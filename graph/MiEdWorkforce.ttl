<urn:solutiondesign:instance:iam:BatchJob_DeactivateInactiveUsers> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Not detailed in source." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:notes> "Backs POST /admin/jobs/deactivate-inactive-users (iam-api.yml), gated by iam.inactivity.run." ;
	<urn:solutiondesign:ontology:schedule> "First Friday of each month (Azure Synapse Pipeline), per active InactivityPolicy.deactivationSchedule cron expression; default inactivity threshold 84 months (7 years)" ;
	<urn:solutiondesign:ontology:steps> "Load active InactivityPolicy configuration; query users WHERE lastLoginAt < (now - inactivityThreshold) AND MiLogin type matches policy filter AND authorization status = Active; for each, revoke all authorizations, mark the account Inactive, invalidate the authorization cache, publish UserAccountDeactivated and one AuthorizationRevoked per authorization, notify the user and Lead Admin(s); generate and send a summary report to System Admins." .

<urn:solutiondesign:instance:iam:BatchJob_ExpireAuthorizationRequests> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Not detailed in source; job runs idempotently against a status filter so a retry after partial failure only re-processes remaining Pending-and-overdue requests." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:notes> "Backs POST /admin/jobs/expire-requests (iam-api.yml), gated by iam.inactivity.run." ;
	<urn:solutiondesign:ontology:schedule> "Nightly (Azure Synapse Pipeline)" ;
	<urn:solutiondesign:ontology:steps> "Query AuthorizationRequests WHERE status=Pending AND createdAt < (now - expirationThreshold); for each, mark Expired, invalidate the approval link, publish AuthorizationExpired, notify the requesting user and Lead Admin." .

<urn:solutiondesign:instance:iam:BatchJob_GenerateReports> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:ApiDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Not detailed in source." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:notes> "Backs POST /admin/jobs/generate-reports (iam-api.yml), gated by iam.reports.view." ;
	<urn:solutiondesign:ontology:schedule> "Mondays at 8 AM (Azure Synapse Pipeline)" ;
	<urn:solutiondesign:ontology:steps> "Generate and email weekly authorization summary reports to System Admins." .

