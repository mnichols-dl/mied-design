<urn:solutiondesign:instance:staffing:Op_RequestCollectionException> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:ExceptionRequest> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Only available after the legislative deadline has passed. Pending review by a Staffing Data Admin under staffing.admin.process-exceptions." ;
	<urn:solutiondesign:ontology:operationId> "requestCollectionException" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/collection-exceptions" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:ExceptionRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Request extension past legislative deadline" ;
	<urn:solutiondesign:ontology:tags> "CollectionExceptions" .

<urn:solutiondesign:instance:staffing:Op_RequestNewId> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Proxies to IAM's /identity-resolution/requests/{requestId}/escalate endpoint (iam:Op_EscalateIdentityRequest); approval/denial is performed by an Identity Administrator via IAM's own review capability, not by Staffing. IAM-owned payload shape, hence the escape hatch." ;
	<urn:solutiondesign:ontology:operationId> "requestNewId" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/request-new-id" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ requestId }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Request new Unique ID when rejecting all near-match potentials" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_ResolveDemographicsNearMatch> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Unlike /employee-roster/resolve-near-match (Add New Employee path), there is no option to request a new ID here — FDD 15.3 explicitly prohibits creating a new ID from the Update path. IAM-owned payload shape, hence the escape hatch." ;
	<urn:solutiondesign:ontology:operationId> "resolveDemographicsNearMatch" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/{employeeId}/demographics/resolve-near-match" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ requestId, selectedUniqueId, replaceMasterRecord: true|false }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Resolve a Near Match returned during a demographics update" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_ResolveNearMatch> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Proxies to IAM's /identity-resolution/requests/{requestId}/resolve endpoint (iam:Op_SelfResolveIdentityRequest), which owns the Near Match state — the request/response shape here is IAM's identity-resolution payload, not a Staffing domain entity, hence the escape-hatch sd:requestBodySchema rather than sd:consumesShape." ;
	<urn:solutiondesign:ontology:operationId> "resolveNearMatch" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/resolve-near-match" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ requestId, selectedUniqueId? (or reject-all-and-request-new) }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Resolve Mi-Key near match by selecting a potential match (Add New Employee path)" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_RunQualityReview> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Executes all validation rules (record-level, cross-record, historical, EEM alignment) — see staff:TP_ValidationRuleEngine (staffing-technical-design.ttl). Can be run multiple times." ;
	<urn:solutiondesign:ontology:operationId> "runQualityReview" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/collections/{collectionId}/quality-review" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:QualityReviewResult> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Run validation rules and generate quality report" ;
	<urn:solutiondesign:ontology:tags> "Collections" .

<urn:solutiondesign:instance:staffing:Op_SearchEducators> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Cross-organization search used by coordinators for lookup purposes (e.g. mentor validation). Returns only a free-text, nullable activeCredentialSummary string — a name-and-summary lookup, not a structured credential-validity check. Does not require X-Organization-Context because it is a system-wide identity lookup, not an organizational data query. See staff:Question_MentorVerificationEndpointDirection in staffing-domain.ttl for how this relates to credentialing's own 'Mentor Assignment Requirement for Permits' expectations of a different Staffing endpoint (fixes a dangling v1 reference to a never-defined staff:CrossDomainNote_MentorVerification)." ;
	<urn:solutiondesign:ontology:operationId> "searchEducators" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/educators/search" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:EmployeeRecord> ;
	<urn:solutiondesign:ontology:projection> "Minimal cross-org lookup shape only: name, Unique ID, and a free-text nullable activeCredentialSummary string — not a full EmployeeRecord and not a structured credential-validity determination." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Global search for educators by name or Unique ID" ;
	<urn:solutiondesign:ontology:tags> "Educators" .

<urn:solutiondesign:instance:staffing:Op_SearchEmployees> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Must be performed before adding a new employee to identify existing Unique ID associations and prevent duplicates. Org-scoped and permission-gated — see staff:Question_EmploymentAssignmentVerificationEndpoint (staffing-domain.ttl) for why this is the closest-but-not-matching endpoint credentialing's 'Verify employment assignment' call assumes exists." ;
	<urn:solutiondesign:ontology:operationId> "searchEmployees" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/search" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:EmployeeRecord> ;
	<urn:solutiondesign:ontology:projection> "Search-result subset of EmployeeRecord (name, DOB, Unique ID) for duplicate-prevention lookup, not the full record." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Search employees by name, DOB, or Unique ID" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_SubmitJustifications> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "No sd:DomainEntity was promoted in staffing-domain.ttl for the ERD's COLLECTION_JUSTIFICATIONS table (per that file's 'ERD/DataTable modeling is skipped' scope note) — escape hatch used rather than pointing at an entity that doesn't exist as a graph node." ;
	<urn:solutiondesign:ontology:operationId> "submitJustifications" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/collections/{collectionId}/justifications" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ justifications: [{ conditionKey, justificationText }] }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit justifications for validation warnings" ;
	<urn:solutiondesign:ontology:tags> "Collections" .

<urn:solutiondesign:instance:staffing:Op_UpdateAssignment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Partial update of assignment fields (FTE, end date, primary flag)." ;
	<urn:solutiondesign:ontology:operationId> "updateAssignment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/assignments/{assignmentId}" ;
	<urn:solutiondesign:ontology:projection> "Partial update — FTE, end date, primary flag only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update assignment details" ;
	<urn:solutiondesign:ontology:tags> "Assignments" .

<urn:solutiondesign:instance:staffing:Op_UpdateEmployeeDemographics> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:EmployeeRecord> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Triggers identity resolution via IAM's identity-resolution API (which synchronizes to Mi-Key). Cross-notifies the district if updated by citizen, or the citizen if updated by a district user." ;
	<urn:solutiondesign:ontology:operationId> "updateEmployeeDemographics" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/{employeeId}/demographics" ;
	<urn:solutiondesign:ontology:projection> "Partial update — only changedFields, not the full record." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update employee demographics" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_UpdateEmploymentStatus> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:EmploymentStatus> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. If terminating, separation reason is required; end date and separation reason must both be present or both absent." ;
	<urn:solutiondesign:ontology:operationId> "updateEmploymentStatus" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/{employeeId}/employment-status" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:EmployeeRecord> ;
	<urn:solutiondesign:ontology:projection> "Request carries newStatus plus, if terminating, endDate and separationReason (staff:EmploymentSeparationReason)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update employment status and separation details" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_UpdatePosition> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:Position> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Partial update of position fields (title, job category/function, approved FTE)." ;
	<urn:solutiondesign:ontology:operationId> "updatePosition" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/positions/{positionId}" ;
	<urn:solutiondesign:ontology:projection> "Partial update of title, job category/function, approved FTE only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update position details" ;
	<urn:solutiondesign:ontology:tags> "Positions" .

<urn:solutiondesign:instance:staffing:Op_UpdatePositionStatus> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:PositionStatus> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Transitions a position to a new status with business rule enforcement (Filled requires employee, Approved requires future start date, Cancelled requires reason, Frozen ends any active assignment)." ;
	<urn:solutiondesign:ontology:operationId> "updatePositionStatus" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/positions/{positionId}/status" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:Position> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update position status" ;
	<urn:solutiondesign:ontology:tags> "Positions" .

<urn:solutiondesign:instance:staffing:Op_ValidatePlacement> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called internally during assignment creation, and also callable from other internal services (e.g. credentialing) via Managed Identity/mTLS. No user token is present; X-Organization-Context does not apply. A validation-result payload, not itself an entity — escape hatch used deliberately. Source still lists staffing.assignment.view under x-permissions-required despite accessType internal-service having no user context to check a permission against — recorded as-is; a plausible source inconsistency, not resolved here." ;
	<urn:solutiondesign:ontology:operationId> "validatePlacement" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/assignments/validate-placement" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ employeeId, positionId, scedCode?, gradeSpan? }" ;
	<urn:solutiondesign:ontology:responseSchema> "{ meetsRequirements: boolean, missingCredential?: boolean, missingEndorsement?: boolean, pprRestriction?: boolean }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Validate credential and endorsement for assignment" ;
	<urn:solutiondesign:ontology:tags> "Assignments" .

<urn:solutiondesign:instance:staffing:Perm_AdminManageCollections> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Define and manage collection configurations" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Admin> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Staffing Data Admin role; create collections, set date ranges, entity types. No matching sd:ApiOperation anywhere in staffing-api.yml — a documented gap, not modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.admin.manage-collections" .

<urn:solutiondesign:instance:staffing:Perm_AdminManageDataElements> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Define and manage data element definitions" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Admin> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Staffing Data Admin role; create/update data elements, categories, components. No matching sd:ApiOperation anywhere in staffing-api.yml — a documented gap, not modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.admin.manage-data-elements" .

<urn:solutiondesign:instance:staffing:Perm_AdminManageValidations> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Define and manage business rule validations" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Admin> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Staffing Data Admin role; assign validations to collections/categories/elements — see staff:TP_ValidationRuleEngine (staffing-technical-design.ttl). No matching sd:ApiOperation anywhere in staffing-api.yml — a documented gap, not modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.admin.manage-validations" .

<urn:solutiondesign:instance:staffing:Perm_AdminProcessExceptions> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Approve or deny collection exception requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Admin> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Staffing Data Admin role; review and approve deadline extension requests." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.admin.process-exceptions" .

<urn:solutiondesign:instance:staffing:Perm_AdminResetFileProcessing> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Reset or delete files in processing queue" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Admin> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Staffing Data Admin role; troubleshoot stuck file uploads. No matching sd:ApiOperation anywhere in staffing-api.yml — same file-upload API-surface gap as staffing.admin.view-file-queues." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.admin.reset-file-processing" .

<urn:solutiondesign:instance:staffing:Perm_AdminViewFileQueues> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View and manage file upload queues" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Admin> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Staffing Data Admin role; monitor bulk upload processing. No matching sd:ApiOperation anywhere in staffing-api.yml — bulk-upload has no endpoint at all (see staffing.employee-roster.bulk-upload); a documented gap, not modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.admin.view-file-queues" .

<urn:solutiondesign:instance:staffing:Perm_AssignmentCertify> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Certify assignment details collection for entity" ;
