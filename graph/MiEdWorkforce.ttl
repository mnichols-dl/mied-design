	<urn:solutiondesign:ontology:name> "WorklistName" .

<urn:solutiondesign:instance:profpractices:WorklistPriorityRules> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Sorting criteria (by date reported, conviction date, disclosure type)." ;
	<urn:solutiondesign:ontology:name> "PriorityRules" .

<urn:solutiondesign:instance:profpractices:WorklistQueuedDisclosureIds> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Disclosures currently in this worklist." ;
	<urn:solutiondesign:ontology:name> "QueuedDisclosureIds" .

<urn:solutiondesign:instance:profpractices:WorklistRoutingRules> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Conditions that automatically route disclosures to this worklist (based on disclosure status, type, date ranges)." ;
	<urn:solutiondesign:ontology:name> "RoutingRules" .

<urn:solutiondesign:instance:profpractices:WorklistState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:profpractices:WorklistState_Paused> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Paused" .

<urn:solutiondesign:instance:profpractices:WorklistVisibilitySettings> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Which statuses/markers are visible to reviewers in this worklist." ;
	<urn:solutiondesign:ontology:name> "VisibilitySettings" .

<urn:solutiondesign:instance:publicportal:PublicPortalContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:displayName> "Public Portal" ;
	<urn:solutiondesign:ontology:identifier> "publicportal" ;
	<urn:solutiondesign:ontology:kind> "CoreDomain" ;
	<urn:solutiondesign:ontology:status> "stub" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:CredentialIssuedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:CredentialRevokedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:CredentialSuspendedEvent> .

<urn:solutiondesign:instance:publicportal:Question_PublicPortalCmsNotModeled> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Features 12.2.1-12.2.3 describe a concrete admin CMS for the public, unauthenticated MiEdWorkforce landing page: free-text content editing with direct-to-live publishing (no approval workflow), hyperlink management, and maintenance/downtime messaging. pub:PublicPortalContext is a stub-only sd:BoundedContext (declared in credentialing-domain.ttl per CONVENTIONS.md's registry, sd:status \"stub\") with no Aggregate, ApiOperation, or Sequence of its own anywhere in the project — this FDD is the first pass to describe concrete admin-facing behavior for it (the FDD 31 pass only ever treated it as passive UI chrome hosting a search link, not as something with its own admin/content-management surface). wireframe-03 (viewed) shows this is a real, designed screen, not aspirational narrative. This mirrors the treatment iam:Req_01_1_3 gave the same landing page from the login-routing side (a minor, UI-only gap folded into notes there since it was one narrow AC bullet among many) — but here the ENTIRE Feature is landing-page content administration, large enough relative to this FDD's total size to warrant its own Annotation rather than a notes-only mention." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:publicportal:Req_12_2_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:publicportal:Req_12_2_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:publicportal:Req_12_2_3> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:Fdd12Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:publicportal:Req_12_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an administrative interface for the System Administrator to add, edit, or remove headings, text, announcements, and user support materials on the public landing page. When the administrator submits changes, the system publishes the updates directly to the live page without requiring a secondary system approval workflow." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:Fdd12Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_PublicPortalCmsNotModeled below. wireframe-03 (pub:WireframePublicLandingPageCms, viewed) shows a concretely-designed rich-text CMS screen over the real MiEdWorkforce/MiLogin landing-page copy (matching the FDD 01 pass's own wireframe-02 content) — a real, wireframed feature, not vague narrative." ;
	<urn:solutiondesign:ontology:requirementId> "12.2.1" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to manage page text, headings, and user support materials on the Public System Landing page, so that members of the public have accurate and current information." ;
	<urn:solutiondesign:ontology:title> "Manage public landing page text and user support materials" .

<urn:solutiondesign:instance:publicportal:Req_12_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system allows the System Administrator to add new external or internal URLs along with their corresponding display text. The system allows the System Administrator to edit or remove existing hyperlinks. Links configured by the administrator display appropriately on the unauthenticated public landing page." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:Fdd12Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_PublicPortalCmsNotModeled below." ;
	<urn:solutiondesign:ontology:requirementId> "12.2.2" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to add and update hyperlinks and their associated text on the Public System Landing page, so that users can be properly directed to appropriate external resources (such as CEPI or MDE web pages)." ;
	<urn:solutiondesign:ontology:title> "Add and update public landing page hyperlinks" .

<urn:solutiondesign:instance:publicportal:Req_12_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system allows the System Administrator to enter and display specific maintenance text/announcements (e.g., notifying users of the time and date of a production deployment or system downtime). The system displays this maintenance message on the public landing page, which serves as the 'door' users land on if they are redirected from MiLogin while the main application is closed." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:Fdd12Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_PublicPortalCmsNotModeled below." ;
	<urn:solutiondesign:ontology:requirementId> "12.2.3" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to configure and display system maintenance or downtime messages on the Public System Landing page, so that users are informed when the system is inaccessible before they attempt to log in." ;
	<urn:solutiondesign:ontology:title> "Configure public landing page maintenance/downtime messages" .

<urn:solutiondesign:instance:publicportal:WireframePublicLandingPageCms> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:Fdd12Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "word/media/image5.png, embedded at 12.2.2. A rich-text CMS editor over the real MiEdWorkforce/MiLogin public landing-page copy (the same landing-page content also depicted in the FDD 01 pass's wireframe-02). Confirms 12.2's public-landing-page administration is a concretely designed screen, not vague narrative — strengthens rather than weakens Question_PublicPortalCmsNotModeled below, since a real screen exists with nothing in the graph backing it." ;
	<urn:solutiondesign:ontology:section> "wireframes/wireframe-03-public-landing-page-cms.png" .

