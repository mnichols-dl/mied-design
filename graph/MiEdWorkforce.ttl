	<urn:solutiondesign:ontology:name> "Recommended by EPP" .

<urn:solutiondesign:instance:epp:AarState_Submitted> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
