	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Requires all pre-certification tasks complete." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.assignment.certify" .

<urn:solutiondesign:instance:staffing:Perm_AssignmentCreate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Assign employee to position" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Assignment> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Triggers credential validation." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.assignment.create" .

<urn:solutiondesign:instance:staffing:Perm_AssignmentSubmitJustification> a <urn:solutiondesign:ontology:Permission> ;
