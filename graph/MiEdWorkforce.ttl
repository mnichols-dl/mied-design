<urn:solutiondesign:instance:iam:AuthorizationRemovalRequestedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Emitted per iam-sequences.md but has no home in iam-domain.md's Core Aggregates section (only an ERD REMOVAL_REQUESTS table exists) and no documented cross-domain Consumers — an honest gap, not fabricated." ;
	<urn:solutiondesign:ontology:payloadHighlights> "referenceId, targetUserEmail, requestorName, requestorEmail, justification, submittedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "iam-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "External (unauthenticated) party submits a public authorization-removal form" .

<urn:solutiondesign:instance:iam:AuthorizationRequestedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
