	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/permissions/effective" ;
	<urn:solutiondesign:ontology:responseSchema> "List of effective permissionIds for a user at an organizational scope, derived by unioning across the user's matching Authorizations' Roles -- a computed projection spanning multiple entities, not one entity shape" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get all effective permissions for a user at an organizational scope (internal service)" ;
	<urn:solutiondesign:ontology:tags> "Permissions" .

