	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'ID Management Requests' list (Unresolved/Resolved tabs; Unique ID/Last/First/Requested By/Received/Type/Status columns; Type values New ID, Link IDs, Split ID, Retire ID; Status values Needs Review, On Hold). Strong match for iam:IdentityResolutionRequestAggregate's request-type/status vocabulary and iam:Op_ListIdentityResolutionRequests. Breadcrumb reads '< Back to Rapbacks' — see this file's header note on Question_RapbacksBreadcrumbDiscrepancy." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/24-request-for-id-collection/wireframes/wireframe-06-id-management-requests-list.png" .

<urn:solutiondesign:instance:staffing:Wireframe24_7> a <urn:solutiondesign:ontology:SourceDocument> ;
