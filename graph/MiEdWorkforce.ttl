<urn:solutiondesign:instance:communications:EmailContent> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "The rendered email output (subject, body_html, body_text) — hot storage only, deleted on archival." ;
	<urn:solutiondesign:ontology:name> "EmailContent" .

<urn:solutiondesign:instance:communications:EmailContentArchivedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "See file header: communications-sequences.md's 'Email Content Purge Job' sequence describes what reads like the same occurrence but names it EmailContentPurged instead (see comm:EmailContentPurgedEvent) — a genuine cross-document naming discrepancy, not resolved here." ;
	<urn:solutiondesign:ontology:payloadHighlights> "instance_id, archived_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Email content purged from hot storage (per communications-capability.md's Domain Events table and its own 'Email Content Archival' Integration Pattern)" .

<urn:solutiondesign:instance:communications:EmailContentPurgedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "See file header and comm:EmailContentArchivedEvent's note — likely the same real occurrence as EmailContentArchivedEvent, named differently in a different source document. No consumers documented for this name specifically." ;
	<urn:solutiondesign:ontology:payloadHighlights> "instance_id, purged_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Daily content-purge CronJob successfully deletes one instance's hot-storage content (per communications-sequences.md's 'Email Content Purge Job' sequence's own Events Published list and diagram)" .

<urn:solutiondesign:instance:communications:EmailDeferredEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumer per source: monitoring — not a registry bounded context, left unresolved." ;
	<urn:solutiondesign:ontology:payloadHighlights> "instance_id, recipient_email, defer_reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "SendGrid defers delivery (temporary failure, will retry)" .

<urn:solutiondesign:instance:communications:EmailDeliveredEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumer per source: analytics — not a registry bounded context, left unresolved." ;
	<urn:solutiondesign:ontology:payloadHighlights> "instance_id, recipient_email, delivered_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "SendGrid confirms delivery" .

<urn:solutiondesign:instance:communications:EmailDeliveryEvent> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "One SendGrid-reported status update (Processed, Delivered, Bounced, Deferred, Dropped) with substatus/reason, keyed for idempotency by sg_event_id." ;
	<urn:solutiondesign:ontology:name> "EmailDeliveryEvent" .

<urn:solutiondesign:instance:communications:EmailDroppedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers per source: monitoring, support — neither is a registry bounded context, left unresolved." ;
	<urn:solutiondesign:ontology:payloadHighlights> "instance_id, recipient_email, drop_reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "SendGrid drops email before sending" .

<urn:solutiondesign:instance:communications:EmailInstanceAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Preserves complete historical record of sent emails with dual retention policies: full content for operational needs (hot storage) and audit metadata for compliance (warm/cold storage)." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailBouncedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailContentArchivedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailContentPurgedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailDeferredEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailDeliveredEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailDroppedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailResentEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailSendFailedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailSentEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:EmailContent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:EmailDeliveryEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:EmailRecipient> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:EmailResend> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:TemplateReference> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:ContentState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:ContentState_Archived> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:EmailState_Bounced> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:EmailState_Deferred> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:EmailState_Delivered> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:EmailState_Dropped> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:EmailState_Failed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:EmailState_Processed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:EmailState_Queued> ;
	<urn:solutiondesign:ontology:invariants> "Instance content is immutable once created — stores ONLY the rendered output, never the original event or template structure. Resent emails must reference the original instance (resent_from_instance_id). Instance must capture the template version ID and event type used, for audit purposes. Delivery status is tracked but instance content is never modified. Resend is only available while email content exists in hot storage. Email content is archived/purged based on content_retention_days (default 90). Audit metadata is retained for audit_retention_years (default 7 years)." ;
	<urn:solutiondesign:ontology:notes> "Dual-retention storage: Cosmos DB (hot, full rendered content, 90-day default, <100ms p95 target, partitioned by /functional_area) for the delivery-states lifecycle above; SQL Server (warm, metadata only, 7-year default) for the content-lifecycle states (Active/Archived) — the same aggregate spans both stores. Idempotency keyed on the triggering event_id to guard against Service Bus retries producing duplicate sends. See communications-technical-design.ttl's comm:TP_EmailStorageArchitecture for the full dual-retention/partitioning design." ;
	<urn:solutiondesign:ontology:rootEntity> "EmailInstance" .

<urn:solutiondesign:instance:communications:EmailRecipient> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Recipient details (email address, optional user reference, recipient type: User|External)." ;
	<urn:solutiondesign:ontology:name> "EmailRecipient" .

<urn:solutiondesign:instance:communications:EmailResend> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Resend tracking record linking the original EmailInstance to the new one, with recipient-override capability." ;
	<urn:solutiondesign:ontology:name> "EmailResend" .

<urn:solutiondesign:instance:communications:EmailResentEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "instance_id, original_instance_id, new_recipient_email, resent_by" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Email resent to new/same recipient" .

<urn:solutiondesign:instance:communications:EmailSendFailedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Not in communications-capability.md's Domain Events table — only appears in communications-sequences.md's 'Event-Triggered Email Send' sequence. No consumers documented anywhere." ;
	<urn:solutiondesign:ontology:payloadHighlights> "template_id, version_id, event_id, missing variable names" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Mandatory template variable unresolvable, or SendGrid rejected the send" .

<urn:solutiondesign:instance:communications:EmailSentEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers per source: audit, analytics. 'analytics' is not a registry bounded context — left unresolved, see file header." ;
	<urn:solutiondesign:ontology:payloadHighlights> "instance_id, template_id, recipients[], sent_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Email successfully queued to SendGrid" .

<urn:solutiondesign:instance:communications:EmailState_Bounced> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Bounced" .

<urn:solutiondesign:instance:communications:EmailState_Deferred> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Deferred" .

<urn:solutiondesign:instance:communications:EmailState_Delivered> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Delivered" .

<urn:solutiondesign:instance:communications:EmailState_Dropped> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Dropped" .

<urn:solutiondesign:instance:communications:EmailState_Failed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Failed" .

<urn:solutiondesign:instance:communications:EmailState_Processed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Processed" .

<urn:solutiondesign:instance:communications:EmailState_Queued> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Queued" .

<urn:solutiondesign:instance:communications:EmailTemplateActivatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "template_id, version_id, effective_date" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Template version set to active" .

<urn:solutiondesign:instance:communications:EmailTemplateAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Manages the lifecycle and versioning of reusable email content structures, ensuring only one active version exists per template and enforcing functional area isolation." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailTemplateActivatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailTemplateCreatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:EmailTemplateVersionCreatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:EventTypeBinding> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:TemplateRecipient> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:TemplateVariable> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:TemplateVersion> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:TemplateState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:TemplateState_Archived> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:TemplateState_Draft> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:TemplateState_Pending> ;
	<urn:solutiondesign:ontology:invariants> "A template must have at least one version at all times. Only one version can be marked as current/active per template — activating a new version automatically deactivates the previous one. Template names must be unique within a functional area. Templates must be associated with a specific event type (the binding between domain events and templates). Only one active template is allowed per event type within a functional area. Mandatory template variables must resolve to non-null values or send is blocked (send blocked -> event to DLQ -> admin dashboard alert -> manual recovery: fix template, retry, export to CSV, or after 7 days archive as permanently failed). Variable placeholders must match the available variables for the template's event type." ;
	<urn:solutiondesign:ontology:notes> "Storage: SQL Server (not Cosmos DB) for relational structure and strong consistency on the single-active-version invariant. Content authored in Markdown with a server-controlled extension allowlist (:::alert{}, :::button{}) rather than raw HTML, to eliminate the template-authoring XSS surface entirely; variables are HTML-escaped at substitution time. See communications-technical-design.ttl's comm:TP_TemplateStorageAndEditing for the full storage/editing design." ;
	<urn:solutiondesign:ontology:rootEntity> "EmailTemplate" .

<urn:solutiondesign:instance:communications:EmailTemplateCreatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "template_id, functional_area, created_by" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "New template saved" .

<urn:solutiondesign:instance:communications:EmailTemplateVersionCreatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Not in communications-capability.md's Domain Events table — only appears in communications-sequences.md's 'Template Version Update and Activation' sequence. No consumers documented anywhere." ;
	<urn:solutiondesign:ontology:payloadHighlights> "template_id, version_id" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "New draft version created for an existing template" .

<urn:solutiondesign:instance:communications:EventTypeBinding> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Links a template to the specific domain event that triggers it (event_type name, functional_area). One template maps to exactly one event type." ;
	<urn:solutiondesign:ontology:name> "EventTypeBinding" .

<urn:solutiondesign:instance:communications:Fdd06CommentLogsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:Fdd06Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Example remark-category/template table (Professional Practices, Application, Account, Employment) plus 5 legacy-MORE-system screenshots of the same Remarks-History/Hold-action shape as comm:Wireframe1/Wireframe2, with different sample data. Notably shows 'Account'-level remarks visible to 'MORE workers' (broader than a single application) and flags PPR-categorized remarks as restricted to PPR-access users only — corroborates comm:CommentAggregate's org-scoped visibility model and profpractices' own PPR access-control concept, referenced here in prose only (profp: prefix not imported, no direct triple needed)." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/06 - Alerts, Emails, Communications/Comment Logs.docx" .

<urn:solutiondesign:instance:communications:Fdd06Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 6.1-6.5 (document subtitle: '6.0 Alerts, Emails, Communications (6.1 - 6.5)'). Authors Vidhya Punniyamoorthy/Beth Dontje/Caitlin Groom; approved by Dontje (MDE) and Groom (CEPI) 08/01/2025 per the signoff table — but comments.xml contains entries dated through 2026-03-06, well after that signoff date, so (as with the FDD 29 pass's own finding on the same pattern) the document continued to be actively revised after its nominal approval date." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/06 - Alerts, Emails, Communications/6 - Alerts, Emails and Communication.docx" .

<urn:solutiondesign:instance:communications:Fdd06EmailsRemarksDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:Fdd06Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Role-based narrative (MORE Product Owner/Superuser vs. Application Evaluator) confirming the template-library-vs.-per-send-customization split (Rule_SingleActiveTemplateVersion's library sits above per-send customization) and the Hold-action-triggers-template-selection-plus-required-internal-remark flow that Req_06_4_3/comm:Wireframe1 both corroborate." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/06 - Alerts, Emails, Communications/Emails and Remarks.docx" .

<urn:solutiondesign:instance:communications:Fdd06InterfaceOutlookDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:Fdd06Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Describes a Microsoft Graph API (POST https://graph.microsoft.com/v1.0/me/sendMail) integration for two-way email from dedicated Outlook mailboxes — see Question_OutlookTwoWayChannelUnmodeled below." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/06 - Alerts, Emails, Communications/Interface Design document - Microsoft 365 (Outlook).docx" .

<urn:solutiondesign:instance:communications:Fdd06InterfaceSendGridDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:Fdd06Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Confirms ext:SendGridSystem's own integration details (Bearer token auth, RESTful/C# library, 10k calls/sec rate limit, JSON personalization/template payload shape) already modeled in communications-capability.ttl/communications-technical-design.ttl — no new facts beyond what's already captured there." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/06 - Alerts, Emails, Communications/Interface Design document - SendGrid.docx" .

<urn:solutiondesign:instance:communications:Fdd06MoecsScreenshotDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:Fdd06Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Legacy MOECS (Michigan Online Educator Certification System) reference screenshots — comment 2098536325 on the primary FDD confirms these are what comm:Wireframe1/Wireframe2 were copied from ('Screenshot will be similar to this but for remarks'), i.e. this doc's images are the SOURCE, not an independent confirmation." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/06 - Alerts, Emails, Communications/MOECS_CommentsScreenShot.docx" .

<urn:solutiondesign:instance:communications:Op_ActivateTemplateVersion> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Deactivates the previously active version in the same transaction (Single Active Template Version business rule — see comm:Rule_SingleActiveTemplateVersion in communications-capability.ttl). No request body and a bare 200 response; consumesShape/producesShape deliberately omitted since templateId/versionId path parameters (not a body) drive this state transition." ;
	<urn:solutiondesign:ontology:operationId> "activateTemplateVersion" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates/{templateId}/versions/{versionId}/activate" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Activate template version" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Op_CreateAlert> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:AlertAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Targeting is by explicit user ID list." ;
	<urn:solutiondesign:ontology:operationId> "createAlert" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/alerts" ;
	<urn:solutiondesign:ontology:projection> "AlertCreate maps to Alert root fields (alertType, severity, message, actionLink, expiresAt) plus an explicit targetUserIds list — targeting here is by explicit user ID rather than the role/scope-based targeting comm:AlertRoleTarget models for the Dashboard Alert Creation sequence's own event-triggered path; both are real targeting mechanisms for the same aggregate, not a conflict." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create dashboard alert" ;
	<urn:solutiondesign:ontology:tags> "Alerts" .

<urn:solutiondesign:instance:communications:Op_CreateComment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:CommentAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Caller's organizational scope determined by X-Organization-Context; may only create comments on process items within their authorized scope (Building/District/ISD, transitive)." ;
	<urn:solutiondesign:ontology:operationId> "createComment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/comments" ;
	<urn:solutiondesign:ontology:projection> "CommentCreate maps to Comment root fields (processItemType, processItemId, commentText, visibility)." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Add comment to process item" ;
	<urn:solutiondesign:ontology:tags> "Comments" .

<urn:solutiondesign:instance:communications:Op_CreateTemplate> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:ApiDoc> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "createTemplate" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates" ;
	<urn:solutiondesign:ontology:projection> "TemplateCreate carries only name/description/functionalArea/eventType — the subset of EmailTemplate root fields needed to create the record in Draft status. Version content (subject/body) is added separately via createTemplateVersion; response is just the new templateId, not the full aggregate." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create new email template" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Op_CreateTemplateVersion> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:TemplateVersion> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Creates a Draft version; does not auto-activate. Validates variable placeholders against the event type's available-variables list (see comm:Op_GetAvailableVariables)." ;
	<urn:solutiondesign:ontology:operationId> "createTemplateVersion" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates/{templateId}/versions" ;
	<urn:solutiondesign:ontology:projection> "TemplateVersionCreate carries subject/bodyContent — the authorable subset of TemplateVersion's fields; version_number/status/created_at/activated_at/activated_by are server-assigned, not part of the request." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create new template version" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Op_DeleteComment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "DELETE" ;
	<urn:solutiondesign:ontology:notes> "204 No Content, no request body — consumesShape/producesShape deliberately omitted. Scope resolved server-side from the comment's owning process item — X-Organization-Context not required." ;
	<urn:solutiondesign:ontology:operationId> "deleteComment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/comments/{commentId}" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Delete comment (soft delete)" ;
	<urn:solutiondesign:ontology:tags> "Comments" .

<urn:solutiondesign:instance:communications:Op_DeleteTemplate> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "DELETE" ;
	<urn:solutiondesign:ontology:notes> "204 No Content, no request body — consumesShape/producesShape deliberately omitted; the operation acts on comm:EmailTemplateAggregate (see sd:appliesTo on other Template operations) without carrying a distinct request/response shape of its own." ;
	<urn:solutiondesign:ontology:operationId> "deleteTemplate" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates/{templateId}" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Archive template (soft delete)" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Op_GetAvailableVariables> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Used by the template editor for autocomplete and variable insertion; scope-agnostic system-wide metadata." ;
	<urn:solutiondesign:ontology:operationId> "getAvailableVariables" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/event-types/{eventType}/available-variables" ;
	<urn:solutiondesign:ontology:responseSchema> "EventTypeVariables: { eventType, functionalArea, variableFamilies: [ { sourceEntity, requiredContext: string[], availableVariables: [ { name, displayName, description, exampleValue, isMandatory, dataType } ] } ] }. Escape hatch, not sd:producesShape: this is a variable-family registry projection driven by the event-type-specific Variable Resolver design (see communications-technical-design.ttl's comm:TP_VariableResolution), not itself a promoted domain-model entity — comm:TemplateVariable only captures a placeholder's name/mandatory flag on a specific template, not the full resolver-family metadata (source entity, required context, example values) this endpoint returns for a given event type in the abstract." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get available variables for event type" ;
	<urn:solutiondesign:ontology:tags> "EventTypes" .

<urn:solutiondesign:instance:communications:Op_GetEmailInstance> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "communications-api.yml's own description says this 'requires communications.email.view-details plus the corresponding functional area view-history permission, both of which are evaluated server-side' — but x-permissions-required lists only email.view-details. The implied functional-area view-history requirement is not independently modeled as a PermissionRequirement here since communications-api.yml doesn't say which one(s); left as a documented gap rather than guessed." ;
	<urn:solutiondesign:ontology:operationId> "getEmailInstance" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/email-history/{instanceId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:EmailInstanceAggregate> ;
	<urn:solutiondesign:ontology:projection> "EmailInstanceDetail = EmailInstanceSummary + bodyHtml/bodyText (null if content purged) + deliveryEvents timeline (comm:EmailDeliveryEvent) + templateVersionId + eventType + sentByUserId + resentFromInstanceId — the full EmailInstance aggregate shape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get email instance details" ;
	<urn:solutiondesign:ontology:tags> "EmailHistory" .

<urn:solutiondesign:instance:communications:Op_GetTemplate> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:ApiDoc> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "getTemplate" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates/{templateId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:projection> "TemplateDetail = TemplateSummary + description + the full versions list (comm:TemplateVersion), i.e. the complete EmailTemplate aggregate shape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get template details" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Op_ListAlerts> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Always scoped to the calling user's own alerts, regardless of which scope the caller's alerts.view permission was granted at." ;
	<urn:solutiondesign:ontology:operationId> "listAlerts" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/alerts" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:AlertAggregate> ;
	<urn:solutiondesign:ontology:projection> "AlertSummary is the list-view projection of Alert (alertId, alertType, severity, message, actionLink, status, createdAt, expiresAt)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List dashboard alerts for current user" ;
	<urn:solutiondesign:ontology:tags> "Alerts" .

<urn:solutiondesign:instance:communications:Op_ListComments> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Internal comments only returned to callers holding comments.view-internal; external comments are visible to any caller with access to the parent process item (no separate 'view-external' permission exists). Scoped by X-Organization-Context (Building/District/ISD, transitive)." ;
	<urn:solutiondesign:ontology:operationId> "listComments" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/comments" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:CommentAggregate> ;
	<urn:solutiondesign:ontology:projection> "CommentSummary is the list-view projection of Comment (commentId, commentText, visibility, createdBy, createdAt, modifiedAt, sentInEmailInstanceIds)." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "List comments for process item" ;
	<urn:solutiondesign:ontology:tags> "Comments" .

<urn:solutiondesign:instance:communications:Op_ListTemplateVersions> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:ApiDoc> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listTemplateVersions" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates/{templateId}/versions" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:TemplateVersion> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List template versions" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Op_ListTemplates> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Results automatically scoped to the functional areas the caller holds a view permission for. See file header for the credentials/credentialing naming discrepancy and the 4-of-8-functional-areas gap." ;
	<urn:solutiondesign:ontology:operationId> "listTemplates" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:projection> "TemplateSummary is a list-view projection of EmailTemplate (id, name, functionalArea, eventType, status, currentVersionNumber, lastModifiedAt) — excludes description and the full versions list, which getTemplate returns." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List email templates" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Op_PreviewEmail> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:ApiDoc> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "previewEmail" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/communications/preview" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:EmailContent> ;
	<urn:solutiondesign:ontology:projection> "Request references an EmailTemplate by templateId plus context/overrides, same shape as sendManualEmail's request. Response (subject/bodyHtml/bodyText) mirrors EmailContent's rendered fields exactly, without persisting an EmailInstance or a resolved recipient." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Preview rendered email before sending" ;
	<urn:solutiondesign:ontology:tags> "Communications" .

<urn:solutiondesign:instance:communications:Op_ReceiveSendGridWebhook> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:EmailDeliveryEvent> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "communications-api.yml explicitly declares x-permissions-required: [] — this endpoint is authenticated via HMAC SHA256 signature validation against a shared secret, not an IAM permission, since the caller (SendGrid) has no MiLogin token. Not exposed via APIM. No sd:PermissionRequirement is asserted, which is a real, deliberate fact about this operation (not a conversion gap) — it will surface as an ambient ApiOperationRequiresPermissionShape finding, which is accurate: this operation genuinely has no IAM permission gate. sd:requiresAuth is NOT set to false here — HMAC signature validation is itself a form of authentication, just not an IAM-permission-gated one; see file header." ;
	<urn:solutiondesign:ontology:operationId> "receiveSendGridWebhook" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/webhooks/sendgrid" ;
	<urn:solutiondesign:ontology:projection> "SendGridWebhookEvent (email, timestamp, event, sg_message_id, sg_event_id, instance_id, reason, status), array-wrapped since SendGrid batches webhook deliveries, maps onto EmailDeliveryEvent's fields (event_type/substatus/reason/timestamp/sg_event_id) plus the instance_id join key used to look up the target EmailInstance." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Receive SendGrid delivery status webhook" ;
	<urn:solutiondesign:ontology:tags> "Webhooks" .

<urn:solutiondesign:instance:communications:Op_ResendEmail> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:EmailResend> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Only available while content exists in hot storage; cannot re-resolve variables, uses originally rendered content. communications-api.yml's description also requires 'the corresponding view-history permission' server-side, evaluated from the email's own functional area, but only the resend permissions are listed in x-permissions-required — the same kind of documented gap as comm:Op_GetEmailInstance above." ;
	<urn:solutiondesign:ontology:operationId> "resendEmail" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/email-history/{instanceId}/resend" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:EmailInstanceAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request (recipientEmail + ccEmails) matches comm:EmailResend's recipient-override shape directly. Response is newInstanceId + originalInstanceId, not the full new EmailInstance (fetchable separately via getEmailInstance)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Resend email with optional recipient override" ;
	<urn:solutiondesign:ontology:tags> "EmailHistory" .

<urn:solutiondesign:instance:communications:Op_ResolveAlert> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:AlertResolution> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "communications-api.yml lists communications.alerts.view as the required permission for an operation that performs a state transition (Active -> Resolved), and its own description separately says the caller 'must own the alert or hold administrative alert permissions, both evaluated server-side' without naming which administrative permission. Modeled exactly as listed (alerts.view) rather than substituting a permission that reads more plausible — a genuine, documented oddity in the source, not corrected here." ;
	<urn:solutiondesign:ontology:operationId> "resolveAlert" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/alerts/{alertId}/resolve" ;
	<urn:solutiondesign:ontology:projection> "Request (resolutionType: Completed|Dismissed|NoActionNeeded) matches comm:AlertResolution's value-object shape directly; response is a bare 200 with no body." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Resolve dashboard alert" ;
	<urn:solutiondesign:ontology:tags> "Alerts" .

<urn:solutiondesign:instance:communications:Op_SearchEmailHistory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Results scoped to the functional areas the caller holds view-history for; email.view-all-history bypasses that scoping entirely." ;
	<urn:solutiondesign:ontology:operationId> "searchEmailHistory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/email-history" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:EmailInstanceAggregate> ;
	<urn:solutiondesign:ontology:projection> "EmailInstanceSummary is a metadata-only projection (instanceId, recipientEmail, subject, sentAt, deliveryStatus, functionalArea, contentStatus) — excludes body content entirely, matching the list-view field set; getEmailInstance returns the full detail shape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Search email history" ;
	<urn:solutiondesign:ontology:tags> "EmailHistory" .

<urn:solutiondesign:instance:communications:Op_SendManualEmail> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Typically used by help desk staff sending one-off emails on behalf of users." ;
	<urn:solutiondesign:ontology:operationId> "sendManualEmail" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/communications/send-manual" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:communications:EmailInstanceAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request (templateId + context + recipientEmail/ccEmails + optional customSubject/customBody) references an EmailTemplate by ID and layers a resend-style override on top of it, rather than mirroring the full aggregate — customSubject/customBody parallel EmailResend's override shape, applied at send time instead of resend time. Response is just the new instanceId; the created EmailInstance is fetchable via getEmailInstance." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Send one-time manual email using template" ;
	<urn:solutiondesign:ontology:tags> "Communications" .

<urn:solutiondesign:instance:communications:Op_UpdateComment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:CommentAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:notes> "Cannot modify a comment already included in a sent email; visibility cannot be changed after creation. Scope resolved server-side from the comment's owning process item — X-Organization-Context not required here despite the underlying permission being org-scoped." ;
	<urn:solutiondesign:ontology:operationId> "updateComment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/comments/{commentId}" ;
	<urn:solutiondesign:ontology:projection> "Request carries only commentText — a single-field subset of Comment's root fields; visibility cannot be changed after creation." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update comment text" ;
	<urn:solutiondesign:ontology:tags> "Comments" .

<urn:solutiondesign:instance:communications:Op_UpdateTemplate> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:notes> "Updates name/description only; does not create a new version (see createTemplateVersion for that)." ;
	<urn:solutiondesign:ontology:operationId> "updateTemplate" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:communications:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/templates/{templateId}" ;
	<urn:solutiondesign:ontology:projection> "Request carries only name/description — a narrow subset of EmailTemplate's root fields; does not create a new version (see createTemplateVersion for that)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update template metadata" ;
	<urn:solutiondesign:ontology:tags> "Templates" .

<urn:solutiondesign:instance:communications:Perm_AlertsCreate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Create new alert templates" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_AlertManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Define alert content, targeting, triggers." ;
	<urn:solutiondesign:ontology:permissionId> "communications.alerts.create" .

<urn:solutiondesign:instance:communications:Perm_AlertsDelete> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Archive alert templates" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_AlertManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:permissionId> "communications.alerts.delete" .

<urn:solutiondesign:instance:communications:Perm_AlertsEdit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Edit alert templates" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_AlertManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:permissionId> "communications.alerts.edit" .

<urn:solutiondesign:instance:communications:Perm_AlertsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View alerts for functional area" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_AlertManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "See alert templates and configuration." ;
	<urn:solutiondesign:ontology:permissionId> "communications.alerts.view" .

<urn:solutiondesign:instance:communications:Perm_CommentsCreateExternal> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Create external comments" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_CommentManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Comments may be shared with citizens/applicants; scoped to the caller's org level, transitive." ;
	<urn:solutiondesign:ontology:permissionId> "communications.comments.create-external" .

<urn:solutiondesign:instance:communications:Perm_CommentsCreateInternal> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Create internal comments" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_CommentManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Comments not visible to external users; scoped to the caller's org level, transitive." ;
	<urn:solutiondesign:ontology:permissionId> "communications.comments.create-internal" .

<urn:solutiondesign:instance:communications:Perm_CommentsDelete> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Delete comments" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_CommentManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Soft delete; remains in the audit trail; scoped to the caller's org level." ;
	<urn:solutiondesign:ontology:permissionId> "communications.comments.delete" .

<urn:solutiondesign:instance:communications:Perm_CommentsEdit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Edit comments (before email send)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_CommentManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Cannot edit after the comment has been included in a sent email; scoped to the caller's org level." ;
	<urn:solutiondesign:ontology:permissionId> "communications.comments.edit" .

<urn:solutiondesign:instance:communications:Perm_CommentsViewInternal> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View internal comments on process items" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_CommentManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Internal staff only; scoped to their org level, transitive (Building/District/ISD per source; Building modeled as shared scope:Entity)." ;
	<urn:solutiondesign:ontology:permissionId> "communications.comments.view-internal" .

<urn:solutiondesign:instance:communications:Perm_CredentialingEmailsResend> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Resend historical Credentialing emails with recipient override" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:communications:Cat_Credentialing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
