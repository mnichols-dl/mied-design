<urn:solutiondesign:instance:credentialing:IssuedCredentialAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents an actual credential issued to a specific educator, tracking its lifecycle and current validity." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialExpiredEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialIssuedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialRenewedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialRevokedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialSuspendedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:credentialing:IssuanceHistory> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredState_Expired> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredState_Nullified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredState_Pending> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredState_Revoked> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredState_Suspended> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredState_Valid> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssociatedEndorsements> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:CredentialStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:IssuedCredentialValidityDateRange> ;
	<urn:solutiondesign:ontology:invariants> "An educator can hold multiple credentials simultaneously. Only one version of a specific credential type can be Valid at a time per educator. Suspended or revoked credentials cannot be renewed; new application required. Expiration date must be after issuance date." ;
	<urn:solutiondesign:ontology:rootEntity> "IssuedCredential" .

<urn:solutiondesign:instance:credentialing:IssuedCredentialValidityDateRange> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Effective from/to dates for an issued credential." ;
	<urn:solutiondesign:ontology:name> "ValidityDateRange" .

<urn:solutiondesign:instance:credentialing:IssuedEndorsState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:credentialing:IssuedEndorsState_Nullified> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Nullified" .

<urn:solutiondesign:instance:credentialing:IssuedEndorsementAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents an endorsement added to a specific educator's certificate." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:EndorsementAddedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:EndorsementNullifiedEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:IssuedEndorsState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:IssuedEndorsState_Nullified> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:IssuedEndorsementGradeBand> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:IssuedEndorsementValidityDateRange> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ParentCredential> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:QualifyingAssessments> ;
	<urn:solutiondesign:ontology:invariants> "An endorsement can only be added to a valid teaching certificate. Grade band must fall within the definition's allowed range. If subject area assessment is required, passing scores must be on file before issuance. Endorsements cannot outlive their parent credential's validity." ;
	<urn:solutiondesign:ontology:rootEntity> "IssuedEndorsement" .

<urn:solutiondesign:instance:credentialing:IssuedEndorsementGradeBand> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Actual grade range for this educator's endorsement." ;
	<urn:solutiondesign:ontology:name> "GradeBand" .

<urn:solutiondesign:instance:credentialing:IssuedEndorsementValidityDateRange> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When this issued endorsement is effective." ;
	<urn:solutiondesign:ontology:name> "ValidityDateRange" .

<urn:solutiondesign:instance:credentialing:LastIssuanceOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "CONFIRMED GAP (cross-domain consistency pass): credentialing is now really converted in abox/mied-v3/credentialing/credentialing-api.ttl, and it still defines no /last-issuance path anywhere — only /credentials/{credentialId}, /credentials search, /educators/{educatorId}/credentials, and the definitions/assessment endpoints exist. This was originally flagged against credentialing-api.yml alone; the real converted API confirms the same gap. proflearning-domain.md's own Upstream table and proflearning-sequences.md's 'Educator Applies College Course for SCECH Credit' sequence both call this exact path. Left resolvable here as a placeholder node, but the underlying Dependency and SequenceReference are both marked to reflect that credentialing does not actually expose this operation." ;
	<urn:solutiondesign:ontology:path> "/credentials/{educatorId}/last-issuance" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Would return an educator's most recent credential issuance date, for college-course SCECH eligibility (course must post-date last issuance)." .

<urn:solutiondesign:instance:credentialing:ManualReviewReasons> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "List of reasons requiring review (multiple reasons possible): ProfessionalPracticeHold, AssessmentResultsMissing, DocumentsIncomplete, SpecialistReview, PolicyException." ;
	<urn:solutiondesign:ontology:name> "ManualReviewReasons" .

<urn:solutiondesign:instance:credentialing:ManualReviewRequired> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Boolean flag; true when business rules determine human review is needed." ;
	<urn:solutiondesign:ontology:name> "ManualReviewRequired" .

<urn:solutiondesign:instance:credentialing:MttcPearsonInterfaceDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "technical-design" ;
	<urn:solutiondesign:ontology:notes> "Interface specification for the Pearson MTTC score feed: a monthly, one-way, manually-retrieved fixed-width file download over HTTPS GET from a Pearson-hosted website (Data Volume 4MB/month, PROD only, 'Incoming File (Prod & Test): N/A (manual process today)'). Read in full for this ingestion per the task brief's instruction to check it against the MTTC/Pearson integration-status discrepancy." ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied-fdds/functional-design-docs/11 - Educator Credentialing/Interface Design document - MTTC EdReports (Pearson).docx" .

<urn:solutiondesign:instance:credentialing:Op_AdminIssuePermit> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:credentialing:CredentialApplicationAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "adminIssuePermit" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:credentialing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/applications/permits/admin-issue" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:credentialing:IssuedCredentialAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is a permit-flavored CredentialApplication (credentialDefinitionId, recipientUniqueId, validFrom/To, justification, mentorAssignment); response returns credentialId + certificatePdfUrl directly rather than an application status, since this path's happy path issues synchronously — see credentialing-domain.md's Auto-Approval framing for permits." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit temporary permit application (standard org-submitted path)" ;
	<urn:solutiondesign:ontology:tags> "Permits" .

<urn:solutiondesign:instance:credentialing:Op_ApproveApplication> a <urn:solutiondesign:ontology:ApiOperation> ;
