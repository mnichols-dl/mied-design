	<urn:solutiondesign:ontology:path> "/assessment-definitions/{definitionId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionVersion> ;
	<urn:solutiondesign:ontology:projection> "Response is just the new versionId — creates a new version, per Credential Definition Versioning (applies uniformly across all three definition types)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update assessment definition (admin)" ;
	<urn:solutiondesign:ontology:tags> "Definitions" .

<urn:solutiondesign:instance:credentialing:Op_UpdateCredentialDefinition> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:credentialing:CredentialDefinitionAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:operationId> "updateCredentialDefinition" ;
