	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/epp-providers/{eppCode}/proprepconfig" ;
	<urn:solutiondesign:ontology:projection> "Same visibility-override subset as Op_GetProprepConfig, not the full provider aggregate." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update Pro Prep catalog visibility" ;
	<urn:solutiondesign:ontology:tags> "EPP Providers" .

<urn:solutiondesign:instance:epp:OrganizationReference> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Immutable reference to the EEM organization this EPP designation overlays (FICE code, organization code)." ;
	<urn:solutiondesign:ontology:name> "OrganizationReference" .

<urn:solutiondesign:instance:epp:Perm_AdminSystem> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Full administrative access to EPP domain" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:epp:Cat_Administration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Super admin - all EPP functions across all providers. A blanket super-permission, not tied to any single operation; epp-api.yml's per-operation x-permissions-required lists never name it directly (e.g. createEppProvider is gated by epp.provider.create), so no sd:PermissionRequirement is modeled for it here — it is presumed to satisfy every other permission's check at the authorization-layer level, which is outside what an individual PermissionRequirement can express." ;
	<urn:solutiondesign:ontology:permissionId> "epp.admin.system" .

<urn:solutiondesign:instance:epp:Perm_ApplicationsRecommend> a <urn:solutiondesign:ontology:Permission> ;
