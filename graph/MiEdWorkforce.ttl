	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Personnel search' page with a multi-field search form (Unique ID, First/Last name, Email, Credential number, Application number, DOB, SSN) and a results table (Unique ID/First/Last/Email/DOB/SSN) with a 'Compare' action. Directly corroborates staff:Op_SearchEmployees and Req_24_BizSpec_1's search-before-add step." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/24-request-for-id-collection/wireframes/wireframe-01-person-search-results.png" .

<urn:solutiondesign:instance:staffing:Wireframe24_2> a <urn:solutiondesign:ontology:SourceDocument> ;
