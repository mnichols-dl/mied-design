<urn:solutiondesign:instance:epp:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "permissions" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/epp/epp-permissions.md" .

<urn:solutiondesign:instance:epp:ProfessionalPracticeAnswers> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Disclosure responses from the applicant, present when the conviction flag is set." ;
	<urn:solutiondesign:ontology:name> "ProfessionalPracticeAnswers" .

<urn:solutiondesign:instance:epp:Question_AlternativePassRules> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What are the specific business rules for 'Alternative Pass' tracking on the Teacher credential application list, and how does this differ from standard MTTC pass requirements? (Open Question #5)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Rule_EPPRecommendationRequiresMTTCPass> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_ConvictionReviewInformationScope> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "When a candidate has a conviction flag, what Professional Practice information does the EPP need to see in order to make their recommendation decision? (Open Question #10)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Rule_ConvictionFlagManualReview> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_CrossEPPEnrollmentConflicts> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can a candidate be enrolled at multiple EPPs simultaneously, and if so, should the system detect or prevent enrollment conflicts across EPPs? (Open Question #2)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_EndorsementApprovalRequestWorkflow> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Is there a workflow for EPPs to request new endorsement approvals from the state, or is this handled entirely outside the system? (Open Question #6)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_EnrollmentRecordRetention> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What retention policy applies to candidate enrollment records after a candidate exits or completes their program? (Open Question #7)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_EnrollmentStatusTransitionOrdering> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Partially resolved by FDD 25.2.4/25.2.5: the valid status SET per route is now known (Traditional excludes Placed (Alt); Alternative excludes Student Teaching (Trad)/Post Student Teaching (Trad)). Still open: the exact transition ordering/graph within each route (e.g. can a Traditional candidate move directly from Enrolled to Exited without passing through Student Teaching?) isn't specified by either FDD. (Open Question #1)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Rule_EnrollmentStatusStateMachine> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_EppWorklistAdminIsCredentialingScreen> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "FDD 13's Feature 13.3 (Worklist) presents 'an administrative page to manage worklists used by EPP Processing staff' (13.3.1) as EPP's own admin capability, illustrated with a wireframe (word/media/image17.png, extracted as epp:WireframeWorklistManagement) whose own breadcrumb reads 'Credentialing Data > Worklist Management' and whose visible worklist names (Desktop/Dashboard Full/Dashboard Component Credentialing Worklist, Mobile Worklist) are all Credentialing-scoped. Either (a) this FDD reused a Credentialing screenshot as a placeholder without updating it for EPP's own worklist names, which would mean the ACTUAL EPP worklist-admin screen is simply undocumented, or (b) 'EPP worklist administration' and 'Credentialing worklist administration' are genuinely meant to be the SAME shared admin screen/capability (consistent with FDD 5's own framing, per epp:Question_WorklistAssignmentScope, of worklist assignment as covering EPP, School District, and Applicant worklists together under one Credentialing System Admin function) — in which case Feature 13.3 shouldn't be modeled as an EPP-owned capability at all. Not resolved here; flagged as a discrepancy worth a product-owner check rather than guessed at." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Req_13_3_1> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_ProPrepPublicCatalogFieldGaps> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "FDD 31.4 ('Public Search - Pro Prep') requires City and Website as public provider search/result fields, and a Program-level Code/Grade Band/Availability/Classification shown on the public 'Available Providers' page — none of city, website, or a program-level code/availability/classification field exists anywhere in this domain's data model (EppProviderDetail's organizationAddress is an unstructured string) or in the Organizations capability. epp-api.yml's /pro-prep/* public endpoints omit City/Website and stand in certificateType/endorsementCode for the missing program Code. Does City/Website belong on the EEM organization record (extending Organizations), or as EPP-Admin-editable fields via ProPrepConfig? Is 'Program' meant to be a cross-provider searchable catalog entity in its own right, rather than data nested per-provider under certificateCategories/endorsements? (Open Question #12)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Op_GetProPrepProviderDetail> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Op_SearchProPrepProviders> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_ProgramApprovalDateChangeWorkflow> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Is an approval workflow required for changes to EPP program approval dates, or can any authorized admin make changes immediately? (Open Question #9)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:Question_WorklistAssignmentScope> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Flagged as a possible exception to the 'worklist is just a filtered list' working assumption modeled throughout this domain. FDD 13 ('EPP - Admin'), Feature 13.3.1 describes an EPP Admin screen to 'manage worklists used by EPP Processing staff,' referring for access-level control to FDD 5 ('System Admin - Credentialing'), Wireframe 10/Feature 5.5, which describes a System Administrator - Credentialing user who can 'assign the specific worklist and/or report access to a user (individual level, not just the role level)' and manage a user's 'Worklist assignment'. This describes per-user assignment to specific named worklists, which is not derivable from CredentialApplicationReview/ApprovalApplicationReview's existing fields (license type, status, EPP scope) — it may be real routing/assignment behavior rather than the simple filtered-list pattern currently modeled by epp:Perm_ApplicationsView/epp:Perm_ApprovalsView. Also unclear whether this admin screen belongs to epp or credentialing (FDD 5 frames it as a Credentialing System Admin function covering EPP, School District, and Applicant worklists together). Not resolved here. (Open Question #11)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Perm_ApplicationsView> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:epp:Perm_ApprovalsView> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:epp:ReadingDiagnosticsFlag> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Whether EPP offers Reading Diagnostics; gates certification-search dropdown inclusion (FDD 13.1.2)." ;
	<urn:solutiondesign:ontology:name> "ReadingDiagnosticsFlag" .

<urn:solutiondesign:instance:epp:RecommendedEndorsement> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "An endorsement EPP recommends for the credential, with grade band." ;
	<urn:solutiondesign:ontology:name> "RecommendedEndorsement" .

<urn:solutiondesign:instance:epp:Req_13_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Navigate via hamburger menu > Education Prep Data & Management > Educator Prep Data > Providers; landing page accessible to the EPP Admin role; table shows Code [FICE]#, Name, Certificate Type (comma-separated), Pathway (comma-separated); search filters for Code/Name/Certificate Type/Pathway; Include/Exclude Closed EPPs toggle; Clear restores defaults; 'No results found' message when no matches; default view lists all EPPs." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — epp:Op_ListEppProviders (GET /epp-providers, EppProviderSummary projection: eppCode/organizationName/eppType/status/ficeCode) backs the search/list behavior; epp-api.ttl doesn't itemize this operation's query/filter parameters (sd:parameters is left unset on it), so the Certificate Type/Pathway/Closed-EPP filter fields aren't independently confirmed at the API-contract level, only at the aggregate-data level — a minor documentation gap, not a functional one. No dedicated sd:Sequence exists for 'search/browse EPP providers' in epp-sequences.ttl (all 12 of that file's sequences are for designate/update/manage-detail/candidate-tracking actions, not a plain browse flow) — Op_ListEppProviders alone is the right-sized citation here, consistent with the ontology's own preference for a Sequence 'when a relevant one exists.' Confirmed by viewing epp:Wireframe13_1. Comments 18/24/1299713688/2093175/1923023007 (a running, resolved 'does EPP Data sound good as a nav label?' naming thread from 2026-03 through 2026-04) are pure UI-copy bikeshedding on this same screen's breadcrumb label — folded in here rather than raised as their own Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "13.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_ListEppProviders> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to access a list of providers on the Manage Education Preparation Provider screen, so that I can review and manage approved EPPs and their programs." ;
	<urn:solutiondesign:ontology:title> "Access EPP provider list" .

<urn:solutiondesign:instance:epp:Req_13_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "'Create Education Provider' button; admin searches by Entity Name or EEM Entity Code; system auto-populates read-only Entity Name/Code/Address/Website/Phone from EEM; admin manually selects EPP Type (not stored in EEM); admin toggles 'Include Reading Diagnostics' and 'Include Special Ed Director/Supervisor' (gates certification-search dropdown inclusion); audit details (Last Modified By/On) captured on save." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "CITATION VERIFIED: epp:EducatorPreparationProviderAggregate's own sd:notes already cites 'FDD 13.1.2' as resolving Open Question #8 (what the Reading Diagnostics/Special Ed Director flags gate) — rereading the actual story text confirms that citation is accurate: this story states almost verbatim that these flags indicate 'if this EPP should appear in dropdowns for those specific certification searches.' Strong, direct match overall — Seq_DesignateEEMOrgAsEPP's own sequence diagram is essentially a step-by-step walkthrough of this exact story (search EEM org, retrieve read-only details, enter EPP-specific fields, submit)." ;
	<urn:solutiondesign:ontology:requirementId> "13.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_CreateEppProvider> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:ReadingDiagnosticsFlag> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_EPPMustReferenceValidEEMOrganization> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_DesignateEEMOrgAsEPP> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:SpecialEdDirectorFlag> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to add a new EPP by looking up their entity information from the Educational Entity Master (EEM), so that I can establish a new provider record without manually entering core demographic data." ;
	<urn:solutiondesign:ontology:title> "Add new EPP via EEM lookup" .

<urn:solutiondesign:instance:epp:Req_13_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Certificate Categories Allowed table on the EPP detail/create screen; Add specifying Certificate Type, Pathway, MDE Approval Date, Enrollment Close Date (Pro Prep), Recommend Close Date (MiEdWorkforce); Edit/Delete existing entries; date-order validation (e.g. Close Date cannot precede Approval Date)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, including the date-order validation (Seq_ManageCertificateCategoryApprovals's own keyDecisions: 'MDE Approval Date must precede Enrollment Close Date and Recommend Close Date') and the deletion-protection behavior (blocked if active candidate enrollments exist) neither this story's own AC text nor the HLS table mentions explicitly, but the sequence and epp:EducatorPreparationProviderAggregate's invariants both already model it — a case of the domain model being MORE complete than this particular story's stated AC, not less. Confirmed by viewing epp:Wireframe13_2 (inline table, matching field-for-field)." ;
	<urn:solutiondesign:ontology:requirementId> "13.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:ApprovedCertificateCategory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_AddCertificateCategory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_DeleteCertificateCategory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateCertificateCategory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ManageCertificateCategoryApprovals> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to manage the Certificate Categories (Programs) allowed for a provider, so that I can define which certificates they are authorized to offer." ;
	<urn:solutiondesign:ontology:title> "Manage certificate categories allowed" .

<urn:solutiondesign:instance:epp:Req_13_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Approved Endorsements table (Certificate Type/Endorsement/Status) on EPP detail and Create EPP screens; admin can remove (delete) an endorsement record; Add/Edit opens a detail view with read-only Grade Level and Code (from Manage Endorsement); admin updates MDE Approval Date/Enrollment Close Date (Pro Prep)/Recommend Close Date (MiEdWorkforce) independently for Initial Certification and Additional Endorsement types." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match. Confirmed by viewing epp:Wireframe13_3 (per-grade-band Initial Cert./Addl. Endorsement date-pair rows, field-for-field). Deletion-protection (blocked if active candidates pursuing the endorsement) again modeled at the sequence/aggregate level beyond this story's own stated AC, same pattern as 13.1.3." ;
	<urn:solutiondesign:ontology:requirementId> "13.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:ApprovedEndorsement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_AddEndorsement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_DeleteEndorsement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateEndorsement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ManageApprovedEndorsements> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to manage the specific endorsements attached to a provider's approved programs, so that I can control which subject areas they are authorized to recommend." ;
	<urn:solutiondesign:ontology:title> "Manage approved endorsements" .

<urn:solutiondesign:instance:epp:Req_13_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Contact table on EPP detail and Create EPP screens; Add a contact (Name, Title, Email Address, Phone); Edit/remove existing entries; Modified By/On audit fields update on save." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "Satisfied, with a documented shape difference: epp-api.ttl has no dedicated /epp-providers/{eppCode}/contacts endpoint — contacts travel inside the whole-provider Create/Update payload (both operations' sd:consumesShape epp:EducatorPreparationProviderAggregate, which sd:hasEntity epp:EPPContact) rather than as their own CRUD surface. This matches epp:Wireframe13_2's own inline Contact Information table (part of the single Edit EPP form, not a separate screen) — so the API shape and the wireframe agree with each other, just not with a naive reading of 'manage contacts' as implying its own endpoint set." ;
	<urn:solutiondesign:ontology:requirementId> "13.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:EPPContact> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_CreateEppProvider> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateEppProvider> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to add and manage contact information for a provider in a multi-row table, so that I can maintain accurate records of key personnel for communication purposes." ;
	<urn:solutiondesign:ontology:title> "Manage EPP contact information" .

<urn:solutiondesign:instance:epp:Req_13_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Accessible via Dashboard > Educator Prep Data & Management > Worklist Management; administrator can manage existing worklists for EPP business users." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no worklist-DEFINITION/administration concept exists anywhere in epp-domain.ttl/epp-api.ttl/epp-sequences.ttl — epp's own 'worklist' concept (per epp-domain.ttl's own Ubiquitous Language entry epp:UT_CredentialApplicationWorklist) is explicitly modeled as nothing more than CredentialApplicationReview/ApprovalApplicationReview's existing filtered list endpoints, with no admin-configuration surface behind it at all. Directly corroborates epp-domain.ttl's own epp:Question_WorklistAssignmentScope (Open Question #11), which already flagged this exact gap from FDD 5's side; this pass adds a second, independent piece of evidence FDD 5's framing was right: epp:WireframeWorklistManagement (viewed, embedded directly under THIS story's own acceptance-criteria text) is a screenshot of a 'Credentialing Data > Worklist Management' screen listing only Credentialing-named worklists. See Question_EppWorklistAdminIsCredentialingScreen below." ;
	<urn:solutiondesign:ontology:requirementId> "13.3.1" ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I need an administrative page to manage worklists used by EPP Processing staff so that the staff can track required tasks effectively." ;
	<urn:solutiondesign:ontology:title> "Administer worklists used by EPP Processing staff" .

<urn:solutiondesign:instance:epp:Req_13_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Access the worklist-management admin page; on an 'edit' screen, add predefined data fields to the worklist's display results; add/remove existing columns, applied on Save; worklist management includes visual indicators for 'Verified Candidates' and 'Pending Verification' items." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL: the 'visual indicators for Verified Candidates and Pending Verification items' half of this story is satisfied — epp:WireframeCandidatesStatusList (viewed, embedded directly under this story's text) is the Candidates screen's Verified/Pending-Verification tabs with color-coded status badges, an exact match to epp:EnrState_Enrolled/StudentTeachingTrad/PlacedAlt/Rejected/Inactive/Exited/PostStudentTeachingTrad already surfaced by Seq_SearchEnrolledCandidates/Seq_SearchPendingEnrollmentVerifications — i.e. this half of the story is really about the existing CandidateEnrollment list, not a 'worklist' in the CredentialApplicationReview sense. The OTHER half — a genuine column/field CUSTOMIZATION admin capability for any worklist — has no backing anywhere, same root cause as 13.3.1 (comment 68: 'This AC is not needed due to the EPP admin choosing the existing worklist from the list to edit' suggests even the reviewer wasn't confident this AC was well-formed). Also targeted by the coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "13.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_SearchEnrolledCandidates> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_SearchPendingEnrollmentVerifications> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I need the ability to edit predefined worklists by adding or removing data fields and columns so that I can customize the information displayed for EPP business users." ;
	<urn:solutiondesign:ontology:title> "Edit worklist columns; visual indicators for candidate status" .

<urn:solutiondesign:instance:epp:Req_13_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "The doc's own text literally says 'specifically for the Professional Learning module' here — a copy-paste artifact from another domain's FDD template, evidently not updated for EPP. Not itself substantive; noted as a minor authoring-quality issue, not raised as its own finding." ;
	<urn:solutiondesign:ontology:requirementId> "13.4" ;
	<urn:solutiondesign:ontology:statement> "All underlying logic for sending, tracking, and displaying emails, alerts and notifications are derived from Business Specification #6 (Alerts, Emails & Communications). This feature is strictly limited to the configuration of these tools (defining what is sent) specifically for [this] module. Additionally, Business Specification #4 (Business Rules Management) will specify when and to whom it is sent." ;
	<urn:solutiondesign:ontology:title> "Email/Comm configuration for EPP (pointer to Business Specification #6)" .

<urn:solutiondesign:instance:epp:Req_13_5> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:requirementId> "13.5" ;
	<urn:solutiondesign:ontology:statement> "All underlying logic for the display, organization, and rendering of the dashboard is derived from Business Specification #3 (Dashboards). This feature is strictly limited to the configuration of these elements (defining which tiles and reports are available to whom) specifically for the workflow." ;
	<urn:solutiondesign:ontology:title> "Dashboard configuration for EPP (pointer to Business Specification #3)" .

<urn:solutiondesign:instance:epp:Req_13_6> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "This is the FDD's own explicit, deliberate decision NOT to build file-queue management (view queue/status, Reset stuck files, Delete queued files, filter by status, view upload audit details — all listed in the main Business Specifications prose as candidate admin functionality) as an EPP-ADMIN-facing feature at all — a real decision, distinct from deferring it to another business specification. Consistent with epp-domain.ttl's own Bulk Upload sequences (epp:Op_InitiateBulkUpload/CompleteBulkUpload/BulkCreateEnrollments) already being modeled as plain internal-service/internal-user API operations with no admin-configuration surface of their own." ;
	<urn:solutiondesign:ontology:requirementId> "13.6" ;
	<urn:solutiondesign:ontology:statement> "The requirements for the EPP Admin to manage file queues (e.g., resetting 'stuck' files) and toggle upload availability should be considered outside scope of an administrative task. These functions are considered as technical management and maintenance tasks to be handled by developers." ;
	<urn:solutiondesign:ontology:title> "EPP Admin file-queue/upload-configuration management (declined as an admin feature)" .

<urn:solutiondesign:instance:epp:Req_13_7> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13_7Doc> ;
	<urn:solutiondesign:ontology:notes> "The main FDD's own Addendum (Feature: 13.7 Identity Management Integration) independently states the same conclusion in three words: 'This feature is no longer needed.' Both documents agree. FDD 15 (Identity Management Integration) is NOT itself reviewed as part of this pass — it isn't in this session's assignment, and its content wasn't cross-checked against the real iam bounded context conversion (iam-domain.ttl/iam-api.ttl exist in mied-v3, but whether they actually cover what FDD 15 describes is unconfirmed). Worth a GAPS.md-style note that FDD 15 remains an unreviewed dependency, even though the withdrawal itself is a clean rejection, not a gap." ;
	<urn:solutiondesign:ontology:requirementId> "13.7" ;
	<urn:solutiondesign:ontology:statement> "This feature was created to integrate the identity management functionality into the Educator Preparation Program processes. In system design, we have captured the full system requirements for identity management within Identity Management Integration (15.0), and thus this feature is no longer necessary." ;
	<urn:solutiondesign:ontology:title> "Identity Management Integration for EPP (feature withdrawn)" .

<urn:solutiondesign:instance:epp:Req_13_8_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Admin page for Pro Prep public page content; add/update hyperlinks and associated text; create/manage Alert Messages; define/manage Error and Validation text; manage Search Results table configurations." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL: Seq_ConfigureProPrepVisibility's own steps include 'Update page text, links, announcements' — matching the hyperlinks/text half. Alert Messages, Error/Validation text, and Search Results table configuration are NOT itemized anywhere in epp-domain.ttl/epp-api.ttl's Pro Prep config shape (Op_GetProprepConfig's own sd:projection describes only 'per-program visible flags, page text, links' — no alert/error-text/search-config fields). This is the same territory Feature 13.4's own Business-Specification-#6 deferral covers for alerts specifically, so the Alert-Messages sub-piece is arguably out-of-scope-by-the-same-logic rather than a fresh EPP gap; Error/Validation text and Search Results table config remain genuinely unaccounted for either way. Not split into a separate Annotation given how thin this remaining slice is relative to the rest of the story (per this convention's depth-calibration guidance) — captured here in notes instead." ;
	<urn:solutiondesign:ontology:requirementId> "13.8.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_GetProprepConfig> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateProprepConfig> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ConfigureProPrepVisibility> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to create and manage guidance text and alert messages on the Pro Prep public page, so that public users receive timely and accurate information." ;
	<urn:solutiondesign:ontology:title> "Manage Pro Prep public page guidance text and alerts" .

<urn:solutiondesign:instance:epp:Req_13_8_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Define/manage Headings; enter/update Text, Information, and Announcements; upload/link User Support materials visible to the public; rich text or standard formatting support (implied)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "Same 'page text, links, announcements' step as 13.8.1 covers headings/announcements loosely; uploadable/linkable 'User Support materials' as a distinct content type isn't itemized in Op_GetProprepConfig/UpdateProprepConfig's documented projection — likely the same undifferentiated 'page text, links' bucket, but not confirmed at the field level. Minor gap, not raised as a separate Annotation (same reasoning as 13.8.1)." ;
	<urn:solutiondesign:ontology:requirementId> "13.8.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateProprepConfig> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ConfigureProPrepVisibility> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to define page verbiage, including headings, announcements, and user support materials on the Pro Prep public page, so that I can control the public experience." ;
	<urn:solutiondesign:ontology:title> "Define Pro Prep public page verbiage" .

<urn:solutiondesign:instance:epp:Req_13_8_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Toggle/checkbox controls program visibility; unchecking hides the program from public search results immediately; default visibility follows the program's approval status unless manually overridden." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match — epp:EducatorPreparationProviderAggregate's own invariants text states almost verbatim 'an EPP Admin can also manually override visibility (hide early / extend) independent of the date rule,' and Seq_ConfigureProPrepVisibility's keyDecisions list 'Manual Override' and 'Immediate Effect' as named decisions. One of this FDD's cleanest matches." ;
	<urn:solutiondesign:ontology:requirementId> "13.8.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateProprepConfig> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_ProPrepVisibilityBasedOnCloseDates> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ConfigureProPrepVisibility> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want the ability to toggle the availability of a program on the public Pro Prep screen, so that I can control what is displayed based on review status." ;
	<urn:solutiondesign:ontology:title> "Toggle Pro Prep program visibility" .

<urn:solutiondesign:instance:epp:Req_13_8_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Configure which data elements display on the Manage Education Preparation Provider screen; admin can select to display Active Endorsements; admin can select to display [Pending] Endorsements; the Manage EPP screen view updates to reflect the configuration." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:notes> "Reasonable match via Op_GetProprepConfig/UpdateProprepConfig's 'per-program visible flags' projection and epp:ApprovedEndorsement's own Status field (plausibly Active/Pending as status values, though epp-domain.ttl never enumerates ApprovedEndorsement's Status vocabulary explicitly — a minor documentation gap in the base domain conversion, not newly introduced by this FDD). Note also this story's own AC text repeats 'display Endorsements' verbatim for what its narrative clearly means as 'Pending Endorsements' (a copy-paste-and-forgot-to-finish artifact, similar to Req_13_4's 'Professional Learning module' artifact) — read charitably as intended, not modeled as its own discrepancy." ;
	<urn:solutiondesign:ontology:requirementId> "13.8.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:ApprovedEndorsement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_GetProprepConfig> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateProprepConfig> ;
	<urn:solutiondesign:ontology:statement> "As an EPP Admin, I want to define which Pro Prep information, such as Active or Pending Endorsements, displays so that I can effectively manage the Pro Prep Page." ;
	<urn:solutiondesign:ontology:title> "Configure which Pro Prep information displays" .

<urn:solutiondesign:instance:epp:Req_25_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Navigate to the worklist via hamburger menu > Certificate Applications; freeform search bar (default text 'Type to search'); results table sorted ascending by Submitted Date with columns Application Number (hyperlink), First/Last Name, Student ID, Unique ID, Certificate Type, Has Conviction? (red font if Yes), Status, Submitted Date, Last Modified By, Summary (hyperlink, opens read-only); dropdown filters per the main Business Specifications list (Certificate Type, Status, Application #, First/Last Name, SSN, Unique ID, Student ID, Uses Alternative Pass? for Teacher only, plus Approval Category/Type for the Approval tab); Clear button restores defaults; 'No results found' messaging." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25WorklistDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: Op_SearchApplicationReviews's own ApplicationReviewSummary projection explicitly carries hasConviction/usesAlternativePass flags for exactly this red-font/Teacher-only-filter behavior. The Approval tab's own Approval Category/Type filter values (Teacher, Administrator, Other, Educated out-of-state Special Education Admin, Educated out-of-state School Social Worker, Permit) match epp:ApprovalCategory's description almost verbatim. Wireframe25_Worklist1 (confirmed by viewing) directly corroborates the tabbed worklist layout." ;
	<urn:solutiondesign:ontology:requirementId> "25.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_SearchApplicationReviews> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_SearchApprovalApplicationReviews> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Perm_ApplicationsView> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Perm_ApprovalsView> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_ConvictionFlagManualReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_SearchCredentialApplicationsForReview> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with Education Preparation Provider (EPP) permissions, I want to search and filter the worklist of credential applications, so that I can locate specific applications or groups of applications requiring my review." ;
	<urn:solutiondesign:ontology:title> "Search and filter the EPP credential application worklist" .

<urn:solutiondesign:instance:epp:Req_25_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking an Application Number opens the detailed review screen; the Applicant Name on that screen is a hyperlink to the Educator Profile page (current and historical demographic info); the review screen has a Details tab (Personal Information, Application Information, MTTC Information: Endorsement Name/Test Code/Has Passed?/Date Passed/Exam Date), an Internal Remarks tab (Comment/Created By/Date Created), and an Audit Log tab (User ID, date/time of status change, Previous Status, New Status)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25WorklistDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match for the Details/Internal Remarks/Audit Log tab structure (epp-sequences.ttl's own sequence names these tabs 'Details / MTTC Information / Internal Remarks / Audit Log' almost verbatim, and Op_GetRemarksHistory's projection is exactly the action/actionBy/actionAt shape the Audit Log tab needs). Wireframe25_AddendumApplicationReviewDetail (confirmed by viewing) directly corroborates this. The 'Educator Profile page' destination itself, however, is NOT modeled anywhere in this graph as a first-class thing — see Question_EducatorProfilePageNotModeled below (this is the first FDD 25 story to reference it, but not the first FDD in the batch to reference an 'Educator Profile' screen at all; FDD 17's own school-admin wireframe search flow references the same destination by name)." ;
	<urn:solutiondesign:ontology:requirementId> "25.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_AddInternalRemark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_GetApplicationReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_GetInternalRemarks> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_GetRemarksHistory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ViewCredentialApplicationDetailForReview> ;
	<urn:solutiondesign:ontology:statement> "As an EPP user reviewing a specific application, I need hyperlinks on the Application Number, so that I can view the detailed application status screen and the comprehensive Educator Profile page." ;
	<urn:solutiondesign:ontology:title> "Navigate from the worklist to application detail and the Educator Profile" .

<urn:solutiondesign:instance:epp:Req_25_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Navigate via Dashboard > Education Prep > Candidates; two tabs (Pending Verification, Verified Candidates); each tab has a freeform search bar, a results table (per-tab column set matching the Business Specifications section), the same filter set (Program Level, Program Type [Teacher/School Administrator only], First/Last Name, Student ID, Unique ID, plus Status and date ranges on the Verified tab), 'No results found' messaging, and the ability to download the worksheet as Word/Excel/PDF." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> ;
	<urn:solutiondesign:ontology:notes> "Search/filter/tab-switch behavior is a direct match (Wireframe25_CandTrack1 confirmed by viewing). The Word/Excel/PDF worksheet-download capability, however, has no counterpart anywhere in this graph: epp-api.ttl exposes only JSON list endpoints, documents-api.ttl has no table-export operation, and reporting-capability.ttl's own Rule_NotEveryDashboardIsAPowerBIReport explicitly argues this kind of simple UI-level table export should be a native in-domain component rather than a Reporting-capability concern — meaning it isn't Reporting's gap to fill either. See the coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "25.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_SearchCandidateEnrollments> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_SearchEnrolledCandidates> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_SearchPendingEnrollmentVerifications> ;
	<urn:solutiondesign:ontology:statement> "As an EPP user, I need to easily switch between Pending Verification and Verified Candidates lists on the Candidate Tracking worklist, so that I can efficiently manage candidates based on their enrollment status." ;
	<urn:solutiondesign:ontology:title> "Switch between Pending Verification and Verified Candidates worklists" .

<urn:solutiondesign:instance:epp:Req_25_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Select one or multiple Pending Verification records; Accept Enrollment and Reject Enrollment options become available; Reject sets status to Rejected and sends a templated notification email; Accept prompts for Enrollment Start Date/Program Level/Program(s)/Program Type then sets status to Enrolled and sends a notification email; both actions capture audit details (Modified By, Modified Date)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct, complete match — epp:Seq_AcceptCandidateEnrollment/Seq_RejectCandidateEnrollment already model exactly this bulk shape, including the notification-email trigger via comm:CommunicationsContext's subscription to both events." ;
	<urn:solutiondesign:ontology:requirementId> "25.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:CandidateEnrollmentRejectedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:CandidateEnrollmentVerifiedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_BulkAcceptEnrollments> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_BulkRejectEnrollments> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_AcceptCandidateEnrollment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_RejectCandidateEnrollment> ;
	<urn:solutiondesign:ontology:statement> "As an EPP user, I need to perform a bulk Accept or Reject Enrollment action on multiple candidates simultaneously from the Pending Verification list, to save time during verification." ;
	<urn:solutiondesign:ontology:title> "Bulk Accept or Reject enrollment on multiple Pending Verification candidates" .

<urn:solutiondesign:instance:epp:Req_25_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Save during Accept Enrollment, validate for duplicates defined as same Student/Unique ID + same EPP + same Program Level + same Program Type; block creation and display a clear error message if a duplicate is detected." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> ;
	<urn:solutiondesign:ontology:notes> "Matches epp:Seq_AcceptCandidateEnrollment's own key decision ('Duplicate Check: Prevents duplicate enrollment records for same candidate/EPP/program') and error scenario. Comment thread 18/20/21 in the source document shows the exact duplicate definition (Same EPP + Student/Unique ID + Program Level + Program Type for enrollment-level duplicates, distinct from Same Program + Grade Band for the program-level duplicate check in Rule_DuplicateProgramPrevention) was clarified during review — both concepts are present in this domain's model, just under different rules; not itself a gap." ;
	<urn:solutiondesign:ontology:requirementId> "25.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_AcceptCandidateEnrollment> ;
	<urn:solutiondesign:ontology:statement> "As an EPP user, when accepting enrollment, the system must check for duplicate record creation upon saving, preventing accidental double entry." ;
	<urn:solutiondesign:ontology:title> "Prevent duplicate enrollment records when accepting enrollment" .

<urn:solutiondesign:instance:epp:Req_25_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Verified Candidates worklist offers View/Add Program/Status Update radio options (View default); selecting one or multiple records + Add Program lets the user choose Program + Grade Band from dropdowns with Edit/Confirm/Delete before saving, blocking duplicates (same EPP + Student/Unique ID + Program + Grade Band); selecting Status Update changes status for multiple candidates to the route-appropriate set (Traditional: Enrolled/Student Teaching/Post Student Teaching/Inactive/Rejected/Exited; Alt Route: Enrolled/Placed/Inactive/Rejected/Exited), validates at least one program exists when moving to a placement status, and requires Exit Reason/Date on Exited or Program Detail/Enrollment Start Date on Rejected-to-Enrolled." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> ;
	<urn:solutiondesign:ontology:notes> "Status Update half is a direct, complete match (epp:Op_BulkUpdateCandidateStatus's own projection already conditionally requires exitDate/exitReason or enrollmentDate/programLevel/programType exactly as this story describes). The Add Program half is only PARTIALLY satisfied: epp-api.ttl's program-management operations (epp:Op_AddCandidateProgram et al.) all operate on a single enrollmentId — there is no bulk-add-program-to-multiple-candidates counterpart to Op_BulkUpdateCandidateStatus's bulk-status pattern. Wireframe25_CandTrack9 (confirmed by viewing) independently corroborates the route-restricted status set. See the coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "25.2.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_BulkUpdateCandidateStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_CandidateProgramAssignmentRequiredForPlacement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_DuplicateProgramPrevention> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_EnrollmentStatusStateMachine> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_UpdateCandidateEnrollmentStatus> ;
	<urn:solutiondesign:ontology:statement> "As an EPP user, I need the ability to Add Program and perform a Status Update (including Enrolled, Student Teaching, Placed, Exited) in bulk on the Verified Candidates list, to update large groups of candidates as they progress through the program." ;
	<urn:solutiondesign:ontology:title> "Bulk Add Program and Status Update on Verified Candidates" .

<urn:solutiondesign:instance:epp:Req_25_2_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking a candidate's name opens the individual profile on the Education tab (Enrolled Date, Program Level, EPP Provider, Status, Exit Date/Reason); an Edit modal allows changing Enrollment Date/Program Level/EPP Provider/Status (with Exit Date/Reason required for Exited, and Program Detail/Enrollment Start Date required for Rejected-to-Enrolled, plus the same at-least-one-program validation for placement statuses); a Program(s) table (Program Name/Type/Grade Band/Modified By/Modified Date) supports add/edit/delete via a modal." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct, complete match across both the detail-view and edit-modal halves of this story; Op_UpdateCandidateStatus's own projection (conditional exitDate/exitReason or enrollmentDate/programLevel/programType fields) matches this story's edit-modal validation exactly. Wireframe25_AddendumEducatorProfileEducationTab and Wireframe25_CandTrack10 (both confirmed by viewing) directly corroborate the Education tab layout and the cross-EPP toggle respectively." ;
	<urn:solutiondesign:ontology:requirementId> "25.2.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_AddCandidateProgram> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_DeleteCandidateProgram> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_GetCandidateEnrollment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateCandidateProgram> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_UpdateCandidateStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ManageCandidatePrograms> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ViewCandidateEnrollmentDetail> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_ViewCrossEPPEnrollmentHistory> ;
	<urn:solutiondesign:ontology:statement> "As an EPP User, I want to see a detailed view of a Verified Candidate, so that I can review their current enrollment status, program history, and toggle between viewing internal enrollment data and enrollment data from other providers." ;
	<urn:solutiondesign:ontology:title> "View and edit a Verified Candidate's detailed enrollment and program record" .

<urn:solutiondesign:instance:epp:Req_25_2_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking a Pending Verification candidate opens their profile with an 'Unverified Enrollment' alert; displays Program Type and a single-select action dropdown (Accept Enrollment / Reject Enrollment); Accept collects Enrollment Start Date + Program Level/Type (with duplicate check), sets status to Enrolled, and emails the candidate; Reject sets status to Rejected and emails the candidate; both save audit details; the screen also supports adding/editing/deleting programs (same duplicate rule as elsewhere: same Program + Grade Band)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> ;
	<urn:solutiondesign:ontology:notes> "Functionally this is the same accept/reject/program-management behavior as Req_25_2_2/25_2_4, exercised at the individual-candidate level rather than from a bulk-selected list — the existing bulk operations (accepting/rejecting an array of one candidateId) already cover this cleanly; no dedicated single-candidate accept/reject endpoint is needed and none is modeled separately. Wireframe25_AddendumAcceptEnrollmentReview (confirmed by viewing) directly corroborates this individual-level screen, including the editable Program(s) table alongside the Accept/Reject dropdown." ;
	<urn:solutiondesign:ontology:requirementId> "25.2.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_AddCandidateProgram> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_BulkAcceptEnrollments> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_BulkRejectEnrollments> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_AcceptCandidateEnrollment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_RejectCandidateEnrollment> ;
	<urn:solutiondesign:ontology:statement> "As an EPP User, I want to see a detailed view of a Pending Verification Candidate, so that I can review their current enrollment status to either Accept or Reject their Enrollment." ;
	<urn:solutiondesign:ontology:title> "View and act on an individual Pending Verification candidate" .

<urn:solutiondesign:instance:epp:Req_25_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Single-select Action dropdown (Select/Hold/Deny/Cancel/Recommend); Hold/Deny/Cancel collect Application Remarks (optional per this story's own text) and optional Internal Remarks, then set status accordingly; Recommend collects License Type and an endorsement table (Recommend checkbox, Endorsement Name, Code, Grade Band, Action by applicant, inline Edit/Delete, Add Endorsement), validates at least one endorsement is added/recommended, and on Submit routes in-state applicants to 'Pending Payment' or out-of-state applicants directly to the OEE/State Credential Admin worklist." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25WorklistDoc> ;
	<urn:solutiondesign:ontology:notes> "Excellent, near-exhaustive match: this story is essentially the narrative source epp-domain.md's Rule_EPPRecommendationTriggersPaymentOrOEEReview was itself built from (in-state -> Pending Payment / out-of-state -> OEE routing, worded almost identically). Wireframe25_Worklist3 (Recommend) and Wireframe25_Worklist4 (Deny) both confirmed by viewing. One genuine new detail: Wireframe25_Worklist4 shows a 'Send Email?' checkbox on the Deny action, matching this story's own 'Optional' framing for sending the Application Remarks email — the toggle itself isn't separately modeled anywhere (Communications owns the actual send mechanics), not raised as its own gap since it's a small UI/Communications-boundary detail, not an EPP-domain one." ;
	<urn:solutiondesign:ontology:requirementId> "25.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_CancelApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_DenyApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_HoldApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_RecommendApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_EPPProgramApprovalScope> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_EPPRecommendationRequiresMTTCPass> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_EPPRecommendationTriggersPaymentOrOEEReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_CancelCredentialApplicationReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_DenyCredentialApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_PlaceCredentialApplicationOnHold> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_RecommendCandidateForCredential> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with Education Preparation Provider (EPP) permissions, I want to perform specific actions (Hold, Deny, Cancel, or Recommend) on a candidate's detailed application screen, so that I can validate their endorsements against test scores and progress the application through the approval workflow." ;
	<urn:solutiondesign:ontology:title> "Hold, Deny, Cancel, or Recommend a credential application under EPP review" .

<urn:solutiondesign:instance:epp:Req_25_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Deny is a selectable Action option on Approval-tab applications; Remarks are required (submission blocked if blank); on submission, status updates to Deny, an email is sent to the originating ISD/School District, the application is removed from the EPP worklist and reassigned to the ISD/School District worklist, and the action (status change, remarks, Modified By, Action Date) is captured in the Approval Application History." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25WorklistDoc> ;
	<urn:solutiondesign:ontology:notes> "Exact match, down to the required-remarks validation and the History-capture fields — epp:Seq_DenyApprovalApplication's own error scenario ('Missing required remarks > Validation error') and event flow ('EventBus--)CredService: Return application to ISD/School District', 'EventBus--)CommService: Trigger notification to ISD with denial remarks') mirror this story almost verbatim. This story is also, in effect, the narrative source for Rule_ApprovalApplicationDenialReturnsToISD." ;
	<urn:solutiondesign:ontology:requirementId> "25.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_DenyApprovalApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Rule_ApprovalApplicationDenialReturnsToISD> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_DenyApprovalApplication> ;
	<urn:solutiondesign:ontology:statement> "As an EPP User, I want to deny an Approval application that does not meet program requirements, so that the system automatically notifies the requesting ISD/School District and returns the application to their worklist for resolution." ;
	<urn:solutiondesign:ontology:title> "Deny an Approval application and return it to the requesting ISD/School District" .

<urn:solutiondesign:instance:epp:Req_25_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Navigate Dashboard > Education Prep > Candidates, click Add Student dropdown > Upload; the system accepts files only matching the defined type/size/template; processes rows by the student's Unique ID, rejecting rows for students without an established MiEdWorkforce account/Unique ID; if the file includes Program Type/Level, validates the EPP is approved to offer those specific programs and errors on unapproved-program rows; on completion, provides a summary of successful updates plus a downloadable list of errors (e.g. 'Unique ID not found'); captures the uploader's Unique ID and upload timestamp in the audit log, distinguishing admin-on-behalf-of-EPP actions from EPP-user actions." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> ;
	<urn:solutiondesign:ontology:notes> "THIS IS THE STORY THAT RESOLVES the open question left in GAPS.md's FDD 29 entry ('Candidate Tracking and Recommendation (25)... unconfirmed whether epp:Seq_BulkUploadCandidateTrackingData actually covers what FDD 29's Dependencies section is pointing at'): CONFIRMED — epp:Seq_BulkUploadCandidateTrackingData's own error scenarios ('Unique ID not found in IAM > Skip row, include in error report'; 'Program not approved for EPP > Skip row, include in error report') and its Synapse-pipeline validate-then-partial-success-then-error-report flow match this story's acceptance criteria closely, feature for feature. Two minor, non-blocking gaps, neither large enough to warrant its own Annotation: (1) the modeled audit trail ('Capture audit trail with bulk upload job ID', plus 'uploadedBy' in the initiate payload) does not explicitly distinguish an admin acting on behalf of an EPP from the EPP user acting directly, which this story calls for; (2) HLS Use Case 34 ('System Admin downloads and extracts the submitted data') has no dedicated modeled operation — Wireframe25_AddendumCandidatesVerifiedAddStudent shows a download icon on the same screen as the Add Student upload trigger, a plausible fit for docs:Op_DownloadDocument against the staging container, but this is inferred, not confirmed by any caption or acceptance-criteria text." ;
	<urn:solutiondesign:ontology:requirementId> "25.4.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:BulkUploadCompletedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_BulkCreateEnrollments> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_CompleteBulkUpload> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_InitiateBulkUpload> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Perm_EnrollmentBulkUpload> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Seq_BulkUploadCandidateTrackingData> ;
	<urn:solutiondesign:ontology:statement> "As an EPP User or MiEdWorkforce System Admin user, I want to upload a bulk file for reporting teacher candidate tracking, so that I can efficiently enroll multiple verified candidates into my program and update their statuses without manual entry for each individual." ;
	<urn:solutiondesign:ontology:title> "Bulk-upload a file for reporting/updating candidate tracking data" .

<urn:solutiondesign:instance:epp:Req_31_4_10> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Message disappears automatically on a corrected search that yields results, or on clicking Clear/Clear Search (returns to default search state)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: same client-side chrome as 31.4.9. Folded into the out-of-scope UI-chrome Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.10" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the \"No results found\" message to disappear when I correct my search criteria or click Clear or Clear Search, so that the message does not persist once I initiate a new search." ;
	<urn:solutiondesign:ontology:title> "'No results found' message clears on corrected search or Clear" .

<urn:solutiondesign:instance:epp:Req_31_4_1> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Landing page displays hyperlink 'Educator Preparation Providers Search' below the banner; no login required; navigates to the Educator Preparation Provider Search Landing Page." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "The 'no login' half is confirmed by epp:Op_SearchProPrepProviders's sd:requiresAuth false. The landing-page-hyperlink placement itself is shared public-portal chrome — see cred:WireframeLandingPageThreeSearches (same landing page also serves cred:Req_31_1_1/plrn:Req_31_5_1) and the out-of-scope Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.1" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want a 'Educator Preparation Provider' Search hyperlink available on the MiEdWorkforce landing page, found below the MiEdWorkforce banner, so that I can access the search without logging in." ;
	<urn:solutiondesign:ontology:title> "Educator Preparation Providers Search hyperlink on landing page, no login" .

<urn:solutiondesign:instance:epp:Req_31_4_2> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Educator Preparation Providers Search Landing Page displays two selection options: a Providers button and a Programs button, switching search mode." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: epp-api.ttl only has one public search operation (epp:Op_SearchProPrepProviders, over providers). No equivalent 'search Programs' operation or Program-as-first-class-entity model exists — Program data only appears nested under a provider's certificateCategories/endorsements. See coverage-gap Annotation below, which corroborates the already-open epp:Question_ProPrepPublicCatalogFieldGaps (Open Question #12)." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.2" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want buttons to choose between searching for Providers or searching for Programs on the landing page." ;
	<urn:solutiondesign:ontology:title> "Providers vs. Programs search-mode toggle" .

<urn:solutiondesign:instance:epp:Req_31_4_3> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Search returns full and partial matches; strips leading/trailing spaces; retains embedded spaces." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match on the core search operation; the specific match-algorithm details (partial-match, whitespace handling) aren't independently modeled as a BusinessRule the way credentialing's public search has one, but the operation itself is the right target." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_SearchProPrepProviders> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, the system must search the database for matching Provider Name(s) and return full and partial matches." ;
	<urn:solutiondesign:ontology:title> "Search matching Provider Name(s), full/partial match" .

<urn:solutiondesign:instance:epp:Req_31_4_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Results list active providers only (closed/inactive excluded); columns: Provider Name (hyperlink), Program Type (comma-separated), Pathway (comma-separated), EPP Type, City, Website (hyperlink)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong partial match — epp:Op_SearchProPrepProviders's own sd:notes already flag exactly this gap: 'Does not return City or Website — see epp-domain.md Open Question #12.' This FDD story is independent confirmation that City/Website are real, needed fields, not speculative. See coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_SearchProPrepProviders> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, when searching Providers, I want the results table to display the following data of active providers: Provider Name, Program Type, Pathway, EPP Type, City, and Website (Hyperlink)." ;
	<urn:solutiondesign:ontology:title> "Provider results table: Name, Program Type, Pathway, EPP Type, City, Website" .

<urn:solutiondesign:instance:epp:Req_31_4_5> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Results list active programs only; columns: Program Name (hyperlink to Available Providers page), Program Code, Program Type, Classification." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no Program-search ApiOperation exists (see 31.4.2). epp:Wireframe31_4_4 (viewed directly) confirms this is a distinct results shape from the Provider search, not a filtered view of it." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.5" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, when searching Programs, I want the results table to display the following data of active programs: Program Name, Program Code, Program Type, and Classification." ;
	<urn:solutiondesign:ontology:title> "Program results table: Name, Code, Type, Classification" .

<urn:solutiondesign:instance:epp:Req_31_4_6> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Program Name hyperlink navigates to an Available Providers page listing Provider Name (hyperlink), Program Name/Code/Grade Band/Availability, Pathway, and provider website hyperlink." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this reverse Program-to-Providers lookup has no corresponding ApiOperation — same underlying gap as 31.4.2/31.4.5 (Program isn't modeled as a first-class searchable/addressable entity)." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.6" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, when I click the Program Name hyperlink in the program search results table, I want to be taken to the Available Providers page so I can see which institutions offer that specific program." ;
	<urn:solutiondesign:ontology:title> "Program Name links to Available Providers (reverse lookup)" .

<urn:solutiondesign:instance:epp:Req_31_4_7> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Filters for both Programs and Providers: Provider Name (dynamic), Program Type/Pathway/EPP Type (dropdowns, ascending alphabetical, values defined by EPP Admin per Feature 13.8), City (dynamic). 'Apply Filters'/'Reset Filters' buttons." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial match: epp:Op_SearchProPrepProviders has no sd:parameters property, so none of these filters (including the already-flagged-missing City) are promoted onto the operation today. See coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_SearchProPrepProviders> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want search filtering options available for Provider Name (dynamic filtering), Program Type (Dropdown), Pathway (dropdown), EPP Type (dropdown), and City (dynamic filtering) so I can refine my search for both programs and providers." ;
	<urn:solutiondesign:ontology:title> "Search filters: Provider Name, Program Type, Pathway, EPP Type, City" .

<urn:solutiondesign:instance:epp:Req_31_4_8> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Provider Detail page displays Contact Information (Address/Name/Title/Email/Phone) and an Available Programs list (Program Name hyperlink, Code, Grade Band, Availability)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "Good direct match — the operation's own projection already says 'contact info plus only currently-visible programs (certificate categories/endorsements)'." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.8" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:epp:Op_GetProPrepProviderDetail> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, when clicking a Provider Name, I want to see the 'Provider Details' page that includes Provider Contact Information (Address, Name, Title, Email, Phone), as well as a list of Available Programs." ;
	<urn:solutiondesign:ontology:title> "Provider Detail page: contact info and Available Programs" .

<urn:solutiondesign:instance:epp:Req_31_4_9> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Displays 'No results found' when a search yields no matching records." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd31_4Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: client-side validation-message behavior, no backend modeling expected. Folded into the out-of-scope UI-chrome Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.4.9" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the system to display a \"No results found\" message when my search criteria yield zero matches, so that I am notified when my search is unsuccessful." ;
	<urn:solutiondesign:ontology:title> "'No results found' validation message" .

<urn:solutiondesign:instance:epp:ReviewAction> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Action taken: Hold, Deny, Cancel, or Recommend." ;
	<urn:solutiondesign:ontology:name> "ReviewAction" .

<urn:solutiondesign:instance:epp:ReviewRemark> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Required remarks when denying; optional when recommending." ;
	<urn:solutiondesign:ontology:name> "ReviewRemark" .

<urn:solutiondesign:instance:epp:Rule_ApprovalApplicationDenialReturnsToISD> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:ApprovalApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:ApprovalApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_DenyApprovalApplication> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_DenyApprovalApplication> ;
	<urn:solutiondesign:ontology:example> "ISD submits approval application for alternative route teacher. EPP determines candidate lacks required coursework. EPP selects 'Deny', enters remarks explaining deficiency, submits. System sends email to ISD with remarks and returns the application to the ISD/School District for resolution." ;
	<urn:solutiondesign:ontology:rationale> "Approval applications originate from ISD/districts. EPP denial indicates the candidate doesn't meet program requirements; ISD must address before resubmission." ;
	<urn:solutiondesign:ontology:statement> "When an EPP denies an approval application, the application no longer appears in EPP's filtered application list and is reassigned to the ISD/School District for resolution. Denial requires mandatory Remarks." .

<urn:solutiondesign:instance:epp:Rule_CandidateProgramAssignmentRequiredForPlacement> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_BulkUpdateCandidateStatus> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_UpdateCandidateStatus> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_UpdateCandidateEnrollmentStatus> ;
	<urn:solutiondesign:ontology:example> "EPP attempts to mark candidate as 'Student Teaching (Trad)' but no program is assigned. System displays error: 'At least one General/Special Education or CTE Program is required for this status.'" ;
	<urn:solutiondesign:ontology:rationale> "Placement statuses indicate active teaching practice in a specific program area. System must track which program the candidate is completing." ;
	<urn:solutiondesign:ontology:statement> "A candidate cannot transition to Student Teaching (Trad) or Placed (Alt) status without at least one assigned program (Program Level + Grade Band)." .

<urn:solutiondesign:instance:epp:Rule_ConvictionFlagManualReview> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:ApprovalApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_SearchApplicationReviews> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_SearchApprovalApplicationReviews> ;
	<urn:solutiondesign:ontology:example> "Candidate with prior conviction submits credential application. EPP's application list displays the record in red font. EPP coordinator manually reviews conviction details and professional practice responses before deciding whether to recommend or deny." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by FDD 25.1/25.3 (Worklist and Recommendation): both the standard credential worklist and the Approval worklist describe 'Has Conviction' purely as a red-font UI indicator on the search-results table, with no described system-level block on Hold/Deny/Cancel/Recommend actions for flagged records — NOT a hard system block. The View Credential/Approval Application Detail for EPP Review sequences' optional PPR disclosure-summary lookup (via profp:DisclosuresOperation) matches the FDD's description of EPP reviewing 'Professional Practices' answers as context before deciding. No FDD evidence for a harder block." ;
	<urn:solutiondesign:ontology:rationale> "Professional practice concerns must be reviewed by EPP before state recommendation. Automated approval is inappropriate." ;
	<urn:solutiondesign:ontology:statement> "Credential applications and approval applications with 'Has Conviction' flag set to true require manual EPP review before recommendation. System highlights these records in red in the application list view." .

<urn:solutiondesign:instance:epp:Rule_DuplicateProgramPrevention> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_AddCandidateProgram> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_ManageCandidatePrograms> ;
	<urn:solutiondesign:ontology:example> "Candidate has 'Elementary Education - K-5' program already assigned. EPP attempts to add 'Elementary Education - K-5' again. System blocks with error message." ;
	<urn:solutiondesign:ontology:rationale> "Prevents data entry errors and maintains data integrity. Each program/grade band combination should appear once per enrollment." ;
	<urn:solutiondesign:ontology:statement> "A candidate cannot have duplicate programs within a single enrollment (same Program + Grade Band combination)." .

<urn:solutiondesign:instance:epp:Rule_EPPMustReferenceValidEEMOrganization> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_CreateEppProvider> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_DesignateEEMOrgAsEPP> ;
	<urn:solutiondesign:ontology:example> "Admin attempts to designate 'University of Michigan' as an EPP. System validates organization code exists in org-reference-data before allowing EPP-specific configuration. Admin cannot change university name or address - those must be updated in EEM and will sync automatically." ;
	<urn:solutiondesign:ontology:rationale> "EEM is the authoritative source for organization master data. EPP is an overlay designation, not a standalone entity." ;
	<urn:solutiondesign:ontology:statement> "An EPP can only be created for an organization that exists in the org-reference-data (synced from EEM). Core organization attributes cannot be modified in MiEdWorkforce." .

<urn:solutiondesign:instance:epp:Rule_EPPProgramApprovalScope> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_RecommendApplication> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_RecommendCandidateForCredential> ;
	<urn:solutiondesign:ontology:example> "EPP is approved for Teacher - Traditional Route with Elementary Education and Special Education endorsements. EPP attempts to recommend Secondary Mathematics endorsement. System prevents recommendation as it's not in EPP's approved list." ;
	<urn:solutiondesign:ontology:rationale> "EPPs are authorized by the state to prepare candidates only for specific programs. Recommendations outside scope are invalid." ;
	<urn:solutiondesign:ontology:statement> "An EPP can only recommend endorsements that are included in their approved endorsement list for the applicable certificate type." .

<urn:solutiondesign:instance:epp:Rule_EPPRecommendationRequiresMTTCPass> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_RecommendApplication> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_RecommendCandidateForCredential> ;
	<urn:solutiondesign:ontology:example> "Candidate applies for Elementary Education endorsement. EPP reviews application and sees MTTC Elementary Education test status is 'Not Passed'. System prevents recommendation until test is passed or alternative pathway is documented." ;
	<urn:solutiondesign:ontology:notes> "Open Question #5 (exact 'Alternative Pass' business rules and how they differ from standard MTTC pass requirements) is unresolved — see epp:Question_AlternativePassRules." ;
	<urn:solutiondesign:ontology:rationale> "State policy requires assessment validation before EPP recommendation for endorsement issuance." ;
	<urn:solutiondesign:ontology:statement> "An EPP cannot recommend an endorsement on a credential application unless the candidate has passed the corresponding MTTC test." .

<urn:solutiondesign:instance:epp:Rule_EPPRecommendationTriggersPaymentOrOEEReview> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_RecommendCandidateForCredential> ;
	<urn:solutiondesign:ontology:example> "In-state candidate receives EPP recommendation. Application status becomes 'Pending Payment'. Candidate receives notification to pay credential fee. Out-of-state candidate receives EPP recommendation. Application bypasses payment step and routes directly to the state reviewer for review." ;
	<urn:solutiondesign:ontology:notes> "Routing/payment itself is executed by the Credentialing domain's own workflow once epp:CredentialApplicationRecommendedEvent is consumed — this rule states EPP's side of the contract (what recommendation is supposed to trigger), not Credentialing's implementation, which epp-api.ttl's Dependency gap note (viaOperation omitted) already flags as unconfirmed on Credentialing's side." ;
	<urn:solutiondesign:ontology:rationale> "In-state applicants typically don't pay until EPP recommendation confirms eligibility. Out-of-state applicants pay upfront during application submission." ;
	<urn:solutiondesign:ontology:statement> "After EPP recommendation, in-state applications transition to 'Pending Payment' status and await fee payment. Out-of-state applications (already paid) route directly to OEE/State Credential Admin for review." .

<urn:solutiondesign:instance:epp:Rule_EnrollmentStatusStateMachine> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_BulkUpdateCandidateStatus> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_UpdateCandidateEnrollmentStatus> ;
	<urn:solutiondesign:ontology:example> "Traditional route candidate progresses: Enrolled > Student Teaching (Trad) > Post Student Teaching (Trad) > Exited (completion). Invalid transition: Post Student Teaching (Trad) cannot jump back to Enrolled without proper justification and exit/re-enrollment. An Alternative-route candidate is never offered 'Student Teaching (Trad)' or 'Post Student Teaching (Trad)' as status options at all (per FDD 25.2.4); a Traditional-route candidate is never offered 'Placed (Alt)'." ;
	<urn:solutiondesign:ontology:notes> "FDD 25.2.4/25.2.5 (Candidate Tracking) confirms the valid status SETS per route are themselves route-restricted, not just the transitions between them (Traditional: Enrolled, Student Teaching (Trad), Post Student Teaching (Trad), Inactive, Rejected, Exited — no Placed (Alt); Alternative: Enrolled, Placed (Alt), Inactive, Rejected, Exited — no Student Teaching (Trad)/Post Student Teaching (Trad)). The exact transition ORDERING/graph within each route beyond these sets is still unspecified by either FDD — see epp:Question_EnrollmentStatusTransitionOrdering (Open Question #1, partially resolved)." ;
	<urn:solutiondesign:ontology:rationale> "Program types have different preparation pathways. Status transitions must reflect realistic progression through each pathway." ;
	<urn:solutiondesign:ontology:statement> "Candidate enrollment status transitions must follow valid state machine paths defined separately for Traditional and Alternative route programs. Not all transitions are valid." .

<urn:solutiondesign:instance:epp:Rule_ProPrepVisibilityBasedOnCloseDates> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_GetProPrepProviderDetail> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Op_SearchProPrepProviders> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:epp:Seq_ConfigureProPrepVisibility> ;
	<urn:solutiondesign:ontology:example> "EPP has Elementary Education program with Enrollment Close Date of June 30, 2025. On July 1, 2025, this program no longer appears in public Pro Prep search results." ;
	<urn:solutiondesign:ontology:rationale> "Prevents candidates from enrolling in or pursuing programs that are no longer accepting new students or are being phased out." ;
	<urn:solutiondesign:ontology:statement> "EPP programs and endorsements are visible on the public Pro Prep catalog only if current date is before both Enrollment Close Date (Pro Prep) and Recommend Close Date (MiEdWorkforce), and EPP status is Active." .

<urn:solutiondesign:instance:epp:Seq_AcceptCandidateEnrollment> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n    participant CommService as Communications API\n\n    Coordinator->>UI: Select candidate(s) from Pending Verification list\n    Coordinator->>UI: Click \"Accept Enrollment\"\n\n    UI->>IAM: Verify permission (epp.enrollment.verify)\n    IAM-->>UI: Permission confirmed\n\n    UI->>Coordinator: Prompt for enrollment details\n    Note over UI: Enrollment Start Date (required)<br/>Program Level (required)<br/>Program Type (if applicable)\n\n    Coordinator->>UI: Enter enrollment details\n    Coordinator->>UI: Submit acceptance\n\n    UI->>EPPService: POST /candidate-enrollments/bulk-accept\n    Note over UI,EPPService: Payload: [candidateIds], enrollmentDate,<br/>programLevel, programType\n\n    EPPService->>EPPService: For each candidate: validate no duplicate enrollment\n\n    alt Duplicate enrollment detected\n        EPPService-->>UI: Error: Enrollment already exists\n        UI-->>Coordinator: Display duplicate error for specific candidates\n    else No duplicates\n        EPPService->>EPPService: Update CandidateEnrollment aggregates\n        Note over EPPService: State: PendingVerification > Enrolled\n        EPPService->>EPPService: Set enrollment date, program details\n        EPPService->>EPPService: Capture audit trail (Modified By, Date)\n\n        EPPService--)EventBus: CandidateEnrollmentVerified (for each)\n        EventBus--)CommService: Trigger enrollment confirmation email\n\n        EPPService-->>UI: Enrollments accepted\n        UI-->>Coordinator: Confirmation with count of accepted enrollments\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Duplicate enrollment > Block acceptance, display error for affected candidates. Missing required program type > Validation error. Invalid enrollment date > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "CandidateEnrollmentVerified - Triggers candidate notification email, may affect credentialing eligibility." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Bulk Operation: Supports single or multiple candidate acceptance. Duplicate Check: Prevents duplicate enrollment records for same candidate/EPP/program. Program Type: Required only for Teacher and School Administrator program levels." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Accept Candidate Enrollment" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator verifies and accepts candidate enrollment with enrollment date and program details. When: Candidate's enrollment information has been validated as correct. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_AddInternalRemarksToApplicationReview> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n\n    Coordinator->>UI: View application detail\n    Coordinator->>UI: Navigate to \"Internal Remarks\" tab\n\n    UI->>IAM: Verify permission (epp.applications.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /application-reviews/{applicationId}/internal-remarks\n    EPPService-->>UI: Existing internal remarks history\n\n    Coordinator->>UI: Enter new internal remark\n    Coordinator->>UI: Submit remark\n\n    UI->>EPPService: POST /application-reviews/{applicationId}/internal-remarks\n    Note over UI,EPPService: Payload: remarkText\n\n    EPPService->>EPPService: Create InternalRemark value object\n    EPPService->>EPPService: Associate with CredentialApplicationReview\n    EPPService->>EPPService: Capture author and timestamp\n\n    EPPService-->>UI: Remark added\n    UI->>EPPService: GET /application-reviews/{applicationId}/internal-remarks\n    EPPService-->>UI: Updated remarks list\n    UI-->>Coordinator: Display updated remarks\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Empty remark text > Validation error. User lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (internal notes only)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Internal Only: Remarks never visible to candidate, only to EPP staff. Audit Trail: Author and timestamp captured for accountability. No Status Change: Adding remarks does not change application review status." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Add Internal Remarks to Application Review" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator adds notes visible only to EPP staff. When: Documenting internal review discussions or tracking information. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_BulkUploadCandidateTrackingData> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User as EPP Coordinator/Admin\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant DocService as Document Service\n    participant IAM as Identity & Access API\n    participant Synapse as Azure Synapse Pipeline\n    participant EventBus as Event Bus\n\n    User->>UI: Navigate to \"Candidates\" > \"Upload\"\n    UI->>IAM: Verify permission (epp.enrollment.bulk-upload)\n    IAM-->>UI: Permission confirmed\n\n    User->>UI: Download template file\n    UI-->>User: CSV template with required columns\n\n    User->>UI: Upload completed file\n    UI->>DocService: POST /documents/staging/upload/request\n    DocService-->>UI: SAS token for staging container\n\n    UI->>DocService: Upload file to staging blob\n    DocService->>EPPService: POST /candidate-enrollments/bulk-upload/initiate\n    Note over DocService,EPPService: Payload: fileId, eppCode,<br/>uploadedBy, uploadDate\n\n    EPPService->>EPPService: Create bulk upload job record\n    EPPService--)Synapse: Trigger bulk processing pipeline\n    EPPService-->>UI: Upload initiated - job ID\n    UI-->>User: Upload accepted, processing in background\n\n    Note over Synapse: Synapse Pipeline processes file:<br/>1. Validate file format<br/>2. Validate Unique IDs exist in IAM<br/>3. Validate EPP program approvals<br/>4. Process valid records<br/>5. Generate error report\n\n    Synapse->>IAM: GET /users/by-unique-id/{uniqueId} (for each row)\n    IAM-->>Synapse: User validation\n\n    Synapse->>EPPService: GET /epp-providers/{eppCode}/approved-programs\n    EPPService-->>Synapse: Program validation\n\n    alt Validation errors found\n        Synapse->>DocService: Upload error report to staging\n        Synapse->>EPPService: POST /candidate-enrollments/bulk-upload/complete\n        Note over Synapse,EPPService: Status: PartialSuccess or Failed\n\n        EPPService--)EventBus: BulkUploadCompleted\n        EventBus--)User: Email notification with error report link\n    else All records valid\n        Synapse->>EPPService: POST /candidate-enrollments/bulk-create\n        EPPService->>EPPService: Create/update CandidateEnrollment aggregates\n        EPPService->>EPPService: Capture audit trail with bulk upload job ID\n\n        Synapse->>EPPService: POST /candidate-enrollments/bulk-upload/complete\n        Note over Synapse,EPPService: Status: Success\n\n        EPPService--)EventBus: BulkUploadCompleted\n        EventBus--)User: Email notification with success summary\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid file format > Reject entire file. Unique ID not found in IAM > Skip row, include in error report. Program not approved for EPP > Skip row, include in error report. Duplicate enrollment > Skip row, include in error report." ;
	<urn:solutiondesign:ontology:eventsPublished> "BulkUploadCompleted - Triggers notification email with results." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Staging Upload: Files uploaded to staging container for Synapse processing. Validation Sequence: Validate Unique IDs first, then program approvals. Partial Success: System processes valid records even if some rows fail validation. Error Reporting: Downloadable report identifies failing rows with reasons." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Bulk Upload Candidate Tracking Data" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator or EPP System Admin uploads file with candidate enrollment updates. When: EPP has batch data from internal student information system. Who: EPP Coordinator or EPP System Admin." .

<urn:solutiondesign:instance:epp:Seq_CancelCredentialApplicationReview> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n\n    Coordinator->>UI: View application detail\n    Coordinator->>UI: Select \"Cancel\" from Action dropdown\n\n    UI->>IAM: Verify permission (epp.applications.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>Coordinator: Prompt for Application Remarks (required)\n    UI->>Coordinator: Prompt for Internal Remarks (optional)\n\n    Coordinator->>UI: Enter cancellation reason\n    Coordinator->>UI: Submit cancellation\n\n    UI->>EPPService: POST /application-reviews/{applicationId}/cancel\n    Note over UI,EPPService: Payload: applicationRemarks,<br/>internalRemarks (optional)\n\n    EPPService->>EPPService: Update CredentialApplicationReview aggregate\n    Note over EPPService: State: Submitted > Cancelled\n    EPPService->>EPPService: Store ApplicationRemark (external)\n    EPPService->>EPPService: Store InternalRemark (if provided)\n    EPPService->>EPPService: Capture audit trail\n\n    EPPService-->>UI: Application cancelled\n    UI-->>Coordinator: Confirmation\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Missing application remarks > Validation error. User lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (internal status change only)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Application Remarks Required: External remarks document cancellation reason. No Notification: Cancel action typically does not trigger candidate email (candidate already aware). Final State: Cancelled is a terminal state." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Cancel Credential Application Review" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator cancels application (e.g., candidate withdrew). When: Application is no longer being pursued. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_ConfigureProPrepVisibility> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin as EPP System Admin\n    participant UI as EPP Admin UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n\n    Admin->>UI: Navigate to \"Pro Prep Settings\" for EPP\n    UI->>IAM: Verify permission (epp.proprepconfig.manage)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /epp-providers/{eppCode}/proprepconfig\n    EPPService-->>UI: Current Pro Prep visibility settings\n\n    Admin->>UI: Review certificate categories and endorsements\n    Note over UI: Display current visibility based on:<br/>- EPP status (Active/Closed)<br/>- Date comparisons (Enrollment Close, Recommend Close)\n\n    Admin->>UI: Toggle visibility for specific programs\n    Note over Admin,UI: Admin can override date-based visibility<br/>to hide programs early or extend availability\n\n    Admin->>UI: Update page text, links, announcements\n    Admin->>UI: Submit Pro Prep configuration\n\n    UI->>EPPService: PUT /epp-providers/{eppCode}/proprepconfig\n    EPPService->>EPPService: Update Pro Prep visibility flags\n    EPPService->>EPPService: Update page content/links\n    EPPService->>EPPService: Capture audit trail\n\n    EPPService-->>UI: Configuration updated\n    UI-->>Admin: Confirmation - changes live immediately\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid page content/links > Validation error. Attempt to make closed EPP visible > Block override." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (configuration change only, no domain events)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Date-Based Visibility: Default visibility based on Enrollment/Recommend Close Dates. Manual Override: Admin can manually hide programs even if dates allow visibility. Immediate Effect: Changes to Pro Prep settings take effect immediately." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Configure Pro Prep Catalog Visibility" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP System Admin toggles program visibility and manages Pro Prep display settings. When: Managing public-facing program availability for prospective educators. Who: EPP System Admin." .

<urn:solutiondesign:instance:epp:Seq_DenyApprovalApplication> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n    participant CommService as Communications API\n\n    Coordinator->>UI: View approval application detail\n    Coordinator->>UI: Select \"Deny\" from Action dropdown\n\n    UI->>IAM: Verify permission (epp.approvals.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>Coordinator: Prompt for Remarks (required)\n\n    Coordinator->>UI: Enter denial remarks\n    Coordinator->>UI: Submit denial\n\n    UI->>EPPService: POST /approval-application-reviews/{applicationId}/deny\n    Note over UI,EPPService: Payload: remarks (required)\n\n    EPPService->>EPPService: Validate remarks provided\n    alt Missing remarks\n        EPPService-->>UI: Validation error\n        UI-->>Coordinator: Display error - remarks required\n    else Remarks provided\n        EPPService->>EPPService: Update ApprovalApplicationReview aggregate\n        Note over EPPService: State: Submitted > Denied\n        EPPService->>EPPService: Store ReviewRemark\n        EPPService->>EPPService: Capture audit trail\n\n        EPPService--)EventBus: ApprovalApplicationDenied\n        EventBus--)CredService: Return application to ISD/School District\n        EventBus--)CommService: Trigger notification to ISD with denial remarks\n\n        EPPService-->>UI: Approval application denied\n        UI-->>Coordinator: Confirmation - returned to ISD with remarks\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Missing required remarks > Validation error. User lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "ApprovalApplicationDenied - Triggers return of the application to the ISD/School District and ISD notification with remarks." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Remarks Required: Denial must include explanation for ISD. ISD Return: Application routes back to the ISD/School District for resolution. ISD Notification: Email sent to ISD with denial remarks." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Deny Approval Application" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator denies approval application with required remarks (returns to the ISD/School District). When: Candidate doesn't meet EPP requirements for alternative route. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_DenyCredentialApplication> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n    participant CommService as Communications API\n\n    Coordinator->>UI: View application detail\n    Coordinator->>UI: Select \"Deny\" from Action dropdown\n\n    UI->>IAM: Verify permission (epp.applications.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>Coordinator: Prompt for Application Remarks (required)\n    UI->>Coordinator: Prompt for Internal Remarks (optional)\n\n    Coordinator->>UI: Enter denial remarks\n    Coordinator->>UI: Submit denial\n\n    UI->>EPPService: POST /application-reviews/{applicationId}/deny\n    Note over UI,EPPService: Payload: applicationRemarks,<br/>internalRemarks (optional)\n\n    EPPService->>EPPService: Update CredentialApplicationReview aggregate\n    Note over EPPService: State: Submitted > Denied\n    EPPService->>EPPService: Store ApplicationRemark (external)\n    EPPService->>EPPService: Store InternalRemark (if provided)\n    EPPService->>EPPService: Capture audit trail\n\n    EPPService--)EventBus: CredentialApplicationDenied\n    EventBus--)CredService: Update application status\n    EventBus--)CommService: Trigger denial notification email to candidate\n\n    EPPService-->>UI: Application denied\n    UI-->>Coordinator: Confirmation\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Missing application remarks > Validation error. User lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "CredentialApplicationDenied - Triggers status update in Credentialing domain and candidate notification." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Application Remarks Required: External remarks sent to candidate explaining denial reason. Status Update: Application status updated in Credentialing domain to reflect EPP denial. Candidate Notification: Candidate receives email with denial remarks." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Deny Credential Application" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator denies application with required remarks. When: Candidate doesn't meet EPP program requirements. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_DesignateEEMOrgAsEPP> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin as EPP System Admin\n    participant UI as EPP Admin UI\n    participant EPPService as EPP API\n    participant OrgRef as Organization Reference Data API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n\n    Admin->>UI: Navigate to \"Manage EPPs\"\n    UI->>IAM: Verify permission (epp.provider.create)\n    IAM-->>UI: Permission confirmed\n\n    Admin->>UI: Click \"Add New EPP\"\n    UI->>OrgRef: GET /organizations/search?query={searchTerm}\n    OrgRef-->>UI: List of EEM organizations\n\n    Admin->>UI: Select organization from search results\n    UI->>OrgRef: GET /organizations/{code}\n    OrgRef-->>UI: Organization details (name, address, FICE, fed code)\n\n    Admin->>UI: Enter EPP-specific configuration\n    Note over Admin,UI: EPP Type, Contacts, Certificate Categories,<br/>Endorsements, Reading Diagnostics flag,<br/>Special Ed Director flag\n\n    Admin->>UI: Add Certificate Category (cert type, pathway, dates)\n    Admin->>UI: Add Approved Endorsements for category\n    Admin->>UI: Submit EPP designation\n\n    UI->>EPPService: POST /epp-providers\n    EPPService->>OrgRef: GET /organizations/{code}\n    OrgRef-->>EPPService: Validate org exists\n\n    alt Organization not found in EEM\n        EPPService-->>UI: Error: Organization must exist in EEM\n        UI-->>Admin: Display error message\n    else Organization exists\n        EPPService->>EPPService: Create EducatorPreparationProvider aggregate\n        Note over EPPService: Link to EEM org, store EPP metadata\n        EPPService->>EPPService: Create ApprovedCertificateCategory entities\n        EPPService->>EPPService: Create ApprovedEndorsement entities\n\n        EPPService--)EventBus: EPPProviderCreated\n        EPPService-->>UI: EPP created successfully\n        UI-->>Admin: Confirmation with EPP code\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Organization code not found in EEM > Display error, prevent creation. Missing required certificate category > Validation error, require at least one." ;
	<urn:solutiondesign:ontology:eventsPublished> "EPPProviderCreated - Notifies downstream systems of new EPP availability." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "EEM Dependency: EPP cannot be created unless organization exists in org-reference-data (synced from EEM). Core Data Immutability: Organization name, address, federal codes are read-only from EEM. Program Approval Scope: At least one certificate category required for EPP to be active." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Designate EEM Organization as EPP" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP System Admin designates an existing EEM organization as an Educator Preparation Provider by adding EPP-specific configuration. When: An EEM organization receives state approval to become an educator preparation provider. Who: EPP System Admin." .

<urn:solutiondesign:instance:epp:Seq_ExitCandidateFromProgram> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n\n    Coordinator->>UI: Navigate to candidate detail\n    UI->>IAM: Verify permission (epp.enrollment.edit)\n    IAM-->>UI: Permission confirmed\n\n    Coordinator->>UI: Click \"Edit\" on enrollment status\n    UI->>Coordinator: Display status update modal\n\n    Coordinator->>UI: Select \"Exited\" status\n    UI->>Coordinator: Prompt for Exit Date and Exit Reason\n    Note over UI: Exit Reason examples:<br/>- Program Completion<br/>- Withdrew<br/>- Transferred to Another EPP<br/>- Other\n\n    Coordinator->>UI: Enter exit date and reason\n    Coordinator->>UI: Submit status update\n\n    UI->>EPPService: PATCH /candidate-enrollments/{enrollmentId}/status\n    Note over UI,EPPService: Payload: status=\"Exited\",<br/>exitDate, exitReason\n\n    EPPService->>EPPService: Validate exit date (not future date)\n\n    alt Invalid exit date\n        EPPService-->>UI: Validation error\n        UI-->>Coordinator: Display date error\n    else Valid exit date\n        EPPService->>EPPService: Update CandidateEnrollment status\n        Note over EPPService: State: {CurrentStatus} > Exited\n        EPPService->>EPPService: Store ExitInformation value object\n        EPPService->>EPPService: Capture audit trail\n\n        EPPService--)EventBus: CandidateExited\n        EPPService-->>UI: Candidate exited successfully\n        UI-->>Coordinator: Confirmation\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Future exit date > Validation error. Missing exit reason > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "CandidateExited - May affect credentialing application eligibility." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Exit Information Required: Both date and reason mandatory for Exited status. Date Validation: Exit date cannot be in the future. Program Completion Tracking: Exit reason distinguishes completion from withdrawal." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Exit Candidate from Program" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator marks candidate as Exited with exit date and reason. When: Candidate completes EPP program or withdraws. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_ManageApprovedEndorsements> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin as EPP System Admin\n    participant UI as EPP Admin UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n\n    Admin->>UI: Navigate to EPP detail page\n    UI->>EPPService: GET /epp-providers/{eppCode}\n    EPPService-->>UI: EPP configuration with approved endorsements\n\n    alt Add Endorsement\n        Admin->>UI: Click \"Add Endorsement\"\n        Admin->>UI: Select Certificate Type\n\n        UI->>CredService: GET /endorsement-definitions?certType={type}\n        CredService-->>UI: Available endorsements for cert type\n\n        Admin->>UI: Select Endorsement, Grade Level, Code\n        Admin->>UI: Select Type (Initial Certification, Additional Endorsement)\n        Admin->>UI: Enter MDE Approval Date, Enrollment Close Date, Recommend Close Date\n        Admin->>UI: Click \"Confirm\"\n\n        UI->>EPPService: POST /epp-providers/{eppCode}/endorsements\n\n        EPPService->>EPPService: Validate EPP has approved cert type\n        alt Cert type not approved\n            EPPService-->>UI: Error: Must approve certificate type first\n            UI-->>Admin: Display error\n        else Cert type approved\n            EPPService->>EPPService: Validate date order\n            EPPService->>EPPService: Create ApprovedEndorsement entity\n\n            EPPService--)EventBus: EPPProgramApprovalChanged\n            EPPService-->>UI: Endorsement added\n            UI-->>Admin: Confirmation\n        end\n\n    else Edit Endorsement\n        Admin->>UI: Click \"Edit\" on existing endorsement\n        Admin->>UI: Update dates or type\n        Admin->>UI: Submit changes\n\n        UI->>EPPService: PUT /epp-providers/{eppCode}/endorsements/{id}\n        EPPService->>EPPService: Update ApprovedEndorsement\n        EPPService->>EPPService: Capture audit trail\n\n        EPPService--)EventBus: EPPProgramApprovalChanged\n        EPPService-->>UI: Endorsement updated\n        UI-->>Admin: Confirmation\n\n    else Delete Endorsement\n        Admin->>UI: Click \"Delete\" on endorsement\n        UI->>EPPService: DELETE /epp-providers/{eppCode}/endorsements/{id}\n\n        EPPService->>EPPService: Check for active candidate programs with endorsement\n        alt Active candidates pursuing endorsement\n            EPPService-->>UI: Error: Cannot delete - active candidates\n            UI-->>Admin: Display error\n        else No active candidates\n            EPPService->>EPPService: Delete ApprovedEndorsement\n            EPPService--)EventBus: EPPProgramApprovalChanged\n            EPPService-->>UI: Endorsement deleted\n            UI-->>Admin: Confirmation\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Certificate type not approved > Block endorsement addition. Invalid date order > Validation error. Delete with active candidates > Block deletion." ;
	<urn:solutiondesign:ontology:eventsPublished> "EPPProgramApprovalChanged - May trigger Pro Prep catalog updates." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Certificate Type Dependency: Cannot add endorsement unless EPP has approved certificate type. Date Validation: Similar to certificate categories (MDE < Enrollment < Recommend). Deletion Protection: Cannot delete if active candidates are pursuing the endorsement." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Manage EPP Approved Endorsements" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP System Admin adds, edits, or removes specific endorsements within certificate types. When: EPP receives approval for new endorsements or existing endorsements are sunset. Who: EPP System Admin." .

<urn:solutiondesign:instance:epp:Seq_ManageCandidatePrograms> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n\n    Coordinator->>UI: Navigate to candidate detail > Programs tab\n    UI->>IAM: Verify permission (epp.enrollment.edit)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /candidate-enrollments/{enrollmentId}/programs\n    EPPService-->>UI: Current program assignments\n\n    alt Add Program\n        Coordinator->>UI: Click \"Add Program\"\n        UI->>EPPService: GET /epp-providers/{eppCode}/approved-programs\n        EPPService-->>UI: Available programs for EPP\n\n        Coordinator->>UI: Select Program and Grade Band\n        Coordinator->>UI: Click \"Confirm\"\n\n        UI->>EPPService: POST /candidate-enrollments/{enrollmentId}/programs\n\n        EPPService->>EPPService: Check for duplicate program (same program + grade band)\n        alt Duplicate detected\n            EPPService-->>UI: Error: Program already assigned\n            UI-->>Coordinator: Display duplicate error\n        else No duplicate\n            EPPService->>EPPService: Create EnrollmentProgram entity\n            EPPService->>EPPService: Capture audit trail\n            EPPService-->>UI: Program added\n            UI-->>Coordinator: Confirmation\n        end\n\n    else Edit Program\n        Coordinator->>UI: Click \"Edit\" on existing program\n        Coordinator->>UI: Update Grade Band\n        Coordinator->>UI: Submit changes\n\n        UI->>EPPService: PUT /candidate-enrollments/{enrollmentId}/programs/{programId}\n        EPPService->>EPPService: Update EnrollmentProgram\n        EPPService->>EPPService: Capture audit trail\n        EPPService-->>UI: Program updated\n        UI-->>Coordinator: Confirmation\n\n    else Delete Program\n        Coordinator->>UI: Click \"Delete\" on program\n        UI->>EPPService: DELETE /candidate-enrollments/{enrollmentId}/programs/{programId}\n\n        EPPService->>EPPService: Check enrollment status\n        alt Status requires program (StudentTeaching, Placed)\n            EPPService->>EPPService: Check remaining program count\n            alt Last program\n                EPPService-->>UI: Error: At least one program required for current status\n                UI-->>Coordinator: Display error\n            else Other programs exist\n                EPPService->>EPPService: Delete EnrollmentProgram\n                EPPService-->>UI: Program deleted\n                UI-->>Coordinator: Confirmation\n            end\n        else Status does not require program\n            EPPService->>EPPService: Delete EnrollmentProgram\n            EPPService-->>UI: Program deleted\n            UI-->>Coordinator: Confirmation\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Duplicate program > Block addition. Delete last program with status requiring program > Block deletion. Invalid program for EPP > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (internal enrollment update only)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Duplicate Prevention: Cannot add same program + grade band combination twice. Status Validation: Cannot delete last program if status is StudentTeaching or Placed. EPP Scope: Can only assign programs the EPP is approved to offer." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Manage Candidate Programs" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator adds, edits, or deletes programs assigned to enrolled candidate. When: Candidate adds/changes program concentrations or endorsements. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_ManageCertificateCategoryApprovals> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin as EPP System Admin\n    participant UI as EPP Admin UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n\n    Admin->>UI: Navigate to EPP detail page\n    UI->>EPPService: GET /epp-providers/{eppCode}\n    EPPService-->>UI: EPP configuration with certificate categories\n\n    alt Add Certificate Category\n        Admin->>UI: Click \"Add Certificate Category\"\n        Admin->>UI: Select Certificate Type, Pathway\n        Admin->>UI: Enter MDE Approval Date, Enrollment Close Date, Recommend Close Date\n        Admin->>UI: Click \"Confirm\"\n\n        UI->>EPPService: POST /epp-providers/{eppCode}/certificate-categories\n        EPPService->>EPPService: Validate date order (MDE < Enrollment < Recommend)\n\n        alt Invalid dates\n            EPPService-->>UI: Validation error\n            UI-->>Admin: Display date validation error\n        else Valid dates\n            EPPService->>EPPService: Create ApprovedCertificateCategory entity\n            EPPService--)EventBus: EPPProgramApprovalChanged\n            EPPService-->>UI: Category added\n            UI-->>Admin: Confirmation\n        end\n\n    else Edit Certificate Category\n        Admin->>UI: Click \"Edit\" on existing category\n        Admin->>UI: Update dates\n        Admin->>UI: Submit changes\n\n        UI->>EPPService: PUT /epp-providers/{eppCode}/certificate-categories/{id}\n        EPPService->>EPPService: Validate date order\n        EPPService->>EPPService: Update ApprovedCertificateCategory\n        EPPService->>EPPService: Capture audit trail\n\n        EPPService--)EventBus: EPPProgramApprovalChanged\n        EPPService-->>UI: Category updated\n        UI-->>Admin: Confirmation\n\n    else Delete Certificate Category\n        Admin->>UI: Click \"Delete\" on category\n        UI->>EPPService: DELETE /epp-providers/{eppCode}/certificate-categories/{id}\n\n        EPPService->>EPPService: Check for active candidate enrollments\n        alt Active enrollments exist\n            EPPService-->>UI: Error: Cannot delete - active enrollments\n            UI-->>Admin: Display error with enrollment count\n        else No active enrollments\n            EPPService->>EPPService: Delete ApprovedCertificateCategory\n            EPPService--)EventBus: EPPProgramApprovalChanged\n            EPPService-->>UI: Category deleted\n            UI-->>Admin: Confirmation\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid date order > Validation error, prevent save. Delete with active enrollments > Block deletion, display error. Attempt to add duplicate category/pathway > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "EPPProgramApprovalChanged - May trigger Pro Prep catalog updates." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Date Validation: MDE Approval Date must precede Enrollment Close Date and Recommend Close Date. Deletion Protection: Cannot delete certificate category if active candidate enrollments exist. Pro Prep Impact: Date changes affect public catalog visibility." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Manage EPP Certificate Category Approvals" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP System Admin adds, edits, or removes certificate type/pathway approvals with effective dates. When: State approves new programs for EPP or modifies existing program approvals. Who: EPP System Admin." .

<urn:solutiondesign:instance:epp:Seq_PlaceCredentialApplicationOnHold> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n    participant CommService as Communications API\n\n    Coordinator->>UI: View application detail\n    Coordinator->>UI: Select \"Hold\" from Action dropdown\n\n    UI->>IAM: Verify permission (epp.applications.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>Coordinator: Prompt for Application Remarks (required)\n    UI->>Coordinator: Prompt for Internal Remarks (optional)\n\n    Coordinator->>UI: Enter remarks\n    Coordinator->>UI: Submit hold action\n\n    UI->>EPPService: POST /application-reviews/{applicationId}/hold\n    Note over UI,EPPService: Payload: applicationRemarks,<br/>internalRemarks (optional)\n\n    EPPService->>EPPService: Update CredentialApplicationReview aggregate\n    Note over EPPService: State: Submitted > Hold\n    EPPService->>EPPService: Store ApplicationRemark (external)\n    EPPService->>EPPService: Store InternalRemark (if provided)\n    EPPService->>EPPService: Capture audit trail\n\n    EPPService--)EventBus: CredentialApplicationOnHold\n    EventBus--)CommService: Trigger hold notification email to candidate\n\n    EPPService-->>UI: Application placed on hold\n    UI-->>Coordinator: Confirmation\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Missing application remarks > Validation error. User lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "CredentialApplicationOnHold - Triggers candidate notification email." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Application Remarks Required: External remarks sent to candidate explaining hold reason. Internal Remarks Optional: Internal notes not visible to candidate. No Re-Routing: Application remains in EPP's filtered application list (status stays Hold) until EPP takes next action." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Place Credential Application on Hold" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator holds application with remarks explaining reason. When: Application needs additional information or clarification. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_RecommendApprovalApplication> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n    participant CommService as Communications API\n\n    Coordinator->>UI: View approval application detail\n    Coordinator->>UI: Select \"Recommend\" from Action dropdown\n\n    UI->>IAM: Verify permission (epp.approvals.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>Coordinator: Prompt for Remarks (optional)\n\n    Coordinator->>UI: Enter optional remarks\n    Coordinator->>UI: Submit recommendation\n\n    UI->>EPPService: POST /approval-application-reviews/{applicationId}/recommend\n    Note over UI,EPPService: Payload: remarks (optional)\n\n    EPPService->>EPPService: Update ApprovalApplicationReview aggregate\n    Note over EPPService: State: Submitted > Recommended by EPP\n    EPPService->>EPPService: Store ReviewRemark (if provided)\n    EPPService->>EPPService: Capture audit trail\n\n    EPPService--)EventBus: ApprovalApplicationRecommended\n    EventBus--)CredService: Return application to ISD/School District\n    EventBus--)CommService: Trigger notification to ISD\n\n    EPPService-->>UI: Approval application recommended\n    UI-->>Coordinator: Confirmation - returned to ISD\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "ApprovalApplicationRecommended - Triggers return of the application to the ISD/School District and ISD notification." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Remarks Optional: Unlike denial, recommendation remarks are optional. ISD Return: Application routes back to the ISD/School District, not to state OEE. No Direct Approval: EPP recommendation is not final approval; ISD/district retains control." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Recommend Approval Application" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator recommends approval application (returns to the ISD/School District). When: Candidate meets alternative route requirements. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_RecommendCandidateForCredential> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n    participant BRM as Business Rule Engine\n    participant EventBus as Event Bus\n    participant CommService as Communications API\n\n    Coordinator->>UI: View application detail\n    Coordinator->>UI: Select \"Recommend\" from Action dropdown\n\n    UI->>IAM: Verify permission (epp.applications.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>CredService: GET /applications/{applicationId}/requested-endorsements\n    CredService-->>UI: Endorsements requested by candidate\n\n    UI->>CredService: GET /applications/{applicationId}/mttc-results\n    CredService-->>UI: MTTC test results\n\n    UI->>EPPService: GET /epp-providers/{eppCode}/approved-endorsements\n    EPPService-->>UI: Endorsements EPP can recommend\n\n    UI->>Coordinator: Display endorsement selection grid\n    Note over UI: Grid shows:<br/>- Recommend (checkbox)<br/>- Endorsement Name<br/>- Code, Grade Band<br/>- Action by Applicant<br/>- Action (Edit/Add)\n\n    Coordinator->>UI: Select/adjust endorsements to recommend\n\n    opt Add additional endorsement\n        Coordinator->>UI: Click \"Add Endorsement\"\n        UI->>Coordinator: Show endorsement picker (EPP approved only)\n        Coordinator->>UI: Select endorsement, grade band\n    end\n\n    Coordinator->>UI: Enter Internal Remarks (optional)\n    Coordinator->>UI: Submit recommendation\n\n    UI->>EPPService: POST /application-reviews/{applicationId}/recommend\n    Note over UI,EPPService: Payload: recommendedEndorsements[],<br/>internalRemarks (optional)\n\n    EPPService->>EPPService: Validate at least one endorsement selected\n    alt No endorsements selected\n        EPPService-->>UI: Validation error\n        UI-->>Coordinator: Display error - must recommend at least one endorsement\n    else Endorsements selected\n        EPPService->>BRM: Validate endorsements against EPP approved list\n        BRM-->>EPPService: Validation result\n\n        alt Endorsement not approved for EPP\n            EPPService-->>UI: Validation error\n            UI-->>Coordinator: Display error - endorsement not in EPP scope\n        else All endorsements valid\n            EPPService->>CredService: GET /applications/{applicationId}/mttc-results\n            CredService-->>EPPService: MTTC results\n\n            EPPService->>BRM: Validate MTTC pass for each endorsement\n            BRM-->>EPPService: MTTC validation result\n\n            alt MTTC not passed for endorsement\n                EPPService-->>UI: Warning - MTTC not passed\n                UI-->>Coordinator: Display warning (allow override if Alternative Pass)\n            else MTTC passed or Alternative Pass\n                EPPService->>EPPService: Update CredentialApplicationReview aggregate\n                Note over EPPService: State: Submitted > Recommended\n                EPPService->>EPPService: Create RecommendedEndorsement entities\n                EPPService->>EPPService: Store InternalRemark (if provided)\n                EPPService->>EPPService: Capture audit trail\n\n                EPPService--)EventBus: CredentialApplicationRecommended\n                EventBus--)CredService: Route to payment (in-state) or OEE (out-of-state)\n                EventBus--)CommService: Trigger recommendation confirmation email\n\n                EPPService-->>UI: Application recommended\n                UI-->>Coordinator: Confirmation\n            end\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "No endorsements selected > Validation error. Endorsement not in EPP approved list > Validation error. MTTC not passed (without Alternative Pass) > Warning, require override. User lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "CredentialApplicationRecommended - Triggers payment workflow (in-state) or OEE routing (out-of-state), sends candidate notification." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Endorsement Validation: Must recommend at least one endorsement within EPP's approved scope. MTTC Validation: System validates MTTC pass status for each endorsement. Alternative Pass Override: Coordinator can proceed if candidate used alternative assessment pathway. Routing Logic: In-state applications route to payment; out-of-state to OEE/State Credential Admin for review." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Recommend Candidate for Credential" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator recommends application with selected endorsements. When: Candidate meets EPP program and assessment requirements. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_RejectCandidateEnrollment> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n    participant CommService as Communications API\n\n    Coordinator->>UI: Select candidate(s) from Pending Verification list\n    Coordinator->>UI: Click \"Reject Enrollment\"\n\n    UI->>IAM: Verify permission (epp.enrollment.verify)\n    IAM-->>UI: Permission confirmed\n\n    UI->>Coordinator: Confirm rejection\n    Coordinator->>UI: Confirm rejection\n\n    UI->>EPPService: POST /candidate-enrollments/bulk-reject\n    Note over UI,EPPService: Payload: [candidateIds]\n\n    EPPService->>EPPService: Update CandidateEnrollment aggregates\n    Note over EPPService: State: PendingVerification > Rejected\n    EPPService->>EPPService: Capture audit trail (Modified By, Date)\n\n    EPPService--)EventBus: CandidateEnrollmentRejected (for each)\n    EventBus--)CommService: Trigger rejection notification email\n\n    EPPService-->>UI: Enrollments rejected\n    UI-->>Coordinator: Confirmation with count of rejected enrollments\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Enrollment not in PendingVerification status > Invalid state transition error." ;
	<urn:solutiondesign:ontology:eventsPublished> "CandidateEnrollmentRejected - Triggers candidate notification email." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Bulk Operation: Supports single or multiple candidate rejection. No Remarks Required: Rejection does not require explanation (unlike application denial)." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Reject Candidate Enrollment" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator denies enrollment verification with notification to candidate. When: Candidate's enrollment information is incorrect or candidate not actually enrolled. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_SearchApprovalApplicationsForReview> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n\n    Coordinator->>UI: Navigate to \"Certificate Applications\" > \"Approval\" tab\n    UI->>IAM: Verify permission (epp.approvals.review)\n    IAM-->>UI: Permission confirmed with EPP scope\n\n    UI->>EPPService: GET /approval-application-reviews?eppCode={userEppCode}&status=Submitted\n    EPPService->>CredService: GET /applications/approvals?eppCode={eppCode}\n    CredService-->>EPPService: Approval application IDs requiring EPP review\n\n    EPPService->>EPPService: Query ApprovalApplicationReview for EPP's reviews\n    EPPService-->>UI: List of approval applications requiring EPP review\n\n    Coordinator->>UI: Enter filter criteria\n    Note over Coordinator,UI: Status, Application #,<br/>First Name, Last Name,<br/>SSN, Unique ID, Student ID,<br/>Approval Category, Approval Type\n\n    Coordinator->>UI: Click \"Search\"\n    UI->>EPPService: GET /approval-application-reviews?filters={criteria}\n\n    EPPService->>EPPService: Apply filters to ApprovalApplicationReview query\n    EPPService->>EPPService: Filter by EPP scope from user context\n\n    alt No results found\n        EPPService-->>UI: Empty result set\n        UI-->>Coordinator: Display \"No results found\"\n    else Results found\n        EPPService-->>UI: Filtered approval application review list\n        UI-->>Coordinator: Display results in table\n        Note over UI: Columns: Application Number (link),<br/>First Name, Last Name,<br/>Student ID, Unique ID,<br/>Approval Type, School District,<br/>Has Conviction? (red if Yes),<br/>Status, Submitted on,<br/>Last Modified By, Summary (link)\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Invalid filter values > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "EPP Scope: Results automatically filtered to coordinator's EPP only. Approval-Specific Filters: Approval Category and Approval Type replace Certificate Type. ISD Context: School District displayed to show originating ISD." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Search Approval Applications for Review" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator filters approval applications by category, type, status. When: EPP needs to review alternative route approval applications. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_SearchCredentialApplicationsForReview> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n\n    Coordinator->>UI: Navigate to \"Certificate Applications\"\n    UI->>IAM: Verify permission (epp.applications.review)\n    IAM-->>UI: Permission confirmed with EPP scope\n\n    UI->>EPPService: GET /application-reviews?eppCode={userEppCode}&status=Submitted,Hold\n    EPPService->>CredService: GET /applications?eppCode={eppCode}&status=SubmittedToEpp\n    CredService-->>EPPService: Application IDs requiring EPP review\n\n    EPPService->>EPPService: Query CredentialApplicationReview for EPP's reviews\n    EPPService-->>UI: List of applications requiring EPP review\n\n    Coordinator->>UI: Enter filter criteria\n    Note over Coordinator,UI: Certificate Type, Status,<br/>Application #, First Name, Last Name,<br/>SSN, Unique ID, Student ID,<br/>Uses Alternative Pass? (Teacher only)\n\n    Coordinator->>UI: Click \"Search\"\n    UI->>EPPService: GET /application-reviews?filters={criteria}\n\n    EPPService->>EPPService: Apply filters to CredentialApplicationReview query\n    EPPService->>EPPService: Filter by EPP scope from user context\n\n    alt No results found\n        EPPService-->>UI: Empty result set\n        UI-->>Coordinator: Display \"No results found\"\n    else Results found\n        EPPService-->>UI: Filtered application review list\n        UI-->>Coordinator: Display results in table\n        Note over UI: Columns: Application Number (link),<br/>First Name, Last Name,<br/>Student ID, Unique ID,<br/>Certificate Type, Has Conviction? (red if Yes),<br/>Status, Submitted Date,<br/>Last Modified By, Summary (link)\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Invalid filter values > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "EPP Scope: Results automatically filtered to coordinator's EPP only. Status Filter: Typically shows Submitted and Hold statuses. Conviction Highlighting: Applications with conviction flag displayed in red. Certificate Type Filtering: Alternative Pass filter only available for Teacher applications." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Search Credential Applications for Review" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator filters credential applications by certificate type, status, candidate info. When: EPP needs to locate applications requiring review. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_SearchEnrolledCandidates> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n\n    Coordinator->>UI: Navigate to \"Candidates\" > \"Verified Candidates\"\n    UI->>IAM: Verify permission (epp.enrollment.view)\n    IAM-->>UI: Permission confirmed with EPP scope\n\n    UI->>EPPService: GET /candidate-enrollments?status=Enrolled,StudentTeaching,PostStudentTeaching,Placed,Inactive,Rejected,Exited&eppCode={userEppCode}\n    EPPService-->>UI: List of verified enrollments\n\n    Coordinator->>UI: Enter filter criteria\n    Note over Coordinator,UI: Program Level, Program Type,<br/>First Name, Last Name,<br/>Student ID, Unique ID,<br/>Status, Enrollment Date Range\n\n    Coordinator->>UI: Click \"Search\"\n    UI->>EPPService: GET /candidate-enrollments?filters={criteria}\n\n    EPPService->>EPPService: Apply filters to CandidateEnrollment query\n    EPPService->>EPPService: Filter by EPP scope from user context\n\n    alt No results found\n        EPPService-->>UI: Empty result set\n        UI-->>Coordinator: Display \"No results found\"\n    else Results found\n        EPPService-->>UI: Filtered candidate enrollment list\n        UI-->>Coordinator: Display results in table\n        Note over UI: Columns: First Name (link), Last Name,<br/>Student ID, Unique ID,<br/>Program Level, Program(s),<br/>Status, Enroll Date,<br/>Exit Date, Exit Reason\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Invalid filter values > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "EPP Scope: Results automatically filtered to coordinator's EPP only. Multiple Statuses: Default includes all verified statuses except PendingVerification. Clickable Name: First Name is hyperlink to candidate detail view." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Search Enrolled Candidates" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator filters and searches candidates with verified enrollment status. When: EPP needs to review/manage current enrolled candidates. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_SearchPendingEnrollmentVerifications> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n\n    Coordinator->>UI: Navigate to \"Candidates\" > \"Pending Verification\"\n    UI->>IAM: Verify permission (epp.enrollment.verify)\n    IAM-->>UI: Permission confirmed with EPP scope\n\n    UI->>EPPService: GET /candidate-enrollments?status=PendingVerification&eppCode={userEppCode}\n    EPPService-->>UI: List of pending enrollments\n\n    Coordinator->>UI: Enter filter criteria\n    Note over Coordinator,UI: Program Level, Program Type,<br/>First Name, Last Name,<br/>Student ID, Unique ID\n\n    Coordinator->>UI: Click \"Search\"\n    UI->>EPPService: GET /candidate-enrollments?status=PendingVerification&filters={criteria}\n\n    EPPService->>EPPService: Apply filters to CandidateEnrollment query\n    EPPService->>EPPService: Filter by EPP scope from user context\n\n    alt No results found\n        EPPService-->>UI: Empty result set\n        UI-->>Coordinator: Display \"No results found\"\n    else Results found\n        EPPService-->>UI: Filtered candidate enrollment list\n        UI-->>Coordinator: Display results in table\n        Note over UI: Columns: First Name, Last Name,<br/>Student ID, Unique ID,<br/>Submitted Date, Program Level\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Invalid filter values > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "EPP Scope: Results automatically filtered to coordinator's EPP only. Status Filter: Hard-coded to PendingVerification status." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Search Pending Enrollment Verifications" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator filters and searches candidates awaiting enrollment verification. When: EPP needs to review new enrollment submissions from candidates. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_UpdateCandidateEnrollmentStatus> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant BRM as Business Rule Engine\n    participant EventBus as Event Bus\n\n    Coordinator->>UI: Select candidate(s) from Verified Candidates list\n    Coordinator->>UI: Click \"Status Update\" action\n\n    UI->>IAM: Verify permission (epp.enrollment.edit)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /candidate-enrollments/{enrollmentId}/available-transitions\n    EPPService->>BRM: Get valid status transitions for current status and EPP type\n    BRM-->>EPPService: Available next statuses\n    EPPService-->>UI: Valid status options\n\n    Coordinator->>UI: Select new status\n\n    alt Status = Exited\n        UI->>Coordinator: Prompt for Exit Date and Exit Reason\n        Coordinator->>UI: Enter exit information\n    else Status = Enrolled (from Rejected)\n        UI->>Coordinator: Prompt for Program Details and Enrollment Start Date\n        Coordinator->>UI: Enter enrollment details\n    end\n\n    Coordinator->>UI: Submit status update\n\n    UI->>EPPService: PATCH /candidate-enrollments/bulk-status-update\n    Note over UI,EPPService: Payload: [candidateIds], newStatus,<br/>exitInfo (if applicable),<br/>enrollmentInfo (if applicable)\n\n    EPPService->>EPPService: For each candidate: validate transition\n    EPPService->>BRM: Validate state machine rules\n\n    alt Invalid transition\n        BRM-->>EPPService: Validation error\n        EPPService-->>UI: Error: Invalid status transition\n        UI-->>Coordinator: Display error for affected candidates\n    else Valid transition\n        alt New status requires programs (StudentTeaching, Placed)\n            EPPService->>EPPService: Check if candidate has assigned programs\n            alt No programs assigned\n                EPPService-->>UI: Error: At least one program required\n                UI-->>Coordinator: Display error\n            else Programs exist\n                EPPService->>EPPService: Update CandidateEnrollment status\n                EPPService->>EPPService: Capture audit trail\n                EPPService--)EventBus: CandidateStatusChanged\n                EPPService-->>UI: Status updated\n                UI-->>Coordinator: Confirmation\n            end\n        else Status does not require programs\n            EPPService->>EPPService: Update CandidateEnrollment status\n            EPPService->>EPPService: Capture audit trail\n            EPPService--)EventBus: CandidateStatusChanged\n            EPPService-->>UI: Status updated\n            UI-->>Coordinator: Confirmation\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid state transition per state machine > Block update. Missing programs for StudentTeaching/Placed > Block update. Missing exit information when status = Exited > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "CandidateStatusChanged - Internal tracking, may inform other domains of candidate progress." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "State Machine Validation: Valid transitions differ by EPP type (Traditional vs Alternative). Program Requirement: StudentTeaching and Placed statuses require at least one assigned program. Bulk Operation: Supports single or multiple candidate status updates. Exit Information: Exit Date and Reason required when transitioning to Exited status." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Update Candidate Enrollment Status" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator changes candidate status along valid state machine path. When: Candidate progresses through program milestones. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_UpdateEPPConfiguration> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin as EPP System Admin\n    participant UI as EPP Admin UI\n    participant EPPService as EPP API\n    participant OrgRef as Organization Reference Data API\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n\n    Admin->>UI: Navigate to \"Manage EPPs\"\n    UI->>IAM: Verify permission (epp.provider.edit)\n    IAM-->>UI: Permission confirmed\n\n    Admin->>UI: Search and select EPP\n    UI->>EPPService: GET /epp-providers/{eppCode}\n    EPPService->>OrgRef: GET /organizations/{code}\n    OrgRef-->>EPPService: Organization details (read-only)\n    EPPService-->>UI: EPP configuration + org details\n\n    Note over UI: Display EEM data (name, address) as read-only\n\n    Admin->>UI: Update EPP-specific fields\n    Note over Admin,UI: EPP Type, Contacts,<br/>Reading Diagnostics flag,<br/>Special Ed Director flag\n\n    Admin->>UI: Submit updates\n    UI->>EPPService: PUT /epp-providers/{eppCode}\n\n    EPPService->>EPPService: Update EducatorPreparationProvider aggregate\n    EPPService->>EPPService: Capture audit details (Modified By, Modified Date)\n\n    EPPService--)EventBus: EPPProviderModified\n    EPPService-->>UI: Update successful\n    UI-->>Admin: Confirmation message\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Attempt to modify read-only org data > Validation error at UI level. Invalid EPP type > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "EPPProviderModified - Notifies downstream systems of configuration changes." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Read-Only EEM Data: Name, address, federal codes cannot be edited in MiEdWorkforce. EPP-Specific Updates Only: Only metadata unique to EPP role can be modified." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Update EPP Configuration" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP System Admin updates EPP-specific settings (type, contacts, flags, certificate categories, endorsements). When: EPP metadata needs to be updated (does NOT include core organization data like name/address). Who: EPP System Admin." .

<urn:solutiondesign:instance:epp:Seq_ViewApprovalApplicationDetailForReview> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n    participant PPR as Professional Practices API\n    participant OrgRef as Organization Reference Data API\n\n    Coordinator->>UI: Click application number from the approval application list\n    UI->>IAM: Verify permission (epp.approvals.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /approval-application-reviews/{applicationId}\n    EPPService-->>UI: EPP review record\n\n    UI->>CredService: GET /applications/approvals/{applicationId}\n    CredService-->>UI: Approval application details\n\n    UI->>IAM: GET /users/{candidateId}\n    IAM-->>UI: Candidate demographics\n\n    UI->>OrgRef: GET /organizations/{schoolDistrictCode}\n    OrgRef-->>UI: School district information\n\n    opt If Has Conviction flag = true\n        UI->>PPR: GET /educators/{candidateId}/disclosures\n        PPR-->>UI: Professional practice responses\n    end\n\n    UI->>EPPService: GET /approval-application-reviews/{applicationId}/history\n    EPPService-->>UI: Application action history\n\n    UI->>Coordinator: Display approval application review screen\n    Note over UI: Sections:<br/>- Applicant Information<br/>- Application Information<br/>- Other Information (School District,<br/>  Program Category, College/University,<br/>  Effective Date)<br/>- Application Acknowledgements<br/>- Professional Practices<br/>- Approval Application History\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Application not found > 404 error. School district not found in EEM > Display warning." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "ISD Context: School district and program category central to approval application review. Acknowledgements: Applicant attestations specific to approval category displayed. Professional Practice Integration: If conviction flag present, show PPR responses for review." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "View Approval Application Detail for EPP Review" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator views approval application including acknowledgements, professional practice responses. When: EPP needs to assess approval application before recommendation/denial. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_ViewCandidateEnrollmentDetail> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n    participant CredService as Credentialing API\n\n    Coordinator->>UI: Click candidate name from search results\n    UI->>IAM: Verify permission (epp.enrollment.view)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /candidate-enrollments/{enrollmentId}\n    EPPService-->>UI: Candidate enrollment details\n\n    UI->>IAM: GET /users/{candidateId}\n    IAM-->>UI: Candidate demographics (name, SSN, DOB, Student ID, Unique ID)\n\n    UI->>CredService: GET /educators/{candidateId}/credentials\n    CredService-->>UI: Credential history (if any)\n\n    UI->>EPPService: GET /candidate-enrollments/{enrollmentId}/programs\n    EPPService-->>UI: Assigned programs with grade bands\n\n    UI->>Coordinator: Display candidate profile\n    Note over UI: Tabs: Education (enrollment info),<br/>Programs (program assignments),<br/>Credentials (credential history)\n\n    Note over UI: Education Tab shows:<br/>- Enrollment Date<br/>- Program Level<br/>- EPP Provider<br/>- Status<br/>- Exit Date/Reason (if exited)\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Enrollment not found > 404 error. Candidate not found in IAM > Display partial data with error message." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Multi-Domain Data: Pulls data from EPP (enrollment), IAM (demographics), Credentialing (credentials). Tabbed Interface: Organizes information by category. Read-Only View: This sequence is display-only, updates handled by separate workflows." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "View Candidate Enrollment Detail" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator views individual candidate's full enrollment history and programs. When: Reviewing specific candidate's progress through EPP program. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_ViewCredentialApplicationDetailForReview> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant CredService as Credentialing API\n    participant IAM as Identity & Access API\n    participant PPR as Professional Practices API\n\n    Coordinator->>UI: Click application number from the application list\n    UI->>IAM: Verify permission (epp.applications.review)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /application-reviews/{applicationId}\n    EPPService-->>UI: EPP review record and internal remarks\n\n    UI->>CredService: GET /applications/{applicationId}\n    CredService-->>UI: Application details\n\n    UI->>IAM: GET /users/{candidateId}\n    IAM-->>UI: Candidate demographics\n\n    UI->>CredService: GET /applications/{applicationId}/mttc-results\n    CredService-->>UI: MTTC test results\n    Note over UI: MTTC table shows:<br/>Endorsement Name, Test Code,<br/>Has Passed?, Date Passed, Exam Date\n\n    opt If Has Conviction flag = true\n        UI->>PPR: GET /educators/{candidateId}/disclosures\n        PPR-->>UI: Conviction disclosure summary (for context)\n    end\n\n    UI->>EPPService: GET /application-reviews/{applicationId}/remarks-history\n    EPPService-->>UI: Historical remarks and actions\n\n    UI->>Coordinator: Display application review screen\n    Note over UI: Tabs:<br/>- Details (Personal Info, Application Info)<br/>- MTTC Information<br/>- Internal Remarks<br/>- Audit Log\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. Application not found > 404 error. MTTC results unavailable > Display warning, allow coordinator to proceed." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Multi-Domain Data: Pulls data from Credentialing (application), IAM (demographics), EPP (remarks/review status). Conviction Context: If conviction flag present, optionally show disclosure summary for context. Read-Only Application: Actual application form is read-only from Credentialing domain." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "View Credential Application Detail for EPP Review" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator views application summary, MTTC results, candidate demographics, review history. When: EPP needs to assess application before taking action. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:Seq_ViewCrossEPPEnrollmentHistory> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator as EPP Coordinator\n    participant UI as EPP UI\n    participant EPPService as EPP API\n    participant IAM as Identity & Access API\n\n    Coordinator->>UI: Navigate to candidate detail\n    Coordinator->>UI: Click \"View Enrollment from All EPPs\" option\n\n    UI->>IAM: Verify permission (epp.enrollment.view)\n    IAM-->>UI: Permission confirmed\n\n    UI->>EPPService: GET /candidate-enrollments?candidateId={id}&allEpps=true\n    Note over UI,EPPService: This query retrieves enrollments<br/>across all EPPs for this candidate\n\n    EPPService->>EPPService: Query all CandidateEnrollment records for candidate\n    EPPService-->>UI: Complete enrollment history across EPPs\n\n    UI->>Coordinator: Display cross-EPP enrollment table\n    Note over UI: Read-only view<br/>Columns: Student ID, Provider,<br/>Program Level, Program(s),<br/>Submitted Date, Enroll Date,<br/>Exit Date, Exit Reason<br/><br/>Current EPP's records highlighted\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User lacks permission > Access denied. No enrollments found > Display empty state message." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (query operation)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Read-Only: Coordinator can view but not edit enrollments from other EPPs. Full History: Shows all enrollments regardless of status or EPP. Highlighting: Current EPP's records visually distinguished." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "View Cross-EPP Enrollment History" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: EPP Coordinator views candidate's enrollment records at all EPPs. When: Candidate has transferred or dual-enrolled, EPP needs full context. Who: EPP Coordinator." .

<urn:solutiondesign:instance:epp:SequencesDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "sequences" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/epp/epp-sequences.md" .

<urn:solutiondesign:instance:epp:SpecialEdDirectorFlag> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Whether EPP offers Special Ed Director/Supervisor; gates certification-search dropdown inclusion (FDD 13.1.2)." ;
	<urn:solutiondesign:ontology:name> "SpecialEdDirectorFlag" .

<urn:solutiondesign:instance:epp:StudentID> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "EPP-specific identifier assigned to the candidate by the institution." ;
	<urn:solutiondesign:ontology:name> "StudentID" .

<urn:solutiondesign:instance:epp:UT_ApprovalApplication> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Alternative certification route application requiring EPP recommendation before ISD/school district placement. Distinct workflow from standard credential applications." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Approval Application" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:epp:ApprovalApplicationReviewAggregate> .

<urn:solutiondesign:instance:epp:UT_Candidate> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#altLabel> "Student" ;
	<http://www.w3.org/2004/02/skos/core#definition> "An individual enrolled in an EPP program working toward educator certification. Tracked from enrollment through program completion." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Candidate" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> .

<urn:solutiondesign:instance:epp:UT_CredentialApplicationWorklist> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Stakeholder term for the filtered/sorted view of credential applications requiring EPP review/action (Hold, Deny, Cancel, Recommend), surfaced via CredentialApplicationReview's own list endpoint. Not a separate domain concept." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Credential Application Worklist" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> .

<urn:solutiondesign:instance:epp:UT_EPP> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "An institution or organization approved by the state to prepare educator candidates for certification. Types include Public, Independent, Educator Association, and State. EPPs can offer Traditional Route, Alternative Route, or other specialized pathways." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Education Preparation Provider (EPP)" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> .

<urn:solutiondesign:instance:epp:UT_EPPRecommendation> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "EPP's formal approval of a candidate's credential application, asserting the candidate has met program requirements and is ready for state credentialing." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "EPP Recommendation" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> .

<urn:solutiondesign:instance:epp:Wireframe13_1> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Manage Educator Preparation Provider (EPP)' search screen — Code [FICE]#/Name text fields, Cert Type/Pathway dropdowns, 'Include Closed EPPs' checkbox, Search/Clear buttons; Search Results table (Code (FICE)#/Name/Cert Type/Pathway, comma-separated multi-values e.g. 'School Administrator, School Counselor, School Psychologist, School Social Worker, Teacher'), radio-select rows, Add/Edit buttons, pagination. Exact field-for-field match to the Business Specifications prose and to 13.1.1's acceptance criteria." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/13-epp-admin-users/wireframes/wireframe-01-manage-epp-search-results.png" .

<urn:solutiondesign:instance:epp:Wireframe13_2> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Edit Educator Preparation Provider (EPP)' form — Name/Code(FICE)#/Name(Fed)/Code(Fed)#/EPP Type dropdown/Address/City/State/Zip/Phone/Website URL fields; an inline Certificate Categories Allowed table (Certificate Type, Pathway, MDE Approval Date, Enrollment Close Date (Pro Prep), Recommend Close Date (MOECS — note: FDD prose calls this column 'MiEdWorkforce', wireframe UI itself labels it 'MOECS', a naming inconsistency between doc and UI worth flagging but not otherwise substantive), Actions/Edit); Reading Diagnostics and Special Ed Director/Supervisor checkboxes; Last Modified By/On; an inline multi-row Contact Information table (Prefix/First/Middle/Last/Title/Email/Phone/Ext/Clear); an inline Approved Endorsements table (Type/Endorsement/Status/Action). Confirms Contact Information and Approved Endorsements are both embedded directly in the single EPP edit form, not separate screens/endpoints — consistent with epp-api.ttl having no dedicated /contacts endpoint (contacts travel inside Op_CreateEppProvider/Op_UpdateEppProvider's whole-aggregate payload)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/13-epp-admin-users/wireframes/wireframe-02-add-edit-epp.png" .

<urn:solutiondesign:instance:epp:Wireframe13_3> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:Fdd13Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: per-endorsement 'Initial Cert. Application' / 'Addl. Endorsement' date-pair rows (MDE Approval Date / Enrollment Close Date (Pro Prep) / Recommend Close Date (MOECS)) broken out by Grade Level+Code (PK-12, K-8, K-9, K-12, 5-12, 6-12), each with its own 'Clear Dates' action. Confirms 13.1.4's 'update dates for both Initial Certification and Additional Endorsement types' independently per grade band, matching epp:ApprovedEndorsement's per-endorsement date fields." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/13-epp-admin-users/wireframes/wireframe-03-add-edit-endorsement-proprep-dates.png" .

<urn:solutiondesign:instance:epp:Wireframe25_AddendumAcceptEnrollmentReview> a <urn:solutiondesign:ontology:SourceDocument> ;
