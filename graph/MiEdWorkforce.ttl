<urn:solutiondesign:instance:staffing:Perm_EducationHistoryUpdate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Add/update education history records" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EducationHistory> ;
