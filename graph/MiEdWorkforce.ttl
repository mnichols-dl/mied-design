<urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:description> "The rule catalog underlying Collection's quality-review process. FDD 10's companion spreadsheet, 'Staffing Submission Validations.xlsx', documents 100+ individual validation checks, many inherited verbatim from the legacy MORE system's fixed-width record format. This is implementation/configuration detail for a rules engine, not a business-rule catalog, so it is kept separate from the staffing-domain.md Business Rules." ;
	<urn:solutiondesign:ontology:implementationNotes> "Rule categories identified: (1) Field-level syntax/format checks (e.g. SSN format) — declarative field-level validator per record on submission. (2) Cross-field consistency (e.g. End Date requires Separation Reason) — already covered by aggregate-level invariants (staff:Rule_EmploymentEndDateSeparationReasonCorequirement), no engine needed. (3) Cross-record/collection-level checks (e.g. 'all open districts must report active staff') — require EEM program-flag lookups at quality-review time, evaluated once per collection, not per record; unresolved how (see Open Technical Question #2 below). (4) Historical/trend anomaly detection (e.g. assignment-count change thresholds) — needs a defined comparison baseline and threshold, unresolved (Open Technical Question #3). (5) Legacy REP field-position rules (MORE-inherited, sheet 'REP BRs', F02_01-F26_6) — whether these need a 1:1 port or should be re-derived from the CEDS-aligned data-element model is unresolved (Open Technical Question #1). The admin configuration surface for assigning validations to a Collection/Category/Data Element (FDD 10 Feature 10.3/10.13) is captured by staff:Perm_AdminManageValidations; the execution engine itself is the unresolved technical gap this process describes." .

<urn:solutiondesign:instance:staffing:TechnicalDesignDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "technical-design" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/staffing/staffing-technical-design.md" .

<urn:solutiondesign:instance:staffing:UT_AppropriatePlacement> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The state where an employee holds valid credentials and endorsements matching their assigned position and course responsibilities." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Appropriate Placement" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:AssignmentAggregate> .

<urn:solutiondesign:instance:staffing:UT_Assignment> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The linkage of an employee to a specific position, including course details, grade levels, and FTE allocation." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Assignment" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:AssignmentAggregate> .

<urn:solutiondesign:instance:staffing:UT_CollectionCertification> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The formal attestation and finalization of employment and assignment data for a reporting period, after quality review and error resolution." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Collection Certification" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:CollectionAggregate> .

<urn:solutiondesign:instance:staffing:UT_CredentialErrorJustification> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Free-form text explanation provided by a district when assigning an employee to a position they are not credentialed for, used in audit reviews." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Credential Error Justification" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:CredentialErrorJustification> .

<urn:solutiondesign:instance:staffing:UT_EmployeeRoster> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The collection of all individuals employed by an educational organization during a school year, including active and terminated staff." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Employee Roster" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> .

<urn:solutiondesign:instance:staffing:UT_NewTeacher> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "An educator within their first three years of classroom teaching employment, subject to mentorship and professional development requirements." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "New Teacher" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:NewTeacherMonitoring> .

<urn:solutiondesign:instance:staffing:UT_PositionRoster> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The organizational chart of approved positions within an entity, including unfilled, filled, and frozen positions." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Position Roster" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> .

<urn:solutiondesign:instance:staffing:UT_Spot> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A single assignment allocation within a position, defined by SCED course, grade levels, FTE allocation, and start/end dates." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Spot" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:staffing:Spot> .

