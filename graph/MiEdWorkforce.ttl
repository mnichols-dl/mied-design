	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/application-reviews/{applicationId}/recommend" ;
	<urn:solutiondesign:ontology:projection> "Request carries recommendedEndorsements[] (endorsementCode + gradeBand, minItems 1) plus optional internalRemarks; drives the parent CredentialApplicationReview aggregate's Submitted -> Recommended transition (Business Rules: EPP Program Approval Scope, EPP Recommendation Requires MTTC Pass)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Recommend candidate for credential" ;
	<urn:solutiondesign:ontology:tags> "Application Reviews" .

