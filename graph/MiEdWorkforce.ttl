<urn:solutiondesign:instance:refdata:ReferenceDataOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:refdata:ReferenceDataContext> ;
