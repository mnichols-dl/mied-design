	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Called by IAM's own permission-evaluation engine; not exposed via APIM." ;
	<urn:solutiondesign:ontology:operationId> "getOrganizationHierarchy" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/organizations/{organizationCode}/hierarchy" ;
	<urn:solutiondesign:ontology:responseSchema> "Ordered ancestor-organization-code array -- escape hatch, proxies the Organizations platform capability (see orgs:Op_GetOrganizationHierarchy), not IAM's own domain model" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get organization parent hierarchy (internal service)" ;
	<urn:solutiondesign:ontology:tags> "Organizations" .

<urn:solutiondesign:instance:iam:Op_GetRemovalRequestStatus> a <urn:solutiondesign:ontology:ApiOperation> ;
