<urn:solutiondesign:instance:credentialing:EndorsementCode> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Unique identifier for the endorsement." ;
	<urn:solutiondesign:ontology:name> "EndorsementCode" .

<urn:solutiondesign:instance:credentialing:EndorsementDefinitionActiveDateRange> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When this endorsement definition is available." ;
	<urn:solutiondesign:ontology:name> "ActiveDateRange" .

<urn:solutiondesign:instance:credentialing:EndorsementDefinitionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Defines subject area specializations that can be added to teaching certificates. Supports versioning and historical tracking." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:EndorsementDefinitionCreatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:EndorsementDefinitionDeactivatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:EndorsementDefinitionUpdatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:credentialing:EndorsementDefinitionVersion> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:EndorsDefState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:EndorsDefState_Inactive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:EndorsementCode> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:EndorsementDefinitionActiveDateRange> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:EndorsementDisplayName> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:EndorsementFlags> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:GradeBandRange> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:RequiredAssessments> ;
	<urn:solutiondesign:ontology:invariants> "Endorsement codes must be unique across all active definitions. If grade band is specified, high grade must be >= low grade. Assessment requirements must specify at least one assessment identifier if competency testing is required. Required assessments must reference active assessment definitions. Endorsements marked Initial Endorsement Eligible must meet state program requirements. Changes to definitions create new versions rather than modifying existing ones. Active date ranges for different versions of the same endorsement cannot overlap." ;
	<urn:solutiondesign:ontology:rootEntity> "EndorsementDefinition" .

<urn:solutiondesign:instance:credentialing:EndorsementDefinitionCreatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, endorsementCode, displayName, effectiveFrom" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin creates new endorsement type" .

<urn:solutiondesign:instance:credentialing:EndorsementDefinitionDeactivatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, endorsementCode, deactivatedAt, deactivatedBy" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
