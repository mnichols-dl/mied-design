<urn:solutiondesign:instance:proflearning:Op_AddAttendee> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:Attendee> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "addAttendee" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/sessions/{sessionId}/attendees" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:SCECHAward> ;
	<urn:solutiondesign:ontology:projection> "Request is just educatorUniqueId (Attendee's identifying field). Response returns attendeeId plus defaultScechAward (the SCECHAllocation-shaped default award), not the full Attendee entity." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Add attendee to session roster" ;
	<urn:solutiondesign:ontology:tags> "Attendance" .

<urn:solutiondesign:instance:proflearning:Op_AdjustScechAward> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:SCECHAllocation> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:notes> "Pre-certification only; post-certification changes require a correction request via a separate permission/workflow (proflearning.correction.submit)." ;
	<urn:solutiondesign:ontology:operationId> "adjustScechAward" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/session-attendees/{attendeeId}/scech-award" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:SCECHAllocation> ;
	<urn:solutiondesign:ontology:projection> "The ScechAllocation schema (general/college/career/military hour counts) is reused here for an individual attendee's awarded amount — same shape as the program's own maximum SCECHAllocation, different semantic role (actual vs. maximum). Plus an optional free-text adjustmentReason not part of the value object." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Adjust SCECH award for attendee" ;
	<urn:solutiondesign:ontology:tags> "Attendance" .

<urn:solutiondesign:instance:proflearning:Op_ApplyCollegeCourse> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:STARRCourseRecord> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Publishes CollegeCourseApplied event consumed by Credentialing. Always operates on the authenticated user's own records." ;
	<urn:solutiondesign:ontology:operationId> "applyCollegeCourse" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/my/college-courses" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is just a starrCourseRecordId reference. Response returns a computed summary (applicationId, courseName, semesterCredits, scechsAwarded), not the full CollegeCourseApplication record." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Apply college course for SCECH credit" ;
	<urn:solutiondesign:ontology:tags> "CollegeCourses" .

<urn:solutiondesign:instance:proflearning:Op_ApproveCorrectionRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:AdminDecision> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Updates the attendance roster and publishes SCECHCorrectionApproved, consumed by Credentialing." ;
	<urn:solutiondesign:ontology:operationId> "approveCorrectionRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/correction-requests/{correctionRequestId}/approve" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is just an optional adminNotes string (part of AdminDecision). Response returns correctionRequestId + status only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Approve correction request" ;
	<urn:solutiondesign:ontology:tags> "CorrectionRequests" .

<urn:solutiondesign:instance:proflearning:Op_ApproveProgramApplication> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Transitions application PendingApproval -> Approved and creates the approved Program record." ;
	<urn:solutiondesign:ontology:operationId> "approveProgramApplication" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-applications/{applicationId}/approve" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:projection> "Request is just an optional reviewerNotes string, not entity-shaped. Response returns applicationId, the newly created programId, and status only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Approve program application" ;
	<urn:solutiondesign:ontology:tags> "ProgramApplications" .

<urn:solutiondesign:instance:proflearning:Op_BulkUploadAttendees> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Escape hatch used deliberately: the request is a raw CSV file upload (not JSON matching any domain entity) and the response is an async job-status/validation-report object, not a domain entity either — genuinely non-entity-shaped on both sides, the case sd:requestBodySchema/sd:responseSchema exist for." ;
	<urn:solutiondesign:ontology:operationId> "bulkUploadAttendees" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/sessions/{sessionId}/attendees/bulk-upload" ;
	<urn:solutiondesign:ontology:requestBodySchema> "multipart/form-data; required: [attendeesFile] (binary CSV of Unique IDs)" ;
	<urn:solutiondesign:ontology:responseSchema> "{ jobId: uuid, statusUrl: uri, processed: int, added: int, failed: int, errors: [{row, uniqueId, reason}] }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Bulk add attendees from CSV" ;
	<urn:solutiondesign:ontology:tags> "Attendance" .

<urn:solutiondesign:instance:proflearning:Op_CertifyAttendance> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Publishes AttendanceCertified event consumed by Credentialing. Blocked if required evaluations are not submitted." ;
	<urn:solutiondesign:ontology:operationId> "certifyAttendance" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/sessions/{sessionId}/certify" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is just a boolean attestation flag, not entity-shaped. Response returns a computed summary (sessionId, certifiedAt, attendeeCount, totalScechsAwarded), not the roster itself." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Certify attendance and award SCECHs" ;
	<urn:solutiondesign:ontology:tags> "Attendance" .

<urn:solutiondesign:instance:proflearning:Op_CreateBookmark> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Same escape-hatch rationale as plrn:Op_ListBookmarks above — Bookmark is not a promoted domain-model element." ;
	<urn:solutiondesign:ontology:operationId> "createBookmark" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/my/bookmarks" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ itemType: Program|Sponsor, itemId: uuid }" ;
	<urn:solutiondesign:ontology:responseSchema> "{ bookmarkId: uuid }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create bookmark" ;
	<urn:solutiondesign:ontology:tags> "Bookmarks" .

<urn:solutiondesign:instance:proflearning:Op_CreateEvaluationTemplate> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:EvaluationTemplateAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "createEvaluationTemplate" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/evaluation-templates" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:EvaluationTemplateAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request (name, description, applicableCategoryIds[], questionSetRefs[]) mirrors TemplateMetadata + QuestionReference[]. Response returns templateId only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create evaluation template" ;
	<urn:solutiondesign:ontology:tags> "EvaluationTemplates" .

<urn:solutiondesign:instance:proflearning:Op_CreateProgramCategory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:ProgramCategoryAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "createProgramCategory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-categories" ;
	<urn:solutiondesign:ontology:projection> "Request is just name + description (the category root's own fields, no subcategories). Response returns categoryId only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create program category" ;
	<urn:solutiondesign:ontology:tags> "ProgramCategories" .

<urn:solutiondesign:instance:proflearning:Op_CreateSubcategory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:Subcategory> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "createSubcategory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-categories/{categoryId}/subcategories" ;
	<urn:solutiondesign:ontology:projection> "Request is just name + description under the given parent categoryId. Response returns subcategoryId only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create subcategory" ;
	<urn:solutiondesign:ontology:tags> "ProgramCategories" .

<urn:solutiondesign:instance:proflearning:Op_DeactivateProgramCategory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Blocked if active programs are currently assigned to this category." ;
	<urn:solutiondesign:ontology:operationId> "deactivateProgramCategory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-categories/{categoryId}/deactivate" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramCategoryAggregate> ;
	<urn:solutiondesign:ontology:projection> "No request body. Response returns categoryId only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Deactivate program category" ;
	<urn:solutiondesign:ontology:tags> "ProgramCategories" .

<urn:solutiondesign:instance:proflearning:Op_DeleteBookmark> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "DELETE" ;
	<urn:solutiondesign:ontology:notes> "No request/response body (query params itemType/itemId only, 204 on success) — same escape-hatch rationale as plrn:Op_ListBookmarks above; no schema properties needed since there's no body to describe." ;
	<urn:solutiondesign:ontology:operationId> "deleteBookmark" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/my/bookmarks" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Remove bookmark" ;
	<urn:solutiondesign:ontology:tags> "Bookmarks" .

<urn:solutiondesign:instance:proflearning:Op_DenyCorrectionRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:AdminDecision> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Admin notes are required to explain the denial reason." ;
	<urn:solutiondesign:ontology:operationId> "denyCorrectionRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/correction-requests/{correctionRequestId}/deny" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is a required adminNotes string (part of AdminDecision, mandatory on denial). Response returns correctionRequestId + status only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Deny correction request" ;
	<urn:solutiondesign:ontology:tags> "CorrectionRequests" .

<urn:solutiondesign:instance:proflearning:Op_GetEligibleCollegeCourses> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Always self-only; not gated by X-Organization-Context." ;
	<urn:solutiondesign:ontology:operationId> "getEligibleCollegeCourses" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/my/college-courses/eligible" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:STARRCourseRecord> ;
	<urn:solutiondesign:ontology:projection> "EligibleCourse adds a computed estimatedScechs (semesterCredits * conversion rate) not stored on STARRCourseRecord itself, plus lastCredentialIssuanceDate as response-level metadata." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get eligible college courses for current educator" ;
	<urn:solutiondesign:ontology:tags> "CollegeCourses" .

<urn:solutiondesign:instance:proflearning:Op_GetProgram> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Non-standard dual access, mirroring credentialing-api.yml's GET /educators/{id}/credentials convention: x-access lists both internal-user and external-public. internal-user (any status) recorded as primary since sd:accessType only accepts one value per ApiOperationShape — see external-public note below and cred:Op_GetEducatorCredentials's identical caveat. For the external-public access pattern (Active programs only, via /catalog/search), the permission check is bypassed entirely per the source doc. sd:requiresAuth is deliberately left unset here (not asserted false) since the internal-user pattern is the primary, authenticated one — see this file's header note." ;
	<urn:solutiondesign:ontology:operationId> "getProgram" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/programs/{programId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:projection> "ProgramDetail adds description, category detail, contact, approvalPeriod, and nested sessions[] (SessionSummary) beyond ProgramSummary." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get program" ;
	<urn:solutiondesign:ontology:tags> "Programs" .

<urn:solutiondesign:instance:proflearning:Op_GetProgramApplication> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "getProgramApplication" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-applications/{applicationId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:projection> "Adds the full nested programDetails and reviewerNotes on top of the summary fields returned by the list operation." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get program application" ;
	<urn:solutiondesign:ontology:tags> "ProgramApplications" .

<urn:solutiondesign:instance:proflearning:Op_GetSessionRoster> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "getSessionRoster" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/sessions/{sessionId}/attendees" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:projection> "AttendanceRoster embeds an array of AttendeeRecord (attendeeId, educatorUniqueId/Name, awardedScechs, evaluationSubmitted, adjustmentReason) alongside session-level certificationStatus." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "View session roster" ;
	<urn:solutiondesign:ontology:tags> "Attendance" .

<urn:solutiondesign:instance:proflearning:Op_GetSponsor> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Non-standard dual access (internal-user + external-public), same convention as plrn:Op_GetProgram and cred:Op_GetEducatorCredentials — internal-user recorded as primary. Permission check is bypassed entirely for the external-public access pattern. sd:requiresAuth deliberately left unset — see this file's header note (same reasoning as plrn:Op_GetProgram)." ;
	<urn:solutiondesign:ontology:operationId> "getSponsor" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/sponsors/{sponsorId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> ;
	<urn:solutiondesign:ontology:projection> "SponsorDetail adds a nested activePrograms[] (ProgramSummary) beyond the sponsor's own base fields." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get sponsor" ;
	<urn:solutiondesign:ontology:tags> "Sponsors" .

<urn:solutiondesign:instance:proflearning:Op_ListBookmarks> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Escape hatch used deliberately: Bookmark is modeled in proflearning-domain.ttl only as a raw sd:DataTable (plrn:Tbl_Bookmarks), not promoted to a DomainEntity/ValueObject — its own note explains it 'supports the public catalog / educator self-service features rather than a core SCECH workflow' and isn't attached to any Aggregate root, so sd:consumesShape/producesShape (which require an Aggregate/DomainEntity/ValueObject target) don't apply." ;
	<urn:solutiondesign:ontology:operationId> "listBookmarks" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/my/bookmarks" ;
	<urn:solutiondesign:ontology:responseSchema> "{ data: [{ bookmarkId, itemType: Program|Sponsor, itemId, itemName, createdAt }], pagination }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List bookmarks" ;
	<urn:solutiondesign:ontology:tags> "Bookmarks" .

<urn:solutiondesign:instance:proflearning:Op_ListCorrectionRequests> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Also serves as the admin's correction-request review list via ?status=Submitted, per the sequence docs. Note: proflearning-api.yml defines no GET /correction-requests/{id} single-resource detail endpoint — only this list and the approve/deny actions; see proflearning-sequences.ttl's SequenceReference for the 'Admin Reviews Correction Request' sequence's GET /correction-requests/{id} call, marked no-such-endpoint." ;
	<urn:solutiondesign:ontology:operationId> "listCorrectionRequests" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/correction-requests" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Returns CorrectionRequestSummary — currentScechs/requestedScechs/justification/status, omitting AdminDecision and AuditTrail detail." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "List correction requests" ;
	<urn:solutiondesign:ontology:tags> "CorrectionRequests" .

<urn:solutiondesign:instance:proflearning:Op_ListEvaluationTemplates> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listEvaluationTemplates" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/evaluation-templates" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:EvaluationTemplateAggregate> ;
	<urn:solutiondesign:ontology:projection> "Returns EvaluationTemplateSummary — questionSetCount (a computed count) in place of the full QuestionReference list." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List evaluation templates" ;
	<urn:solutiondesign:ontology:tags> "EvaluationTemplates" .

<urn:solutiondesign:instance:proflearning:Op_ListProgramApplications> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Coordinators see only applications for their sponsor; admins with system-wide authorization see all. Also serves as the admin's pending-review list via ?status=PendingApproval, per the sequence docs." ;
	<urn:solutiondesign:ontology:operationId> "listProgramApplications" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-applications" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:projection> "Returns ProgramApplicationSummary — title/sponsor/type/status/timestamps only, not the full nested programDetails." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "List program applications" ;
	<urn:solutiondesign:ontology:tags> "ProgramApplications" .

<urn:solutiondesign:instance:proflearning:Op_ListProgramCategories> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listProgramCategories" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-categories" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramCategoryAggregate> ;
	<urn:solutiondesign:ontology:projection> "ProgramCategorySummary nests an array of subcategory summaries (id, name, status) alongside the category's own fields." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List program categories" ;
	<urn:solutiondesign:ontology:tags> "ProgramCategories" .

<urn:solutiondesign:instance:proflearning:Op_ListPrograms> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listPrograms" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/programs" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:projection> "Returns ProgramSummary — omits description, contact, approvalPeriod detail, and sessions[]." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "List programs" ;
	<urn:solutiondesign:ontology:tags> "Programs" .

<urn:solutiondesign:instance:proflearning:Op_RejectProgramApplication> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "rejectProgramApplication" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-applications/{applicationId}/reject" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:projection> "Request is just a required rejectionReason string, not entity-shaped. Response returns applicationId + status only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Reject program application" ;
	<urn:solutiondesign:ontology:tags> "ProgramApplications" .

<urn:solutiondesign:instance:proflearning:Op_RequestProgramApplicationInfo> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "requestProgramApplicationInfo" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-applications/{applicationId}/request-info" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:projection> "Request is just a required infoRequest string, not entity-shaped. Response returns applicationId + status only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Request additional information from sponsor" ;
	<urn:solutiondesign:ontology:tags> "ProgramApplications" .

<urn:solutiondesign:instance:proflearning:Op_SearchCatalog> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "external-public" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "x-permissions-required is an explicit empty list in the source, and x-access lists external-public only (no dual-access pattern, unlike getProgram/getSponsor) — genuinely, unconditionally unauthenticated, matching the proflearning.catalog.search permission's own 'no login required' note; sd:requiresAuth false asserted accordingly. Escape hatch used for the response: CatalogSearchResult is a composite result spanning BOTH the ProfessionalLearningProgramAggregate and ProfessionalLearningSponsorAggregate at once (resultType discriminates which), the exact 'composite search endpoint spanning several aggregates' case the ontology's own comment on sd:responseSchema calls out — no single sd:producesShape value would be accurate. City/zip/county/human-readable Sponsor ID filters described in FDD 31.5 are not yet implemented here — see plrn:Question_SponsorAddressAndHumanReadableId in proflearning-domain.ttl (Open Question #13)." ;
	<urn:solutiondesign:ontology:operationId> "searchCatalog" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/catalog/search" ;
	<urn:solutiondesign:ontology:requiresAuth> false ;
	<urn:solutiondesign:ontology:responseSchema> "{ data: [CatalogSearchResult { resultType: Program|Sponsor, programId?, sponsorId?, title, sponsorName, format?, category?, maxScechHours?, nextSessionDate?, beginDate?, endDate?, county?, isDppd?, programFee? }], pagination }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Search public program catalog" ;
	<urn:solutiondesign:ontology:tags> "Catalog" .

<urn:solutiondesign:instance:proflearning:Op_SubmitCorrectionRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:RequestedChange> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitCorrectionRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/correction-requests" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request body (sessionId, attendeeId, requestedScechs, justification) maps directly to the RequestedChange value object. Response returns correctionRequestId + status only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit SCECH correction request" ;
	<urn:solutiondesign:ontology:tags> "CorrectionRequests" .

<urn:solutiondesign:instance:proflearning:Op_SubmitProgramApplication> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitProgramApplication" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-applications" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:projection> "Request nests a ProgramDetails object under the application envelope, which itself mirrors ProfessionalLearningProgramAggregate's own fields (title, format, category, SCECHAllocation, ApprovalPeriod, sessions[]) rather than the ProgramApplication entity's tracking fields — the application is really a request-to-create/modify-Program wrapper. Response returns only applicationId + status, not the full entity." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Submit new or modified program application" ;
	<urn:solutiondesign:ontology:tags> "ProgramApplications" .

<urn:solutiondesign:instance:proflearning:Op_UpdateEvaluationTemplate> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:EvaluationTemplateAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:operationId> "updateEvaluationTemplate" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/evaluation-templates/{templateId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:EvaluationTemplateAggregate> ;
	<urn:solutiondesign:ontology:projection> "Same shape as createEvaluationTemplate's request. Response returns templateId only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update evaluation template (full replacement)" ;
	<urn:solutiondesign:ontology:tags> "EvaluationTemplates" .

<urn:solutiondesign:instance:proflearning:Op_UpdateProgramCategory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:proflearning:ProgramCategoryAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:operationId> "updateProgramCategory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/program-categories/{categoryId}" ;
	<urn:solutiondesign:ontology:projection> "Partial update of name/description only. Response returns categoryId only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update program category" ;
	<urn:solutiondesign:ontology:tags> "ProgramCategories" .

<urn:solutiondesign:instance:proflearning:Op_WithdrawProgram> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "withdrawProgram" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:proflearning:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/programs/{programId}/withdraw" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is just an optional notes string. Response returns programId + status only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Withdraw program" ;
	<urn:solutiondesign:ontology:tags> "Programs" .

<urn:solutiondesign:instance:proflearning:Perm_AdminCategories> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manage program categories and subcategories" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AdminFunctions> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin. Backs listProgramCategories, createProgramCategory, updateProgramCategory, createSubcategory, deactivateProgramCategory." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.admin.categories" .

<urn:solutiondesign:instance:proflearning:Perm_AdminEvaluationTemplates> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manage evaluation templates" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AdminFunctions> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin. Backs listEvaluationTemplates, createEvaluationTemplate, updateEvaluationTemplate." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.admin.evaluationtemplates" .

<urn:solutiondesign:instance:proflearning:Perm_AdminQuestions> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manage evaluation question sets" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AdminFunctions> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin. LIKELY-STALE / GAP: proflearning-domain.md's own Scope section explicitly says the Question Set framework is a cross-cutting capability this domain does NOT own, and no API operation in proflearning-api.yml is gated by this permission — evaluation-templates endpoints are gated by the separate proflearning.admin.evaluationtemplates instead, which only lets an admin select existing question-set IDs, not manage question content itself. Left with no PermissionRequirement." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.admin.questions" .

<urn:solutiondesign:instance:proflearning:Perm_AttendanceAdd> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Add attendees to program roster" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AttendanceManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to session-scoped. Backs addAttendee and bulkUploadAttendees." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.attendance.add" .

<urn:solutiondesign:instance:proflearning:Perm_AttendanceAdjust> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Adjust awarded SCECH hours before certification" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AttendanceManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to session-scoped. Backs adjustScechAward." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.attendance.adjust" .

<urn:solutiondesign:instance:proflearning:Perm_AttendanceCertify> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Certify finalized attendance and award SCECHs" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AttendanceManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to session-scoped. Backs certifyAttendance." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.attendance.certify" .

<urn:solutiondesign:instance:proflearning:Perm_AttendanceOverride> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Adjust SCECH hours after certification" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AttendanceManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin only. GAP: no API operation is gated by this permission specifically — post-certification adjustment is instead handled entirely through the SCECHCorrectionRequest workflow (submitCorrectionRequest / approveCorrectionRequest / denyCorrectionRequest), gated by the distinct proflearning.correction.* permissions. This permission appears to describe the same capability the correction-request workflow already provides, under a different name; left with no PermissionRequirement rather than double-gating approveCorrectionRequest under two permission IDs." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.attendance.override" .

<urn:solutiondesign:instance:proflearning:Perm_AttendanceView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View attendance roster" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_AttendanceManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to session-scoped; coordinators for their programs, admins system-wide." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.attendance.view" .

<urn:solutiondesign:instance:proflearning:Perm_CatalogBookmark> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Bookmark programs/sponsors" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_PublicAccess> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Requires login (System-wide (authenticated) per the source). Backs listBookmarks, createBookmark, deleteBookmark." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.catalog.bookmark" .

<urn:solutiondesign:instance:proflearning:Perm_CatalogSearch> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Search public professional learning catalog" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_PublicAccess> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Unauthenticated; no login required. Consistent with searchCatalog's x-permissions-required: [] in proflearning-api.yml and plrn:Op_SearchCatalog's sd:requiresAuth false — no PermissionRequirement is modeled for that operation since ApiOperationRequiresPermissionShape only applies to non-public operations and searchCatalog is genuinely external-public with zero permission gating." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.catalog.search" .

<urn:solutiondesign:instance:proflearning:Perm_CollegeCourseApply> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Apply college course for SCECH credit" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_CollegeCourseCredit> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Educators for their own courses. Backs getEligibleCollegeCourses and applyCollegeCourse." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.collegecourse.apply" .

<urn:solutiondesign:instance:proflearning:Perm_CorrectionApprove> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Approve SCECH correction requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_CorrectionRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin only. Backs approveCorrectionRequest and denyCorrectionRequest." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.correction.approve" .

<urn:solutiondesign:instance:proflearning:Perm_CorrectionSubmit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit SCECH correction request for certified attendance" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_CorrectionRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to session-scoped; coordinators for their programs. Backs submitCorrectionRequest. Scoped to coordinators only — FDD 27 describes a distinct educator-initiated correction/dispute pathway with no corresponding permission here; see plrn:SCECHCorrectionRequestAggregate's notes and plrn:Question_EducatorInitiatedCorrectionPathway (Open Question #11)." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.correction.submit" .

<urn:solutiondesign:instance:proflearning:Perm_CorrectionView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View correction requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_CorrectionRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to sponsor/session-scoped; coordinators see their own requests, admins see all. Backs listCorrectionRequests. No single-resource GET /correction-requests/{id} exists in proflearning-api.yml (see plrn:Op_ListCorrectionRequests's own notes) — the list endpoint plus this permission is the only modeled coverage." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.correction.view" .

<urn:solutiondesign:instance:proflearning:Perm_EvaluationSubmit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit program evaluation" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_EvaluationManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Attendees for programs they attended. SIGNIFICANT GAP: neither proflearning-api.yml (no evaluation-submission endpoint) nor proflearning-sequences.md (no 'Attendee Submits Evaluation' sequence, despite the EvaluationTemplate aggregate's own 'Referenced In' list naming one) actually models this capability end-to-end, even though the domain doc's certification workflow (plrn:Rule_EvaluationRequirementProgramSpecific) depends on evaluations being submitted before certification can proceed. Left with no PermissionRequirement — a real, load-bearing gap, not a minor one." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.evaluation.submit" .

<urn:solutiondesign:instance:proflearning:Perm_EvaluationView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View submitted evaluations" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_EvaluationManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to program-scoped. GAP: proflearning-api.yml has no endpoint for listing/viewing submitted EvaluationSubmission records at all. Left with no PermissionRequirement." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.evaluation.view" .

<urn:solutiondesign:instance:proflearning:Perm_ProgramApprove> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Approve program applications" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_ProgramManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin only. Backs approve, reject, and request-info — matches proflearning-api.yml exactly." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.program.approve" .

<urn:solutiondesign:instance:proflearning:Perm_ProgramCreate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit new program applications" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_ProgramManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to sponsor-scoped. Coordinators for their sponsor." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.program.create" .

<urn:solutiondesign:instance:proflearning:Perm_ProgramEdit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Edit program details (triggers re-approval if approved)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_ProgramManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to program-scoped. PARTIAL GAP: for the sponsor-initiated path this is effectively covered by POST /program-applications with applicationType=Modify (plrn:Op_SubmitProgramApplication, gated by proflearning.program.create, not this permission) — proflearning-api.yml has no distinct 'edit program' endpoint gated by proflearning.program.edit itself. The domain doc's own 'Modified Programs Require Re-Approval' business rule (plrn:Rule_ModifiedProgramsRequireReapproval) also describes a second path — Professional Learning Admin editing an approved program directly, with no re-approval — that has no API operation at all. Left with no PermissionRequirement; the permission ID doesn't map cleanly to modeled operations either way." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.program.edit" .

<urn:solutiondesign:instance:proflearning:Perm_ProgramView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View program application details" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_ProgramManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to program-scoped; coordinators, admins, or public for active programs. Backs listProgramApplications, getProgramApplication, listPrograms, and getProgram (internal-user access pattern) — matches proflearning-api.yml's x-permissions-required exactly." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.program.view" .

<urn:solutiondesign:instance:proflearning:Perm_ProgramWithdraw> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Withdraw or delete programs" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_ProgramManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to program-scoped. Coordinators for their programs, admins system-wide." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.program.withdraw" .

<urn:solutiondesign:instance:proflearning:Perm_SessionCreate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Add program sessions (dates/locations)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_SessionManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to program-scoped. GAP: proflearning-api.yml has no distinct session-creation endpoint — sessions are created inline as part of ProgramDetails.sessions within POST /program-applications (submitProgramApplication, gated by proflearning.program.create). Left with no PermissionRequirement of its own." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.session.create" .

<urn:solutiondesign:instance:proflearning:Perm_SessionEdit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Edit session dates and locations" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_SessionManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to session-scoped. GAP: no session-edit endpoint exists anywhere in proflearning-api.yml. Left with no PermissionRequirement." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.session.edit" .

<urn:solutiondesign:instance:proflearning:Perm_SponsorApprove> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Approve new sponsor applications" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_SponsorManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin only. GENUINE GAP, already flagged in proflearning-domain.ttl's own aggregate design note and plrn:Question_SponsorApprovalWorkflowContradiction (Open Question #9): the ProfessionalLearningSponsor aggregate says sponsor creation is EEM-only with no PendingApproval state inside MiEdWorkforce, yet this permission — and FDD 26's described new-Sponsor application / Lead-Administrator e-signature workflow — presumes such a workflow exists. No SponsorApplication aggregate or API operation is modeled for it (proflearning-api.yml has no sponsor-application endpoints at all); left with no PermissionRequirement as an honest, documented gap rather than fabricating the missing workflow." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.sponsor.approve" .

<urn:solutiondesign:instance:proflearning:Perm_SponsorDelete> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Delete sponsor applications or approved sponsors" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_SponsorManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Professional Learning Admin only. No DELETE/deactivate sponsor endpoint exists in proflearning-api.yml at all — same class of gap as sponsor.approve above, compounded by the aggregate's own Design Note that sponsor lifecycle (creation, presumably deletion) belongs to EEM, not MiEdWorkforce. Left with no PermissionRequirement." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.sponsor.delete" .

<urn:solutiondesign:instance:proflearning:Perm_SponsorEdit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Edit sponsor contact information and metadata" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_SponsorManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Coordinators for their sponsor, admins system-wide. No distinct 'update sponsor' API operation exists in proflearning-api.yml (only GET /sponsors/{sponsorId}) — the proflearning-domain.md aggregate description says MiEdWorkforce 'edits contact info' but no corresponding endpoint was found; an honest gap, left with no PermissionRequirement." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.sponsor.edit" .

<urn:solutiondesign:instance:proflearning:Perm_SponsorView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View sponsor details and program list" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:proflearning:Cat_SponsorManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Entity resolves to a specific sponsor. Coordinators have this for their own sponsor." ;
	<urn:solutiondesign:ontology:permissionId> "proflearning.sponsor.view" .

<urn:solutiondesign:instance:proflearning:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "permissions" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/proflearning/proflearning-permissions.md" .

<urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:displayName> "Professional Learning" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:proflearning:EvaluationTemplateAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:proflearning:ProgramCategoryAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<urn:solutiondesign:ontology:identifier> "proflearning" ;
	<urn:solutiondesign:ontology:kind> "CoreDomain" ;
	<urn:solutiondesign:ontology:notes> "Explicitly does NOT own: user authentication/account creation (iam, via MiLogin), organization master data (EEM is source of truth, synced to org-reference-data), sponsor creation in EEM (external process — MiEdWorkforce manages existing sponsors only), credential renewal processing (credentialing), email delivery infrastructure (communications), document storage (documents), STARR data collection (external system, via Synapse), educator's total SCECH balance for credential purposes (a computed view maintained by credentialing, not stored here), the Question Set framework (cross-cutting capability), or program fee collection (display-only field; actual payment happens on the sponsor's own external registration site)." ;
	<urn:solutiondesign:ontology:purpose> "Manages the State Continuing Education Clock Hours (SCECH) system for Michigan educators: sponsor management, professional learning program applications/approval/catalog, session scheduling, attendee enrollment and attendance tracking, SCECH credit awarding and correction workflows, program evaluations, public catalog search, and college-course-credit application from STARR data." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:iam:AuthorizationApprovedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:iam:AuthorizationRevokedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:organizations:OrganizationDeactivatedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:proflearning:SCECHCorrectionApprovedEvent> .

<urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents an approved professional learning offering with defined content, format, maximum SCECH hours, and approval period." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:InfoRequestedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:ProgramApplicationSubmittedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:ProgramApprovedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:ProgramModifiedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:ProgramRejectedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:ProgramSession> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:ProgState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:ProgState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:ProgState_Draft> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:ProgState_Inactive> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:ProgState_PendingApproval> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:ProgState_Withdrawn> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:ApplicationReviewStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:ApprovalPeriod> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:EndorsementAlignment> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:EvaluationRequirement> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:ProgramAgenda> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:ProgramCategoryVO> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:ProgramContact> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:ProgramFormatVO> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:SCECHAllocation> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:SessionLocation> ;
	<urn:solutiondesign:ontology:invariants> "Program must have approved sponsor. Maximum SCECH hours must be positive. Program must have at least one session within approval period. Modified programs require re-approval (sponsor-initiated edits only — Professional Learning Admin may edit an approved program directly without re-triggering approval). Program Format dictates whether location address is required. If evaluation is required, template must be specified." ;
	<urn:solutiondesign:ontology:rootEntity> "Program" .

<urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents an organization (created in EEM) that is managed within MiEdWorkforce for offering professional learning programs, with designated coordinators and contact information." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:CoordinatorAssignedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:CoordinatorAssignment> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:SponsorState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:SponsorState_Inactive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:SponsorContact> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:SponsorStatus> ;
	<urn:solutiondesign:ontology:invariants> "A sponsor must have at least one active Coordinator. Sponsor must exist in EEM before being managed in MiEdWorkforce. Only one coordinator can be designated as primary." ;
	<urn:solutiondesign:ontology:notes> "Design Note: sponsor creation happens in EEM (external system); MiEdWorkforce only manages existing sponsors (editing contact info, assigning coordinators). There is no 'PendingApproval' state within MiEdWorkforce for sponsors — this directly contradicts proflearning-permissions.md's proflearning.sponsor.approve permission and FDD 26's described new-Sponsor application/Lead-Administrator e-signature workflow (see plrn:Question_SponsorApprovalWorkflowContradiction below). No SponsorApplication aggregate is modeled here since the domain doc's own aggregate description doesn't describe one — an honest gap, not resolved by this conversion." ;
	<urn:solutiondesign:ontology:rootEntity> "Sponsor" .

<urn:solutiondesign:instance:proflearning:ProgState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:proflearning:ProgState_Approved> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Approved" .

<urn:solutiondesign:instance:proflearning:ProgState_Draft> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Draft" .

<urn:solutiondesign:instance:proflearning:ProgState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:proflearning:ProgState_PendingApproval> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "PendingApproval" .

<urn:solutiondesign:instance:proflearning:ProgState_Withdrawn> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Withdrawn" .

<urn:solutiondesign:instance:proflearning:ProgramAgenda> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Document reference from the documents domain." ;
	<urn:solutiondesign:ontology:name> "ProgramAgenda" .

<urn:solutiondesign:instance:proflearning:ProgramApplication> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Entity tracking application lifecycle (new, modify, renew)." ;
	<urn:solutiondesign:ontology:name> "ProgramApplication" .

<urn:solutiondesign:instance:proflearning:ProgramApplicationSubmittedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Topic name inferred by analogy with other mied domains' single-topic-per-domain convention; proflearning-domain.md itself does not state a topic name." ;
	<urn:solutiondesign:ontology:payloadHighlights> "programId, sponsorId, applicationDetails" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Coordinator submits program application" .

<urn:solutiondesign:instance:proflearning:ProgramApprovedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "programId, sponsorId, approvalPeriod, maxSCECHs" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Program application approved" .

<urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks enrollment, attendance, and SCECH credit awarding for a specific program session." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:AttendanceCertifiedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:EvaluationRequiredEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:SCECHAwardAdjustedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:Attendee> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:EvaluationSubmission> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:SCECHAward> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:RosterState_AwaitingEvaluations> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:RosterState_Certified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:RosterState_Draft> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:RosterState_ReadyForCertification> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:AttendanceRecord> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:CertificationStatus> ;
	<urn:solutiondesign:ontology:invariants> "Attendee must have valid Unique ID from IAM system. Awarded SCECHs cannot exceed program's maximum for each type. Roster cannot be certified until all required evaluations are submitted. Once certified, SCECH awards are immutable (corrections require admin override via SCECHCorrectionRequest). Default awarded SCECHs equal program maximum unless adjusted. School Counselor SCECH types (College/Career/Military) can only be awarded to educators holding a School Counselor credential." ;
	<urn:solutiondesign:ontology:rootEntity> "AttendanceRoster" .

<urn:solutiondesign:instance:proflearning:ProgramCategoryAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Defines the classification taxonomy for programs (categories and subcategories)." ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:Subcategory> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:CategoryState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:CategoryState_Inactive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:CategoryStatus> ;
	<urn:solutiondesign:ontology:invariants> "Category names must be unique. Subcategories must belong to exactly one category. Inactive categories cannot be assigned to new programs. Deleting a category requires reassignment or archival of dependent programs." ;
	<urn:solutiondesign:ontology:rootEntity> "ProgramCategory" .

<urn:solutiondesign:instance:proflearning:ProgramCategoryVO> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Category, Subcategory reference on a program (distinct from the ProgramCategory aggregate itself, which owns the taxonomy)." ;
	<urn:solutiondesign:ontology:name> "ProgramCategory" .

<urn:solutiondesign:instance:proflearning:ProgramContact> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:fields> "name, phone, email" ;
	<urn:solutiondesign:ontology:name> "ProgramContact" .

<urn:solutiondesign:instance:proflearning:ProgramFormatVO> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Face-to-Face, Virtual/Online, Hybrid." ;
	<urn:solutiondesign:ontology:name> "ProgramFormat" .

<urn:solutiondesign:instance:proflearning:ProgramModifiedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "programId, changes, requiresReapproval" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Approved program edited" .

<urn:solutiondesign:instance:proflearning:ProgramRejectedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "programId, sponsorId, rejectionReason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Program application denied" .

<urn:solutiondesign:instance:proflearning:ProgramSession> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Specific offering with dates/location." ;
	<urn:solutiondesign:ontology:name> "ProgramSession" .

<urn:solutiondesign:instance:proflearning:QuestionReference> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Reference to a Question Set ID (from the Question Set capability)." ;
	<urn:solutiondesign:ontology:name> "QuestionReference" .

<urn:solutiondesign:instance:proflearning:Question_AttestationVsEvaluationSubmissionUnresolved> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Comment 12 (Dontje, 2026-01-27), anchored on the same Business Specifications passage that became 27.2.1: 'the survey will exist upon implementation with the admin ability to update the questions. In addition, the admin can turn on/off and required/optional. Upon MiEdWorkforce implementation, the surveys will be off. The educators need a way to attest to attending to add the SCECH hours. For example, number 8 [Business Specs paragraph -> Addendum 27.2.1] needs to be updated to state that the SCECH hours are awarded when the educator attestation occurs. Number 9 and 10 [-> 27.3.2, 27.3.3] are applicable when the surveys are on and required; if the surveys are off, the system will send the alert/email to remind the educator to attest.' Three follow-up comments (17, 18, 19, all Dontje, same session) reassert 'Need to discuss'/'impacted by the discussion' directly against 27.2.1, 27.3.2, and 27.3.3's own Addendum text. UNLIKE FDD 28's own Sponsor-application-editability comment thread (which reached a final resolved position that the visible Addendum text already reflects), this thread was NEVER folded back into 27.2.1/27.3.1/27.3.2/27.3.3's visible wording — all four stories still describe evaluation SUBMISSION as the award/reminder trigger, not educator ATTESTATION. Whether 'attestation' names a wholly new, unmodeled educator-facing concept, or is better read as clarifying prose around the existing plrn:Rule_EvaluationRequirementProgramSpecific ('if [Evaluation Required is] OFF, credits award immediately upon sponsor certification') is itself unresolved — that business rule already covers the sponsor-certification side of an evaluations-off launch, but says nothing about an educator-facing attestation UI, which is what this comment specifically calls for ('the educators need a way to attest'). No AttestationRecord or equivalent concept exists anywhere in proflearning-domain.ttl. Genuinely open, not something this review can resolve unilaterally." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_27_2_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_27_3_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_27_3_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_27_3_3> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_CollegeCourseSelfUploadAlternative> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Comment 6 (Chaturvedi, 2025-10-06), anchored on the same STARR college-course passage as plrn:Req_27_BizSpec_CollegeCourseCredit: 'educator should be able to upload their own college credits and their transcripts. system automatically calculates the scech hrs and the EPP will review it when they review the credentialling application.' This proposes a materially different intake mechanism (educator self-upload + EPP manual review during credentialing) alongside or instead of the modeled STARR-sourced-only path — never adopted, corrected, or explicitly rejected in any later comment. No self-upload/EPP-review pathway exists anywhere in proflearning-domain.ttl or epp's own converted domain files. Recorded as an open, unconfirmed alternative rather than assumed adopted or dropped." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_27_BizSpec_CollegeCourseCredit> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_ConfigurableWorklistStatuses> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Exceeds the Worklist/Pending-Items working assumption in solution-architecture.md. FDD 14 (Admin) §Feature 14.3 describes admin-defined, dynamically reconfigurable 'worklists', not a filtered view over an existing status field: the admin can define new statuses and modify displayed columns per audience (separate worklists for Processing staff vs. Sponsors), with items categorized by 'Resolved'/'Unresolved'. This implies admin-configurable status taxonomy and view definitions beyond the current ApplicationReviewStatus/RequestStatus enums modeled here. Is FDD 14.3's 'define new statuses' language just imprecise phrasing for filtering, or does Professional Learning Admin genuinely need admin-configurable status/column definitions requiring real modeling beyond the working assumption? See 14-professional-learning-admin review, Coverage Gap re: Feature 14.3. (Open Question #12)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:ApplicationReviewStatus> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:RequestStatus> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_EducatorInitiatedCorrectionPathway> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "SCECHCorrectionRequest is modeled exclusively as sponsor-initiated (Ubiquitous Language: 'Sponsor-initiated request...'; ERD's submitted_by_user_unique_id is documented as 'Coordinator who submitted'). FDD 27 (Educator) §Feature 27.2.2 describes a distinct, educator-initiated pathway: a MiEdWorkforce citizen user submitting a request/query regarding a correction or review of Professional Learning hours, routed directly to the Professional Learning administrator — not through the sponsor/coordinator at all. proflearning-permissions.md has no permission for an educator to submit a correction/dispute (proflearning.correction.submit is scoped to coordinators only). Is this a second, parallel correction-request pathway, or should the existing aggregate be widened to allow either actor to initiate? See 26-27-28-professional-learning review, Discrepancy #2. (Open Question #11)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_EvaluationPolicyDetails> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Two related, unanswered evaluation-policy questions from the source doc, deduped into one Annotation: what is the retention period for evaluation responses (Open Question #4)? And are evaluation reminder emails sent at fixed intervals, or is the schedule configurable per program (Open Question #6)?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:EvaluationTemplateAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_FieldLevelReapprovalUnresolved> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "A NEW, still-unresolved nuance on top of the already-modeled plrn:Rule_ModifiedProgramsRequireReapproval, from this FDD's most recent (2026-03-11) comment round: comment 763087876 (Groom, CEPI): 'After approval, all fields are editable. Upon submission if fields that require Admin approval have been edited, it is treated as a new application and sent for review/approval. If fields that do not require review are edited, the changes are immediately effective. (SOM team to verify which fields can be edited without review/approval).' This introduces a FIELD-LEVEL distinction (which specific fields trigger re-approval vs. take effect immediately) that plrn:Rule_ModifiedProgramsRequireReapproval does not currently express — the existing rule's only distinction is by ACTOR (sponsor-initiated edits always re-approve; admin edits never do), not by which field changed. The thread's own final exchange (comment 1528602329, Caswell, 2026-03-11 15:46, replying to Groom: 'Would you like to update requirement #5 to note that modifications will conditionally route for admin approval or become immediately effective based on the specific fields edited?') shows this was raised but not yet answered anywhere in the exported document — genuinely open, not merely undocumented. The visible 26.2.4/26.2.5 AC text was never updated to reflect it. Which specific fields require re-approval (per the comment's own 'SOM team to verify' caveat) is unknown outside this FDD's comment thread." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_26_2_4> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_26_2_5> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Rule_ModifiedProgramsRequireReapproval> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_IdpAggregateGap> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "This domain has no IndividualDevelopmentPlan (IDP) aggregate at all, despite credentialing-domain.md's 'Individual Development Plan (IDP) for Permit Renewals' business rule stating 'Professional Learning domain manages IDP content and approval' and describing a GET /educators/{uniqueId}/idp/status call this API does not define (no /idp path exists anywhere in proflearning-api.yml, confirmed by direct inspection during this conversion). Neither FDD 14 (Admin) nor any other FDD in this folder describes IDP creation, content, or an admin approval workflow — the only source describing IDP at all is FDD 17 (Renewals), which lists it only as a renewal requirement name without describing the mechanism. Does IDP need a first-class aggregate here, or is 'IDP' actually just a category of uploaded document reviewed manually by a credential processor (as credentialing-sequences.md's 'Renew Credential' sequence currently treats it)? See 14-professional-learning-admin review, Discrepancy #1. (Open Question #7)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_MissingSponsorSequences> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "This aggregate's own 'Referenced In' list cites a 'Sequence: Mass Email to Sponsors' and a 'Sequence: Manage Sponsor Contact Information', but neither sequence exists in proflearning-sequences.md — only 'Program Application Submission and Approval' and the other documented flows are present. FDD 28 (Processing) confirms mass-emailing sponsors is a real, described capability (Wireframe 14: 'compose and send mass emails... to selected or All Sponsors'), and FDD 26 confirms sponsor contact/coordinator updates are a real, described capability. Both sequences need to be authored in proflearning-sequences.md to match what the domain doc already claims exists. See 26-27-28-professional-learning review, Coverage Gap #2. (Open Question #10)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_ReminderIntervalConfigFddOwnershipUnresolved> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Comment 20 (Dontje, 2026-01-27) on 27.3.4 (Professional Learning Admin configures the reminder-interval threshold): 'This should be captured in #14.' This is an explicit, still-open scope question from the FDD's own reviewer about whether this admin-configuration capability belongs in FDD 27 (this document, Educator-facing) or FDD 14 (Professional Learning Admin) — never resolved anywhere in this document's own comment thread, and FDD 14 was not reviewed as part of this pass. Structurally identical to FDD 28's own comment-18 cross-FDD ownership question (evaluation review: FDD 28 vs. FDD 14) — a second, independent instance of FDD 14's admin-functionality boundary being unclear to this project's own reviewers, not a one-off." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_27_3_4> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_ScechBalanceQueryVsEvents> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "credentialing-sequences.md's 'Renew Credential' sequence calls GET /scech-hours?educatorId={id}&credentialType={type} on the Professional Learning API — this endpoint does not exist in proflearning-api.yml, and this domain's own Downstream dependency table (confirmed directly against proflearning-domain.md during this conversion) already documents that Credentialing is expected to maintain its own running SCECH balance via event subscription (AttendanceCertified, SCECHAwardAdjusted, CollegeCourseApplied), not a live query. Should credentialing's sequence be corrected to read from its own event-maintained balance, or is a real-time cross-check endpoint (e.g. GET /educators/{id}/scech-summary) still needed here for renewal-time accuracy? See 14-professional-learning-admin review, Discrepancy #1. (Open Question #8)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_SessionConcurrencyAndWithdrawalImpact> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Two related, unanswered program/session lifecycle edge cases from the source doc, deduped into one Annotation: can a sponsor offer the same program at multiple sessions simultaneously, or must sessions be sequential (Open Question #2)? And what happens to attendee enrollments if a program is withdrawn after approval but before any sessions have occurred (Open Question #5)?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_SponsorAddressAndHumanReadableId> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "FDD 31.5 ('Public Search - Professional Learning') requires Sponsor-level Address (city, mailing zip code, county) as both Advanced Search filters and detail-page display fields, plus a human-readable Sponsor ID (e.g. 'A123456') distinct from the internal sponsor_id UUID. Neither exists in the SPONSORS ERD or SponsorDetail schema today. Does Sponsor mailing address come from EEM (extending org-reference-data), or is it PL-specific data entered separately? Is the human-readable Sponsor ID a new PL-generated identifier, or a legacy-MOECS code needing preservation? plrn:Op_SearchCatalog does not yet filter on city/zip/county/Sponsor ID pending this decision. (Open Question #13)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_SponsorApplicationScopeWasContested> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "REFINEMENT of Question #9, not a restatement: this FDD's own comment thread on Feature 26.1 (anchored directly to the Business Specifications' first Sponsor-application bullet) shows the feature's very existence INSIDE MiEdWorkforce was still an open, evolving policy question well after the domain model was converted, which is the most likely explanation for why proflearning-domain.ttl's source doc still describes sponsor creation as EEM-only/external with no application workflow. Timeline, reconstructed from comments.xml: (1) comment 5 (Ross, DTMB-Contractor, 2025-12-04): 'It is my understanding this is currently taking place, external to MiEdWorkforce and still pending further discussion' — as of Dec 2025, the working assumption was that Sponsor-application intake happens OUTSIDE the system entirely, consistent with the domain doc's own Design Note. (2) comment 6 (Dontje, MDE, 2026-01-28): 'Yes, this needs further discussion as a group. This sponsor application should live in MiEdWorkforce but not require logging in to fill out and submit, similar to user authorization forms' — a PROPOSED reversal of that assumption, marked resolved (w15:done=1) despite saying discussion was still needed. (3) A new top-level comment, 1981370782 (Groom, CEPI, 2026-02-02, 'Per discussions 1/29'): 'The sponsor application should exist within MiEdWorkforce but not require logging in to fill out and submit, similar to user authorization forms, and require OEE approval, routed through the Professional Learning Worklist, included in 28.1' — the apparent FINAL resolution, roughly three weeks after comment 6, confirming in-app intake AND introducing a wholly new approval actor (OEE) never mentioned anywhere in the visible Addendum text (26.1.5/26.1.6 name only 'Lead Administrator (Superintendent)' and 'Professional Learning Administrator'). A second, separate discrepancy sits inside this same resolution: the 'not require logging in' language (comments 6, 1981370782) describes fully unauthenticated public submission, while 26.1.1's own visible AC text says the form 'must be accessible to users who have authenticated via MiLogin but do not yet have authorized user access' — authenticated-but-unauthorized, not unauthenticated. The visible Addendum text was never updated to match either the Feb-2026 login-model resolution or the newly-introduced OEE step. Any future SponsorApplication design needs to resolve both: which access model (26.1.1's text vs. the comment resolution), and where OEE fits relative to the Lead Administrator gate this FDD's own numbered stories already describe." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_26_1_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_26_1_5> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_26_1_6> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_SponsorApprovalWorkflowContradiction> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "This domain's own ProfessionalLearningSponsor aggregate contradicts its own permissions catalog. The aggregate's Design Note states there is no 'PendingApproval' state within MiEdWorkforce for sponsors — sponsor creation is EEM-only. But proflearning-permissions.md defines proflearning.sponsor.approve ('Approve new sponsor applications', Professional Learning Admin only), which presumes exactly such a workflow. FDD 26 §Business Specifications and Addendum Feature 26.1 corroborate the permission, not the Design Note: a full new-Sponsor application form, a 'Pending Review'/'Pending Local Approval' record-lock state, and a Lead Administrator (Superintendent) e-signature approval gate that must complete before the application routes to the Professional Learning Admin's worklist. Does a SponsorApplication entity/workflow need to be modeled (parallel in shape to ProgramApplication), or was this workflow scoped out and the permission is stale? See 26-27-28-professional-learning review, Discrepancy #1. (Open Question #9)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "contradiction" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Question_StarrAwardDataGapInCredentialing> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "STARR post-secondary AWARD data (distinct from the course data proflearning already syncs) is referenced repeatedly by this FDD (8.3.1's own text, and credentialing-domain.ttl/staffing-domain.ttl's own citations of 'CEPI Data Warehouse/STARR-NSC interfaces' for HighestEducation) as evidence usable in credential applications, but no Dependency, Aggregate field, or Sequence anywhere in credentialing-domain.ttl models STARR as a data source at all — credentialing has zero STARR presence today, unlike proflearning's real starr:StarrSystem Dependency for course data. 8.3.5's environment-configuration story is a minor, generic gap shared with several other interfaces in this folder (see the consolidated 8.4-8.7 Annotation) and is grouped here rather than given its own Annotation." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_08_3_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:proflearning:Req_08_3_5> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd08_3StarrDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:proflearning:Req_08_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Successfully receives the STARR payload via REST/Parquet over HTTPS; validates payload format and required award/course elements; rejects and logs records failing validation; logs each transmission with date/time, source, and record counts." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd08_3StarrDoc> ;
	<urn:solutiondesign:ontology:notes> "The COURSE-data half is well covered by proflearning's existing Synapse-Pipeline sync of STARR data into plrn:STARRCourseRecord. The AWARD-data half (post-secondary awards used as evidence in credential applications) has NO counterpart anywhere in credentialing-domain.ttl — see Question_StarrAwardDataGapInCredentialing below, which also covers 8.3.3." ;
	<urn:solutiondesign:ontology:requirementId> "8.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:STARRCourseRecord> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:starr:StarrSystem> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to receive STARR post-secondary award and course data so that it can be used in educator credential and professional learning processes." ;
	<urn:solutiondesign:ontology:title> "Receive STARR post-secondary award and course data" .

<urn:solutiondesign:instance:proflearning:Req_08_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Uses the Unique ID in both STARR and MiEdWorkforce to associate records; logs and excludes records with missing/non-matching Unique IDs; persists linked records referenceable by credentialing/proflearning; captures association outcomes in an audit log." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd08_3StarrDoc> ;
	<urn:solutiondesign:ontology:notes> "proflearning's own architecture note (proflearning-domain.ttl) confirms STARR data is 'synced into MiEdWorkforce via an automated Synapse Pipeline, populating STARR_COURSE_RECORDS' — consistent with a Unique-ID-keyed sync, though the specific 'exclude and log on non-matching ID' branch isn't independently called out." ;
	<urn:solutiondesign:ontology:requirementId> "8.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:STARRCourseRecord> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to associate STARR records to individuals using the Unique ID so that awards and course completions are correctly linked to citizen accounts." ;
	<urn:solutiondesign:ontology:title> "Associate STARR records to individuals via Unique ID" .

<urn:solutiondesign:instance:proflearning:Req_08_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Surfaces linked STARR award data to credentialing processes as read-only reference data; only successfully-associated records are displayed; credential workflow continues without error when no award data exists." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd08_3StarrDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.3.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want STARR award data to be available to credential workflows so that qualifying awards can be used as evidence in applications." ;
	<urn:solutiondesign:ontology:title> "Make STARR award data available to credential workflows" .

<urn:solutiondesign:instance:proflearning:Req_08_3_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Exposes STARR course records for use in professional-learning rules where configured; only evaluates courses successfully associated to the individual's Unique ID; excludes and logs misaligned/invalid course records." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd08_3StarrDoc> ;
	<urn:solutiondesign:ontology:notes> "Strong, direct match — this is exactly what proflearning's college-course-credit-toward-SCECH feature (plrn:CourseEligibility/plrn:SCECHConversion) already models." ;
	<urn:solutiondesign:ontology:requirementId> "8.3.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:CourseEligibility> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:SCECHConversion> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:STARRCourseRecord> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:starr:StarrSystem> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want STARR course data to be available for professional learning evaluation so that applicable courses can count toward requirements where allowed." ;
	<urn:solutiondesign:ontology:title> "Make STARR course data available for professional learning evaluation" .

<urn:solutiondesign:instance:proflearning:Req_08_3_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Configurable with distinct endpoints/settings for DEV, UAT, PROD; each execution logged with environment identifier; configuration prevents STARR test data from loading into production." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd08_3StarrDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.3.5" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support environment-specific configuration for STARR so that testing and production data do not conflict." ;
	<urn:solutiondesign:ontology:title> "Support environment-specific STARR configuration" .

<urn:solutiondesign:instance:proflearning:Req_14_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an accessible administrative page for Professional Learning. The page provides the administrator navigation and access to manage: Public Professional Resources; the SCECH Sponsor application form; the SCECH Program application form; the SCECH Attendee reporting page; the Individual Level Professional Learning component." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "This is a navigation-shell story: it names five destinations an admin area links to, not a distinct capability of its own. Public Professional Resources has its own dedicated story (14.1.2); the SCECH Sponsor/Program application forms are FDD 26/28's own review-and-decision workflows (Feature 28.1/28.4, reviewed in that sibling pass — the SponsorApplication gap FDD 28 already found is neither corroborated nor newly evidenced by this nav-only reference). satisfiedBy loosely names the two aggregates this nav area fronts, not a distinct 'admin home page' node (this level of design doesn't model site navigation/menu structure as its own graph element). GENUINE, FDD-SELF-ACKNOWLEDGED GAP: comment 28 (Dontje, 2026-03-18) on this exact passage says the remaining bullets each need their own user story the way Public Professional Resources got 14.1.2 — and none was ever written for the SCECH Attendee reporting page or the Individual Level Professional Learning component specifically. See Question_Feature141BulletsNeverPromoted." ;
	<urn:solutiondesign:ontology:requirementId> "14.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I want to access a dedicated administrative area, so that I can manage Professional Learning system pages, applications, validations, reports, and availability." ;
	<urn:solutiondesign:ontology:title> "Access a dedicated Professional Learning administrative area" .

<urn:solutiondesign:instance:proflearning:Req_14_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an administrative interface to maintain public Professional Learning Resources (SCECH Sponsor and Program searches). The system allows the administrator to add, edit, and remove hyperlinks and associated text. The system allows the administrator to define and manage page text, including headings and informational announcements. The system allows the administrator to upload and manage User Support materials. The system allows the administrator to manage configurations for the Search Results table. The system allows the administrator to define and manage Error and Validation text displayed to end users." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE COVERAGE GAP: this is a content-management-system (CMS) capability layered on top of the public catalog search (plrn:Op_SearchCatalog, FDD 31.5) — editable hyperlinks/headings/announcements/support materials/search-result-column config/validation text — and no such page-content-management aggregate, entity, or API operation exists anywhere in proflearning-domain.ttl, proflearning-api.ttl, or documents-capability.ttl (the closest adjacent capability, docs:DocumentAggregate, manages uploaded files, not editable page text/hyperlinks). Distinct from plrn:Op_SearchCatalog itself, which serves the search results but has no notion of admin-configurable page chrome around it. satisfiedBy left unasserted." ;
	<urn:solutiondesign:ontology:requirementId> "14.1.2" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I want to manage and maintain the content of the Public Professional Learning Resources pages, so that users have accurate and helpful information when searching for sponsors and programs." ;
	<urn:solutiondesign:ontology:title> "Manage the content of the public Professional Learning Resources pages" .

<urn:solutiondesign:instance:proflearning:Req_14_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system incorporates historical Professional Learning data. The system displays historical Professional Learning data migrated from legacy systems. The historical data set includes: records for all educators; records for all sponsors; records for all programs; administrator processing details. Users can search and filter these historical records within the administrative interface." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL: viewing/searching current sponsor and program records is a real, modeled capability (plrn:Op_ListPrograms, plrn:Op_GetSponsor), but two distinct things this AC also requires are unmodeled: (1) 'migrated from legacy systems' implies a legacy-data-migration/backfill process — no such BatchJob or migration concept exists anywhere in proflearning-domain.ttl or proflearning-sequences.ttl (a genuine gap, not previously flagged by the FDD 28 pass, which had no reason to look for it); (2) 'administrator processing details' as part of the historical record is the same audit-trail gap FDD 28 already found for Program applications specifically, now independently asserted for historical data generally — see this file's header note and the shared coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "14.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSponsor> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListPrograms> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Admin, I want to view historical Professional Learning data for educators, sponsors, and programs, so that I can reference legacy records and maintain continuity." ;
	<urn:solutiondesign:ontology:title> "View historical Professional Learning data for educators, sponsors, and programs" .

<urn:solutiondesign:instance:proflearning:Req_14_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides a view of historical Sponsor details. Historical Professional Learning data includes Sponsor details and Program details. The system provides functionality to access and view Sponsor Program details from the historical data set." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match for the 'view details' half — plrn:Op_GetSponsor and plrn:Op_GetProgram already serve this. This story doesn't itself distinguish 'historical' (past/inactive) records from current ones the way 14.2.1 emphasizes migration; no separate historical-archive read path is needed beyond the existing get operations, which don't filter out inactive/withdrawn/expired records." ;
	<urn:solutiondesign:ontology:requirementId> "14.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetProgram> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSponsor> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Admin, I want to access specific Sponsor and Program details from historical records, so that I can review past program offerings and sponsor history." ;
	<urn:solutiondesign:ontology:title> "Access specific Sponsor and Program details from historical records" .

<urn:solutiondesign:instance:proflearning:Req_14_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Admin can access historical data to verify its accuracy against legacy records. The historical data is structured to support credential renewal calculations (e.g., counting toward 150 hours)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "This is precisely the FDD-14-side evidence plrn:Question_ScechBalanceQueryVsEvents (proflearning-domain.ttl, Open Question #8) already anticipated by name ('See 14-professional-learning-admin review, Discrepancy #1'): that Annotation flags a genuine architectural disagreement over whether an educator's running SCECH balance for credential-renewal purposes is served by a live query or by Credentialing's own event-maintained tally. 14.2.3's AC ('structured to support credential renewal calculations, e.g., counting toward 150 hours') confirms the underlying business need is real and admin-visible, but says nothing about mechanism — it neither resolves the live-query-vs-events question nor introduces a third option. Recorded as corroborating evidence, not a resolution; see the Annotation immediately below." ;
	<urn:solutiondesign:ontology:requirementId> "14.2.3" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Admin, I want to view and verify historical Professional Learning data, so that I can ensure accuracy for educator credential renewal processes." ;
	<urn:solutiondesign:ontology:title> "Verify historical Professional Learning data for credential renewal accuracy" .

<urn:solutiondesign:instance:proflearning:Req_14_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system displays historical attendance records for professional learning sessions. The system displays historical SCECH history for a selected educator. The admin can filter this history by date or program." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Session-level attendance/SCECH data is real and modeled (plrn:Op_GetSessionRoster, plrn:AttendanceRecord, plrn:SCECHAward) — but there is no cross-session, educator-centric 'attendance and SCECH history for this one educator across all programs' query anywhere in proflearning-api.ttl; the only educator-scoped SCECH view described anywhere in this project's source docs is credentialing's own disputed GET /scech-hours (see plrn:Question_ScechBalanceQueryVsEvents). satisfiedBy names the closest real building block, not a full match; filtering 'by date or program' across an educator's full history would need a new, educator-scoped aggregation endpoint that doesn't exist today." ;
	<urn:solutiondesign:ontology:requirementId> "14.2.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:AttendanceRecord> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSessionRoster> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Admin, I want to view the historical SCECH history and attendance records for specific educators, so that I can audit or verify their professional learning progress." ;
	<urn:solutiondesign:ontology:title> "View historical SCECH history and attendance records for specific educators" .

<urn:solutiondesign:instance:proflearning:Req_14_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The administrative page for Professional Learning worklist management is accessible. The administrator can manage existing worklists for Professional Learning Admin Processing staff. The administrator can manage existing worklists for Sponsors." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 14.1 (plrn:Wireframe14_1Doc): a real 'Professional Learning Program Applications' worklist screen exists in the wireframe set with Unresolved/Resolved tabs, matching this feature's shape. See the shared Annotation below (also covering 14.3.2) for the substantive gap: no admin-configurable worklist-DEFINITION mechanism (as opposed to the worklist screen itself, which is real) exists anywhere." ;
	<urn:solutiondesign:ontology:requirementId> "14.3.1" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Admin, I need an administrative page to manage worklists used by Professional Learning Admin Processing staff and Sponsors." ;
	<urn:solutiondesign:ontology:title> "Administrative page to manage worklists for Processing staff and Sponsors" .

<urn:solutiondesign:instance:proflearning:Req_14_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Admin can access the administrative page for Professional Learning worklist management. Upon entering the \"edit\" screen, the administrator can add predefined data fields to the display results of the processing worklist. The system allows for the adding and/or removal of existing data fields or columns from the worklist view and will be applied once clicking \"Save\". Worklists will be categorized by \"Resolved\" and \"Unresolved\" items. Worklists include the ability to display progress for tasks utilizing visual indicators for \"Resolved\" versus \"Unresolved\" items." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 14.1 (plrn:Wireframe14_1Doc)'s own Unresolved/Resolved tabs, matching this AC precisely. Coverage-gap Annotation below (Coverage Gap re: Feature 14.3) closes the forward reference plrn:Question_ConfigurableWorklistStatuses (proflearning-domain.ttl, Open Question #12) already made to this review by name." ;
	<urn:solutiondesign:ontology:requirementId> "14.3.2" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Admin, I need the ability to edit predefined worklists by adding or removing data fields and columns so that I can customize the information displayed for processing staff and sponsors." ;
	<urn:solutiondesign:ontology:title> "Edit predefined worklists by adding/removing data fields and columns" .

<urn:solutiondesign:instance:proflearning:Req_14_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Not a user story — a prose scope-deferral paragraph with no numbered sub-stories, same treatment as FDD 28's Req_28_2. The underlying send/track/display logic is correctly out-of-scope here (Communications' own domain, real and converted). But the Business Specifications prose elsewhere in this same document describes substantial PL-specific CONFIGURATION content this paragraph says IS in scope (alerts admin, email template admin) that was never promoted to an Addendum number — see plrn:Req_14_BizSpec_AlertsNotificationsAdminConfig and plrn:Req_14_BizSpec_EmailTemplateAdminConfig below, which carry that content instead of leaving it unaccounted for." ;
	<urn:solutiondesign:ontology:requirementId> "14.4" ;
	<urn:solutiondesign:ontology:statement> "All underlying logic for sending, tracking, and displaying emails, alerts and notifications are derived from Business Specification #6 (Alerts, Emails & Communications). This feature is strictly limited to the configuration of these tools (defining what is sent) specifically for the Professional Learning module. Additionally, Business Specification #4 (Business Rules Management) will specify when and to whom it is sent." ;
	<urn:solutiondesign:ontology:title> "Email/Comm (scope deferral to Business Specification #6)" .

<urn:solutiondesign:instance:proflearning:Req_14_5> a <urn:solutiondesign:ontology:Requirement> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:dashboards:DashboardsContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Not a user story — a prose scope-deferral paragraph, same treatment as Req_14_4/Req_14_6. Business Specification #3 (Dashboards) corresponds only to dash:DashboardsContext, a minimal sd:status \"stub\" bounded context minted by the earlier FDD 11/16 pilot pass, per CONVENTIONS.md's registry — no real dashboard-configuration aggregate/API exists to satisfy even the PL-specific configuration slice this paragraph claims is in scope (define available tiles, set per-role access for Educators/Sponsor/Coordinator, define reports per tile, set worklist availability by role — all from the Business Specifications prose, HLS row 14). Not modeled as a separate BizSpec-only Requirement (unlike Alerts/Email Templates/Reports) because, unlike Communications/Reporting, Dashboards has no real API surface at all to check coverage against — same treatment GAPS.md already gives FDD 29's own dashboard finding." ;
	<urn:solutiondesign:ontology:requirementId> "14.5" ;
	<urn:solutiondesign:ontology:statement> "All underlying logic for the display, organization, and rendering of the dashboard is derived from Business Specification #3 (Dashboards). This feature is strictly limited to the configuration of these elements (defining which tiles and reports are available to whom) specifically for the Professional Learning workflow." ;
	<urn:solutiondesign:ontology:title> "Dashboard (scope deferral to Business Specification #3)" .

<urn:solutiondesign:instance:proflearning:Req_14_6> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Not a user story — a prose scope-pointer/exclusion paragraph, same treatment as Req_14_4/14_5. Distinct from those two in also containing an outright REJECTION (file-queue management is explicitly excluded from the admin role, full stop, not merely deferred to another FDD). See the discrepancy Annotation below: this rejection directly contradicts this same document's own, much more detailed Business Specifications prose, which describes exactly this file-queue-management capability (view queue, reset/cancel/delete stuck files, filter by status, view audit details) as an ADMIN-facing capability at length." ;
	<urn:solutiondesign:ontology:requirementId> "14.6" ;
	<urn:solutiondesign:ontology:statement> "All user stories regarding the uploading of supporting documentation and bulk attendee data files can be found within user stories associated with Feature 26.3: Professional Learning - Sponsor - Document upload. Additionally, all user stories pertaining to the ability to view and verify uploaded supporting documentation can be found within user stories associated with Feature 28.3: Professional Learning - Processing - Document Upload. The requirements for the Professional Learning Admin to manage file queues (e.g., resetting \"stuck\" files) and toggle upload availability should be considered outside scope of an administrative task. These functions are considered as technical management and maintenance tasks to be handled by developers." ;
	<urn:solutiondesign:ontology:title> "Document upload (scope pointer to 26.3/28.3; file-queue management excluded)" .

<urn:solutiondesign:instance:proflearning:Req_14_7_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system validates the Unique ID provided in the attendee file upload against the Identity Management system. The system confirms that the Unique ID exists and is active. The system links the attendance record to the verified educator profile associated with the Unique ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match: plrn:Rule_AttendeeValidUniqueId already states this exact requirement ('Only educators with a Unique ID... can be added to program attendance rosters') and is enforced against iam:Op_GetUserByUniqueId per proflearning-domain.ttl's own Dependency on IAM for 'Educator Unique ID validation.'" ;
	<urn:solutiondesign:ontology:requirementId> "14.7.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_GetUserByUniqueId> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Attendee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_AttendeeValidUniqueId> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must utilize Unique ID matching to associate SCECH attendee data with educator profiles, so that attendance is attributed to the correct individual." ;
	<urn:solutiondesign:ontology:title> "Use Unique ID matching to associate SCECH attendee data with educator profiles" .

<urn:solutiondesign:instance:proflearning:Req_14_7_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system automatically awards the reported SCECHs to the attendee's profile once the Unique ID match is confirmed. If the Unique ID is invalid or cannot be matched, the record produces an error and SCECHs are not awarded." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match on substance: plrn:Rule_DefaultScechEqualsMax already models automatic SCECH awarding on attendee-roster entry, and plrn:Rule_AttendeeValidUniqueId's gate means an unmatched Unique ID never reaches the roster in the first place, satisfying the 'no award without a valid match' half. UNCONFIRMED ASSUMPTION flagged in review: comment 715111818 (Doherty, 2026-04-06, quoting Sinha) on this exact passage says 'The validations for the SCECH Hours have been added. Please confirm as the FDDs do not contain any references to these specific thresholds or caps' — i.e., the FDD's own author isn't sure the specific numeric thresholds/decimal-place rules added to this text are corroborated anywhere else. See Question_UnconfirmedScechThresholds below." ;
	<urn:solutiondesign:ontology:requirementId> "14.7.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Attendee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_DefaultScechEqualsMax> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:SCECHAward> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must award reported SCECHs to session attendees upon successful Unique ID confirmation, so that the educators receive credit for their participation." ;
	<urn:solutiondesign:ontology:title> "Award reported SCECHs to session attendees upon Unique ID confirmation" .

<urn:solutiondesign:instance:proflearning:Req_14_7_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Admin can access the system to confirm the accuracy of Professional Learning records. The administrator can view awarded SCECH records to confirm accuracy. The administrator can view error details of processed files." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL: viewing awarded SCECH records is covered by plrn:Op_GetSessionRoster's own AttendeeRecord projection. 'View error details of processed files' has no clean counterpart: docs:BulkOperationAggregate's docs:BulkOperationItem entity does carry a per-item error message/reason field, and docs:StagingFileAggregate models Failed/Infected states for the bulk-import pipeline proflearning's own attendee-file uploads would use — but no admin-facing operation exposing either of those error details is documented in proflearning-api.ttl or documents-api.ttl specifically for this use. Same class of gap as this file's header-note audit-log finding, but distinct (file-processing errors, not action audit trail)." ;
	<urn:solutiondesign:ontology:requirementId> "14.7.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSessionRoster> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Admin, I need visibility into the process to confirm the accuracy of Professional Learning details and awarded records within the system." ;
	<urn:solutiondesign:ontology:title> "Admin visibility to confirm accuracy of Professional Learning records" .

<urn:solutiondesign:instance:proflearning:Req_14_7_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "If a provided Unique ID is invalid or results in an identity conflict (Near Match), the system flags the record as an error/pending in the file queue. The system prevents SCECHs from being awarded for these flagged records. Detailed identity resolution tasks (if applicable) are routed to the Identity Administrator worklist, not the Professional Learning Admin." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "STRONG, PRECISE MATCH — the best-covered story in this FDD: iam-domain.ttl/iam-sequences.ttl already model exactly this 'Near Match' concept end-to-end (Mi-Key identity matching returning Match/No-Match/Near Match, an IdentityResolutionRequest entity, and a dedicated Identity Administrator review queue via iam:Op_ListIdentityResolutionRequests/iam:Op_AdminResolveIdentityRequest) — this story's explicit scope boundary ('routed to the Identity Administrator worklist, not the Professional Learning Admin') is precisely the architecture IAM's own domain conversion already committed to for every other domain's Near Match cases (Staffing's Business-User-Request-New-ID flow is the closest documented analogue). The 'prevents SCECHs from being awarded' half is covered by plrn:Rule_AttendeeValidUniqueId's own gate. Minor gap: no explicit SequenceReference/Dependency ties proflearning's attendee-file-upload path to iam's IdentityResolutionRequest submission specifically (the existing Dependency to iam:Op_GetUserByUniqueId in proflearning-domain.ttl models a direct lookup, not a Near-Match-capable submission flow) — worth a future proflearning-sequences.ttl update, not modeled as a separate Annotation given how minor it is relative to the rest of this match." ;
	<urn:solutiondesign:ontology:requirementId> "14.7.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_AdminResolveIdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ListIdentityResolutionRequests> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must flag attendee records that fail Unique ID matching or require identity resolution, so that records that were not processed can be identified." ;
	<urn:solutiondesign:ontology:title> "Flag Unique ID matching failures and route identity resolution to the Identity Administrator" .

<urn:solutiondesign:instance:proflearning:Req_14_BizSpec_AlertsNotificationsAdminConfig> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Create and manage system alert text with versioning. Set system effective dates for alerts and notifications. Set Authorized User Roles to receive the alert. View and manage the system event/trigger that utilizes the alert. View existing alerts in a table with filter options; results include Alert Name, Status, Expiration Date, Action, and Versioning/audit details." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "GOOD MATCH: comm:AlertAggregate already models versioning (comm:AlertVersion) and role-based targeting (comm:AlertRoleTarget) alongside comm:Op_ListAlerts/Op_CreateAlert/Op_ResolveAlert — covering most of this AC directly. PARTIAL GAP: unlike the Email Template permissions (which have explicit per-functional-area variants — comm:Perm_ProflearningTemplatesView/Create/Edit/Activate), Alerts are gated only by generic comm:Perm_AlertsView/Perm_AlertsCreate with no Proflearning-specific scoping — meaning any Alerts admin can currently manage any domain's alerts, not just Professional Learning's own, which is a narrower authorization model than this AC implies ('Professional Learning Administrator' specifically). Not previously flagged by any earlier proflearning or communications conversion pass." ;
	<urn:solutiondesign:ontology:requirementId> "14-BizSpec-AlertsNotificationsAdminConfig" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:AlertAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_CreateAlert> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ListAlerts> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ResolveAlert> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, using the framework of alerts and notifications (Epic 6.0), I will manage alerts and notifications for Professional Learning, so that users see timely, correctly-targeted system messages." ;
	<urn:solutiondesign:ontology:title> "Manage system alerts and notifications for Professional Learning" .

<urn:solutiondesign:instance:proflearning:Req_14_BizSpec_EmailTemplateAdminConfig> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Create/manage email templates; set effective dates; set authorized recipient roles; define the triggering system event; view historical use of templates (each sent instance, usage counts, trigger point); resend a historical email with a CC option. View existing templates in a table with filter options; results include Email Template Name, Template Group, Template Status, Expiration Date, Action, and Versioning/audit details." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "STRONG MATCH, the best-covered BizSpec-only item in this FDD: communications-permissions.ttl already defines a full Proflearning-specific permission set for exactly this (comm:Perm_ProflearningTemplatesView/Create/Edit/Activate/Delete, comm:Perm_ProflearningEmailsViewHistory/Resend), and communications-api.ttl's comm:Op_ListTemplates/Op_CreateTemplate/Op_UpdateTemplate/Op_ActivateTemplateVersion (with versioning via comm:Op_CreateTemplateVersion/Op_ListTemplateVersions) plus comm:Op_SearchEmailHistory/Op_ResendEmail cover template management, versioning, and resend-with-CC end-to-end. Minor documentation gap: 'count of uses, trigger point' as an aggregated usage-statistics view isn't explicitly modeled as its own projection — comm:Op_SearchEmailHistory returns individual sent-email records, from which such stats could be derived, but no dedicated stats endpoint exists. Confirms, and gives much more detail to, FDD 28's own observation (Req_28_1_4's notes) that Communications' permission catalog already treats proflearning as a first-class gated functional area." ;
	<urn:solutiondesign:ontology:requirementId> "14-BizSpec-EmailTemplateAdminConfig" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ActivateTemplateVersion> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_CreateTemplate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ListTemplates> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ResendEmail> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_SearchEmailHistory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_UpdateTemplate> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, using the framework for email communications (Epic 6.0), I will create and manage email templates for Professional Learning, set effective dates, define trigger events, view historical use, and resend historical emails." ;
	<urn:solutiondesign:ontology:title> "Manage email templates for Professional Learning" .

<urn:solutiondesign:instance:proflearning:Req_14_BizSpec_QuestionSetAdmin> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add new question. Modify existing question. Update decision tree. Manage text. Per comment 13 (Caswell, 2025-12-04): the question set management page should include explicit functionality for viewing, editing, and activating/deactivating questions/sets." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE COVERAGE GAP, confirmed at the stub level: qset:QuestionSetContext is already registered as a minimal sd:status \"stub\" bounded context (proflearning-domain.ttl's own conversion stubbed it because proflearning explicitly does NOT own the Question Set framework, only consumes it for evaluation templates) with exactly one operation, qset:GetQuestionSetsOperation — a read-only GET for consuming existing question sets, itself unconfirmed against any real questionsets-api.yml. Nothing resembling question CREATE/UPDATE/activate-deactivate, decision-tree authoring, or text management exists anywhere. This is the one BizSpec-only item in this FDD that genuinely has no possible satisfiedBy target today, even a partial one — distinguished from the broader 'Business Rule Management' prose content (assign validation to workflow, set severity, date-field admin), which isn't modeled as a Requirement at all since it maps to Business Specification #4, which has no bounded context in this project whatsoever (see this file's header note; report to GAPS.md, not an edit made here)." ;
	<urn:solutiondesign:ontology:requirementId> "14-BizSpec-QuestionSetAdmin" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, on an administrative page with audit details stored, I will define and manage the Question Sets and validations for Professional Learning processes: add new questions, modify existing questions, update decision trees, and manage text." ;
	<urn:solutiondesign:ontology:title> "Define and manage Question Sets and validations for Professional Learning processes" .

<urn:solutiondesign:instance:proflearning:Req_14_BizSpec_ReportsAdminConfig> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Define report availability and allow future/immediate retiring. Define report access by authorized user roles. Search existing reports. Create ad-hoc and custom reports. Export/download options. Manage report resources, including page text and links. Audit details will be stored." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:notes> "GOOD MATCH for catalog administration: rpt:Op_AdminListReports/Op_AdminCreateReport/Op_AdminGetReport/Op_AdminUpdateReport/Op_AdminUpdateReportStatus already cover defining, updating, retiring, and searching report catalog entries, gated by rpt:Perm_CatalogManage. PARTIAL GAP on 'create ad-hoc and custom reports' specifically: reporting-capability.ttl's own rpt:Rule_ReportDefinitionsOwnedOutsideApplication states report definitions are Power-BI-authored artifacts registered into the catalog, not built ad-hoc inside this admin UI — 'create ad-hoc and custom reports' as literally described (build a new report on the fly) is architecturally at odds with reporting's own governance model, not merely unbuilt. Also ties to this file's header-note audit-log finding ('Audit details will be stored') — no versioning/audit mechanism is modeled on rpt:ReportDefinitionAggregate itself." ;
	<urn:solutiondesign:ontology:requirementId> "14-BizSpec-ReportsAdminConfig" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminCreateReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminGetReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminListReports> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminUpdateReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminUpdateReportStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, on an administrative page with audit details stored, I will manage the reports and report settings related to Professional Learning: define report availability (including future/immediate retirement), define report access by authorized user roles, search existing reports, create ad-hoc and custom reports, provide export/download options, and manage report resources (page text and links)." ;
	<urn:solutiondesign:ontology:title> "Manage Professional Learning reports and report settings" .

<urn:solutiondesign:instance:proflearning:Req_26_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an initial SCECH Sponsor application form for new Professional Learning Sponsors to complete. The form must be accessible to users who have authenticated via MiLogin but do not yet have authorized user access to log into the MiEdWorkforce dashboard (similar to the user authorization forms). The system is aligned with the SCECH Sponsor Application Form structure, provided by business, and maintainable by the Professional Learning Admin. The application form must be completed prior to the sponsor gaining approval." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "THE root story of the SponsorApplication gap: no SponsorApplication aggregate/entity/API exists anywhere in proflearning-domain.ttl or proflearning-api.ttl to hold this form's data or lifecycle. Confirmed by Wireframe1/2/3 (plrn:Wireframe1Doc/2Doc/3Doc) — Wireframe3 shows this AC's own 'similar to the user authorization forms' language is a literal design reuse of MiEdWorkforce's existing IAM access-request screen, not a new original design. Also see Question_SponsorApplicationScopeWasContested: this story's own AC text ('authenticated via MiLogin but do not yet have authorized user access') describes a DIFFERENT access model than the comment thread's later resolution ('not require logging in to fill out and submit') — an unresolved discrepancy between the visible requirement text and the most recent stakeholder decision, not merely a missing implementation." ;
	<urn:solutiondesign:ontology:requirementId> "26.1.1" ;
	<urn:solutiondesign:ontology:statement> "As a new Professional Learning Sponsor, I want to complete an initial application form before I have full system access, so that I can officially apply to become an approved SCECH provider." ;
	<urn:solutiondesign:ontology:title> "Complete initial Sponsor application form before full system access" .

<urn:solutiondesign:instance:proflearning:Req_26_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The initial application form includes a mandatory requirement to name a Coordinator. The initial application form includes a field to name an Assistant Coordinator." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Same structural gap as 26.1.1 — no SponsorApplication to hold this data at intake time. Distinct from the ONGOING coordinator-management capability that IS modeled (plrn:CoordinatorAssignment entity on the already-approved plrn:ProfessionalLearningSponsorAggregate, plrn:CoordinatorAssignedEvent) — this story is specifically about capturing the Coordinator/Assistant Coordinator names as part of the initial APPLICATION, before any Sponsor record exists to assign them to." ;
	<urn:solutiondesign:ontology:requirementId> "26.1.2" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to name a Coordinator and/or Assistant Coordinator on my application so that the state knows the designated contacts responsible for professional learning activities." ;
	<urn:solutiondesign:ontology:title> "Name a Coordinator and/or Assistant Coordinator on the Sponsor application" .

<urn:solutiondesign:instance:proflearning:Req_26_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The user can update the form details when a new Coordinator has been assigned. The user can update the form details when a new Assistant Coordinator has been assigned." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Unlike 26.1.1/26.1.2, this story describes ONGOING maintenance (after the Sponsor is already approved), which is the scenario plrn:CoordinatorAssignment/plrn:ProfessionalLearningSponsorAggregate DO model conceptually — but the mechanism to actually perform this update is the same already-flagged gap plrn:Question_MissingSponsorSequences (Open Question #10) names: proflearning-sequences.md has no 'Manage Sponsor Contact Information' sequence despite the Sponsor aggregate's own 'Referenced In' list citing one, and plrn:Perm_SponsorEdit's own notes confirm no update-sponsor API operation exists at all. This FDD independently confirms that gap's real-world trigger (a Coordinator/Assistant Coordinator change) rather than raising a new one — see the Annotation immediately below." ;
	<urn:solutiondesign:ontology:requirementId> "26.1.3" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to be able to update the Coordinator or Assistant Coordinator information after submission so that my profile accurately reflects my lead personnel." ;
	<urn:solutiondesign:ontology:title> "Update Coordinator/Assistant Coordinator information after submission" .

<urn:solutiondesign:instance:proflearning:Req_26_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upon submission for approval, the application status changes to Pending Review. The system locks the application record when the application is submitted for approval. The sponsor is prevented from making edits to the record while it is in the Pending Review status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "No SponsorApplication status/lifecycle model exists anywhere — contrast with plrn:ApplicationReviewStatus (Submitted/PendingApproval/Approved/Rejected/RequiresInfo), the parallel, already-modeled status enum on the Program-application side. If a SponsorApplication entity is ever built, this status shape is the closest existing template to extend from, not a wholly new design." ;
	<urn:solutiondesign:ontology:requirementId> "26.1.4" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want the system to lock the record after submission and assign a Pending Review status so that I know the application is officially under state review." ;
	<urn:solutiondesign:ontology:title> "Lock the application record and assign Pending Review status on submission" .

<urn:solutiondesign:instance:proflearning:Req_26_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upon submission, the system identifies the Lead Admin and sends an email with a secure, one-time use link. The link directs the Lead Admin to a review page displaying applicant details and justification. The Lead Admin can Approve (requires E-signature/Attestation) or Deny (requires comments). If Denied, the workflow ends, and the application is not sent to the State. The system stores audit details of the action." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "The single largest, most specific piece of missing functionality in this Feature: a district-level Lead Administrator (Superintendent) e-signature gate, with its own actor (not 'Coordinator' or 'Professional Learning Admin' — a THIRD role never otherwise mentioned in proflearning-domain.md/proflearning-permissions.md), a secure one-time-use email link, and an audit trail — none of which has any counterpart anywhere in proflearning-domain.ttl, proflearning-permissions.ttl, or proflearning-api.ttl. No Role instance for 'Lead Administrator'/'Superintendent' exists in this domain's converted files at all. This is also the story most directly contradicted by proflearning-domain.ttl's Sponsor aggregate Design Note ('no PendingApproval state... sponsor creation is EEM-only') — see Question_SponsorApprovalWorkflowContradiction." ;
	<urn:solutiondesign:ontology:requirementId> "26.1.5" ;
	<urn:solutiondesign:ontology:statement> "As the Lead Administrator (Superintendent), I want to receive notification of a Sponsor Application and be able to electronically sign/approve it, so that I can authorize my organization's participation as a professional learning sponsor before the State reviews it." ;
	<urn:solutiondesign:ontology:title> "Lead Administrator e-signature approval of the Sponsor application" .

<urn:solutiondesign:instance:proflearning:Req_26_1_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The application status remains in a \"Pending Local Approval\" (or similar) state until the Lead Administrator completes the e-signature. Upon successful Lead Administrator approval, the application status changes to Pending Review and is routed to the Professional Learning Administrator's worklist. The Applicant (Sponsor User) receives a notification that their request has been approved by their Lead Admin and forwarded to the State." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Depends entirely on 26.1.4/26.1.5's missing status model and Lead-Admin gate. Also the story FDD 28's own Feature-28.1 header note points at from the opposite direction: FDD 28 (Processing) independently confirms, via its own worklist/wireframes, that a Sponsor application DOES eventually reach the Professional Learning Admin's worklist — this story is the specific routing RULE (only after Lead Admin approval) that FDD 28 does not itself describe, since FDD 28 only sees the worklist from the point an item already appears in it." ;
	<urn:solutiondesign:ontology:requirementId> "26.1.6" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to route the Sponsor Application to the Professional Learning Administrator worklist only after Lead Administrator approval, so that State workers only review applications that have been authorized by the district." ;
	<urn:solutiondesign:ontology:title> "Route Sponsor Application to Professional Learning Admin worklist only after Lead Admin approval" .

<urn:solutiondesign:instance:proflearning:Req_26_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides the SCECH Program Application form for submitting new professional learning programs. The application includes mandatory sections for Program Name, Program Type, Registration Link, Program Description, Category, Sub-Category, Program Fee, Maximum SCECH Hours, Purpose of Learning, and Program Agenda (via Program Documents Upload). The Program Type section requires selection of the Program Type from a drop-down list of values. The form allows the user to upload the Program Agenda document, with file types defined by the Professional Learning Admin. Upon selecting \"Next,\" the applicant will be prompted to enter the corresponding Program Dates and Location(s) for which they are applying." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match — every named field (name, type, registration link, description, category/subcategory, fee, max SCECH hours, agenda document, sessions/dates/locations) has a direct counterpart on plrn:ProfessionalLearningProgramAggregate's own value objects (ProgramContact/ProgramCategoryVO/ProgramFormatVO/SCECHAllocation/ProgramAgenda/ApprovalPeriod/SessionLocation). Confirmed by Wireframe4 (plrn:Wireframe4Doc). The tracked-change-inserted 'SCECH Eligibility' restructuring (comments 17/18/19/223948687 — splitting New-Teacher-PD/Re-certification indicators out of Program Type into their own section) is a form-layout refinement already reflected in the visible AC text above, not a modeling gap: it still maps to the same underlying fields." ;
	<urn:solutiondesign:ontology:requirementId> "26.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SubmitProgramApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_ProgramApplicationSubmission> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to access a comprehensive application form so that I can provide all necessary details to add a new program." ;
	<urn:solutiondesign:ontology:title> "Comprehensive application form to add a new Program" .

<urn:solutiondesign:instance:proflearning:Req_26_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system displays a summary of the application details before submission is allowed. The user is required to review the application details summary. The system displays attestation language for the user to review and agree with. The Professional Learning Sponsor must agree to the attestations prior to submitting the application form." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe6 (plrn:Wireframe6Doc, the document's own 'Step 3 of 3' summary+attestation screen). Same client-side-review treatment used elsewhere in this project's FDD reviews (e.g. FDD 28's Req_28_5_5/28_5_6): the summary display and attestation checkbox are UI-rendering concerns on top of the same submit operation, not a distinct backend capability requiring its own node — no attestation-acceptance field is separately modeled on plrn:ProgramApplication, which is a minor, low-impact documentation gap if attestation acceptance itself ever needs to be individually audited." ;
	<urn:solutiondesign:ontology:requirementId> "26.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SubmitProgramApplication> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to review a summary and agree to attestations before submission so that I can confirm the accuracy of the program details." ;
	<urn:solutiondesign:ontology:title> "Review summary and agree to attestations before submitting a Program application" .

<urn:solutiondesign:instance:proflearning:Req_26_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The application form allows the Professional Learning Sponsor to submit requests to renew existing programs. Selecting the \"...\" will allow the option to \"Renew Program\". The Professional Learning Sponsor can edit the application form details for existing programs. These fields will prepopulate with the prior academic year's information but can be modified as needed. Programs require renewal each academic year." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "plrn:ProgramApplication's own description ('Entity tracking application lifecycle (new, modify, renew)') explicitly names 'renew' as a first-class lifecycle value, confirming this capability is modeled at the entity level — but plrn:Op_SubmitProgramApplication's own summary text only says 'Submit new or modified program application,' never mentioning renewal explicitly, and proflearning-api.ttl documents no distinct applicationType enum values anywhere for someone to confirm 'Renew' is actually accepted alongside 'New'/'Modify.' Minor documentation gap, not a structural one: the entity's own comment is good evidence renewal is intended to route through the same operation, just not confirmed by the operation's own documentation. Comment 8 (Ross, 2025-12-04, confirmed by Dontje's own resolution note) corroborates renewal happens 'every academic year' via 'the same [process] as adding a new application.'" ;
	<urn:solutiondesign:ontology:requirementId> "26.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SubmitProgramApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProgramApplication> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to be able to renew my existing approved programs so that I can maintain current offerings and comply with academic year renewal requirements." ;
	<urn:solutiondesign:ontology:title> "Renew existing approved Programs" .

<urn:solutiondesign:instance:proflearning:Req_26_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The application form allows the Professional Learning Sponsor to submit requests to modify existing programs. Selecting the \"...\" will allow the option to \"Edit Program\". The Professional Learning Sponsor can edit the application form details for existing programs." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match — plrn:Rule_ModifiedProgramsRequireReapproval's own text ('Sponsor-initiated edits... route through the full approval workflow') directly describes this story, applicationType=Modify per plrn:Perm_ProgramEdit's own notes. See Question_FieldLevelReapprovalUnresolved below for an unresolved refinement of exactly which fields trigger re-approval, raised by this FDD's own most recent (2026-03-11) comment thread." ;
	<urn:solutiondesign:ontology:requirementId> "26.2.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SubmitProgramApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_ModifiedProgramsRequireReapproval> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to be able to modify my existing approved programs so that I can make necessary changes/modifications." ;
	<urn:solutiondesign:ontology:title> "Modify existing approved Programs" .

<urn:solutiondesign:instance:proflearning:Req_26_2_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "If changes are made to the program details after the program has been approved by the Professional Learning Administrator, the system automatically routes the updated application. The updated application is routed through the full Professional Learning Program approval process for review by the Professional Learning Admin." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match — plrn:Rule_ModifiedProgramsRequireReapproval, plrn:ProgramModifiedEvent, and the already-modeled admin-approval sequence together cover this end-to-end. Comments 11/12 (Ross/Dontje) already confirm, and the visible AC text already states, that the ORIGINALLY approved program details remain searchable while the modified application is under review — no separate modeling needed for that nuance, it's a read/query-time concern already satisfied by plrn:Op_GetProgram/plrn:Op_ListPrograms continuing to serve the prior approved version. See Question_FieldLevelReapprovalUnresolved immediately below for the one genuinely open nuance on this story." ;
	<urn:solutiondesign:ontology:requirementId> "26.2.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SubmitProgramApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProgramModifiedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_ModifiedProgramsRequireReapproval> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AdminApprovesProgramApplication> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want the system to re-route my modified application for approval if I change details of an already approved program so that the changes are reviewed by the Professional Learning Admin." ;
	<urn:solutiondesign:ontology:title> "Re-route a modified approved Program's application for approval" .

<urn:solutiondesign:instance:proflearning:Req_26_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The SCECH Program Application includes a specific field for the Program Agenda (Document Upload). The Professional Learning Sponsor can successfully upload the required Program Agenda documentation as part of the application process." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match — plrn:ProgramAgenda is a real, modeled ValueObject and plrn:Seq_ProgramApplicationSubmission's own mermaid content already shows the coordinator's UI calling DocumentsAPI to upload the agenda before submitting the application. Confirmed by Wireframe7 (plrn:Wireframe7Doc)." ;
	<urn:solutiondesign:ontology:requirementId> "26.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_RequestDocumentUpload> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProgramAgenda> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_ProgramApplicationSubmission> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to be able to upload my Program Agenda so that I can provide supporting documentation required for the application." ;
	<urn:solutiondesign:ontology:title> "Upload the Program Agenda document" .

<urn:solutiondesign:instance:proflearning:Req_26_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system enforces a predefined list of allowable file types for the Program Agenda document upload. The specific allowable file types are defined and managed by the Professional Learning Admin (Reference Business Specification Professional Learning - Admin Users (14) for additional information). The system rejects uploads that do not conform to the predefined allowable file types." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe7 (plrn:Wireframe7Doc), which shows a live 'File type not supported' rejection UI and a concrete allowed-type list (.doc/.docx/.pdf) not stated anywhere in proflearning-domain.ttl or the Addendum text itself. GAP: no admin-configurable allowed-file-type list exists anywhere in proflearning-domain.ttl/proflearning-api.ttl (this FDD's own AC explicitly defers ownership of that configuration to FDD 14, Professional Learning Admin, which was not reviewed as part of this pass) — this is a genuine cross-FDD dependency, not something this domain's own model would be expected to carry regardless. Documents domain itself (docs:Op_RequestDocumentUpload) was not inspected in full for this pass to confirm whether it has any generic file-type-restriction mechanism of its own; left unconfirmed rather than assumed. See the Annotation immediately below." ;
	<urn:solutiondesign:ontology:requirementId> "26.3.2" ;
	<urn:solutiondesign:ontology:statement> "As a system, I want to enforce predefined allowable file types for document uploads so that data integrity and system security are maintained." ;
	<urn:solutiondesign:ontology:title> "Enforce predefined allowable file types for document uploads" .

<urn:solutiondesign:instance:proflearning:Req_26_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Not a user story — the Addendum states this feature's own removal in one sentence, no numbered sub-stories or acceptance criteria. This is the ORIGIN of the dependency FDD 28's own Req_28_2 cites: FDD 28's Feature 28.2 ('Publishing the Professional Learning Catalog') was dropped specifically BECAUSE this feature (26.4) was dropped first — FDD 28's own text says so explicitly ('Business Specification #26 Professional Learning - Sponsor, contains feature 26.4: Professional Learning Catalog which is considered no longer necessary'). The two rejections are two sides of one decision, not two independent ones. Consistent with plrn:Op_SearchCatalog's real, modeled 'catalog' actually being the PUBLIC catalog search surface (31.5 Public Search), a distinct capability from whatever Sponsor-side 'catalog' this dropped feature would have added." ;
	<urn:solutiondesign:ontology:requirementId> "26.4" ;
	<urn:solutiondesign:ontology:statement> "It has been determined that this feature is no longer considered necessary." ;
	<urn:solutiondesign:ontology:title> "Professional Learning Catalog" .

<urn:solutiondesign:instance:proflearning:Req_26_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Sponsor can add attendees to a program roster via online entry (manual input). The Professional Learning Sponsor can add attendees to a program roster via a file upload (bulk enrollment). The system allows the sponsor to search globally for attendees since individuals may not be associated with the sponsor's entity. The system includes a process for the SCECH Sponsor to upload bulk files for individual-level participation or attendance." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Both entry paths (online, bulk file) are real, modeled operations, confirmed by Wireframe8 (plrn:Wireframe8Doc). PARTIAL, already-documented gap on the 'search globally' requirement specifically: plrn:Seq_AddAttendeesToProgram's own SequenceReference for 'GET /educators/search?query={name}' is already marked resolutionStatus 'no-such-endpoint' in proflearning-sequences.ttl — this FDD's own AC ('search globally for attendees since individuals may not be associated with the sponsor's entity,' citing 'BRD 26.5.1' by name) is the actual source requirement that endpoint was meant to satisfy. Confirming, not raising, that gap." ;
	<urn:solutiondesign:ontology:requirementId> "26.5.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_AddAttendee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_BulkUploadAttendees> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AddAttendeesToProgram> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to be able to add attendees to a program roster using both online entry and file upload so that I can efficiently manage participation records." ;
	<urn:solutiondesign:ontology:title> "Add attendees to a program roster via online entry and file upload" .

<urn:solutiondesign:instance:proflearning:Req_26_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "By default, the system applies the maximum approved SCECHs for the program as the awarded value for attendees. When utilizing the bulk upload function, the system allows the sponsor to define adjusted SCECH amounts in the data file prior to upload. The system will accept any value less than or equal to the maximum approved amount for each individual. After attendees are added (whether via bulk upload or single entry), the system provides the sponsor the ability to manually edit (increase or decrease) the awarded SCECH hours for any individual attendee within the UI, up to the maximum approved amount." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "SOURCE-MATERIAL NOTE: the pre-generated .md sibling shows this story's Acceptance Criteria as completely blank — the real text above was reconstructed from word/document.xml's tracked-change (w:ins, Caswell, DTMB-Contractor, 2026-03-11T20:14-20:15) content, which the .md extraction tool evidently drops; see this file's header note. Once reconstructed, this is a clean match: plrn:Rule_DefaultScechEqualsMax already states exactly this default-to-max-then-adjust behavior, and plrn:Op_AdjustScechAward is the real, modeled mechanism. Corroborated by comments 13/14/20/21/22 and their Mar-2026 replies (472884203/575263450), all converging on the same resolved behavior now reflected in the AC text used here." ;
	<urn:solutiondesign:ontology:requirementId> "26.5.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_AdjustScechAward> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_DefaultScechEqualsMax> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want the system to accept SCECH hours less than the max amount so that I can report accurate SCECH attendance." ;
	<urn:solutiondesign:ontology:title> "Accept SCECH hours less than the program maximum" .

<urn:solutiondesign:instance:proflearning:Req_26_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Sponsor can adjust the number of awarded SCECHs for a single attendee. The capability to increase or decrease awarded SCECHs is available, but not to exceed the max number." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match, confirmed by Wireframe9 (plrn:Wireframe9Doc, the 'Edit Attendee' modal with its own SCECH-hours field). Same operation as 26.5.2, single-attendee framing." ;
	<urn:solutiondesign:ontology:requirementId> "26.5.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_AdjustScechAward> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to be able to increase or decrease awarded SCECHs for a single attendee so that I can accurately reflect partial attendance or non-completion." ;
	<urn:solutiondesign:ontology:title> "Increase or decrease awarded SCECHs for a single attendee" .

<urn:solutiondesign:instance:proflearning:Req_26_5_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system requires the Professional Learning Sponsor to review attendee details before final certification. The system requires the Professional Learning Sponsor to agree to attestations prior to certifying attendance. The sponsor is able to certify the finalized program attendance. Upon certification, the individuals listed on the attendance roster are awarded the SCECHs approved by the sponsor." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong, end-to-end match confirmed by Wireframe10 (plrn:Wireframe10Doc). Attestation-before-certify is the same client-side-review treatment as 26.2.2 — no separate node needed. plrn:AttendanceCertifiedEvent's own consumers (Credentialing, Communications) already cover the 'attendees notified of new SCECHs' business-specifications text (a separate sentence in the prose, not its own numbered story)." ;
	<urn:solutiondesign:ontology:requirementId> "26.5.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:AttendanceCertifiedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_CertifyAttendance> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_CertifiedAwardsImmutable> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AdjustScechAwardsAndCertify> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want to certify the finalized program attendance so that the awarded SCECHs are officially processed and registered for the attendees." ;
	<urn:solutiondesign:ontology:title> "Certify finalized program attendance" .

<urn:solutiondesign:instance:proflearning:Req_26_5_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system displays the roster of attendees for each program. The Professional Learning Sponsor can create and export the roster of attendees for external record keeping or auditing purposes. The ability to view the roster is tied to appropriate Professional Learning Sponsor permissions; the ability to export is tied to SOM UI/UX standards." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL: view is a clean, already-modeled match (plrn:Op_GetSessionRoster, gated by plrn:Perm_AttendanceView). GAP: 'export' has no distinct API operation or mechanism anywhere in proflearning-api.ttl — the AC's own text defers export's shape to 'SOM UI/UX standards' rather than describing a specific format, consistent with this being a client-side rendering/download concern (e.g. a CSV/PDF export button over the same roster data) rather than a missing backend capability; still worth naming as a minor, low-impact documentation gap rather than silently assuming it's covered." ;
	<urn:solutiondesign:ontology:requirementId> "26.5.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSessionRoster> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want the ability to create view and export a roster of attendees so that I can maintain external records or use the data for auditing purposes." ;
	<urn:solutiondesign:ontology:title> "View and export a roster of attendees" .

<urn:solutiondesign:instance:proflearning:Req_26_6_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides a dedicated worklist interface for the Professional Learning Sponsor. The worklist displays action items requiring the sponsor's attention." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL, mirroring FDD 28's own worklist-coverage pattern from the admin side: plrn:Op_ListProgramApplications already covers the Program-application half of this worklist ('Coordinators see only applications for their sponsor' per its own notes) — confirmed by Wireframe11 (plrn:Wireframe11Doc). The Business Specifications prose explicitly says this worklist 'will include sponsor and program applications that have action items assigned by the Professional Learning Processing Administrator (28.0)' — the SPONSOR-application half of that has nothing to list, since no SponsorApplication entity exists (Feature 26.1's gap). satisfiedBy still asserted since the Program-application half is real and the story is fundamentally about a worklist UI pattern already in place; the Sponsor-application half of the gap is the same one already captured under Feature 26.1, not re-raised as a separate Annotation here." ;
	<urn:solutiondesign:ontology:requirementId> "26.6.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListProgramApplications> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want the system to display a worklist of action items so that I can quickly address tasks assigned to me." ;
	<urn:solutiondesign:ontology:title> "Display a worklist of action items for the Sponsor" .

<urn:solutiondesign:instance:proflearning:Req_26_6_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The worklist allows the Professional Learning Sponsor to efficiently access the specific application (program or sponsor) associated with each action item. The system enables direct navigation from the worklist entry to the form or application details needing attention." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:notes> "Same partial coverage as 26.6.1 — the hyperlink-to-detail UI pattern is confirmed by Wireframe11 (Program Name as a clickable link) and backed by the real list+detail operation pair for Program applications; the AC's own parenthetical '(program or sponsor)' again names the Sponsor-application half that has nothing to link to." ;
	<urn:solutiondesign:ontology:requirementId> "26.6.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetProgramApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListProgramApplications> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Sponsor, I want the worklist to provide a link to the application so that I can easily navigate to the form requiring action." ;
	<urn:solutiondesign:ontology:title> "Worklist links directly to the application requiring action" .

<urn:solutiondesign:instance:proflearning:Req_27_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning program website link is available and clickable. The system navigates the user to the area where they will be able to register for the specific Professional Learning program offering(s), within the external website. The user can register for currently offered or future Professional Learning programs using the respective program's website link." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 1 (plrn:Wireframe1Doc, 'Visit Program Website' button). Minor documentation gap: no explicit website-URL field is modeled on plrn:ProfessionalLearningProgramAggregate or plrn:ProgramContact (which only has name/phone/email) — the closest textual evidence is plrn:UT_ProgramFee's own definition ('actual payment collection happens on the sponsor's external registration website'), which confirms the concept exists but doesn't name a field for it. Registration itself (the AC's second/third bullets) happens entirely on the external site, outside MiEdWorkforce's own scope — consistent with proflearning-domain.ttl's own explicit non-ownership of 'program fee collection... on the sponsor's own external registration site'." ;
	<urn:solutiondesign:ontology:requirementId> "27.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetProgram> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to view a link to the respective program's website so that I can register for currently offered or future Professional Learning programs." ;
	<urn:solutiondesign:ontology:title> "View program website link to register" .

<urn:solutiondesign:instance:proflearning:Req_27_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Follows standard Public Search (31), feature 32.5 layout conventions. Search by keyword (Program Name). Filter by Program Type, Format (Virtual/In-Person/Blended-Hybrid), Date Range, Credit Hours (SCECHs). Results in tabular/card format (Program Name, Date(s), Credit Hours). Sort by Date and Program Name. Pagination supported. Clicking a Program Name navigates to Program Details. Default view shows only active/upcoming programs. A bookmark indicator/action is available directly from search results." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 2 (plrn:Wireframe2Doc) — filter fields (keyword, date range, county, sponsor, category, hours, fee, format including Dontje's comment-16 'or blended/hybrid' correction) match closely, though county/sponsor/fee filters go beyond this story's own narrower AC list. Same minor documentation-gap pattern already noted across other domains' equivalent stories: plrn:Op_SearchCatalog's sd:responseSchema documents the result shape but not its query parameters, so Program Type/Format/Date-Range/Credit-Hours are not individually confirmed as real query parameters, only that the operation and result fields exist. Pagination is documented (response includes 'pagination'). Default-active-only filtering matches plrn:Rule_OnlyActiveProgramsInCatalog exactly." ;
	<urn:solutiondesign:ontology:requirementId> "27.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SearchCatalog> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_PublicCatalogSearch> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to search for Professional Learning Programs using various criteria, so that I can identify relevant learning opportunities to attend or bookmark for later." ;
	<urn:solutiondesign:ontology:title> "Search for Professional Learning Programs" .

<urn:solutiondesign:instance:proflearning:Req_27_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Follows standard Public Search (31), feature 32.5 layout conventions. Search by Sponsor Name. Results display Provider Name and Contact Information. Sort alphabetically by Provider Name. Clicking a Provider Name navigates to the Provider Details page, listing that provider's active programs under a 'Programs' tab. Viewable regardless of login status; bookmarking requires login. A bookmark indicator/action is available directly from search results." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match: plrn:Op_SearchCatalog's CatalogSearchResult is explicitly a composite spanning both Program and Sponsor (resultType discriminates), and plrn:Op_GetSponsor's SponsorDetail response already nests activePrograms[] — exactly the 'Provider Details page... Programs tab' AC. Dual-access (external-public + internal-user) on both operations matches the 'viewable regardless of login status' requirement precisely." ;
	<urn:solutiondesign:ontology:requirementId> "27.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSponsor> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SearchCatalog> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_PublicCatalogSearch> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to search for Professional Learning Providers (Sponsors), so that I can find specific organizations offering training and view their contact information or course catalogs." ;
	<urn:solutiondesign:ontology:title> "Search for Professional Learning Providers (Sponsors)" .

<urn:solutiondesign:instance:proflearning:Req_27_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Bookmark from search results list or Program Details page. Visual indicator on bookmarked programs. A 'Saved Programs' dashboard section exists. Clicking a saved program navigates to Program Details. Shows upcoming/active by default; a 'Show Inactive'/'Show Past' toggle is available. Data adheres to academic year boundaries. Users can remove a bookmark from either the dashboard list or the Program Details page." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "Core bookmarking mechanism is a clean match (itemType=Program on all three Bookmark operations); plrn:Seq_PublicCatalogSearch's own 'opt Bookmark (authenticated only)' branch is the end-to-end sequence that actually carries this story out, per this Phase 2 pass's convention of preferring the Sequence link over a lone operation when one exists — linked first, ahead of the individual Bookmark operations it calls. Confirmed real (tab structure, if not table content) by Wireframe 3 (plrn:Wireframe3Doc) — see that SourceDocument's own note on the wireframe-fidelity mismatch in its underlying table data. Two narrower gaps, minor relative to the rest of this story: (1) the 'Show Inactive'/'Show Past' toggle and 'academic year boundaries' filtering are not documented as query parameters anywhere on plrn:Op_ListBookmarks (same class of minor documentation gap noted elsewhere in this domain's search/list operations); (2) the dashboard SECTION itself ('Saved Programs' as a piece of dashboard layout/composition, distinct from the bookmark data it displays) is a Dashboards-capability concern — dash:DashboardsContext exists only as a stub (sd:status \"stub\") per CONVENTIONS.md's registry, so the dashboard-placement half of this story has no real target to point at; the underlying data API is real and is what satisfiedBy names here." ;
	<urn:solutiondesign:ontology:requirementId> "27.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_CreateBookmark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_DeleteBookmark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListBookmarks> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Perm_CatalogBookmark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_PublicCatalogSearch> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to bookmark Professional Learning Programs from the catalog or search results, so that I can easily access them later under a \"Saved Programs\" section on my dashboard." ;
	<urn:solutiondesign:ontology:title> "Bookmark Professional Learning Programs (Saved Programs)" .

<urn:solutiondesign:instance:proflearning:Req_27_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Bookmark from Provider search results or Provider Details page. A 'Saved Providers' dashboard section exists, separate from 'Saved Programs'. List displays Provider Name and contact/status information. Clicking a provider name navigates to Provider Details. Removing a bookmark immediately updates the dashboard section. An inactive provider remains in the saved list with a visual inactive indicator." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "Same mechanism, same Sequence-first rationale, and same two gaps as plrn:Req_27_1_4 (itemType=Sponsor here) — see that story's notes; not repeated in full. The 'inactive provider remains listed with a visual indicator' behavior is plausible given plrn:SponsorStatus (Active/Inactive) is a real, queryable field on plrn:Op_GetSponsor's response, but is not independently confirmed as bookmark-list-specific behavior anywhere in the API documentation." ;
	<urn:solutiondesign:ontology:requirementId> "27.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_CreateBookmark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_DeleteBookmark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListBookmarks> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Perm_CatalogBookmark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_PublicCatalogSearch> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to bookmark Professional Learning Providers (Sponsors), so that I can quickly find their information and offerings under a \"Saved Providers\" section on my dashboard." ;
	<urn:solutiondesign:ontology:title> "Bookmark Professional Learning Providers (Saved Providers)" .

<urn:solutiondesign:instance:proflearning:Req_27_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Citizen User can complete and submit the required Professional Learning program evaluation, per Programs with status of \"Awaiting Evaluation\". Upon successful submission, the system automatically awards the appropriate Professional Learning credit hours." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE GAP, independently confirmed from the opposite side of a gap FDD 28 already flagged: proflearning-permissions.ttl's plrn:Perm_EvaluationSubmit and plrn:Perm_EvaluationView both already document that neither an evaluation-submission API operation nor an 'Attendee Submits Evaluation' sequence exists anywhere in proflearning-api.ttl/proflearning-sequences.ttl, despite plrn:EvaluationTemplateAggregate's own 'Referenced In' list citing such a sequence and plrn:Rule_EvaluationRequirementProgramSpecific depending on evaluation submission as a certification precondition. FDD 28's own 28.4.6 (this session's prior pass) confirmed the ADMIN review-side of this same missing capability; this story is the independent SUBMISSION-side confirmation, now from the actual educator-facing FDD, not an assumption. Confirmed real and wireframed (Wireframe 4 / plrn:Wireframe4Doc, Wireframe 5 / plrn:Wireframe5Doc) — a load-bearing, twice-confirmed gap, not modeled speculatively. ADDITIONALLY unresolved per a late review comment: see plrn:Question_AttestationVsEvaluationSubmissionUnresolved — Dontje's comment 12 says the entire award-on-evaluation-submission narrative this story describes needs revision for the evaluations-OFF launch configuration, and that revision was never folded back into this story's visible text." ;
	<urn:solutiondesign:ontology:requirementId> "27.2.1" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to submit the required program evaluation so that the system automatically awards my professional learning credit hours." ;
	<urn:solutiondesign:ontology:title> "Submit required program evaluation to receive credit hours" .

<urn:solutiondesign:instance:proflearning:Req_27_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The user can initiate this request when they believe the awarded hours are incorrect. The user can submit a request or query for correction/review of awarded hours. The system sends the request/query to the Professional Learning administrator for review." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE GAP, direct confirmation of plrn:Question_EducatorInitiatedCorrectionPathway (Open Question #11), raised during proflearning-domain.ttl's own conversion purely from the aggregate's own sponsor/coordinator-only shape (plrn:SCECHCorrectionRequestAggregate's ERD documents submitted_by_user_unique_id as 'Coordinator who submitted'; plrn:Perm_CorrectionSubmit is coordinator-scoped only) — this is the first FDD in this batch to actually describe the educator-initiated pathway that question anticipated, not just infer its absence. Confirmed wireframed: Wireframe 4 (plrn:Wireframe4Doc)'s 'Appeal Hours' link is this story's own entry point, on the same screen as 27.2.1's evaluation-gated award display. satisfiedBy deliberately left unasserted — plrn:Op_SubmitCorrectionRequest and plrn:Perm_CorrectionSubmit both exist but are coordinator-scoped only; extending either to a citizen/educator caller (a different accessType/scope entirely) is exactly the open design decision Question #11 already names, not something this review can resolve unilaterally by linking to the wrong-actor operation." ;
	<urn:solutiondesign:ontology:requirementId> "27.2.2" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to submit a request for correction or review of my professional learning hours awarded so that I can dispute records I believe are incorrect." ;
	<urn:solutiondesign:ontology:title> "Submit a request for correction or review of awarded hours" .

<urn:solutiondesign:instance:proflearning:Req_27_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "An email/alert is sent if the user attended a program requiring evaluation and hasn't submitted it. If the program doesn't require evaluation, no notification is sent and credits award automatically upon sponsor submission. The notification is triggered on an adjustable interval, configurable by the Professional Learning Administrator. Emails use the standardized framework with dynamic coded-insert fields." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL match, architecture exists but the specific instance doesn't: proflearning-domain.ttl already asserts comm:CommunicationsContext sd:subscribesTo plrn:EvaluationRequiredEvent, and communications-capability.ttl models a real, generic event-driven templated-email mechanism (comm:EmailTemplateAggregate + the event-consumption architecture demonstrated end-to-end by comm:Seq_MassEmailWithConsolidation, albeit for a Data Quality event as its own worked example, not a Proflearning one) — the underlying capability plausibly extends to this use case, and comm:Perm_ProflearningTemplatesView/Create/Edit/Activate and comm:Perm_ProflearningEmailsViewHistory/Resend already exist as one of Communications' four gated functional areas per FDD 28's own finding. But no Proflearning-specific sequence or template instance is actually confirmed, and — more significantly — no REPEATING, configurable-interval reminder cadence exists anywhere in Communications: comm:Seq_MassEmailWithConsolidation's only configurable timing concept is a one-time 15-minute consolidation-buffer window (per event TYPE, not a recurring per-condition reminder), a different mechanism than 'send this reminder again every N days until the condition clears.' See the shared coverage-gap Annotation covering this story, 27.3.3, and 27.3.4 together." ;
	<urn:solutiondesign:ontology:requirementId> "27.3.1" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to receive emails (and system alerts) using the centralized Communications framework so that I am reminded to complete pending tasks that are preventing me from receiving Professional Learning credit." ;
	<urn:solutiondesign:ontology:title> "Receive email/alert reminders for pending evaluations via centralized Communications" .

<urn:solutiondesign:instance:proflearning:Req_27_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system identifies a Citizen User who attended a program with 'Evaluation Required' ON. If required and not submitted, the record is flagged 'Pending Evaluation'. An alert is generated and displayed in the Alerts list/Dashboard (Bell icon or Dashboard Widget) upon login. The alert notifies the user of the specific pending evaluation(s) and links to the evaluation form." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "GOOD MATCH: comm:AlertAggregate/comm:Seq_DashboardAlertCreationAndDisplay is a real, generic, already-modeled mechanism (role/event-based targeting, action-link deep-linking, dashboard-widget/bell-icon display via comm:Op_ListAlerts) and proflearning-domain.ttl already asserts the specific subscription this story needs (comm:CommunicationsContext sd:subscribesTo plrn:EvaluationRequiredEvent). The sequence's own worked example uses a Data Quality event, but the mechanism itself is event-agnostic, unlike 27.3.1/27.3.3/27.3.4's email-interval gap. Also targeted by plrn:Question_AttestationVsEvaluationSubmissionUnresolved — comment 19's 'Need to discuss' on this exact story means its literal 'pending evaluation' framing may need to become 'pending attestation' pending that unresolved discussion, but the underlying Alert mechanism itself is unaffected either way." ;
	<urn:solutiondesign:ontology:requirementId> "27.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:AlertAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ListAlerts> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Seq_DashboardAlertCreationAndDisplay> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to generate a system alert for the Citizen User if they have pending evaluations for programs that require them, so that they are prompted to complete the steps necessary to receive their credits." ;
	<urn:solutiondesign:ontology:title> "Generate a dashboard alert for pending evaluations" .

<urn:solutiondesign:instance:proflearning:Req_27_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system identifies Citizen Users with 'Evaluation Required' ON and evaluation not yet completed. If not required, no email is sent. An email reminder is sent to identified users. Frequency/timing is governed by a configurable interval set by the Professional Learning Administrator. Email content uses the centralized Alerts, Emails, and Communications framework." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "Same partial-match/gap as plrn:Req_27_3_1 — see that story's notes and the shared coverage-gap Annotation below (this story, 27.3.1, and 27.3.4 together). The 'only when required' conditional-send logic is a plausible template-selection/targeting-rule detail within the existing comm:EmailTemplateAggregate mechanism, but the recurring configurable-interval half of this AC has no counterpart anywhere in communications-capability.ttl/-sequences.ttl." ;
	<urn:solutiondesign:ontology:requirementId> "27.3.3" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to send email notifications to Citizen Users regarding pending Professional Learning evaluation(s) only when an evaluation is required, so that they are reminded to submit them to receive their credit." ;
	<urn:solutiondesign:ontology:title> "Send email notifications for pending evaluations on a configurable interval" .

<urn:solutiondesign:instance:proflearning:Req_27_3_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Administrator can access system settings for communications/business-rule thresholds. The Administrator can define/update the interval value triggering pending-evaluation email reminders. The system uses this interval to control reminder frequency, only for programs with 'Evaluation Required' active. Updates to intervals are logged in audit history (Modified By/Modified Date)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE, NEWLY-FLAGGED GAP: no configurable numeric time-interval/threshold concept for a RECURRING reminder cadence exists anywhere in communications-capability.ttl, -api.ttl, -sequences.ttl, or -technical-design.ttl — Wireframe 6 (plrn:Wireframe6Doc, confirmed by viewing, cross-domain-reused from a Credentialing FDD) shows the closest real analogue, a per-template 'Frequency' field, but it is a categorical select ('Set Frequency'), not the numeric adjustable-interval value this story describes, and it is scoped per-template rather than per-business-rule-threshold. proflearning-domain.md's own Open Question re: evaluation reminder scheduling (deduped into plrn:Question_EvaluationPolicyDetails during proflearning-domain.ttl's own conversion: 'are evaluation reminder emails sent at fixed intervals, or is the schedule configurable per program?') already flagged this as an open design question from the OTHER side (proflearning's own domain doc); this story is FDD 27's confirmation that a configurable-threshold admin capability is real, expected functionality, not speculative. ALSO an unresolved cross-FDD ownership question: comment 20 (Dontje, 2026-01-27) says outright 'This should be captured in #14' (Professional Learning Admin) — see plrn:Question_ReminderIntervalConfigFddOwnershipUnresolved, structurally identical to FDD 28's own comment-18 cross-FDD scope question about evaluation-review ownership." ;
	<urn:solutiondesign:ontology:requirementId> "27.3.4" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I want to configure the adjustable thresholds (time intervals) for pending evaluation email notifications so that the frequency of reminders is managed centrally." ;
	<urn:solutiondesign:ontology:title> "Configure the reminder interval threshold" .

<urn:solutiondesign:instance:proflearning:Req_27_BizSpec_CollegeCourseCredit> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Displays all STARR-reported college courses for the user's Unique ID since the last credential issuance. A course completed before the last credential issuance is not eligible/displayed. The user selects courses to apply for credit. Once applied, a course is no longer available in the display list (High Level Scenarios use cases 4/4a/4b/4c)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "FULLY SATISFIED, unlike the rest of this BizSpec-only cluster — proflearning-domain.ttl/-api.ttl/-sequences.ttl already model this capability end-to-end, matching the AC almost field-for-field (issuance-date eligibility, one-time-use, STARR sourcing). Never promoted to an Addendum number, but that's consistent with it being complete rather than a gap: this domain's own already-documented gap on the SAME sequence is the cross-domain last-issuance-date lookup (cred:LastIssuanceOperation, credentialing-api.ttl has no /last-issuance path — see proflearning-domain.ttl's own notes), not anything specific to this story. See also plrn:Question_CollegeCourseSelfUploadAlternative below for a proposed, unadopted alternative intake mechanism raised in this FDD's own comments." ;
	<urn:solutiondesign:ontology:requirementId> "27-BizSpec-CollegeCourseCredit" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ApplyCollegeCourse> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetEligibleCollegeCourses> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_CollegeCourseNotReusable> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_CollegeCoursePostDatesIssuance> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_EducatorAppliesCollegeCourse> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to view college course data submitted within the CEPI STARR collection and select completed courses to apply toward my Professional Learning credit, so that qualifying coursework counts toward my requirements." ;
	<urn:solutiondesign:ontology:title> "Select completed STARR college courses for Professional Learning credit" .

<urn:solutiondesign:instance:proflearning:Req_27_BizSpec_PastAttendedProgramsSearch> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Search results display in a table, sortable and filterable (date range, cumulatively, status, etc.). Detailed requirements to be provided (per the source document's own placeholder text)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE, NEWLY-FLAGGED GAP: never promoted to an Addendum number (High Level Scenarios use case 3 describes it; no 27.x story exists for it). No API operation anywhere in proflearning-api.ttl returns an educator's own attendance/participation history (the closest analogues — plrn:Op_GetSessionRoster, plrn:Op_ListProgramApplications — are both admin/coordinator-facing, session- or sponsor-scoped, not a citizen's own cross-program history view). Wireframe 3 (plrn:Wireframe3Doc)'s 'Completed Programs' tab is real, wireframed evidence this capability was intended as a distinct screen, but — per that SourceDocument's own note — the table content underneath is mismatched Staffing-domain data, not useable as a literal field-list confirmation. The source document itself flags this area as unfinished ('Detailed requirements will be provided'), consistent with treating this as an honest gap rather than something to force-fit against an unrelated existing operation." ;
	<urn:solutiondesign:ontology:requirementId> "27-BizSpec-PastAttendedProgramsSearch" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Citizen User, I want to search and view my past attended Professional Learning programs in a sortable, filterable results table, so that I can review my own participation history." ;
	<urn:solutiondesign:ontology:title> "Search and view past attended Professional Learning programs" .

<urn:solutiondesign:instance:proflearning:Req_27_BizSpec_ProgramRegistrationDetailsStorage> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:notes> "Not modeled as a user story — the source text describes a system BEHAVIOR (auto-storing registration details), not a citizen-facing want, and two reviewers explicitly confirm it is stale: comment 8 (Ross, 2025-12-04) — 'I believe this is no longer the case and that the bookmarking is for the citizen user to have a more condensed listing of programs and providers that have previously been bookmarked'; comment 9 (Dontje, 2026-01-27) — 'Agreed.' Registration itself happens entirely on the sponsor's external website (see plrn:Req_27_1_1's own notes); MiEdWorkforce's real, current mechanism for a citizen to track programs of interest is bookmarking (27.1.4/27.1.5), not a registration-detail-storage/potential-attendee-reporting feature. Modeled here as a rejected Requirement, not a coverage gap — building registration-storage would contradict two reviewers' explicit, agreed-upon correction." ;
	<urn:solutiondesign:ontology:requirementId> "27-BizSpec-ProgramRegistrationDetailsStorage" ;
	<urn:solutiondesign:ontology:statement> "Once the MiEdWorkforce citizen user registers for a Professional Learning program using the respective program's website link, the details of the registration are stored in MiEdWorkforce to report on potential attendees (Program Name, Date, etc.)." ;
	<urn:solutiondesign:ontology:title> "Store registration details to report on potential attendees (REJECTED / superseded)" .

<urn:solutiondesign:instance:proflearning:Req_28_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Administrator can select a Sponsor application from the worklist. The system must display the submitted application in view mode upon selection." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 2 (plrn:Wireframe2Doc). No SponsorApplication aggregate/entity or backing ApiOperation exists anywhere in proflearning-domain.ttl/proflearning-api.ttl — see this section's header note and plrn:Question_SponsorApprovalWorkflowContradiction (already raised in proflearning-domain.ttl, Open Question #9). This FDD is independent, later evidence that the missing workflow is real and specific, not speculative." ;
	<urn:solutiondesign:ontology:requirementId> "28.1.1" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to view the submitted Sponsor application in view mode so that I can review all details before taking an approval action." ;
	<urn:solutiondesign:ontology:title> "View submitted Sponsor application in view mode" .

<urn:solutiondesign:instance:proflearning:Req_28_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Administrator is able to view documents uploaded within the Sponsor application. The Professional Learning Administrator is able to parse documents uploaded within the Sponsor application. The Professional Learning Administrator is able to extract documents uploaded within the Sponsor application." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Compound gap: even setting aside the missing SponsorApplication container itself (this section's header note), 'parse' specifically has no counterpart anywhere in documents-api.ttl either — docs:Op_DownloadDocument/docs:Op_GetDocumentMetadata/docs:Op_SearchDocuments cover view/retrieve, but no operation extracts or parses document content (OCR, form-field extraction, etc.) in any domain converted so far. 'View'/'extract' alone would be a plausible partial match to the generic Documents capability if a SponsorApplication existed to hold the document references; 'parse' would still be an open gap even then." ;
	<urn:solutiondesign:ontology:requirementId> "28.1.2" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need the ability to view, parse, and extract documents uploaded within the Sponsor application so that I can verify supporting documentation." ;
	<urn:solutiondesign:ontology:title> "View, parse, and extract documents uploaded within the Sponsor application" .

<urn:solutiondesign:instance:proflearning:Req_28_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an option to Approve the selected Sponsor application. The system provides an option to Reject the selected Sponsor application. The system provides an option to Edit the selected Sponsor application, allowing the administrator to modify any submitted field (e.g., to correct typos). The system provides an option to Delete the selected Sponsor application. The ability to delete applies to both a pending Sponsor application and an already approved Sponsor record." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "The visible 'Edit... modify any submitted field' text is the FINAL, resolved position of a contested comment thread: comment 3 (Ross, 2025-12-05) originally said edit access is restricted to an Action + comments only, NOT the application fields; comment 4 (Ross, same day) notes this was 'later discussed as potentially allowing... editable... Need confirmation'; comment 5 (Dontje, 2026-01-28) resolves it — 'Yes, the Sponsor Application should be editable by the admin.' See Question_SponsorApplicationEditabilityWasContested. Structural gap unchanged regardless of which reading won: no SponsorApplication aggregate/entity/API exists at all (this section's header note) — approve/reject/edit/delete are all equally unmodeled. plrn:Perm_SponsorApprove and plrn:Perm_SponsorDelete both already exist in proflearning-permissions.ttl and already document this exact gap in their own notes (no PermissionRequirement, no backing operation) — deliberately not linked via satisfiedBy here since neither actually gates anything yet." ;
	<urn:solutiondesign:ontology:requirementId> "28.1.3" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to have the option to Approve, Reject, Edit, or Delete the Sponsor application so that I can efficiently process the worklist and correct minor errors without returning the application." ;
	<urn:solutiondesign:ontology:title> "Approve, Reject, Edit, or Delete the Sponsor application" .

<urn:solutiondesign:instance:proflearning:Req_28_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an option to Email the respective sponsor from the application review page using editable templates. The email functionality supports communicating a decision regarding the application. The email functionality supports requesting additional information. When requesting information, the system allows the admin to set the application status to \"Needs Information\" (or similar \"Correction\" status)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "GOOD MATCH, cross-domain: communications-api.ttl's comm:Op_SendManualEmail ('Send one-time manual email using template', single recipientEmail + optional customSubject/customBody, gated by comm:Perm_EmailSendManual + comm:Perm_EmailCustomize when customizing) is a genuinely fitting, already-modeled mechanism for 'email the respective sponsor... using editable templates' — and Communications' permission catalog explicitly includes Proflearning as one of its four gated functional areas (comm:Perm_ProflearningTemplatesView/Create/Edit/Activate, comm:Perm_ProflearningEmailsViewHistory/Resend all exist), unlike comm:CommentAggregate below, whose own invariant explicitly does NOT list proflearning as a covered process-item type. Partial gap: setting the application to a 'Needs Information'/'Correction' status still requires the SponsorApplication container this Feature doesn't have (this section's header note) — the email mechanism itself is real, but nothing exists yet to hold the resulting status change." ;
	<urn:solutiondesign:ontology:requirementId> "28.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_SendManualEmail> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Perm_EmailCustomize> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to email the sponsor directly from the review page so that I can communicate decisions or request missing details." ;
	<urn:solutiondesign:ontology:title> "Email the sponsor from the review page" .

<urn:solutiondesign:instance:proflearning:Req_28_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Administrator is able to add comments to the application. The Professional Learning Administrator is able to view the comment history for the application." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 2 (plrn:Wireframe2Doc), which shows a live Comment field + dated Comment History panel. communications-capability.ttl already models a generic comm:CommentAggregate ('text annotation on a process item... with visibility control') with a real API (comm:Op_CreateComment/Op_ListComments/Op_UpdateComment/Op_DeleteComment) — but its own invariant explicitly scopes it to 'CredentialApplication, StaffingRecord, EPPEnrollment' only, NOT any proflearning process item. satisfiedBy deliberately left unasserted: the mechanism exists and is the natural extension point, but as documented it does not yet cover this FDD's SponsorApplication (which itself doesn't exist — this section's header note) or ProgramApplication (see plrn:Req_28_4_2, same gap on the Program side)." ;
	<urn:solutiondesign:ontology:requirementId> "28.1.5" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to be able to add comments and view comment history on an application so that I have a record of communication and review notes." ;
	<urn:solutiondesign:ontology:title> "Add comments and view comment history on a Sponsor application" .

<urn:solutiondesign:instance:proflearning:Req_28_2> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Not a user story — the Addendum states this feature's own removal in prose, with no numbered sub-stories or acceptance criteria to model individually. Consistent with plrn:Op_SearchCatalog's real, modeled 'catalog' actually being the PUBLIC catalog search surface (31.5 Public Search), a distinct capability from whatever admin-side 'publishing' workflow this dropped feature would have added on top of it." ;
	<urn:solutiondesign:ontology:requirementId> "28.2" ;
	<urn:solutiondesign:ontology:statement> "It has been determined that this feature is no longer considered necessary. Business Specification #26 Professional Learning - Sponsor, contains feature 26.4: Professional Learning Catalog which is considered no longer necessary. Based on this, the ability to publish that particular feature is not feasible." ;
	<urn:solutiondesign:ontology:title> "Publishing the Professional Learning Catalog" .

<urn:solutiondesign:instance:proflearning:Req_28_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Administrator is able to view, parse and extract documents uploaded within the Program application. The summary view of the Program application includes the Program Agenda Details as an attached document." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Real match, unlike Feature 28.1's Sponsor-side stories: plrn:ProgramApplication is a real, modeled entity and plrn:ProgramAgenda ('Document reference from the documents domain') is a real ValueObject on plrn:ProfessionalLearningProgramAggregate — and plrn:Seq_AdminApprovesProgramApplication's own mermaid content already shows the admin's UI calling DocumentsAPI to 'Fetch program agenda' (resolved, if ambiguously, to docs:Op_RequestDocumentUpload in proflearning-sequences.ttl; docs:Op_DownloadDocument is the more precise real-download counterpart added here). Partial gap: 'parse' still has no counterpart anywhere in documents-api.ttl — same specific gap already noted on plrn:Req_28_1_2 — no domain converted so far models document content extraction/OCR." ;
	<urn:solutiondesign:ontology:requirementId> "28.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_DownloadDocument> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetProgramApplication> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProgramAgenda> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AdminApprovesProgramApplication> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need the ability to view, parse and extract documents uploaded as part of the Program application so that I can review the Program Agenda Details." ;
	<urn:solutiondesign:ontology:title> "View, parse, and extract documents uploaded within the Program application" .

<urn:solutiondesign:instance:proflearning:Req_28_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Administrator can click on the Program name hyperlink from the approved Programs Search Results table. The system displays the summary of the associated Program. The Administrator is able to view and edit each section of the Program summary." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "View half is a clean match (plrn:Op_GetProgram). Edit half is a PARTIAL, already-documented gap: plrn:Rule_ModifiedProgramsRequireReapproval's own text explicitly distinguishes sponsor-initiated edits (which route through re-approval, via plrn:Op_SubmitProgramApplication) from 'Professional Learning Admin edits apply directly without re-triggering approval' — exactly what this story describes — but proflearning-permissions.ttl's plrn:Perm_ProgramEdit notes already flag that no API operation is gated by proflearning.program.edit at all; a direct-edit-by-admin endpoint is described in two places (this business rule and this story) but implemented in neither. Comment 8/6/7 (Ross/Chaturvedi, on the parallel Sponsor-application-editability thread) confirm Program applications were NEVER proposed to have a restricted-edit reading the way Sponsor applications briefly were — 'Program Applications should allow for Admin to edit all sections... Needs to edit all fields' — consistent with the visible text, no correction needed." ;
	<urn:solutiondesign:ontology:requirementId> "28.4.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetProgram> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_ModifiedProgramsRequireReapproval> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to be able to view and edit each section of an approved Program's summary so that I can ensure the catalog information is accurate." ;
	<urn:solutiondesign:ontology:title> "View and edit each section of an approved Program's summary" .

<urn:solutiondesign:instance:proflearning:Req_28_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The application review interface provides a specific input mechanism for the administrator to enter text-based comments regarding the application under review. The system saves entered comments to the specific Program application record. A dedicated \"Remarks History\" tab is visible and accessible within the application review screen. The \"Remarks History\" tab displays a cumulative list of all comments previously added to the application. The history log presents comments in chronological order to reflect the timeline of the review process. Each entry in the \"Remarks History\" tab includes the content of the comment, the name of the user who created the note, and the timestamp (date and time) of the entry. The system allows the administrator to view the comment history without requiring them to add a new comment." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Same gap as plrn:Req_28_1_5, on the Program side: communications-capability.ttl's comm:CommentAggregate is a real, generically-shaped Comment mechanism (author/timestamp/chronological history already exactly match this story's AC) but its own invariant explicitly scopes it to CredentialApplication/StaffingRecord/EPPEnrollment only — ProgramApplication is not a covered process-item type. satisfiedBy deliberately left unasserted for the same reason as Req_28_1_5: the extension point exists, the coverage doesn't yet." ;
	<urn:solutiondesign:ontology:requirementId> "28.4.2" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I want to add internal comments to Program applications and view the historical log of these remarks so that I can document decision-making logic and maintain a clear audit trail of the review process." ;
	<urn:solutiondesign:ontology:title> "Add internal comments to Program applications and view remarks history" .

<urn:solutiondesign:instance:proflearning:Req_28_4_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Audit details will be stored upon successful editing of the Program summary." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "NUMBERING COLLISION: the Addendum uses '28.4.3' twice — this story, and a second, unrelated one immediately following it (modeled as plrn:Req_28_4_3b) — same pattern the FDD 29 pass already documented for its own 29.4.3/29.4.4 collision. Preserved literally, not renumbered. No audit/change-tracking concept exists on plrn:ProfessionalLearningProgramAggregate or plrn:ProgramApplication anywhere in proflearning-domain.ttl — the only AuditTrail ValueObject modeled in this domain belongs to plrn:SCECHCorrectionRequestAggregate, a different aggregate entirely. Comment 9 (Ross) — 'Noting that in the interest of Standardization, Audit Log is used' — confirms 'Audit Log' (not the Business Specifications prose's stale 'Activity log', see Wireframe 6's own caption) is the term of record, consistent with 28.4.3b/28.5.7's wording." ;
	<urn:solutiondesign:ontology:requirementId> "28.4.3" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need the system to store audit details when I edit a Program application so that changes are tracked chronologically." ;
	<urn:solutiondesign:ontology:title> "Store audit details when editing a Program application" .

<urn:solutiondesign:instance:proflearning:Req_28_4_3b> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Administrator can review the Audit log of the Program. The Audit Log includes the following information: Date/time, User, Action, Description." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Same coverage-gap as plrn:Req_28_4_3 (no Program/ProgramApplication-level audit-trail concept modeled) and the same content as plrn:Req_28_5_7 below (Feature 28.5's Worklist section independently re-describes the identical Audit Log capability) — see the shared coverage-gap Annotation covering all three." ;
	<urn:solutiondesign:ontology:requirementId> "28.4.3" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to review the Audit Log of a Program to see a record of all user actions (Date/time, User, Action, Description) so that I can audit the history of modifications and track specific changes made by users during the application review process." ;
	<urn:solutiondesign:ontology:title> "Review the Audit Log of a Program" .

<urn:solutiondesign:instance:proflearning:Req_28_4_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Professional Learning Administrator is able to add or edit program event dates and locations within the Program Begin and End Date. The system requires the following information for event dates and locations: Start date, End date, Start time, End time, County, Location name, Address - City, State and Zip. Note: Address details (City, State and Zip) are not collected for Virtual/Online events." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Field shape matches cleanly: plrn:SessionLocation's own fields ('County, LocationName, Address or Virtual indicator') already capture exactly this AC's field list, including the Virtual/Online address exception. GAP: no distinct session-creation/session-edit API operation exists — proflearning-permissions.ttl's plrn:Perm_SessionCreate and plrn:Perm_SessionEdit both already document this (sessions are created only inline as part of plrn:Op_SubmitProgramApplication's ProgramDetails.sessions[], with no standalone endpoint for an admin to add/edit a session directly against an already-approved Program, which is what this story actually describes). satisfiedBy names the domain-model shape that's correctly modeled; the missing operation is the gap." ;
	<urn:solutiondesign:ontology:requirementId> "28.4.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:ProgramSession> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:SessionLocation> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need the ability to add/edit program event dates and locations and specify required information like County and Start/End times so that I can accurately define event offerings and ensure the system can generate the necessary attendance lists for each specific session." ;
	<urn:solutiondesign:ontology:title> "Add/edit program event dates and locations" .

<urn:solutiondesign:instance:proflearning:Req_28_4_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The interface allows the administrator to select attendees from the attendance list to modify their credit status. The system provides options to approve, edit, or reject credits for the selected attendees. Credit entry fields are categorized into General, College, Career, and Military types. The system restricts the assignment of College, Career, and Military credits to the School Counselor role. The system automatically validates manually awarded credits against the Program's maximum allowable credits for each category. The system prohibits awarding credits that exceed the program's defined maximums. The system records attendance in both full and partial increments based on the event date. An audit log captures details whenever credits are added or updated for an attendee." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match on the substance: School-Counselor-only College/Career/Military restriction (plrn:Rule_CounselorScechTypesRestricted), max-credit validation (plrn:SCECHAllocation), and Full/Partial attendance increments (plrn:AttendanceRecord) are all real, already-modeled concepts, and plrn:Op_AdjustScechAward + plrn:Seq_AdjustScechAwardsAndCertify carry out the adjustment end-to-end. Two minor gaps: (1) terminology — the modeled operation is 'adjust', a single action; this story's 'approve, edit, or reject' as three DISTINCT actions doesn't map one-to-one (an adjustment that reduces credits to zero is the closest analogue to 'reject', but there's no separate reject action or status); (2) the per-adjustment audit-log requirement ('An audit log captures details whenever credits are added or updated') has no modeled counterpart — same class of gap as plrn:Req_28_4_3's Program-level Audit Log, but not folded into that same Annotation since this is attendee/attendance-scoped rather than Program-scoped." ;
	<urn:solutiondesign:ontology:requirementId> "28.4.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:AttendanceRecord> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_AdjustScechAward> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_CounselorScechTypesRestricted> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AdjustScechAwardsAndCertify> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to approve, edit, or reject the credits awarded to specific attendees so that I can ensure the correct number and type of professional learning hours (SCECHs) are recorded for their certification." ;
	<urn:solutiondesign:ontology:title> "Approve, edit, or reject credits awarded to attendees" .

<urn:solutiondesign:instance:proflearning:Req_28_4_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The interface allows the administrator to select specific attendees from the Attendance List. The system displays the responses submitted by the selected attendee." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "SIGNIFICANT, already-known gap, now independently confirmed by a second FDD: proflearning-permissions.ttl's plrn:Perm_EvaluationView already documents 'proflearning-api.yml has no endpoint for listing/viewing submitted EvaluationSubmission records at all', and plrn:Perm_EvaluationSubmit documents the matching submission-side gap. This story is the review-side confirmation of the exact same missing capability. UNRESOLVED CROSS-FDD SCOPE QUESTION, not just a technical gap: comment 18 (Groom, 2026-02-02) on this exact passage says 'Admin ability to manage/maintain the evaluations should be included in 14, this may belong with that admin functionality. Need to discuss' — i.e. even the FDD's own reviewers were unsure whether evaluation review belongs in FDD 28 (Processing) or FDD 14 (Professional Learning Admin) at all, and left it an open discussion rather than resolving it. See Question_EvaluationReviewFddOwnershipUnresolved." ;
	<urn:solutiondesign:ontology:requirementId> "28.4.6" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to review the evaluations submitted by attendees so that I can assess the quality of the program and ensure feedback is linked to the correct participant." ;
	<urn:solutiondesign:ontology:title> "Review evaluations submitted by attendees" .

<urn:solutiondesign:instance:proflearning:Req_28_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides a worklist for the Professional Learning Administrator to review pending Program applications." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match — plrn:Op_ListProgramApplications's own notes already describe serving as 'the admin's pending-review list via ?status=PendingApproval', exactly this story, and plrn:Seq_AdminApprovesProgramApplication's sequence content opens with exactly that call." ;
	<urn:solutiondesign:ontology:requirementId> "28.5.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListProgramApplications> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AdminApprovesProgramApplication> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to view the pending Program applications in a worklist so that I can manage the queue for program review." ;
	<urn:solutiondesign:ontology:title> "View pending Program applications in a worklist" .

<urn:solutiondesign:instance:proflearning:Req_28_5_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Program applications worklist provides a basic search field. The Program Application Worklist Search Results table displays the following columns: Program name (as a hyperlink to open the program), Program #, Application #, Start Date, Submit Date, Status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "The list operation itself exists and is the right target, but proflearning-api.ttl doesn't document sd:parameters for plrn:Op_ListProgramApplications the way documents-api.ttl does for its own search endpoints — the specific named filters (Program name/number, Application number) aren't confirmed as real query parameters on this operation, only that the operation and its result columns exist. Minor documentation gap, not a structural one." ;
	<urn:solutiondesign:ontology:requirementId> "28.5.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListProgramApplications> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need to filter the Program applications worklist by Program name, Program number, and Program Application number so that I can efficiently locate specific applications or groups of applications for processing." ;
	<urn:solutiondesign:ontology:title> "Filter the Program applications worklist" .

<urn:solutiondesign:instance:proflearning:Req_28_5_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Program applications worklist page provides a \"Clear\" option to restore search defaults. The \"Clear\" option removes all entered search criteria on the Program applications worklist page." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Pure client-side UI behavior (restoring a form to its default, unfiltered state) rather than a distinct server-side concern — satisfied by the same list operation returning its default, unfiltered result set; this level of design doesn't model client-side form state as its own node, consistent with how other domains' equivalent 'Clear'/'Reset' stories have been treated." ;
	<urn:solutiondesign:ontology:requirementId> "28.5.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListProgramApplications> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need a Reset option on the search pages so that I can easily reset search criteria." ;
	<urn:solutiondesign:ontology:title> "Reset option on search pages" .

<urn:solutiondesign:instance:proflearning:Req_28_5_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system displays a 'No results found' message when search criteria for Sponsor applications yield no matching records. The system displays a 'No results found' message when search criteria for Program applications yield no matching records. The 'No results found' message disappears when the user enters search criteria that successfully displays results." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Same client-side-rendering treatment as plrn:Req_28_5_5 — an empty-result-set UI affordance on top of the same list operation, not a distinct backend capability. Note this AC explicitly covers BOTH Program and Sponsor application searches, but only the Program-application list operation is real (plrn:Op_ListProgramApplications) — the Sponsor-application half has no backing operation at all, per Feature 28.1's header note; satisfiedBy still asserted here since the story is fundamentally a UI-rendering concern, with the missing Sponsor-application search itself already captured as its own gap (plrn:Req_28_BizSpec_SponsorWorklistSearch)." ;
	<urn:solutiondesign:ontology:requirementId> "28.5.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListProgramApplications> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I need the system to display a \"No results found\" message when my search yields no results so that I am clearly informed that no records matched my criteria and know to adjust my filter inputs." ;
	<urn:solutiondesign:ontology:title> "\"No results found\" message on empty search" .

<urn:solutiondesign:instance:proflearning:Req_28_5_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Audit Log displays a chronological list of actions taken on the application. Each entry includes the Date and Time the action occurred. Each entry identifies the specific User who performed the action. The log details the specific Action taken (such as an edit or status change). A Description field is provided for each entry to explain the nature of the activity. The system automatically stores audit details in this log whenever a section of the program application is successfully edited." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Word-for-word restatement of plrn:Req_28_4_3/28.4.3b's Audit Log capability — see that shared coverage-gap Annotation (oa:hasTarget already includes this Requirement)." ;
	<urn:solutiondesign:ontology:requirementId> "28.5.7" ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I want to review the Audit Log within a specific Professional Learning Program application so that I can audit the history of actions taken, including edits and status changes, by specific users." ;
	<urn:solutiondesign:ontology:title> "Review the Audit Log within a Program application" .

<urn:solutiondesign:instance:proflearning:Req_28_5_8> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The table includes columns for the attendee's First Name, Last Name, and Unique ID. A \"Confirmed\" column is visible in the table to indicate attendance status. The interface handles scenarios where no results are found by displaying an appropriate message that clears once valid criteria are entered." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Clean match — plrn:Op_GetSessionRoster's own AttendeeRecord projection already carries educatorUniqueId/Name and evaluationSubmitted/attendance-status fields matching this AC's column list. The Business Specifications prose's fuller version of this same capability (Wireframe 10-12) additionally describes search filters (Last name/First name/Email/Unique ID) not mentioned in this Addendum story's own AC and not documented as sd:parameters on plrn:Op_GetSessionRoster — same minor documentation-gap pattern as plrn:Req_28_5_4, not modeled as a separate Requirement given how minor it is relative to the rest of this story." ;
	<urn:solutiondesign:ontology:requirementId> "28.5.8" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSessionRoster> ;
	<urn:solutiondesign:ontology:statement> "As a Professional Learning Administrator, I want to view the attendance records for a specific program event so that I can verify learner participation and manage attendee details." ;
	<urn:solutiondesign:ontology:title> "View attendance records for a program event" .

<urn:solutiondesign:instance:proflearning:Req_28_BizSpec_ApprovedProgramsListAndWithdraw> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Search by Program name, Program approval #, Offering end date range, Sponsor name; Clear option; results table (Program name hyperlink, Sponsor ID, Program approval #, Application #, Start Date, Submit date, Status); clicking the Program name opens view/edit of each section, with audit details stored on edit; a delete-or-withdraw action on the Program." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match overall — the approved-Programs list/search/withdraw trio is fully modeled (plrn:Op_ListPrograms, plrn:Op_GetProgram, plrn:Op_WithdrawProgram/plrn:Perm_ProgramWithdraw). Same edit-endpoint and audit-on-edit gaps already noted on plrn:Req_28_4_1 and the Req_28_4_3/28.4.3b/28.5.7 Audit Log Annotation apply here too — not re-raised as separate Annotations since they're the identical, already-flagged gaps applied to the same underlying Program entity via a different worklist screen." ;
	<urn:solutiondesign:ontology:requirementId> "28-BizSpec-ApprovedProgramsListAndWithdraw" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetProgram> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListPrograms> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_WithdrawProgram> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, I can view the list of all approved Programs, search/filter them, edit each section, and delete or withdraw a Program, so that I can maintain the program catalog." ;
	<urn:solutiondesign:ontology:title> "View, search, edit, and withdraw approved Programs" .

<urn:solutiondesign:instance:proflearning:Req_28_BizSpec_EvaluationTemplateMaintenance> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Admin can create/edit evaluation templates referencing question sets, assignable to program categories or individual programs (per the Business Specifications prose and Wireframe 10's Attendance-list-Evaluation screen)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Fully satisfied, unlike the closely-related but distinct plrn:Req_28_4_6 (reviewing SUBMITTED evaluation responses, which has no modeled counterpart at all) — this story is specifically about maintaining the evaluation TEMPLATE/question set, which proflearning-sequences.ttl already models end-to-end via plrn:Seq_AdminConfiguresEvaluationQuestions. Worth noting precisely because the two are easy to conflate: template maintenance = satisfied; reviewing submitted responses = significant gap." ;
	<urn:solutiondesign:ontology:requirementId> "28-BizSpec-EvaluationTemplateMaintenance" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_CreateEvaluationTemplate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListEvaluationTemplates> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AdminConfiguresEvaluationQuestions> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, I will maintain the evaluation questions for Programs, so that program feedback can be systematically collected." ;
	<urn:solutiondesign:ontology:title> "Maintain evaluation questions for Programs" .

<urn:solutiondesign:instance:proflearning:Req_28_BizSpec_MassEmailSponsors> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Compose an email with optional attachments; select specific Sponsors or All Sponsors as recipients; send (matches Wireframe 14: Email sponsors, and Wireframe 1's 'Email Sponsors' tab)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "CONFIRMS an already-open finding from proflearning-domain.ttl's own conversion: plrn:Question_MissingSponsorSequences (Open Question #10) already noted that plrn:ProfessionalLearningSponsorAggregate's own 'Referenced In' list cites a 'Sequence: Mass Email to Sponsors' that doesn't exist anywhere in proflearning-sequences.ttl, and specifically named this FDD ('FDD 28 (Processing) confirms mass-emailing sponsors is a real, described capability... Wireframe 14') as the evidence for it — this review is that confirmation, now made concrete with the actual FDD text and wireframe reference. Distinct from plrn:Req_28_1_4 (emailing ONE sponsor from an application review page, which IS satisfied by comm:Op_SendManualEmail): comm:Op_SendManualEmail's request shape is a single recipientEmail, with no bulk-recipient list and no attachment support — genuinely does not cover 'selected or All Sponsors' + attachments. A real gap on the Communications side (or a net-new bulk-send capability), not merely a missing proflearning-side sequence diagram for an operation that already exists elsewhere." ;
	<urn:solutiondesign:ontology:requirementId> "28-BizSpec-MassEmailSponsors" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, I will compose and send mass emails (with attachments) to selected or All Sponsors, so that I can communicate program updates or requirements broadly." ;
	<urn:solutiondesign:ontology:title> "Compose and send mass emails to selected or all Sponsors" .

<urn:solutiondesign:instance:proflearning:Req_28_BizSpec_ProgramCategoryMaintenance> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add/View/Edit/Active-Inactive actions on Program Categories, on an admin screen (matches Wireframe 1's 'Category/Program description' tab)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Fully satisfied — plrn:Seq_AdminManagesProgramCategories and its backing operations already model create/list/deactivate for both categories and subcategories, matching this story's Add/View/Edit/Active-Inactive shape closely (no distinct 'Edit category name/description' story is separately called out in the Business Specifications text, but plrn:Op_UpdateProgramCategory covers it regardless)." ;
	<urn:solutiondesign:ontology:requirementId> "28-BizSpec-ProgramCategoryMaintenance" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_CreateProgramCategory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_DeactivateProgramCategory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_ListProgramCategories> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Seq_AdminManagesProgramCategories> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, I will maintain Professional Learning Program Categories on an Admin screen (Add, View, Edit, Active/Inactive), so that programs can be consistently classified." ;
	<urn:solutiondesign:ontology:title> "Maintain Professional Learning Program Categories" .

<urn:solutiondesign:instance:proflearning:Req_28_BizSpec_ProgramDescriptionsAdmin> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add/View/Edit/Active-Inactive actions on Program Descriptions, on an admin screen (matches Wireframe 1's 'Category/Program description' tab, the same tab named for Program Categories above)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE, PREVIOUSLY-UNFLAGGED coverage gap, distinct from Program Category maintenance (which IS fully modeled — see plrn:Req_28_BizSpec_ProgramCategoryMaintenance immediately above). 'Program Descriptions' as described here — a maintained, reusable ADMIN-CURATED library of description text/templates with its own Add/View/Edit/Active-Inactive lifecycle, presented on the very same tab as Program Categories in Wireframe 1 ('Category/Program description') — is a different concept from plrn:ProfessionalLearningProgramAggregate's own free-text 'description' field on an individual Program (which a sponsor or admin types directly on that one Program, with no separate reusable-library concept behind it). No ProgramDescription aggregate/entity/API exists anywhere in proflearning-domain.ttl or proflearning-api.ttl. Worth flagging precisely because it's easy to mistake for 'already covered by Program.description' when it is not." ;
	<urn:solutiondesign:ontology:requirementId> "28-BizSpec-ProgramDescriptionsAdmin" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, I will maintain Professional Learning Program Descriptions on an Admin screen (Add, View, Edit, Active/Inactive), so that programs can reference a consistent, reusable set of description text." ;
	<urn:solutiondesign:ontology:title> "Maintain Professional Learning Program Descriptions" .

<urn:solutiondesign:instance:proflearning:Req_28_BizSpec_SponsorListViewEditDelete> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Search by Sponsor name, Sponsor ID, Include Inactive toggle; Clear option; results table (Sponsor name hyperlink, Sponsor ID, Contact name, Sponsor email, Active); clicking the Sponsor name opens a view/edit screen for Sponsor name/ID/Address/City/State/Zip/Contact/Phone/Email/URL/Active-inactive switch; delete option for both a pending Sponsor application and an approved Sponsor." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 7 (plrn:Wireframe7Doc). PARTIAL: view is a real, clean match (plrn:Op_GetSponsor). Edit and delete are both already-documented gaps on the Permission side — plrn:Perm_SponsorEdit's own notes say 'No distinct update-sponsor API operation exists... an honest gap', and plrn:Perm_SponsorDelete's own notes say the same for deletion, further noting the aggregate's own Design Note that sponsor lifecycle belongs to EEM, not MiEdWorkforce. This FDD independently confirms both stated capabilities (edit AND delete an approved Sponsor, not just a pending application) are real, expected, and wireframed — strengthening, not just repeating, those two existing Permission-level gap notes." ;
	<urn:solutiondesign:ontology:requirementId> "28-BizSpec-SponsorListViewEditDelete" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSponsor> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, I can view the list of all Sponsors, search by name/ID/active status, and edit or delete a Sponsor's information, so that I can maintain accurate sponsor records." ;
	<urn:solutiondesign:ontology:title> "View, search, edit, and delete Sponsors from the Sponsor List" .

<urn:solutiondesign:instance:proflearning:Req_28_BizSpec_SponsorWorklistSearch> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Filter by Type (Sponsor, coordinator, assistant coordination), District or sponsor, District/Sponsor name, Application number, Status (New, pending, approved, comment, documentation). A Clear option restores search defaults. Search Results table columns: Type, Date of application, Application number, District or sponsor, District/Sponsor name, Name (Last, First), Last update date, Status. 'No results found' message shown/hidden per search outcome." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed by Wireframe 1 (plrn:Wireframe1Doc). Never promoted to an Addendum number — by analogy with 28.5.3/28.5.4 (the Program-worklist equivalents), this would naturally be 28.5.1/28.5.2, but the Addendum's Worklist feature starts numbering at 28.5.3 and never defines a Sponsor-worklist story at all, the same 'described and wireframed in Business Specs, never promoted to the Addendum's own numbering' pattern the FDD 29 pass found for three of its own features. Same structural gap as the rest of Feature 28.1 (this file's header note on that section): no SponsorApplication entity exists to search over, so satisfiedBy is left unasserted despite the search/filter/results UI itself being fully wireframed." ;
	<urn:solutiondesign:ontology:requirementId> "28-BizSpec-SponsorWorklistSearch" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce user with the Professional Learning Administrator role, I can view the pending Professional Learning Sponsor/Vendor Applications in a table format with filter options, so that I can locate and process specific applications." ;
	<urn:solutiondesign:ontology:title> "View, search, and filter the Sponsor/Vendor Applications worklist" .

<urn:solutiondesign:instance:proflearning:Req_31_5_10> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Results grid supports standard sorting, filtering, and pagination; dynamically filtered, real-time data." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — plrn:Op_SearchCatalog's own sd:responseSchema explicitly includes a 'pagination' field alongside the results array." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.10" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SearchCatalog> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the Professional Learning results to be displayed in a sortable, filterable, and paginated grid." ;
	<urn:solutiondesign:ontology:title> "Sortable, filterable, paginated results grid" .

<urn:solutiondesign:instance:proflearning:Req_31_5_11> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Grid named 'Search Results' with columns Program Name (hyperlink), Sponsor Name (hyperlink), County, Category, Program Format, Max SCECH Hours, Begin Date, End Date; dynamically filtered, real-time; standard sort/filter/pagination." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, field-for-field match — plrn:Op_SearchCatalog's sd:responseSchema literally lists 'title, sponsorName, format, category, maxScechHours, ..., beginDate, endDate, county' on its composite CatalogSearchResult shape." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.11" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SearchCatalog> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the Professional Learning Search results grid to display Program Name, Sponsor Name, County, Category, Program Format, Max SCECH Hours, Begin Date, and End Date, so I can quickly assess the key details of available sponsors and programs." ;
	<urn:solutiondesign:ontology:title> "Results grid columns: Program, Sponsor, County, Category, Format, Max SCECH Hours, Begin/End Date" .

<urn:solutiondesign:instance:proflearning:Req_31_5_12> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking Program Name shows Program Name, Sponsor Name (hyperlink), Sponsor Contact, Category, Program Location, Program Facilitator (hyperlinked email, multiple independently selectable), Participant Fee, Program Description, Prerequisites/Restrictions, Technical Specifications, Program Website, Number of Maximum SCECHs, Offering Dates, County." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Real coverage gap: plrn:Op_GetProgram is the right operation to target, but plrn:ProfessionalLearningProgramAggregate's actual value objects (plrn:ProgramContact: name/phone/email; plrn:SCECHAllocation; plrn:ApprovalPeriod; plrn:SessionLocation; plrn:ProgramFormatVO; plrn:ProgramCategoryVO; plrn:EndorsementAlignment; plrn:EvaluationRequirement) have NO field for Program Description, Prerequisites/Restrictions, Technical Specifications, Program Website, or Participant Fee, and no distinct 'Facilitator' concept (only a single generic Contact with one name/phone/email, not the FDD's 'if multiple facilitators are listed, each is independently selectable'). This is a substantially richer public-detail-page field set than the domain model captures today — a genuine, previously-undetected gap surfaced by reading the actual FDD and viewing plrn:Wireframe31_5_4 directly, not visible from the already-distilled domain doc alone." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.12" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetProgram> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the Program Name hyperlink in the search grid to display additional details such as Program Facilitator (with hyperlinked email) and Program Website." ;
	<urn:solutiondesign:ontology:title> "Program detail: Facilitator, Fee, Description, Prerequisites, Tech Specs, Website" .

<urn:solutiondesign:instance:proflearning:Req_31_5_13> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking Sponsor Name shows Sponsor ID, Mailing Address, Contact Name, Phone (hyperlink, multiple independently selectable), Email (hyperlink, multiple independently selectable), and a list of that sponsor's Active Programs (Program Name, Description, Category, Begin/End Date)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Real coverage gap, already anticipated: plrn:Op_GetSponsor's own sd:notes reference the sponsor-detail pattern, but plrn:ProfessionalLearningSponsorAggregate's SponsorContact value object only has name/phone/email (singular, not independently-selectable multiples) and has no Sponsor ID (human-readable, distinct from the internal UUID) or Mailing Address field at all. See the coverage-gap Annotation above (shared with 31.5.7), which corroborates the pre-existing plrn:Question_SponsorAddressAndHumanReadableId." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.13" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_GetSponsor> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the Sponsor Name hyperlink in the search grid to display Sponsor ID, Mailing Address, and hyperlinked contact phone and email information." ;
	<urn:solutiondesign:ontology:title> "Sponsor detail: Sponsor ID, mailing address, hyperlinked phone/email" .

<urn:solutiondesign:instance:proflearning:Req_31_5_1> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Landing page displays hyperlink 'Professional Learning Opportunities' below the banner; no login required; navigates to the Michigan Professional Learning Resources Search Landing Page." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "The 'no login' half is confirmed by plrn:Op_SearchCatalog's sd:requiresAuth false (the one operation in proflearning-api.ttl asserted unconditionally unauthenticated). The landing-page-hyperlink placement itself is shared public-portal chrome — cred:WireframeLandingPageThreeSearches (viewed directly) shows a tile literally labeled 'Professional Learning Opportunities,' matching this story's wording exactly, alongside the credentialing and Pro Prep search tiles. See out-of-scope Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.1" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want a Professional Learning Opportunities Search hyperlink available on the MiEdWorkforce landing page, found below the MiEdWorkforce banner, so that I can access the search without logging in." ;
	<urn:solutiondesign:ontology:title> "Professional Learning Opportunities Search hyperlink on landing page, no login" .

<urn:solutiondesign:instance:proflearning:Req_31_5_2> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Search executes for SCECH Sponsors AND/OR Programs with 'Active' status only; non-Active (inactive/pending) sponsors or programs excluded." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial match / discrepancy: plrn:Rule_OnlyActiveProgramsInCatalog's statement is 'The public catalog search only returns programs with status Active and sessions within their approval period' — it says nothing about SPONSOR status. This FDD explicitly requires filtering catalog results by Sponsor status too ('SCECH Sponsors... that have an Active status'), and plrn:ProfessionalLearningSponsorAggregate does have an Active/Inactive state (plrn:SponsorState_Active/plrn:SponsorState_Inactive) that could back this — but the rule and plrn:Op_SearchCatalog's own documentation only describe filtering the Program side. See discrepancy Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Rule_OnlyActiveProgramsInCatalog> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the basic search to only return SCECH Sponsors and Programs that have an 'Active' status." ;
	<urn:solutiondesign:ontology:title> "Basic search returns only 'Active' status Sponsors and Programs" .

<urn:solutiondesign:instance:proflearning:Req_31_5_3> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System ignores special characters entered in the search field; still returns matches for text including special characters (e.g. D'Angelo returning DAngelo)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial satisfaction: plrn:Op_SearchCatalog is the right target operation, but (unlike credentialing's cred:Rule_PublicEducatorCredentialSearch) proflearning has no separate BusinessRule spelling out the exact matching algorithm (partial-match, whitespace/special-char handling) — it's implied by the operation existing, not independently documented." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SearchCatalog> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the system to ignore special characters during a basic search so that minor differences in input do not prevent a match." ;
	<urn:solutiondesign:ontology:title> "Ignore special characters during basic search" .

<urn:solutiondesign:instance:proflearning:Req_31_5_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Returns full and partial matches for text/numeric criteria; strips leading/trailing spaces; retains embedded spaces." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Same partial-satisfaction note as 31.5.3 — right operation, matching-algorithm details not independently documented as a rule." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SearchCatalog> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, the system must search the MiEdWorkforce database for matching SCECH Sponsor(s) or Program(s) and return full and partial matches." ;
	<urn:solutiondesign:ontology:title> "Full/partial match, strip leading/trailing (not embedded) spaces" .

<urn:solutiondesign:instance:proflearning:Req_31_5_5> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Displays 'No results found' on a no-match search; disappears on Reset or on a corrected search that returns results." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: client-side validation-message behavior. Folded into the out-of-scope UI-chrome Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.5" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want to see an error message ('No results found') when my search criteria yields no results." ;
	<urn:solutiondesign:ontology:title> "'No results found' validation message" .

<urn:solutiondesign:instance:proflearning:Req_31_5_6> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Message disappears automatically on corrected search with results, or on Reset (returns to default search state)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: same client-side chrome as 31.5.5. Folded into the out-of-scope UI-chrome Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.6" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the \"No results found\" message to disappear when I correct my search criteria or click Reset, so that the message does not persist once I initiate a new search." ;
	<urn:solutiondesign:ontology:title> "'No results found' message clears on corrected search or Reset" .

<urn:solutiondesign:instance:proflearning:Req_31_5_7> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Advanced Search expands to show all listed filters; City/Category/Program Formats/County allow multiple selections; Sponsor ID uses 'standard matching logic' on a free-form alpha+6-digit-number field." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial match: plrn:Op_SearchCatalog's own sd:notes already say 'City/zip/county/human-readable Sponsor ID filters described in FDD 31.5 are not yet implemented here — see plrn:Question_SponsorAddressAndHumanReadableId.' This story is direct, independent confirmation that gap is real and FDD-31.5-sourced exactly as that question already assumed. See coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:proflearning:Op_SearchCatalog> ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the Advanced Search to include filters for Sponsor Name, Sponsor ID, Program Name, City, Zip Code, County, Category, Program Formats, Number of Awarded SCECHs, and Offering Date Range (From date and To date) so I can narrow down potential results." ;
	<urn:solutiondesign:ontology:title> "Advanced Search filters: Sponsor Name/ID, Program Name, City, Zip, County, Category, Program Formats, #SCECHs, Date Range" .

<urn:solutiondesign:instance:proflearning:Req_31_5_8> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Reset clears main and Advanced Search fields; restores Sponsor ID field to 'Start typing...'; collapses Advanced Search." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: client-side form-state behavior. Folded into the out-of-scope UI-chrome Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.8" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want a Reset button that clears all search inputs (basic and advanced), restores default filter values, and collapses the Advanced Search options, so that I can quickly and easily start a new search for professional learning resources." ;
	<urn:solutiondesign:ontology:title> "Reset button clears all search state" .

<urn:solutiondesign:instance:proflearning:Req_31_5_9> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Icons next to Advanced Search field names, visible when expanded; hovering shows a tooltip with field-specific guidance." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: pure UI-chrome content, though notably a review comment (#5, Dontje) adds a real requirement beyond the acceptance criteria's own wording — 'The hover text will be editable by the MiEdWorkforce System Admin' — meaning this needs an admin-configurable content store, not just static tooltip copy. Neither the static tooltips nor the admin-editability is modeled anywhere in proflearning. Folded into the out-of-scope UI-chrome Annotation below given its overall small footprint, but the admin-editability detail is worth a second look if/when Professional Learning Admin (14.0) tooling is built out further." ;
	<urn:solutiondesign:ontology:requirementId> "31.5.9" ;
	<urn:solutiondesign:ontology:statement> "As a member of the public, I want the Advanced Search field names to display informational icons that reveal additional descriptive text when hovered over, so I can easily understand the purpose and required format for each search filter." ;
	<urn:solutiondesign:ontology:title> "Hover-icon tooltips on Advanced Search fields, admin-editable text" .

<urn:solutiondesign:instance:proflearning:RequestStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Submitted, UnderReview, Approved, Denied." ;
	<urn:solutiondesign:ontology:name> "RequestStatus" .

<urn:solutiondesign:instance:proflearning:RequestedChange> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:fields> "attendeeId, oldValue, newValue, justification" ;
	<urn:solutiondesign:ontology:name> "RequestedChange" .

<urn:solutiondesign:instance:proflearning:RosterState_AwaitingEvaluations> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "AwaitingEvaluations" .

<urn:solutiondesign:instance:proflearning:RosterState_Certified> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Certified" .

<urn:solutiondesign:instance:proflearning:RosterState_Draft> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Draft" .

<urn:solutiondesign:instance:proflearning:RosterState_ReadyForCertification> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "ReadyForCertification" .

<urn:solutiondesign:instance:proflearning:Rule_AttendeeValidUniqueId> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:example> "Sponsor tries to add 'John Smith' by name only; system requires selecting a matched Unique ID from search results." ;
	<urn:solutiondesign:ontology:rationale> "SCECH credits must be awarded to verified educator accounts for credentialing integration." ;
	<urn:solutiondesign:ontology:statement> "Only educators with a Unique ID (registered in IAM via MiLogin) can be added to program attendance rosters." .

<urn:solutiondesign:instance:proflearning:Rule_CertifiedAwardsImmutable> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> ;
	<urn:solutiondesign:ontology:example> "Sponsor certifies roster June 1; discovers an error June 5; must submit a correction request rather than editing directly." ;
	<urn:solutiondesign:ontology:rationale> "Maintains audit integrity and prevents retroactive manipulation of educator records without oversight." ;
	<urn:solutiondesign:ontology:statement> "After a sponsor certifies program attendance, awarded SCECH hours cannot be changed directly; changes require a formal SCECHCorrectionRequest approved by Professional Learning Admin." .

<urn:solutiondesign:instance:proflearning:Rule_CollegeCourseConversionRate> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:example> "3-credit graduate course converts to 45 SCECH hours (3 x 15)." ;
	<urn:solutiondesign:ontology:rationale> "Standardizes SCECH valuation for college coursework across all institutions and courses." ;
	<urn:solutiondesign:ontology:statement> "College course semester credits are converted to SCECH hours at a rate of 1 semester credit = 15 SCECH hours (configurable via business rules management)." .

<urn:solutiondesign:instance:proflearning:Rule_CollegeCourseNotReusable> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:rationale> "Prevents double-counting the same coursework." ;
	<urn:solutiondesign:ontology:statement> "Once an educator applies a college course toward SCECH requirements, that course is marked as used and cannot be selected again." .

<urn:solutiondesign:instance:proflearning:Rule_CollegeCoursePostDatesIssuance> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:CollegeCourseCreditAggregate> ;
	<urn:solutiondesign:ontology:example> "Certificate issued June 2023; a May 2023 course is ineligible, a September 2023 course is eligible." ;
	<urn:solutiondesign:ontology:rationale> "Prevents reusing coursework already counted toward a previous credential." ;
	<urn:solutiondesign:ontology:statement> "An educator can only apply college course credits toward SCECH if the course was completed after their most recent credential was issued." .

<urn:solutiondesign:instance:proflearning:Rule_CounselorScechTypesRestricted> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:example> "Program offers 5 General + 3 College SCECHs; non-counselors receive only 5 General, School Counselors receive 5+3=8 total." ;
	<urn:solutiondesign:ontology:notes> "Enforcement depends on a live credential-type check against Credentialing (GET /credentials/{educatorId}/type per proflearning-sequences.md), which credentialing-api.yml does not currently expose — see cred:CredentialTypeOperation's notes." ;
	<urn:solutiondesign:ontology:rationale> "These specialized SCECH types are tied to specific professional development requirements for school counselors." ;
	<urn:solutiondesign:ontology:statement> "SCECH types College, Career, and Military can only be awarded to educators holding a School Counselor credential; the system validates credential type before allowing these allocations." .

<urn:solutiondesign:instance:proflearning:Rule_DefaultScechEqualsMax> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:example> "Program approved for 10 SCECH hours; John Doe's awarded SCECHs default to 10, then adjusted to 5 for partial attendance before certifying." ;
	<urn:solutiondesign:ontology:rationale> "Most attendees complete the full program; adjustments handle partial attendance." ;
	<urn:solutiondesign:ontology:statement> "When an attendee is added to a program roster, awarded SCECH hours default to the program's maximum approved hours." .

<urn:solutiondesign:instance:proflearning:Rule_EvaluationRequirementProgramSpecific> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> ;
	<urn:solutiondesign:ontology:rationale> "Allows flexibility for different program types while collecting quality feedback where needed." ;
	<urn:solutiondesign:ontology:statement> "Programs have a configurable 'Evaluation Required' toggle. If ON, attendees must submit an evaluation before SCECH credits are awarded; if OFF, credits award immediately upon sponsor certification." .

<urn:solutiondesign:instance:proflearning:Rule_ModifiedProgramsRequireReapproval> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:example> "Sponsor changes max SCECH hours 10->15: status becomes PendingApproval, ProgramModified published, reappears in admin's pending-review list. An Admin correcting a typo edits directly with no status change." ;
	<urn:solutiondesign:ontology:rationale> "Ensures quality control over sponsor-initiated changes; an Admin, as the approval authority itself, needs no additional approval." ;
	<urn:solutiondesign:ontology:statement> "If a sponsor (Coordinator/Assistant Coordinator) edits details of an already-approved program, the updated application must route through the full approval workflow. Professional Learning Admin edits apply directly without re-triggering approval (audit still recorded)." .

<urn:solutiondesign:instance:proflearning:Rule_OnlyActiveProgramsInCatalog> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> ;
	<urn:solutiondesign:ontology:rationale> "Prevents confusion from inactive or expired programs; ensures the public sees only current offerings." ;
	<urn:solutiondesign:ontology:statement> "The public catalog search only returns programs with status Active and sessions within their approval period." .

<urn:solutiondesign:instance:proflearning:SCECHAllocation> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "College/Career/Military hours are restricted to School Counselor credential holders — see the 'School Counselor SCECH Types Restricted by Credential' business rule. Also reused (same shape, different semantic role) by the API's attendee-level ScechAllocation schema for actual awarded amounts — see plrn:Op_AdjustScechAward's sd:projection." ;
	<urn:solutiondesign:ontology:fields> "MaxGeneral, MaxCollege, MaxCareer, MaxMilitary" ;
	<urn:solutiondesign:ontology:name> "SCECHAllocation" .

<urn:solutiondesign:instance:proflearning:SCECHAward> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Awarded credits by type, justification for adjustments." ;
	<urn:solutiondesign:ontology:name> "SCECHAward" .

<urn:solutiondesign:instance:proflearning:SCECHAwardAdjustedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "attendeeId, oldAmount, newAmount, justification" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin approves correction request" .

<urn:solutiondesign:instance:proflearning:SCECHAwardsOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "CONFIRMED GAP (cross-domain consistency pass): proflearning is now really converted in abox/mied-v3/proflearning/proflearning-api.ttl, and it exposes no endpoint that returns an educator's SCECH award history/total by educator ID — only session-scoped operations (plrn:Op_CertifyAttendance, plrn:Op_AdjustScechAward, plrn:Op_GetSessionRoster) and self-service ones scoped to the calling educator (plrn:Op_GetEligibleCollegeCourses). staffing-domain.md's Dependencies table only says 'REST API or event subscription' for this, without naming a concrete endpoint or event, and the real converted surface confirms no matching endpoint exists. Note the parallel, unresolved discrepancy credentialing-domain.md documents for its own SCECH dependency on proflearning (a GET /scech-hours call with no matching endpoint) — this staffing dependency is phrased even more loosely and is left equally unresolved rather than guessing which mechanism actually applies." ;
	<urn:solutiondesign:ontology:path> "/scech-awards" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Returns SCECH (professional-development hour) awards for an educator, for New Teacher DPPD tracking." .

<urn:solutiondesign:instance:proflearning:SCECHConversion> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Course credits converted to SCECH hours using configured rate: 1 semester credit = 15 SCECH hours." ;
	<urn:solutiondesign:ontology:name> "SCECHConversion" .

<urn:solutiondesign:instance:proflearning:SCECHCorrectionApprovedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "correctionRequestId, approvedBy, newSCECHValue" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin approves correction" .

<urn:solutiondesign:instance:proflearning:SCECHCorrectionDeniedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "correctionRequestId, deniedBy, reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin denies correction" .

<urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Handles sponsor-initiated requests to adjust SCECH awards after attendance has been certified, requiring admin approval." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:SCECHCorrectionApprovedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:SCECHCorrectionDeniedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:proflearning:AdminDecision> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:CorrState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:CorrState_Denied> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:CorrState_Submitted> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:CorrState_UnderReview> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:AuditTrail> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:RequestStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:RequestedChange> ;
	<urn:solutiondesign:ontology:invariants> "Can only be created for certified attendance rosters. Requested SCECH value must not exceed program maximum. Requires documented justification from sponsor. Once approved, original award is superseded (not deleted - maintains audit trail). Denial requires admin notes explaining reason." ;
	<urn:solutiondesign:ontology:notes> "Modeled exclusively as sponsor/coordinator-initiated per the domain doc's own Ubiquitous Language and ERD (submitted_by_user_unique_id is documented as 'Coordinator who submitted'). FDD 27 describes a distinct educator-initiated correction/dispute pathway not covered by any permission here (proflearning.correction.submit is coordinator-scoped only) — an honest gap, not resolved by this conversion. See plrn:Question_EducatorInitiatedCorrectionPathway below." ;
	<urn:solutiondesign:ontology:rootEntity> "CorrectionRequest" .

<urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "correctionRequestId, sessionId, attendeeId, requestedChange" ;
	<urn:solutiondesign:ontology:publishedToTopic> "proflearning-events" ;
	<urn:solutiondesign:ontology:trigger> "Sponsor submits correction request" .

<urn:solutiondesign:instance:proflearning:STARRCourseRecord> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Course data from STARR sync." ;
	<urn:solutiondesign:ontology:name> "STARRCourseRecord" .

<urn:solutiondesign:instance:proflearning:Seq_AddAttendeesToProgram> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator\n    participant ProfLearningUI\n    participant ProfLearningAPI\n    participant IAM_API\n\n    Coordinator->>ProfLearningUI: Navigate to program session\n    ProfLearningUI->>IAM_API: Check permission (proflearning.attendance.add)\n    IAM_API-->>ProfLearningUI: Authorized\n\n    alt Online Entry\n        Coordinator->>ProfLearningUI: Search for educator by name/ID\n        ProfLearningUI->>ProfLearningAPI: GET /educators/search?query={name}\n        ProfLearningAPI->>IAM_API: Validate educators exist\n        IAM_API-->>ProfLearningAPI: Matching educators with Unique IDs\n        ProfLearningAPI-->>ProfLearningUI: Search results\n\n        Coordinator->>ProfLearningUI: Select educator, add to roster\n        ProfLearningUI->>ProfLearningAPI: POST /sessions/{id}/attendees\n        ProfLearningAPI->>IAM_API: GET /users/{uniqueId}\n        IAM_API-->>ProfLearningAPI: User confirmed\n        Note over ProfLearningAPI: Default awarded SCECHs to program max\n        ProfLearningAPI->>ProfLearningAPI: Add Attendee to roster\n        ProfLearningAPI-->>ProfLearningUI: Success\n    else File Upload\n        Coordinator->>ProfLearningUI: Upload attendee CSV\n        ProfLearningUI->>ProfLearningAPI: POST /sessions/{id}/attendees/bulk-upload\n        ProfLearningAPI->>ProfLearningAPI: Parse CSV, extract Unique IDs\n        loop For each Unique ID\n            ProfLearningAPI->>IAM_API: GET /users/{uniqueId}\n            IAM_API-->>ProfLearningAPI: User confirmed or not found\n        end\n        Note over ProfLearningAPI: Default awarded SCECHs to program max\n        ProfLearningAPI->>ProfLearningAPI: Add valid Attendees to roster\n        ProfLearningAPI-->>ProfLearningUI: Success with validation report\n    end\n\n    ProfLearningUI-->>Coordinator: Attendees added (with any errors)\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Unique ID not found in IAM -> Display error, cannot add attendee. Duplicate attendee -> Prevent addition with error message. Bulk upload with invalid IDs -> Return validation report showing which IDs failed." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (attendance not certified yet)" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Global educator search (not scoped to coordinator's organization) per BRD 26.5.1. Default awarded SCECHs to program maximum. Unique ID validation via IAM API before adding to roster." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Add Attendees" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Coordinator enrolls educators in program session. When: Before or during program delivery. Who: Coordinator." .

<urn:solutiondesign:instance:proflearning:Seq_AdjustScechAwardsAndCertify> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator\n    participant ProfLearningUI\n    participant ProfLearningAPI\n    participant CredentialingAPI\n    participant ServiceBus\n\n    Coordinator->>ProfLearningUI: View attendance roster for session\n    ProfLearningUI->>ProfLearningAPI: GET /sessions/{id}/attendance\n    ProfLearningAPI-->>ProfLearningUI: Roster with attendees\n\n    opt Adjust for partial attendance\n        Coordinator->>ProfLearningUI: Decrease awarded SCECHs for attendee\n        ProfLearningUI->>ProfLearningAPI: PATCH /attendees/{id}/scech-award\n        Note over ProfLearningAPI: Validate not exceeding program max\n        ProfLearningAPI->>ProfLearningAPI: Update SCECHAward entity\n        ProfLearningAPI-->>ProfLearningUI: Updated award\n    end\n\n    Coordinator->>ProfLearningUI: Review roster, agree to attestations\n    Coordinator->>ProfLearningUI: Certify attendance\n    ProfLearningUI->>ProfLearningAPI: POST /sessions/{id}/certify\n\n    alt Evaluation Required\n        ProfLearningAPI->>ProfLearningAPI: Check if all attendees submitted evaluation\n        alt Missing evaluations\n            ProfLearningAPI-->>ProfLearningUI: Error - pending evaluations\n        end\n    end\n\n    opt School Counselor SCECH validation\n        ProfLearningAPI->>CredentialingAPI: GET /credentials/{educatorId}/type\n        CredentialingAPI-->>ProfLearningAPI: Credential type\n        Note over ProfLearningAPI: Filter College/Career/Military SCECHs for non-counselors\n    end\n\n    ProfLearningAPI->>ProfLearningAPI: Mark roster as Certified\n    Note over ProfLearningAPI: After certification, direct edits blocked\n    ProfLearningAPI--)ServiceBus: Publish AttendanceCertified\n    ProfLearningAPI-->>ProfLearningUI: Success\n\n    ServiceBus--)CommunicationsWorker: AttendanceCertified event\n    CommunicationsWorker->>CommunicationsAPI: Send SCECH award notifications to attendees\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Missing required evaluations -> Block certification. Awarded SCECHs exceed program max -> Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "AttendanceCertified - Triggers attendee notifications, updates Credentialing domain" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Certification blocked if evaluations required but not submitted. SCECH awards immutable after certification (changes require SCECHCorrectionRequest). School Counselor credential type validated before awarding specialized SCECH types." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Adjust SCECHs and Certify" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Coordinator adjusts awarded hours for partial attendance, then certifies roster. When: After program completion. Who: Coordinator." .

<urn:solutiondesign:instance:proflearning:Seq_AdminApprovesProgramApplication> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant ProfLearningAdminUI\n    participant ProfLearningAPI\n    participant DocumentsAPI\n    participant ServiceBus\n\n    Note over ProfLearningAdminUI: Admin views the filtered, sortable program-applications list\n    Admin->>ProfLearningAdminUI: View pending program applications\n    ProfLearningAdminUI->>ProfLearningAPI: GET /program-applications?status=PendingApproval\n    ProfLearningAPI-->>ProfLearningAdminUI: Pending applications\n\n    Admin->>ProfLearningAdminUI: Select application, review details\n    ProfLearningAdminUI->>ProfLearningAPI: GET /program-applications/{id}\n    ProfLearningAPI-->>ProfLearningAdminUI: Application details\n    ProfLearningAdminUI->>DocumentsAPI: Fetch program agenda\n    DocumentsAPI-->>ProfLearningAdminUI: Agenda content\n\n    alt Approve\n        Admin->>ProfLearningAdminUI: Add comments, approve\n        ProfLearningAdminUI->>ProfLearningAPI: POST /program-applications/{id}/approve\n        ProfLearningAPI->>ProfLearningAPI: Update Program (Approved)\n        ProfLearningAPI--)ServiceBus: Publish ProgramApproved\n    else Reject\n        Admin->>ProfLearningAdminUI: Add comments, reject\n        ProfLearningAdminUI->>ProfLearningAPI: POST /program-applications/{id}/reject\n        ProfLearningAPI->>ProfLearningAPI: Update Application (Rejected)\n        ProfLearningAPI--)ServiceBus: Publish ProgramRejected\n    else Request More Info\n        Admin->>ProfLearningAdminUI: Add comments, request info\n        ProfLearningAdminUI->>ProfLearningAPI: POST /program-applications/{id}/request-info\n        ProfLearningAPI->>ProfLearningAPI: Update Application (RequiresInfo)\n        ProfLearningAPI--)ServiceBus: Publish InfoRequested\n    end\n\n    ProfLearningAPI-->>ProfLearningAdminUI: Updated status\n\n    ServiceBus--)CommunicationsWorker: Event received\n    CommunicationsWorker->>CommunicationsAPI: Notify coordinator of decision\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Missing required comments on reject/request-info -> Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "ProgramApproved - Triggers coordinator notification. ProgramRejected - Triggers coordinator notification. InfoRequested - Coordinator notified to provide additional details." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Admin UI accesses ProfLearning API endpoints directly for approve/reject/request-info." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Admin Approves Program Application" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Admin reviews a program application and approves, rejects, or requests more info. When: Application is in the admin's pending-review list. Who: Professional Learning Admin." .

<urn:solutiondesign:instance:proflearning:Seq_AdminConfiguresEvaluationQuestions> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant AdminUI\n    participant ProfLearningAPI\n    participant QuestionSetAPI\n\n    Admin->>AdminUI: Navigate to evaluation template management\n    AdminUI->>ProfLearningAPI: GET /evaluation-templates\n    ProfLearningAPI-->>AdminUI: Existing templates\n\n    Admin->>AdminUI: Create new template or edit existing\n    AdminUI->>AdminUI: Display template editor\n\n    Admin->>AdminUI: Enter template name, description\n    Admin->>AdminUI: Select applicable program categories\n\n    Admin->>AdminUI: Add questions to template\n    AdminUI->>QuestionSetAPI: GET /question-sets?domain=proflearning\n    QuestionSetAPI-->>AdminUI: Available question sets\n    Note over AdminUI: Question Set capability manages question content\n\n    Admin->>AdminUI: Select question set IDs to include\n    Admin->>AdminUI: Save template\n\n    AdminUI->>ProfLearningAPI: POST /evaluation-templates\n    Note over ProfLearningAPI: { name, description, categories[], questionSetRefs[] }\n    ProfLearningAPI->>ProfLearningAPI: Create EvaluationTemplate (Active)\n    ProfLearningAPI-->>AdminUI: Template ID\n    AdminUI-->>Admin: Template saved successfully\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid question set reference -> Validation error. Duplicate template name -> Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (configuration change, not a business event)" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Evaluation templates reference Question Set IDs, not inline question content. Question Set capability manages actual question versioning and structure. Templates can be assigned to program categories or individual programs." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Configure Evaluation Template" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Admin creates or edits evaluation templates used for program feedback. When: New evaluation needed or existing template requires updates. Who: Professional Learning Admin." .

<urn:solutiondesign:instance:proflearning:Seq_AdminManagesProgramCategories> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant AdminUI\n    participant ProfLearningAPI\n\n    Admin->>AdminUI: Navigate to category management\n    AdminUI->>ProfLearningAPI: GET /program-categories\n    ProfLearningAPI-->>AdminUI: Categories and subcategories\n\n    alt Create Category\n        Admin->>AdminUI: Create new category\n        AdminUI->>AdminUI: Display category form\n        Admin->>AdminUI: Enter category name, description\n        AdminUI->>ProfLearningAPI: POST /program-categories\n        ProfLearningAPI->>ProfLearningAPI: Create ProgramCategory (Active)\n        ProfLearningAPI-->>AdminUI: Category ID\n    else Create Subcategory\n        Admin->>AdminUI: Create subcategory under existing category\n        AdminUI->>AdminUI: Display subcategory form\n        Admin->>AdminUI: Enter subcategory name, select parent category\n        AdminUI->>ProfLearningAPI: POST /program-categories/{parentId}/subcategories\n        ProfLearningAPI->>ProfLearningAPI: Create Subcategory under parent\n        ProfLearningAPI-->>AdminUI: Subcategory ID\n    else Deactivate Category\n        Admin->>AdminUI: Select category, deactivate\n        AdminUI->>ProfLearningAPI: PATCH /program-categories/{id}/deactivate\n        ProfLearningAPI->>ProfLearningAPI: Check for active programs using category\n        alt Has active programs\n            ProfLearningAPI-->>AdminUI: Error - cannot deactivate\n            Note over AdminUI: Must reassign programs first\n        else No active programs\n            ProfLearningAPI->>ProfLearningAPI: Update category status (Inactive)\n            ProfLearningAPI-->>AdminUI: Success\n        end\n    end\n\n    AdminUI-->>Admin: Operation complete\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Duplicate category name -> Validation error. Deactivate category with active programs -> Blocked with error. Subcategory without parent -> Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (configuration change, not a business event)" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Categories cannot be deleted, only deactivated. Deactivation blocked if active programs depend on the category. Subcategories must belong to exactly one parent category." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Manage Program Categories" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Admin creates, edits, or deactivates program categories and subcategories. When: New classification needed or existing categories require updates. Who: Professional Learning Admin." .

<urn:solutiondesign:instance:proflearning:Seq_AdminReviewsCorrectionRequest> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant ProfLearningAdminUI\n    participant ProfLearningAPI\n    participant ServiceBus\n\n    Note over ProfLearningAdminUI: Admin views the filtered, sortable correction-requests list\n    Admin->>ProfLearningAdminUI: View correction requests queue\n    ProfLearningAdminUI->>ProfLearningAPI: GET /correction-requests?status=Submitted\n    ProfLearningAPI-->>ProfLearningAdminUI: Pending correction requests\n\n    Admin->>ProfLearningAdminUI: Select request, review details\n    ProfLearningAdminUI->>ProfLearningAPI: GET /correction-requests/{id}\n    ProfLearningAPI-->>ProfLearningAdminUI: Request details\n    Note over ProfLearningAdminUI: Shows: attendee, program, session, old value, new value, justification\n\n    alt Approve\n        Admin->>ProfLearningAdminUI: Add notes, approve correction\n        ProfLearningAdminUI->>ProfLearningAPI: POST /correction-requests/{id}/approve\n        ProfLearningAPI->>ProfLearningAPI: Update CorrectionRequest (Approved)\n        ProfLearningAPI->>ProfLearningAPI: Update ProgramAttendance with new SCECH value\n        ProfLearningAPI--)ServiceBus: Publish SCECHCorrectionApproved\n        Note over ServiceBus: Consumed by Credentialing to update SCECH balance\n        ProfLearningAPI-->>ProfLearningAdminUI: Success\n    else Deny\n        Admin->>ProfLearningAdminUI: Add notes explaining denial, deny\n        ProfLearningAdminUI->>ProfLearningAPI: POST /correction-requests/{id}/deny\n        ProfLearningAPI->>ProfLearningAPI: Update CorrectionRequest (Denied)\n        ProfLearningAPI--)ServiceBus: Publish SCECHCorrectionDenied\n        ProfLearningAPI-->>ProfLearningAdminUI: Success\n    end\n\n    ServiceBus--)CommunicationsWorker: Event received\n    CommunicationsWorker->>CommunicationsAPI: Notify coordinator of decision\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Missing admin notes on denial -> Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "SCECHCorrectionApproved - Updates Credentialing domain, notifies coordinator. SCECHCorrectionDenied - Notifies coordinator." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Admin can approve or deny, not modify the requested value. Admin notes are required for denials. Approval triggers update to both ProgramAttendance and Credentialing domain." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Admin Reviews Correction" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Professional Learning Admin approves or denies SCECH correction request. When: Correction request appears in the admin's correction-request review list. Who: Professional Learning Admin." .

<urn:solutiondesign:instance:proflearning:Seq_EducatorAppliesCollegeCourse> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Educator\n    participant ProfLearningUI\n    participant ProfLearningAPI\n    participant CredentialingAPI\n    participant ServiceBus\n\n    Educator->>ProfLearningUI: Navigate to college course credit page\n    ProfLearningUI->>ProfLearningAPI: GET /college-courses/eligible\n    ProfLearningAPI->>CredentialingAPI: GET /credentials/{educatorId}/last-issuance\n    CredentialingAPI-->>ProfLearningAPI: Last issuance date\n    ProfLearningAPI->>ProfLearningAPI: Filter STARR courses completed after issuance\n    ProfLearningAPI->>ProfLearningAPI: Exclude already-applied courses\n    ProfLearningAPI-->>ProfLearningUI: List of eligible courses\n\n    Educator->>ProfLearningUI: Select course(s) to apply\n    ProfLearningUI->>ProfLearningAPI: POST /college-courses/apply\n    ProfLearningAPI->>ProfLearningAPI: Create CollegeCourseApplication\n    ProfLearningAPI->>ProfLearningAPI: Convert college credits to SCECH hours (1 credit = 15 SCECHs)\n    ProfLearningAPI->>ProfLearningAPI: Mark course as used\n    ProfLearningAPI--)ServiceBus: Publish CollegeCourseApplied\n    ProfLearningAPI-->>ProfLearningUI: SCECH credits awarded\n\n    ServiceBus--)CommunicationsWorker: CollegeCourseApplied event\n    CommunicationsWorker->>CommunicationsAPI: Send confirmation to educator\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Course completed before last credential issuance -> Not displayed in eligible list. Course already applied -> Not displayed in eligible list." ;
	<urn:solutiondesign:ontology:eventsPublished> "CollegeCourseApplied - Updates Credentialing domain, triggers confirmation email" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Course eligibility determined by last credential issuance date from Credentialing domain. STARR data synced via Synapse Pipeline (external dependency). Conversion rate: 1 semester credit = 15 SCECH hours." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Apply College Course" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Educator selects completed college courses to count toward SCECH requirements. When: Educator views available courses from STARR data. Who: Educator (Citizen User)." .

<urn:solutiondesign:instance:proflearning:Seq_ProgramApplicationSubmission> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator\n    participant ProfLearningUI\n    participant ProfLearningAPI\n    participant IAM_API\n    participant DocumentsAPI\n    participant ServiceBus\n\n    Coordinator->>ProfLearningUI: Complete program application form\n    ProfLearningUI->>IAM_API: Check permission (proflearning.program.create)\n    IAM_API-->>ProfLearningUI: Authorized for sponsor\n\n    Coordinator->>DocumentsAPI: Upload program agenda\n    DocumentsAPI-->>Coordinator: Document reference\n\n    ProfLearningUI->>ProfLearningAPI: POST /program-applications\n    Note over ProfLearningAPI: Program details, agenda ref, sponsor ID\n    ProfLearningAPI->>ProfLearningAPI: Create ProgramApplication (PendingApproval)\n    ProfLearningAPI--)ServiceBus: Publish ProgramApplicationSubmitted\n    Note over ServiceBus: Notifies communications; application is now visible in the admin's pending-review list\n    ProfLearningAPI-->>ProfLearningUI: Application ID\n    ProfLearningUI-->>Coordinator: Confirmation message\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Coordinator lacks permission for sponsor -> HTTP 403. Required agenda document missing -> Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "ProgramApplicationSubmitted - Application becomes visible in the admin's pending-review list" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Document reference stored in ProfLearning, blob in Documents domain. Admin's pending-review list is the same GET /program-applications endpoint, filtered by status." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Program Application Submission" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Sponsor submits new/modified program for approval. When: Sponsor wants to offer new program or modify existing. Who: Coordinator or Assistant Coordinator." .

<urn:solutiondesign:instance:proflearning:Seq_PublicCatalogSearch> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Public\n    participant CatalogUI\n    participant ProfLearningAPI\n\n    Public->>CatalogUI: Navigate to Professional Learning Resources\n    CatalogUI->>CatalogUI: Display basic search field\n\n    Public->>CatalogUI: Enter search criteria (basic or advanced)\n    CatalogUI->>ProfLearningAPI: GET /catalog/search?query={criteria}\n    Note over ProfLearningAPI: Filter by Active status only\n    ProfLearningAPI-->>CatalogUI: Programs and sponsors matching criteria\n\n    CatalogUI-->>Public: Display search results grid\n\n    alt View Program Details\n        Public->>CatalogUI: Click Program Name hyperlink\n        CatalogUI->>ProfLearningAPI: GET /programs/{id}/details\n        ProfLearningAPI-->>CatalogUI: Program details (description, fees, contact, etc.)\n        CatalogUI-->>Public: Display program detail page\n    else View Sponsor Details\n        Public->>CatalogUI: Click Sponsor Name hyperlink\n        CatalogUI->>ProfLearningAPI: GET /sponsors/{id}/details\n        ProfLearningAPI-->>CatalogUI: Sponsor details and active programs\n        CatalogUI-->>Public: Display sponsor detail page\n    end\n\n    opt Bookmark (authenticated only)\n        Public->>CatalogUI: Click bookmark icon\n        CatalogUI->>ProfLearningAPI: POST /bookmarks\n        ProfLearningAPI-->>CatalogUI: Bookmark saved\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "No results found -> Display 'No results found' message. Special characters in search -> Ignored per BR." ;
	<urn:solutiondesign:ontology:eventsPublished> "None" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "No authentication required for search, authentication required for bookmarking. Only Active programs/sponsors returned in search results." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - Public Catalog Search" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Public searches for professional learning programs or sponsors. When: Anyone wants to discover learning opportunities. Who: Public (unauthenticated) or Educator (authenticated for bookmarking)." .

<urn:solutiondesign:instance:proflearning:Seq_SponsorRequestsScechCorrection> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Coordinator\n    participant ProfLearningUI\n    participant ProfLearningAPI\n    participant ServiceBus\n\n    Coordinator->>ProfLearningUI: Navigate to certified attendance roster\n    ProfLearningUI->>ProfLearningAPI: GET /sessions/{id}/attendance\n    ProfLearningAPI-->>ProfLearningUI: Certified roster (locked)\n\n    Coordinator->>ProfLearningUI: Select attendee, request correction\n    ProfLearningUI->>ProfLearningUI: Display correction request form\n    Note over ProfLearningUI: Shows current value, requests new value + justification\n\n    Coordinator->>ProfLearningUI: Enter new SCECH value and justification\n    ProfLearningUI->>ProfLearningAPI: POST /correction-requests\n    Note over ProfLearningAPI: { attendeeId, sessionId, oldValue, newValue, justification }\n\n    ProfLearningAPI->>ProfLearningAPI: Validate new value within program max\n    ProfLearningAPI->>ProfLearningAPI: Create SCECHCorrectionRequest (Submitted)\n    ProfLearningAPI--)ServiceBus: Publish SCECHCorrectionRequested\n    Note over ServiceBus: Request becomes visible in the admin's correction-request review list\n    ProfLearningAPI-->>ProfLearningUI: Correction request ID\n    ProfLearningUI-->>Coordinator: Request submitted, awaiting admin review\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "New value exceeds program max -> Validation error. Missing justification -> Validation error. Duplicate pending request for same attendee -> Reject with error." ;
	<urn:solutiondesign:ontology:eventsPublished> "SCECHCorrectionRequested - Request becomes visible in the admin's correction-request review list" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Correction requests required for any changes to certified attendance. Justification is mandatory. New SCECH value must not exceed program maximum." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Professional Learning - SCECH Correction Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Coordinator submits request to adjust SCECH awards after attendance has been certified. When: Error discovered post-certification. Who: Coordinator." .

<urn:solutiondesign:instance:proflearning:SequencesDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "sequences" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/proflearning/proflearning-sequences.md" .

<urn:solutiondesign:instance:proflearning:SessionLocation> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:fields> "County, LocationName, Address or Virtual indicator" ;
	<urn:solutiondesign:ontology:name> "SessionLocation" .

<urn:solutiondesign:instance:proflearning:SponsorContact> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:fields> "name, phone, email" ;
	<urn:solutiondesign:ontology:name> "SponsorContact" .

<urn:solutiondesign:instance:proflearning:SponsorState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:proflearning:SponsorState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:proflearning:SponsorStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Active or Inactive." ;
	<urn:solutiondesign:ontology:name> "SponsorStatus" .

<urn:solutiondesign:instance:proflearning:Subcategory> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "More specific classification within a parent category." ;
	<urn:solutiondesign:ontology:name> "Subcategory" .

<urn:solutiondesign:instance:proflearning:TemplateMetadata> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:fields> "name, description, applicable categories" ;
	<urn:solutiondesign:ontology:name> "TemplateMetadata" .

<urn:solutiondesign:instance:proflearning:TemplateState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:proflearning:TemplateState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:proflearning:TemplateStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Active, Inactive." ;
	<urn:solutiondesign:ontology:name> "TemplateStatus" .

<urn:solutiondesign:instance:proflearning:UT_AttendanceCertification> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Sponsor's formal confirmation that attendees completed the program, triggering SCECH award." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Attendance Certification" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> .

<urn:solutiondesign:instance:proflearning:UT_CorrectionRequest> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Sponsor-initiated request to adjust SCECH awards after attendance has been certified, requiring admin approval." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Correction Request" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:proflearning:SCECHCorrectionRequestAggregate> .

<urn:solutiondesign:instance:proflearning:UT_DPPD> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "District Provided Professional Development - specific indicator for programs that count as district-provided." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "DPPD" .

<urn:solutiondesign:instance:proflearning:UT_Program> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "An approved professional learning offering with defined content, format, and maximum SCECH hours." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Program" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:proflearning:ProfessionalLearningProgramAggregate> .

<urn:solutiondesign:instance:proflearning:UT_ProgramFee> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Display-only field showing the cost of the program. Actual payment collection happens on the sponsor's external registration website, not within MiEdWorkforce." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Program Fee" .

<urn:solutiondesign:instance:proflearning:UT_SCECH> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "State Continuing Education Clock Hours - credits awarded for professional learning attendance that count toward credential renewal." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "SCECH" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:proflearning:ProgramAttendanceAggregate> .

<urn:solutiondesign:instance:proflearning:UT_Session> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A specific offering/instance of a Program with defined dates and location. The same Program may have multiple Sessions at different times/locations." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Session" .

<urn:solutiondesign:instance:proflearning:UT_Sponsor> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "An organization approved to offer professional learning programs (created in EEM, managed in MiEdWorkforce)." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Sponsor" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:proflearning:ProfessionalLearningSponsorAggregate> .

<urn:solutiondesign:instance:proflearning:Wireframe10Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing (word/media/image5.png, immediately following Wireframe5): an approved program's own 'Attendance' tab ('Effectively Navigating investigations and student Discipline', status Approved) showing 'Pending approval attendance, 10 individuals' with a per-attendee Confirmed/Canceled/Not-confirmed status table and an 'Approve attendees credits' button — a sponsor-facing attendance/certification screen sitting alongside a 'Summary'/'Activity log' tab structure (the same 'Activity log' term FDD 28's own comment 9 flagged as stale versus the standardized 'Audit Log'; this FDD's wireframe evidence corroborates that the stale term originates upstream of FDD 28). Directly corroborates 26.5.4 (certify attendance)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-10-attendance-pending-approval.png" .

<urn:solutiondesign:instance:proflearning:Wireframe11Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Professional Learning Programs, Pending Applications' tab with a results table (Program Name, Application #, Start/Submit Date, Status: Info Required/In Review/Submitted) and a highlighted Program-Name hyperlink row. Positioned directly under the 26.6 Worklist text. Reads as a filtered view of the same Manage-Applications list (Wireframe5) rather than a functionally distinct worklist screen — no Sponsor-application action items appear anywhere in it, consistent with plrn:Req_26_6_1's own partial-gap note (Program-application worklist items only; Sponsor-application items have nothing to list, since no SponsorApplication entity exists)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-11-worklist-pending-applications.jpg" .

<urn:solutiondesign:instance:proflearning:Wireframe14_1Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Professional Learning Program Applications' worklist with Unresolved/Resolved tabs, a search field, filter/export controls, and a results table (Program Name, Program #, Application #, Start Date, Submit Date, Status) with a pagination footer showing 6115 items. Directly corroborates 14.3.1 (worklist page for Processing staff) and 14.3.2's 'categorized by Resolved and Unresolved' AC exactly." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/14-proflearning-admin-users/wireframes/wireframe-01-program-applications-worklist.png" .

<urn:solutiondesign:instance:proflearning:Wireframe14_2Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd14Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a 'Worklist Management' screen whose own breadcrumb reads 'Dashboard > Credentialing Data > Worklist Management' and whose table rows are 'Desktop Credentialing Worklist', 'Dashboard Full Credentialing Worklist', 'Dashboard Component Credentialing Worklist', 'Mobile Worklist' — Credentialing content, not Professional Learning, with no Professional-Learning-specific relabeling visible anywhere on the screen. This is a reused, uncustomized wireframe from a different domain's FDD, confirming comment 24 (Dontje) and comment 681365075 (Doherty, quoting Sinha)'s own suspicion that this screen was generic and might need PL-specific customization — see Question_ReusedCredentialingWorklistWireframe below." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/14-proflearning-admin-users/wireframes/wireframe-02-reused-credentialing-worklist-management.jpg" .

<urn:solutiondesign:instance:proflearning:Wireframe1Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Professional Learning - Sponsor list' [sic, actually the Sponsor Worklist screen] with Type/District-or-Sponsor/District-Sponsor-name/Application-number/Status filters, Search/Clear buttons, and a persistent admin tab bar: Sponsor Worklist | Program Worklist | Sponsor List | Program List | Category/Program description | Coupons and Payments | Email Sponsors. The 'Category/Program description' and 'Email Sponsors' tabs match Business-Specification-only capabilities modeled below (plrn:Req_28_BizSpec_ProgramCategoryMaintenance / ProgramDescriptionsAdmin / MassEmailSponsors); 'Coupons and Payments' matches nothing anywhere in this FDD's own text — see Question_CouponsAndPaymentsTabUndocumented." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a 'Professional Learning' landing page with a single 'Become a Professional Learning Sponsor' card (placeholder 'Content to come...' body text) and an 'Application' button. Low-fidelity placeholder, not a functional wireframe of the application itself — but positioned exactly where story 26.1.1's own AC text sits in document.xml, confirming this is genuinely 26.1's own (thin) wireframe evidence, at package-root /media/ rather than word/media/ (easy to miss)." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a Program Details page ('Drawing for Absolute Beginners') with a highlighted 'Visit Program Website' button and a bookmark icon, plus Sponsor Name/Contact, Program Location, Participant Fee, Professional Learning Hours, Offering Dates, Program Description, Prerequisite/Restrictions, and Requirements sections. Directly corroborates 27.1.1 (clickable program website link) and 27.1.2's 'Clicking on a Program Name navigates the user to the Program Details page' AC." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-01-sponsor-application-landing.jpg" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/27-proflearning-educator/wireframes/wireframe-01-program-details-registration-link.jpg" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/28-professional-learning-processing/wireframes/wireframe-01-sponsor-worklist-search-results.png" .

<urn:solutiondesign:instance:proflearning:Wireframe2Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Review Sponsor Application' — full submitted-application detail (School/Organization name, Address, Authorized Representative certification, submitter Name/Title/Email/Submitted Date), an Action dropdown (Comment/Submit/Cancel controls visible) and a Comment History panel showing two prior dated entries. Directly corroborates 28.1.1 (view in view mode), 28.1.3 (Action options), and 28.1.5 (comments + comment history)." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Search by Program' filter panel — Program Keywords, Date Range, Select Counties (multi-select typeahead), Select Sponsor, Select Category, Learning Hours range slider, Fee range slider, and Program Format checkboxes (Blended/Hybrid, Face-to-Face, Virtual/Online) — directly corroborates 27.1.2's AC list, including Dontje's comment-16 'or blended/hybrid' correction, which the visible AC text already incorporates." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Sponsor Application, Step 1 of 4' with Entity/Contact-Information fields (Name, Phone, Email, MiLogin ID, reason for access requested) PLUS a 'Program Fee' and 'General SCECH Hours' field and a 'Program Documents' upload table — fields that belong to the PROGRAM application wizard (image2.png/image3.png, Wireframe-04 below), not a Sponsor application. This is internal wireframe-authoring evidence, not just a documentation gap: the Sponsor-application wireframe appears to be a copy-paste of the Program-application wizard template with only some labels changed, corroborating that Feature 26.1 received noticeably less design attention than Feature 26.2 — consistent with Question_SponsorApplicationScopeWasContested's finding that the feature's very existence inside MiEdWorkforce was still being decided during this document's review period." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-02-sponsor-application-form.jpg" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/27-proflearning-educator/wireframes/wireframe-02-search-by-program.jpg" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/28-professional-learning-processing/wireframes/wireframe-02-review-sponsor-application.png" .

<urn:solutiondesign:instance:proflearning:Wireframe31_5_1> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Doc caption 'Wireframe 1 - Professional Learning sponsor search'. Confirmed by viewing: basic search bar plus Advanced Search/Reset buttons under a three-tab nav (Public Credential Search / Education Preparation Providers / Professional Learning Resources) — same shared-tab-bar pattern seen in the credentialing doc's images, further corroborating one shared public-search shell across all three domains." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/31-public-search/wireframes/plrn-31.5-wireframe1-basic-search.png" .

<urn:solutiondesign:instance:proflearning:Wireframe31_5_2> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Doc caption 'Wireframe 2 - Generic example of Advanced Search' (doc itself says wireframes here are generic functionality sketches, not exact content/fields per comment #12/#16). Confirmed by viewing: Sponsor Name/ID, Program Name, City, Zip, County, Category, Program Formats, #SCECHs, and a date-range picker — matches the 31.5.7 acceptance criteria field-for-field." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/31-public-search/wireframes/plrn-31.5-wireframe2-advanced-search.png" .

<urn:solutiondesign:instance:proflearning:Wireframe31_5_3> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Professional Learning resources search results' grid with Program Name/Sponsor Name/County/Category/Program Format/Max SCECH hrs/Begin Date/End Date columns and pagination — matches plrn:Op_SearchCatalog's responseSchema field-for-field." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/31-public-search/wireframes/plrn-31.5-results-grid.png" .

<urn:solutiondesign:instance:proflearning:Wireframe31_5_4> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: Program Name/Sponsor Name/Sponsor Contact/Category/Location/Facilitator/Fee/Description/Prerequisites/Technical Specs/Website/Max SCECHs/Offering Dates/County — a much richer field set than plrn:ProfessionalLearningProgramAggregate models today (see coverage-gap Annotation on plrn:Req_31_5_12)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/31-public-search/wireframes/plrn-31.5-program-detail.png" .

<urn:solutiondesign:instance:proflearning:Wireframe31_5_5> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd31_5Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: Sponsor Name/Sponsor ID/Phone/Email plus an Active Programs table for that sponsor — Sponsor ID and mailing-address fields shown here don't exist on plrn:ProfessionalLearningSponsorAggregate today (see plrn:Question_SponsorAddressAndHumanReadableId, corroborated below)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/31-public-search/wireframes/plrn-31.5-sponsor-detail.png" .

<urn:solutiondesign:instance:proflearning:Wireframe3Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: NOT a Sponsor-application screen at all — an 'Authorization and Security Agreement Instructions for State Continuing Education Clock Hours (SCECH)' access-request form with a View/Edit permissions-grant table (Teaching certificates worklist, Career and Technical Education Certificates Worklist, School Psychologist/Counselor/Administrator worklists, Manage demographics) and an 'Attestation for authorized representative' checkbox — this is MiEdWorkforce's existing IAM/User-Authorization access-request form (the same one cred:/iam: domains' own 'user authorization forms' concept refers to), reused here purely as a design ANALOGY for what a no-login-required intake experience should look and feel like, per 26.1.1's own AC ('similar to the user authorization forms'). Directly corroborates that 26.1.1 was deliberately modeled by analogy to an existing IAM flow rather than given its own original design — and that IAM flow itself has no counterpart SponsorApplication entity to extend." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a 'Find Learning Opportunities' screen with 'Completed Programs' / 'Saved Programs' tabs (the latter selected), and two results tables (one headed 'Program Name', one headed 'Provider Name') each with a bookmark-icon column. WIREFRAME-FIDELITY MISMATCH: the actual table columns/data underneath (Category, Building, Filled FTE, Unfilled FTE, Approved FTE, Status; row values 'English Language Arts'/'Mathematics'/'EKHS') are Staffing-domain vacancy/position data, not Professional-Learning-shaped columns (Program Name, Date(s), Credit Hours per 27.1.2's own AC) — this screen was evidently reused wholesale from a Staffing wireframe with only the tab labels changed, not redrawn for this content. The tab STRUCTURE (Completed Programs / Saved Programs) is still real signal for 27.1.4 and plrn:Req_27_BizSpec_PastAttendedProgramsSearch; the table content should not be read literally. See that Requirement's own notes." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-03-user-authorization-reference.jpg" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/27-proflearning-educator/wireframes/wireframe-03-saved-completed-programs-tabs.jpg" .

<urn:solutiondesign:instance:proflearning:Wireframe4Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing (this is the document's own explicitly-captioned 'Wireframe- Sponsor Program Application Wizard', word/media/image2.png — a filled-in example following the blank image1.png, both 'New program application, Step 1 of 4'): Sponsor information (read-only, pre-populated), Program type (dropdown + Display-in-catalog + 'Qualify program as' New-teacher/Re-certification checkboxes — the pre-restructuring layout comment 17/18 flagged for separation into 'SCECH Eligibility'), Basic information (name/category/subcategory/format/attendance-assurance), and an Endorsement(s) picker. Directly corroborates 26.2.1." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: an educator-facing 'Drawing for Absolute Beginners' program page tagged 'Awaiting Evaluation', with an Awarded Hours table (Awarded Hours / Possible Hours / Type / Sponsor Comments) and an 'Appeal Hours' link, plus an 'Evaluation' tab alongside 'Overview'. Directly corroborates both 27.2.1 (evaluation-gated hours, 'Hours awarded will not be applied... if the evaluation has not been completed') and 27.2.2 (the 'Appeal Hours' link is the correction/dispute entry point) on the same screen." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-04-program-application-wizard.png" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/27-proflearning-educator/wireframes/wireframe-04-awaiting-evaluation-overview-appeal.jpg" .

<urn:solutiondesign:instance:proflearning:Wireframe5Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing (the document's own explicitly-captioned 'Wireframe- Sponsor Program Application Management', word/media/image4.png): a 'Professional learning applications / Manage applications' list with In-progress/All-applications tabs, an Advanced-search control, and a results table (Program name, Program #, Application #, Start/Submit date, Status: Review/Draft/Correct errors/Approved/Submitted) — the sponsor-facing analogue of plrn:Op_ListProgramApplications's admin-side list. Directly corroborates 26.2.3/26.2.4 (the '...' edit/renew affordance is implied by the row actions, not itself visible in this static capture)." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the 'Evaluation' tab of the same program page — a 'What was your experience?' survey with configurable Question fields (two dropdowns, one free-text with a 255-char counter) and a 'Submit Evaluation' button. Directly corroborates 27.2.1's evaluation-submission mechanism, and is the concrete UI comment 12's attestation critique says needs to be reconsidered for the evaluations-OFF launch configuration — see plrn:Question_AttestationVsEvaluationSubmissionUnresolved." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-05-manage-applications-list.png" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/27-proflearning-educator/wireframes/wireframe-05-evaluation-submission-form.jpg" .

<urn:solutiondesign:instance:proflearning:Wireframe6Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd27Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'New Program Application, Step 3 of 3' — a read-only Program Information / Program Documents / Program Dates & Locations summary followed by an 'Advisory' block and three attestation checkboxes ('I have read and understood...', 'I verify that the requirements...', 'I attest that the information submitted...') before a Submit button. Directly corroborates 26.2.2's summary-and-attestation review step." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: an email-template editor ('{email_template_name}', General Info + Urgency/Frequency fields) breadcrumbed under Credentialing > Credentialing Data & Management > Communication Management > Emails — i.e. a screen from a DIFFERENT bounded context's own FDD, reused here to illustrate the shared Communications template-admin capability that 27.3.4's 'configure adjustable thresholds' story would extend. Supports the observation (see plrn:Req_27_3_4's own notes) that Communications' generic per-template Urgency/Frequency configuration is a real, modeled admin surface, but its 'Frequency' control is a per-template categorical select ('Set Frequency'), not the numeric adjustable time-interval value 27.3.4 actually describes." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-06-program-summary-attestation.jpg" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/27-proflearning-educator/wireframes/wireframe-06-email-template-admin-crossdomain.png" .

<urn:solutiondesign:instance:proflearning:Wireframe7Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Professional Learning - Sponsor list' — Sponsor name/Sponsor ID search fields, an 'Include inactive' checkbox, Search/Clear buttons, and a results table (Sponsor Name hyperlink, Sponsor ID, Contact, Sponsor Email, Active checkbox column) — matches the Business Specifications prose exactly. Same persistent tab bar as Wireframe 1." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a document-upload modal (drag-and-drop or browse, 'Maximum file size 1MB', 'Files supported: .doc, .docx, or .pdf') actively displaying a rejected-file-type error ('One or more file types not supported. Please remove and try again.') on one of three listed files. Directly corroborates both 26.3.1 (upload) and 26.3.2 (enforced allowable file types) — the visible file-type list (.doc/.docx/.pdf) is a real, concrete detail neither the Addendum text nor proflearning-domain.ttl states explicitly anywhere." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-07-document-upload.jpg" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/28-professional-learning-processing/wireframes/wireframe-07-sponsor-list-search-results.png" .

<urn:solutiondesign:instance:proflearning:Wireframe8Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: an 'Add Attendee' modal with a 'Search by name or PIC' field and a Select-Attendee results table (Employee, UID, Certificate, Endorsement columns). Directly corroborates 26.5.1's online-entry path; the search field's generic framing (no organization/sponsor-scoping UI element visible) is consistent with the AC's explicit 'search globally for attendees since individuals may not be associated with the sponsor's entity' requirement, matching the already-documented gap on the API side (no /educators/search endpoint — see plrn:Req_26_5_1's own notes)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-08-add-attendee.jpg" .

<urn:solutiondesign:instance:proflearning:Wireframe9Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd26Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: an 'Edit Attendee' modal with an Attendance dropdown (showing 'Full Attendance'), a 'General SCECH Hours Awarded' numeric field (pre-filled 3.75, presumably the program max), and a Comment field, plus Remove/Save actions. Directly corroborates 26.5.2/26.5.3's award-adjustment stories — matches plrn:Op_AdjustScechAward's shape closely." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/26-proflearning-sponsor/wireframes/wireframe-09-edit-attendee-scech.jpg" .

<urn:solutiondesign:instance:proflearning:WireframeAddendumADoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:proflearning:Fdd28Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: an uncaptioned, higher-fidelity '{Program_Name}' screen with Detail/Attendance/Evaluations tabs, a Coordinator-facing 'Add Attendee' / CSV-upload prompt, a per-attendee Attendance/Credits table, and a redacted attestation checkbox before 'Submit Attendance'. Header chrome ('School Name' persona selector) and actor implied (a Coordinator submitting attendance, not a Professional Learning Administrator reviewing it) place this outside this FDD's own stated PL-Admin actor scope — likely reused reference material from the Sponsor-side FDD (26/27), not this FDD's own deliverable. Kept as background context for 28.4.5/28.4.6 rather than mapped to a specific numbered story." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/28-professional-learning-processing/wireframes/addendum-a-attendance-evaluation-tabs.jpg" .

