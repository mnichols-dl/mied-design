<urn:solutiondesign:instance:epp:Op_BulkAcceptEnrollments> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "bulkAcceptEnrollments" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/candidate-enrollments/bulk-accept" ;
	<urn:solutiondesign:ontology:projection> "Bulk payload (candidateIds[] + enrollmentDate + programLevel + optional programType) applied to each targeted enrollment's PendingVerification -> Enrolled transition; response is an acceptedCount plus per-candidate errors, not the aggregates themselves." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Accept pending enrollment verifications (bulk)" ;
	<urn:solutiondesign:ontology:tags> "Candidate Enrollments" .

<urn:solutiondesign:instance:epp:Op_BulkCreateEnrollments> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called by the Synapse pipeline. Not exposed via APIM; mTLS/Managed Identity." ;
	<urn:solutiondesign:ontology:operationId> "bulkCreateEnrollments" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/candidate-enrollments/bulk-create" ;
	<urn:solutiondesign:ontology:projection> "bulkUploadJobId plus an enrollments[] array of parsed CSV rows (candidateUniqueId, eppCode, studentId, status, programLevel/programType, enrollmentDate, exitDate/exitReason), each applied to create or update one CandidateEnrollment aggregate." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Create/update enrollments from bulk file (called by Synapse)" ;
	<urn:solutiondesign:ontology:tags> "Candidate Enrollments" .

<urn:solutiondesign:instance:epp:Op_BulkRejectEnrollments> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "bulkRejectEnrollments" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/candidate-enrollments/bulk-reject" ;
	<urn:solutiondesign:ontology:projection> "Bulk payload is just candidateIds[]; response is a rejectedCount, not the aggregates themselves." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Reject pending enrollment verifications (bulk)" ;
	<urn:solutiondesign:ontology:tags> "Candidate Enrollments" .

<urn:solutiondesign:instance:epp:Op_BulkUpdateCandidateStatus> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:operationId> "bulkUpdateCandidateStatus" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/candidate-enrollments/bulk-status-update" ;
	<urn:solutiondesign:ontology:projection> "Bulk status-transition payload (candidateIds[] + status, plus exitDate/exitReason or enrollmentDate/programLevel/programType only when the target status requires them); response is an updatedCount plus per-candidate errors." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update status for multiple candidates (bulk)" ;
	<urn:solutiondesign:ontology:tags> "Candidate Enrollments" .

<urn:solutiondesign:instance:epp:Op_CancelApplication> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "cancelApplication" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/application-reviews/{applicationId}/cancel" ;
	<urn:solutiondesign:ontology:projection> "Request carries only applicationRemarks (required) + internalRemarks (optional); drives the aggregate's Submitted -> Cancelled transition." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Cancel application review" ;
	<urn:solutiondesign:ontology:tags> "Application Reviews" .

<urn:solutiondesign:instance:epp:Op_CompleteBulkUpload> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called by the Synapse pipeline. Not exposed via APIM; mTLS/Managed Identity." ;
	<urn:solutiondesign:ontology:operationId> "completeBulkUpload" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/candidate-enrollments/bulk-upload/complete" ;
	<urn:solutiondesign:ontology:projection> "Escape hatch: reports final status of a BulkUploadJob, which epp-domain.ttl deliberately does not model as its own sd:Aggregate/DomainEntity (see CandidateEnrollmentAggregate's sd:notes) — no sd:consumesShape target exists to point at." ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ bulkUploadJobId: uuid, status: Success|PartialSuccess|Failed, processedCount?: int, errorCount?: int, errorReportUrl?: uri }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Complete bulk upload job (called by Synapse)" ;
	<urn:solutiondesign:ontology:tags> "Candidate Enrollments" .

<urn:solutiondesign:instance:epp:Op_CreateEppProvider> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
