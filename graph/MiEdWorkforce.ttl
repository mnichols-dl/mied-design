	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_AuthorizationRequest> ;
	<urn:solutiondesign:ontology:projection> "Returns AuthorizationRequestSummary, a lighter per-item projection of AuthorizationRequest, paginated" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List current user's authorization requests" ;
	<urn:solutiondesign:ontology:tags> "AuthorizationRequests" .

<urn:solutiondesign:instance:iam:Op_ListIdentityResolutionRequests> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Same path as submitBusinessUserIdentityRequest (POST), distinguished by method — a source-document quirk (duplicate top-level YAML path key), not a conversion error." ;
	<urn:solutiondesign:ontology:operationId> "listIdentityResolutionRequests" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/identity-resolution/requests" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List identity resolution requests requiring administrator review" ;
	<urn:solutiondesign:ontology:tags> "IdentityResolution" .

<urn:solutiondesign:instance:iam:Op_ListOwnCitizenIdentityRequests> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listOwnCitizenIdentityRequests" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/citizen-identity/requests/my-requests" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:projection> "Never includes candidate match data, per the Citizen Near Match Resolution business rule" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List current citizen's own identity requests" ;
	<urn:solutiondesign:ontology:tags> "CitizenIdentity" .

<urn:solutiondesign:instance:iam:Op_ListPendingApprovals> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listPendingApprovals" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/authorization-requests/pending-approvals" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_AuthorizationRequest> ;
	<urn:solutiondesign:ontology:projection> "Returns PendingApprovalSummary, filtered to requests awaiting the caller's approval" ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "List requests awaiting the current user's approval (Lead Admins)" ;
	<urn:solutiondesign:ontology:tags> "AuthorizationRequests" .

<urn:solutiondesign:instance:iam:Op_ListRoles> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
