	<urn:solutiondesign:ontology:trigger> "Request reaches a resolved terminal state — Mi-Key Match/No-Match, requester self-resolution, or Identity Administrator resolution (Match/CreateNew/ApproveLink)" .

<urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks any submission — citizen self-service or business-user-initiated — through Mi-Key identity matching/resolution, and the resulting requirement for Identity Administrator review when Mi-Key returns a Near Match or the request otherwise requires admin review. The single request lifecycle for identity resolution across MiEdWorkforce; replaces what would otherwise be duplicate matching logic in each consuming domain." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:IdentityRecordRetiredEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:IdentityRecordSplitEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:IdentityRequestCancelledEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:IdentityRequestDeniedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:IdentityResolutionCompletedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:IdentityResolutionRequiresReviewEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:PersonRecordUpdatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:IdReqState_Cancelled> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:IdReqState_Denied> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:IdReqState_Matched> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:IdReqState_NoMatchCreated> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:IdReqState_PendingMiKeyMatch> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:IdReqState_RequiresResolution> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:IdReqState_Resolved> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_LinkDetails> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_NoSSNStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_RequestOrigin> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_RequestType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_ResolutionAction> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_SubmittedDemographics> ;
	<urn:solutiondesign:ontology:invariants> "A citizen cannot access MiEdWorkforce functionality while their most recent AccountCreation-type request is not yet resolved. An AccountUpdate-type request that results in Near Match does NOT block dashboard access. While a CitizenSelfService AccountUpdate request is RequiresResolution, Primary/Secondary demographic fields are locked; Contact fields remain editable. NoSSNStatus can only be set at Account Creation and can only be cleared by the citizen, an Identity Administrator, or as a side effect of Employee Roster addition (enforced by staffing). A Unique ID assigned with NoSSNStatus=true may only be used for Student Intern or Credential Applicant purposes. A citizen may cancel their own pending AccountUpdate request; AccountCreation requests cannot be self-cancelled once RequiresResolution. Self-resolution differs by origin: BusinessUserStaffing Near Match may be self-resolved by the requesting district user (or, for NewId only, escalated); CitizenSelfService Near Match always escalates to Identity Administrator review. A DemographicUpdate Near Match only ever presents the single candidate sharing the submitted Unique ID, with confirm/cancel and no escalation path. A LinkId request always goes directly to Identity Administrator review (no Mi-Key match phase, no self-resolution)." ;
	<urn:solutiondesign:ontology:notes> "RequestOrigin/RequestType combinations covered: CitizenSelfService+AccountCreation, CitizenSelfService+AccountUpdate, BusinessUserStaffing+NewId, BusinessUserStaffing+DemographicUpdate, BusinessUserStaffing+LinkId. Split ID and Retire ID are explicitly NOT modeled as requests here (FDD 15.6/15.11 Addendum) — both are Admin/Mi-Key-direct actions with no business-user-facing submission; MiEdWorkforce only receives the resulting callback/event (see IdentityRecordSplit/IdentityRecordRetired events). Open Question #11: the numeric auto-cancellation timeframe for an unresolved Near Match is undefined for both citizen and business-user paths." ;
	<urn:solutiondesign:ontology:rootEntity> "IdentityRequest" .

<urn:solutiondesign:instance:iam:IdentityResolutionRequiresReviewEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "requestId, requestOrigin, requestType, userId?, employeeRecordId?, submittedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "iam-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Mi-Key returns Near Match that must be reviewed by an Identity Administrator (always for CitizenSelfService; on escalation for BusinessUserStaffing NewId; always for LinkId)" .

<urn:solutiondesign:instance:iam:InactivityPolicyAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Automates the removal of authorizations for accounts that have been inactive, reducing security risk and maintaining system hygiene." ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:iam:Entity_DeactivationPolicy> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:PolicyState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:PolicyState_Configured> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:PolicyState_Suspended> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_DeactivationSchedule> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_InactivityThreshold> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_MiLoginTypeFilter> ;
	<urn:solutiondesign:ontology:invariants> "Inactivity threshold must be a positive number of days. Deactivation schedule must be a valid cron expression. Deactivated users are notified per policy. Deactivation actions are audit-logged." ;
	<urn:solutiondesign:ontology:rootEntity> "DeactivationPolicy" .

<urn:solutiondesign:instance:iam:NewCitizenUserAuthorizedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "userId, uniqueId, miLoginId, authorizedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "iam-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Citizen completes account creation (identity resolution reaches a Unique ID)" .

<urn:solutiondesign:instance:iam:Op_AdminResolveIdentityRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "adminResolveIdentityRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/identity-resolution/requests/{requestId}/admin-resolve" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Resolve an identity resolution request awaiting administrator review" ;
	<urn:solutiondesign:ontology:tags> "IdentityResolution" .

<urn:solutiondesign:instance:iam:Op_AdminUpdatePersonRecord> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:iam:VO_SubmittedDemographics> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:operationId> "adminUpdatePersonRecord" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/identity-resolution/person-records/{userId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:projection> "Direct demographic patch via Mi-Key, bypassing the normal match workflow; response reflects the affected IdentityRequest/person record" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Directly update a person's record (Identity Administrator)" ;
	<urn:solutiondesign:ontology:tags> "IdentityResolution" .

<urn:solutiondesign:instance:iam:Op_ApproveAuthorizationRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "approveAuthorizationRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/authorization-approvals/{token}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_Authorization> ;
	<urn:solutiondesign:ontology:projection> "Approving a request creates a new Authorization; the underlying AuthorizationRequest also transitions to Approved" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Approve authorization request via email link token" ;
	<urn:solutiondesign:ontology:tags> "AuthorizationRequests" .

<urn:solutiondesign:instance:iam:Op_CancelOwnCitizenIdentityRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "cancelOwnCitizenIdentityRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/citizen-identity/requests/{requestId}/cancel" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Cancel own pending Account Update request (Near Match only)" ;
	<urn:solutiondesign:ontology:tags> "CitizenIdentity" .

<urn:solutiondesign:instance:iam:Op_CheckPermissions> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called by any domain service; not exposed via APIM; authenticated via Managed Identity/mTLS. Critical permissions (iam.authorization.grant, iam.authorization.revoke) always bypass the 5-minute result cache." ;
	<urn:solutiondesign:ontology:operationId> "checkPermissions" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/permissions/check" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{userId, miLoginType, organizationCode?, permissionIds[]} -- an ad-hoc batch permission check, not shaped like one domain-model entity" ;
	<urn:solutiondesign:ontology:responseSchema> "{permissionId -> boolean} map -- escape hatch, does not map to one sd:producesShape entity" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Check one or more permissions for a user (internal service)" ;
	<urn:solutiondesign:ontology:tags> "Permissions" .

<urn:solutiondesign:instance:iam:Op_DenyAuthorizationRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
