	<urn:solutiondesign:ontology:method> "DELETE" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Sets the assignment end date; does not physically delete the record." ;
	<urn:solutiondesign:ontology:operationId> "endAssignment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/assignments/{assignmentId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
