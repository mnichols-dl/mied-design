<urn:solutiondesign:instance:staffing:Perm_AuditView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View audit items for ISD/RESA or SOM" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Audit> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
