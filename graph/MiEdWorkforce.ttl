<urn:solutiondesign:instance:credentialing:CredentialApplicationAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Manages the application process for new credentials, renewals, and endorsement additions." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:ApplicationApprovedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:ApplicationDeniedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:ApplicationRequiresManualReviewEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:AssessmentResultsValidatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialApplicationSubmittedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:credentialing:ApplicationProcessingNotes> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_Blocked> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_Cancelled> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_Denied> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_Draft> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_PendingDocuments> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_PendingPayment> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_ProfessionalPracticeHold> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_RequiresManualReview> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AppState_Submitted> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ApplicantResponses> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ApplicationStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ApplicationType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ManualReviewReasons> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ManualReviewRequired> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:PaymentStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ProfessionalPracticeStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:SubmittedDocuments> ;
	<urn:solutiondesign:ontology:invariants> "Once an application moves beyond Submitted status, it cannot be deleted by the applicant. Payment must be received before final approval (unless waived). Assessment scores must meet requirements for endorsement applications. Applications with ProfessionalPracticeStatus = Blocked cannot proceed to approval. Applications with ProfessionalPracticeStatus = Hold are held until cleared by Professional Practices domain. Applications with ProfessionalPracticeStatus = ConditionalClearance cannot auto-approve and require manual review; if PPR sets RequiresFelonyAcknowledgment, the district's acknowledgment must be captured before the application can proceed. ProfessionalPracticeStatus is eventually consistent - updated via event subscription (PPRClearanceAssessmentChanged) from Professional Practices domain." ;
	<urn:solutiondesign:ontology:rootEntity> "CredentialApplication" .

<urn:solutiondesign:instance:credentialing:CredentialApplicationSubmittedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "applicationId, applicantId, credentialType, submittedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Application submitted by educator or admin" .

<urn:solutiondesign:instance:credentialing:CredentialCategory> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "High-level grouping (Teacher, CTE, School Administrator, School Counselor, School Psychologist, School Nurse, Teaching Permit, Annual Vocational Authorization, School Social Worker)." ;
	<urn:solutiondesign:ontology:name> "CredentialCategory" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Defines the types, categories, and business rules for certificates and permits that can be issued. Supports versioning and historical tracking of definition changes." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialDefinitionCreatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialDefinitionDeprecatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:CredentialDefinitionUpdatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:credentialing:CredentialCategory> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:credentialing:CredentialDefinitionRequirementRule> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:credentialing:CredentialDefinitionVersion> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredDefState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredDefState_Deprecated> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:CredDefState_Draft> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:CredentialDefinitionEffectiveDateRange> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:CredentialDefinitionFeeSchedule> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:CredentialDefinitionValidityPeriod> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:CredentialProperties> ;
	<urn:solutiondesign:ontology:invariants> "A credential definition must belong to exactly one category. Active credential definitions must have defined eligibility requirements. Effective date ranges for different versions of the same credential cannot overlap. Fee amounts must be non-negative. If IsPermanent = true, then CanRenew must = false and ValidityPeriod must be null. Changes to definitions create new versions rather than modifying existing ones." ;
	<urn:solutiondesign:ontology:rootEntity> "CredentialDefinition" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionCreatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, credentialType, category, effectiveFrom" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin creates new credential type" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionDeprecatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, credentialType, deprecatedAt, deprecatedBy" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin deprecates credential type" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionEffectiveDateRange> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When this version of the definition is active." ;
	<urn:solutiondesign:ontology:name> "EffectiveDateRange" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionFeeSchedule> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Cost associated with application or renewal." ;
	<urn:solutiondesign:ontology:name> "FeeSchedule" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionRequirementRule> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Business rules defining eligibility criteria (degree requirements, GPA minimums, program enrollment, etc.)." ;
	<urn:solutiondesign:ontology:name> "RequirementRule" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionUpdatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, credentialType, changes, effectiveFrom, updatedBy" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin modifies credential definition" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionValidityPeriod> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "How long the credential remains valid before renewal (if not permanent)." ;
	<urn:solutiondesign:ontology:name> "ValidityPeriod" .

<urn:solutiondesign:instance:credentialing:CredentialDefinitionVersion> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Historical versions of a CredentialDefinition with change audit trail." ;
	<urn:solutiondesign:ontology:name> "DefinitionVersion" .

<urn:solutiondesign:instance:credentialing:CredentialExpiredEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "credentialId, educatorId, expiredAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Nightly batch job transitions an IssuedCredential past its expires_at date" .

<urn:solutiondesign:instance:credentialing:CredentialIssuedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "credentialId, educatorId, credentialType, issuedAt, expiresAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Application approved and credential created" .

<urn:solutiondesign:instance:credentialing:CredentialProperties> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Configuration flags for a credential definition." ;
	<urn:solutiondesign:ontology:fields> "PrintName (official name for printed certificates), IsPermanent, IsAdvanced, IsActive, CanApply, CanRenew" ;
	<urn:solutiondesign:ontology:name> "CredentialProperties" .

<urn:solutiondesign:instance:credentialing:CredentialRenewedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "credentialId, educatorId, renewedAt, newExpiryDate" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Existing credential renewed" .

<urn:solutiondesign:instance:credentialing:CredentialRevokedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "credentialId, educatorId, revokedAt, reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin revokes credential" .

<urn:solutiondesign:instance:credentialing:CredentialStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Current state of an issued credential (Valid, Expired, Suspended, Revoked, Nullified, Pending)." ;
	<urn:solutiondesign:ontology:name> "CredentialStatus" .

<urn:solutiondesign:instance:credentialing:CredentialSuspendedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "credentialId, educatorId, suspendedAt, reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin suspends credential" .

<urn:solutiondesign:instance:credentialing:CredentialTypeOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "CONFIRMED GAP (cross-domain consistency pass), same as cred:LastIssuanceOperation above: credentialing is now really converted in abox/mied-v3/credentialing/credentialing-api.ttl, and it still defines no /credentials/{id}/type path. proflearning-sequences.md's 'Adjust SCECH Awards and Certify Attendance' sequence calls this exact path to enforce the 'School Counselor SCECH Types Restricted by Credential' business rule." ;
	<urn:solutiondesign:ontology:path> "/credentials/{educatorId}/type" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Would return an educator's credential type, used to gate School-Counselor-only SCECH types (College/Career/Military) during certification." .

<urn:solutiondesign:instance:credentialing:CredentialingContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:displayName> "Credentialing" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:credentialing:AssessmentResultAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:credentialing:CredentialApplicationAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:credentialing:CredentialDefinitionAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:credentialing:EndorsementDefinitionAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:credentialing:IssuedCredentialAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:credentialing:IssuedEndorsementAggregate> ;
	<urn:solutiondesign:ontology:identifier> "credentialing" ;
	<urn:solutiondesign:ontology:kind> "CoreDomain" ;
	<urn:solutiondesign:ontology:notes> "Explicitly does NOT own: payment processing (payments), Professional Practice Review/conviction screening (profpractices), identity management and authentication (iam), document storage/retrieval (documents), email/SMS notifications (communications), educator employment assignments (staffing), professional learning hours tracking (proflearning), educator preparation program enrollment (epp)." ;
	<urn:solutiondesign:ontology:purpose> "Manages the complete lifecycle of educator credentials (certificates and permits) including application submission, review, approval, issuance, renewal, and revocation. Enables Michigan educators to obtain and maintain the credentials necessary to teach or serve in administrative roles, while ensuring state compliance and professional standards are met." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:documents:DocumentUploadedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:ApprovalApplicationDeniedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:ApprovalApplicationRecommendedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:CandidateEnrollmentVerifiedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:CandidateExitedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:CredentialApplicationDeniedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:CredentialApplicationRecommendedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:iam:AuthorizationApprovedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:iam:AuthorizationRevokedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:iam:AuthorizationUpdatedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:iam:NewCitizenUserAuthorizedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:iam:UserAccountDeactivatedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:payments:BulkPaymentCompletedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:payments:MissingPaymentDetectedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:payments:PaymentCompletedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:payments:PaymentFailedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:payments:PaymentInitiatedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:payments:RefundCompletedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:proflearning:AttendanceCertifiedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:proflearning:CollegeCourseAppliedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:proflearning:SCECHAwardAdjustedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:proflearning:SCECHCorrectionApprovedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:profpractices:DisclosureReviewCompletedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:profpractices:DisclosureStatusChangedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:profpractices:DisclosureSubmittedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:profpractices:NASDTECRecordMatchedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:profpractices:PPRAccountMarkerChangedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:profpractices:PPRClearanceAssessmentChangedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:profpractices:RapBackNotificationReceivedEvent> .

