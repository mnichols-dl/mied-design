	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Cannot modify core org data (name, address) - those come from EEM." ;
	<urn:solutiondesign:ontology:permissionId> "epp.provider.edit" .

<urn:solutiondesign:instance:epp:Perm_ProviderView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View EPP provider details and configuration" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:epp:Cat_ProviderManagement> ;
