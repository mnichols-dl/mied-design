	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get current user's active authorizations" ;
	<urn:solutiondesign:ontology:tags> "Authorizations" .

<urn:solutiondesign:instance:iam:Op_GetNewUsersReport> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
