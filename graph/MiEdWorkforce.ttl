	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:operationId> "updateEppProvider" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/epp-providers/{eppCode}" ;
	<urn:solutiondesign:ontology:projection> "EppProviderUpdate excludes core EEM-sourced fields (name, address, federal code) — only eppType, contacts, capability flags, and status are editable here." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update EPP provider configuration" ;
	<urn:solutiondesign:ontology:tags> "EPP Providers" .

<urn:solutiondesign:instance:epp:Op_UpdateProprepConfig> a <urn:solutiondesign:ontology:ApiOperation> ;
