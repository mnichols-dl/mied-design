<urn:solutiondesign:instance:credentialing:EndorsementAddedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "endorsementId, credentialId, educatorId, endorsementCode, gradeBand" ;
