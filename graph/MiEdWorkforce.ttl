	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Dated 08/01/2024 decision record (MOECS/MiEdWorkforce product owners and QA) settling how CredentialApplication.application_number is generated going forward. Read in full for this ingestion per the task brief's instruction to check it against Question_CredentialNumberFormat." ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied-fdds/functional-design-docs/11 - Educator Credentialing/Decision Sheet for Creating A Code in the Application Numbers.docx" .

