	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:DocumentRequest> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Transitions the audit item to AwaitingDistrictResponse." ;
	<urn:solutiondesign:ontology:operationId> "requestAuditDocumentation" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/audit/{auditItemId}/request-documentation" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:DocumentRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Request additional documentation from district" ;
