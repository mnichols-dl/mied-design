	<urn:solutiondesign:ontology:notes> "Stub, generalized — credentialing-sequences.md shows RefData participant calls (GET /endorsement-definitions, GET /credential-categories, GET /assessment-definitions) that read like they may actually be credentialing's own definitions endpoints rather than a separate refdata store; ambiguous in the source, not resolved here. See refdata-api.yml (not converted here)." ;
	<urn:solutiondesign:ontology:path> "/reference-data" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Cached reference/master data lookups (endorsement codes, credential type definitions, etc.)." .

<urn:solutiondesign:instance:reporting:ApiDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "api-spec" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/reporting/reporting-api.yml" .

<urn:solutiondesign:instance:reporting:ApiSpec> a <urn:solutiondesign:ontology:ApiSpec> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:ApiDoc> ;
	<urn:solutiondesign:ontology:version> "1.0.0" .

<urn:solutiondesign:instance:reporting:AuthorizationOutcome> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Whether the request was granted or denied, and why if denied (InsufficientPermission, ParameterResolutionFailure, ReportInactive, PowerBIError)." ;
	<urn:solutiondesign:ontology:name> "AuthorizationOutcome" .

<urn:solutiondesign:instance:reporting:CapabilityDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "domain" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/reporting/reporting-capability.md" .

<urn:solutiondesign:instance:reporting:Cat_Audit> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Audit" .

<urn:solutiondesign:instance:reporting:Cat_CatalogManagement> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Catalog Management" .

<urn:solutiondesign:instance:reporting:Cat_Credentialing> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Domain-Specific: credentialing" .

<urn:solutiondesign:instance:reporting:Cat_Documents> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Domain-Specific: documents" .

<urn:solutiondesign:instance:reporting:Cat_EmbedToken> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Embed Token" .

<urn:solutiondesign:instance:reporting:Cat_Epp> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Domain-Specific: epp" .

<urn:solutiondesign:instance:reporting:Cat_Payments> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Domain-Specific: payments" .

<urn:solutiondesign:instance:reporting:Cat_Proflearning> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Domain-Specific: proflearning" .

<urn:solutiondesign:instance:reporting:Cat_Staffing> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Domain-Specific: staffing" .

<urn:solutiondesign:instance:reporting:DomainAssociationVO> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Which functional domain this report belongs to (e.g. profpractice); determines permission gating and portal placement. Enum: iam, credentialing, profpractice, staffing, proflearning, epp, reporting." ;
	<urn:solutiondesign:ontology:name> "DomainAssociation" .

<urn:solutiondesign:instance:reporting:EmbedReqState_Denied> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Denied" .

<urn:solutiondesign:instance:reporting:EmbedReqState_Granted> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Granted" .

<urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Represents a single on-demand request to generate an embed token for a specific report and user context. Captures the authorization decision, resolved parameters, and token lifecycle for audit purposes." ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:reporting:EmbedReqState_Denied> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:reporting:EmbedReqState_Granted> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:reporting:AuthorizationOutcome> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:reporting:ResolvedParameters> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:reporting:TokenMetadata> ;
	<urn:solutiondesign:ontology:invariants> "Tokens are never stored; only audit metadata is persisted. A token can only be issued if the requesting user holds the report's declared PermissionKey at an appropriate scope. ResolvedParameters must satisfy all required fields in the report's ParameterContract before a token is issued. Each token is single-use in context — re-rendering requires a new token request." ;
	<urn:solutiondesign:ontology:notes> "reporting-capability.md's ERD models this as EMBED_TOKEN_REQUESTS (request_id PK, report_definition_id FK, requesting_user_unique_id, outcome, denial_reason, resolved_parameters json snapshot, token_expires_at, requested_at), 1:N-generates from REPORT_DEFINITIONS." ;
	<urn:solutiondesign:ontology:rootEntity> "EmbedTokenRequest" .

<urn:solutiondesign:instance:reporting:Fdd02Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Subtitle 'Reporting (2.0)'. Authors Vidhya Punniyamoorthy (DTMB)/Beth Dontje (MDE)/Caitlin Groom (CEPI); approved by Dontje and Groom 08/01/2025 per the signoff table — but comments.xml contains dated entries through 2026-03-05, well after that nominal approval date (same pattern the FDD 29 pass flagged for its own document: the signoff table isn't 'nothing changed after this')." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/02 - Reporting/2 - Reporting.docx" .

<urn:solutiondesign:instance:reporting:Fdd08_9DataWarehouseDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "8 review comments — see Question_DataWarehouseOutOfScope below; this thread is the single most important finding of this pass. A sibling, superseded '8.3 - Data Warehouse IDD.docx' also exists (in 'TO BE DELETED 8.3, 8.9 - Data Warehouse/'), read in full and confirmed to have NO Addendum/numbered stories at all and near-identical prose to this current doc — genuinely replaced, not converted separately, consistent with its own folder name." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.9 - CEPI Data Warehouse/8.9 - Data Warehouse IDD.docx" .

<urn:solutiondesign:instance:reporting:Op_AdminCreateReport> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Validates workspaceId/reportId resolve to a real Power BI report before creating the catalog entry (422 if not found). New reports are created with status Inactive; activated separately via adminUpdateReportStatus. All parameterContract entries must use a standard parameter name (StandardParameterName enum) — non-standard names are rejected (400)." ;
	<urn:solutiondesign:ontology:operationId> "adminCreateReport" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/reports" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request (ReportCreate) mirrors ReportDefinition's full authorable shape (displayName, domainAssociation, permissionKey, powerbiWorkspaceId, powerbiReportId, parameterContract, sortOrder) minus server-assigned fields (id, status, timestamps). Response is only the thin {reportDefinitionId, status} pair, not the full entity — status is always Inactive on creation." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Register a report in the catalog (admin)" ;
	<urn:solutiondesign:ontology:tags> "Admin" .

<urn:solutiondesign:instance:reporting:Op_AdminGetReport> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Full metadata including parameterContract and Power BI workspace/report identifiers; available for both Active and Inactive reports. Scope is resolved server-side from the report definition — X-Organization-Context is not required." ;
	<urn:solutiondesign:ontology:operationId> "adminGetReport" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/reports/{reportDefinitionId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response is ReportAdminDetail — ReportAdminSummary plus parameterContract and createdAt; the full admin-visible shape of ReportDefinition, available for both Active and Inactive reports." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get report details (admin)" ;
	<urn:solutiondesign:ontology:tags> "Admin" .

<urn:solutiondesign:instance:reporting:Op_AdminListEmbedAudit> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Paginated audit log of all embed token requests (granted and denied), filterable by report, requesting user, outcome, and date range. Never includes the token string itself, only resolvedParameters snapshots for granted requests." ;
	<urn:solutiondesign:ontology:operationId> "adminListEmbedAudit" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/embed-audit" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response items are EmbedAuditEntry — EmbedTokenRequest's own outcome/denialReason/resolvedParameters/tokenExpiresAt/requestedAt fields plus two denormalized display fields (reportDefinitionId, reportDisplayName) for the audit UI. Never includes the token string itself." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "View embed token request audit log (admin)" ;
	<urn:solutiondesign:ontology:tags> "Admin" .

<urn:solutiondesign:instance:reporting:Op_AdminListReports> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Returns the full catalog including Inactive reports; unlike /reports, no permission filtering is applied — all registered reports are returned regardless of the caller's domain permissions." ;
	<urn:solutiondesign:ontology:operationId> "adminListReports" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/reports" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response items are ReportAdminSummary — ReportSummary plus status and Power BI workspaceId/reportId/permissionKey/updatedAt (fields hidden from the user-facing listReports)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List all reports (admin)" ;
	<urn:solutiondesign:ontology:tags> "Admin" .

<urn:solutiondesign:instance:reporting:Op_AdminUpdateReport> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:notes> "Does not affect the underlying Power BI report definition. If workspaceId/reportId change, re-validates against Power BI (422 if not found). Updating parameterContract on an Active report takes effect immediately — the API cannot itself verify the Power BI report's RLS configuration was updated to match." ;
	<urn:solutiondesign:ontology:operationId> "adminUpdateReport" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/reports/{reportDefinitionId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request (ReportUpdate) is a partial/optional-fields subset of ReportDefinition — every field optional, at least one required; response is only {reportDefinitionId}." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update report catalog metadata (admin)" ;
	<urn:solutiondesign:ontology:tags> "Admin" .

<urn:solutiondesign:instance:reporting:Op_AdminUpdateReportStatus> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:notes> "Deactivating a report does not invalidate embed tokens already issued; those remain valid until natural expiry, since Power BI is not notified of the catalog-level status change. 409 if the report is already in the requested state." ;
	<urn:solutiondesign:ontology:operationId> "adminUpdateReportStatus" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/reports/{reportDefinitionId}/status" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request and response both carry only ReportDefinition's status field (plus reportDefinitionId in the response) — the single-field ReportStatus transition, not the full entity." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Activate or deactivate a report (admin)" ;
	<urn:solutiondesign:ontology:tags> "Admin" .

<urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Requires X-Organization-Context header (scope-sensitive). Validates the requesting user's authorization against the report's declared permissionKey, resolves embed parameters, and calls the Power BI GenerateToken API. An optional orgContext override may be supplied for multi-scope users, but it is validated against the user's actual authorizations — it cannot be used to escalate scope. reporting.embed-token.generate is not itself directly role-assignable; the real authorization decision is whether the caller holds the target report's declared permissionKey (see rpt:Perm_EmbedTokenGenerate's notes)." ;
	<urn:solutiondesign:ontology:operationId> "generateEmbedToken" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/reports/{reportDefinitionId}/embed-token" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response (EmbedTokenResponse) mirrors a Granted EmbedTokenRequest's outcome: embedToken (never persisted — ephemeral only, not the ResolvedParameters/audit shape), embedUrl, expiresAt (TokenMetadata), reportDefinitionId. Request body (EmbedTokenRequest) is optional and thin — only an orgContext override for multi-scope users, IAM-validated and unable to escalate scope — not itself a restatement of any aggregate's shape, so sd:consumesShape is left unset rather than forced onto it." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Generate embed token for a report" ;
	<urn:solutiondesign:ontology:tags> "Embed" .

<urn:solutiondesign:instance:reporting:Op_GetReport> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Returns 404 rather than 403 if the user is not authorized for this specific report's permissionKey, to avoid confirming the existence of reports the user cannot access." ;
	<urn:solutiondesign:ontology:operationId> "getReport" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/reports/{reportDefinitionId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response is ReportDetail (ReportSummary plus parameterContract); still excludes Power BI internal identifiers (workspaceId/reportId) and permissionKey, which are admin-only fields." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get report details" ;
	<urn:solutiondesign:ontology:tags> "Reports" .

<urn:solutiondesign:instance:reporting:Op_ListReports> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Returns the catalog filtered server-side to only reports the user is authorized for; unauthorized reports are omitted entirely (not returned as forbidden entries) to avoid leaking catalog information. Scope is agnostic at catalog level — org scope is evaluated per-report at embed-token time, not here." ;
	<urn:solutiondesign:ontology:operationId> "listReports" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:reporting:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/reports" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response items are ReportSummary — a lightweight subset (reportDefinitionId, displayName, description, domainAssociation, sortOrder); excludes PermissionKey, ParameterContract, and Power BI workspace/report identifiers. Reports the user cannot access are omitted entirely, not returned as forbidden entries." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List available reports" ;
	<urn:solutiondesign:ontology:tags> "Reports" .

<urn:solutiondesign:instance:reporting:ParameterContractVO> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Declared set of embed parameters this report accepts, with types, whether required, and how each maps to RLS configuration in the Power BI report definition." ;
	<urn:solutiondesign:ontology:fields> "parameterName (from the standard parameter set: UserUniqueId, OrgType, OrgCode, OrgAncestorCodes, UserRole), parameterType (String|Integer|Guid), isRequired, resolutionSource (UserContext|OrgContext|Static), description (how this param maps to RLS)" ;
	<urn:solutiondesign:ontology:name> "ParameterContract" .

<urn:solutiondesign:instance:reporting:Perm_CatalogManage> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Register, edit, or deactivate report definitions in the catalog" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_CatalogManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; does not affect the underlying Power BI report definition. This remains the ONLY permission gating reporting-api.ttl's admin catalog operations (Op_AdminCreateReport et al.) — there is not yet a per-domain equivalent of Communications' create/edit/activate/delete verbs, so a Staffing Administrator cannot today manage Staffing's own report catalog entries independently of a System Admin. See DESIGN-SPIKES.md item 3, which already covers bringing the ReportDefinitionAggregate lifecycle up to Communications' template-lifecycle richness (draft/published status, availability window) — delegating catalog management to per-domain manage permissions belongs in that same design pass, not as a quick rename, since it requires new authorization checks on the admin API operations themselves." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.catalog.manage" .

<urn:solutiondesign:instance:reporting:Perm_CatalogView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View the report catalog and browse available reports" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_CatalogManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "All authenticated users; individual reports are further gated by their declared domain permission (each report's PermissionKey)." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.catalog.view" .

<urn:solutiondesign:instance:reporting:Perm_CredentialingReportsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:appliesToDomain> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:concernsDomain> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:description> "View application status and volume reports" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_Credentialing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Scope-aware reporting. Migrated from credentialing.reports.view (credentialing-permissions.ttl, formerly cred:Perm_ReportsView) — see this file's header. Not required by any sd:ApiOperation via a static PermissionRequirement; it's consumed dynamically as a Power BI ReportDefinition's declared PermissionKey string (see rpt:PermissionKeyVO), the same as before the rename." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.credentialing-reports.view" .

<urn:solutiondesign:instance:reporting:Perm_DocumentsReportsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:appliesToDomain> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:concernsDomain> <urn:solutiondesign:instance:documents:DocumentsContext> ;
	<urn:solutiondesign:ontology:description> "View document lifecycle and compliance reports" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_Documents> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Migrated from documents.reports.view (documents-permissions.ttl, formerly docs:Perm_ReportsView) — see this file's header. Documents' own permissions file already noted this one had no matching PermissionRequirement (no dedicated reports endpoint in documents-api.ttl); unchanged by the move — still consumed dynamically as a Power BI ReportDefinition PermissionKey, not a static API gate." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.documents-reports.view" .

<urn:solutiondesign:instance:reporting:Perm_EmbedAuditView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View embed token request audit log" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_Audit> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.embed-audit.view" .

<urn:solutiondesign:instance:reporting:Perm_EmbedTokenGenerate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Trigger embed token generation for an eligible report" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_EmbedToken> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Not directly role-assignable; granted implicitly when the user holds the report's declared domain permission (PermissionKey, e.g. reporting.credentialing-reports.view) at an appropriate scope. The Reporting API enforces this — it is a technical/documentation gate on the embed-token endpoint's behavior, not a standalone assignable permission. The real authorization decision ('does this user hold the PermissionKey declared on this specific report?') is delegated to IAM and evaluated per-report; scope.SystemWide here describes this permission's own nominal scope, not the effective scope of the underlying domain permission it delegates to." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.embed-token.generate" .

<urn:solutiondesign:instance:reporting:Perm_EppReportsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:appliesToDomain> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:concernsDomain> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:description> "View EPP-specific reports (enrollment metrics, application statistics)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_Epp> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Migrated from epp.reports.view (epp-permissions.ttl, formerly epp:Perm_ReportsView) — see this file's header. epp-api.ttl has no /reports endpoint; same documented gap as before the move, now living alongside Reporting's other per-domain view permissions instead of in epp-permissions.ttl." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.epp-reports.view" .

<urn:solutiondesign:instance:reporting:Perm_PaymentsReportsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:appliesToDomain> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:concernsDomain> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:description> "View all payment reports (transactions, refunds, reconciliation, revenue, failed payments)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_Payments> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Includes export. Migrated from payments.report.view (payments-permissions.ttl, formerly pay:Perm_ReportView) — see this file's header; found on the second migration sweep (singular 'report', not 'reports'). No API operation currently models this permission — payments-api.yml has no export endpoint; same documented gap as before the move." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.payments-reports.view" .

<urn:solutiondesign:instance:reporting:Perm_ProflearningReportsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:appliesToDomain> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:concernsDomain> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:description> "View and export all professional learning reports and analytics" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_Proflearning> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Migrated from proflearning.report.view (proflearning-permissions.ttl, formerly plrn:Perm_ReportView) — see this file's header; found on the second migration sweep (singular 'report', not 'reports'). proflearning-api.ttl defines no reporting/analytics endpoints; same documented gap as before the move." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.proflearning-reports.view" .

<urn:solutiondesign:instance:reporting:Perm_StaffingReportsManage> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:appliesToDomain> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:concernsDomain> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:description> "Define and manage report availability and access for Staffing" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:reporting:Cat_Staffing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Migrated from staffing.admin.manage-reports (staffing-permissions.ttl, formerly staff:Perm_AdminManageReports) — see this file's header for an important caveat: fdd-review/10-staffing-admin's own review already links this exact story to the existing GLOBAL rpt:Perm_CatalogManage as a 'good match,' which may be too loose since that permission is System-Admin-only and covers every domain's reports, not a Staffing-scoped delegation. No sd:ApiOperation implements per-domain-scoped catalog management yet (only the global reporting.catalog.manage exists) — this permission is a placeholder anchor for that still-missing capability, tracked in DESIGN-SPIKES.md item 3, not a currently-enforced permission." ;
	<urn:solutiondesign:ontology:permissionId> "reporting.staffing-reports.manage" .

<urn:solutiondesign:instance:reporting:PermissionKeyVO> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The specific permission required to view this report (e.g. reporting.credentialing-reports.view). As of 2026-09-04, Reporting itself owns and defines these per-domain view permissions (reporting-permissions.ttl, tagged sd:appliesToDomain per report's DomainAssociation) rather than each referenced domain owning its own — this field still just stores the string key and delegates the actual check to IAM." ;
	<urn:solutiondesign:ontology:name> "PermissionKey" .

<urn:solutiondesign:instance:reporting:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "permissions" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/reporting/reporting-permissions.md" .

<urn:solutiondesign:instance:reporting:PowerBIReportReference> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The Power BI Service identifiers needed to generate a token." ;
	<urn:solutiondesign:ontology:fields> "workspaceId (Power BI Service workspace GUID), reportId (Power BI Service report GUID)" ;
	<urn:solutiondesign:ontology:name> "PowerBIReportReference" .

<urn:solutiondesign:instance:reporting:Question_BusinessSpecificationsBroaderThanAddendum> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "This FDD's Business Specifications prose section describes at least six distinct capabilities (report versioning, per-report export-tool/availability-window/aggregation-level admin controls, ad-hoc report saving, cross-system data sourcing, in-report visualization/comparative-dataset customization, and staffing-submission-role gating) that were never promoted into the Addendum's own 2.1.1-2.1.6 numbering — the inverse of FDD 29's pattern (where the Addendum fully superseded and exceeded its own Business Specifications section). Modeled here as rpt:Req_02_BizSpec_1 through _6 with synthetic IDs, following the precedent FDD 29's own pass set for its three never-promoted Business-Specification features. Two of the six (versioning, availability-window/aggregation-level) are genuine coverage gaps; three (ad-hoc authoring/saving, cross-system data sourcing, in-report visualization) resolve to out-of-scope or already-satisfied by Reporting's existing design boundary; one (staffing-submission gating) is already covered by the general PermissionKey mechanism." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_02_BizSpec_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_02_BizSpec_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_02_BizSpec_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_02_BizSpec_4> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_02_BizSpec_5> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_02_BizSpec_6> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_CatalogSearchTagging> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Should the report catalog support tagging or free-text search beyond domain grouping? Currently the only catalog filter is the `domain` query parameter on GET /reports (reporting-api.yml); no tags/search fields exist on ReportDefinition or ReportSummary. (Open Question #5)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Op_ListReports> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:CapabilityDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_DataWarehouseOutOfScope> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "THE KEY FINDING OF THIS PASS. FDD 02 (Reporting) and FDD 29 (Educator Credentialing - Certificates) both independently named 'Interfaces and Integrations Setup (8)' as an unconverted dependency, on the assumption it was a build gap waiting for someone to model it. This document's own review-comment thread shows the opposite: MDE/CEPI reviewers explicitly REJECTED these stories as MiEdWorkforce's responsibility. Groom (CEPI), 2025-11-21: 'Is this story needed? SLDS Warehouse is part of the overall MiEd system architecture plan.' Handley (CEPI), same day, twice: 'Since MiEdW is only responsible for populating data into the appropriate CEDS based cosmos data store, the CEDS SLDS Project Team will handle movement from cosmos to DW and beyond' and 'The data transfers from the CEDS based cosmos data store to the DW and beyond are responsibility of the CEDS SLDS Project Team.' Caswell (DTMB-Contractor), the most recent comment on this document (2026-03-09, i.e. after every other comment in this whole FDD 08 folder): 'Not needed, as the work is being under the Data Migration/Conversion work. Suggesting to remove.' In other words: the actual, current, most-recent-on-record decision is that CEPI Data Warehouse integration is NOT part of MiEdWorkforce's own solution design at all -- it belongs to a separate CEDS SLDS/Data Migration-Conversion project team, with MiEdWorkforce's only real responsibility being to correctly populate its own CEDS-based Cosmos datastore (a responsibility that belongs to the Data Migration/Conversion effort, not to this FDD or to Reporting). This resolves FDD 02's and FDD 29's dependency claims: 'Interfaces and Integrations Setup (8)', insofar as it means CEPI Data Warehouse specifically, is not a coverage gap for mied-v3 to close -- it is explicitly out of scope for this solution design. It does NOT resolve the separate, narrower question of what actually feeds reporting's own Power BI semantic layer (rpt:Dependency to ext:PowerBISystem already exists in reporting-capability.ttl) -- that remains genuinely unmodeled, but per this same comment thread it is now understood to be the CEDS SLDS Project Team's concern, not a MiEdWorkforce-side gap to close." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_08_9_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_08_9_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_08_9_4> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_08_9_5> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_08_9_6> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd08_9DataWarehouseDoc> ;
	<urn:solutiondesign:ontology:findingType> "out-of-scope" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "resolved" .

<urn:solutiondesign:instance:reporting:Question_DatasetIdDiscoveryStrategy> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What is the datasetId discovery strategy? The Power BI GenerateToken call requires the dataset ID associated with the report (see the identities.datasets field in the GenerateToken request body). Should this be stored in the ParameterContract at registration time, or fetched dynamically from the Power BI API at token generation time? Neither reporting-api.yml's ReportCreate/ReportUpdate schemas nor rpt:ParameterContractVO currently capture a datasetId field, so this is an open, unmodeled gap in the current ReportDefinition shape, not just a process-timing question. (Open Technical Question #4)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:TP_EmbedTokenGeneration> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Platform" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_OrgAncestorCodesCaching> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Should OrgAncestorCodes be pre-computed and cached (reducing Organizations API calls per token request), or fetched fresh on each token generation? A cache TTL would need to align with the org sync pipeline's cadence (nightly, per organizations-domain.md's own materialized-hierarchy batch job). (Open Technical Question #2)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:TP_ParameterResolution> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Platform" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_PowerBILicensingModel> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What Power BI licensing model will be used — Embedded A-SKU, Premium P-SKU, or Per-User Pro? This determines whether GenerateToken supports service-principal-based multi-user embedding without per-user licenses (A-SKU or P-SKU is required for anonymous/service-principal embedding at scale), and affects the token generation approach generally. The same question appears twice in the source material with the same unresolved answer: reporting-capability.md's Open Question #1 and reporting-technical-design.md's Open Technical Question #1 — modeled once here rather than as two separate Annotations." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:TP_EmbedTokenGeneration> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:CapabilityDoc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:owner> "Platform / Procurement" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_PublicUnauthenticatedReports> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Should any reports be accessible to unauthenticated public users — for example, aggregate credential statistics surfaced on the Public Portal? Every operation in reporting-api.yml is currently x-access: internal-user with no sd:requiresAuth false exceptions; if this is answered yes, it changes both the API surface (a new public, unauthenticated endpoint class) and the authorization model (Reporting would need a path that doesn't route through IAM's permission-check dependency at all). (Open Question #3)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:CapabilityDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_ReportAuthoringOwnership> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Who owns report authoring, and what is the process for a domain team to request a new report be authored and registered in the catalog? reporting-capability.md is explicit that report authoring itself (Power BI Desktop, Pro/Premium licensing) is out of scope for the portal and this capability — but the intake/governance process for a domain team requesting a new report (who builds it, who reviews the ParameterContract for standard-parameter compliance before registration, how Rule_NotEveryDashboardIsAPowerBIReport's 'catalog team reviews requests' actually works operationally) is undocumented. (Open Question #7)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Op_AdminCreateReport> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Rule_NotEveryDashboardIsAPowerBIReport> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:CapabilityDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Platform / Reporting catalog team" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_ReportFilterAndDownloadFilenameConvention> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Punniyamoorthy, 2026-02-05 (comment 34, no reply on record): (1) will these Power BI reports within MiEdWorkforce have filter options like date range or certificate type, and (2) is a defined filename convention needed for downloads (example given: 'Teaching Cert_MSU_02052026.pdf' for a Teaching certificate report run for MSU as of 2/5/2026)? Filtering is presumably native Power BI report interactivity (see rpt:UT_AdHocExploration) and thus not a MiEdWorkforce-side gap, but a download-filename convention, if wanted, WOULD be something Reporting's own embed/export integration would need to control or coordinate with Power BI's export naming — currently unaddressed anywhere in reporting-capability.md/reporting-technical-design.md. Left open; no reply thread exists to resolve it." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:Req_02_1_6> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:Question_TokenRefreshSDKSupport> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "How does the Power BI JavaScript SDK handle token refresh for reports already rendered? The proactive-refresh design (schedule a refresh at expiresAt minus 10 minutes, call setAccessToken on the already-rendered report rather than a full page reload) assumes a setAccessToken-equivalent API exists in the chosen SDK version — needs confirmation before committing to the no-reload refresh approach. (Open Technical Question #3)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:reporting:TP_EmbedTokenGeneration> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Frontend" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:reporting:ReportDefState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:reporting:ReportDefState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Represents a registered, portal-visible Power BI report. Acts as the application's record of a report that can be embedded, capturing all metadata needed to generate a valid embed token and display the report in context." ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:reporting:ReportDefState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:reporting:ReportDefState_Inactive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:reporting:DomainAssociationVO> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:reporting:ParameterContractVO> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:reporting:PermissionKeyVO> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:reporting:PowerBIReportReference> ;
	<urn:solutiondesign:ontology:invariants> "A ReportDefinition must reference a valid Power BI workspaceId and reportId. A ReportDefinition must declare exactly one PermissionKey used to gate access. A ReportDefinition must declare its DomainAssociation; only one domain per report. The ParameterContract must be consistent with the RLS configuration in the Power BI report definition (application-side validation cannot enforce this, so it is a governance convention). Only reports with status = Active are surfaced in the portal catalog or eligible for token generation." ;
	<urn:solutiondesign:ontology:notes> "reporting-capability.md's ERD models this as REPORT_DEFINITIONS (report_definition_id PK, display_name, description, domain_association, permission_key, powerbi_workspace_id, powerbi_report_id, status, sort_order, created_at, updated_at) 1:N-declares REPORT_PARAMETER_CONTRACTS (contract_id PK, report_definition_id FK, parameter_name, parameter_type, is_required, resolution_source, description) — see rpt:ParameterContractVO's sd:fields for the parameter-contract shape." ;
	<urn:solutiondesign:ontology:rootEntity> "ReportDefinition" .

<urn:solutiondesign:instance:reporting:ReportingContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:CapabilityDoc> ;
	<urn:solutiondesign:ontology:displayName> "Reporting" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:identifier> "reporting" ;
	<urn:solutiondesign:ontology:kind> "PlatformCapability" ;
	<urn:solutiondesign:ontology:notes> "Platform Capability rather than a Core Domain because it provides shared infrastructure (report discovery, embed token generation, parameter contracts, authorization gating) consumed by multiple core domains. Owns report catalog metadata, embed-token generation with authorization gating, and RLS (row-level security) parameter contracts. Owns none of the underlying report data or definitions — those live in Power BI Service and each domain respectively. Explicitly does NOT own: Power BI report definitions (authored/maintained in Power BI Desktop and published to Power BI Service outside the application), the underlying data surfaced in reports (owned by the domain whose data it is), report editing/authoring (requires Power BI Pro/Premium licensing, not exposed in the portal UI), and general-purpose in-UI charts/dashboards that do not require Power BI (a UI concern per domain). As of 2026-09-04 Reporting DOES own the domain-level report-viewing permissions themselves (reporting.{domain}-reports.view, in reporting-permissions.ttl) — moved here from each domain's own file since Reporting is what actually checks them; see that file's header for the rationale." ;
	<urn:solutiondesign:ontology:purpose> "Provides embedded Power BI report access within the MiEdWorkforce portal, enabling domain-specific analytics and data exploration for authorized users. Manages report catalog metadata, authorization-gated embed token generation, and a standardized parameter contract that scopes report data to the viewer's organizational context." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:communications:EmailTemplateCreatedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:staffing:CollectionCertifiedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:staffing:CollectionOpenedEvent> .

<urn:solutiondesign:instance:reporting:Req_02_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system must provide the functional administrator the ability to define and maintain reports and define user viewability/availability using the Power BI framework without requiring developer support. The system must enforce authorization access for all system functionality at the entity, group, and role level." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Wireframe1 (Report Management list screen) directly corroborates the admin interface itself. 'Entity, group, and role level' authorization enforcement is the general IAM/PermissionScope machinery (scope:Entity etc., per permission-scopes.ttl) rather than anything Reporting-specific — not re-modeled here, just cited as the existing mechanism." ;
	<urn:solutiondesign:ontology:requirementId> "2.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminGetReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminListReports> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Perm_CatalogManage> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Rule_ReportAccessGatedByDomainPermissions> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Administrator (by functional area), I want an administrative interface to manage embedded Power BI reports, so that I can ensure the correct reports are accessible to the appropriate user roles and scoped to the relevant functional area data." ;
	<urn:solutiondesign:ontology:title> "Administrative interface to manage embedded Power BI reports" .

<urn:solutiondesign:instance:reporting:Req_02_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "An 'Add Report' button/function on the administrative page (e.g., Staffing Admin page, Credential Admin page) initiates new report creation. The administrator defines and maintains the report without developer support. The system prompts the administrator to input the external report identifier or link necessary to embed the Power BI content (report creation happens externally in Power BI). The administrator specifies the functional area (e.g., Credentialing, Staffing, PPR) for the new report. The System Administrator can define/maintain standard reports related to user authorization. The Credential Admin manages reports/settings related to Credential report availability and PPR Processes. The Staffing Data Admin manages reports/settings related to Staffing Data Collections. The system allows a 'Preview' of the report prior to adding it; once reviewed, the report is added by selecting 'Add Report.'" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Good structural match: Op_AdminCreateReport validates workspaceId/reportId against the real Power BI report before creating the catalog entry, matching 'report creation happens externally in Power BI'; Seq_RegisterReportInCatalog's register-then-activate pattern matches this story's implicit two-step (add, then presumably a separate activation per 2.1.3) flow. Two genuine gaps, both wireframe-confirmed (Wireframe2) rather than assumption-based: (1) no 'Preview' capability exists anywhere in reporting-api.ttl/reporting-sequences.ttl — Op_AdminCreateReport has no preview/dry-run mode, only a real create; (2) the wireframe's actual field shape (single free-text Power BI Link + Workspace dropdown + Role/Category/Sub-Category, vs. the modeled workspaceId+reportId GUID pair + flat DomainAssociation + PermissionKey string) doesn't match the aggregate as documented — see Question_ReportFormShapeVsModeledAggregate below." ;
	<urn:solutiondesign:ontology:requirementId> "2.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:DomainAssociationVO> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminCreateReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:PermissionKeyVO> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Seq_RegisterReportInCatalog> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Administrator (by functional area), I want an \"Add Report\" function within my administrative interface to register a new embedded Power BI report, so that I can define the report's resources, access permissions, and availability for my designated functional area and user roles." ;
	<urn:solutiondesign:ontology:title> "\"Add Report\" function to register a new embedded Power BI report" .

<urn:solutiondesign:instance:reporting:Req_02_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Administrators, by functional area, can set reports Active or Inactive. The status change takes effect on-demand (immediately). When Inactive, the report is completely hidden from the UI and users are not notified of its existence or unavailability. The admin can immediately retire report availability." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match — ReportDefinitionAggregate's own invariant ('Only reports with status = Active are surfaced in the portal catalog or eligible for token generation') is exactly the 'completely hidden, no notification' behavior this story asks for, and Seq_DeactivateReport's key decision (outstanding tokens remain valid; no Power BI-side revocation call) is a reasonable, already-documented interpretation of 'immediate' that this story doesn't itself address one way or the other. Wireframe3's context menu ('Deactivate'/'Delete Report') visually corroborates the Deactivate half; see Question_WireframeOnlyFeaturesNotInStories for the sibling 'Delete Report' option this story doesn't mention." ;
	<urn:solutiondesign:ontology:requirementId> "2.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminUpdateReportStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefState_Active> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefState_Inactive> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Seq_DeactivateReport> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Admin (by functional area), I need the ability to set reports as Active or Inactive on-demand, so that I can control report visibility to end-users dynamically." ;
	<urn:solutiondesign:ontology:title> "Set reports Active or Inactive on-demand" .

<urn:solutiondesign:instance:reporting:Req_02_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Store audit details for: a report being added; modification of Report Name and/or Description; Workspace association changes; changes in access and permissions. Availability audit details include Active/Inactive status and Begin/End Date ranges. Report audit details include Report Name, description of the audit event, and Date." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this story asks for a CATALOG-CHANGE audit trail (who edited a report's name/description/workspace/permissions, and when) — a genuinely different audit concept from what rpt:EmbedTokenRequestAggregate/rpt:Op_AdminListEmbedAudit actually model, which is an EMBED-TOKEN-REQUEST audit (who viewed/attempted to view which report, granted or denied, and why). reporting-capability.ttl's own ERD note mentions REPORT_DEFINITIONS carries created_at/updated_at timestamps, but no admin-facing endpoint exposes a change history, no old-value/new-value field-level tracking exists, and nothing tracks 'who' made a catalog edit at all (no actor/user field on ReportDefinition). This is a real, confirmed coverage gap distinct from the embed-token audit already modeled — not to be papered over by pointing at Op_AdminListEmbedAudit, which answers a different question. Additionally, 'Begin/End Date ranges' as an audited field presupposes those fields exist on ReportDefinition at all, which they don't — see rpt:Req_02_BizSpec_2 below (Business Specifications' own admin-settable availability-window feature, also unmodeled)." ;
	<urn:solutiondesign:ontology:requirementId> "2.1.4" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Admin, I want the system to store audit details in an internal audit log for report related changes made within the MiEdWorkforce system, so that I can track, review and verify who made changes, what was changed and when, for accountability and compliance purposes." ;
	<urn:solutiondesign:ontology:title> "Internal audit log for report-related changes" .

<urn:solutiondesign:instance:reporting:Req_02_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "A primary navigation menu is organized by functional areas. Selecting a functional area displays a secondary list of associated report subcategories. Selecting a subcategory displays a comprehensive list of all reports in that grouping. The user can select an individual report to initiate viewing. Selected reports render as fully functional, embedded Power BI objects within the interface. The system maintains the user's navigational context so they can return to subcategory/functional-area menus. Access to reports and categories adheres to the user's existing security permissions and data access levels." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match end-to-end: Seq_BrowseReportCatalog's server-side permission filtering matches 'adheres to existing security permissions' well, and Seq_GenerateEmbedTokenHappyPath's render step matches 'fully functional embedded Power BI objects'. Wireframe4 and Wireframe5 (confirmed by viewing) visually corroborate the exact three-level functional-area > subcategory > report-list flow this story describes. The functional-area/subcategory two-level grouping this story assumes is the same DomainAssociation-vs-wireframe-Category/Sub-Category granularity gap already raised on 2.1.2 — not re-raised as a second Annotation, same underlying finding (Question_ReportFormShapeVsModeledAggregate). 'Maintains navigational context on return' is a client-side UX concern with no corresponding API/Sequence concept to satisfy it against — not flagged as a gap, since nothing in Reporting's own API contract would need to change to support it (it's ordinary client-side routing state)." ;
	<urn:solutiondesign:ontology:requirementId> "2.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:DomainAssociationVO> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_GetReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_ListReports> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Perm_CatalogView> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Seq_BrowseReportCatalog> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Seq_GenerateEmbedTokenHappyPath> ;
	<urn:solutiondesign:ontology:statement> "As a System User, I want to navigate through functional area menus and subcategories to access specific reports, so that I can view embedded Power BI data visualizations directly within the MiEdWorkforce system." ;
	<urn:solutiondesign:ontology:title> "Navigate functional-area menus to access and view embedded reports" .

<urn:solutiondesign:instance:reporting:Req_02_1_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "A user with appropriate report permissions can export standardized reports; the MiEdWorkforce UI supports and displays the export capabilities enabled within the embedded Power BI reports for authorized users. Users can export in a variety of formats, explicitly including PDF, Excel, and CSV, as defined in the Power BI configuration. Users can download the exported report. For Paginated Reports, the system supports Power BI's paginated export features for pixel-perfect print/PDF optimization." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Comment thread (Ross, 2026-01-21: 'Ability to export will reside within the Power BI embedded report'; Groom, 2026-02-09: 'The ability to define the export of reports will live in Power BI, but MiEd will need to support the export functions defined within Power BI'; Caswell: 'User story revised, per Caitlin's comment') is decisive and resolves this story to exactly what's already modeled: Reporting's own obligation ends at successfully embedding the report (rpt:Op_GenerateEmbedToken/Seq_GenerateEmbedTokenHappyPath) — export itself is a native Power BI Service capability of the rendered report object, not a MiEdWorkforce-built feature, consistent with rpt:Rule_ReportDefinitionsOwnedOutsideApplication's existing scope boundary. Satisfied by design, not by omission. See Question_ReportFilterAndDownloadFilenameConvention below for one genuinely open, unresolved sub-question from a later comment on this same story." ;
	<urn:solutiondesign:ontology:requirementId> "2.1.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:PowerBISystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Seq_GenerateEmbedTokenHappyPath> ;
	<urn:solutiondesign:ontology:statement> "As a System User, I need the ability to export reports in a variety of formats [text overlaps two revisions in the source — see this file's header note] MiEdWorkforce report interface to support the export functions defined within Power BI, including PDF, Excel, and CSV, so that I can share critical data with stakeholders and perform offline analysis outside of the MiEdWorkforce system." ;
	<urn:solutiondesign:ontology:title> "Export reports via Power BI's native export functions" .

<urn:solutiondesign:instance:reporting:Req_02_BizSpec_1> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no versioning concept (version number, prior-version retention, or version history) exists anywhere on rpt:ReportDefinitionAggregate — only a two-state Active/Inactive lifecycle and (per the ERD note) created_at/updated_at timestamps, neither of which is 'versioning' in the sense this bullet implies (the HLS table's own paraphrase, row 2, explicitly separates 'the system admin will be able to update the report' from '2. The MiEdWorkforce system will version the updated report(s)' as two distinct expectations). Genuine coverage gap." ;
	<urn:solutiondesign:ontology:requirementId> "2.BizSpec.1" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem given — a flat Business Specifications bullet.) The system will version reports updated by the system admin." ;
	<urn:solutiondesign:ontology:title> "Report versioning on admin update" .

<urn:solutiondesign:instance:reporting:Req_02_BizSpec_2> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Active/inactive on-demand is the one clause here that IS modeled and covered — see 2.1.3/rpt:Op_AdminUpdateReportStatus. The other three are genuine gaps: (1) per-report export-tool selection has no field on ReportDefinition and no admin operation to set it (distinct from 2.1.6's end-user-facing native Power BI export, which is a different, already-satisfied concern); (2) a Begin/End Date availability window (with a future-dated Begin Date explicitly called out) has no corresponding fields anywhere — confirmed as a real, intended feature (not a dropped idea) by comment thread 25/26: Punniyamoorthy asks 'Do we need to have validity period on any report?' and Dontje replies 'The validity period is a report setting' — i.e. this was affirmed as real scope, just never modeled; (3) 'level of aggregation (building, district, ISD, statewide)' as an admin-settable report attribute has no field either — RLS-driven org scoping exists at embed-token time (rpt:ResolvedParameters/OrgAncestorCodes) but that's runtime data-scoping for the VIEWER, not an admin-authored 'this report reports at the district level' catalog attribute. All three: coverage-gap." ;
	<urn:solutiondesign:ontology:requirementId> "2.BizSpec.2" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem given.) The MiEdWorkforce administrators, by functional area, will be able to: select tools used for exporting a specific report; set active/inactive on-demand; set a timeframe for report availability (Begin Date, which can be a future date, and End Date); and set the level of aggregation (building, district, ISD, statewide, etc.)." ;
	<urn:solutiondesign:ontology:title> "Per-report admin controls: export tool selection, availability window, aggregation level" .

<urn:solutiondesign:instance:reporting:Req_02_BizSpec_3> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Download and print for STANDARDIZED (catalog-registered) reports are covered by 2.1.6's resolution (native Power BI export/print, satisfied by Op_GenerateEmbedToken/ext:PowerBISystem). 'Save' and the entire 'ad-hoc' half of this bullet are different: rpt:Rule_ReportDefinitionsOwnedOutsideApplication is explicit that report AUTHORING happens in Power BI Desktop outside the application, and rpt:UT_AdHocExploration's own definition draws the line at 'drilldowns, filtering, and data slicing within an embedded report... does NOT mean users can edit report definitions.' Building or saving a genuinely new ad-hoc report from within the MiEdWorkforce portal (as opposed to exploring an already-catalog-registered one) is therefore out-of-scope for Reporting by its own existing, documented design boundary — not a gap, a deliberate exclusion this bullet's phrasing just doesn't spell out as clearly as the technical-design docs do." ;
	<urn:solutiondesign:ontology:requirementId> "2.BizSpec.3" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem given.) The system will allow a user, with a role that has the appropriate report permissions, to do the following with standardized AND ad-hoc reports: download, save, print." ;
	<urn:solutiondesign:ontology:title> "Save, print, and download standardized and ad-hoc reports" .

<urn:solutiondesign:instance:reporting:Req_02_BizSpec_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Out-of-scope for Reporting itself: reporting-capability.ttl's own header note is explicit that Reporting 'owns none of the underlying report data or definitions — those live in Power BI Service and each domain respectively.' Data sourcing/provenance for a given report's dataset is a Power BI dataset-design and source-domain concern (Staffing/Credentialing/etc. each own their own data), not something Reporting's own bounded context builds or models — consistent with, not contradicting, the existing scope note." ;
	<urn:solutiondesign:ontology:requirementId> "2.BizSpec.4" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem given.) MiEdWorkforce will source data for reports using any combination of MDE/CEPI system data, historical data, and data from integrated systems — various data elements (Staffing, Person, Credential) across current and historical date ranges." ;
	<urn:solutiondesign:ontology:title> "Source report data from combined MDE/CEPI, historical, and integrated-system sources" .

<urn:solutiondesign:instance:reporting:Req_02_BizSpec_5> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "Satisfied by design, same resolution as 2.1.6: all of filtering/sorting/column selection/printing/visualization customization/comparative-dataset definition are native, built-in capabilities of an embedded Power BI report once rendered (rpt:UT_AdHocExploration: 'Drilldowns, filtering, and data slicing within an embedded report... possible within embedded reports'); MiEdWorkforce's own obligation is limited to successfully generating the embed token and rendering the report object (Op_GenerateEmbedToken), consistent with Rule_ReportDefinitionsOwnedOutsideApplication's scope boundary (report/visual design happens in Power BI Desktop by the report author, not in this portal). Not a build item for Reporting beyond what's already modeled." ;
	<urn:solutiondesign:ontology:requirementId> "2.BizSpec.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:PowerBISystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Seq_GenerateEmbedTokenHappyPath> ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem given.) The system will allow a user to generate a report with filtering, sorting, add/remove columns and fields, printing, and exporting in a variety of formats; will offer visualization customization (comparative models, anomaly data representation, interactive visuals, sequential color scales, other data visualizations); and will have the ability to define comparative data sets and elements meeting a specific criterion (e.g. comparing academic years, FTE count of teachers year-to-year by district)." ;
	<urn:solutiondesign:ontology:title> "In-report interactivity, visualization customization, and comparative datasets" .

<urn:solutiondesign:instance:reporting:Req_02_BizSpec_6> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:notes> "This is exactly the general domain-owned-PermissionKey gating mechanism reporting-capability.ttl already documents (each report declares one PermissionKey, e.g. a hypothetical staffing.reports.view, checked by IAM before token issuance) — a specific instance of a pattern already fully modeled, not a new capability. The specific staffing.reports.view-equivalent permission itself is staffing's own domain permission to define (not modeled in this file, per reporting-permissions.ttl's own note that domain-owned {domain}.reports.view permissions belong to each referenced domain's own permissions file, not Reporting's)." ;
	<urn:solutiondesign:ontology:requirementId> "2.BizSpec.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:PermissionKeyVO> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Rule_ReportAccessGatedByDomainPermissions> ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem given.) Staffing submission reports are viewable to those with staffing submission roles." ;
	<urn:solutiondesign:ontology:title> "Staffing-submission-role-gated reports" .

<urn:solutiondesign:instance:reporting:Req_08_9_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "MiEdWorkforce does not re-migrate REP/MOECS data already moved into the Warehouse; overlap is handled through agreed integration rules rather than independent migrations." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd08_9DataWarehouseDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.9.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to avoid duplicating historical migration work already performed into the CEPI Data Warehouse so that data remains consistent." ;
	<urn:solutiondesign:ontology:title> "Avoid duplicating historical migration into the CEPI Data Warehouse" .

<urn:solutiondesign:instance:reporting:Req_08_9_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Design allows pulling/calling Warehouse data when needed using agreed secure mechanisms (no payload yet defined); inbound data, if implemented, is validated and logged; no assumption is coded that prevents a future receive capability." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd08_9DataWarehouseDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.9.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want bidirectional integration capabilities with the CEPI Data Warehouse where appropriate so that MiEdWorkforce can consume historical or aggregated data, if required." ;
	<urn:solutiondesign:ontology:title> "Support bidirectional integration with the CEPI Data Warehouse" .

<urn:solutiondesign:instance:reporting:Req_08_9_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Connections use HTTPS and authenticated access as defined (TBD in IDD); configuration separates DEV/UAT/PROD Warehouse endpoints; logs include environment identifiers per transaction." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd08_9DataWarehouseDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.9.4" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want Data Warehouse integrations to be secured and environment-specific so that internal data is protected." ;
	<urn:solutiondesign:ontology:title> "Secure, environment-specific CEPI Data Warehouse integration" .

<urn:solutiondesign:instance:reporting:Req_08_9_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Executes scheduled exports at a CEPI-agreed frequency (TBD, not hard-coded); failed schedules logged with error details; successful runs record counts sent." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd08_9DataWarehouseDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.9.5" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support scheduled data exchanges with the CEPI Data Warehouse so that it receives updated data at agreed intervals." ;
	<urn:solutiondesign:ontology:title> "Support scheduled data exchanges with the CEPI Data Warehouse" .

<urn:solutiondesign:instance:reporting:Req_08_9_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "All send/receive operations logged with timestamp, dataset, environment, and status; error conditions capture response codes/failure reasons; log retention follows MiEdWorkforce integration policy." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd08_9DataWarehouseDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.9.6" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to log all Warehouse-related data transfers so that integration activity is auditable." ;
	<urn:solutiondesign:ontology:title> "Log all CEPI Data Warehouse transfers" .

<urn:solutiondesign:instance:reporting:ResolvedParameters> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The final set of embed parameters supplied to the Power BI API, derived from the user's authorization context and the report's ParameterContract. Snapshotted for audit; never includes the token itself." ;
	<urn:solutiondesign:ontology:name> "ResolvedParameters" .

<urn:solutiondesign:instance:reporting:Rule_NotEveryDashboardIsAPowerBIReport> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:example> "A 'pending applications' count displayed on a credential processor's dashboard is a native UI component pulling from the Credentialing API. A 'credential issuance trends by district over rolling 12 months with demographic breakdown' is a Power BI report." ;
	<urn:solutiondesign:ontology:notes> "Enforced by governance convention (the Reporting catalog team reviews requests before registering new reports) — not a mechanism sd:enforcedBy's Aggregate|Sequence|ApiOperation range can represent, so left unset rather than forced onto an ill-fitting node." ;
	<urn:solutiondesign:ontology:rationale> "Power BI embedding carries infrastructure overhead (workspace management, service principal credentials, token generation latency, licensing considerations). Overusing it for trivial displays degrades maintainability and performance." ;
	<urn:solutiondesign:ontology:statement> "Power BI embedding should be reserved for reports that involve complex data aggregation across domains, multi-dimensional filtering, scheduled refresh from data warehouse sources, or export needs. Simple UI-level statistics, counts, or single-domain summaries should be implemented as native UI components within the relevant domain's portal pages, not as embedded Power BI reports." .

<urn:solutiondesign:instance:reporting:Rule_ParameterContractSatisfiedBeforeIssuance> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:rationale> "Issuing a token without required RLS parameters would cause the report to display unscoped (all) data, violating data access controls enforced inside the report definition." ;
	<urn:solutiondesign:ontology:statement> "All parameters declared as required in a report's ParameterContract must be resolvable from the user's context before a token is issued. If a required parameter cannot be resolved (e.g. a district-scoped report is requested by a user with no district association), token generation is refused." .

<urn:solutiondesign:instance:reporting:Rule_ReportAccessGatedByDomainPermissions> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:Op_CheckPermissions> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:rationale> "Centralizing the permission check in the Reporting capability ensures reports cannot be embedded by unauthorized users even if the client-side catalog is manipulated." ;
	<urn:solutiondesign:ontology:statement> "Each report in the catalog declares a single PermissionKey (e.g. reporting.credentialing-reports.view). Before generating an embed token, the Reporting API checks that the requesting user holds this permission at an appropriate organizational scope. Access is denied if the check fails." .

<urn:solutiondesign:instance:reporting:Rule_ReportDefinitionsOwnedOutsideApplication> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:notes> "Enforced by omission: the Reporting API has no endpoints for modifying Power BI assets; it only reads from them (GET /reports/{reportId} at registration, POST /GenerateToken at token issuance)." ;
	<urn:solutiondesign:ontology:rationale> "Report authoring requires Power BI Pro/Premium licensing and tooling not available in the web portal. Attempting to expose report editing in the UI would require significant licensing and security scope expansion." ;
	<urn:solutiondesign:ontology:statement> "Power BI report definitions (.pbix files, dataset definitions, RLS role configurations) are authored and maintained in Power BI Desktop and published to the Power BI Service. The application does not modify, version, or store report definitions. The application only maintains catalog metadata pointing to a report already published in the service." .

<urn:solutiondesign:instance:reporting:Rule_StandardParameterSet> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:reporting:Op_AdminCreateReport> ;
	<urn:solutiondesign:ontology:notes> "Enforced by governance convention (catalog registration review), not a modelable Aggregate/Sequence/ApiOperation node — reporting-api.yml's adminCreateReport operation does reject non-standard parameter names at the schema level (StandardParameterName enum), so that operation is the closest concrete enforcement point." ;
	<urn:solutiondesign:ontology:rationale> "Consistency enables the application to reliably resolve and pass parameters without per-report custom logic." ;
	<urn:solutiondesign:ontology:statement> "The application defines a canonical set of embed parameter names (UserUniqueId, OrgType, OrgCode, OrgAncestorCodes, UserRole). Report authors must use these exact parameter names when configuring RLS roles in their report definitions. Custom parameter names outside this set are not permitted without a catalog governance review." .

<urn:solutiondesign:instance:reporting:Rule_TokensEphemeralNonTransferable> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:rationale> "Prevents token sharing or URL spoofing. Even if a token were intercepted, it would be short-lived and scoped to specific report parameters." ;
	<urn:solutiondesign:ontology:statement> "Embed tokens are generated on demand for a specific user and report. Tokens are never stored by the application. Token expiry should be short (target: 60 minutes, configurable). Re-rendering a report always requires a fresh token request." .

<urn:solutiondesign:instance:reporting:Seq_BrowseReportCatalog> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant Portal as MiEdWorkforce Portal\n    participant ReportingAPI as Reporting API\n    participant IAM as IAM API\n\n    User->>Portal: Navigate to Reports\n    Portal->>ReportingAPI: GET /reports\n    ReportingAPI->>IAM: POST /permissions/check (batch: all report permission keys)\n    IAM-->>ReportingAPI: Permission results per report\n    ReportingAPI-->>Portal: Filtered report catalog (only reports user is authorized for)\n    Portal-->>User: Report list grouped by domain\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "IAM unavailable > Return 503; do not return partial catalog. Surface error to user. User holds no applicable report permissions > Return empty catalog; do not return 403 (empty state is a valid response, not an error)." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Catalog filtering at API layer: the Reporting API filters the catalog server-side based on permission checks rather than returning the full catalog and relying on the client to hide unauthorized entries, preventing information leakage about the existence of reports the user cannot access. Batch permission check: to avoid N+1 IAM calls (one per report), the Reporting API batches all permission key checks in a single IAM request." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Browse Report Catalog" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: A user views the list of reports available to them, filtered to only those they are authorized to access. When: User navigates to the Reports section of the MiEdWorkforce Portal. Who: Any authenticated portal user." .

<urn:solutiondesign:instance:reporting:Seq_DeactivateReport> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant Portal as MiEdWorkforce Portal\n    participant ReportingAPI as Reporting API\n\n    Admin->>Portal: Select report in catalog admin\n    Admin->>Portal: Deactivate report\n    Portal->>ReportingAPI: PATCH /admin/reports/{reportDefinitionId}/status (Inactive)\n\n    ReportingAPI->>ReportingAPI: Update status: Active > Inactive\n    Note over ReportingAPI: Existing embed tokens issued before deactivation remain valid until natural expiry\n\n    ReportingAPI-->>Portal: 200 OK\n    Portal-->>Admin: \"Report deactivated. No longer visible in portal.\"\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Report already inactive > Return 409 Conflict with message." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Deactivation does not invalidate outstanding tokens: tokens already in flight (issued but not yet expired) remain valid since the Power BI Service is not notified. Acceptable given the short token expiry window — revoking active tokens would require a Power BI API call per active session, a disproportionate cost for a non-emergency deactivation." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Deactivate Report" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: An admin removes a report from portal visibility. The Power BI report definition is unaffected. When: A report is retired, replaced, or temporarily pulled from the portal. Who: System Admin with reporting.catalog.manage permission." .

<urn:solutiondesign:instance:reporting:Seq_GenerateEmbedTokenAccessDenied> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant Portal as MiEdWorkforce Portal\n    participant ReportingAPI as Reporting API\n    participant IAM as IAM API\n\n    User->>Portal: Select report (or direct URL access)\n    Portal->>ReportingAPI: POST /reports/{reportId}/embed-token\n\n    ReportingAPI->>IAM: POST /permissions/check (report's permissionKey, user, scope)\n    IAM-->>ReportingAPI: Authorized: false\n\n    ReportingAPI->>ReportingAPI: Persist EmbedTokenRequest audit record\n    Note over ReportingAPI: outcome: Denied, denialReason: InsufficientPermission\n\n    ReportingAPI-->>Portal: 403 Forbidden\n    Portal-->>User: Access denied message\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Permission check fails > 403 Forbidden; audit record persisted with outcome Denied, denialReason InsufficientPermission." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Generate Embed Token and View Report - Access Denied - Permission Check Fails" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: A user selects a report and the system validates their authorization, resolves organizational context parameters, generates a Power BI embed token, and returns it to the portal for rendering. Scenario: user does not hold the report's declared permission, or the report is not in the catalog. When: User selects a specific report from the catalog (or accesses it via a direct URL). Who: Any authenticated portal user." .

<urn:solutiondesign:instance:reporting:Seq_GenerateEmbedTokenHappyPath> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant Portal as MiEdWorkforce Portal\n    participant ReportingAPI as Reporting API\n    participant IAM as IAM API\n    participant OrgAPI as Organizations API\n    participant PowerBI as Power BI Service API\n\n    User->>Portal: Select report\n    Portal->>ReportingAPI: POST /reports/{reportId}/embed-token\n\n    ReportingAPI->>IAM: POST /permissions/check (report's permissionKey, user, scope)\n    IAM-->>ReportingAPI: Authorized: true, orgScope: { type: District, code: 12345 }\n\n    ReportingAPI->>OrgAPI: GET /organizations/12345/hierarchy\n    OrgAPI-->>ReportingAPI: Org metadata + ancestor chain\n\n    ReportingAPI->>ReportingAPI: Resolve embed parameters against ParameterContract\n    Note over ReportingAPI: UserUniqueId, OrgType, OrgCode, OrgAncestorCodes resolved\n\n    ReportingAPI->>PowerBI: POST /GenerateToken (workspaceId, reportId, resolved params)\n    PowerBI-->>ReportingAPI: Embed token + expiry\n\n    ReportingAPI->>ReportingAPI: Persist EmbedTokenRequest audit record (no token stored)\n    Note over ReportingAPI: outcome: Granted, resolvedParameters snapshot, expiresAt\n\n    ReportingAPI-->>Portal: { embedToken, embedUrl, expiresAt }\n    Portal-->>User: Render embedded Power BI report\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Power BI API timeout or error > Return 502 to portal; log audit record with failure reason; surface user-friendly error ('Report temporarily unavailable')." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Parameter resolution before Power BI call: all ParameterContract requirements are validated locally before calling the Power BI API — a failed resolution causes a 400/403 response without consuming a Power BI API call. Org hierarchy for transitive scoping: OrgAncestorCodes is resolved from the Organizations API to allow reports to support transitive org filtering (e.g. an ISD user sees data for all constituent districts). Token not persisted: only audit metadata is stored; the token string itself is never written to the database." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Generate Embed Token and View Report - Happy Path" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: A user selects a report and the system validates their authorization, resolves organizational context parameters, generates a Power BI embed token, and returns it to the portal for rendering. Scenario: user holds required permission at an appropriate scope; all required parameters can be resolved. When: User selects a specific report from the catalog. Who: Any authenticated portal user who holds the report's declared permission." .

<urn:solutiondesign:instance:reporting:Seq_GenerateEmbedTokenParameterResolutionFailure> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant Portal as MiEdWorkforce Portal\n    participant ReportingAPI as Reporting API\n    participant IAM as IAM API\n\n    User->>Portal: Select report\n    Portal->>ReportingAPI: POST /reports/{reportId}/embed-token\n\n    ReportingAPI->>IAM: POST /permissions/check (permissionKey, user, scope)\n    IAM-->>ReportingAPI: Authorized: true, orgScope: { type: System }\n\n    ReportingAPI->>ReportingAPI: Attempt to resolve ParameterContract\n    Note over ReportingAPI: OrgCode required; cannot resolve from System-level scope\n\n    ReportingAPI->>ReportingAPI: Persist EmbedTokenRequest audit record\n    Note over ReportingAPI: outcome: Denied, denialReason: ParameterResolutionFailure\n\n    ReportingAPI-->>Portal: 400 Bad Request (required parameter unresolvable)\n    Portal-->>User: \"This report requires an organizational context. Select a district or ISD to continue.\"\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Required parameter unresolvable (e.g. OrgCode required, caller is System-scoped) > 400 Bad Request; audit record persisted with outcome Denied, denialReason ParameterResolutionFailure." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Generate Embed Token and View Report - Access Denied - Required Parameter Cannot Be Resolved" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: A user selects a report and the system validates their authorization, resolves organizational context parameters, generates a Power BI embed token, and returns it to the portal for rendering. Scenario: user holds the permission but cannot be scoped to the required organizational context (e.g. a system-level user requesting a district-scoped report without a district in context). When: User selects a specific report from the catalog. Who: Any authenticated portal user who holds the report's declared permission but lacks the required org context." .

<urn:solutiondesign:instance:reporting:Seq_RegisterReportInCatalog> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant Portal as MiEdWorkforce Portal\n    participant ReportingAPI as Reporting API\n    participant PowerBI as Power BI Service API\n\n    Admin->>Portal: Open Report Catalog admin screen\n    Admin->>Portal: Fill in report metadata (name, domain, permissionKey, workspaceId, reportId, parameterContract)\n    Portal->>ReportingAPI: POST /admin/reports\n\n    ReportingAPI->>PowerBI: GET /reports/{reportId} (validate report exists in workspace)\n    PowerBI-->>ReportingAPI: Report metadata confirmed\n\n    ReportingAPI->>ReportingAPI: Validate ParameterContract (all parameter names are standard)\n    ReportingAPI->>ReportingAPI: Create ReportDefinition with status: Inactive\n\n    ReportingAPI-->>Portal: { reportDefinitionId, status: Inactive }\n    Portal-->>Admin: \"Report registered. Set status to Active to make it visible in the portal.\"\n\n    Note over Admin,Portal: Admin reviews, then activates separately\n    Admin->>Portal: Activate report\n    Portal->>ReportingAPI: PATCH /admin/reports/{reportDefinitionId}/status (Active)\n    ReportingAPI->>ReportingAPI: Update status: Inactive > Active\n    ReportingAPI-->>Portal: 200 OK\n    Portal-->>Admin: Report is now live in the catalog\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Power BI workspace/report ID not found > Return 422 with message 'Power BI report not found in specified workspace. Verify workspaceId and reportId.' Non-standard parameter name in contract > Return 400; list disallowed parameter names." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Register then activate pattern: new reports default to Inactive so admins can verify catalog metadata before making the report visible to users, decoupling registration from publication. Power BI validation at registration: confirming the report exists in the workspace at registration time (not at token generation time) surfaces configuration errors early." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Register Report in Catalog" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: An administrator registers a new Power BI report in the application catalog, making it available for embedding once activated. When: A new report has been published to the Power BI Service and is ready to be surfaced in the portal. Who: System Admin with reporting.catalog.manage permission." .

<urn:solutiondesign:instance:reporting:SequencesDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "sequences" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/reporting/reporting-sequences.md" .

<urn:solutiondesign:instance:reporting:TP_EmbedTokenGeneration> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:implementationNotes> "The GenerateToken request is made using the service principal credential stored in Azure Key Vault, accessed via managed identity — the client never receives or uses the service principal credential. The call is server-to-server: POST https://api.powerbi.com/v1.0/myorg/groups/{workspaceId}/reports/{reportId}/GenerateToken with accessLevel 'View' and an identities block whose username maps to UserUniqueId and roles maps to the RLS role name configured in the Power BI report definition (a static string per report, agreed in the ParameterContract). Additional filter parameters (OrgCode, OrgType, OrgAncestorCodes) are passed as effective identity filters, not separate API fields — the exact mechanism depends on the report's dataset connectivity mode (Import/DirectQuery/Live Connection/Composite; Import is the expected default for MiEdWorkforce, given data-freshness requirements for most reports — DirectQuery may be considered for near-real-time needs if performance testing supports it). Licensing SKU (Embedded A-SKU vs. Premium P-SKU vs. Per-User Pro) affects available GenerateToken behavior/features — see rpt:Question_PowerBILicensingModel. Token expiry target is 60 minutes; the client should proactively refresh at expiresAt minus 10 minutes using the Power BI JS SDK's token-update API (setAccessToken) rather than a full re-render — see rpt:Question_TokenRefreshSDKSupport. Security: the service-principal credential string is never in application configuration files, environment variables, or logs; the embed token itself is scoped by Power BI to a specific workspaceId/reportId (rejected if used against a different report) and its resolved parameters are always derived server-side from the authenticated session and IAM authorization context — POST /reports/{reportId}/embed-token does not accept raw parameter values from the caller (the only client input is the report ID from the URL path, plus the optional, IAM-validated orgContext override), which is what prevents parameter spoofing (a district user cannot pass a different OrgCode, and a user cannot elevate UserRole beyond what IAM resolves). Every token request (granted or denied) is written to EMBED_TOKEN_REQUESTS, never including the token string itself, for forensic/audit review." ;
	<urn:solutiondesign:ontology:references> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:steps> "1. Load ReportDefinition from catalog. 2. If report doesn't exist or isn't Active, 404. 3. Check user permission via IAM API (permissionKey declared on report); if unauthorized, 403 and audit Denied/InsufficientPermission. 4. Retrieve user's org scope from IAM authorization context. 5. Fetch org hierarchy from Organizations API if OrgCode is in the ParameterContract. 6. Resolve all ParameterContract fields against user + org context. 7. If any required parameter is unresolved, 400 and audit Denied/ParameterResolutionFailure. 8. Call Power BI REST API GenerateToken with resolved params. 9. If the Power BI call fails, 502 and log the error. 10. Write EmbedTokenRequest audit record (no token stored). 11. Return embedToken + embedUrl + expiresAt." ;
	<urn:solutiondesign:ontology:title> "Power BI Embed Token Generation" .

<urn:solutiondesign:instance:reporting:TP_ParameterResolution> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:implementationNotes> "Standard parameters and their resolution: UserUniqueId (UserContext, Mi-Key Unique ID from the authenticated user's identity token), OrgType (OrgContext, District|ISD|System), OrgCode (OrgContext, primary org code from the user's scoped authorization), OrgAncestorCodes (OrgContext + Organizations API, ancestor org codes from the materialized hierarchy fetched using OrgCode — see rpt:Question_OrgAncestorCodesCaching on whether this should be pre-computed/cached instead of fetched fresh per request), UserRole (UserContext, the user's highest-ranking role within the report's domain, derived from IAM authorizations). Adding a new parameter outside this standard set requires a catalog governance review and a defined, general-purpose resolution source usable by multiple reports — one-off, per-report custom resolution logic is not permitted (this is rpt:Rule_StandardParameterSet's enforcement mechanism at the technical-design level)." ;
	<urn:solutiondesign:ontology:references> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:steps> "For each parameter declared in the report's ParameterContract: if resolutionSource is UserContext, read the value from JWT claims/IAM user session (UserUniqueId, UserRole). If resolutionSource is OrgContext, use the already-resolved OrgCode (or read the primary org scope from the IAM authorization response if not yet resolved); if the parameter is specifically OrgAncestorCodes, call GET /organizations/{OrgCode}/hierarchy and flatten the ancestor chain to CSV, otherwise use OrgCode/OrgType directly. If the parameter is_required and its resolved value is null, fail with ParameterResolutionFailure; otherwise add it to the resolved parameter set. Repeat until every declared parameter has been processed, then return the resolved set." ;
	<urn:solutiondesign:ontology:title> "Standard Parameter Contract Resolution" .

<urn:solutiondesign:instance:reporting:TechnicalDesignDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "technical-design" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/reporting/reporting-technical-design.md" .

<urn:solutiondesign:instance:reporting:TokenMetadata> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Expiry time and token status (not the token itself — tokens are never persisted)." ;
	<urn:solutiondesign:ontology:name> "TokenMetadata" .

<urn:solutiondesign:instance:reporting:UT_AdHocExploration> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Drilldowns, filtering, and data slicing within an embedded report. This is possible within embedded reports. It does NOT mean users can edit report definitions — that requires a Power BI license and is out of scope for the portal." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Ad Hoc Exploration" .

<urn:solutiondesign:instance:reporting:UT_EmbedToken> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A short-lived, signed token issued by the Power BI API that authorizes rendering a specific report in a browser session. Tokens are generated on demand, are non-transferable, and expire quickly." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Embed Token" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> .

<urn:solutiondesign:instance:reporting:UT_ParameterContract> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The declared set of embed parameters a report accepts, including which are required vs. optional and how they map to RLS roles or filters within the report definition. Agreed upon between the application team and the report author." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Parameter Contract" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> .

<urn:solutiondesign:instance:reporting:UT_RLS> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#altLabel> "RLS" ;
	<http://www.w3.org/2004/02/skos/core#definition> "A Power BI feature allowing a report definition to filter data based on parameters or roles supplied at embed time. Used to scope district or ISD users to their organizational data." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Row-Level Security (RLS)" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:reporting:EmbedTokenRequestAggregate> .

<urn:solutiondesign:instance:reporting:UT_Report> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A Power BI report definition hosted in the Power BI Service. The application does not own or modify report definitions — it only embeds them." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Report" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> .

<urn:solutiondesign:instance:reporting:UT_ReportCatalog> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The application-managed registry of reports available for embedding, including metadata, domain association, and parameter contracts. Not all Power BI reports in the workspace are necessarily in the catalog." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Report Catalog" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> .

<urn:solutiondesign:instance:reporting:Wireframe1> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Report Management' admin screen — Search box, 'Add Report' button, filter icon, and a table (Report Name/Category/Added Date/[unlabeled columns]/Status) of Active reports, paginated (footer shows '1-10 of 6115 items' — a placeholder/sample row count, not a real figure). Directly corroborates 2.1.1's admin management interface and 2.1.2's Add Report entry point." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/02-reporting/wireframes/wireframe-01-admin-report-management-list.jpg" .

<urn:solutiondesign:instance:reporting:Wireframe2> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing (two highlight variants, image4 and image5, same underlying screen): 'New Report' form — Report Details panel (Report Name text field, Report Description textarea with a 255-char counter, a single free-text 'Power BI Link' URL field populated with a placeholder http://www.maspa.org, a 'Workspace' dropdown) and an Availability panel (Role / Category / Sub-Category / Status dropdowns, Status defaulting to Active), with Cancel/Preview/Add Report actions. See Question_ReportFormShapeVsModeledAggregate below — this shape does not match rpt:ReportDefinitionAggregate's modeled fields." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/02-reporting/wireframes/wireframe-02-new-report-form.jpg" .

<urn:solutiondesign:instance:reporting:Wireframe3> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a report row's context (kebab) menu, showing exactly two options — 'Deactivate' and 'Delete Report'. Deactivate matches 2.1.3/rpt:Op_AdminUpdateReportStatus well; Delete Report has no corresponding story, acceptance criterion, or modeled API operation anywhere (reporting-api.yml has no DELETE /admin/reports/{id}). See Question_WireframeOnlyFeaturesNotInStories below." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/02-reporting/wireframes/wireframe-03-row-menu-deactivate-delete.jpg" .

<urn:solutiondesign:instance:reporting:Wireframe4> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the end-user functional-area navigation menu (School Name context switcher; Personnel Search, Employment Management, Credential Management [expanded: Permits, Renew Daily Substitutes, Career Authorizations, Special Education Approvals, Unpaid Applications, Reports], Professional Learning, Education Prep, Professional Practices, User Management). Directly corroborates 2.1.5's primary-functional-area-menu acceptance criterion, and shows 'Reports' as one leaf item within a functional area's own expanded menu (not a single global 'Reports' top-level entry) — consistent with the report catalog being scoped per functional area rather than centralized." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/02-reporting/wireframes/wireframe-04-functional-area-nav-menu.jpg" .

<urn:solutiondesign:instance:reporting:Wireframe5> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing (two highlight variants, image12 and image15, same underlying screen): a 'Credential Reports > [Category] Reports' breadcrumb-and-list screen (Dashboard > Credential Management > Credential Reports > [Category] Reports), with 'All Reports'/'Favorite Reports' tabs, a search box, and a list of Report Name rows each with a star (favorite) icon. Directly corroborates 2.1.5's three-level functional-area > subcategory > report-list navigation. The 'Favorite Reports' tab and per-report star/favorite affordance has no corresponding story or acceptance criterion anywhere in this FDD — see Question_WireframeOnlyFeaturesNotInStories below." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/02-reporting/wireframes/wireframe-05-category-report-list-favorites.jpg" .

<urn:solutiondesign:instance:reporting:Wireframe6> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:reporting:Fdd02Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the terminal 'Report Name' screen with a large placeholder panel labeled 'Power BI' where the embedded report renders — the endpoint of 2.1.5's navigation flow, consistent with rpt:Op_GenerateEmbedToken's role." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/02-reporting/wireframes/wireframe-06-embedded-report-placeholder.jpg" .

<urn:solutiondesign:instance:shared:scope:AssignedOnly> a <urn:solutiondesign:ontology:PermissionScope> ;
	<urn:solutiondesign:ontology:isStandard> true ;
	<urn:solutiondesign:ontology:label> "Assigned-only" ;
	<urn:solutiondesign:ontology:notes> "Narrower than any org-hierarchy scope: limits visibility to work items individually assigned to the holder (e.g. a specific processor's worklist), not everything within an org unit. See credentialing-domain.md Open Question #34 — this scope implies an assignment/queue concept that doesn't fully exist in the domain model yet." ;
	<urn:solutiondesign:ontology:order> 60 .

<urn:solutiondesign:instance:shared:scope:District> a <urn:solutiondesign:ontology:PermissionScope> ;
	<urn:solutiondesign:ontology:broaderScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:isStandard> true ;
	<urn:solutiondesign:ontology:label> "District" ;
	<urn:solutiondesign:ontology:order> 30 .

<urn:solutiondesign:instance:shared:scope:Entity> a <urn:solutiondesign:ontology:PermissionScope> ;
	<urn:solutiondesign:ontology:broaderScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:isStandard> true ;
	<urn:solutiondesign:ontology:label> "Entity" ;
	<urn:solutiondesign:ontology:order> 20 .

<urn:solutiondesign:instance:shared:scope:ISD> a <urn:solutiondesign:ontology:PermissionScope> ;
	<urn:solutiondesign:ontology:broaderScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:isStandard> true ;
	<urn:solutiondesign:ontology:label> "ISD" ;
	<urn:solutiondesign:ontology:order> 40 .

<urn:solutiondesign:instance:shared:scope:SelfOnly> a <urn:solutiondesign:ontology:PermissionScope> ;
	<urn:solutiondesign:ontology:isStandard> true ;
	<urn:solutiondesign:ontology:label> "Self-only" ;
	<urn:solutiondesign:ontology:order> 50 .

<urn:solutiondesign:instance:shared:scope:SystemWide> a <urn:solutiondesign:ontology:PermissionScope> ;
	<urn:solutiondesign:ontology:isStandard> true ;
	<urn:solutiondesign:ontology:label> "System-wide" ;
	<urn:solutiondesign:ontology:order> 10 .

<urn:solutiondesign:instance:solution:MiEdWorkforce> a <urn:solutiondesign:ontology:Solution> ;
	<urn:solutiondesign:ontology:displayName> "MiEdWorkforce" ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:audit:AuditContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:dashboards:DashboardsContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:dataquality:DataQualityContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:documents:DocumentsContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:proflearning:ProfessionalLearningContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:publicportal:PublicPortalContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:questionsets:QuestionSetContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:refdata:ReferenceDataContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:reporting:ReportingContext> ;
	<urn:solutiondesign:ontology:hasBoundedContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:nonFunctionalRequirement> "Data covered by 'historical records' views (certificates, permits, endorsements, documents, enrollment, conviction, demographic/employment/education info) must be retained per the State of Michigan's State Retention Policy (FDD 11,16, Feature 16.4.1). The specific retention schedule/duration isn't stated in this FDD — see Question_StateRetentionPolicyUndefined." ;
	<urn:solutiondesign:ontology:notes> "Michigan Department of Education educator workforce platform. mied-v3 is the third-pass conversion: full-depth SDD ingestion (business rules, technical-design, Annotations, v0.5 ontology features) for all 11 real domains, followed by FDD-vs-graph traceability review (see fdd-review/ once Phase 2 begins). Solution data lives in one file (solution/MiEdWorkforce.ttl), generated by the Solution Design Editor's Save — it excludes the ontology and SHACL shapes (schema, not project data; see ontology/solution-design.ontology.ttl and shapes/solution-design.shapes.ttl) and does not preserve '#' comments on save, since RDF has no comment in its data model. Put rationale that needs to survive a save on the relevant node itself, as sd:notes or an sd:Annotation, not as a file-header comment." .

