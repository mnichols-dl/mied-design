<urn:solutiondesign:instance:staffing:EmployeeRosterAdditionAttemptedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Stub — see staffing-domain.md (converted separately in this same batch, may not match exactly). profpractice-domain.md's own Upstream table lists this event OR a synchronous API call as alternative mechanisms; only the event-subscription side is modeled as a Dependency here since no synchronous staffing status-check endpoint is named in either domain's source docs." ;
	<urn:solutiondesign:ontology:payloadHighlights> "educatorId, districtId, attemptedAt" ;
	<urn:solutiondesign:ontology:trigger> "District HR attempts to add an educator to an employment roster" .

<urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Manages the annual collection of employed individuals for an educational organization, tracking employment lifecycle from hire through termination." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:DemographicDataUpdatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:EmployeeAddedToRosterEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:EmploymentStatusChangedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:EvaluationOutcomeRecordedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:NewTeacherMentorAssignedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:EducationHistory> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:EmployeeRecord> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:EvaluationOutcome> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:NewTeacherMonitoring> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:EmpRosterState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:EmpRosterState_Certified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:EmpRosterState_Error> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:EmpRosterState_Pending> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:EmploymentSeparationReason> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:EmploymentStatus> ;
	<urn:solutiondesign:ontology:invariants> "Employment Start Date must be on or before current date (no future hires). Employment End Date must follow Employment Start Date. Employment End Date and Separation Reason must both be present or both absent. Employee cannot be re-added to same district without new Employment Start Date if previously terminated. Active employment status requires at least one active assignment in Assignment Details. New Teacher flag set to true requires New Teacher Monitoring component completion before certification. Evaluation Outcome required for instructional staff and administrators before certification. Identity resolution is not owned here: when an employee record has no Unique ID or its demographics change, this aggregate triggers identity resolution by calling iam's IdentityResolutionRequest API (or, for Link ID, submits a link request) and waits for a completion event (IdentityResolutionCompleted, IdentityRequestDenied, PersonRecordUpdated) to populate/update unique_id. EmployeeRoster holds no Near Match state, matching candidates, or Identity Administrator worklist of its own — see iam-domain.ttl (real, converted in this same mied-v3 pass)." ;
	<urn:solutiondesign:ontology:notes> "See iam-sequences.md (not yet converted into mied-v3) for the identity-resolution sequences this aggregate triggers into: 'Business User - Request New ID (Near Match Escalation)', 'Business User - Request Link ID', 'Identity Administrator - Resolve Identity Request', and 'Identity Resolution - Split/Retire ID (Mi-Key-Direct)'." ;
	<urn:solutiondesign:ontology:rootEntity> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:EmploymentSeparationReason> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Retirement, Budgetary Reduction, Misconduct, Resignation, Contract Non-Renewal, Deceased, Transfer, or Other." ;
	<urn:solutiondesign:ontology:name> "EmploymentSeparationReason" .

<urn:solutiondesign:instance:staffing:EmploymentStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Contractual, Probationary, Substitute/Temporary, Tenured, or Leave." ;
	<urn:solutiondesign:ontology:name> "EmploymentStatus" .

<urn:solutiondesign:instance:staffing:EmploymentStatusChangedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "entityCode, uniqueId, oldStatus, newStatus, effectiveDate, separationReason?" ;
	<urn:solutiondesign:ontology:trigger> "Employment status updated (e.g., termination)" .

<urn:solutiondesign:instance:staffing:EvaluationOutcome> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Annual performance assessment with scale and outcome value, appealable by both employee and district within defined windows." ;
	<urn:solutiondesign:ontology:name> "EvaluationOutcome" .

<urn:solutiondesign:instance:staffing:EvaluationOutcomeRecordedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "uniqueId, entityCode, schoolYear, evaluationScale, outcome" ;
	<urn:solutiondesign:ontology:trigger> "District submits evaluation outcome" .

<urn:solutiondesign:instance:staffing:ExceptionRequest> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Entity, collection, justification, requested extension dates." ;
	<urn:solutiondesign:ontology:name> "ExceptionRequest" .

<urn:solutiondesign:instance:staffing:ExceptionState_Approved> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Approved" .

<urn:solutiondesign:instance:staffing:ExceptionState_Denied> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Denied" .

<urn:solutiondesign:instance:staffing:ExceptionState_Pending> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Pending" .

<urn:solutiondesign:instance:staffing:ExceptionStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Pending, Approved, or Denied." ;
	<urn:solutiondesign:ontology:name> "ExceptionStatus" .

<urn:solutiondesign:instance:staffing:Fdd08_1EemDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "REST API (Bearer Token) integration spec against CEPI.PublicServices/api/EntityInformation/{method}. 6 review comments, all editorial TBD-field nagging plus one dead-link fix — no requirement-level content." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.1 - EEM Interface/8.1 - EEM Interface IDD.docx" .

<urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "33 review comments (by far the most of any sub-document in this folder) — most are 'reasonable use case for the API'/'values provided'/'endpoint added' resolution notes on the HIGH LEVEL SCENARIOS table's 20 Ed-Fi Identities API use cases (skipped per CONVENTIONS.md as duplicative of the Addendum, same as every other FDD's HLS table). Two threads are substantive and modeled as standalone Annotations below: a live data-flow-direction dispute (Question_DataHubFlowDirectionDisputed) and an unresolved Mi-Key-vs-MiEdWorkforce ownership question (Question_DataHubMiKeyOwnershipUnconfirmed). A third comment ('Potential to source from CTEIS in the future, but not initial use case') confirms the Career-Cluster/CIP-Code fields in the HLS table are explicitly future/deferred, not part of the current 8.4.1-8.4.5 Addendum scope." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.4 - Data Hub/8.4 - Data Hub IDD.docx" .

<urn:solutiondesign:instance:staffing:Fdd08_5CteisDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "8 review comments, editorial (scheduling/volume TBDs, one confirmed at '1000 to 2000 requests a day in prod'). Explicitly states its own three methods (GetPersonnelByDistrict/PIC/CoreFields) 'are the same set of service endpoints that will be used by many of the other integrations including MSDS/TSDL, MEGS+, NexSys and potentially others... based on the existing set of REP services' — see the consolidated coverage-gap Annotation below, which treats CTEIS/NexSys/MSDS-TSDL's personnel-lookup stories as ONE missing capability rather than three independent gaps, per this self-declared overlap." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.5 - CTEIS Interface/8.5 - CTEIS Interface IDD.docx" .

<urn:solutiondesign:instance:staffing:Fdd08_6NexSysDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "0 review comments." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.6 - NexSys/8.6 - NexSys IDD.docx" .

<urn:solutiondesign:instance:staffing:Fdd08_7MsdsTsdlDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "4 review comments, editorial TBD-field nagging only." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.7 - MSDS-TSDL Interface/8.7 - MSDS(TSDL) IDD.docx" .

<urn:solutiondesign:instance:staffing:Fdd08_8SecureSiteDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "0 review comments. Shortest, most self-aware doc in the folder: it explicitly states the historical REP-Secure Site connection is deprecated/no-longer-used, and that no active outbound interface is being built now — only that MiEdWorkforce's data model should not preclude one later." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.8 - Secure Site/8.8 - Secure Site IDD.docx" .

<urn:solutiondesign:instance:staffing:Fdd10Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Author Caitlin Groom (CEPI); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/04/2025 per the signoff table — but the comments.xml thread contains dated entries through 2026-04-28 (well after signoff), meaning the document continued to be actively revised after its nominal approval date, same pattern the FDD 29 pass already flagged for its own document. Not resolved here; noted so the signoff table isn't read as 'nothing changed after this.'" ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/10 - Data Collection & Compliance - Staffing Admin/10 - Data Collection & Compliance Staffing Admin.docx" .

<urn:solutiondesign:instance:staffing:Fdd10ValidationsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Companion reference spreadsheet: ~150 individual field/record/collection-level validation rules (Sheet1, ID Validations, Rule Types, REP BRs sheets), many inherited verbatim from the legacy MORE system's fixed-width REP file-layout rules. Not re-ingested as individual sd:Requirement instances here — staffing-technical-design.ttl's staff:TP_ValidationRuleEngine already cites this exact file by name and describes its rule categories and open technical questions (staff:Question_LegacyValidationPortVsRederive, staff:Question_CrossRecordValidationEvaluationModel, staff:Question_AnomalyDetectionBaselineAndThreshold) in detail; treated here purely as corroborating evidence for Req_10_3_1/Req_10_13_1/Req_10_13_2's severity vocabulary (Error/Warning/Data Quality, an exact match to this spreadsheet's own 'Fatal Error/Error/Warning' and 'QR Error'/'DQ' columns)." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/10 - Data Collection & Compliance - Staffing Admin/Staffing Submission Validations.xlsx" .

<urn:solutiondesign:instance:staffing:Fdd18Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers the Position Roster epic (18.0). Author Caitlin Groom (CEPI); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/04/2025 per the signoff table — but comments.xml contains entries dated through 2026-03-10, well after that signoff date, meaning the document (specifically its Addendum) continued to be actively revised after nominal approval, same pattern FDD 29 documented." ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied-fdds/functional-design-docs/18 - Data Collection & Compliance - Roster of Positions/18 - Collection & Compliance - Position Roster.docx" .

<urn:solutiondesign:instance:staffing:Fdd21Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
