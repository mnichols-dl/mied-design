<urn:solutiondesign:instance:epp:ApprovalApplicationDeniedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "approvalApplicationId, eppCode, denialDate, remarks" ;
	<urn:solutiondesign:ontology:trigger> "EPP denies approval application" .

<urn:solutiondesign:instance:epp:ApprovalApplicationRecommendedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "approvalApplicationId, eppCode, recommendationDate, remarks" ;
	<urn:solutiondesign:ontology:trigger> "EPP recommends approval application" .

<urn:solutiondesign:instance:epp:ApprovalApplicationReviewAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "EPP's review of alternative route approval applications (temporary permits, alternative certifications), originating from an ISD/school district. Distinct workflow from standard credential applications: recommendation and denial both return the application to the originating ISD/School District rather than proceeding directly to state approval." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:ApprovalApplicationDeniedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:ApprovalApplicationRecommendedEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:AarState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:AarState_Denied> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:AarState_RecommendedByEPP> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:AarState_Submitted> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:ApplicationAcknowledgements> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:ApprovalCategory> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:ApprovalType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:ProfessionalPracticeAnswers> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:ReviewRemark> ;
	<urn:solutiondesign:ontology:invariants> "Denial requires Remarks to be provided (Business Rule: 'Approval Application Denial Returns to ISD'). Conviction flag requires manual EPP review before recommendation, surfaced as the same red-font UI indicator pattern as credential applications (not a hard system block). Recommended approvals return to the ISD/School District for further action, not directly to state approval. Approval Type must be valid for the selected Approval Category." ;
	<urn:solutiondesign:ontology:rootEntity> "ApprovalApplicationReview" .

<urn:solutiondesign:instance:epp:ApprovalCategory> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Type of approval: Teacher, Administrator, Other, Out-of-State Special Ed Admin, Out-of-State School Social Worker, Permit." ;
	<urn:solutiondesign:ontology:name> "ApprovalCategory" .

<urn:solutiondesign:instance:epp:ApprovalType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Specific approval type within the selected category." ;
	<urn:solutiondesign:ontology:name> "ApprovalType" .

<urn:solutiondesign:instance:epp:ApprovedCertificateCategory> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Certificate type/pathway approval with MDE approval date, enrollment close date, and recommend close date." ;
	<urn:solutiondesign:ontology:name> "ApprovedCertificateCategory" .

<urn:solutiondesign:instance:epp:ApprovedEndorsement> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Specific endorsement the EPP can offer/recommend, by certificate type, with its own approval/close dates." ;
	<urn:solutiondesign:ontology:name> "ApprovedEndorsement" .

<urn:solutiondesign:instance:epp:BulkUploadCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "bulkUploadJobId, eppCode, status, processedCount, errorCount, errorReportUrl" ;
	<urn:solutiondesign:ontology:trigger> "Synapse pipeline reports final status (Success/PartialSuccess/Failed) of a bulk candidate-tracking upload job" .

<urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks a candidate's journey through an EPP program from initial enrollment submission through program completion or exit. A candidate can have enrollments at multiple EPPs simultaneously (Open Question #2: whether cross-EPP conflicts should be detected/prevented is unresolved)." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:BulkUploadCompletedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:CandidateEnrollmentRejectedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:CandidateEnrollmentVerifiedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:CandidateExitedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:CandidateStatusChangedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:epp:EnrollmentProgram> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_Enrolled> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_Exited> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_Inactive> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_PendingVerification> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_PlacedAlt> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_PostStudentTeachingTrad> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_Rejected> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EnrState_StudentTeachingTrad> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:EnrollmentStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:ExitInformation> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:StudentID> ;
	<urn:solutiondesign:ontology:invariants> "A candidate must have at least one Program associated when status is Student Teaching (Trad) or Placed (Alt) (Business Rule: 'Candidate Program Assignment Required for Placement Status'). Cannot add duplicate programs (same Program + Grade Band combination) (Business Rule: 'Duplicate Program Prevention'). Enrollment Start Date required for status transition from Rejected to Enrolled. Candidate can have enrollments at multiple EPPs simultaneously. Status transitions must follow a valid state machine, and the valid status SET is itself route-restricted per FDD 25.2.4/25.2.5 (Business Rule: 'Enrollment Status State Machine'): Traditional route allows Enrolled, Student Teaching (Trad), Post Student Teaching (Trad), Inactive, Rejected, Exited (no Placed (Alt)); Alternative route allows Enrolled, Placed (Alt), Inactive, Rejected, Exited (no Student Teaching (Trad)/Post Student Teaching (Trad)). Open Question #1 (partially resolved): the exact transition ordering/graph within each route beyond the valid status sets above is still unspecified by either FDD." ;
	<urn:solutiondesign:ontology:notes> "BulkUploadJob (from epp-domain.md's ERD, not listed among 'Core Aggregates') is a supporting record for the Bulk Upload Candidate Tracking Data sequence — tracks async Synapse pipeline job status (Pending/Processing/Success/PartialSuccess/Failed) and produces/updates CandidateEnrollment records; not modeled here as its own sd:Aggregate. Open Question #7 (retention policy for enrollment records after exit/completion) is unresolved." ;
	<urn:solutiondesign:ontology:rootEntity> "CandidateEnrollment" .

<urn:solutiondesign:instance:epp:CandidateEnrollmentRejectedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "candidateId, eppCode, rejectionDate" ;
	<urn:solutiondesign:ontology:trigger> "EPP rejects enrollment" .

<urn:solutiondesign:instance:epp:CandidateEnrollmentVerifiedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "candidateId, eppCode, programLevel, programType, enrollmentDate" ;
	<urn:solutiondesign:ontology:trigger> "EPP accepts enrollment" .

<urn:solutiondesign:instance:epp:CandidateExitedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "candidateId, eppCode, exitDate, exitReason" ;
	<urn:solutiondesign:ontology:trigger> "Status changed to Exited" .

<urn:solutiondesign:instance:epp:CandidateStatusChangedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "No consumers currently — internal tracking only, per epp-domain.md's Domain Events table." ;
	<urn:solutiondesign:ontology:payloadHighlights> "candidateId, eppCode, oldStatus, newStatus, effectiveDate" ;
	<urn:solutiondesign:ontology:trigger> "Status update by EPP" .

<urn:solutiondesign:instance:epp:CarState_Approved> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Approved" ;
	<urn:solutiondesign:ontology:notes> "Final state is set by the Credentialing domain, not by EPP — EPP's own visibility into this record ends at Recommended." .

<urn:solutiondesign:instance:epp:CarState_Cancelled> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Cancelled" .

<urn:solutiondesign:instance:epp:CarState_Denied> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Denied" .

<urn:solutiondesign:instance:epp:CarState_Hold> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Hold" .

<urn:solutiondesign:instance:epp:CarState_PendingPayment> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Pending Payment" .

<urn:solutiondesign:instance:epp:CarState_Recommended> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Recommended" .

<urn:solutiondesign:instance:epp:CarState_Submitted> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Submitted" .

