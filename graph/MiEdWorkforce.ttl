<urn:solutiondesign:instance:credentialing:Op_GetEducatorCredentials> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "v1 fix: the source's x-access is genuinely 'internal-user, internal-service' (also callable service-to-service, e.g. by Staffing per that domain's Dependencies table) — sd:accessType is asserted with both values here since the ontology's own comment on sd:accessType says an operation reachable by more than one audience holds multiple values. v1 had recorded only 'internal-user' as primary because ApiOperationShape appeared single-valued; that was a misreading of the shape, not a real constraint, so it's corrected here rather than re-flagged." ;
	<urn:solutiondesign:ontology:operationId> "getEducatorCredentials" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:credentialing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/educators/{educatorId}/credentials" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:credentialing:IssuedCredentialAggregate> ;
	<urn:solutiondesign:ontology:projection> "EducatorCredentialSummary: all of the educator's credentials (and their endorsements) grouped under one educatorUniqueId, rather than one credential at a time." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get educator credential summary" ;
	<urn:solutiondesign:ontology:tags> "Credentials" .

<urn:solutiondesign:instance:credentialing:Op_GetEndorsementDefinitionHistory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "getEndorsementDefinitionHistory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:credentialing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/endorsement-definitions/{definitionId}/history" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:credentialing:EndorsementDefinitionVersion> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "View endorsement definition version history (admin)" ;
	<urn:solutiondesign:ontology:tags> "Definitions" .

<urn:solutiondesign:instance:credentialing:Op_GetPublicEducatorCredentialHistory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "external-public" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "getPublicEducatorCredentialHistory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:credentialing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/public/educator-credentials/{educatorUniqueId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:credentialing:IssuedCredentialAggregate> ;
	<urn:solutiondesign:ontology:projection> "PublicEducatorCredentialHistory: credentials grouped into activeCredentials/inactiveCredentials, each with issuedAt/expiresAt blanked for Nullified/Revoked/Suspended/PPR-Withdrawn per Rule_PublicEducatorCredentialSearch, plus hasAdverseAction/adverseActionMessage — a public-safe subset, not the full CredentialDetail an authenticated caller sees." ;
	<urn:solutiondesign:ontology:requiresAuth> false ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get public credential history for an educator" ;
	<urn:solutiondesign:ontology:tags> "Public Credential Search" .

<urn:solutiondesign:instance:credentialing:Op_ImportAssessmentResults> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Escape hatch used deliberately for the request only: a provider-specific CSV/XLSX file upload isn't a JSON mirror of AssessmentResult's fields — it's parsed per-row by the import job, not a single entity payload." ;
	<urn:solutiondesign:ontology:operationId> "importAssessmentResults" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:credentialing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/assessment-results/import" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:credentialing:AssessmentResultAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response is an async job handle (jobId, statusUrl), not the created/updated AssessmentResult records themselves — each successful row creates or updates one AssessmentResultAggregate instance (see the Import Assessment Results sequence) and publishes AssessmentResultImported." ;
	<urn:solutiondesign:ontology:requestBodySchema> "multipart/form-data: { provider: enum[Pearson-MTTC, ETS-Praxis, Other], resultsFile: binary CSV/XLSX }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Import assessment results from provider (admin)" ;
	<urn:solutiondesign:ontology:tags> "Assessments" .

<urn:solutiondesign:instance:credentialing:Op_InitiateBulkRenewals> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:markedDeleted> true ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Escape hatch used deliberately: this operation's request is a batch-selection criteria object spanning many CredentialApplication instances at once, not one entity's fields, and the response is an async job handle, not an entity — neither maps to a single sd:consumesShape/producesShape target." ;
	<urn:solutiondesign:ontology:operationId> "initiateBulkRenewals" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:credentialing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/applications/bulk-renewals" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ credentialType, expirationDateRange: { from, to }, excludeEducatorIds? }" ;
	<urn:solutiondesign:ontology:responseSchema> "{ jobId, estimatedApplicationCount, statusUrl }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Initiate bulk renewal process (admin)" ;
	<urn:solutiondesign:ontology:tags> "Applications" .

