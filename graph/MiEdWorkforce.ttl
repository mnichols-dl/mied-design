<urn:solutiondesign:instance:epp:Op_UpdateCandidateStatus> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "PATCH" ;
	<urn:solutiondesign:ontology:operationId> "updateCandidateStatus" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/candidate-enrollments/{enrollmentId}" ;
	<urn:solutiondesign:ontology:projection> "Request carries only status plus whichever conditional fields the target status requires (exitDate/exitReason for Exited; enrollmentDate/programLevel/programType when transitioning from Rejected to Enrolled) — a single-candidate counterpart to Op_BulkUpdateCandidateStatus's payload shape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update candidate enrollment status" ;
	<urn:solutiondesign:ontology:tags> "Candidate Enrollments" .

<urn:solutiondesign:instance:epp:Op_UpdateCertificateCategory> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:ApprovedCertificateCategory> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:operationId> "updateCertificateCategory" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/epp-providers/{eppCode}/certificate-categories" ;
	<urn:solutiondesign:ontology:projection> "Request adds a required categoryId to identify which existing ApprovedCertificateCategory to update." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update certificate category approval" ;
	<urn:solutiondesign:ontology:tags> "EPP Providers" .

<urn:solutiondesign:instance:epp:Op_UpdateEndorsement> a <urn:solutiondesign:ontology:ApiOperation> ;
