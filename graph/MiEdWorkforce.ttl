	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:epp:ApprovedEndorsement> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:operationId> "updateEndorsement" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/epp-providers/{eppCode}/endorsements" ;
	<urn:solutiondesign:ontology:projection> "Request adds a required endorsementId to identify which existing ApprovedEndorsement to update." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update approved endorsement" ;
	<urn:solutiondesign:ontology:tags> "EPP Providers" .

<urn:solutiondesign:instance:epp:Op_UpdateEppProvider> a <urn:solutiondesign:ontology:ApiOperation> ;
