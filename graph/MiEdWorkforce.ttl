<urn:solutiondesign:instance:credentialing:EndorsementDefinitionUpdatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, endorsementCode, changes, effectiveFrom, updatedBy" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin modifies endorsement definition" .

<urn:solutiondesign:instance:credentialing:EndorsementDefinitionVersion> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Historical versions of an EndorsementDefinition with change audit trail." ;
	<urn:solutiondesign:ontology:name> "DefinitionVersion" .

<urn:solutiondesign:instance:credentialing:EndorsementDisplayName> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "User-facing name for the endorsement." ;
	<urn:solutiondesign:ontology:name> "DisplayName" .

<urn:solutiondesign:instance:credentialing:EndorsementFlags> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Configuration properties for an endorsement definition." ;
	<urn:solutiondesign:ontology:fields> "OutOfState (special handling for out-of-state endorsements), InitialEndorsementEligible (can this be an initial endorsement on a new certificate), ProgressToProfessional (related to provisional-to-professional progression paths)" ;
	<urn:solutiondesign:ontology:name> "EndorsementFlags" .

<urn:solutiondesign:instance:credentialing:EndorsementNullifiedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "endorsementId, credentialId, educatorId, nullifiedAt, reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
