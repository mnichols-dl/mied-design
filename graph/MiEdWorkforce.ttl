	<urn:solutiondesign:ontology:path> "/authorization-denials/{token}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_AuthorizationRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Deny authorization request via email link token" ;
	<urn:solutiondesign:ontology:tags> "AuthorizationRequests" .

<urn:solutiondesign:instance:iam:Op_EscalateIdentityRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Only valid for NewId requests — DemographicUpdate has no escalation path." ;
	<urn:solutiondesign:ontology:operationId> "escalateIdentityRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/identity-resolution/requests/{requestId}/escalate" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Escalate a business-user New ID Near Match for Identity Administrator review" ;
	<urn:solutiondesign:ontology:tags> "IdentityResolution" .

<urn:solutiondesign:instance:iam:Op_GetDeniedRequestsReport> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "getDeniedRequestsReport" ;
