	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Restricted to internal-user as attestation requires an identified ISD official. Locks the audit report read-only; triggers SOM Auditor notification." ;
