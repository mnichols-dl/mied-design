	<urn:solutiondesign:ontology:operationId> "listRoles" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/roles" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_Role> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List all roles" ;
	<urn:solutiondesign:ontology:tags> "Roles" .

<urn:solutiondesign:instance:iam:Op_ManualGrantAuthorization> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:iam:Entity_Authorization> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "manualGrantAuthorization" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/authorizations/manual-grant" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_Authorization> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Admin manually grant authorization (bypass approval workflow)" ;
	<urn:solutiondesign:ontology:tags> "Authorizations" .

<urn:solutiondesign:instance:iam:Op_RevokeAuthorization> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "revokeAuthorization" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/authorizations/{authorizationId}/revoke" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_Authorization> ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Admin revoke authorization" ;
	<urn:solutiondesign:ontology:tags> "Authorizations" .

<urn:solutiondesign:instance:iam:Op_SearchOrganizations> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Backed by the Organizations platform capability's CEDS-aligned local replica; used for authorization request forms and scope selectors." ;
	<urn:solutiondesign:ontology:operationId> "searchOrganizations" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/organizations/search" ;
	<urn:solutiondesign:ontology:responseSchema> "OrganizationSummary list -- escape hatch: this operation proxies the Organizations platform capability's own data (see orgs:Op_SearchOrganizations), which is a different bounded context's domain model, not IAM's own" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Typeahead search for organizations" ;
	<urn:solutiondesign:ontology:tags> "Organizations" .

<urn:solutiondesign:instance:iam:Op_SearchUsers> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "searchUsers" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/users/search" ;
	<urn:solutiondesign:ontology:responseSchema> "UserSummary list -- escape hatch: iam-domain.md models no standalone User DomainEntity/Aggregate (identity lives on MiLoginIdentity/Authorization instead), so there is no sd:DomainModelElement for this operation to producesShape; a real, honest gap rather than a fabricated User entity" ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Search users (admin)" ;
	<urn:solutiondesign:ontology:tags> "Users" .

<urn:solutiondesign:instance:iam:Op_SelfRemoveAuthorization> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "DELETE" ;
	<urn:solutiondesign:ontology:operationId> "selfRemoveAuthorization" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/authorizations/{authorizationId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_Authorization> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Self-remove authorization" ;
	<urn:solutiondesign:ontology:tags> "Authorizations" .

<urn:solutiondesign:instance:iam:Op_SelfResolveIdentityRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Gated by a Staffing permission, not an IAM one — see iam-domain.ttl's staff:Perm_EmployeeRosterAddEmployee / staff:Perm_EmployeeRosterUpdateDemographics stubs. Only valid for BusinessUserStaffing-origin NewId and DemographicUpdate requests; a citizen can never call this." ;
	<urn:solutiondesign:ontology:operationId> "selfResolveIdentityRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/identity-resolution/requests/{requestId}/resolve" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Self-resolve a business-user Near Match by selecting a potential match" ;
	<urn:solutiondesign:ontology:tags> "IdentityResolution" .

<urn:solutiondesign:instance:iam:Op_SubmitAuthorizationRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:iam:Entity_AuthorizationRequest> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitAuthorizationRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/authorization-requests" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_AuthorizationRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit new authorization request" ;
	<urn:solutiondesign:ontology:tags> "AuthorizationRequests" .

<urn:solutiondesign:instance:iam:Op_SubmitBusinessUserIdentityRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called by Staffing on behalf of an already-authorized business user. iam-api.yml documents no x-permissions-required for this operation at all — the calling domain is explicitly responsible for checking the human's permission for the underlying business action before calling; IAM does not re-check a human permission here since the caller is a trusted internal service. Left with NO PermissionRequirement, an intentional, documented gap (ApiOperationRequiresPermissionShape will flag this — accurate, per the source doc's own stated design)." ;
	<urn:solutiondesign:ontology:operationId> "submitBusinessUserIdentityRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/identity-resolution/requests" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit a business-user-triggered identity resolution request (New ID or Link ID)" ;
	<urn:solutiondesign:ontology:tags> "IdentityResolution" .

<urn:solutiondesign:instance:iam:Op_SubmitCitizenAccountCreation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitCitizenAccountCreation" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/citizen-identity/account-creation" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:projection> "Request body is shaped by VO_SubmittedDemographics plus VO_NoSSNStatus, not the full IdentityRequest entity" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit Citizen Account Creation identity request" ;
	<urn:solutiondesign:ontology:tags> "CitizenIdentity" .

<urn:solutiondesign:instance:iam:Op_SubmitCitizenAccountUpdate> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitCitizenAccountUpdate" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/citizen-identity/account-update" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:projection> "Request body is shaped by VO_SubmittedDemographics (updated fields only), not the full IdentityRequest entity" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit Citizen Account Update identity request" ;
	<urn:solutiondesign:ontology:tags> "CitizenIdentity" .

<urn:solutiondesign:instance:iam:Op_SubmitRemovalRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "external-public" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitRemovalRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/removal-requests" ;
	<urn:solutiondesign:ontology:requestBodySchema> "RemovalRequestCreate {targetUserEmail, targetUserName, targetMiLoginId?, requestorName, requestorEmail, requestorRelationship, justification} -- escape hatch: no RemovalRequest aggregate is modeled in iam-domain.ttl (see this domain's header note), so there is no entity to consumesShape/producesShape" ;
	<urn:solutiondesign:ontology:requiresAuth> false ;
	<urn:solutiondesign:ontology:responseSchema> "{referenceId, message} -- escape hatch, same reason" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit public authorization removal request (external)" ;
	<urn:solutiondesign:ontology:tags> "RemovalRequests" .

<urn:solutiondesign:instance:iam:Op_TriggerDeactivateInactiveUsers> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called by Azure Synapse Pipeline on the first Friday of each month. Backs iam:Job_DeactivateInactiveUsers." ;
	<urn:solutiondesign:ontology:operationId> "triggerDeactivateInactiveUsers" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/jobs/deactivate-inactive-users" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Trigger inactivity-based account deactivation job (Synapse)" ;
	<urn:solutiondesign:ontology:tags> "AdminJobs" .

<urn:solutiondesign:instance:iam:Op_TriggerExpireRequests> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called by Azure Synapse Pipeline on a nightly schedule; authenticated via Managed Identity/mTLS. Backs iam:Job_ExpireAuthorizationRequests." ;
	<urn:solutiondesign:ontology:operationId> "triggerExpireRequests" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/jobs/expire-requests" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Trigger authorization request expiration job (Synapse)" ;
	<urn:solutiondesign:ontology:tags> "AdminJobs" .

<urn:solutiondesign:instance:iam:Op_TriggerGenerateReports> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Called by Azure Synapse Pipeline on Mondays at 8 AM. Backs iam:Job_GenerateReports." ;
	<urn:solutiondesign:ontology:operationId> "triggerGenerateReports" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/jobs/generate-reports" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Trigger weekly report generation job (Synapse)" ;
	<urn:solutiondesign:ontology:tags> "AdminJobs" .

<urn:solutiondesign:instance:iam:Op_WithdrawAuthorizationRequest> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "withdrawAuthorizationRequest" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:iam:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/authorization-requests/{requestId}/withdraw" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:iam:Entity_AuthorizationRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Withdraw a pending authorization request" ;
	<urn:solutiondesign:ontology:tags> "AuthorizationRequests" .

<urn:solutiondesign:instance:iam:Perm_ApprovalLinkConfigure> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Configure approval link expiration" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_ApprovalLinks> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Set default expiration timeframe (days). No API operation currently models this configuration permission — iam-api.yml has no approval-link-configuration endpoint; left with no PermissionRequirement, an intentional, documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "iam.approval-link.configure" .

<urn:solutiondesign:instance:iam:Perm_AuditView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View authorization audit logs" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_AuditLogs> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Scope-aware: Organization admins see their Organization only ('System-wide or Organization' in source, expanded to the org-hierarchy scope set). No API operation currently models this permission — iam-api.yml has no audit-log endpoint; left with no PermissionRequirement, an intentional, documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "iam.audit.view" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationApprove> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Approve user authorization requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_AuthorizationRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Must be Lead Admin for Organization; transitive (ISD grants access to constituent districts and buildings)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.approve" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationDeny> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Deny user authorization requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_AuthorizationRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Must be Lead Admin for Organization; can add denial reason; transitive." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.deny" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationGrant> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manually grant authorization without approval" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_AuthorizationRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; bypasses approval workflow. Critical permission — always evaluated real-time, bypasses the authorization cache (iam-technical-design.md)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.grant" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationRemoveOwn> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Remove own active authorization (self-service)" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Users can revoke their own access to organizations without approval. Immediate effect." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.remove-own" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationRequest> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit authorization request for organizational access" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Business/Worker users without existing authorizations can request access to organizations. Citizen users receive automatic Individual scope authorization instead." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.request" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationRevoke> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Revoke/remove user authorization" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_AuthorizationRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Organization admin for scope or System Admin. Critical permission — always evaluated real-time, bypasses the authorization cache (iam-technical-design.md)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.revoke" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View authorization requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_AuthorizationRequests> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Scope-aware: Organization admins see their Organization only. 'Building' scope in source mapped to scope:Entity — see this file's header note." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.view" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationViewOwn> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View own authorization requests and active authorizations" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Users can see their pending requests, approval status, and current active authorizations." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.view-own" .

<urn:solutiondesign:instance:iam:Perm_AuthorizationWithdraw> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Withdraw own pending authorization request" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Users can cancel requests before Lead Admin approval." ;
	<urn:solutiondesign:ontology:permissionId> "iam.authorization.withdraw" .

<urn:solutiondesign:instance:iam:Perm_CitizenIdentityCancelOwnRequest> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Cancel own pending Account Update request (Near Match only)" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Citizen users only; Account Creation requests cannot be self-cancelled once RequiresResolution (Identity Admin only)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.citizen-identity.cancel-own-request" .

<urn:solutiondesign:instance:iam:Perm_CitizenIdentitySubmitRequest> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit an Account Creation or Account Update identity request" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Citizen users only." ;
	<urn:solutiondesign:ontology:permissionId> "iam.citizen-identity.submit-request" .

<urn:solutiondesign:instance:iam:Perm_CitizenIdentityViewOwnRequest> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View own pending/historical identity request status" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Citizen users only; never exposes candidate match data (see iam-domain.md Near Match Resolution rule)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.citizen-identity.view-own-request" .

<urn:solutiondesign:instance:iam:Perm_IdentityAdminManageConfiguration> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manage identity-specific system configuration: validation rules, data element definitions, training materials, and processing queue monitoring" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_IdentityAdministrator> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Identity Administrator role; narrower than the general iam.* system-configuration permissions, which do not cover identity processing specifically. No API operation currently models this permission — iam-api.yml has no identity-configuration endpoint; left with no PermissionRequirement, an intentional, documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "iam.identity-admin.manage-configuration" .

<urn:solutiondesign:instance:iam:Perm_IdentityAdminResolveRequest> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Resolve an identity request awaiting administrator review (match, create new, approve/deny link, cancel)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_IdentityAdministrator> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Identity Administrator role only." ;
	<urn:solutiondesign:ontology:permissionId> "iam.identity-admin.resolve-request" .

<urn:solutiondesign:instance:iam:Perm_IdentityAdminUpdatePersonRecord> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Directly update a person's demographic record via Mi-Key, bypassing matching" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_IdentityAdministrator> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Identity Administrator role only; rare-use path distinct from citizen/business-user self-service demographic updates." ;
	<urn:solutiondesign:ontology:permissionId> "iam.identity-admin.update-person-record" .

<urn:solutiondesign:instance:iam:Perm_IdentityAdminViewPendingRequests> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View identity requests awaiting administrator review, of any origin or type" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_IdentityAdministrator> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Identity Administrator role; a distinct role from Staffing Data Admin or System Admin — reviewing and resolving identity requests is not a function of either." ;
	<urn:solutiondesign:ontology:permissionId> "iam.identity-admin.view-pending-requests" .

<urn:solutiondesign:instance:iam:Perm_InactivityConfigure> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Set auto-deactivation rules" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_InactivityPolicy> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Configure threshold (days) and schedule." ;
	<urn:solutiondesign:ontology:permissionId> "iam.inactivity.configure" .

<urn:solutiondesign:instance:iam:Perm_InactivityRun> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manually trigger inactivity deactivation job" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_InactivityPolicy> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; for testing/emergency runs. Also gates the nightly/monthly Synapse-triggered admin job endpoints (POST /admin/jobs/expire-requests, POST /admin/jobs/deactivate-inactive-users)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.inactivity.run" .

<urn:solutiondesign:instance:iam:Perm_PermissionView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View permission catalog" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_Permissions> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "See all defined permissions. Also used to gate internal-service permission-evaluation endpoints (POST /permissions/check, GET /permissions/effective, GET /organizations/{code}/hierarchy) per iam-api.yml." ;
	<urn:solutiondesign:ontology:permissionId> "iam.permission.view" .

<urn:solutiondesign:instance:iam:Perm_RemovalRequestReview> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Review public authorization removal requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_AuthorizationRemoval> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; approve/deny external requests." ;
	<urn:solutiondesign:ontology:permissionId> "iam.removal-request.review" .

<urn:solutiondesign:instance:iam:Perm_ReportsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View User Management Report" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_Reports> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only. Also gates GET /reports/new-users, GET /reports/denied-requests, GET /reports/inactivity, and POST /admin/jobs/generate-reports." ;
	<urn:solutiondesign:ontology:permissionId> "iam.reports.view" .

<urn:solutiondesign:instance:iam:Perm_RoleView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View role definitions" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_Roles> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "See role names, descriptions, assigned permissions." ;
	<urn:solutiondesign:ontology:permissionId> "iam.role.view" .

<urn:solutiondesign:instance:iam:Perm_UserEdit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Edit user account details" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_UserAccounts> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; modify contact info, flags" ;
	<urn:solutiondesign:ontology:permissionId> "iam.user.edit" .

<urn:solutiondesign:instance:iam:Perm_UserImpersonate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View system as another user (read-only)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_UserAccounts> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Documented discrepancy: this permission is cataloged here (iam-permissions.md), but iam-technical-design.md's 'Omission of User Impersonation' section states impersonation was designed, evaluated, and deliberately EXCLUDED from the initial implementation — diagnostic value is instead achieved via admin views of records/history/audit logs and screenshare tooling. Not resolved here; left as a documented catalog/implementation mismatch for the cross-domain reconciliation pass. No API operation implements it (iam-api.yml has no impersonation endpoint)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.user.impersonate" .

<urn:solutiondesign:instance:iam:Perm_UserView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View user account details and list" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:iam:Cat_UserAccounts> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Read-only access to user directory" ;
	<urn:solutiondesign:ontology:permissionId> "iam.user.view" .

<urn:solutiondesign:instance:iam:Perm_UserViewOwn> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View own user profile" ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Read-only access to own account details (name, email, MiLogin type, contact info)." ;
	<urn:solutiondesign:ontology:permissionId> "iam.user.view-own" .

<urn:solutiondesign:instance:iam:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "permissions" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/iam/iam-permissions.md" .

<urn:solutiondesign:instance:iam:PersonRecordUpdatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "staffing consumer is conditional: only when affectsActiveEmployment or BusinessUserStaffing origin, per iam-domain.md's Domain Events table Consumers column." ;
	<urn:solutiondesign:ontology:payloadHighlights> "userId?, employeeRecordId?, uniqueId, updatedAt, affectsActiveEmployment" ;
	<urn:solutiondesign:ontology:publishedToTopic> "iam-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "An AccountUpdate or DemographicUpdate request resolves to Match (Mi-Key confirms update to the Master Record)" .

<urn:solutiondesign:instance:iam:PolicyState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:iam:PolicyState_Configured> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Configured" .

<urn:solutiondesign:instance:iam:PolicyState_Suspended> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Suspended" .

<urn:solutiondesign:instance:iam:Question_AuthorizationCacheStalenessTolerance> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What is the acceptable cache staleness tolerance for authorization revocations? Can the system tolerate the current 5-minute TTL, or does a revoked user's continued access for up to 5 minutes require a shorter TTL?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:TP_AuthorizationEvaluation> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:notes> "iam-technical-design.md Open Technical Question #2." ;
	<urn:solutiondesign:ontology:owner> "Product + Security" ;
	<urn:solutiondesign:ontology:status> "open" ;
	<urn:solutiondesign:ontology:targetDate> "2025-01-15"^^<http://www.w3.org/2001/XMLSchema#date> .

<urn:solutiondesign:instance:iam:Question_BulkIdentityProcessingNotModeled> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Feature 15.5 describes a complete bulk/file-upload identity-update pathway — file staging queue, schema validation, business-rule validation, a sandbox commit/cancel review step, and asynchronous Mi-Key processing with worklist-routed Near Matches — with no counterpart anywhere in iam-domain.ttl/iam-api.ttl/iam-sequences.ttl. Every identity-resolution pathway iam currently models (Citizen self-service, Business New ID, Business Demographic Update, Link ID) is a single-record, synchronous, online-form submission; nothing resembles a file-upload staging area, a schema-validation gate, a commit/cancel sandbox step, or an asynchronous batch variant of the Mi-Key Assignment service. This is a genuine, structural gap, not a documentation nuance — a whole distinct interaction pattern (batch, not just a bigger single request) that the domain's existing IdentityRequest/IdentityResolutionRequest model doesn't obviously extend to without new design work (e.g. is a bulk file's Near Match one IdentityResolutionRequest per row, or a new aggregate entirely?). Documents domain owns generic file-upload infrastructure elsewhere in the platform (not reviewed as part of this iam-scoped pass), but the identity-specific business rules, staging/commit semantics, and async Mi-Key variant described here have no home in iam regardless." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_5_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_5_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_5_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_5_4> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_DistributedCacheArchitecture> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Should the authorization-evaluation cache be implemented as a distributed cache (e.g. Redis cluster) or is in-memory cache with replication sufficient?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:TP_AuthorizationEvaluation> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:notes> "iam-technical-design.md Open Technical Question #3." ;
	<urn:solutiondesign:ontology:owner> "Infrastructure" ;
	<urn:solutiondesign:ontology:status> "open" ;
	<urn:solutiondesign:ontology:targetDate> "2025-01-15"^^<http://www.w3.org/2001/XMLSchema#date> .

<urn:solutiondesign:instance:iam:Question_ExternalRemovalRequestVerification> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "For external authorization-removal requests submitted without login, should additional verification (e.g., matching demographic data against Mi-Key) be required before a System Administrator can approve?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "iam-domain.md Open Question #9." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_ImpersonationFeatureContradictsOmission> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "iam-technical-design.ttl's own iam:Question_UserImpersonationOmission already documents a three-way discrepancy: iam.user.impersonate is cataloged as a permission (iam:Perm_UserImpersonate), a read-only-impersonation design was diagrammed in iam-technical-visual-summary.md, but iam-technical-design.md's 'Omission of User Impersonation' section states impersonation was designed, evaluated, and deliberately EXCLUDED from the initial implementation (diagnostic value achieved instead via admin views of records/history/audit logs and screenshare tooling, with documented reintroduction criteria). This FDD (Feature 1.8, all four stories) is a FOURTH independent document describing the exact same capability in comparable or greater detail — citizen search-and-view-as (1.8.1), Business/Entity context view (1.8.2), read-only enforcement matching the already-diagrammed design almost exactly (1.8.3), and a role-based access-restriction matrix on top (1.8.4) — plus its own wireframe (wireframe-06, viewed). No sd:satisfiedBy is asserted for any of the four: no ApiOperation or Sequence implements 'View As' anywhere in iam-api.ttl/iam-sequences.ttl, consistent with the domain's own documented exclusion decision. This strengthens rather than resolves the existing open question — four separate documents (permissions catalog, technical-visual-summary, this FDD's Business Specs section, and this FDD's own Addendum) describe or assume impersonation exists or should exist, against one technical-design section that says it was cut. Whoever owns the reintroduction-criteria decision should see this FDD as material evidence the client-facing requirement did not go away." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_8_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_8_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_8_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_8_4> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:findingType> "contradiction" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:references> <urn:solutiondesign:instance:iam:Perm_UserImpersonate> ;
	<urn:solutiondesign:ontology:references> <urn:solutiondesign:instance:iam:Question_UserImpersonationOmission> ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_LeadAdminDataStaleness> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What is the acceptable staleness window for Lead Administrator data sourced from EEM — is ~25-hour cached data (nightly sync + 60-min consumer TTL) sufficient for bootstrap grants and approval routing, or is real-time accuracy required?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:TP_OrgDataCaching> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:notes> "iam-domain.md Open Question #10, elaborated in this domain's own Technical Considerations section and in iam-technical-design.md's org-data caching writeup. Resolving it would require a mechanism in the Organizations API to bypass its cache for IAM's service principal." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_MultiScopeRequestSubmission> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can a user submit a single authorization request covering multiple scopes, or must separate requests be submitted for each scope?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "iam-domain.md Open Question #5." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_NearMatchAutoCancelTimeframe> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What is the numeric auto-cancellation timeframe (\"X days\") for an unresolved Near Match of any origin, and does it need to stay aligned with Mi-Key's own independent cancellation timer?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "iam-domain.md Open Question #11. FDD 15.3's own Gap Analysis names this as undefined for both the citizen and business-user paths — see the auto_cancel_at field on IDENTITY_RESOLUTION_REQUESTS in this domain's ERD, which exists but is unpopulated pending this answer." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_NearMatchDataPrecedenceNotModeled> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "See Req_15_3_5's own sd:notes: the Citizen User Near Match Resolution doc's own Gap Analysis section independently confirms both halves of this gap ('Missing Admin Action - Data Precedence Selection' and 'Missing Admin Interface Detail - Matching Score') as FDD-vs-BRD gaps in the source document itself, not a discrepancy introduced by this conversion. iam:VO_ResolutionAction captures the admin's overall Match/CreateNew/Deny disposition but no field-level data-precedence selection, and no property anywhere in iam-domain.ttl carries a Mi-Key match score for display." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_3_5> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_NoUserGroupLayerContradiction> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "iam:RoleDefinitionAggregate's own sd:notes record a 2026-08-14 domain decision: 'No User Group Layer... an earlier FDD draft described a User Group concept whose one enforced constraint never carried behavior that Role + Scope couldn't already express. Confirmed direction is Role + Scope only... Pending final client concurrence.' This FDD (1 - User Management, comments dated through 2026-04-15, i.e. contemporaneous with or after that decision) directly contradicts it: Feature 1.3 is an entire admin CRUD feature for creating/editing/listing 'User Groups' as a first-class, separately-assignable, admin-managed construct (System Administrator, Credential, Staffing, EPP, Professional Learning, Data Quality, Citizen, per the FDD's own Business Specifications list) distinct from Role — not a vague or stale mention. Corroborating evidence this is a live requirement, not leftover FDD text nobody updated: (1) wireframe-04 (viewed) is a fully-realized 'Groups' CRUD screen, not just narrative text; (2) 1.4.2/1.4.3/1.5.1 all separately reference assigning/filtering by Group as distinct from Role; (3) the Role Matrix reference workbook (Fdd01RoleMatrixDoc) itself has a 'Group' column distinct from 'Role', meaning even the canonical role-catalog artifact organizes around Groups. This is the strongest evidence available that the domain's 'pending final client concurrence' decision may not have actually been concurred with, or that this FDD was not updated to reflect it — a genuine open reconciliation question for the client, not a simple oversight either side can silently resolve." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_3_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_3_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_3_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_4_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_4_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_5_1> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:findingType> "contradiction" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_PersonSearchNotModeled> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Feature 15.4 (Person Search) and Req_15_2_1 both describe a cross-cutting 'Person/Identity Search' capability — search by Unique ID, Name, DOB, SSN, Credential License Number, or Application Number; view an individual's full demographic history, credential information, AND employment collection history in one read-only detail page; select multiple records to compare and request a Link. No API operation anywhere in iam-api.ttl implements this: iam:Op_SearchUsers/Op_GetUser search MiEdWorkforce *user accounts* specifically (and iam-api.ttl's own honest-gap note already says no standalone User entity backs even that), which is a materially narrower and different concept than searching the universe of Mi-Key-known identity records (including individuals with no MiEdWorkforce user account at all — e.g. a PK-12 student later becoming a credential applicant). The credential/employment-history aggregation this search surfaces spans Credentialing and Staffing data that iam-domain.ttl explicitly disclaims owning ('IAM explicitly does NOT own... employee roster membership'). This may be a genuine gap, or may be a capability that rightfully belongs to Staffing, Credentialing, or a dedicated cross-domain search capability not yet reviewed/converted — unconfirmed without reviewing those domains' own files as part of this pass, so left as an open finding rather than guessed at." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_2_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_4_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_4_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_4_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_4_4> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_15_4_5> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_RoleCrudNotModeled> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Features 1.5.2-1.5.4 ask for a full admin UI to create Roles, bundle Functions/Permissions into them, and edit those mappings later. iam-api.ttl only models read access to roles (Op_ListRoles, Op_GetRole); no create/update/delete Role operation exists anywhere in the IAM API surface, and iam:Entity_Role's own description states Roles are 'system-defined, not user-created' — the two aren't just unimplemented, they reflect an explicit, documented design position that this FDD's own Feature 1.5 contradicts. (1.5.3's own acceptance criteria simultaneously insist Functional Areas/Functions themselves stay code-based/developer-maintained, so the FDD is internally inconsistent about how much of this model is meant to be admin-configurable at all.) Distinct from Question_NoUserGroupLayerContradiction — this gap would exist even if the User Group question were resolved in the FDD's favor, since it concerns Role definition itself, not Role-vs-Group terminology." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_5_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_5_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_5_4> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_ScopeApproverCapacityAndDelegation> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "How many Scope Approvers can exist for a given organization, and could that create a bottleneck requiring delegated approval? Relatedly: can a Scope Approver for a parent organization also approve requests routed to a child organization, or must requests always go to the approver of the specific target organization?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "Combines iam-domain.md Open Questions #6 and #7 — both concern Lead Administrator/Scope Approver routing capacity and reach, not modeled as two independent unknowns." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_UserImpersonationOmission> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "iam-permissions.md's catalog lists iam.user.impersonate as a live, cataloged permission (System-wide scope, 'View system as another user (read-only)'), and iam-technical-visual-summary.md section 6 goes as far as diagramming a concrete read-only-impersonation design (view/search/export allowed, all mutating actions blocked). But iam-technical-design.md's 'Omission of User Impersonation' section states plainly that impersonation was designed, evaluated, and deliberately EXCLUDED from the initial implementation — diagnostic value is instead achieved via admin views of records/history/audit logs and screenshare tooling, with documented reintroduction criteria if that ever proves insufficient. No API operation implements it (iam-api.yml has no impersonation endpoint) and no PermissionRequirement references iam.user.impersonate anywhere in iam-api.ttl." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Perm_UserImpersonate> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:TechnicalVisualSummaryDoc> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:notes> "See also the sd:notes on iam:Perm_UserImpersonate itself (iam-permissions.ttl), where this same catalog/implementation mismatch is flagged inline. Not resolved here or there — a genuine three-document discrepancy preserved rather than silently picking a winner." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Question_WorkerOnboardingNotFullyModeled> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Features 1.2.1/1.2.2 describe a Worker-specific post-authentication path that is materially different from Business: zero permissions by default, no e-form, a distinct 'Pending Access' page pointing the user at an offline paper process, with admin-side manual assignment (1.2.3, which IS reasonably satisfied). iam-sequences.ttl's Seq_MiLoginAuthenticationIntegration currently routes 'No authorizations AND MiLogin type = Business/Worker' through one shared branch (Lead-Admin check, else 'redirect to authorization request form') with no Worker-specific fork to a zero-permission Pending Access state — the same e-form path a Business user gets. Corroborating evidence this gap is real, not just an FDD-numbering artifact: (a) comment 144560476/42 shows the visible 1.2.1 text was deliberately rewritten mid-review specifically to describe this manual/paper-only process, meaning the requirement is a live, considered decision, not a stale draft; (b) the wireframe positioned at this exact spot in the document (wireframe-03, viewed) is not a Worker screen at all but a misplaced/reused Citizen account-creation form — i.e. no Worker-specific UI exists anywhere in this FDD either, reinforcing that this path was never fully designed end-to-end on either side." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_2_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:iam:Req_01_2_2> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:iam:Req_01_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system detects the authentication request originating from the MiLogin for Citizens platform. The system auto-approves the user's request for access to MiEdWorkforce upon selection from the MiLogin Systems/Applications menu. If the user has not yet established a Unique ID, the system navigates the user to the 'Account Creation Landing Page'. If the user has a Unique ID assigned, the system navigates the user to the Dashboard." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match: Seq_MiLoginAuthenticationIntegration's own routing alt-branch ('No authorizations AND MiLogin type = Citizen' -> has Unique ID ? dashboard : identity resolution) is this story almost verbatim, and Seq_CitizenInitialSignIn covers the identity-resolution path in full detail. wireframe-03 (viewed) shows the actual Account Creation Landing Page form referenced here, though it is misplaced in the document at the Feature 1.2 (Worker) location — see Question_WorkerOnboardingNotFullyModeled." ;
	<urn:solutiondesign:ontology:requirementId> "1.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_CitizenAutoApproval> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenInitialSignIn> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_MiLoginAuthenticationIntegration> ;
	<urn:solutiondesign:ontology:statement> "As a MiLogin for Citizens User, I want to be automatically directed to the specific MiEdWorkforce account creation or dashboard page upon selecting the application, so that I can establish my identity or view my credentials without manual approval of my system access request." ;
	<urn:solutiondesign:ontology:title> "Citizen auto-directed to account creation or dashboard" .

<urn:solutiondesign:instance:iam:Req_01_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system detects the authentication request originating from the MiLogin for Business platform. The system navigates the user directly to the security access forms to establish user roles and entity permissions. The system allows the user to access the security forms without a pre-established Unique ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: the sequence's Business/Worker branch (no existing authorizations, not a Lead Admin) routes to exactly this form. wireframe-01 (viewed) corroborates the full security-form + Lead-Admin-approval swimlane." ;
	<urn:solutiondesign:ontology:requirementId> "1.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SubmitAuthorizationRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserInitialAuthorizationRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_MiLoginAuthenticationIntegration> ;
	<urn:solutiondesign:ontology:statement> "As a MiLogin for Business User, I want to be directed to the security access forms upon selecting the application, so that I can associate my account with a specific educational entity." ;
	<urn:solutiondesign:ontology:title> "Business user directed to security access forms" .

<urn:solutiondesign:instance:iam:Req_01_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The MiEdWorkforce public landing page displays a distinct link or button for 'MiLogin for Citizens'. The MiEdWorkforce public landing page displays a distinct link or button for 'MiLogin for Business'. The system does not display a login option for 'MiLogin for Workers' on the public landing page. Clicking a specific link redirects the user to the corresponding MiLogin platform URL." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: the underlying three-portal-separation fact (Citizen/Business/Worker are genuinely separate MiLogin URLs, confirmed independently by the three MiLogin Interface IDDs read for this pass) is real and matches ext:MiLoginSystem's own integrationNotes. But which links a public MiEdWorkforce landing page itself displays is a front-end/portal-content concern with no corresponding node anywhere in iam-domain.ttl/iam-api.ttl (no ApiOperation or Sequence models 'the public landing page'); this is a minor, UI-only gap not worth its own Annotation given how narrow it is — noted here rather than escalated." ;
	<urn:solutiondesign:ontology:requirementId> "1.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:MiLoginSystem> ;
	<urn:solutiondesign:ontology:statement> "As a Member of the public, I want to view distinct login options for Citizens and Business users on the MiEdWorkforce public landing page, so that I am redirected to the correct MiLogin portal for my user type." ;
	<urn:solutiondesign:ontology:title> "Public landing page shows distinct Citizen/Business login options, no Worker option" .

<urn:solutiondesign:instance:iam:Req_01_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system validates the authentication token originates specifically from the MiLogin for Workers platform." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted. See Question_WorkerOnboardingNotFullyModeled below — grouped with 1.2.2/1.2.3 since all three describe the same Worker-specific post-authentication handling that iam-sequences.ttl's Seq_MiLoginAuthenticationIntegration does not actually implement as described." ;
	<urn:solutiondesign:ontology:requirementId> "1.2.1" ;
	<urn:solutiondesign:ontology:statement> "(No 'As a...' stem is present in the visible document text for this item — see this file's header note on comment 144560476/42: the story was rewritten mid-review to describe a manual, paper-form-only Worker onboarding process, but the visible AC was left as a single bare validation statement.)" ;
	<urn:solutiondesign:ontology:title> "Worker authentication token validated as MiLogin-for-Workers-originated" .

<urn:solutiondesign:instance:iam:Req_01_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upon successful login by a new Worker user, the system defaults the account to having zero functional permissions/roles. The system prevents the Worker user from accessing any functional dashboards, search tools, or data entry screens until a role is explicitly assigned by an administrator. The system bypasses the 'Security Authorization Form' workflow used by Business users (Worker authorization is handled via offline paper forms)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted: iam-sequences.ttl's Seq_MiLoginAuthenticationIntegration routes a Worker with no existing authorizations and no Lead Admin status to the SAME 'authorization request form' branch as a Business user with no special-casing for 'bypass the e-form entirely, land on a zero-permission Pending Access state instead' — this is exactly what the FDD asks for and exactly what the currently-modeled sequence does not do. See Question_WorkerOnboardingNotFullyModeled." ;
	<urn:solutiondesign:ontology:requirementId> "1.2.2" ;
	<urn:solutiondesign:ontology:statement> "As a System Administrator, I want the system to prevent automatic permission granting for Worker accounts, so that state employees only access data after the offline approval process is complete." ;
	<urn:solutiondesign:ontology:title> "No automatic permission granting for Worker accounts" .

<urn:solutiondesign:instance:iam:Req_01_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system makes the newly authenticated Worker account visible in the User Account search. The system allows the Admin to identify the user specifically as a 'MiLogin for Workers' type. The system allows the Admin to assign worker-specific groups and roles to the account. The system captures audit details (Modified By/Date) when the Worker's permissions are updated from the pending state." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Reasonably satisfied, unlike 1.2.1/1.2.2: Op_SearchUsers (scope-sensitive admin search) plus Seq_SystemAdminManualGrant (admin directly grants an Authorization, bypassing approval, with a required justification/audit trail — 'Record manual grant in audit log') together implement the search + manual-assign + audit-capture behavior asked for here. 'identify the user specifically as MiLogin for Workers' is implicit in VO_MiLoginIdentity's type field, not a documented distinct search filter on Op_SearchUsers — a minor gap. 'worker-specific groups' repeats the Group-layer terminology covered by Question_NoUserGroupLayerContradiction; the Role-assignment half of this story is what's actually satisfied." ;
	<urn:solutiondesign:ontology:requirementId> "1.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ManualGrantAuthorization> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SearchUsers> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_SystemAdminManualGrant> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce Admin, I want to be able to locate accounts established via MiLogin for Workers, so that I can manually assign the specific permissions approved via the offline security process." ;
	<urn:solutiondesign:ontology:title> "Admin locates and manually assigns permissions to Worker accounts" .

<urn:solutiondesign:instance:iam:Req_01_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system does not display a 'MiLogin for Workers' link/button on the public-facing MiEdWorkforce landing page. The Worker logs into the external MiLogin for Workers platform to view their available State of Michigan applications. When a worker selects 'MiEdWorkforce' from the MiLogin for Workers application list, the system accepts the redirection and validates the authentication token." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "The core OIDC redirect-and-validate flow is a direct match to Seq_MiLoginAuthenticationIntegration's generic 'any user (Citizen/Business/Worker)' description. The 'no public landing-page link for Workers' half shares Req_01_1_3's minor UI-only gap, not re-raised separately." ;
	<urn:solutiondesign:ontology:requirementId> "1.2.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:MiLoginSystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_MiLoginAuthenticationIntegration> ;
	<urn:solutiondesign:ontology:statement> "As a State of Michigan Worker, I want to initiate my session directly through the MiLogin for Workers platform, so that I am authenticated securely without a public login link." ;
	<urn:solutiondesign:ontology:title> "Worker initiates session via MiLogin for Workers only" .

<urn:solutiondesign:instance:iam:Req_01_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system displays a searchable list of existing user groups. The list displays the associated MiLogin type (Citizen, Business, or Worker) for each group. The system allows the administrator to filter the list by MiLogin type. The system restricts access to this page to users with the MiEdWorkforce System Administrator role." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_NoUserGroupLayerContradiction below. wireframe-04 (viewed) shows this exact 'Groups' admin list screen (Group Name/Group Description, with Create/Edit/Delete), embedded at this precise location in the document — a fully wireframed feature for a concept the domain explicitly decided not to model." ;
	<urn:solutiondesign:ontology:requirementId> "1.3.1" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to access an administrative page to view a list of all defined user groups, so that I can monitor the high-level categorization of users within the system." ;
	<urn:solutiondesign:ontology:title> "View list of defined user groups" .

<urn:solutiondesign:instance:iam:Req_01_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an option to 'Create Group'. When creating or editing a group, the system requires the administrator to define the Group Name and associate it with a specific MiLogin Type (Citizen, Business, or Worker). The system allows the administrator to edit the name of an existing group. The system logs all creation and modification of user groups with the user ID and timestamp for audit purposes." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_NoUserGroupLayerContradiction below." ;
	<urn:solutiondesign:ontology:requirementId> "1.3.2" ;
	<urn:solutiondesign:ontology:reviewStatus> "Needs Discussion" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to add new user groups or edit existing ones, so that I can adapt the system structure if organizational needs change (e.g., splitting an admin group into two)." ;
	<urn:solutiondesign:ontology:title> "Add or edit user groups" .

<urn:solutiondesign:instance:iam:Req_01_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system prevents a user group from being associated with more than one MiLogin type. The system allows a user to be assigned to multiple groups only if all assigned groups belong to the same MiLogin type. The system prevents the assignment of a group to a user if the group's MiLogin type does not match the user's account type." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Partially satisfied by an analogous-but-different mechanism: iam:VO_ApplicableMiLoginTypes on Role (not on a Group layer) already enforces 'this Role may only be assigned under these MiLogin identity types' at grant time, and Rule_MiLoginContextEnforcement enforces the same boundary at query time. The underlying intent (don't let a Business-only construct attach to a Citizen account) is achieved via Role, exactly as iam:RoleDefinitionAggregate's own notes describe as the deliberate replacement for a Group layer — this Requirement is satisfied in spirit but the FDD's own 'group' vocabulary doesn't exist. Also targeted by Question_NoUserGroupLayerContradiction below for that terminology mismatch." ;
	<urn:solutiondesign:ontology:requirementId> "1.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_MiLoginContextEnforcement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_ApplicableMiLoginTypes> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want the system to enforce MiLogin type consistency for user groups, so that users are only organized into groups compatible with their authentication method." ;
	<urn:solutiondesign:ontology:title> "Enforce MiLogin type consistency for user groups" .

<urn:solutiondesign:instance:iam:Req_01_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system displays a search interface allowing the administrator to query by MiLogin ID, MiLogin Type, First Name, Last Name, and Email. The search results list displays all users matching the criteria, including those with established roles and those with pending access requests. The results list indicates the MiLogin Type (Citizen, Business, or Worker) for each user. The system allows the administrator to select a user record to view their current details and assigned permissions." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match. Per iam-api.ttl's own honest-gap note, Op_SearchUsers/Op_GetUser have no standalone sd:producesShape (no User DomainEntity/Aggregate is modeled in this domain — identity lives on MiLoginIdentity/Authorization instead); that's a pre-existing, already-documented gap, not newly introduced by this FDD. Comment thread 2058739645/189499350 (see this file's header note) confirms the wireframe near this story is a deliberately-reused generic search/list screen, not this feature's literal final UI — noted for context, doesn't change the satisfiedBy assessment." ;
	<urn:solutiondesign:ontology:requirementId> "1.4.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_GetUser> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SearchUsers> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Perm_UserView> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to search for and view user accounts within the system, so that I can locate specific individuals to manage their access permissions." ;
	<urn:solutiondesign:ontology:title> "Search for and view user accounts" .

<urn:solutiondesign:instance:iam:Req_01_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upon selecting a user, the system allows the administrator to add or remove User Groups (e.g., Credential, Staffing, EPP). Within a selected Group, the system allows the administrator to assign specific Roles defined in the Role Matrix. The system allows a user to be assigned to multiple Groups and Roles simultaneously. The system logs the date, time, and administrator ID for any changes made to user permissions." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: the Role-assignment half (assign specific Roles, audit-logged, multiple simultaneously) is satisfied by Op_ManualGrantAuthorization/Seq_SystemAdminManualGrant and RoleDefinitionAggregate directly. The 'add or remove User Groups' half has no backing node at all — see Question_NoUserGroupLayerContradiction (this Requirement is one of its targets). Kept in the Satisfied state overall since a real, substantial part of it is genuinely implemented; the Group-layer gap is called out via the contradiction Annotation rather than a second, separate coverage-gap Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "1.4.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ManualGrantAuthorization> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:RoleDefinitionAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to assign specific User Groups Roles to a user account, so that the user has the appropriate functional permissions to perform their tasks." ;
	<urn:solutiondesign:ontology:title> "Assign User Groups and Roles to a user account" .

<urn:solutiondesign:instance:iam:Req_01_4_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "When assigning a Group, the system validates the Group's MiLogin Type against the user's account type. The system displays an error if a mismatch is detected (e.g., assigning a Business group to a Citizen user). The system blocks the assignment until a compatible group is selected." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Same analogous-mechanism satisfaction as Req_01_3_3: the compatibility CHECK exists (via Role's ApplicableMiLoginTypes, not a Group's), just not against the 'Group' vocabulary this story uses. Also targeted by Question_NoUserGroupLayerContradiction." ;
	<urn:solutiondesign:ontology:requirementId> "1.4.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_RoleScopeAssignmentCompatibility> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_ApplicableMiLoginTypes> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want the system to prevent assignment of User Groups that do not match the user's MiLogin Type, so that users are not granted incompatible permissions." ;
	<urn:solutiondesign:ontology:title> "Prevent assignment of MiLogin-type-incompatible User Groups" .

<urn:solutiondesign:instance:iam:Req_01_4_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system allows the administrator to search for and select educational entities (School District, EPP, etc.) from the EEM to link to an existing Business user. The system allows the administrator to add or remove entity associations for the user. The system requires a Role to be defined for each Entity association. Any changes made by the System Admin are logged in the audit history." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match: Seq_SystemAdminManualGrant's own flow (search organization via the Organizations API, select roles, submit with required justification, audit-logged) is exactly 'add' half of this story; Op_RevokeAuthorization covers the 'remove' half. 'Requires a Role to be defined for each Entity association' matches the Authorization aggregate's own shape (Scope + Role pairing) directly." ;
	<urn:solutiondesign:ontology:requirementId> "1.4.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ManualGrantAuthorization> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_RevokeAuthorization> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_SystemAdminManualGrant> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:Op_SearchOrganizations> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to manage or update a Business user's entity associations, so that I can correct access issues or handle exceptions outside the standard security form process." ;
	<urn:solutiondesign:ontology:title> "Manage a Business user's entity associations" .

<urn:solutiondesign:instance:iam:Req_01_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system displays a searchable table of all User Roles. The table includes columns for Role Name, associated User Group, and MiLogin Type (Citizen, Business, Worker). The system provides filters to view roles specific to a User Group (e.g., Credentialing, Staffing) or MiLogin Type." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: Op_ListRoles/iam:Entity_Role plus VO_ApplicableMiLoginTypes satisfy the Role-list-by-MiLogin-Type half; the 'associated User Group' column/filter has no backing concept — see Question_NoUserGroupLayerContradiction (this Requirement is one of its targets)." ;
	<urn:solutiondesign:ontology:requirementId> "1.5.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ListRoles> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_ApplicableMiLoginTypes> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to view a list of all existing user roles categorized by User Group and MiLogin Type, so that I can audit the current access configurations in the system." ;
	<urn:solutiondesign:ontology:title> "View list of user roles by Group and MiLogin Type" .

<urn:solutiondesign:instance:iam:Req_01_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system provides an 'Add ' function. The user must define a unique Role Name. The user must select the associated User Group (e.g., EPP, School District) and MiLogin Type. The system validates that the selected User Group is compatible with the selected MiLogin Type before saving." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted: iam-api.ttl has no create/update/delete Role operation at all — only Op_ListRoles (GET) and Op_GetRole (GET). This is a genuine, structural gap independent of the Group-layer issue: iam:Entity_Role's own description states a Role is a 'Named collection of permissions (system-defined, not user-created)' — meaning the domain model's own documented intent is that Roles are NOT admin-created via a UI like this story asks for at all, a second, distinct contradiction layered on top of the User-Group one. See Question_RoleCrudNotModeled below. wireframe-05 (viewed, embedded at exactly this story) turns out to be a Staffing 'Positions' list screen, not a Role-creation form — direct visual confirmation of the reused-wireframe review-comment thread (id 2058739645) described in this file's header, and itself evidence that this admin capability was never concretely designed either." ;
	<urn:solutiondesign:ontology:requirementId> "1.5.2" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to create a new User Role and associate it with a specific User Group, so that I can establish a new permission set for a specific category of users." ;
	<urn:solutiondesign:ontology:title> "Create a new user role" .

<urn:solutiondesign:instance:iam:Req_01_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "When configuring a role, the system displays a list of developer-defined Functional Areas (e.g., Credentialing, Staffing). Upon selecting a Functional Area, the system displays the specific Functions available within that area (e.g., Worklists, Upload Management). The system allows the administrator to assign specific Permissions (e.g., View, Edit, Add, None) to each Function for the role being configured. The system prevents the administrator from creating new Functional Areas or Functions (these are code-based/developer-maintained)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — same Role-CRUD gap as 1.5.2, see Question_RoleCrudNotModeled. Also worth noting: this story's own last AC line ('prevents the administrator from creating new Functional Areas or Functions... code-based/developer-maintained') already partially concedes the same point iam:Entity_Role's description makes about Roles themselves being system-defined — the FDD is not fully consistent within itself about how much of the permission-bundling model is admin-configurable vs. developer-fixed." ;
	<urn:solutiondesign:ontology:requirementId> "1.5.3" ;
	<urn:solutiondesign:ontology:reviewStatus> "Dropped" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to add functions to a role, so that the role is granted precise access to specific system capabilities. (Visible text reads '...I want to to a role...' — a tracked-change/edit artifact in the source; 'add functions' is the clear intent from the surrounding acceptance criteria.)" ;
	<urn:solutiondesign:ontology:title> "Add functions/permissions to a role" .

<urn:solutiondesign:instance:iam:Req_01_5_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system allows the administrator to select an existing role and modify its assigned Functional Areas, Functions, and Permissions. The system allows the administrator to rename the role. The system prevents modification of the underlying User Group or MiLogin Type for an established role. The system captures audit details (Modified By/Date) for any changes made to the role's configuration." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — same Role-CRUD gap, see Question_RoleCrudNotModeled." ;
	<urn:solutiondesign:ontology:requirementId> "1.5.4" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to edit the permission mappings for an existing role, so that I can adjust user access as business requirements evolve." ;
	<urn:solutiondesign:ontology:title> "Edit permission mappings for an existing role" .

<urn:solutiondesign:instance:iam:Req_01_6_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upon successful authentication from the MiLogin for Business platform, the system checks if the user has an existing MiEdWorkforce account. If no account exists, the system redirects the user to the Security Authorization Form landing page. The system pre-populates the 'MiLogin Account Info' section (ID, Name, Email, Phone) using data passed from the MiLogin token. The system prevents the user from navigating to the main dashboard until a security request has been submitted and approved." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: the routing check ('has existing authorizations for this MiLogin type') and the pre-population data (VO_MiLoginIdentity carries type/ID/email) both line up well." ;
	<urn:solutiondesign:ontology:requirementId> "1.6.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserInitialAuthorizationRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_MiLoginAuthenticationIntegration> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_MiLoginIdentity> ;
	<urn:solutiondesign:ontology:statement> "As a MiLogin for Business user, I want to be automatically directed to the Security Authorization Form upon my first login, so that I can initiate the process of establishing my access to the system." ;
	<urn:solutiondesign:ontology:title> "Business user auto-directed to Security Authorization Form on first login" .

<urn:solutiondesign:instance:iam:Req_01_6_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The form allows the user to search for and select an Entity (ISD, District, Building, or Nonpublic School) sourced from the Educational Entity Master (EEM). The user may select multiple Buildings within the same District, but may only select one ISD or District per request. The system allows the user to multi-select specific roles/permissions being requested for the selected entity. The user must provide a text justification for the access request. The user must agree to the system attestation before the 'Submit Request' button is enabled." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match on organization search + role selection + justification (the sequence's own steps: 'Search for Organization', 'Select Organization, roles, justification', 'Submit request'). The multi-Building-single-District/ISD selection nuance and the attestation/e-sig checkbox are not individually broken out as separate fields anywhere in iam-domain.ttl (VO_AuthScope only holds one scope reference) — a minor, narrower-than-the-story gap, not raised separately given how much of the story is otherwise covered." ;
	<urn:solutiondesign:ontology:requirementId> "1.6.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SubmitAuthorizationRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserInitialAuthorizationRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:Op_SearchOrganizations> ;
	<urn:solutiondesign:ontology:statement> "As a MiLogin for Business user, I want to search for my organization and select the roles I need, so that I can submit a request for access to the appropriate Lead Administrator." ;
	<urn:solutiondesign:ontology:title> "Search organization and select roles for access request" .

<urn:solutiondesign:instance:iam:Req_01_6_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upon form submission, the system queries the EEM to identify the designated Lead Administrator (e.g., Superintendent) for each selected entity. The system generates a unique, time-bound 'magic link' for the request. The system sends an email notification to the Lead Administrator's email address (sourced from EEM) containing the magic link. If the user selects multiple entities belonging to different Lead Admins, the system splits the request and sends separate notifications to each respective Lead Administrator." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match for the single-entity case (Lead Admin lookup via the Organizations API, single-use time-bound approval link, matching Rule_AuthorizationApprovalRouting/Rule_ApprovalLinkExpiration almost exactly). The 'splits the request across multiple Lead Admins for multiple entities' branch is not shown in Seq_BusinessUserInitialAuthorizationRequest's diagram (which models one organization per request) — a real but narrow gap, not raised as a separate Annotation since the dominant single-entity path is solidly covered." ;
	<urn:solutiondesign:ontology:requirementId> "1.6.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_ApprovalLinkExpiration> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_AuthorizationApprovalRouting> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserInitialAuthorizationRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:Op_GetOrganizationsByLeadAdmin> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to identify the correct Lead Administrator for the selected entity and send them a secure approval link, so that they can approve the request without needing a MiEdWorkforce account." ;
	<urn:solutiondesign:ontology:title> "Identify Lead Administrator and send secure approval link" .

<urn:solutiondesign:instance:iam:Req_01_6_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "When the Lead Administrator selects to 'Approve,' the system automatically creates a user's account in MiEdWorkforce. The system assigns the approved Entity and Roles/Permissions to the user's account immediately. The system sends a confirmation email to the Business User notifying them that access has been granted. If the Lead Administrator modifies the requested roles before approving, the system provisions only the roles explicitly approved by the Administrator." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match: Seq_ScopeApproverApproves explicitly models the role-modification-before-approval step ('opt Modify roles... Validate modified roles are compatible with scope') and immediate Authorization creation on approval." ;
	<urn:solutiondesign:ontology:requirementId> "1.6.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ApproveAuthorizationRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_ScopeApproverApproves> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want an account to be automatically provisioned upon approval, so that a user can immediately access the system functionality required for their job." ;
	<urn:solutiondesign:ontology:title> "Auto-provision account on Lead Administrator approval" .

<urn:solutiondesign:instance:iam:Req_01_7> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:requirementId> "1.7" ;
	<urn:solutiondesign:ontology:statement> "The reporting needs described under Feature 1.7: User Authorization Reports are already fully addressed by the user stories defined in Feature 2.1: Reporting Framework Implementation. Feature 2.1 explicitly includes the required user authorization reports and establishes the global reporting capabilities and architecture (including export options and Power BI-based ad-hoc reporting). To avoid redundancy and maintain consistency with the approved reporting framework, separate user stories for Feature 1.7 are not needed." ;
	<urn:solutiondesign:ontology:title> "User Authorization reports — deferred to Feature 2.1" .

<urn:solutiondesign:instance:iam:Req_01_8_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system allows the administrator to search for a citizen user by Unique ID, Name, or Account Number. Upon selecting a user, the system provides an option to 'View As' or 'Impersonate' the user. The system renders the user's view, including their Dashboard, User Profile, and in-progress Credential Applications. The system displays a visual indicator (e.g., banner) that the administrator is currently viewing the system as another user." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_ImpersonationFeatureContradictsOmission below. wireframe-06 (viewed) shows exactly this 'View System as User' link on a citizen record's Actions panel, alongside a struck-through 'Send Reset Password' action — direct visual confirmation this is a specifically-designed feature, not vague narrative text." ;
	<urn:solutiondesign:ontology:requirementId> "1.8.1" ;
	<urn:solutiondesign:ontology:reviewStatus> "Dropped" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to search for a citizen user and view the system from their perspective, so that I can troubleshoot issues with credential applications or profiles without logging in as them." ;
	<urn:solutiondesign:ontology:title> "Admin searches citizen user and views the system as them (impersonation)" .

<urn:solutiondesign:instance:iam:Req_01_8_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system allows the administrator to enter an Entity Code or Entity Name to access the data view for that business entity. The system displays the temporary credential applications, employee rosters, and district reports associated with that entity. If the impersonated user has access to multiple entities, the system allows the administrator to toggle between the entities using the global filter available to the user. The system logs the start and end of the entity view session in the audit log." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — same impersonation feature as 1.8.1, extended to entity/Business-user context. See Question_ImpersonationFeatureContradictsOmission below." ;
	<urn:solutiondesign:ontology:requirementId> "1.8.2" ;
	<urn:solutiondesign:ontology:reviewStatus> "Dropped" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to view the system context for a specific Business User or Entity, so that I can see district-level reports, rosters, and applications exactly as the business user sees them." ;
	<urn:solutiondesign:ontology:title> "Admin views system context for a Business User or Entity" .

<urn:solutiondesign:instance:iam:Req_01_8_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "While in 'View As' mode, the system allows the administrator to navigate to pages where the user has entered data. The system displays any error messages or validation flags currently visible to the user. The system disables or blocks all 'Submit,' 'Save,' and 'Delete' actions (Read-Only). The system allows UI-based manipulations (e.g., changing filters, expanding rows) to view data, provided no database changes occur." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted. Notably, this story's own read-only design (view/search allowed, all mutations blocked) is materially the SAME design iam-technical-design.ttl's iam:Question_UserImpersonationOmission already describes iam-technical-visual-summary.md's 'Impersonation: Read-Only Mode' diagram as proposing — meaning this isn't merely an unimplemented idea, it is the specific, already-evaluated, already-excluded idea. See Question_ImpersonationFeatureContradictsOmission below." ;
	<urn:solutiondesign:ontology:requirementId> "1.8.3" ;
	<urn:solutiondesign:ontology:reviewStatus> "Dropped" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System Administrator, I want to view user-entered data and validation errors without the ability to save changes, so that I can diagnose submission blockers without altering the user's record." ;
	<urn:solutiondesign:ontology:title> "Admin views user-entered data and errors without saving (read-only impersonation)" .

<urn:solutiondesign:instance:iam:Req_01_8_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Credential Admin can only initiate 'View As' sessions for users in the Credential or Citizen groups. The Staffing Admin can only initiate 'View As' sessions for users in the School District/Staffing groups. The MiEdWorkforce System Admin can initiate 'View As' sessions for all user types. The Identity Admin is restricted from initiating 'View As' sessions." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd01Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — same impersonation feature, with a role-based access matrix on top. Also uses the 'groups' vocabulary from Question_NoUserGroupLayerContradiction ('Credential or Citizen groups', 'School District/Staffing groups'), though that terminology overlap is secondary to the larger impersonation-omission contradiction here; not double-counted as a separate target of that other Annotation given how narrow the overlap is. See Question_ImpersonationFeatureContradictsOmission below." ;
	<urn:solutiondesign:ontology:requirementId> "1.8.4" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to restrict 'View As' capabilities based on the administrator's functional role, so that admins only view users relevant to their domain." ;
	<urn:solutiondesign:ontology:title> "Restrict View As capability by administrator's functional role" .

<urn:solutiondesign:instance:iam:Req_15_10_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Navigate Account Details > Personal Information > Update personal information; Unique ID always read-only; demographic fields pre-populated, SSN masked to last 4; Attestation required before Submit enabled; business-rule validation on submit blocks Mi-Key send on error." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, near-verbatim match to Seq_CitizenUpdateAccountDemographics's own opening steps." ;
	<urn:solutiondesign:ontology:requirementId> "15.10.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SubmitCitizenAccountUpdate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenUpdateAccountDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User, I want to access and update my demographic data on my personal information page, so that my identity record remains current and accurate." ;
	<urn:solutiondesign:ontology:title> "Citizen updates their own demographic data" .

<urn:solutiondesign:instance:iam:Req_15_10_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "When associated with active employment, primary demographic fields (Legal Name, SSN, DOB) are read-only; message directs the user to contact their district." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the sequence's own 'Active employment gates Primary fields' keyDecision." ;
	<urn:solutiondesign:ontology:requirementId> "15.10.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenUpdateAccountDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User with active employment, I need to be restricted from altering my primary demographic data directly, so that my school district maintains accountability for core employment records." ;
	<urn:solutiondesign:ontology:title> "Primary demographic fields locked for citizens with active employment" .

<urn:solutiondesign:instance:iam:Req_15_10_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "If No SSN and not actively employed, user can uncheck No SSN and enter SSN/Confirm SSN; if an SSN already exists, the No SSN checkbox does not appear at all." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — this is the citizen-self-service mirror of Req_15_9_7's admin-side variant, both backed by the same VO/rule." ;
	<urn:solutiondesign:ontology:requirementId> "15.10.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_NoSSNCitizenAccounts> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_NoSSNStatus> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User who initially created an account without an SSN and does not have active employment, I want to add my newly acquired SSN, so that my profile is complete for future credentialing or employment." ;
	<urn:solutiondesign:ontology:title> "Citizen without active employment adds a previously-missing SSN" .

<urn:solutiondesign:instance:iam:Req_15_10_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Near Match, do not apply the update or show match options; route a Requires Resolution task; notify the user the request is pending; lock Primary/Secondary fields; leave Contact fields unlocked; user can view and cancel the pending request." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, exact match — iam-sequences.ttl's own keyDecision on Seq_CitizenUpdateAccountDemographics states the identical Primary/Secondary-locked-but-Contact-editable rule, and a source-document review comment on this exact story explicitly confirms this same field-level distinction ('Contact fields... will remain unlocked... Primary and Secondary Identity fields will be locked')." ;
	<urn:solutiondesign:ontology:requirementId> "15.10.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenCancelPendingUpdate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenUpdateAccountDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User, I want to be notified if my demographic update requires administrative review (Near Match) and have my profile temporarily locked, so that conflicting updates are prevented while my identity is verified." ;
	<urn:solutiondesign:ontology:title> "Citizen notified of Near Match on update, with field-level locking" .

<urn:solutiondesign:instance:iam:Req_15_10_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Send to Mi-Key Assignment service; on Match, update non-matching fields; notify citizen (no field-level detail); if active employment and Secondary fields changed, notify the employing district(s) automatically." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, including the conditional district-notification branch ('Active employment AND Secondary fields changed... Notify employing district(s) of update')." ;
	<urn:solutiondesign:ontology:requirementId> "15.10.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:PersonRecordUpdatedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenUpdateAccountDemographics> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must process validated demographic updates through Mi-Key and notify relevant parties, so that the Master Record remains accurate across all state systems." ;
	<urn:solutiondesign:ontology:title> "System processes validated citizen updates through Mi-Key and notifies parties" .

<urn:solutiondesign:instance:iam:Req_15_11_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Business Users cannot request a Split from the MiEdWorkforce UI; when an Admin splits an ID directly in Mi-Key, MiEdWorkforce receives the callback with the new ID and updates the person record; Admins/DBAs manually separate associated credential/employment history on the backend." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, exact match — iam-domain.ttl's IdentityResolutionRequestAggregate notes already cite this exact FDD feature by number ('Split ID and Retire ID are explicitly NOT modeled as requests here (FDD 15.6/15.11 Addendum) — both are Admin/Mi-Key-direct actions with no business-user-facing submission; MiEdWorkforce only receives the resulting callback/event') — this is the FDD passage that decision was built from." ;
	<urn:solutiondesign:ontology:requirementId> "15.11.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityRecordSplitEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_SplitRetireIdMiKeyDirect> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Admin, I need to execute ID splits directly in the Mi-Key backend rather than through a Business User UI request, so that complex historical data separation is handled securely by administrators." ;
	<urn:solutiondesign:ontology:title> "Identity Admin executes ID splits directly in Mi-Key, not via a business-user UI" .

<urn:solutiondesign:instance:iam:Req_15_12_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Submitting a Retired ID for data collection/employment throws an error requiring update to the primary ID; a searched Retired ID clearly shows inactive/retired status, its linked Primary ID, and cannot be selected for use." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the sequence's own keyDecision ('A Retired Unique ID must be rejected if submitted anywhere in MiEdWorkforce afterward — staffing's responsibility on consuming these events'). Per the FDD's own text, Retire ID's business-user-facing request workflow (worklist, approve/deny, justification) is explicitly marked 'not required for minimal viable product' and may not be built at all — that larger conditional-scope workflow itself is not modeled (correctly matching the domain's own scope decision, not a gap)." ;
	<urn:solutiondesign:ontology:requirementId> "15.12.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityRecordRetiredEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_SplitRetireIdMiKeyDirect> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must prevent users from submitting or utilizing a 'Retired' ID, so that inactive records do not accumulate new data." ;
	<urn:solutiondesign:ontology:title> "Prevent use of a Retired Unique ID" .

<urn:solutiondesign:instance:iam:Req_15_13> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:requirementId> "15.13" ;
	<urn:solutiondesign:ontology:statement> "For identity management and processing, the system will use the framework for email communications (Business Specification #6, Alerts, Emails and Communications) to allow the Identity Management Administrator to create/manage email templates, set effective dates, set recipient roles, define triggers, and view historical usage. All underlying logic for sending, tracking, and displaying emails/alerts/notifications is derived from Business Specification #6; Business Specification #4 (Business Rule Management) specifies when and to whom notifications are sent. This feature is strictly limited to configuring those tools for the Identity Management module." ;
	<urn:solutiondesign:ontology:title> "Identity-specific email/comms configuration — out of scope for iam, owned by Communications + Business Rule Management" .

<urn:solutiondesign:instance:iam:Req_15_14> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:requirementId> "15.14" ;
	<urn:solutiondesign:ontology:statement> "This feature was created to account for the potential need for MiEdWorkforce to migrate and convert 'Person' data into the system database. It has been determined that MiEdWorkforce will not have additional migration and conversion needs beyond what the Mi-Key and Data Warehouse teams (or full system migration/conversion plans) already handle." ;
	<urn:solutiondesign:ontology:title> "ID Migration & Conversion — withdrawn, no longer necessary" .

<urn:solutiondesign:instance:iam:Req_15_15> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:requirementId> "15.15" ;
	<urn:solutiondesign:ontology:statement> "This feature was created to allow citizens to upload supporting documentation during account creation to support identity management processes. Through process definition, it was determined that document upload was not a necessary component for processing, and thus this feature is no longer necessary." ;
	<urn:solutiondesign:ontology:title> "Citizen File Upload — withdrawn, no longer necessary" .

<urn:solutiondesign:instance:iam:Req_15_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Record displays read-only initially; 'Edit Account Information' unlocks all demographic fields except Unique ID (always read-only); SSN pre-populated masked (last 4 digits) with ability to clear and re-enter; 'No SSN' checkbox shown only when no SSN exists on record; Submit disabled until at least one field changed and Attestation checked." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Satisfied at the aggregate/API level: iam-api.ttl's Op_SubmitBusinessUserIdentityRequest is generic across RequestType (NewId/DemographicUpdate/LinkId), and iam-domain.ttl's IdentityResolutionRequestAggregate notes explicitly lists 'BusinessUserStaffing+DemographicUpdate' as a covered combination. However, unlike NewId (which has its own named iam:Seq_BusinessUserRequestNewId diagram), no dedicated Sequence diagram exists for the DemographicUpdate variant of this same flow — a minor documentation-completeness gap, not a functional one, since the API/aggregate genuinely supports it end to end. The specific UI mechanics (read-only-until-Edit-clicked, masked SSN re-entry, conditional No-SSN checkbox) are presentation-layer detail this domain's API-level model doesn't individually capture, same class of gap as FDD 01's UI-only findings." ;
	<urn:solutiondesign:ontology:requirementId> "15.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SubmitBusinessUserIdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_NoSSNStatus> ;
	<urn:solutiondesign:ontology:statement> "As a Business User with an Identity Management Role, I want to access an employee's record from the Employee Roster and unlock it for editing so that I can correct inaccurate data or update changed information based on verified documentation." ;
	<urn:solutiondesign:ontology:title> "Business user unlocks an employee record for demographic editing" .

<urn:solutiondesign:instance:iam:Req_15_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Trigger Business Rule Engine validation on submit; on failure, stop, show errors, do not send to Mi-Key or persist; on pass, temporarily store and parse the Mi-Key-relevant subset; send via the Mi-Key synchronous Assignment service." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the aggregate's own invariant-driven lifecycle (PendingMiKeyMatch state, VO_SubmittedDemographics as 'temporarily stored; not permanently retained if validation fails'). The specific field-by-field validation ruleset itself lives only in Identity Validations.xlsx (read for context, not separately modeled per this file's header note) — the RULE CONTENT is an honest gap in the graph (no per-field business-rule catalog), but the validate-then-gate-Mi-Key-submission BEHAVIOR is fully modeled." ;
	<urn:solutiondesign:ontology:requirementId> "15.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_SubmittedDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to validate submitted demographic updates against defined business rules before transmitting to Mi-Key so that only valid and properly formatted data is processed for identity matching." ;
	<urn:solutiondesign:ontology:title> "Validate demographic updates against business rules before transmitting to Mi-Key" .

<urn:solutiondesign:instance:iam:Req_15_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Match, update non-matching fields on the Master Record, finalize temporary storage, notify submitting user (no field-level detail) and any associated citizen account. On Near Match, do not update; set status to Requires Resolution." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match: PersonRecordUpdatedEvent's own trigger ('AccountUpdate or DemographicUpdate request resolves to Match') and payload are exactly this; near-match handling routes to the same self-resolve/escalate machinery iam:Rule_BusinessUserNearMatchSelfResolution already documents." ;
	<urn:solutiondesign:ontology:requirementId> "15.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequiresReviewEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:PersonRecordUpdatedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_BusinessUserNearMatchSelfResolution> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to process the matching results returned from Mi-Key so that the individual's Master Record is updated or flagged for resolution if the match is ambiguous." ;
	<urn:solutiondesign:ontology:title> "Process Mi-Key match/near-match results for a demographic update" .

<urn:solutiondesign:instance:iam:Req_15_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Person Search interface as first step of Add New Employee; search by Unique ID (exact) or demographic fields (Name/SSN/CLN); results table with pre-populate-on-select; Add New Record option when no match found." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — this is the same Person Search capability targeted by Feature 15.4 below and shares its gap: no dedicated Person/Identity search surface (distinct from iam:Op_SearchUsers, which searches MiEdWorkforce user accounts, not the broader universe of identity records including non-portal individuals) exists anywhere in iam-api.ttl. See Question_PersonSearchNotModeled below. A source-document comment on this story cross-references '24.2.1,' i.e. FDD 24 (Data Collection & Compliance — Request for ID, an FDD not yet reviewed/mapped per GAPS.md), flagging a live duplicate-effort risk between the two FDDs' own Request-for-ID processes — noted for whoever reviews FDD 24." ;
	<urn:solutiondesign:ontology:requirementId> "15.2.1" ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to search for an individual using their Unique ID or demographic information so that I can identify if they already have a Unique ID before creating a duplicate record." ;
	<urn:solutiondesign:ontology:title> "Search for an individual before creating a duplicate record" .

<urn:solutiondesign:instance:iam:Req_15_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add Employee form (empty or pre-populated); required identity fields validated; 'No SSN' checkbox disables SSN/Confirm SSN when checked; Attestation required before Submit enabled; business-rule validation on submit blocks Mi-Key send on error." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to Op_SubmitBusinessUserIdentityRequest (type=NewId) and the aggregate's own submission/validation lifecycle. Rule_NoSSNCitizenAccounts is named for citizen accounts in iam-domain.ttl but its 'No SSN' mechanics (VO_NoSSNStatus, Student Intern/Credential Applicant restriction) are the identical mechanism this story asks for on the business-user/employee side — the rule's own statement is citizen-scoped in iam-domain.ttl's prose, a minor naming-scope note rather than a gap, since the VO/behavior itself is origin-agnostic." ;
	<urn:solutiondesign:ontology:requirementId> "15.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SubmitBusinessUserIdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_NoSSNCitizenAccounts> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_NoSSNStatus> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to enter and submit the demographic details for a new employee so that a Unique ID can be assigned or created for the individual." ;
	<urn:solutiondesign:ontology:title> "Submit new-employee demographic details for Unique ID assignment" .

<urn:solutiondesign:instance:iam:Req_15_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Send validated data to Mi-Key Assignment Service; on Match, update non-matching Master Record fields and assign the returned Unique ID to the Employee Roster; on No Match, accept and assign the newly created Unique ID; notify user of outcome." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match: Seq_BusinessUserRequestNewId's Match/No-Match branches are this story almost verbatim, including the 200/201 status distinction and the Staffing-side note that the EmployeeRoster attachment happens 'on IdentityResolutionCompleted.'" ;
	<urn:solutiondesign:ontology:requirementId> "15.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionCompletedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserRequestNewId> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to process the submitted employee data through the Mi-Key Assignment service so that a Unique ID is either located or created and assigned to the employee roster." ;
	<urn:solutiondesign:ontology:title> "Process new-employee submission through Mi-Key Assignment service" .

<urn:solutiondesign:instance:iam:Req_15_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Near Match during citizen account creation: do not display potential matches (PII protection); show a review-pending notification; block dashboard access; auto-create a Requires Resolution task in the Identity Administrator Worklist." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match — Seq_CitizenInitialSignIn's own Near Match branch and Rule_CitizenNearMatchResolution's statement ('the citizen never sees candidate match data... flagged for Identity Administrator review') are this story verbatim, down to the same 15.8-cross-referenced 'Requires Review' framing." ;
	<urn:solutiondesign:ontology:requirementId> "15.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequiresReviewEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_CitizenNearMatchResolution> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenInitialSignIn> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User, I want to be notified if my account creation request requires manual review due to identity matching issues so that I understand why I cannot immediately access the MiEdWorkforce dashboard." ;
	<urn:solutiondesign:ontology:title> "Citizen notified their account creation requires manual review (Near Match)" .

<urn:solutiondesign:instance:iam:Req_15_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Near Match during a citizen profile update: do not apply the update; do not show conflicting match data; display pending-review notification; generate a Requires Resolution task." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to Seq_CitizenUpdateAccountDemographics's own Near Match branch ('Lock Primary + Secondary fields; Contact fields remain editable... dashboard access NOT blocked')." ;
	<urn:solutiondesign:ontology:requirementId> "15.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequiresReviewEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenUpdateAccountDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User, I want to be notified if my profile updates are pending review due to identity matching conflicts so that I know my changes have been submitted but not yet applied." ;
	<urn:solutiondesign:ontology:title> "Citizen notified profile update is pending review (Near Match)" .

<urn:solutiondesign:instance:iam:Req_15_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Select a Requires Resolution task from account creation; display submitted data alongside Mi-Key candidate(s); actions: Match and Link, Create as New, Deny; notify citizen of the outcome." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the AccountCreation branch of Seq_IdentityAdministratorResolveRequest (Match/Create New/Deny-Cancel, each with the exact downstream event this story implies)." ;
	<urn:solutiondesign:ontology:requirementId> "15.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Perm_IdentityAdminResolveRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to review 'Near Match' results generated during citizen account creation so that I can determine whether to link the user to an existing Unique ID or create a new one." ;
	<urn:solutiondesign:ontology:title> "Identity Administrator reviews Near Match from citizen account creation" .

<urn:solutiondesign:instance:iam:Req_15_3_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Display submitted updates against Master Record with differing fields highlighted; actions: Approve Update (send Resolve Near Match to Mi-Key), Deny Update (revert temporary data); notify citizen of outcome." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the AccountUpdate branch ('Apply the previously-held update to the Person Record... PersonRecordUpdated')." ;
	<urn:solutiondesign:ontology:requirementId> "15.3.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to review 'Near Match' results generated by citizen profile updates so that I can approve valid demographic changes or reject incorrect submissions that conflict with existing records." ;
	<urn:solutiondesign:ontology:title> "Identity Administrator reviews Near Match from citizen profile update" .

<urn:solutiondesign:instance:iam:Req_15_3_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Admin task view shows a matching score to assist review (per the doc's own Gap Analysis citing an underlying BRD requirement); on confirming a true match, admin can select which specific user-submitted data elements should be considered prevalent when updating the Mi-Key master record, rather than an all-or-nothing update." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted. This is the ONE genuinely new ask surfaced by the Citizen User doc's unnumbered 'User Stories' section, which otherwise restates content already covered by Req_15_3_3/Req_15_3_4 (the doc's own Gap Analysis independently confirms this: 'Missing Admin Action - Data Precedence Selection' and 'Missing Admin Interface Detail - Matching Score' are both listed as FDD-vs-BRD gaps). iam:VO_ResolutionAction ('Identity Administrator's disposition... Match to existing Unique ID / Create New / Approve Link / Deny / Cancel, with notes') captures the admin's overall decision but not field-level data-precedence selection, and no property anywhere in iam-domain.ttl/iam-api.ttl carries a Mi-Key match score. A real, narrow coverage gap distinct from the broader Near Match workflow, which is otherwise solidly modeled." ;
	<urn:solutiondesign:ontology:requirementId> "15.3 (unnumbered, Citizen User doc's own 'User Stories' section)" ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, when I determine a 'Near Match' is a true match, I want the ability to select which pieces of new information should update the existing master record in MiKey, so that I can ensure the most accurate and up-to-date data is kept." ;
	<urn:solutiondesign:ontology:title> "Admin data-precedence selection and match-score display when resolving a true match" .

<urn:solutiondesign:instance:iam:Req_15_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Personnel Search page from dashboard; search by Unique ID/First/Middle/Last Name/DOB/SSN/Application Number/CLN; at least one of Last Name/Unique ID/SSN/Application Number/CLN required; First/Middle/DOB cannot be used alone; Unique ID exact-match only, text fields support partial match." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "See Question_PersonSearchNotModeled above." ;
	<urn:solutiondesign:ontology:requirementId> "15.4.1" ;
	<urn:solutiondesign:ontology:statement> "As a Business or Admin User, I want to enter specific search criteria to locate identity records so that I can find individuals using various available identifiers or demographic data." ;
	<urn:solutiondesign:ontology:title> "Enter search criteria to locate identity records" .

<urn:solutiondesign:instance:iam:Req_15_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Sortable results table; partial matches included; Retired IDs shown only when searched explicitly by that Retired ID, displaying Inactive/Retired status and the associated Primary Unique ID, not selectable for active use; 'No results found' when nothing matches." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: the Retired-ID display rule (an ID that's been through Link/Retire is search-visible-but-unusable, paired with its Primary) is a direct, coherent extension of iam:Seq_SplitRetireIdMiKeyDirect's own keyDecision ('A Retired Unique ID must be rejected if submitted anywhere in MiEdWorkforce afterward — staffing's responsibility on consuming these events'), but the search/list mechanism itself is the same unmodeled Person Search gap as Req_15_4_1 — kept Satisfied here (not double-counted under the Annotation) because the retired-ID-specific behavioral rule genuinely has a home, even though the general search surface it's displayed within does not." ;
	<urn:solutiondesign:ontology:requirementId> "15.4.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityRecordRetiredEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_SplitRetireIdMiKeyDirect> ;
	<urn:solutiondesign:ontology:statement> "As a Business or Admin User, I want to view a sortable list of records that match my search query so that I can distinguish between similar records and identify the correct individual." ;
	<urn:solutiondesign:ontology:title> "View sortable, retired-ID-aware search results" .

<urn:solutiondesign:instance:iam:Req_15_4_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Read-only Individual Record Details page: Master Record Demographics, Demographic History, Credential Information, Employment Collection History; visibility restricted by role/permission; Back button to results." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "See Question_PersonSearchNotModeled above." ;
	<urn:solutiondesign:ontology:requirementId> "15.4.3" ;
	<urn:solutiondesign:ontology:statement> "As a Business or Admin User, I want to view the detailed history and current status of a selected individual so that I can verify their demographics, credentials, and employment history before taking action." ;
	<urn:solutiondesign:ontology:title> "View detailed history and status of a selected individual" .

<urn:solutiondesign:instance:iam:Req_15_4_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Multi-select via checkboxes; Compare Records view; 'Request to Link IDs' option triggers the Link ID workflow." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: the downstream Link ID workflow this triggers is fully modeled (see Feature 15.6 below); the compare-records search-results UI itself is the same unmodeled Person Search gap as Req_15_4_1." ;
	<urn:solutiondesign:ontology:requirementId> "15.4.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_LinkIdResolution> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserRequestLinkId> ;
	<urn:solutiondesign:ontology:statement> "As a Business or Admin User, I want to select multiple records from the search results to compare them side-by-side so that I can identify duplicate records and request that they be linked." ;
	<urn:solutiondesign:ontology:title> "Compare multiple search results and request a Link" .

<urn:solutiondesign:instance:iam:Req_15_4_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "'Add to Employee Roster' button for authorized Business Users; 'Request to Split ID' option when a Unique ID appears shared by multiple individuals." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "See Question_PersonSearchNotModeled above. The downstream Split ID request itself is out of scope for a business-user-facing UI per Feature 15.11 (see Req_15_11_1 below) — this story's 'Request to Split ID' entry point contradicts that decision (Split is explicitly backend-admin/Mi-Key-direct only, no business-user-facing UI at all), a second, narrower discrepancy worth flagging alongside the broader search gap rather than folded silently into it." ;
	<urn:solutiondesign:ontology:requirementId> "15.4.5" ;
	<urn:solutiondesign:ontology:statement> "As a Business or Admin User, I want to initiate administrative actions directly from the Person Detail view so that I can efficiently add the person to my roster or correct identity errors." ;
	<urn:solutiondesign:ontology:title> "Initiate admin actions from the Person Detail view" .

<urn:solutiondesign:instance:iam:Req_15_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upload Roster option supporting defined file formats (XML/CSV); one file per type in the Pending Files queue at a time; immediate schema validation gating business-rule validation." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_BulkIdentityProcessingNotModeled below. Also worth flagging on its own: a source-document review comment on this story states the FDD's own 'common file staging area across MiEdWorkforce' framing is 'no longer accurate... file uploads will occur in their designated, relevant areas,' confirmed by a second reviewer — i.e. even the FDD's own authors flag this specific piece of the visible requirement text as stale, independent of whatever the eventual technical design does model." ;
	<urn:solutiondesign:ontology:requirementId> "15.5.1" ;
	<urn:solutiondesign:ontology:statement> "As a Business User, I want to upload a bulk file containing identity demographic updates via the common file staging area so that I can update multiple employee records efficiently without manual entry." ;
	<urn:solutiondesign:ontology:title> "Upload a bulk file of identity demographic updates" .

<urn:solutiondesign:instance:iam:Req_15_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Every record must carry a Unique ID; verify Unique ID association with the submitting entity (error + redirect to Request ID process if not associated); data-element-level validation per Identity Validations." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_BulkIdentityProcessingNotModeled below." ;
	<urn:solutiondesign:ontology:requirementId> "15.5.2" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to validate the contents of the uploaded identity file against business rules before processing so that I ensure only valid updates for existing employees are sent to Mi-Key." ;
	<urn:solutiondesign:ontology:title> "Validate bulk-uploaded identity records against business rules" .

<urn:solutiondesign:instance:iam:Req_15_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "File Upload Status page with validation summary; downloadable error details; Commit (save + trigger Mi-Key processing) vs. Cancel (discard, nothing sent)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_BulkIdentityProcessingNotModeled below." ;
	<urn:solutiondesign:ontology:requirementId> "15.5.3" ;
	<urn:solutiondesign:ontology:statement> "As a Business User, I want to review a summary of validation results in a 'sandbox' view before permanently committing the data so that I can fix errors or cancel the upload if the data impact is incorrect." ;
	<urn:solutiondesign:ontology:title> "Review a sandbox validation summary before committing a bulk upload" .

<urn:solutiondesign:instance:iam:Req_15_5_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Commit, send valid records to the Mi-Key Asynchronous Assignment Service; Match auto-updates; Near Match flags Requires Resolution and adds to the Identity Management Worklist; summary notification on completion." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy asserted — see Question_BulkIdentityProcessingNotModeled below. Notable: this story explicitly names an ASYNCHRONOUS Mi-Key Assignment Service, distinct from the synchronous Assignment service iam-sequences.ttl's other citizen/business flows use — a real architectural variant with no counterpart anywhere in iam-sequences.ttl (every existing sequence models a synchronous Mi-Key call)." ;
	<urn:solutiondesign:ontology:requirementId> "15.5.4" ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to process committed bulk identity records through the Mi-Key Asynchronous Assignment Service so that master records are updated or flagged for resolution based on probabilistic matching." ;
	<urn:solutiondesign:ontology:title> "Process committed bulk identity records asynchronously through Mi-Key" .

<urn:solutiondesign:instance:iam:Req_15_6_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Initiated from Near Match resolution or Personnel Search; user selects the primary ID and provides required justification; user can view status (Needs Review/In Review/Approved/Denied/Canceled) and cancel before Admin review." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: Seq_BusinessUserRequestLinkId's own submission step and VO_LinkDetails ('primary and secondary Unique IDs, and the requester's justification') are this story almost verbatim. The user-visible status list (Needs Review/In Review/Approved/Denied/Canceled) is slightly richer than iam:IdReqState_* (which has RequiresResolution/Resolved/Denied/Cancelled, no explicit 'In Review' distinct from 'RequiresResolution') — a narrow presentation-vs-state-machine granularity gap, not raised separately given how solidly the core flow is covered." ;
	<urn:solutiondesign:ontology:requirementId> "15.6.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_LinkIdResolution> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserRequestLinkId> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_LinkDetails> ;
	<urn:solutiondesign:ontology:statement> "As a Business User, I want to submit a request to link multiple Unique IDs that belong to the same person, so that their fragmented records can be consolidated." ;
	<urn:solutiondesign:ontology:title> "Business user submits a request to link Unique IDs" .

<urn:solutiondesign:instance:iam:Req_15_6_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Review justification alongside demographic data/history; on approve, can override the user-selected Primary ID with justification back to the user; on deny, IDs not joined, denial reason provided; Identity-Admin-initiated links skip worklist approval and go straight to Mi-Key." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the LinkId branch of Seq_IdentityAdministratorResolveRequest (Approve Link / Deny). wireframe-01 (viewed, from this same docx) shows exactly this side-by-side demographic comparison plus Approve/Deny-with-notes screen." ;
	<urn:solutiondesign:ontology:requirementId> "15.6.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Perm_IdentityAdminResolveRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Admin, I want to access a worklist to approve or deny requests to link IDs, so that I have final authority over identity data consolidation." ;
	<urn:solutiondesign:ontology:title> "Identity Admin worklist to approve or deny Link ID requests" .

<urn:solutiondesign:instance:iam:Req_15_6_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Send ID to Retire, ID to Merge To (Primary), and Retire Reason to Mi-Key; on success, automatically merge all associated MiEdWorkforce data to the primary ID; multiple IDs are linked one request at a time (Mi-Key limitation)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the LinkId Approve branch ('Retire secondary Unique ID, merge into primary... StaffingAPI: Merge all associated data')." ;
	<urn:solutiondesign:ontology:requirementId> "15.6.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionCompletedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_EmployeeRosterAddEmployee> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must send approved link requests to Mi-Key and process the response, so that the systems remain in sync and redundant IDs are merged." ;
	<urn:solutiondesign:ontology:title> "System sends approved Link requests to Mi-Key and merges data" .

<urn:solutiondesign:instance:iam:Req_15_6_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Audit log for approvals/denials/cancellations; notify requesting user, Citizen account holder (if applicable), and any school district with the ID on an active roster." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the sequence's own notification fan-out ('Notify requesting district, any citizen account, and any other district reporting either ID')." ;
	<urn:solutiondesign:ontology:requirementId> "15.6.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserRequestLinkId> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must log all actions and notify relevant parties when an ID is linked, so that stakeholders are aware of changes to their data." ;
	<urn:solutiondesign:ontology:title> "Log and notify on a completed Link action" .

<urn:solutiondesign:instance:iam:Req_15_7> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:requirementId> "15.7" ;
	<urn:solutiondesign:ontology:statement> "This feature was created to account for the potential need for MiEdWorkforce to connect to historical 'Person' data. Throughout the project development of Mi-Key and the Data Warehouse it has been determined that MiEdWorkforce will not have a need to store historical 'Person' data, and thus this feature is no longer necessary." ;
	<urn:solutiondesign:ontology:title> "Historical Records — withdrawn, no longer necessary" .

<urn:solutiondesign:instance:iam:Req_15_8_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Pre-populate Legal Name and Email from MiLogin claims, both editable; Phone shown empty/editable; optional Preferred Contact Details section." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: VO_MiLoginIdentity ('type, ID, email') is exactly the MiLogin-sourced pre-population data this story describes; Seq_CitizenInitialSignIn's own redirect-to-Account-Creation-Landing-Page branch is the routing context. The specific field-level pre-population/editability rules (Legal Name editable despite being MiLogin-sourced, Phone always blank) are UI detail this domain's API-level model doesn't individually capture — same class of minor gap as other FDD 01/15 UI-only findings, not raised separately." ;
	<urn:solutiondesign:ontology:requirementId> "15.8.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenInitialSignIn> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_MiLoginIdentity> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User navigating from MiLogin, I want to view the Account Creation form pre-populated with available information so that I can verify or update my demographic details to establish my identity in the system." ;
	<urn:solutiondesign:ontology:title> "Account Creation form pre-populated from MiLogin" .

<urn:solutiondesign:instance:iam:Req_15_8_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Optional 'I have a PIC/Unique ID' toggle reveals a PIC entry field; entering it does not auto-populate other fields, only aids matching; format validated before submission." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Op_SubmitCitizenAccountCreation's own projection note ('Request body is shaped by VO_SubmittedDemographics plus VO_NoSSNStatus') is broad enough to cover an optional supplied PIC as part of the submitted demographic payload; the PIC-specific format-validation rule itself lives only in Identity Validations.xlsx (not separately modeled, per this file's header note)." ;
	<urn:solutiondesign:ontology:requirementId> "15.8.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SubmitCitizenAccountCreation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_SubmittedDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User who already possesses a Personnel Identification Code (PIC), I want the option to manually enter this number during account creation so that it can be used as an additional attribute to help locate my existing records." ;
	<urn:solutiondesign:ontology:title> "Citizen optionally supplies a known PIC/Unique ID during account creation" .

<urn:solutiondesign:instance:iam:Req_15_8_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Attestation required before Submit enabled; run Identity Validations on submit; on failure, show errors and do not send to Mi-Key; on pass, temporarily store and transmit (including optional PIC) to the Mi-Key Assignment Service." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:requirementId> "15.8.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Entity_IdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SubmitCitizenAccountCreation> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce System, I want to validate the citizen's entered demographic data against defined business rules so that only valid and complete data is transmitted to the Mi-Key identity service." ;
	<urn:solutiondesign:ontology:title> "Validate citizen demographic data before transmitting to Mi-Key" .

<urn:solutiondesign:instance:iam:Req_15_8_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Match, assign the returned Unique ID and update non-matching Master Record fields; on No Match, accept and assign the newly created Unique ID; in both cases, immediately navigate to the dashboard and notify the user of success." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match — this is Seq_CitizenInitialSignIn's Match/No-Match branches (auto-create Individual scope authorization, redirect to dashboard) almost verbatim." ;
	<urn:solutiondesign:ontology:requirementId> "15.8.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:NewCitizenUserAuthorizedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_CitizenAutoApproval> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenInitialSignIn> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User, I want to be granted immediate access to the Educational Staff Dashboard if my identity is successfully verified or a new ID is created so that I can begin my credentialing tasks or view employment details without delay." ;
	<urn:solutiondesign:ontology:title> "Grant immediate dashboard access on Match or No Match" .

<urn:solutiondesign:instance:iam:Req_15_8_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Near Match, do not assign a Unique ID or grant dashboard access; show a 'Requires Review'/'On Hold' notification avoiding the term 'Near Match'; create a Requires Resolution task; send a confirmation email." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — iam-sequences.ttl's own keyDecision on this exact sequence already cites this exact story by section number: 'Near Match withholds candidate data: per FDD 15.8 Section 15.8.5, the citizen is never shown potential-match details or the term Near Match — only a generic Requires Review/On Hold status.'" ;
	<urn:solutiondesign:ontology:requirementId> "15.8.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_CitizenNearMatchResolution> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_CitizenInitialSignIn> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User, I want to be notified if my account creation is placed on hold due to a 'Near Match' so that I understand why I cannot immediately access the dashboard while an administrator reviews my identity." ;
	<urn:solutiondesign:ontology:title> "Citizen notified of Near Match hold on account creation" .

<urn:solutiondesign:instance:iam:Req_15_9_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Worklist with Unresolved/Resolved tabs; populated by New ID, Link ID, and Requires Resolution (Near Match) requests; defaults to In Review/Needs Review; Resolved tab filterable by Approved/Denied/Canceled; key columns (Unique ID, Name, Requested By, Received Date, Type, Status)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match: Op_ListIdentityResolutionRequests's summary ('List identity resolution requests requiring administrator review') covers the Unresolved-tab default directly. wireframe-02 (viewed, from this same docx) shows exactly this tabbed worklist with the described columns. The explicit Resolved-tab historical filtering (Approved/Denied/Canceled) is not separately called out in the operation's own documented behavior — a narrow gap, not raised separately given how solidly the core worklist concept is covered." ;
	<urn:solutiondesign:ontology:requirementId> "15.9.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ListIdentityResolutionRequests> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Perm_IdentityAdminViewPendingRequests> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to view a centralized worklist of all identity-related requests requiring manual intervention so that I can efficiently process new identities, link requests, and near match resolutions from a single interface." ;
	<urn:solutiondesign:ontology:title> "Identity Administrator centralized worklist" .

<urn:solutiondesign:instance:iam:Req_15_9_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Display submitted data with Mi-Key potential matches; Approve New ID sends a create request to Mi-Key; Use Potential Match lets admin choose whether to update the matched master record; Deny requires a Denial Reason sent to the requesting user." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the NewId branch of Seq_IdentityAdministratorResolveRequest and VO_ResolutionAction's own disposition set (Match / Create New / Deny, with notes)." ;
	<urn:solutiondesign:ontology:requirementId> "15.9.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_ResolutionAction> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to review requests for 'New IDs' submitted by business users so that I can either approve the creation of a new identity or link the record to an existing potential match to prevent duplicates." ;
	<urn:solutiondesign:ontology:title> "Admin reviews New ID requests" .

<urn:solutiondesign:instance:iam:Req_15_9_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Display the two (or more) IDs and the business user's justification; admin selects Primary/Retired; the request still comes to the admin even if the business entity indicated a desired action, who can approve/deny/change it." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:requirementId> "15.9.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_LinkDetails> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to review 'Link ID' requests submitted by business users so that I can merge duplicate records into a single Primary Unique ID and retire the secondary ID." ;
	<urn:solutiondesign:ontology:title> "Admin reviews Link ID requests" .

<urn:solutiondesign:instance:iam:Req_15_9_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Display requests from citizen creation or update where Mi-Key returned Near Match, alongside candidate(s); actions: Match (associate existing ID), Create New; notify citizen of outcome." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:requirementId> "15.9.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to resolve 'Requires Resolution' tasks generated by citizen account creation so that the citizen can be granted access to the system with the correct identity association." ;
	<urn:solutiondesign:ontology:title> "Admin resolves citizen Requires Resolution tasks" .

<urn:solutiondesign:instance:iam:Req_15_9_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Use Person Search to locate the record; admin edits demographic fields and submits directly to the Mi-Key Update Service; required Audit Note; notify associated Citizen User and/or employing district." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to Op_AdminUpdatePersonRecord's own description ('Directly update a person's record... bypassing the normal match workflow'). The 'search to locate' half depends on the same unmodeled Person Search capability as Question_PersonSearchNotModeled — not re-targeted by that Annotation here since the update operation itself, the part this story is really about, is solidly covered." ;
	<urn:solutiondesign:ontology:requirementId> "15.9.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_AdminUpdatePersonRecord> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Perm_IdentityAdminUpdatePersonRecord> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to search for and update a specific person's demographic record so that I can correct data errors that business or citizen users are unable to fix themselves (e.g., locked fields)." ;
	<urn:solutiondesign:ontology:title> "Admin directly updates a person's demographic record" .

<urn:solutiondesign:instance:iam:Req_15_9_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Manage user support materials/training manuals; manage business-rule validations (severity, error text); view identity-related File and API Queues to monitor Mi-Key batch status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Permission exists and describes exactly this scope ('validation rules, data element definitions, training materials, and processing queue monitoring') but iam-permissions.ttl's own notes already flag that NO API operation implements it ('iam-api.yml has no identity-configuration endpoint... an intentional, documented gap') — this story is the direct source of that already-known, pre-existing gap; not a new finding, but confirms it's a real client-facing ask rather than a speculative catalog entry. Also overlaps GAPS.md's already-logged 'Business Rule Management (04)' unmapped area (see this file's own header note on 15.13) — the business-rule-validation-management half of this story may belong there rather than to iam specifically." ;
	<urn:solutiondesign:ontology:requirementId> "15.9.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Perm_IdentityAdminManageConfiguration> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to manage system configurations for identity processing (e.g., validations, manuals) so that I can maintain the integrity of identity data collection without developer intervention." ;
	<urn:solutiondesign:ontology:title> "Admin manages identity system configuration" .

<urn:solutiondesign:instance:iam:Req_15_9_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Retrieve a No-SSN-flagged record; admin unchecks No SSN, enters SSN and Confirm SSN; on save, update the Mi-Key Master Record and clear the No SSN flag." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:Fdd15Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: Rule_NoSSNCitizenAccounts's own example ('the citizen can later add their SSN via their own Account Update flow, or a hiring district can require it') explicitly anticipates this exact admin-side variant, and Op_AdminUpdatePersonRecord is the generic direct-update path that carries it out." ;
	<urn:solutiondesign:ontology:requirementId> "15.9 (unnumbered sub-item, rendered '15.9.' in source)" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_AdminUpdatePersonRecord> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_NoSSNCitizenAccounts> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:VO_NoSSNStatus> ;
	<urn:solutiondesign:ontology:statement> "As an Identity Administrator, I want to update a citizen's record to include a valid SSN when they previously had 'No SSN' so that the individual becomes eligible for employment or credentialing that requires a Social Security Number." ;
	<urn:solutiondesign:ontology:title> "Admin adds a valid SSN to a No-SSN citizen record" .

<urn:solutiondesign:instance:iam:RoleDefinitionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Defines the available roles in the system, their associated permissions, and scope applicability, ensuring consistent permission assignment." ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:iam:Entity_Role> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:RoleState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:RoleState_Deprecated> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_ApplicableMiLoginTypes> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_ApplicableScopes> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_RolePermission> ;
	<urn:solutiondesign:ontology:invariants> "Role names must be unique. Permissions within a role must be valid permission identifiers. A role can only be assigned to scopes in its ApplicableScopes list. A role can only be assigned to a user authenticated under one of its ApplicableMiLoginTypes (grant-time check; complements query-time MiLogin Context Enforcement). System Administrator roles can only be assigned at System scope." ;
	<urn:solutiondesign:ontology:notes> "No User Group Layer (decision, 2026-08-14): an earlier FDD draft described a 'User Group' concept whose one enforced constraint — a user's groups must all share one MiLogin type — never carried behavior that Role + Scope couldn't already express. Confirmed direction is Role + Scope only; the MiLogin-type constraint is enforced via ApplicableMiLoginTypes (grant-time) plus query-time MiLogin Context Enforcement. Pending final client concurrence (fdd-sdd-review/client-questions.md #2)." ;
	<urn:solutiondesign:ontology:rootEntity> "Role" .

<urn:solutiondesign:instance:iam:RoleState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:iam:RoleState_Deprecated> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Deprecated" .

<urn:solutiondesign:instance:iam:Rule_ApprovalLinkExpiration> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:BatchJob_ExpireAuthorizationRequests> ;
	<urn:solutiondesign:ontology:example> "User submits request on Jan 1; Lead Admin receives a 7-day link; on Jan 9, if not acted upon, link expires, request status updates to Expired, user is notified." ;
	<urn:solutiondesign:ontology:rationale> "Security (limit exposure of approval links) and operational hygiene (stale requests don't linger indefinitely)." ;
	<urn:solutiondesign:ontology:statement> "Authorization approval links sent to Lead Administrators expire after a system-configured timeframe (e.g., 7 days). Expired requests must be resubmitted." .

<urn:solutiondesign:instance:iam:Rule_AuthorizationApprovalRouting> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:example> "User requests 'Staffing Administrator' role for 'District 42'. System calls GET /organizations/district-42 on the Organizations API to retrieve the Lead Administrator contact, then routes the approval request to that individual." ;
	<urn:solutiondesign:ontology:rationale> "Ensures organizational control over who can access organization data; Lead Administrators are the designated authority per EEM." ;
	<urn:solutiondesign:ontology:statement> "Business user authorization requests must be routed to the Lead Administrator of the requested scope's organization as defined in EEM." .

<urn:solutiondesign:instance:iam:Rule_BusinessUserNearMatchSelfResolution> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:example> "District user adds a new employee; Mi-Key returns two potential matches; user selects the correct one; IdentityResolutionRequest resolves immediately to Resolved (self_resolved=true), no Identity Administrator involved." ;
	<urn:solutiondesign:ontology:rationale> "District users adding or updating their own employees have a legitimate business need to see candidate demographic data for the person they are reporting on, unlike a citizen reviewing an unrelated third party's data." ;
	<urn:solutiondesign:ontology:statement> "When a BusinessUserStaffing-origin request (NewId or DemographicUpdate) produces a Mi-Key Near Match, the requesting district user reviews the candidate(s) directly and may resolve it themselves: select a presented potential match, or (NewId only) escalate to Identity Administrator review with justification." .

<urn:solutiondesign:instance:iam:Rule_CitizenAutoApproval> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:example> "Teacher completes identity matching and receives Unique ID; immediately granted Individual scope access to view their own credentials and professional learning." ;
	<urn:solutiondesign:ontology:rationale> "Citizens are accessing their own data; no organizational approval needed." ;
	<urn:solutiondesign:ontology:statement> "MiLogin Citizen users are automatically approved for Individual scope access upon completing account creation." .

<urn:solutiondesign:instance:iam:Rule_CitizenNearMatchResolution> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:example> "Citizen submits Account Update changing Last Name; Mi-Key returns Near Match; IdentityResolutionRequest.status = RequiresResolution; citizen can still log in and edit contact fields but cannot resubmit demographic changes until an Identity Administrator resolves it." ;
	<urn:solutiondesign:ontology:rationale> "Per FDD 15.3 (Citizen), showing potential-match demographic data (another person's name, DOB, SSN fragments) to an unrelated citizen would be a privacy violation." ;
	<urn:solutiondesign:ontology:statement> "When a Citizen User's Account Creation or Account Update submission produces a Mi-Key 'Near Match', the request is flagged for Identity Administrator review as a 'Requires Resolution' item rather than being shown to the citizen. The citizen never sees candidate match data." .

<urn:solutiondesign:instance:iam:Rule_ExternalRemovalRequestValidation> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:example> "Former supervisor submits public form to revoke access for ex-employee. System Admin reviews demographic info, confirms legitimacy, approves removal." ;
	<urn:solutiondesign:ontology:rationale> "Prevents malicious or accidental removal of legitimate user access; validates the legitimacy of the removal request." ;
	<urn:solutiondesign:ontology:statement> "Public authorization removal requests (submitted without login) must be approved by a System Administrator before authorization is revoked." .

<urn:solutiondesign:instance:iam:Rule_LeadAdministratorBootstrap> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:example> "User authenticates via MiLogin Business/Worker; IAM calls GET /organizations/by-lead-admin?email={userEmail}; for each matching organization, IAM auto-grants 'Organization Lead Administrator' role at that scope and publishes AuthorizationApproved." ;
	<urn:solutiondesign:ontology:rationale> "Eliminates chicken-and-egg problem of approvers needing approval; EEM is source of truth for organizational authority." ;
	<urn:solutiondesign:ontology:statement> "When a user designated as Lead Administrator in EEM authenticates for the first time, they are automatically granted predefined approval permissions for their organization scope." .

<urn:solutiondesign:instance:iam:Rule_LinkIdResolution> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:example> "District user notices an employee appears to have two Unique IDs from separate prior employers; submits a Link ID request naming primary and secondary IDs with justification; Identity Administrator approves; Mi-Key merges secondary into primary." ;
	<urn:solutiondesign:ontology:rationale> "Per FDD 15.6, linking two IDs is a higher-risk, cross-district-impacting action that always requires Identity Administrator judgment." ;
	<urn:solutiondesign:ontology:statement> "A district user may submit a LinkId request identifying two Unique IDs believed to represent the same person, with a required justification. The request always routes directly to Identity Administrator review; on approval Mi-Key retires the secondary ID and merges it into the primary." .

<urn:solutiondesign:instance:iam:Rule_MiLoginContextEnforcement> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:example> "Maria Teacher has both a Citizen identity (personal credential viewing) and a Business identity (District HR role); when authenticated as Citizen she can access Individual scope but not the District HR authorization, and vice versa." ;
	<urn:solutiondesign:ontology:rationale> "Security boundary enforcement; Business actions should not be performable while authenticated as Citizen, even if the same person holds both accounts." ;
	<urn:solutiondesign:ontology:statement> "Users with multiple MiLogin identities (Citizen, Business, Worker) can only access authorizations associated with their current authentication context. Authorizations are not shared across MiLogin identity types for the same person." .

<urn:solutiondesign:instance:iam:Rule_NoSSNCitizenAccounts> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:example> "Pre-service teaching candidate has no SSN yet; Identity Administrator creates the citizen account with 'No SSN' checked; the citizen can later add their SSN via their own Account Update flow, or a hiring district can require it when adding the person to an Employee Roster (staffing's validation)." ;
	<urn:solutiondesign:ontology:rationale> "SSN is required by Mi-Key/CEDS for most reporting purposes, but is routinely unavailable at pre-service intern placement or initial credential application per FDD 15.9." ;
	<urn:solutiondesign:ontology:statement> "A citizen account may be created without an SSN only via Identity Administrator assistance, and only for Student Intern or Credential Applicant purposes. The record carries NoSSNStatus=true until an SSN is supplied." .

<urn:solutiondesign:instance:iam:Rule_RoleScopeAssignmentCompatibility> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:RoleDefinitionAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:RoleDefinitionAggregate> ;
	<urn:solutiondesign:ontology:example> "'District HR Administrator' role has ApplicableScopes [District, ISD] and contains both staffing.employee.view (scope-sensitive) and iam.report.export (scope-agnostic); when assigned at District 42, the scope-sensitive permission filters to District 42 + buildings while the scope-agnostic one works system-wide." ;
	<urn:solutiondesign:ontology:rationale> "Prevents nonsensical assignments (e.g., EPP-specific roles at Building scope) while allowing flexible permission bundling." ;
	<urn:solutiondesign:ontology:statement> "Roles can only be assigned at scopes for which they are marked applicable. Roles may contain both scope-sensitive and scope-agnostic permissions." .

<urn:solutiondesign:instance:iam:Rule_ScopeContextInRequests> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:example> "User has authorizations for District 5 and ISD 10. When viewing employee roster, UI sends scope context (X-Organization-Context: district-5) with API request." ;
	<urn:solutiondesign:ontology:rationale> "Prevents ambiguity in data access and audit trails; ensures clear accountability for actions." ;
	<urn:solutiondesign:ontology:statement> "When a user with multiple authorizations makes an API request, they must specify which scope/organization context the request applies to." .

<urn:solutiondesign:instance:iam:Rule_TransitiveAuthorizationResolution> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:iam:TP_AuthorizationEvaluation> ;
	<urn:solutiondesign:ontology:example> "User has 'Staffing Administrator' at ISD 50; request to view employees at Building 123 (in District 10, in ISD 50); Organizations API confirms Building 123 is a descendant of ISD 50; permission check returns AUTHORIZED." ;
	<urn:solutiondesign:ontology:rationale> "Administrative efficiency; ISD-level admins need visibility into constituent organizations without separate approvals for each." ;
	<urn:solutiondesign:ontology:statement> "When evaluating if a user has permission for a target organization, the system checks direct authorization for that organization, then authorization at any parent organization (District for a Building, ISD for a District or Building)." .

<urn:solutiondesign:instance:iam:Seq_AuthorizationRequestLinkExpiration> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Scheduler\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    Scheduler->>IAM: Run expiration check job (e.g., nightly)\n    IAM->>IAM: Query AuthorizationRequests<br/>WHERE status = Pending<br/>AND createdAt < (now - expirationThreshold)\n\n    loop For each expired request\n        IAM->>IAM: Mark request as Expired\n        IAM->>IAM: Invalidate approval link\n\n        Note over IAM: Request status: Pending > Expired\n\n        IAM--)EventBus: AuthorizationExpired\n        IAM->>Notification: Send expiration email to BizUser\n        IAM->>Notification: Send notification to Lead Admin (FYI)\n    end\n\n    IAM->>IAM: Log summary of expired requests\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationExpired - fires when request expires." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Expiration threshold: 7 days by default. Notification: both user and Lead Admin notified when request expires. No auto-extend: user must resubmit new request if expired." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Authorization Request - Link Expiration" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Automated expiration of approval links after configured timeout. When: Scheduled job runs (e.g., nightly) and identifies expired requests. Who: System (automated)." .

<urn:solutiondesign:instance:iam:Seq_AutomatedInactivityDeactivation> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Scheduler\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    Scheduler->>IAM: Run deactivation job (per InactivityPolicy schedule)\n    IAM->>IAM: Load active InactivityPolicy configuration\n    IAM->>IAM: Query users WHERE:<br/>- lastLoginAt < (now - inactivityThreshold)<br/>- MiLogin type matches policy filter<br/>- Authorization status = Active\n\n    loop For each inactive user\n        IAM->>IAM: Revoke all authorizations for user\n        IAM->>IAM: Mark user account as Inactive\n        IAM->>IAM: Invalidate user authorization cache\n\n        Note over IAM: Authorization status: Active > Inactive<br/>Account status: Active > Inactive\n\n        IAM--)EventBus: UserAccountDeactivated\n        IAM--)EventBus: AuthorizationRevoked (one per authorization)\n        IAM->>Notification: Send deactivation email to user\n        IAM->>Notification: Notify Lead Admin(s) of deactivation\n    end\n\n    IAM->>IAM: Generate deactivation summary report\n    IAM->>Notification: Send summary report to System Admins\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:eventsPublished> "UserAccountDeactivated - fires for each deactivated account. AuthorizationRevoked - fires for each revoked authorization." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Inactivity threshold: 84 months (7 years) default. Schedule: first Friday of month default. Notification: user and Lead Admins notified after deactivation. MiLogin type filter: policy can target specific MiLogin types." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Automated Inactivity-Based Account Deactivation" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Scheduled job automatically deactivates user accounts inactive beyond configured threshold. When: Scheduled job runs (e.g., first Friday of month). Who: System (automated)." .

<urn:solutiondesign:instance:iam:Seq_BusinessUserInitialAuthorizationRequest> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor BizUser as Business User\n    participant MiLogin\n    participant IAM\n    participant OrgsAPI as Organizations API\n    participant Notification\n    participant EventBus\n\n    BizUser->>MiLogin: Authenticate\n    MiLogin-->>BizUser: Auth token (MiLogin Business/Worker) + redirect to MiEdWorkforce\n\n    BizUser->>IAM: Access MiEdWorkforce with token\n    IAM->>IAM: Validate token, extract MiLoginID, type=Business/Worker\n    IAM->>IAM: Check for existing authorizations (filtered by MiLogin type)\n\n    alt No existing authorizations for this MiLogin type\n        IAM-->>BizUser: Display Authorization Request Form\n\n        BizUser->>IAM: Search for Organization (start typing)\n        IAM->>OrgsAPI: GET /organizations/search?query={query}&status=Active\n        Note over OrgsAPI: Local replica synced daily from EEM<br/>Sub-10ms query performance\n        OrgsAPI-->>IAM: Matching organizations\n        IAM-->>BizUser: Display Organization suggestions\n\n        BizUser->>IAM: Select Organization, roles, justification\n        BizUser->>IAM: Submit request\n\n        IAM->>IAM: Validate role-scope compatibility\n        IAM->>OrgsAPI: Get Lead Administrator for organization\n        OrgsAPI-->>IAM: Lead Admin contact (email, name)\n\n        IAM->>IAM: Create AuthorizationRequest (Pending)\n        IAM->>IAM: Generate single-use approval link (expires in 7 days)\n\n        Note over IAM: Request status: > Pending<br/>Linked to MiLogin type: Business/Worker\n\n        IAM--)EventBus: AuthorizationRequested\n        IAM->>Notification: Send approval email to Lead Admin\n        IAM->>Notification: Send confirmation email to BizUser\n\n        IAM-->>BizUser: Confirmation: Request submitted\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid Organization code > form validation error. Role not applicable to scope > form validation error. Organizations API unavailable > display error, allow retry; IAM serves from org-data cache if available." ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationRequested - fires when user submits request." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Organization search: predictive search with debouncing against the Organizations API typeahead endpoint. Approval routing: Lead Admin email retrieved from the Organizations API and cached by IAM keyed by org code. Link expiration: 7-day default. MiLogin context: authorization request tied to Business or Worker identity type." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Business User - Initial Authorization Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Business user submits authorization request for roles at a specific scope. When: Business user first attempts to access MiEdWorkforce after MiLogin authentication. Who: Business User (district admin, EPP coordinator, etc.)." .

<urn:solutiondesign:instance:iam:Seq_BusinessUserRequestAuthorizationUpdate> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor BizUser as Business User\n    participant IAM\n    participant OrgsAPI as Organizations API\n    participant Notification\n    participant EventBus\n\n    BizUser->>IAM: Login, navigate to \"Manage My Authorizations\"\n    IAM-->>BizUser: Display current authorizations\n\n    BizUser->>IAM: Click \"Request Additional Access\"\n    IAM-->>BizUser: Display form showing current authorizations\n\n    alt Add roles to existing organization\n        BizUser->>IAM: Select organization, add roles\n    else Add new organization\n        BizUser->>IAM: Search for new organization\n        IAM->>OrgsAPI: GET /organizations/search?query={query}&status=Active\n        OrgsAPI-->>IAM: Matching organizations\n        BizUser->>IAM: Select organization and roles\n    end\n\n    BizUser->>IAM: Enter justification\n    BizUser->>IAM: Submit update request\n\n    IAM->>IAM: Validate new roles are compatible with scope\n    IAM->>OrgsAPI: GET /organizations/{organizationCode}\n    OrgsAPI-->>IAM: Organization detail incl. Lead Admin contact\n\n    IAM->>IAM: Create AuthorizationRequest (Pending) for additions\n    IAM->>IAM: Generate approval link\n\n    Note over IAM: Request status: > Pending (for additions)<br/>Current authorizations for existing organizations remain Active\n\n    IAM--)EventBus: AuthorizationRequested\n    IAM->>Notification: Send approval email to Lead Admin\n    IAM->>Notification: Send confirmation email to BizUser\n\n    IAM-->>BizUser: Confirmation: Update request submitted\n\n    Note right of IAM: User retains existing access to current organizations<br/>until new request approved\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationRequested - fires when user submits update request. AuthorizationApproved or AuthorizationDenied - fires when Lead Admin acts on update." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Approval required: even for existing users, new roles/Organization require Lead Admin approval. Current access preserved: user retains existing authorizations during approval process. Multiple simultaneous requests: user can have multiple pending requests for different Organization." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Business User - Request Authorization Update" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: User adds new roles or Organization to existing authorization. When: User needs expanded access. Who: Business User with existing active authorization." .

<urn:solutiondesign:instance:iam:Seq_BusinessUserRequestLinkId> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor DistrictUser\n    participant StaffingAPI\n    participant IAM\n    participant IdentityRes as Identity Resolution\n    participant CommAPI\n    participant EventBus\n\n    DistrictUser->>StaffingAPI: Select employee record > \"Request Link ID\" (primaryUniqueId, secondaryUniqueId, justification)\n    StaffingAPI->>IAM: POST /identity-resolution/requests (origin=BusinessUserStaffing, type=LinkId, primaryUniqueId, secondaryUniqueId, justification)\n    IAM->>IAM: Create IdentityResolutionRequest (status: RequiresResolution) — no Mi-Key match phase\n    IAM--)EventBus: IdentityResolutionRequiresReview\n    IAM-->>StaffingAPI: 202 Accepted {requestId, status: RequiresResolution}\n    StaffingAPI-->>DistrictUser: Display pending notification with expected timeline\n\n    Note over IAM: See sequence: Identity Administrator - Resolve Identity Request<br/>(Approve: Mi-Key retires secondary, merges to primary. Deny: denial reason returned.)\n\n    alt Approved\n        IAM--)EventBus: IdentityResolutionCompleted (resolutionOutcome=ApproveLink)\n        StaffingAPI->>StaffingAPI: Merge employment history, credentials, and all associated records to primary Unique ID\n        CommAPI--)DistrictUser: Email notification: link approved\n        CommAPI--)DistrictUser: Notify any citizen account and any other district reporting either ID\n    else Denied\n        IAM--)EventBus: IdentityRequestDenied\n        CommAPI--)DistrictUser: Email notification with denial reason\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Mi-Key merge fails after admin approval > system retries or escalates to support; request remains Resolved pending merge completion. Requester submits without justification > 400 Bad Request." ;
	<urn:solutiondesign:ontology:eventsPublished> "IdentityResolutionRequiresReview - notifies Identity Administrators that a new item requires review. IdentityResolutionCompleted - notifies Staffing to begin data merge. IdentityRequestDenied - notifies requesting district user." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Link ID requests skip the Mi-Key match phase entirely and always require Identity Administrator judgment. Only one ID pair is merged per approved request. Staffing owns the post-merge data-migration mechanics; IAM owns only the request/approval lifecycle and the Mi-Key merge call itself." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Business User - Request Link ID" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: A district user requests that two Unique IDs believed to represent the same person be merged, with a required justification; always resolved by an Identity Administrator. When: District user, viewing an employee record, identifies what appears to be a duplicate Unique ID for the same individual. Who: Staffing Authorized User (School District role); Identity Administrator." .

<urn:solutiondesign:instance:iam:Seq_BusinessUserRequestNewId> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor DistrictUser\n    participant StaffingAPI\n    participant IAM\n    participant IdentityRes as Identity Resolution\n    participant CommAPI\n    participant EventBus\n\n    Note over StaffingAPI,IAM: Staffing has already created the employee record (status: Pending) and validated demographics locally\n\n    StaffingAPI->>IAM: POST /identity-resolution/requests (origin=BusinessUserStaffing, type=NewId, employeeRecordId, demographics)\n    IAM->>IAM: Create IdentityResolutionRequest (PendingMiKeyMatch)\n    IAM->>IdentityRes: Submit demographic payload (Mi-Key Assignment Service)\n\n    alt Mi-Key returns Match\n        IdentityRes-->>IAM: 200 OK {uniqueId, matchScore}\n        IAM->>IAM: IdentityResolutionRequest.status > Matched\n        IAM--)EventBus: IdentityResolutionCompleted (resolutionOutcome=Match, assignedUniqueId)\n        IAM-->>StaffingAPI: 200 OK {requestId, status: Matched, uniqueId}\n    else Mi-Key returns No Match (New ID Created)\n        IdentityRes-->>IAM: 201 Created {newUniqueId}\n        IAM->>IAM: IdentityResolutionRequest.status > NoMatchCreated\n        IAM--)EventBus: IdentityResolutionCompleted (resolutionOutcome=CreateNew, assignedUniqueId)\n        IAM-->>StaffingAPI: 201 Created {requestId, status: NoMatchCreated, uniqueId}\n    else Mi-Key returns Near Match\n        IdentityRes-->>IAM: 202 Accepted {potentialMatches[]}\n        IAM->>IAM: IdentityResolutionRequest.status > RequiresResolution\n        IAM-->>StaffingAPI: 202 Accepted {requestId, potentialMatches[]}\n        StaffingAPI-->>DistrictUser: Show near-match resolution screen (backed by IAM)\n\n        alt District user selects existing potential match (self-resolve)\n            DistrictUser->>IAM: POST /identity-resolution/requests/{requestId}/resolve (selectedUniqueId)\n            IAM->>IdentityRes: Confirm match (submittedData, selectedUniqueId)\n            IdentityRes-->>IAM: 200 OK {confirmedUniqueId}\n            IAM->>IAM: IdentityResolutionRequest.status > Resolved (self_resolved=true)\n            IAM--)EventBus: IdentityResolutionCompleted (resolutionOutcome=Match, assignedUniqueId)\n            IAM-->>DistrictUser: 200 OK {uniqueId}\n\n        else District user rejects all potentials, escalates\n            DistrictUser->>IAM: POST /identity-resolution/requests/{requestId}/escalate (justificationText)\n            IAM->>IAM: IdentityResolutionRequest remains RequiresResolution; now appears in the Identity Administrator review list\n            IAM--)EventBus: IdentityResolutionRequiresReview\n            IAM--)CommAPI: Publish notification event\n            IAM-->>DistrictUser: 202 Accepted (pending Identity Administrator review)\n\n            Note over IAM: See sequence: Identity Administrator - Resolve Identity Request\n\n            IAM--)EventBus: IdentityResolutionCompleted (resolutionOutcome=CreateNew) or IdentityRequestDenied\n            CommAPI--)DistrictUser: Email notification of outcome\n        end\n    end\n\n    Note over StaffingAPI: On IdentityResolutionCompleted, Staffing attaches assignedUniqueId to the EmployeeRoster record (see staffing-sequences.md)\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "District user selects potential match but Mi-Key confirm fails > 500 Internal Server Error, user retries. Identity Administrator denies new ID > IdentityRequestDenied; district user reviews potential matches again or contacts support. District user closes resolution screen without action > employee record remains Pending." ;
	<urn:solutiondesign:ontology:eventsPublished> "IdentityResolutionRequiresReview - notifies Identity Administrators that a new item requires review. IdentityResolutionCompleted - notifies Staffing that a Unique ID has been assigned. IdentityRequestDenied - notifies Staffing/district user that the Identity Administrator denied the new-ID request." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Staffing never calls Mi-Key directly; every identity resolution request flows through IAM's IdentityResolutionRequest. District user has final decision on match selection and can self-resolve without Identity Administrator involvement, unlike a citizen. Staffing consumes IdentityResolutionCompleted (or IdentityRequestDenied) asynchronously; it does not poll or hold local matching state." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Business User - Request New ID (Near Match Escalation)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: A district user adding a new employee (or updating an employee's demographics) triggers Mi-Key identity resolution through IAM; on a Near Match they review the candidate(s) and either self-resolve or escalate for Identity Administrator review. When: During Staffing's 'Add New Employee' workflow, after Staffing submits the employee's demographic data to IAM. Who: Staffing Authorized User (School District role)." .

<urn:solutiondesign:instance:iam:Seq_BusinessUserSelfRemoveAuthorization> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor BizUser as Business User\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    BizUser->>IAM: Login, navigate to \"Manage My Authorizations\"\n    IAM-->>BizUser: Display current authorizations (filtered by MiLogin type)\n\n    BizUser->>IAM: Select authorization(s) to remove\n    BizUser->>IAM: Optional: Enter removal reason\n    BizUser->>IAM: Confirm removal\n\n    IAM->>IAM: Validate user is removing their own authorization\n    IAM->>IAM: Revoke selected authorization(s)\n    IAM->>IAM: Invalidate authorization cache for user\n\n    Note over IAM: Authorization status: Active > Inactive<br/>Cache invalidation: immediate\n\n    IAM--)EventBus: AuthorizationRevoked\n    IAM->>Notification: Send confirmation email to BizUser\n    IAM->>Notification: Notify Lead Admin of self-removal (FYI)\n\n    alt User has no remaining authorizations for this MiLogin type\n        IAM-->>BizUser: Redirect to \"No Access\" page\n        Note over BizUser: User can submit new request<br/>or logout\n    else User has other authorizations\n        IAM-->>BizUser: Remain on authorization management page\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User attempts to remove last authorization > warning displayed (still allowed)." ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationRevoked with revokedBy: userId, reason: \\\"self-removal\\\"." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Immediate removal: self-removal is instant; no approval needed. Lead Admin notified: admin is informed but doesn't need to approve. MiLogin context: only removes authorizations for current MiLogin type." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Business User - Self-Remove Authorization" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: User removes their own authorization for an Organization or role. When: User no longer needs access or leaves position. Who: Business User." .

<urn:solutiondesign:instance:iam:Seq_BusinessUserWithdraws> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor BizUser as Business User\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    BizUser->>IAM: Login, navigate to \"My Authorization Requests\"\n    IAM-->>BizUser: Display pending requests (filtered by user)\n\n    BizUser->>IAM: Select request\n    BizUser->>IAM: Optional: Enter withdrawal reason\n    BizUser->>IAM: Click Withdraw\n\n    IAM->>IAM: Validate request is still Pending\n    IAM->>IAM: Mark request as Withdrawn\n    IAM->>IAM: Invalidate approval link\n\n    Note over IAM: Request status: Pending > Withdrawn\n\n    IAM--)EventBus: AuthorizationWithdrawn\n    IAM->>Notification: Notify Lead Admin (request withdrawn)\n\n    IAM-->>BizUser: Confirmation: Request withdrawn\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Attempt to withdraw non-Pending request > error message." ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationWithdrawn - fires when user withdraws request." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Link invalidation: Lead Admin's approval link becomes invalid when user withdraws. No re-activation: withdrawn requests cannot be re-activated." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Business User - Withdraws Pending Authorization Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Business user cancels their own pending authorization request. When: User changes mind before Lead Admin takes action. Who: Business User." .

<urn:solutiondesign:instance:iam:Seq_CitizenCancelPendingUpdate> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Citizen\n    participant IAM\n    participant EventBus\n\n    Citizen->>IAM: View pending request in history, click Cancel\n    IAM->>IAM: Validate request is type=AccountUpdate and status=RequiresResolution\n    IAM->>IAM: IdentityResolutionRequest.status > Cancelled\n    IAM->>IAM: Unlock Primary/Secondary fields\n    IAM--)EventBus: IdentityRequestCancelled\n    IAM-->>Citizen: Confirmation: request cancelled\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Attempt to cancel an AccountCreation-type request > rejected; only Identity Administrator can resolve those. Attempt to cancel a request no longer RequiresResolution > error message." ;
	<urn:solutiondesign:ontology:eventsPublished> "IdentityRequestCancelled." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Citizen User - Cancel Pending Update Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Citizen cancels their own pending Account Update request while it is RequiresResolution. When: Citizen views request status in their history and chooses to cancel. Who: Citizen User." .

<urn:solutiondesign:instance:iam:Seq_CitizenInitialSignIn> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Citizen\n    participant MiLogin\n    participant IAM\n    participant IdentityRes as Identity Resolution\n    participant EventBus\n\n    Citizen->>MiLogin: Authenticate\n    MiLogin-->>Citizen: Auth token (MiLogin Citizen) + redirect to MiEdWorkforce\n\n    Citizen->>IAM: Access MiEdWorkforce with token\n    IAM->>IAM: Validate token, extract MiLoginID, type=Citizen\n    IAM->>IAM: Check for existing authorizations (filtered by MiLogin type)\n\n    alt User has no Unique ID\n        IAM-->>Citizen: Redirect to Account Creation Landing Page\n        Citizen->>IAM: Submit demographic data (+ attestation)<br/>Optional: PIC/Unique ID hint, \"No SSN\" flag\n        IAM->>IAM: Validate against Identity Validations rules\n        alt Validation fails\n            IAM-->>Citizen: Display errors; data not sent to Mi-Key, not persisted\n        else Validation passes\n            IAM->>IAM: Create IdentityResolutionRequest (origin=CitizenSelfService, type=AccountCreation, PendingMiKeyMatch)\n            IAM->>IdentityRes: Submit demographic data (Mi-Key Assignment Service)\n            IdentityRes->>IdentityRes: Perform Mi-Key probabilistic identity matching\n\n            alt Match (score above threshold)\n                IdentityRes--)EventBus: UniqueIdAssigned\n                IAM->>IAM: IdentityResolutionRequest.status > Matched\n                IdentityRes-->>Citizen: Unique ID confirmation\n            else No Match (score below threshold) - New ID created\n                IdentityRes--)EventBus: UniqueIdAssigned\n                IAM->>IAM: IdentityResolutionRequest.status > NoMatchCreated\n                IdentityRes-->>Citizen: New Unique ID confirmation\n            else Near Match (score between thresholds)\n                IAM->>IAM: IdentityResolutionRequest.status > RequiresResolution<br/>(candidate match data withheld from citizen)\n                IAM--)EventBus: IdentityResolutionRequiresReview\n                IAM->>Notification: Notify citizen: request \"Requires Review\" (not \"Near Match\")\n                IAM-->>Citizen: Display \"Requires Review\" status; dashboard access blocked\n                Note over IAM: See sequence: Identity Administrator - Resolve Identity Request\n            end\n        end\n    end\n\n    alt IdentityResolutionRequest resolved to a Unique ID (Matched, NoMatchCreated, or Identity-Admin-resolved)\n        IAM->>IAM: Receive UniqueIdAssigned / IdentityResolutionCompleted\n        IAM->>IAM: Auto-create Individual scope authorization\n\n        Note over IAM: Authorization status: None > Active<br/>Scope: Individual<br/>MiLogin Type: Citizen\n\n        IAM--)EventBus: NewCitizenUserAuthorized\n        IAM-->>Citizen: Redirect to Educational Staff Dashboard\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Validation failure > user corrects and resubmits or cancels; nothing sent to Mi-Key. Identity matching fails (Mi-Key unavailable) > user remains on Account Creation page with error. Near Match > user cannot proceed to dashboard until Identity Administrator resolves." ;
	<urn:solutiondesign:ontology:eventsPublished> "IdentityResolutionRequiresReview - fires when Mi-Key returns Near Match. NewCitizenUserAuthorized - fires when Unique ID assigned/resolved and Individual authorization created." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Citizen auto-approval: no Lead Admin approval required. MiLogin context: authorization is tied to Citizen identity type. Near Match withholds candidate data: per FDD 15.8 §15.8.5, the citizen is never shown potential-match details or the term 'Near Match' — only a generic 'Requires Review'/'On Hold' status." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Citizen User - Initial Sign-In & Identity Resolution" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Citizen user authenticates, completes identity matching, and receives auto-approved Individual scope access. When: First-time citizen logs in via MiLogin. Who: Citizen User (teacher, educator)." .

<urn:solutiondesign:instance:iam:Seq_CitizenUpdateAccountDemographics> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Citizen\n    participant IAM\n    participant IdentityRes as Identity Resolution\n    participant StaffingAPI as Staffing (if active employment)\n    participant Notification\n    participant EventBus\n\n    Citizen->>IAM: Navigate to Personal Information > Update personal information\n    IAM-->>Citizen: Display demographic fields (SSN masked to last 4)\n\n    alt Unique ID associated with active employment\n        IAM-->>Citizen: Primary Demographic fields read-only<br/>(\"contact your district to update\")\n        Citizen->>IAM: Edit Secondary/Contact fields only\n    else No active employment\n        Citizen->>IAM: Edit Primary, Secondary, and/or Contact fields<br/>(may also uncheck \"No SSN\" and supply SSN, if applicable)\n    end\n\n    Citizen->>IAM: Agree to Attestation, click Submit\n    IAM->>IAM: Validate against Identity Validations rules\n\n    alt Validation fails\n        IAM-->>Citizen: Display errors; not sent to Mi-Key, not persisted\n    else Validation passes\n        IAM->>IAM: Create IdentityResolutionRequest (origin=CitizenSelfService, type=AccountUpdate, PendingMiKeyMatch)\n        IAM->>IdentityRes: Submit updated demographic data (Mi-Key Assignment Service)\n        IdentityRes->>IdentityRes: Perform Mi-Key probabilistic matching against Master Record\n\n        alt Match (exact or above threshold)\n            IdentityRes-->>IAM: Match confirmed; Master Record updated with non-matching fields\n            IAM->>IAM: IdentityResolutionRequest.status > Matched\n            IAM--)EventBus: PersonRecordUpdated\n            IAM->>Notification: Notify citizen: update successful (fields not itemized)\n            opt Active employment AND Secondary fields changed\n                IAM--)EventBus: PersonRecordUpdated (affectsActiveEmployment=true)\n                Notification->>StaffingAPI: Notify employing district(s) of update\n            end\n        else Near Match\n            IAM->>IAM: IdentityResolutionRequest.status > RequiresResolution<br/>Lock Primary + Secondary fields; Contact fields remain editable\n            IAM--)EventBus: IdentityResolutionRequiresReview\n            IAM->>Notification: Notify citizen: update pending review\n            IAM-->>Citizen: Confirmation: update submitted, pending review<br/>(dashboard access NOT blocked)\n            Note over IAM: See sequence: Identity Administrator - Resolve Identity Request\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Validation failure > user corrects or cancels. Mi-Key unavailable > error displayed, retry allowed." ;
	<urn:solutiondesign:ontology:eventsPublished> "PersonRecordUpdated - fires on successful Match. IdentityResolutionRequiresReview - fires on Near Match." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Active employment gates Primary fields: locked if the Unique ID is tied to active employment; only the employing district can change them. Near Match does not block dashboard access on Update (unlike Account Creation). Self-cancellable: the citizen retains the ability to cancel a pending Near Match update request." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Citizen User - Update Account Demographics" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Citizen User updates their own demographic data, subject to active-employment field locking, and Mi-Key re-matching. When: Citizen navigates to Account Details > Personal Information > Update personal information. Who: Citizen User with an established Unique ID." .

<urn:solutiondesign:instance:iam:Seq_ExternalPartyRequestRemoval> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Requestor as External Requestor\n    participant PublicForm as Public Website\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    Requestor->>PublicForm: Access public \"Authorization Removal Request\" form\n    PublicForm-->>Requestor: Display form\n\n    Requestor->>PublicForm: Enter:<br/>- Target user details (name, email, MiLoginID)<br/>- Requestor info (name, email, relationship)<br/>- Justification/reason<br/>- Attestation (checkbox)\n    Requestor->>PublicForm: Submit request\n\n    PublicForm->>IAM: Create RemovalRequest (Pending Admin Approval)\n    IAM->>IAM: Store request with status Pending\n    IAM->>IAM: Record requestor identity (IP, timestamp, details)\n\n    Note over IAM: RemovalRequest status: > Pending Approval\n\n    IAM--)EventBus: AuthorizationRemovalRequested\n    IAM->>Notification: Send review request to System Admin queue\n    IAM->>Notification: Send confirmation to Requestor email\n\n    IAM-->>PublicForm: Confirmation: Request submitted (display reference ID)\n    PublicForm-->>Requestor: Display confirmation message + reference ID\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationRemovalRequested - fires when external party submits request." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Admin approval required: external removal requests require System Admin review to prevent abuse. No authentication: form accessible without login for accessibility. Requestor identity captured: IP, timestamp, and contact info stored for accountability." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "External Party - Request User Authorization Removal" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Unauthenticated party submits public form to request removal of a user's authorization. When: Ex-supervisor, HR, or other party needs to revoke access for a user. Who: External Requesting Individual (no login required)." .

<urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor IdAdmin as Identity Administrator\n    participant IAM\n    participant IdentityRes as Identity Resolution\n    participant StaffingAPI as Staffing\n    participant Notification\n    participant EventBus\n\n    IdAdmin->>IAM: Open list of identity resolution requests requiring review\n    IAM-->>IdAdmin: Display \"Requires Resolution\" items (Unresolved tab; any origin/type)\n    IdAdmin->>IAM: Select item\n    IAM-->>IdAdmin: Display submitted data alongside Mi-Key potential match(es), or Link ID's primary/secondary record comparison\n\n    alt requestType = AccountCreation | AccountUpdate | NewId\n        alt Match - associate with existing Unique ID\n            IdAdmin->>IAM: Select \"Match\", choose existing Unique ID\n            IAM->>IdentityRes: Resolve near match: use existing Unique ID\n            IdentityRes-->>IAM: Confirmed\n            IAM->>IAM: IdentityResolutionRequest.status > Resolved (resolutionOutcome=Match)\n        else Create New - no true match\n            IdAdmin->>IAM: Select \"Create New\"\n            IAM->>IdentityRes: Resolve near match: create new Unique ID\n            IdentityRes-->>IAM: New Unique ID returned\n            IAM->>IAM: IdentityResolutionRequest.status > Resolved (resolutionOutcome=CreateNew)\n        else Deny/Cancel - submission invalid\n            IdAdmin->>IAM: Select \"Cancel\"/\"Deny\", enter explanatory notes\n            IAM->>IAM: IdentityResolutionRequest.status > Cancelled|Denied (resolutionOutcome=Cancel)\n        end\n\n        IAM--)EventBus: IdentityResolutionCompleted (or IdentityRequestDenied)\n        IAM->>Notification: Notify requester of outcome (email + on-screen)\n\n        alt Request origin = CitizenSelfService, type = AccountCreation, outcome != Cancel\n            IAM->>IAM: Auto-create Individual scope authorization (see Initial Sign-In sequence)\n            IAM--)EventBus: NewCitizenUserAuthorized\n        else Request origin = CitizenSelfService, type = AccountUpdate, outcome = Match/CreateNew\n            IAM->>IAM: Apply the previously-held update to the Person Record\n            IAM--)EventBus: PersonRecordUpdated\n            opt Active employment\n                Notification->>StaffingAPI: Notify employing district(s)\n            end\n        else Request origin = BusinessUserStaffing, type = NewId, outcome = CreateNew\n            StaffingAPI->>StaffingAPI: Attach assignedUniqueId to EmployeeRoster record (on IdentityResolutionCompleted)\n        end\n\n    else requestType = LinkId\n        alt Approve - Mi-Key merges secondary into primary\n            IdAdmin->>IAM: Select \"Approve Link\"\n            IAM->>IdentityRes: Retire secondary Unique ID, merge into primary\n            IdentityRes-->>IAM: Merge confirmed\n            IAM->>IAM: IdentityResolutionRequest.status > Resolved (resolutionOutcome=ApproveLink)\n            IAM--)EventBus: IdentityResolutionCompleted\n            StaffingAPI->>StaffingAPI: Merge all associated data (employment history, credentials) to primary Unique ID\n            Notification->>StaffingAPI: Notify requesting district, any citizen account, and any other district reporting either ID\n        else Deny\n            IdAdmin->>IAM: Select \"Deny\", enter denial reason\n            IAM->>IAM: IdentityResolutionRequest.status > Denied\n            IAM--)EventBus: IdentityRequestDenied\n            Notification->>StaffingAPI: Notify requesting district of denial reason\n        end\n    end\n\n    IAM-->>IdAdmin: Confirmation: request resolved\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Mi-Key unavailable during resolution call > error displayed, retry allowed; item remains RequiresResolution in the list." ;
	<urn:solutiondesign:ontology:eventsPublished> "IdentityResolutionCompleted or IdentityRequestDenied. NewCitizenUserAuthorized (CitizenSelfService AccountCreation) or PersonRecordUpdated (AccountUpdate)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "No candidate data shown to a citizen at any point for their own request; business-user requesters do see candidate data for their own submissions. Explanatory notes required on Cancel/Deny. List shape: Unresolved/Resolved tabs spanning every request type and origin." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Identity Administrator - Resolve Identity Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Identity Administrator reviews a 'Requires Resolution' item — a Near Match (Account Creation, Account Update, or business-user New ID escalation) or a Link ID request — and resolves it. The single resolution workflow for identity requests of any origin. When: Item appears in the list of identity resolution requests requiring review. Who: Identity Administrator." .

<urn:solutiondesign:instance:iam:Seq_LeadAdministratorBootstrap> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor LeadAdmin as Lead Administrator\n    participant MiLogin\n    participant IAM\n    participant OrgsAPI as Organizations API\n    participant EventBus\n    participant Notification\n\n    LeadAdmin->>MiLogin: Authenticate\n    MiLogin-->>LeadAdmin: Auth token (MiLogin Business/Worker)\n\n    LeadAdmin->>IAM: Access MiEdWorkforce with token\n    IAM->>IAM: Validate token, extract email, MiLoginID, type\n    IAM->>IAM: Check for existing authorizations (filtered by MiLogin type)\n\n    alt No existing authorizations AND MiLogin type is Business/Worker\n        IAM->>OrgsAPI: GET /organizations/by-lead-admin?email={userEmail}\n        Note over OrgsAPI: Returns unmasked Lead Admin email<br/>IAM caches result keyed by org code (60-min TTL)<br/>for subsequent approval routing\n        OrgsAPI-->>IAM: List of organizations where user is Lead Admin\n\n        alt User is Lead Admin for one or more organizations\n            loop For each organization\n                IAM->>IAM: Create Authorization (Active)<br/>Role: \"Organization Lead Administrator\"<br/>Scope: Organization<br/>GrantedBy: SYSTEM-BOOTSTRAP\n\n                Note over IAM: Authorization status: > Active<br/>No approval workflow<br/>System-managed role\n\n                IAM--)EventBus: AuthorizationApproved (bootstrap=true)\n            end\n\n            IAM->>Notification: Send welcome email to Lead Admin\n            IAM-->>LeadAdmin: Redirect to Lead Admin dashboard\n        else User is not a Lead Admin\n            IAM-->>LeadAdmin: Redirect to Authorization Request Form\n        end\n    else User already has authorizations\n        IAM-->>LeadAdmin: Redirect to dashboard\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationApproved with grantedBy: \\\"SYSTEM-BOOTSTRAP\\\"." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Auto-grant: system automatically grants 'Organization Lead Administrator' role. Organizations API as source of truth: email match against Lead Admin data synced from EEM via CEPI. Multiple Organizations: one person can be Lead Admin for multiple Organizations. No revocation on change: if EEM LeadAdmin changes, existing authorization is NOT automatically revoked." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Lead Administrator Bootstrap (First Login)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: When a user designated as Lead Administrator in EEM authenticates for the first time, they are automatically granted approval permissions. When: First login after being designated as Lead Admin in EEM. Who: Lead Administrator per EEM data." .

<urn:solutiondesign:instance:iam:Seq_MiLoginAuthenticationIntegration> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant App as MiEdWorkforce\n    participant IAM\n    participant OrgsAPI as Organizations API\n    participant MiLogin\n\n    User->>App: Click \"Login\"\n    App->>MiLogin: Redirect to /authorize (OIDC authorization code flow)\n    User->>MiLogin: Enter credentials, select identity type (Citizen/Business/Worker)\n    MiLogin-->>User: Redirect to callback with auth code\n\n    User->>App: Callback with auth code\n    App->>MiLogin: POST /token (exchange code for tokens)\n    MiLogin-->>App: ID token + access token\n\n    App->>IAM: Validate tokens, extract claims:<br/>- MiLoginID (sub)<br/>- MiLogin type (Citizen/Business/Worker)<br/>- Email<br/>- Name\n    IAM->>IAM: Check for existing authorizations<br/>(filtered by MiLogin type)\n\n    alt Has authorizations for this MiLogin type\n        IAM-->>App: Redirect to dashboard\n    else No authorizations AND MiLogin type = Business/Worker\n        IAM->>OrgsAPI: GET /organizations/by-lead-admin?email={userEmail}\n        alt User is Lead Admin\n            IAM->>IAM: Auto-grant Organization Lead Admin role(s)\n            IAM-->>App: Redirect to dashboard\n        else User is not Lead Admin\n            IAM-->>App: Redirect to authorization request form\n        end\n    else No authorizations AND MiLogin type = Citizen\n        alt User has Unique ID\n            IAM->>IAM: Auto-grant Individual scope\n            IAM-->>App: Redirect to dashboard\n        else User has no Unique ID\n            IAM-->>App: Redirect to identity resolution\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Display user-friendly error if auth fails; allow retry." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "OIDC authorization code flow; 30-second timeout for token exchange. Post-authentication routing depends on: whether the user has existing authorizations for their MiLogin type; for Business/Worker with none, whether they are an EEM Lead Admin; for Citizen with none, whether they already have a Unique ID." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "MiLogin Integration - Authentication (OIDC)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Authenticate user and obtain identity claims via OIDC, then route to dashboard, authorization request form, or identity resolution depending on existing authorizations and MiLogin type. When: User clicks 'Login' on MiEdWorkforce. Who: any user (Citizen/Business/Worker)." .

<urn:solutiondesign:instance:iam:Seq_ScopeApproverApproves> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor LeadAdmin as Lead Administrator\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    LeadAdmin->>IAM: Click approval link in email\n    IAM->>IAM: Validate link (not expired, not used, request still Pending)\n\n    alt Link valid\n        IAM-->>LeadAdmin: Display request details & requested roles\n\n        opt Modify roles\n            LeadAdmin->>IAM: Edit requested roles (add/remove)\n            IAM->>IAM: Validate modified roles are compatible with scope\n        end\n\n        LeadAdmin->>IAM: Optional: Add comments\n        LeadAdmin->>IAM: Click Approve\n\n        IAM->>IAM: Create Authorization (Active) with approved roles\n        IAM->>IAM: Record ApprovalAction (timestamp, comments, approver ID)\n        IAM->>IAM: Mark link as used\n        IAM->>IAM: Update request status to Approved\n\n        Note over IAM: Request status: Pending > Approved<br/>Authorization status: > Active<br/>Cache invalidation: user authorizations\n\n        IAM--)EventBus: AuthorizationApproved\n        IAM->>Notification: Send approval email to BizUser\n        IAM->>Notification: Send push notification to BizUser\n\n        IAM-->>LeadAdmin: Confirmation: Request approved\n    else Link expired\n        IAM-->>LeadAdmin: Error: Link expired (request must be resubmitted)\n    else Link already used\n        IAM-->>LeadAdmin: Error: Link already used\n    else Request withdrawn/denied\n        IAM-->>LeadAdmin: Error: Request no longer pending\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Expired link > user must resubmit request. Link already used > display error. Request withdrawn > cannot approve." ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationApproved - fires when Lead Admin approves request." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Role modification: Lead Admin can adjust roles before approval. Single-use link: once actioned, link cannot be reused. Cache invalidation: user authorization cache is cleared on approval." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Scope Approver - Approves Authorization Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Lead Administrator reviews authorization request and approves it (optionally modifying roles). When: Lead Admin clicks approval link in email notification. Who: Scope Authorization Approver (Lead Administrator per EEM)." .

<urn:solutiondesign:instance:iam:Seq_ScopeApproverRejects> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor LeadAdmin as Lead Administrator\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    LeadAdmin->>IAM: Click approval link in email\n    IAM->>IAM: Validate link (not expired, not used, request still Pending)\n\n    IAM-->>LeadAdmin: Display request details & requested roles\n\n    LeadAdmin->>IAM: Enter denial reason (optional but recommended)\n    LeadAdmin->>IAM: Click Deny\n\n    IAM->>IAM: Record denial with comments\n    IAM->>IAM: Mark link as used\n    IAM->>IAM: Update request status to Denied\n\n    Note over IAM: Request status: Pending > Denied\n\n    IAM--)EventBus: AuthorizationDenied\n    IAM->>Notification: Send denial email to BizUser (includes reason)\n    IAM->>Notification: Send push notification to BizUser\n\n    IAM-->>LeadAdmin: Confirmation: Request denied\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "User must resubmit entirely new request if denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationDenied - fires when Lead Admin denies request." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Denial reason: optional but recommended for user clarity. No authorization created: user must submit new request if denied." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Scope Approver - Rejects Authorization Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Lead Administrator denies authorization request with optional comments. When: Lead Admin clicks approval link and chooses to deny. Who: Scope Authorization Approver (Lead Administrator per EEM)." .

<urn:solutiondesign:instance:iam:Seq_SplitRetireIdMiKeyDirect> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor IdAdmin as Identity Administrator\n    participant MiKey as Mi-Key (external)\n    participant IAM\n    participant StaffingAPI\n    participant EventBus\n\n    IdAdmin->>MiKey: Split or Retire Unique ID directly in Mi-Key\n    MiKey--)IAM: Callback: IdentityRecordSplit or IdentityRecordRetired\n\n    alt Split\n        IAM--)EventBus: IdentityRecordSplit (originalUniqueId, newUniqueIds[])\n    else Retire\n        IAM--)EventBus: IdentityRecordRetired (retiredUniqueId, replacementUniqueId?)\n    end\n\n    StaffingAPI->>StaffingAPI: Update EMPLOYEE_ROSTER.unique_id references; flag retired IDs so search/submission reject them\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Callback not received (Mi-Key/MiEdWorkforce integration failure) > records remain unsynchronized until reconciliation; tracked as an operational concern, not a functional gap." ;
	<urn:solutiondesign:ontology:eventsPublished> "IdentityRecordSplit, IdentityRecordRetired." ;
	<urn:solutiondesign:ontology:initiatedBy> "external-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "No IdentityResolutionRequest is created for Split or Retire — there is no MiEdWorkforce-side request/approval workflow to model, only the resulting event. A Retired Unique ID must be rejected if submitted anywhere in MiEdWorkforce afterward (staffing's responsibility on consuming these events)." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Identity Resolution - Split/Retire ID (Mi-Key-Direct)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: An Identity Administrator splits or retires a Unique ID directly in Mi-Key (outside MiEdWorkforce); MiEdWorkforce receives the resulting callback/event and updates affected records. Per FDD 15.6/15.11's Addendum, neither action has a business-user-facing submission path in MiEdWorkforce. When: Identity Administrator determines, via Mi-Key or a Help Desk ticket, that a Unique ID represents multiple individuals (Split) or should no longer be used (Retire). Who: Identity Administrator (acting directly in Mi-Key)." .

<urn:solutiondesign:instance:iam:Seq_SystemAdminManualGrant> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor SysAdmin as System Administrator\n    participant IAM\n    participant OrgsAPI as Organizations API\n    participant Notification\n    participant EventBus\n\n    SysAdmin->>IAM: Navigate to \"Manage User Authorizations\"\n    IAM-->>SysAdmin: Display user search\n\n    SysAdmin->>IAM: Search for user (by email, MiLoginID, or name)\n    IAM-->>SysAdmin: Display user details and current authorizations\n\n    SysAdmin->>IAM: Click \"Grant New Authorization\"\n    IAM-->>SysAdmin: Display authorization form\n\n    SysAdmin->>IAM: Search for organization\n    IAM->>OrgsAPI: GET /organizations/search?query={query}\n    OrgsAPI-->>IAM: Matching organizations\n\n    SysAdmin->>IAM: Select organization, select roles\n    IAM->>IAM: Validate role-scope compatibility\n\n    SysAdmin->>IAM: Enter justification/notes (required)\n    SysAdmin->>IAM: Submit\n\n    IAM->>IAM: Create Authorization (Active, bypass approval workflow)\n    IAM->>IAM: Record manual grant in audit log\n    IAM->>IAM: Invalidate user authorization cache\n\n    Note over IAM: Authorization status: > Active<br/>(No Pending state, no approval workflow)<br/>GrantedBy: SysAdmin ID\n\n    IAM--)EventBus: AuthorizationApproved (manualGrant=true)\n    IAM->>Notification: Notify user (access granted)\n\n    IAM->>OrgsAPI: GET /organizations/{organizationCode}\n    OrgsAPI-->>IAM: Organization detail incl. Lead Admin contact\n    IAM->>Notification: Notify Lead Admin (admin-granted access)\n\n    IAM-->>SysAdmin: Confirmation: Authorization granted\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid role-scope combination > validation error. User not found > display error." ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationApproved with grantedBy: adminId, manualGrant: true." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Bypass approval: admin can directly grant without Lead Admin approval. Audit justification: admin must provide reason for manual grant (required field). Notification: user and Lead Admin both notified. Cache invalidation: user authorization cache cleared immediately." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "System Admin - Manual Authorization Grant" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: System Admin directly grants authorization without approval workflow. When: Emergency access needed or special circumstances. Who: System Administrator." .

<urn:solutiondesign:instance:iam:Seq_SystemAdminReviewsRemovalRequest> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor SysAdmin as System Administrator\n    participant IAM\n    participant Notification\n    participant EventBus\n\n    SysAdmin->>IAM: Login, navigate to \"Pending Removal Requests\" queue\n    IAM-->>SysAdmin: Display pending removal requests\n\n    SysAdmin->>IAM: Select request, review details\n    IAM-->>SysAdmin: Display:<br/>- Requestor info<br/>- Target user details<br/>- Justification<br/>- Target user's current authorizations\n\n    alt Approve removal\n        SysAdmin->>IAM: Optional: Add admin notes\n        SysAdmin->>IAM: Click Approve\n\n        IAM->>IAM: Revoke target user's authorization(s)\n        IAM->>IAM: Mark RemovalRequest as Approved\n        IAM->>IAM: Invalidate user authorization cache\n\n        Note over IAM: Authorization status: Active > Inactive<br/>RemovalRequest status: Pending > Approved\n\n        IAM--)EventBus: AuthorizationRevoked\n        IAM->>Notification: Notify target user (authorization removed)\n        IAM->>Notification: Notify requestor (request approved)\n        IAM->>Notification: Notify Lead Admin (authorization removed by admin)\n\n        IAM-->>SysAdmin: Confirmation: Removal approved\n\n    else Deny removal\n        SysAdmin->>IAM: Enter denial reason\n        SysAdmin->>IAM: Click Deny\n\n        IAM->>IAM: Mark RemovalRequest as Denied\n\n        Note over IAM: RemovalRequest status: Pending > Denied\n\n        IAM->>Notification: Notify requestor (request denied with reason)\n\n        IAM-->>SysAdmin: Confirmation: Removal denied\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Target user not found > admin can reject request with clarification." ;
	<urn:solutiondesign:ontology:eventsPublished> "AuthorizationRevoked - fires when admin approves removal (includes removedBy: \\\"external-request\\\")." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Manual review: System Admin validates legitimacy before revoking access. Denial option: admin can deny fraudulent or erroneous requests. Multi-party notification: target user, requestor, and Lead Admin all notified." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "System Admin - Reviews External Authorization Removal Request" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: System Admin reviews and approves/denies external authorization removal request. When: After external party submits removal request. Who: System Administrator." .

<urn:solutiondesign:instance:iam:SequencesDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "sequences" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/iam/iam-sequences.md" .

<urn:solutiondesign:instance:iam:TP_AuthorizationEvaluation> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:description> "Hierarchical RBAC authorization-decision algorithm: retrieve user authorizations (filtered by MiLogin type), determine if the required permission is scope-sensitive, resolve organization context and hierarchy via the Organizations API, match authorizations to the target organization (direct or transitive), check the permission against the matching role, grant if any authorization matches." ;
	<urn:solutiondesign:ontology:implementationNotes> "Authorization checks occur on every protected API call; target sub-10ms via a two-layer cache (evaluation-result cache + user-authorizations cache, both 5-minute TTL). Critical permissions (iam.authorization.grant, iam.authorization.revoke) always bypass cache. Permissions do not inherit upward or across organization types; Individual scope does not participate in hierarchy. Alternatives considered and rejected: flat RBAC (too many per-organization grants), full ABAC (too complex for a well-defined hierarchical structure), manual per-organization grants (administrative burden too high)." ;
	<urn:solutiondesign:ontology:steps> "1. Retrieve active authorizations for userId, filtered by current MiLogin identity type. 2. Determine if the required permission is scope-sensitive or scope-agnostic; scope-agnostic permissions grant immediately if present in any role. 3. For scope-sensitive permissions, extract Organization context from the request (X-Organization-Context header or query param); reject if absent. 4. Resolve the target organization's ancestor chain via GET /organizations/{code}/hierarchy. 5. For each authorization, check direct match (scope org == target org) or transitive match (target org is a descendant of scope org). 6. For matching authorizations, check if the required permission exists in the role's permission set; grant on first match, else continue; deny if no authorization matches." .

<urn:solutiondesign:instance:iam:TP_OrgDataCaching> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:description> "IAM maintains a response cache on top of the Organizations platform capability API (org detail, hierarchy, unmasked Lead Admin email, search results), separate from the authorization-evaluation cache, to avoid redundant HTTP calls on hot paths." ;
	<urn:solutiondesign:ontology:implementationNotes> "Cache keys: org-detail:{code} (60-min TTL), org-hierarchy:{code} (60-min TTL), lead-admin-email:{code} (60-min TTL), org-search:{queryHash} (15-min TTL, expiry only). Invalidated on OrganizationSyncCompleted (all detail/hierarchy), OrganizationDeactivated (affected org's detail/hierarchy + related auth cache entries), and LeadAdministratorChanged (affected org's lead-admin-email) events from the organizations-events Service Bus topic. On a lead-admin-email cache miss at approval-routing time, IAM falls back to a direct by-lead-admin call. Practical worst-case staleness ~25 hours (nightly EEM sync + 60-min consumer TTL) — see iam:Question_LeadAdminDataStaleness (iam-domain.ttl)." .

<urn:solutiondesign:instance:iam:TechnicalDesignDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "technical-design" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/iam/iam-technical-design.md" .

<urn:solutiondesign:instance:iam:TechnicalVisualSummaryDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "technical-design" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/iam/iam-technical-visual-summary.md" .

<urn:solutiondesign:instance:iam:UT_ActiveAuthorization> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The specific authorization context a user is currently operating under (users may have multiple authorizations but must select one at a time). A UI state management concern, not a backend domain flow — the backend is stateless and validates the scope supplied on each request." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Active Authorization" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> .

<urn:solutiondesign:instance:iam:UT_Authorization> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The assignment of a role to a user identity at a specified scope (e.g., 'Jane Smith is a Staffing Administrator for District 5')." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Authorization" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> .

<urn:solutiondesign:instance:iam:UT_IdentityProvider> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The login system the user identity is associated with (MiLogin Citizen, MiLogin Business, MiLogin Worker)." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Identity Provider" .

<urn:solutiondesign:instance:iam:UT_OrganizationHierarchy> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The ISD > District > Building structure with transitive permission inheritance." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Organization Hierarchy" .

<urn:solutiondesign:instance:iam:UT_Permission> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The atomic unit representing one action or a set of extremely closely related actions (e.g., AddEmployee, ViewCredentialApplications, IssueCredential). Permissions may be scope-sensitive (requiring organization context) or scope-agnostic (system-wide)." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Permission" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:iam:RoleDefinitionAggregate> .

<urn:solutiondesign:instance:iam:UT_Role> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "User-facing bundled permissions, grouped according to those most commonly assigned together (e.g., 'Staffing Administrator', 'Credential Processor')." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Role" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:iam:RoleDefinitionAggregate> .

<urn:solutiondesign:instance:iam:UT_Scope> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "An organizational boundary upon which permissions apply (e.g., Individual, Building, District, ISD, EPP, System-wide)." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Scope" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> .

<urn:solutiondesign:instance:iam:UT_ScopeSensitivePermission> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A permission that requires an organization context to be evaluated (e.g., staffing.employee.view requires knowing WHICH district/building)." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Scope-Sensitive Permission" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:iam:RoleDefinitionAggregate> .

<urn:solutiondesign:instance:iam:UT_TransitiveAuthorization> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "When evaluating permissions for an organization, authorizations granted at parent entities (ISD > District > Building) are automatically considered valid." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Transitive Authorization" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:iam:UserAuthorizationAggregate> .

<urn:solutiondesign:instance:iam:UserAccountDeactivatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "userId, miLoginId, deactivatedAt, reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "iam-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "User account deactivated due to inactivity" .

<urn:solutiondesign:instance:iam:UserAuthorizationAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:iam:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Ensures that users can only be granted authorizations that are valid for their identity provider, that appropriate approvals are obtained, and that the authorization lifecycle is properly tracked." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:AuthorizationApprovedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:AuthorizationDeniedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:AuthorizationExpiredEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:AuthorizationRequestedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:AuthorizationRevokedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:AuthorizationUpdatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:AuthorizationWithdrawnEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:NewCitizenUserAuthorizedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:iam:UserAccountDeactivatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:iam:Entity_Authorization> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:iam:Entity_AuthorizationRequest> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:AuthReqState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:AuthReqState_Denied> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:AuthReqState_Expired> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:AuthReqState_Pending> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:AuthReqState_Withdrawn> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:AuthState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:iam:AuthState_Inactive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_ApprovalAction> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_AuthRole> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_AuthScope> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:iam:VO_MiLoginIdentity> ;
	<urn:solutiondesign:ontology:invariants> "An authorization can only be granted after approval (except Citizen auto-approval). Business users must have at least one authorization to access the system. Citizen users are always scoped to Individual. Only one Active Authorization can be selected at a time. Authorization requests must be routed to the correct Scope Authorization Approver per EEM. Withdrawn or expired requests cannot be approved. Roles assigned must be appropriate for the scope type." ;
	<urn:solutiondesign:ontology:rootEntity> "Authorization" .

<urn:solutiondesign:instance:iam:VO_ApplicableMiLoginTypes> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The MiLogin identity type(s) (Citizen, Business, Worker) this role may be assigned under. Replaces the previously-considered 'User Group' concept." ;
	<urn:solutiondesign:ontology:name> "ApplicableMiLoginTypes" .

<urn:solutiondesign:instance:iam:VO_ApplicableScopes> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "List of scope types at which this role can be assigned (not which permissions it contains)." ;
	<urn:solutiondesign:ontology:name> "ApplicableScopes" .

<urn:solutiondesign:instance:iam:VO_ApprovalAction> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Record of approver decision (approved/denied, timestamp, comments, modified roles)." ;
	<urn:solutiondesign:ontology:name> "ApprovalAction" .

<urn:solutiondesign:instance:iam:VO_AuthRole> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Reference to a defined role with bundled permissions." ;
	<urn:solutiondesign:ontology:name> "Role" .

<urn:solutiondesign:instance:iam:VO_AuthScope> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The organizational boundary (type: Individual/Building/District/ISD/EPP/PLS/Nonpublic/System, entity code)." ;
	<urn:solutiondesign:ontology:name> "Scope" .

<urn:solutiondesign:instance:iam:VO_DeactivationSchedule> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When to run deactivation (e.g., first Friday of month)." ;
	<urn:solutiondesign:ontology:name> "DeactivationSchedule" .

<urn:solutiondesign:instance:iam:VO_InactivityThreshold> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Time period (e.g., 84 months)." ;
	<urn:solutiondesign:ontology:name> "InactivityThreshold" .

<urn:solutiondesign:instance:iam:VO_LinkDetails> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "For LinkId requests: the primary and secondary Unique IDs, and the requester's justification for believing they represent the same person." ;
	<urn:solutiondesign:ontology:name> "LinkDetails" .

<urn:solutiondesign:instance:iam:VO_MiLoginIdentity> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The authenticated identity from MiLogin (type: Citizen/Business/Worker, ID, email)." ;
	<urn:solutiondesign:ontology:name> "MiLoginIdentity" .

<urn:solutiondesign:instance:iam:VO_MiLoginTypeFilter> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Which identity provider types this policy applies to." ;
	<urn:solutiondesign:ontology:name> "MiLoginTypeFilter" .

<urn:solutiondesign:instance:iam:VO_NoSSNStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Whether the record carries the 'No SSN' flag (student interns / credential applicants only, CitizenSelfService origin only); mutually exclusive with a stored SSN." ;
	<urn:solutiondesign:ontology:name> "NoSSNStatus" .

<urn:solutiondesign:instance:iam:VO_RequestOrigin> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "CitizenSelfService | BusinessUserStaffing." ;
	<urn:solutiondesign:ontology:name> "RequestOrigin" .

<urn:solutiondesign:instance:iam:VO_RequestType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "AccountCreation | AccountUpdate | NewId | DemographicUpdate | LinkId." ;
	<urn:solutiondesign:ontology:name> "RequestType" .

<urn:solutiondesign:instance:iam:VO_ResolutionAction> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Identity Administrator's disposition (Match to existing Unique ID / Create New Unique ID / Approve Link / Deny / Cancel, with notes)." ;
	<urn:solutiondesign:ontology:name> "ResolutionAction" .

<urn:solutiondesign:instance:iam:VO_RolePermission> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Atomic action grant (domain.resource.action)." ;
	<urn:solutiondesign:ontology:name> "Permission" .

<urn:solutiondesign:instance:iam:VO_SubmittedDemographics> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The data snapshot sent to Mi-Key for this request (temporarily stored; not permanently retained if validation fails)." ;
	<urn:solutiondesign:ontology:name> "SubmittedDemographics" .

<urn:solutiondesign:instance:organizations:ApiDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "api-spec" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/organizations/organizations-api.yml" .

<urn:solutiondesign:instance:organizations:ApiSpec> a <urn:solutiondesign:ontology:ApiSpec> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:ApiDoc> ;
	<urn:solutiondesign:ontology:version> "1.0.0" .

<urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Synapse as Azure Synapse Pipeline\n    participant CEPI as CEPI CEDS JSON-LD API\n    participant OrgAPI as Organizations API\n    participant OrgDB as Organizations Database\n    participant EventBus as Event Bus\n\n    Synapse->>OrgDB: Open sync transaction; insert sync log record (status=Running)\n\n    Synapse->>CEPI: Authenticate (OAuth2 client credentials)\n    CEPI-->>Synapse: Access token\n\n    Synapse->>CEPI: GET /organizations (full snapshot or delta since last sync)\n    CEPI-->>Synapse: Organization records (CEDS JSON-LD)\n\n    loop For each organization record\n        Synapse->>OrgDB: Upsert organization (code, name, type, status, lead_admin_email, grade_band, ceds_metadata)\n\n        alt Organization type changed on existing record\n            Synapse->>OrgDB: Deactivate existing record (status=Inactive, deactivated_at=now)\n            Synapse->>OrgDB: Insert new record with same code, new type\n            Note over Synapse: Treat-as-new path; type is immutable on a record\n        else Organization newly absent from CEPI feed\n            Synapse->>OrgDB: Set status=Inactive, deactivated_at=now\n        end\n    end\n\n    Synapse->>OrgDB: Rebuild organization_hierarchy table\n    Note over Synapse,OrgDB: Recompute parent_organization_code and<br/>ancestor_organization_codes JSON array for all active orgs\n\n    Synapse->>OrgDB: Update sync log record (status=Succeeded, counts)\n    Synapse->>OrgAPI: POST /admin/jobs/sync/complete (notify API layer)\n\n    OrgAPI->>OrgAPI: Identify high-impact changes (deactivations, lead admin changes)\n\n    loop For each deactivated organization\n        OrgAPI--)EventBus: OrganizationDeactivated\n    end\n\n    loop For each lead admin change\n        OrgAPI--)EventBus: LeadAdministratorChanged\n    end\n\n    OrgAPI--)EventBus: OrganizationSyncCompleted\n\n    Note over EventBus: IAM worker receives events and invalidates<br/>affected cache entries\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "CEPI API unavailable after retries > Sync marked Failed; existing replica unchanged; alert fires to platform operations; OrganizationSyncCompleted is NOT published (consumers retain current cache). Individual record fails validation > Record skipped, warning logged, sync continues, marked PartialSuccess on completion; daily digest sent to platform operations. Hierarchy rebuild fails > Entire sync transaction rolls back, marked Failed, alert fires." ;
	<urn:solutiondesign:ontology:eventsPublished> "OrganizationDeactivated - Published for each organization newly deactivated this cycle; IAM invalidates authorization caches for users scoped to that org. LeadAdministratorChanged - Published for each organization whose lead_admin_email changed; IAM invalidates approval routing cache. OrganizationSyncCompleted - Published once per sync cycle on success; all consumers use this as the signal to consider cached org data potentially stale." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Full snapshot vs. delta: the pipeline supports both, but is currently implemented as a full snapshot upsert until CEPI confirms delta feed availability. Hierarchy rebuild on every sync: the full organization_hierarchy table is rebuilt each cycle rather than computing incremental changes, given the small org count (~4,000 active orgs). Transactional batch: the entire sync runs in a single transaction; a partial failure commits nothing. API notification after sync: Synapse writes directly to the database (ETL responsibility) but notifies the API layer on completion so event publishing and any post-sync business logic stay in the API layer, consistent with the principle that domain logic lives in APIs." ;
	<urn:solutiondesign:ontology:schedule> "Nightly at 1 AM EST via Azure Synapse scheduled trigger. May also be triggered manually by a System Admin via POST /admin/jobs/sync in recovery scenarios (see Op_TriggerOrgSync) — sd:initiatedBy is still \"internal-system\" for this node since that's the normal/primary trigger; the manual-trigger path is the same underlying pipeline run, not a distinct sequence." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "CEPI Nightly Sync" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Pulls current organization data from the CEPI CEDS JSON-LD API, updates the local replica, rebuilds the materialized hierarchy, and publishes change events for high-impact mutations. When: Nightly at 1 AM EST via Azure Synapse scheduled trigger; may also be triggered manually by a System Admin via POST /admin/jobs/sync in recovery scenarios. Who: Azure Synapse Pipeline (system-initiated)." .

<urn:solutiondesign:instance:organizations:BuildingsLookupOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "CONFIRMED GAP (cross-domain consistency pass): organizations is now really converted in abox/mied-v3/organizations/organizations-api.ttl, and it exposes no descendant/children lookup (buildings within a district/ISD) — only orgs:Op_GetOrganizationHierarchy, which returns the ANCESTOR chain up to root (the opposite direction), plus orgs:Op_SearchOrganizations, orgs:Op_GetOrganization, and orgs:Op_GetOrganizationsByLeadAdmin, none of which returns child organizations. Called live (EEMAPI GET /organizations/{entityCode}/buildings) in the 'Create New Position' sequence, which sits awkwardly against staffing-domain.md's own Dependencies table, which instead describes this dependency as a 'Synced local replica' rather than a live REST call — see the Dependency notes below for this discrepancy, now compounded by organizations' real surface not exposing this call at all." ;
	<urn:solutiondesign:ontology:path> "/organizations/{entityCode}/buildings" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Returns the buildings within an organization's EEM hierarchy, including grade-level authorization." .

<urn:solutiondesign:instance:organizations:Cat_Organizations> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Organizations" .

<urn:solutiondesign:instance:organizations:DomainDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "domain" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/organizations/organizations-capability.md" .

<urn:solutiondesign:instance:organizations:Fdd08_1EntityDirDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "A DIFFERENT, separately-specified mechanism for the same underlying goal (EEM entity data into MiEdWorkforce): a Synapse ETL pipeline reading EEM's SQL tables directly (Managed Identity auth, no REST layer) and populating CEDS IDS tables, explicitly built to 'remove the dependency on the CEPI Public Service EEM Entity Information services' that the sibling 8.1 EEM Interface IDD describes. See Question_EemIntegrationMechanismDiscrepancy below — three different described mechanisms exist across this folder plus the real organizations-domain build. 9 review comments, all editorial TBD-field nagging." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.1 - EEM Interface/8.1 - Entity Directory Data Population IDD.docx" .

<urn:solutiondesign:instance:organizations:GradeBand> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Low grade and high grade pair representing an organization's authorized serving range (e.g., KG-05, 09-12). Null if not applicable or not configured in EEM for this org type." ;
	<urn:solutiondesign:ontology:name> "GradeBand" .

<urn:solutiondesign:instance:organizations:LeadAdministrator> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Email address (and name where available) of the designated approver for this organization, as sourced from EEM. Considered internal operational data — never returned through any public or external-facing API; only a masked email is returned to non-admin/UI callers, with the full unmasked email reserved for IAM's internal-service lookup." ;
	<urn:solutiondesign:ontology:name> "LeadAdministrator" .

<urn:solutiondesign:instance:organizations:LeadAdministratorChangedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "organizationCode, previousEmail, newEmail, effectiveAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "organizations-events" ;
	<urn:solutiondesign:ontology:trigger> "Lead Admin email changed during sync" .

<urn:solutiondesign:instance:organizations:Op_CompleteSyncJob> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:organizations:SyncLogAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "organizations-api.yml states this is 'Restricted at the Istio layer to the Synapse managed identity only' and names no IAM permission at all — left with no PermissionRequirement, an honest documented gap (access control here is Istio-identity-based, not an IAM permission grant) rather than an invented permission." ;
	<urn:solutiondesign:ontology:operationId> "completeSyncJob" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/jobs/sync/complete" ;
	<urn:solutiondesign:ontology:projection> "Request body {syncLogId, status, recordsCreated, recordsUpdated, recordsDeactivated, failureReason} is a partial update of the SyncLogAggregate record opened at sync start — reports only the fields available at completion time (no recordsProcessed or pipelineRunId in this payload, though both exist on the stored aggregate). 200 response has no body — producesShape deliberately left unset." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Mark sync complete and publish change events (Synapse only)" ;
	<urn:solutiondesign:ontology:tags> "AdminJobs" .

<urn:solutiondesign:instance:organizations:Op_GetOrganization> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Also callable indirectly via another domain's own UI acting as the caller (per organizations-sequences.md's Organization Detail Lookup: 'Caller (UI or Internal Service)'); accessType still recorded as internal-service since the API itself is never exposed through APIM." ;
	<urn:solutiondesign:ontology:operationId> "getOrganization" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/organizations/{organizationCode}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:projection> "OrganizationDetail extends the base OrganizationSummary fields with gradeBand (the GradeBand value object), leadAdministrator (the LeadAdministrator value object, email masked for this endpoint — e.g. j***@district5.edu), directParent (an OrganizationSummary for the immediate parent, null for root ISDs and standalone types), and lastSyncedAt." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get organization details" ;
	<urn:solutiondesign:ontology:tags> "Organizations" .

<urn:solutiondesign:instance:organizations:Op_GetOrganizationHierarchy> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Restricted at the Istio layer to IAM's service account principal, in addition to the standard IAM permission check on organizations.hierarchy.view." ;
	<urn:solutiondesign:ontology:operationId> "getOrganizationHierarchy" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/organizations/{organizationCode}/hierarchy" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:organizations:OrganizationHierarchyEntity> ;
	<urn:solutiondesign:ontology:projection> "Reshapes the entity's stored ancestor_organization_codes array into an ordered array of OrganizationSummary objects (root to direct parent), plus organizationCode (echoed) and a computed depth integer. Empty ancestors array for a root ISD." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get materialized ancestor chain (internal — IAM only)" ;
	<urn:solutiondesign:ontology:tags> "Organizations" .

<urn:solutiondesign:instance:organizations:Op_GetOrganizationsByLeadAdmin> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Restricted at the Istio layer to IAM's service account principal. Returns unmasked Lead Administrator email — the only endpoint that does." ;
	<urn:solutiondesign:ontology:operationId> "getOrganizationsByLeadAdmin" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/organizations/by-lead-admin" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response is {email (echoed), organizations: OrganizationWithLeadAdmin[]} — each entry is OrganizationSummary plus gradeBand and leadAdministrator, the latter returned via LeadAdministratorFull (unmasked email) rather than the masked form Op_GetOrganization uses. The only endpoint that returns an unmasked Lead Administrator email, consistent with being restricted to IAM's service account." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get organizations by Lead Administrator email (internal — IAM only)" ;
	<urn:solutiondesign:ontology:tags> "Organizations" .

<urn:solutiondesign:instance:organizations:Op_GetSyncLog> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "getSyncLog" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/sync-log" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:organizations:SyncLogAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response is {entries: SyncLogEntry[]}, each mirroring SyncLogAggregate's stored fields (id, syncStartedAt, syncCompletedAt, status, recordsProcessed/Created/Updated/Deactivated, failureReason, pipelineRunId) in full, optionally filtered by status and capped by limit (default 20, max 100)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "View sync execution history (System Admin / Platform Ops)" ;
	<urn:solutiondesign:ontology:tags> "AdminJobs" .

<urn:solutiondesign:instance:organizations:Op_ListOrganizationTypes> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listOrganizationTypes" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/organization-types" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:organizations:OrganizationTypeAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response is {organizationTypes: OrganizationTypeSummary[]} — typeCode, displayName, participatesInHierarchy per type; mirrors OrganizationTypeAggregate's fields directly, optionally filtered by the participatesInHierarchy query parameter." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List active organization types" ;
	<urn:solutiondesign:ontology:tags> "OrganizationTypes" .

<urn:solutiondesign:instance:organizations:Op_SearchOrganizations> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "organizations-api.yml documents this operation as requiring the 'organizations.organization.search' permission, but organizations-permissions.md's permission catalog has no such entry anywhere (not even a passing mention, unlike the hierarchy.view case below) — left with no PermissionRequirement, a genuine, documented gap rather than a fabricated permission. Also callable indirectly via another domain's own UI (org selectors, authorization request forms) acting as the caller, not just internal services directly; accessType still recorded as internal-service since the API itself is never exposed through APIM." ;
	<urn:solutiondesign:ontology:operationId> "searchOrganizations" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/organizations/search" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response is an array of OrganizationSummary — organizationCode, name, organizationType, status only. A lightweight projection of the full OrganizationAggregate, deliberately excluding grade band, Lead Administrator, and hierarchy detail (see Op_GetOrganization for the full-detail shape)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Typeahead search for organizations" ;
	<urn:solutiondesign:ontology:tags> "Organizations" .

<urn:solutiondesign:instance:organizations:Op_TriggerOrgSync> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Also called by the Synapse pipeline itself on scheduled runs, in addition to System Admin emergency use." ;
	<urn:solutiondesign:ontology:operationId> "triggerOrgSync" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:organizations:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/jobs/sync" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:organizations:SyncLogAggregate> ;
	<urn:solutiondesign:ontology:projection> "202 response (SyncJobResult) returns only syncLogId, startedAt, and estimatedCompletionAt — the newly created sync log's identity and timing, not its full shape, since the run has only just started and count/status fields aren't populated yet." ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ reason?: string (max 500 chars) } — an optional free-text audit note for the manual trigger, not a domain-model entity; consumesShape deliberately left unset." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Trigger manual organization sync run (System Admin / Synapse)" ;
	<urn:solutiondesign:ontology:tags> "AdminJobs" .

<urn:solutiondesign:instance:organizations:OrgState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:organizations:OrgState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:organizations:OrgTypeState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:organizations:OrgTypeState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:organizations:OrganizationAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:cedsAlignment> "CEDS Education Organization — confirmed by organizations-capability.md's own framing (\"locally replicated, CEDS-aligned replica of organization records\", the ceds_metadata column storing \"Full CEDS JSON-LD payload from CEPI\"), not an inference: the source data itself IS a CEDS-aligned payload, one entity per Organization record. The exact CEDS element/entity name isn't spelled out beyond \"CEDS-aligned\", so this string names the closest standard CEDS concept (an educational institution/agency entity) rather than a specific numbered CEDS element ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents a single educational entity and all attributes needed by consuming domains — identity, type, hierarchy position, grade band, and Lead Administrator designation. Protects the invariant that no MiEdWorkforce domain ever needs to call EEM directly for organizational context." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:organizations:LeadAdministratorChangedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:organizations:OrganizationDeactivatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:organizations:OrganizationHierarchyEntity> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:OrgState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:OrgState_Inactive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:organizations:GradeBand> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:organizations:LeadAdministrator> ;
	<urn:solutiondesign:ontology:invariants> "Every organization has exactly one organization code, which is immutable. Every organization has exactly one Lead Administrator at any point in time; this is sourced from EEM and cannot be overridden in MiEdWorkforce (enforced by: the sync pipeline sets lead_admin_email from CEPI data only, no write endpoint exists for this field). An organization's type is immutable once created; type changes in EEM result in deactivation of the old record and creation of a new one with a new internal ID, same organization code (enforced by: sync pipeline routes type-mismatched records to a deactivate-and-recreate path rather than an update path). A Building may have either a District or an ISD as its direct parent; both are valid. Hierarchy relationships are sourced exclusively from EEM; MiEdWorkforce does not allow manual hierarchy edits. Organizations deactivated in EEM are marked Inactive but never hard-deleted — historical records in consuming domains (authorizations, assignments, enrollments) may still reference them (enforced by: the sync pipeline's deactivation path only ever sets status=Inactive and deactivated_at). See Rule_LeadAdministratorSourcedFromEEM, Rule_OrganizationTypeImmutable, and Rule_InactiveOrganizationsRetained below for these same rules promoted to queryable sd:BusinessRule nodes." ;
	<urn:solutiondesign:ontology:rootEntity> "Organization" .

<urn:solutiondesign:instance:organizations:OrganizationDeactivatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "organizationCode, organizationType, deactivatedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "organizations-events" ;
	<urn:solutiondesign:ontology:trigger> "Org marked Inactive during sync" .

<urn:solutiondesign:instance:organizations:OrganizationHierarchyEntity> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Materialized parent-child relationship for an organization, rebuilt on each sync cycle. Stores the direct parent plus the full ancestor chain (ordered root-to-parent) as a single-row, single-lookup structure specifically so IAM's transitive permission evaluation can meet a sub-10ms target without recursive runtime traversal." ;
	<urn:solutiondesign:ontology:name> "OrganizationHierarchy" .

<urn:solutiondesign:instance:organizations:OrganizationSyncCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "NOT published on Failed sync runs — deliberately absent so consumers retain their current cache rather than being told to consider it stale. Consumers should treat this as their sole signal for 'cached org data may be stale' and should not depend on the per-record events below for freshness." ;
	<urn:solutiondesign:ontology:payloadHighlights> "syncId, recordsCreated, recordsUpdated, recordsDeactivated, completedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "organizations-events" ;
	<urn:solutiondesign:ontology:trigger> "Sync pipeline completes successfully" .

<urn:solutiondesign:instance:organizations:OrganizationTypeAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "The catalog of valid organization types present in EEM (Building, District, ISD, EPP, Nonpublic, PLS), each flagged as to whether it participates in the ISD > District > Building hierarchy. Building, District, and ISD participate in the hierarchy; EPP, Nonpublic, and PLS are standalone." ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:OrgTypeState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:OrgTypeState_Inactive> ;
	<urn:solutiondesign:ontology:invariants> "The type list is stable between sync cycles — callers may cache with a 24-hour TTL. Type list changes only via code deployment, not via the sync pipeline itself." ;
	<urn:solutiondesign:ontology:rootEntity> "OrganizationType" .

<urn:solutiondesign:instance:organizations:OrganizationsContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:displayName> "Organizations" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:organizations:OrganizationTypeAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:organizations:SyncLogAggregate> ;
	<urn:solutiondesign:ontology:identifier> "organizations" ;
	<urn:solutiondesign:ontology:kind> "PlatformCapability" ;
	<urn:solutiondesign:ontology:notes> "Classified as a Platform Capability rather than a Core Domain because it owns no business processes and enforces no domain-specific invariants beyond faithful replication; its business meaning is defined externally by EEM/CEPI. Explicitly does NOT own: organization data at its source (external-eem, via CEPI), authorization decisions that use organization data (iam), position-level grade bands (staffing), EPP-specific organization configuration such as designation dates/program approvals (epp), Professional Learning sponsor configuration (proflearning), or any write operations — MiEdWorkforce cannot modify EEM data." ;
	<urn:solutiondesign:ontology:purpose> "The authoritative source of truth for educational organization data within MiEdWorkforce. Maintains a locally replicated, CEDS-aligned replica of organization records sourced from CEPI's CEDS JSON-LD API (which itself reflects EEM as the upstream source of record), and exposes that data through a focused read-only API consumed by all domains that need organizational context. Exists so that no domain needs to integrate directly with EEM or CEPI for organization lookups." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:EPPProviderCreatedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:epp:EPPProviderModifiedEvent> .

<urn:solutiondesign:instance:organizations:Perm_HierarchyView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Retrieve the materialized ancestor chain for an organization (internal — IAM only)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:organizations:Cat_Organizations> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Source-document inconsistency, not a fabrication: organizations-permissions.md's main permissions table omits this permission entirely, yet its own 'Note on Internal Service Permissions' names it explicitly ('organizations.hierarchy.view and organizations.lead-admin.view are marked as internal service permissions... enforced at the Istio authorization policy layer... User-facing roles do not include these permissions'), and organizations-api.yml's getOrganizationHierarchy operation requires it by name. Modeled here because it is genuinely named in the source (unlike organizations.organization.search — see organizations-api.ttl's note on Op_SearchOrganizations, which is NOT modeled as a Permission for exactly that reason)." ;
	<urn:solutiondesign:ontology:permissionId> "organizations.hierarchy.view" .

<urn:solutiondesign:instance:organizations:Perm_LeadAdminView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Retrieve Lead Administrator contact for an organization" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:organizations:Cat_Organizations> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Internal service permission; consumed by IAM for authorization approval routing. Lead Admin email not exposed to non-admin users directly — enforced at the Istio authorization policy layer (only IAM's service account principal may call the endpoint) in addition to this IAM permission check." ;
	<urn:solutiondesign:ontology:permissionId> "organizations.lead-admin.view" .

<urn:solutiondesign:instance:organizations:Perm_OrgTypesView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "List active organization types" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:organizations:Cat_Organizations> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Granted to all authenticated users; used to populate type filter dropdowns." ;
	<urn:solutiondesign:ontology:permissionId> "organizations.org-types.view" .

<urn:solutiondesign:instance:organizations:Perm_OrganizationView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View organization details, grade band, and Lead Administrator" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:organizations:Cat_Organizations> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Granted to all authenticated users; required to use org search and detail endpoints." ;
	<urn:solutiondesign:ontology:permissionId> "organizations.organization.view" .

<urn:solutiondesign:instance:organizations:Perm_SyncLogView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View sync execution history and status" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:organizations:Cat_Organizations> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin / Platform Operations only." ;
	<urn:solutiondesign:ontology:permissionId> "organizations.sync-log.view" .

<urn:solutiondesign:instance:organizations:Perm_SyncTrigger> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manually trigger an organization sync run" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:organizations:Cat_Organizations> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; reserved for emergency re-seeding or post-failure recovery. Normal sync is pipeline-driven." ;
	<urn:solutiondesign:ontology:permissionId> "organizations.sync.trigger" .

<urn:solutiondesign:instance:organizations:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "permissions" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/organizations/organizations-permissions.md" .

<urn:solutiondesign:instance:organizations:Question_CepiApiContractUnconfirmed> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "CEPI's CEDS JSON-LD API is still under development and its contract isn't finalized on three fronts: (1) field coverage — organization code, name, type, status, Lead Administrator email, parent organization code, and grade band (low/high) are all needed, and it's unconfirmed whether CEPI provides all of these or some require supplemental sourcing; (2) feed shape — whether CEPI will provide a delta feed (changed records only) or a full snapshot on every sync cycle (the pipeline is currently implemented as full-snapshot-upsert pending this); (3) API availability SLA and rate limit are both unstated. Authentication mechanism is also unconfirmed (expected: OAuth2 client credentials with Azure Key Vault secret storage), and until the API is available a manual seed process populates initial org data. (Open Questions #1, #2, #3.)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:external:EEMSystem> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:owner> "Engineering (organizations) / CEPI" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:organizations:Question_EemIncrementalLoadNotYetBuilt> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "8.1.7 (Entity Directory Data Population Addendum) describes true incremental/delta EEM updates as a built capability ('the ETL identifies records that have been added, modified, or deactivated since the previous load'). orgs:BatchJob_CepiNightlySync's own sd:keyDecisions explicitly state the opposite: full-snapshot upsert only, delta support pending CEPI confirming feed availability. The story is not wrong about the DESIRED end state, just about the CURRENT one — worth tracking as a real, not-yet-closed gap between this FDD's Addendum and organizations' own domain documentation, independent of the transport-mechanism discrepancy above." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:organizations:Req_08_1_7> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:Fdd08_1EntityDirDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:organizations:Question_EemIntegrationMechanismDiscrepancy> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Three different, mutually inconsistent mechanisms are described/built for the single goal of 'get EEM entity data into MiEdWorkforce': (1) the 8.1 EEM Interface IDD describes a bearer-token REST API against CEPI.PublicServices/api/EntityInformation/{method}; (2) the sibling 8.1 Entity Directory Data Population IDD describes a Managed-Identity Synapse pipeline reading EEM's own SQL tables directly (explicitly built to REMOVE dependency on mechanism (1)) and populating CEDS IDS tables with a totally different field-mapping shape; (3) organizations-domain.ttl's actually-built orgs:BatchJob_CepiNightlySync does neither — it's a Synapse-triggered OAuth2 REST pull against a 'CEPI CEDS JSON-LD API' GET /organizations endpoint that matches organizations-capability.ttl's own architecture note ('CEPI is building a CEDS JSON-LD API on top of EEM specifically for MiEdWorkforce'). Functionally the built BatchJob satisfies the STORIES (validate/load/sync/audit), so this is not scored as a coverage gap — but it means neither of this FDD's own two IDDs is an accurate description of what was actually built, which matters if either is ever used as an integration reference." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:organizations:Req_08_1_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:organizations:Req_08_1_5> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_1EemDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:organizations:Question_GradeBandNullVsFullRange> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Does EEM distinguish between a building with no grade band configured vs. one that genuinely serves all grades? Null and \"K-12\" are meaningfully different for staffing placement validation, but it's unconfirmed whether EEM's own data model makes this distinction or whether an unconfigured grade band and an all-grades building are indistinguishable at the source. (Open Question #4.)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:organizations:GradeBand> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:organizations:Question_LeadAdminMultiOrgAssignment> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can a single person be designated as Lead Administrator for multiple organizations simultaneously in EEM? Op_GetOrganizationsByLeadAdmin's own response shape (an array of organizations for one email) implies yes, but this isn't confirmed against EEM's actual data model, and no source document states a cardinality constraint either way. (Open Question #5.)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:organizations:LeadAdministrator> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:organizations:Op_GetOrganizationsByLeadAdmin> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:organizations:Req_08_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Receives the entity data payload from EEM via the established integration; validates data format, required fields, and record structure before processing; parses and loads new/updated organization information into the MiEdWorkforce data store; logs any invalid/missing data with a description; logs every transmission with instance name, date, and record count." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_1EemDoc> ;
	<urn:solutiondesign:ontology:notes> "Functionally satisfied by orgs:BatchJob_CepiNightlySync (validates each record, skips/warns on failure, upserts into the local Organization replica) — but see Question_EemIntegrationMechanismDiscrepancy: the TRANSPORT this story and its sibling 8.1 EEM Interface IDD describe (bearer-token REST against CEPI.PublicServices/api/EntityInformation/{method}) does not match what organizations-domain.ttl's own BatchJob actually calls (OAuth2 against a 'CEPI CEDS JSON-LD API' GET /organizations endpoint), nor what the sibling Entity Directory Data Population IDD describes (a Synapse pipeline reading EEM's SQL tables directly). All three describe the same end goal by three different, mutually inconsistent mechanisms." ;
	<urn:solutiondesign:ontology:requirementId> "8.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:EEMSystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to receive entity data from EEM so that organization and address records can be maintained accurately." ;
	<urn:solutiondesign:ontology:title> "Receive EEM entity data into MiEdWorkforce" .

<urn:solutiondesign:instance:organizations:Req_08_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Logs transmission start/end times, record counts, and processing outcomes; captures specific error issues; audit logs stored securely and reviewable by authorized personnel; log retention complies with MiEdWorkforce's defined retention policy." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_1EemDoc> ;
	<urn:solutiondesign:ontology:notes> "The BatchJob's own sync-log record (status, counts) and errorScenarios (Failed/PartialSuccess with alerting) cover the transaction-tracking half well. 'Log retention complies with MiEdWorkforce's defined retention policy' is not itself a modeled concept anywhere (same open-ended retention-policy gap the NASDTEC comment thread flags for 8.2 below) — not raised as a separate Annotation given how minor/generic it is." ;
	<urn:solutiondesign:ontology:requirementId> "8.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to record audit and logging details for all EEM data transfers so that each transaction can be tracked and reviewed." ;
	<urn:solutiondesign:ontology:title> "Audit and log EEM data transfers" .

<urn:solutiondesign:instance:organizations:Req_08_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Retrieves the entire dataset from EEM on a scheduled full load; replaces existing organization data with the current EEM version; includes validation to prevent duplication/data loss; logs execution time, record count, and completion status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_1EemDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: BatchJob_CepiNightlySync's own keyDecisions state it 'is currently implemented as a full snapshot upsert' nightly, exactly this story's shape." ;
	<urn:solutiondesign:ontology:requirementId> "8.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to perform scheduled full loads of EEM data periodically so that baseline data integrity is ensured." ;
	<urn:solutiondesign:ontology:title> "Perform scheduled full loads of EEM data" .

<urn:solutiondesign:instance:organizations:Req_08_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Synchronizes organization details to match the authoritative EEM source on update; alignment covers entity identifiers, hierarchy, and operational status; confirms successful updates and logs results; discrepancies found during sync are reported for manual review." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_1EemDoc> ;
	<urn:solutiondesign:ontology:notes> "Identifier/hierarchy/operational-status alignment matches the BatchJob's hierarchy-rebuild and OrganizationDeactivated/LeadAdministratorChanged event logic well. 'Discrepancies... reported for manual review' has no exact counterpart — the BatchJob's own error handling is Failed/PartialSuccess alerting to platform operations, not a discrepancy-specific manual-review queue; a minor gap, not raised separately." ;
	<urn:solutiondesign:ontology:requirementId> "8.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to ensure data synchronization between EEM and MiEdWorkforce so that all organization information remains aligned." ;
	<urn:solutiondesign:ontology:title> "Keep MiEdWorkforce and EEM organization data synchronized" .

<urn:solutiondesign:instance:organizations:Req_08_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "ETL extracts and transforms EEM entity data into the MiEdWorkforce organizational format; each record includes entity identifiers, names, hierarchy relationships, and operational status; organization identifiers are consistent across environments; successful loads and rejected records (with error details) are logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:Fdd08_1EntityDirDoc> ;
	<urn:solutiondesign:ontology:notes> "Same underlying goal and the same mechanism-discrepancy caveat as Req_08_1_1 above — this story is the Entity Directory Data Population IDD's own restatement of essentially the same ETL/hierarchy/status requirement, via yet a third described transport (direct-SQL Synapse read) that also doesn't match the built BatchJob's actual CEPI-API-based approach." ;
	<urn:solutiondesign:ontology:requirementId> "8.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to process EEM entity data through ETL so that hierarchical and operational details are accurately reflected in MiEdWorkforce." ;
	<urn:solutiondesign:ontology:title> "Process EEM entity data through ETL" .

<urn:solutiondesign:instance:organizations:Req_08_1_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Validates required attributes (entity type, name, identifier) are populated; flags and excludes records with missing/invalid attributes; logs validation results with error details and record counts; only validated records proceed to transform/load." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:Fdd08_1EntityDirDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the BatchJob's per-record validation/skip-and-warn error scenario." ;
	<urn:solutiondesign:ontology:requirementId> "8.1.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to validate EEM entity data during ingestion so that only accurate and complete records are stored." ;
	<urn:solutiondesign:ontology:title> "Validate EEM entity data during ingestion" .

<urn:solutiondesign:instance:organizations:Req_08_1_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Processes only new/changed records when incremental updates are available; identifies added/modified/deactivated records since the previous load; updated records replace or deactivate existing entries; each incremental load is logged with totals and errors." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:Fdd08_1EntityDirDoc> ;
	<urn:solutiondesign:ontology:notes> "DISCREPANCY, not just a partial match: this story assumes true incremental (delta) processing already exists. orgs:BatchJob_CepiNightlySync's own keyDecisions explicitly say the opposite — 'the pipeline supports both, but is currently implemented as a full snapshot upsert until CEPI confirms delta feed availability.' See Question_EemIncrementalLoadNotYetBuilt below." ;
	<urn:solutiondesign:ontology:requirementId> "8.1.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to update organization records incrementally based on EEM changes so that the system maintains current and accurate data." ;
	<urn:solutiondesign:ontology:title> "Update organization records incrementally based on EEM changes" .

<urn:solutiondesign:instance:organizations:Rule_HierarchyMaterializedNotComputed> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:organizations:Op_GetOrganizationHierarchy> ;
	<urn:solutiondesign:ontology:example> "IAM asks whether a user authorized at ISD-50 has access to Building-123: it resolves via a single indexed lookup of Building-123's ancestor_organization_codes array, not a recursive parent-of-parent-of-parent query." ;
	<urn:solutiondesign:ontology:rationale> "IAM evaluates transitive permissions on every protected API call, requiring sub-10ms hierarchy resolution. Runtime recursive traversal of a relational hierarchy cannot meet this target under load. Materialization moves the cost to the sync pipeline, which has no latency constraints." ;
	<urn:solutiondesign:ontology:statement> "Ancestor chains are pre-computed during each sync cycle and stored in organization_hierarchy. Consumers query the materialized data; they do not traverse relationships recursively at runtime." .

<urn:solutiondesign:instance:organizations:Rule_InactiveOrganizationsRetained> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:example> "A building closed in 2023 still resolves via GET /organizations/{code} with status: Inactive, so a 2021 credential application record that references it remains fully displayable." ;
	<urn:solutiondesign:ontology:rationale> "Referential integrity across the system depends on organization codes remaining resolvable. A building that closed three years ago may still appear in audit findings or historical credential records." ;
	<urn:solutiondesign:ontology:statement> "Organizations deactivated in EEM are marked Inactive in the local replica but are never deleted. Historical records (authorizations, assignments, enrollments) in consuming domains may reference them." .

<urn:solutiondesign:instance:organizations:Rule_LeadAdministratorSourcedFromEEM> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:example> "If District 42 designates a new Lead Administrator in EEM, the next nightly sync will update the record, publish a LeadAdministratorChanged event, and IAM's approval routing cache will be invalidated." ;
	<urn:solutiondesign:ontology:notes> "There is no write endpoint for lead_admin_email anywhere in organizations-api.yml — enforcement is entirely by omission (no such capability exists), not by an explicit validation rule in any operation." ;
	<urn:solutiondesign:ontology:rationale> "The Lead Administrator role has legal and operational significance — requests for access are routed to this person, and they have approval authority over their organization's scope. The integrity of that routing must trace back to EEM." ;
	<urn:solutiondesign:ontology:statement> "The Lead Administrator for an organization is exactly as designated in EEM. MiEdWorkforce does not allow this to be overridden or supplemented through the Organizations API or any admin interface." .

<urn:solutiondesign:instance:organizations:Rule_OrganizationTypeImmutable> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:organizations:OrganizationAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:organizations:BatchJob_CepiNightlySync> ;
	<urn:solutiondesign:ontology:example> "A building reclassified from Nonpublic to a public District-affiliated Building in EEM: the old Nonpublic-typed record is deactivated (status=Inactive), and a new record with the same organization code but organization_type=Building is created." ;
	<urn:solutiondesign:ontology:rationale> "Organization type determines what roles, scopes, and features are available in consuming domains. An in-place type change would invalidate cached data and active authorizations in ways that are difficult to reason about. Treat-as-new is cleaner." ;
	<urn:solutiondesign:ontology:statement> "An organization's type cannot change. If EEM indicates a type change (rare, but possible), the sync pipeline deactivates the existing record and creates a new one with a new internal ID. The organization code remains the same." .

<urn:solutiondesign:instance:organizations:Seq_DegradedOperation> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Synapse as Azure Synapse Pipeline\n    participant OrgDB as Organizations Database\n    participant OrgAPI as Organizations API\n    participant Monitor as Azure Monitor\n    participant Consumers as Domain Services (IAM, Staffing, etc.)\n\n    Synapse->>OrgDB: Sync attempt fails (CEPI unavailable or transaction rollback)\n    OrgDB->>OrgDB: No partial writes committed; replica unchanged\n    Synapse->>OrgDB: Update sync log (status=Failed, failure_reason=...)\n\n    Synapse->>Monitor: Alert fires: \"CEPI Org Sync Failed\"\n    Note over Monitor: Platform operations team notified\n\n    Note over OrgAPI: OrganizationSyncCompleted NOT published<br/>Consumer caches remain valid; TTL expiry continues normally\n\n    Consumers->>OrgAPI: Requests continue normally\n    OrgAPI->>OrgDB: Serve from existing replica (last successful sync data)\n    OrgDB-->>OrgAPI: Data returned as normal\n    OrgAPI-->>Consumers: Responses unchanged from pre-failure behavior\n\n    Note over Consumers: Worst-case staleness increases by one sync cycle (~24 hrs)<br/>No user-facing degradation unless failure persists multiple cycles\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Manual sync trigger also fails > Alert remains active; escalate to CEPI team to investigate API availability. Failure persists > Platform operations may manually seed specific high-priority org changes via database patch as a last-resort emergency procedure outside normal process." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (intentionally — OrganizationSyncCompleted is not published on failure)." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "No consumer-facing impact on single failure: because the replica is not modified on failure, consumers see no difference beyond new EEM changes not yet being reflected. Alert on first failure: a single sync failure triggers an alert; platform operations reviews and determines whether manual intervention is needed. Manual re-trigger available: POST /admin/jobs/sync allows a System Admin to trigger a manual sync once the upstream issue is resolved. Multi-day failure escalation: if sync fails for more than 2 consecutive cycles, alert severity escalates; this is treated as an operational concern, not a data integrity concern." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Degraded Operation (Sync Failure)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Describes system behavior when the nightly sync fails and consumers must operate on data from the previous successful sync. When: CEPI API is unavailable, the Synapse pipeline errors, or the sync transaction rolls back. Who: System process; no user action required." .

<urn:solutiondesign:instance:organizations:Seq_HierarchyResolution> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant IAM as IAM API\n    participant OrgAPI as Organizations API\n    participant Cache as IAM Local Cache (Redis)\n    participant OrgDB as Organizations Database\n\n    IAM->>Cache: GET org-hierarchy:{organizationCode}\n\n    alt Cache hit\n        Cache-->>IAM: Cached ancestor chain (TTL: 60 min)\n        IAM->>IAM: Evaluate transitive match against user authorizations\n    else Cache miss\n        IAM->>OrgAPI: GET /organizations/{code}/hierarchy\n        OrgAPI->>OrgDB: SELECT ancestor_organization_codes<br/>FROM organization_hierarchy<br/>WHERE organization_code = {code}\n        OrgDB-->>OrgAPI: Ancestor chain array\n        OrgAPI-->>IAM: Ancestor chain (ordered root to direct parent)\n        IAM->>Cache: SET org-hierarchy:{organizationCode} TTL=60min\n        IAM->>IAM: Evaluate transitive match\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Organization code not found > 404; IAM treats as no transitive match (deny). Organizations API unavailable > IAM falls back to cached hierarchy; if cache empty, fails closed (deny access, surface service unavailable message)." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Single-row lookup: the materialized ancestor_organization_codes JSON array on the hierarchy record makes this a single indexed lookup, not a recursive query — this is what makes sub-10ms hierarchy resolution achievable. Cache owned by IAM: IAM maintains its own cache of hierarchy data; the Organizations API does not cache on behalf of consumers. Restricted endpoint: /organizations/{code}/hierarchy is restricted to IAM's service account principal via Istio authorization policy; other domains call /organizations/{code} for display and let IAM handle permission evaluation." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Hierarchy Resolution" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Returns the full ancestor chain for an organization, used by IAM to evaluate transitive permissions (e.g., does a user authorized at ISD-50 have access to Building-123?). When: IAM permission check encounters a scope-sensitive permission and needs to determine whether the user's authorization scope is an ancestor of the target organization. Who: Internal service (IAM API only)." .

<urn:solutiondesign:instance:organizations:Seq_LeadAdminLookup> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant IAM as IAM API\n    participant OrgAPI as Organizations API\n    participant Cache as IAM Local Cache (Redis)\n    participant OrgDB as Organizations Database\n\n    IAM->>Cache: GET org-lead-admin:{organizationCode}\n\n    alt Cache hit\n        Cache-->>IAM: Cached lead admin detail (TTL: 60 min)\n    else Cache miss\n        IAM->>OrgAPI: GET /organizations/by-lead-admin?email={email}\n        OrgAPI->>OrgDB: SELECT * FROM organizations<br/>WHERE lead_admin_email = {email}<br/>AND status = 'Active'\n        OrgDB-->>OrgAPI: Matching organizations\n        OrgAPI-->>IAM: Organizations where user is Lead Admin\n        IAM->>Cache: SET org-lead-admin:{orgCode} TTL=60min (per org)\n    end\n\n    IAM->>IAM: Route approval request or trigger bootstrap grant\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "No organizations found for the email > Empty array returned; IAM treats as non-Lead-Admin user and routes to standard authorization request flow. Organizations API unavailable > IAM falls back to cache; if cache empty for bootstrap path, defers bootstrap grant until next successful lookup (user proceeds to standard request flow)." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Lookup by email, not by user ID: Lead Admin designation in EEM is an email address, not a MiEdWorkforce user ID; IAM performs the email-to-user match after retrieving the org list. Active orgs only: the query filters to status = Active; a Lead Admin designation on an inactive org has no routing significance. Cache invalidation on LeadAdministratorChanged: IAM invalidates org-lead-admin:{organizationCode} immediately rather than waiting for TTL expiry." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Lead Admin Lookup" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Returns all organizations for which a given email address is designated Lead Administrator. Used by IAM during authorization request routing and Lead Admin bootstrap. When: (1) A business user submits an authorization request - IAM looks up the Lead Admin for the target organization. (2) A new user authenticates for the first time - IAM checks whether their email matches any Lead Admin designation to trigger bootstrap grants. Who: Internal service (IAM API only)." .

<urn:solutiondesign:instance:organizations:Seq_OrganizationDetailLookup> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Caller as Caller (UI or Internal Service)\n    participant OrgAPI as Organizations API\n    participant Cache as Consumer Cache (Redis)\n    participant OrgDB as Organizations Database\n\n    Caller->>OrgAPI: GET /organizations/{code}\n\n    OrgAPI->>Cache: GET org:{organizationCode}\n\n    alt Cache hit\n        Cache-->>OrgAPI: Cached organization detail (TTL: 60 min)\n        OrgAPI-->>Caller: Organization detail\n    else Cache miss\n        OrgAPI->>OrgDB: SELECT org + hierarchy WHERE organization_code = {code}\n        OrgDB-->>OrgAPI: Organization record + direct parent\n        OrgAPI->>Cache: SET org:{organizationCode} TTL=60min\n        OrgAPI-->>Caller: Organization detail\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Organization code not found > 404 Not Found. Organization is Inactive > 200 returned with status: Inactive; callers decide how to handle (IAM will reject scope assignments to inactive orgs; other domains may display a warning)." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Lead Admin included in detail response: the full detail endpoint returns Lead Admin name and a masked version of the email (e.g., j***@district5.edu) for UI display. The unmasked email is returned only on the /by-lead-admin endpoint, restricted to internal service callers (IAM only)." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Organization Detail Lookup" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Retrieves full details for a single organization by code, including grade band, Lead Administrator, and hierarchy summary. When: User selects an organization from search results, or a domain service needs org context for a record being processed. Who: Authenticated user via UI, or internal service." .

<urn:solutiondesign:instance:organizations:Seq_OrganizationSearch> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:organizations:OrganizationsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant UI as Domain UI\n    participant OrgAPI as Organizations API\n    participant Cache as Consumer Cache (Redis)\n    participant OrgDB as Organizations Database\n\n    User->>UI: Type organization name (>=2 characters)\n    UI->>OrgAPI: GET /organizations/search?query={text}&type={type}&status=Active\n\n    OrgAPI->>Cache: GET org-search:{queryHash}\n\n    alt Cache hit\n        Cache-->>OrgAPI: Cached results (TTL: 15 min)\n        OrgAPI-->>UI: Matching organizations\n    else Cache miss\n        OrgAPI->>OrgDB: SELECT WHERE name ILIKE '%{query}%'<br/>AND type = {type} (if provided)<br/>AND status = 'Active'<br/>LIMIT 20\n        OrgDB-->>OrgAPI: Matching records\n        OrgAPI->>Cache: SET org-search:{queryHash} TTL=15min\n        OrgAPI-->>UI: Matching organizations\n    end\n\n    UI-->>User: Display suggestions (code, name, type)\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Query shorter than 2 characters > 400 Bad Request with validation message. Organizations API unavailable > Consumer falls back to local cache if populated; surfaces user-facing message if not." ;
	<urn:solutiondesign:ontology:eventsPublished> "None." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Minimum 2 characters, enforced at the API level to prevent full-table scans on single-character queries. Active-only default: search returns only Active organizations by default; admins with organizations.organization.view can pass status=Inactive to surface deactivated orgs for historical lookup. Result limit of 20: typeahead use cases don't need exhaustive results — users should refine their query rather than paginate. Search cache keyed on query hash with a 15-minute TTL-only invalidation (not event-driven), since the cost of a cache miss is low and the benefit of immediate invalidation on every sync is minimal." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Organization Search" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Returns a list of organizations matching a partial name query, optionally filtered by type and status. Used in authorization request forms, org selectors across domains, and admin lookups. When: User types in an organization search field (typically debounced at 300ms in the UI). Who: Authenticated user via UI, or internal service." .

<urn:solutiondesign:instance:organizations:SequencesDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "sequences" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/organizations/organizations-sequences.md" .

<urn:solutiondesign:instance:organizations:SyncLogAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:organizations:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks each execution of the nightly (or manually-triggered) CEPI sync pipeline: counts of records processed/created/updated/deactivated, status, failure reason, and the Azure Synapse pipeline run correlation ID. Used by platform operations to diagnose sync failures and verify data freshness." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:organizations:OrganizationSyncCompletedEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:SyncState_Failed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:SyncState_PartialSuccess> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:SyncState_Running> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:organizations:SyncState_Succeeded> ;
	<urn:solutiondesign:ontology:invariants> "The entire sync runs in a single transaction: if the pipeline fails partway through, no partial writes are committed and the existing replica remains intact. Sync logs are retained for 1 year for operational audit purposes." ;
	<urn:solutiondesign:ontology:rootEntity> "OrganizationSyncLog" .

<urn:solutiondesign:instance:organizations:SyncState_Failed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Failed" .

<urn:solutiondesign:instance:organizations:SyncState_PartialSuccess> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "PartialSuccess" .

<urn:solutiondesign:instance:organizations:SyncState_Running> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Running" .

<urn:solutiondesign:instance:organizations:SyncState_Succeeded> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Succeeded" .

<urn:solutiondesign:instance:organizations:UT_AncestorChain> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The ordered list of parent organizations from an organization up to the root (e.g., Building -> District -> ISD). Used in IAM for transitive permission evaluation." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Ancestor Chain" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:OrganizationHierarchyEntity> .

<urn:solutiondesign:instance:organizations:UT_GradeBandOrgLevel> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The range of grades an organization is authorized to serve (e.g., K-8, 9-12). Describes the organization's charter, not the scope of any particular position or assignment." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Grade Band (Org-Level)" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:GradeBand> .

<urn:solutiondesign:instance:organizations:UT_LeadAdministrator> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The individual designated in EEM as the primary administrative contact for an organization. Authorization requests for that organization's scope are routed to this person. There is exactly one Lead Administrator per organization at any point in time." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Lead Administrator" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:LeadAdministrator> .

<urn:solutiondesign:instance:organizations:UT_LocalReplica> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The copy of EEM/CEPI data stored within MiEdWorkforce's own database. Read-only from MiEdWorkforce's perspective; authoritative for all internal consumers." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Local Replica" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:OrganizationAggregate> .

<urn:solutiondesign:instance:organizations:UT_Organization> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "An educational entity as defined in EEM — a Building, District, ISD, EPP, Nonpublic School, or Professional Learning Sponsor — each identified by a unique organization code." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Organization" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:OrganizationAggregate> .

<urn:solutiondesign:instance:organizations:UT_OrganizationCode> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The stable, unique identifier for an organization as assigned by EEM. Used as the primary key in all cross-domain references." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Organization Code" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:OrganizationAggregate> .

<urn:solutiondesign:instance:organizations:UT_OrganizationHierarchy> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The parent-child relationships between organizations, primarily ISD > District > Building. A Building may in some cases be directly under an ISD with no intermediate District." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Organization Hierarchy" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:OrganizationHierarchyEntity> .

<urn:solutiondesign:instance:organizations:UT_OrganizationType> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The classification of an organization (e.g., Building, District, ISD, EPP, Nonpublic, PLS). Determines what scopes and roles are applicable in IAM, and what features are available in other domains." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Organization Type" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:OrganizationTypeAggregate> .

<urn:solutiondesign:instance:organizations:UT_StalenessWindow> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "The maximum time between a change in EEM and that change being reflected in the local replica. Currently bounded by the nightly sync cadence plus consumer cache TTL." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Staleness Window" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:SyncLogAggregate> .

<urn:solutiondesign:instance:organizations:UT_SyncCycle> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "One execution of the Synapse pipeline that pulls current data from the CEPI API and updates the local replica. Runs nightly." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Sync Cycle" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:organizations:SyncLogAggregate> .

<urn:solutiondesign:instance:payments:ApiDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "api-spec" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/payments/payments-api.yml" .

<urn:solutiondesign:instance:payments:ApiSpec> a <urn:solutiondesign:ontology:ApiSpec> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:ApiDoc> ;
	<urn:solutiondesign:ontology:notes> "Confirmed: no internal-service ApiOperation exists in this spec at all (every operation is internal-user or external-public). There is no synchronous payment-status-check endpoint for other domains to poll — see this file's header note, pay:Question_PaymentStatusPollingEndpoint, and credentialing-technical-design.md Open Technical Question #7, which this confirms rather than resolves." ;
	<urn:solutiondesign:ontology:version> "1.0.0" .

<urn:solutiondesign:instance:payments:BatchJob_PostingFileReconciliation> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "SFTP connection failure: retry 3 times at 5-minute intervals, alert admin if all fail. File not found: expected if no transactions the previous day, log info-level. Parse error: skip the malformed record, log error, continue, flag the batch PartiallyCompleted. Header/footer mismatch: flag the entire batch Failed, manual review required. Uses an Azure Blob Lease distributed lock to prevent concurrent batch runs; all auto-updates and discrepancy insertions for the batch are wrapped in a single SQL transaction." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:notes> "Per payments-technical-design.md's own 'Posting File Reconciliation Logic' table (Match/Missing Payment/Amount Mismatch/Orphan Payment/Unexpected Status), matching is against a composite index on (application_id, status, created_date) with amount and confirmation_number as included columns, avoiding full table scans; confirmation-number lookups and application-id+status lookups each have their own dedicated index. Expected volume: 100-500 posting-file records/day across roughly 4,000 Michigan educational organizations, well within the provisioned SQL tier's buffer pool. Target: batch completion within 10 minutes; if primary-database DTU utilization exceeds 70% sustained during reporting-query load, read replicas should be considered (this is an operational/scaling note, not a functional requirement of the batch job itself)." ;
	<urn:solutiondesign:ontology:schedule> "Daily at 3:00 AM EST, after CEPAS posts the previous day's transactions (typically ~2:00 AM EST)." ;
	<urn:solutiondesign:ontology:steps> "1. Create a ReconciliationBatch (Processing) for the file date. 2. Retrieve the fixed-width posting file via SFTP through the File Transfer Service. 3. Parse AH header / AD transaction records / AF footer; validate header/footer totals against parsed record count and amount. 4. For each AD record, match on the Custom Reference Data field (application ID) + amount: Match (found, Paid, amounts equal) -> no action; Missing Payment (found, Pending, amounts equal) -> auto-update to Paid, emit MissingPaymentDetected + PaymentCompleted; Amount Mismatch or Orphan Payment or Unexpected Status (found but Failed/Refunded) -> create a ReconciliationDiscrepancy, emit PaymentDiscrepancyDetected. Command codes other than 1 (Payment) and 5 (Refund) are recorded with match_result=Discrepancy pending explicit handling. 5. Update the batch to Completed with summary counts and emit ReconciliationBatchCompleted." .

<urn:solutiondesign:instance:payments:BulkPaymentCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "bulk_transaction_id, application_ids[], total_amount, item_count" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Bulk payment redirect confirmation succeeds" .

<urn:solutiondesign:instance:payments:BulkPaymentItem> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Association to a parent bulk payment transaction (for multi-application payments)." ;
	<urn:solutiondesign:ontology:name> "BulkPaymentItem" .

<urn:solutiondesign:instance:payments:BulkRefundCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Not in payments-capability.md's main Domain Events table — only appears in the 'Bulk Refund Processing' sequence. No consumers documented anywhere, so none are asserted here." ;
	<urn:solutiondesign:ontology:payloadHighlights> "refundIds[], totalAmount" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "All refunds in a bulk refund request have been processed (partial success possible)" .

<urn:solutiondesign:instance:payments:CapabilityDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "domain" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/payments/payments-capability.md" .

<urn:solutiondesign:instance:payments:Cat_Administration> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Administration" .

<urn:solutiondesign:instance:payments:Cat_Audit> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Audit" .

<urn:solutiondesign:instance:payments:Cat_PaymentInitiation> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Payment Initiation" .

<urn:solutiondesign:instance:payments:Cat_PaymentRetry> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Payment Retry" .

<urn:solutiondesign:instance:payments:Cat_PaymentViewing> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Payment Viewing" .

<urn:solutiondesign:instance:payments:Cat_Reconciliation> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Reconciliation" .

<urn:solutiondesign:instance:payments:Cat_Refunds> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Refunds" .

<urn:solutiondesign:instance:payments:DiscrepancyResolvedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Not in payments-capability.md's main Domain Events table — only appears in the 'Reconciliation Discrepancy Investigation' sequence. No consumers documented anywhere, so none are asserted here." ;
	<urn:solutiondesign:ontology:payloadHighlights> "discrepancyId, resolutionAction, resolvedBy, resolvedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Payment Admin manually resolves a reconciliation discrepancy" .

<urn:solutiondesign:instance:payments:Fdd07CepasPaymentsInterfaceDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "CEPAS's own interface contract: AES-256-GCM redirect payload encryption (amount/id/ref/returnurl plaintext, 12-byte nonce, 16-byte tag), and the SHA-1(ConfirmationNumber+Amount+SecurityKey) hash-validation formula for the return redirect. Confirms pay:TP_CepasRedirectInitiation and pay:TP_CepasConfirmationProcessing in payments-capability.ttl match the actual interface spec field-for-field; not separately modeled as its own Requirement set." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/07 - Credit Card Payments and Refunds/7.0 CEPAS/Interface Design document - CEPAS (Payments).docx" .

<urn:solutiondesign:instance:payments:Fdd07CepasPostingFileInterfaceDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Fixed-width AH (header)/AD (transaction detail)/AF (footer) posting-file layout, retrieved via SFTP. Confirms pay:BatchJob_PostingFileReconciliation's own notes on the file format; also the ultimate source of the Payment Command Code vocabulary already captured verbatim as pay:UT_PaymentCommandCode in payments-capability.ttl. Not separately modeled." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/07 - Credit Card Payments and Refunds/7.0 CEPAS/Interface Design document - CEPAS (Posting File).docx" .

<urn:solutiondesign:instance:payments:Fdd07CepasReimbursementsInterfaceDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "CEPAS's CancelPayment API contract (Header: ApplicationID/PaymentChannel/SecurityKey; body: ConfirmationNumber/RefundAmount). Confirms pay:TP_CepasRefundApiCall in payments-capability.ttl matches the actual interface spec; not separately modeled." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/07 - Credit Card Payments and Refunds/7.0 CEPAS/Interface Design document - CEPAS (Reimbursements).docx" .

<urn:solutiondesign:instance:payments:Fdd07Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 7.1-7.3 (the document's own subtitle: '7.0 Credit Card Payments/Refunds (7.1, 7.2 and 7.3)'). Author Vidhya Punniyamoorthy (DTMB); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/01/2025 per the signoff table — but two comments (132877093/1640280882) are dated 2026-03-06, over seven months after signoff, flagging a dead Additional-Resources hyperlink and an access request. Not resolved here (document hygiene, not a functional finding); noted so the signoff table isn't read as 'nothing changed after this' — same caution FDD 29's own header carries for the same reason." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/07 - Credit Card Payments and Refunds/7 - Credit card payments and Refunds-.docx" .

<urn:solutiondesign:instance:payments:GetPaymentOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "CONFIRMED GAP (cross-domain consistency pass): payments is now really converted in abox/mied-v3/payments/payments-api.ttl, and it exposes no GET-by-id single-payment lookup — only pay:Op_SearchPayments (GET /payments/search), pay:Op_InitiatePayment, pay:Op_ConfirmPayment, and the refund/reconciliation endpoints. None returns due-date/fee-amount/confirmation-details for one payment by id, so no rename was made." ;
	<urn:solutiondesign:ontology:path> "/api/payments/{id}" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Returns payment due dates, fee amounts, and confirmation details for variable resolution (path inferred, not shown literally in any source doc)." .

<urn:solutiondesign:instance:payments:MissingPaymentDetectedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table also lists 'monitoring' — no such bounded context in the project registry; not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "transaction_id, confirmation_number, posting_file_date, detected_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Posting file shows a payment not present in the system" .

<urn:solutiondesign:instance:payments:Op_ApproveRefund> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:payments:RefundApproval> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Only required for refunds exceeding the $500 threshold. No corresponding 'reject' operation exists in this spec — payments-sequences.md's own 'Refund Request Processing (Dual Approval)' notes: 'Financial Admin can reject with reason using the same payments.refund.approve permission (not shown in diagram)', implying rejection reuses this same endpoint, but no distinct rejection request/response shape or path is defined." ;
	<urn:solutiondesign:ontology:operationId> "approveRefund" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/refunds/{refundRequestId}/approve" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request body is just approverNotes (RefundApproval's own free-text field) — approvedBy/approvedAt are set server-side, not supplied by the caller. Response is the full RefundRequestResponse (RefundRequestAggregate's API-facing shape), now carrying Approved status and the approval fields." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Approve refund request (Financial Admin)" ;
	<urn:solutiondesign:ontology:tags> "Refunds" .

<urn:solutiondesign:instance:payments:Op_ConfirmPayment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "external-public" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:payments:PaymentConfirmation> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Unauthenticated by design (x-permissions-required: []) — CEPAS's return redirect does not carry a MiLogin token. Tamper detection relies solely on SHA-1 hash validation, not a permission check. This is the one genuinely unauthenticated operation in this spec, hence sd:requiresAuth false." ;
	<urn:solutiondesign:ontology:operationId> "confirmPayment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/payments/confirm" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:PaymentConfirmation> ;
	<urn:solutiondesign:ontology:projection> "Incoming CEPAS query parameters (c, m, o, t, d, z, i, ct, hash) map onto PaymentConfirmation's fields (confirmation number, authorization code, card type, return message/code) plus the hash itself, consumed as sd:parameters rather than a JSON request body. PaymentConfirmationResult (the response) adds paymentTransactionId, status, and hashValidationPassed on top of the same PaymentConfirmation shape." ;
	<urn:solutiondesign:ontology:requiresAuth> false ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Process CEPAS redirect confirmation" ;
	<urn:solutiondesign:ontology:tags> "Payments" .

<urn:solutiondesign:instance:payments:Op_InitiateBulkPayment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Request body is a thin reference list (applicationIds) rather than a domain-entity shape, hence sd:requestBodySchema instead of sd:consumesShape." ;
	<urn:solutiondesign:ontology:operationId> "initiateBulkPayment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/payments/initiate-bulk" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:projection> "BulkPaymentInitiationResponse is a bulk-specific projection of PaymentTransactionAggregate: bulkPaymentTransactionId + totalAmount + applicationCount + a lineItems[] breakdown (applicationId, amount) standing in for the individual child PaymentTransactions (BulkPaymentItem), rather than any single transaction's own fields." ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ applicationIds: uuid[2..100] (required), returnUrl?: uri }" ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Initiate bulk payment for multiple applications" ;
	<urn:solutiondesign:ontology:tags> "Payments" .

<urn:solutiondesign:instance:payments:Op_InitiatePayment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Also used, unchanged, for payment retry after a Failed transaction (payments-sequences.md 'Payment Retry After Failure') — there is no separate retry endpoint. Request body is a thin reference (applicationId) rather than a domain-entity shape, hence sd:requestBodySchema instead of sd:consumesShape." ;
	<urn:solutiondesign:ontology:operationId> "initiatePayment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/payments/initiate" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:PaymentInitiation> ;
	<urn:solutiondesign:ontology:projection> "PaymentInitiationResponse surfaces paymentTransactionId, the CEPAS redirect URL, sessionId, the computed (immutable) amount, and an expiresAt timestamp — it does not expose the raw AES-GCM-encrypted payload internals that PaymentInitiation's own description refers to, only the redirect URL built from them." ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ applicationId: uuid (required), returnUrl?: uri }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Initiate payment redirect to CEPAS" ;
	<urn:solutiondesign:ontology:tags> "Payments" .

<urn:solutiondesign:instance:payments:Op_ListPendingRefundApprovals> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listPendingRefundApprovals" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/refunds/pending-approval" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Returns RefundRequestSummary items (RefundRequestAggregate's list-view projection — no approvedBy/approvedAt/approverNotes, since these are, by definition, still-pending requests) filtered to status=Requested and amount over the approval threshold." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List refund requests pending Financial Admin approval" ;
	<urn:solutiondesign:ontology:tags> "Refunds" .

<urn:solutiondesign:instance:payments:Op_ListReconciliationDiscrepancies> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "listReconciliationDiscrepancies" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/reconciliation/discrepancies" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:ReconciliationDiscrepancy> ;
	<urn:solutiondesign:ontology:projection> "ReconciliationDiscrepancySummary mirrors pay:ReconciliationDiscrepancy's own fields closely (type, application/confirmation identifiers, expected/actual amount, status, resolution fields) — no meaningful projection narrowing beyond the entity's own shape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List reconciliation discrepancies" ;
	<urn:solutiondesign:ontology:tags> "Reconciliation" .

<urn:solutiondesign:instance:payments:Op_RequestBulkRefund> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "requestBulkRefund" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/refunds/bulk-request" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is an array of {paymentTransactionId, refundAmount} plus one shared reason — each item becomes its own RefundRequest. Response wraps an array of RefundRequestSummary (one per item) in a bulkRefundId/totalAmount/requiresApproval envelope; requiresApproval reflects the total across the whole batch, not any single item." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit bulk refund request" ;
	<urn:solutiondesign:ontology:tags> "Refunds" .

<urn:solutiondesign:instance:payments:Op_RequestRefund> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Requests <= $500 are auto-approved and processed immediately via CEPAS API within this same call; requests > $500 are created Requested and wait for a separate POST /refunds/{id}/approve call. Scope is resolved server-side from the transaction's owning organization — X-Organization-Context is not required, matching x-scope-sensitive: false despite the permission itself being scoped in payments-permissions.md." ;
	<urn:solutiondesign:ontology:operationId> "requestRefund" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/refunds/request" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request body (paymentTransactionId, refundAmount, reason) covers only the fields needed to open a RefundRequest; the response (RefundRequestResponse) adds status, requiresApproval, and — once decided — approvedBy/approvedAt/approverNotes (RefundApproval's fields)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit refund request" ;
	<urn:solutiondesign:ontology:tags> "Refunds" .

<urn:solutiondesign:instance:payments:Op_ResolveDiscrepancy> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:payments:ReconciliationDiscrepancy> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "resolveDiscrepancy" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/reconciliation/discrepancies/{discrepancyId}/resolve" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:ReconciliationDiscrepancy> ;
	<urn:solutiondesign:ontology:projection> "Request body (resolutionAction, resolutionNotes, optional correctedAmount) covers exactly pay:ReconciliationDiscrepancy's own resolution-workflow fields; response is a minimal ack (discrepancyId, status, resolvedAt) rather than the full entity." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Manually resolve reconciliation discrepancy" ;
	<urn:solutiondesign:ontology:tags> "Reconciliation" .

<urn:solutiondesign:instance:payments:Op_SearchPayments> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "searchPayments" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/payments/search" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:projection> "PaymentTransactionSummary is a list-view projection of PaymentTransaction: omits authorizationCode, settlementSubmissionDate, refunds[], and reconciliationStatus, all of which only appear on the (unexposed — see payments-api.ttl's documented-gaps comment) PaymentTransactionDetail schema." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Search payment transactions" ;
	<urn:solutiondesign:ontology:tags> "Payments" .

<urn:solutiondesign:instance:payments:PayState_Discrepancy> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Posting file mismatch requiring manual review." ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Discrepancy" .

<urn:solutiondesign:instance:payments:PayState_Failed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Payment attempt failed (declined card, user cancellation, CEPAS error). A retry creates a NEW transaction rather than transitioning this one." ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Failed" .

<urn:solutiondesign:instance:payments:PayState_Paid> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Successfully confirmed via CEPAS return redirect OR posting file." ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Paid" .

<urn:solutiondesign:instance:payments:PayState_PartiallyRefunded> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Partial refund processed; further partial refunds allowed until the full original amount is refunded." ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "PartiallyRefunded" .

<urn:solutiondesign:instance:payments:PayState_Pending> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Awaiting payment (user has not completed CEPAS flow or payment in progress)." ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Pending" .

<urn:solutiondesign:instance:payments:PayState_Reconciled> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Matched against CEPAS posting file (sub-state of Paid)." ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Reconciled" .

<urn:solutiondesign:instance:payments:PayState_Refunded> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Full refund processed. Terminal per payments-technical-design.md: no further status changes permitted." ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Refunded" .

<urn:solutiondesign:instance:payments:PaymentCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "transaction_id, confirmation_number, amount, paid_date, card_type" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "CEPAS redirect returns success and hash validated (or posting file confirms a Pending payment)" .

<urn:solutiondesign:instance:payments:PaymentConfirmation> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "CEPAS return data including confirmation number, authorization code, card type, return message/code." ;
	<urn:solutiondesign:ontology:name> "PaymentConfirmation" .

<urn:solutiondesign:instance:payments:PaymentDiscrepancyDetectedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table also lists 'monitoring' and 'support' — no such bounded contexts in the project registry; not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "transaction_id, expected_amount, actual_amount, discrepancy_type" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Posting file amount mismatch or other conflict" .

<urn:solutiondesign:instance:payments:PaymentDueEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Stub — distinct from any credentialing-side payment-completion event (a different purpose). See payments-capability.md (not converted here)." ;
	<urn:solutiondesign:ontology:payloadHighlights> "Unconfirmed — variable families Payer/Certificate/Payment only" ;
	<urn:solutiondesign:ontology:trigger> "A required fee becomes due, per communications-technical-design.md's Known Event Types table (PaymentDue, no consolidation, time-sensitive)" .

<urn:solutiondesign:instance:payments:PaymentFailedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "transaction_id, return_code, return_message, failed_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "CEPAS redirect returns a non-zero error code" .

<urn:solutiondesign:instance:payments:PaymentInitiatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table also lists 'analytics' — no such bounded context in the project registry; not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "transaction_id, application_id, amount, initiated_by, initiated_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "User clicks \"Pay Fee\"" .

<urn:solutiondesign:instance:payments:PaymentInitiation> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Encrypted redirect payload, sent timestamp, user context." ;
	<urn:solutiondesign:ontology:name> "PaymentInitiation" .

<urn:solutiondesign:instance:payments:PaymentReconciledEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table also lists 'analytics' — no such bounded context in the project registry; not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "transaction_id, reconciliation_batch_id, reconciled_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Posting file confirms a payment" .

<urn:solutiondesign:instance:payments:PaymentReconciliation> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Posting file match status, reconciliation timestamp, discrepancy flags — attached to an individual PaymentTransaction (distinct from the ReconciliationBatch aggregate that produced the match)." ;
	<urn:solutiondesign:ontology:name> "PaymentReconciliation" .

<urn:solutiondesign:instance:payments:PaymentRefund> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Refund request metadata, refund confirmation number, refund amount, processed date, as seen from the PaymentTransaction side." ;
	<urn:solutiondesign:ontology:name> "PaymentRefund" .

<urn:solutiondesign:instance:payments:PaymentTransactionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Manages the complete lifecycle of a fee payment for a credential application, from initiation through confirmation, reconciliation, and potential refund. Serves as the system of record for all payment-related state." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:BulkPaymentCompletedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:MissingPaymentDetectedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:PaymentCompletedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:PaymentFailedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:PaymentInitiatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:PaymentReconciledEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:PayState_Discrepancy> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:PayState_Failed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:PayState_Paid> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:PayState_PartiallyRefunded> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:PayState_Pending> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:PayState_Reconciled> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:PayState_Refunded> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:BulkPaymentItem> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:PaymentConfirmation> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:PaymentInitiation> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:PaymentReconciliation> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:PaymentRefund> ;
	<urn:solutiondesign:ontology:invariants> "Payment amount must be greater than zero. Payment amount is immutable after transaction creation (derived from credential type at initiation). Only transactions in Paid status can be refunded. Refund amount must be less than or equal to original payment amount. Hash validation must succeed before marking payment as confirmed. Transaction status progression: Pending -> Paid OR Failed -> optionally Refunded / PartiallyRefunded. Reference data field limited to 254 characters. Confirmation number required for refund processing. Bulk payment total must equal sum of individual application fees. Missing payment detection only updates status if current status is Pending. Paid/Refunded/PartiallyRefunded transactions cannot revert to Pending or Failed (enforced at the database layer via triggers, not just application logic); Refunded is a terminal state. Bulk payment confirmation updates the parent and all child transactions atomically — per payments-technical-design.md, if the child-row count after update doesn't match the expected item count, the whole update is rolled back." ;
	<urn:solutiondesign:ontology:notes> "Uses a hash-chained, append-only event ledger (the PAYMENT_TRANSACTION_EVENTS table: event_hash = SHA256(event_id+event_type+event_timestamp+event_payload), chained via previous_event_hash) layered on top of SQL Server system-versioned temporal tables — a selective Event Sourcing pattern specifically to satisfy the 7-year Michigan financial-records retention/audit requirement, not the platform's general persistence approach (Payments uses Azure SQL, not the platform-default Cosmos DB, precisely because ACID/relational guarantees are non-negotiable for money — see payments-technical-design.md). CROSS-DOMAIN CONFIRMATION: credentialing-domain.md's 'Payment Requirement' business rule ('one permit/certificate fee per educator per school year') is annotated in credentialing's own conversion as having no counterpart here per an earlier FDD 07 review. Confirmed against the full payments-capability.md ERD and invariants: there is no academic-year/school-year field or dedup invariant anywhere in this aggregate. If 'one fee per year' is enforced at all, it is entirely a credentialing-side pre-check before Payments is ever invoked, not a Payments-tracked concept." ;
	<urn:solutiondesign:ontology:rootEntity> "PaymentTransaction" .

<urn:solutiondesign:instance:payments:PaymentsContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:displayName> "Payments" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:payments:ReconciliationBatchAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:identifier> "payments" ;
	<urn:solutiondesign:ontology:kind> "PlatformCapability" ;
	<urn:solutiondesign:ontology:notes> "Explicitly does NOT own: credential application workflow state transitions (credentialing), fee schedule configuration and pricing management (credentialing, or the respective functional area for non-credentialing fees), CEPAS credential management such as encryption/security keys and SFTP credentials (Azure Key Vault / infrastructure configuration, not an application concern), user authentication and authorization (iam), SFTP infrastructure and file transfer as a general capability (documents), SendGrid integration for payment confirmation emails (communications). PCI boundary: Payments NEVER handles raw payment card data (numbers, CVV, expiration) — all card processing occurs on the CEPAS gateway; MiEdWorkforce only holds card TYPE (VISA/MC/AMEX/etc.) after the fact, never the card itself." ;
	<urn:solutiondesign:ontology:purpose> "Provides centralized payment processing infrastructure across MiEdWorkforce, enabling credential application fee collection, refund processing, and payment reconciliation through integration with the State of Michigan's CEPAS (Centralized Electronic Payment Authorization System). Manages the complete payment lifecycle from fee calculation through payment confirmation, reconciliation, and refund processing while ensuring PCI compliance by never handling sensitive payment card data." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:CredentialApplicationSubmittedEvent> .

<urn:solutiondesign:instance:payments:Perm_AdminCircuitBreakerReset> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Reset CEPAS circuit breaker after outage" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Administration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Payment Admin; audit logged. No API operation currently models this permission — payments-api.yml has no circuit-breaker-reset endpoint (circuit breaker recovery is otherwise automatic via the half-open/closed state transition after cooldown). A documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "payments.admin.circuit-breaker-reset" .

<urn:solutiondesign:instance:payments:Perm_AdminForceStatus> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manually override a payment transaction status" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Administration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; emergency use (e.g. CEPAS confirmed payment but a system error prevented the status update); requires justification; audit logged; should trigger notification to Financial Admin and System Admin. No API operation currently models this permission — payments-api.yml has no force-status endpoint. A documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "payments.admin.force-status" .

<urn:solutiondesign:instance:payments:Perm_AuditView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View and export payment audit logs with advanced filtering" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Audit> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin, Compliance Officer; includes search and export. No API operation currently models this permission — payments-api.yml has no audit-log endpoint (audit trail is populated via the PAYMENT_TRANSACTION_EVENTS ledger and consumed by the separate Audit capability via events, not queried back through this API). A documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "payments.audit.view" .

<urn:solutiondesign:instance:payments:Perm_ReconciliationDiscrepancyResolve> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manually resolve reconciliation discrepancies" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Reconciliation> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Payment Admin; requires resolution notes; audit logged." ;
	<urn:solutiondesign:ontology:permissionId> "payments.reconciliation.discrepancy-resolve" .

<urn:solutiondesign:instance:payments:Perm_ReconciliationDiscrepancyView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View unresolved reconciliation discrepancies" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Reconciliation> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Payment Admin." ;
	<urn:solutiondesign:ontology:permissionId> "payments.reconciliation.discrepancy-view" .

<urn:solutiondesign:instance:payments:Perm_ReconciliationExport> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Export reconciliation data for financial audit" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Reconciliation> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Payment Admin, Financial Admin. No API operation currently models this permission — payments-api.yml has no export endpoint. A documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "payments.reconciliation.export" .

<urn:solutiondesign:instance:payments:Perm_ReconciliationRun> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Manually trigger reconciliation batch job" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Reconciliation> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Payment Admin; audit logged. No API operation currently models this permission — the reconciliation job (pay:BatchJob_PostingFileReconciliation) runs on a schedule only; payments-api.yml exposes no manual-trigger endpoint. A documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "payments.reconciliation.run" .

<urn:solutiondesign:instance:payments:Perm_ReconciliationView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View reconciliation batch results and daily posting file processing" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Reconciliation> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Payment Admin. No API operation currently models this permission — payments-api.yml defines a ReconciliationBatchSummary schema but no endpoint that returns it. A documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "payments.reconciliation.view" .

<urn:solutiondesign:instance:payments:Perm_RefundApprove> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Approve or reject refund requests" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Refunds> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Financial Admin; dual approval required for amounts >$500 (Credential Admin initiates via payments.refund.request, Financial Admin authorizes via this permission); audit logged. Threshold is configurable, default $500." ;
	<urn:solutiondesign:ontology:permissionId> "payments.refund.approve" .

<urn:solutiondesign:instance:payments:Perm_RefundRequest> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit a refund request for a paid transaction" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Refunds> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Credential Admin; requires justification; audit logged." ;
	<urn:solutiondesign:ontology:permissionId> "payments.refund.request" .

<urn:solutiondesign:instance:payments:Perm_RefundRequestBulk> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit refund requests for multiple transactions at once" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Refunds> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Credential Admin; audit logged. Each refund is processed independently — partial success is possible; threshold calculation uses the total amount across all refunds in the batch." ;
	<urn:solutiondesign:ontology:permissionId> "payments.refund.request-bulk" .

<urn:solutiondesign:instance:payments:Perm_RefundView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View refund requests and history" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_Refunds> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Credential Admin, Financial Admin. No API operation currently models this permission — payments-api.yml has no general refund list/history endpoint (GET /refunds/pending-approval exists but is gated by payments.refund.approve, not this permission). A documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "payments.refund.view" .

<urn:solutiondesign:instance:payments:Perm_TransactionInitiate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Initiate payment for a credential application" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_PaymentInitiation> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Implicit baseline — any authenticated user can pay fees for their own applications. Payments does not independently verify application ownership; the calling domain or UI is responsible for that check before invoking payment flows." ;
	<urn:solutiondesign:ontology:permissionId> "payments.transaction.initiate" .

<urn:solutiondesign:instance:payments:Perm_TransactionInitiateBulk> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Initiate bulk payment for multiple applications within scope" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_PaymentInitiation> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "District staff paying fees for multiple applications in their organization. ISD grant is transitive to constituent districts/buildings; District grant is transitive to constituent buildings. System validates all selected applications are in scope before initiation; if any is out of scope the entire bulk request is rejected." ;
	<urn:solutiondesign:ontology:permissionId> "payments.transaction.initiate-bulk" .

<urn:solutiondesign:instance:payments:Perm_TransactionRetry> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Retry a failed payment transaction" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_PaymentRetry> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Implicit baseline — user can re-initiate after failure; each retry creates a new transaction. No dedicated retry endpoint exists: retry simply calls POST /payments/initiate again (pay:Op_InitiatePayment), which is gated by payments.transaction.initiate, not this permission — so this permission is never actually enforced by any modeled PermissionRequirement. A documented gap, not fabricated." ;
	<urn:solutiondesign:ontology:permissionId> "payments.transaction.retry" .

<urn:solutiondesign:instance:payments:Perm_TransactionView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View payment transactions within organizational scope" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:payments:Cat_PaymentViewing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System-wide grants full visibility across all transactions." ;
	<urn:solutiondesign:ontology:permissionId> "payments.transaction.view" .

<urn:solutiondesign:instance:payments:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "permissions" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/payments/payments-permissions.md" .

<urn:solutiondesign:instance:payments:Question_BulkPaymentFeeVariance> a <http://www.w3.org/ns/oa#Annotation> ;
	a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "payments-capability.md Open Question #12: 'Can bulk payments span applications with different fee amounts, or must all items in a bulk payment be the same credential type?' The document's own Business Rules example ('Bulk Payment Individual Fee Integrity') uses five applications with DIFFERENT fee amounts ($50+$75+$50+$100+$50=$325) as if mixed amounts were already an accepted case, and the domain model (BulkPaymentItem as a per-application association, no same-credential-type constraint in the invariants) supports it too — but the source doc still lists this as an open, unanswered question. The example and the open question appear to be in tension; not resolved here." ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:payments:Question_BulkPaymentItemizationConfirmationScreen> a <http://www.w3.org/ns/oa#Annotation> ;
	a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:payments:Op_InitiateBulkPayment> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "payments-capability.md Open Question #25: 'Should bulk payment show an itemized fee breakdown to the user before redirecting to CEPAS?' payments-sequences.md's 'Bulk Payment Processing' sequence shows an itemized selection table BEFORE the user clicks \"Pay Fees\" ($525 total), but no distinct itemized confirmation screen between that click and the CEPAS redirect itself. Whether the selection-table view counts as satisfying this open question, or a separate confirmation step is still expected, is not resolved by the source docs." ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:payments:Question_CircuitBreakerConfigDiscrepancy> a <http://www.w3.org/ns/oa#Annotation> ;
	a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:payments:TP_CircuitBreakerManagement> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:description> "payments-technical-design.md's Circuit Breaker Configuration section gives ONE set of parameters (3 consecutive failures, 5-second health-check timeout, 5-minute cooldown, 1 half-open test request) and states it 'applies to both the payment redirect health check and the refund API.' payments-capability.md's own Integration Patterns section, however, describes the redirect health-check breaker with matching parameters (3 failures, 5-minute cooldown) but gives the REFUND API a materially different breaker: opens after 5 failures, 10-minute cooldown (see pay:TP_CepasRefundApiCall). These two source documents disagree on whether the refund API shares the redirect breaker's configuration or has its own stricter one. Not resolved here — flagged for the engineering team to confirm which figure (or whether both breakers are genuinely separate) is authoritative." ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:payments:Question_PaymentStatusPollingEndpoint> a <http://www.w3.org/ns/oa#Annotation> ;
	a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:payments:ApiSpec> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:ApiDoc> ;
	<urn:solutiondesign:ontology:description> "credentialing-technical-design.md Open Technical Question #7 asks how Credentialing should check current payment status for an application, noting payments-api.yml has no internal-service status-check endpoint and that GET /payments/search is 'a scoped, permission-gated, org-context-requiring admin/UI endpoint, not built for this.' Re-confirmed here directly against payments-api.yml: pay:Op_SearchPayments is x-access: internal-user, x-scope-sensitive: true, requires payments.transaction.view, and requires the X-Organization-Context header for scope resolution — exactly the shape credentialing's question describes. Every other operation in this spec is either internal-user (permission-gated, UI-facing) or external-public (the CEPAS-facing confirm endpoint); there is no internal-service operation anywhere. This does not resolve credentialing's Open Technical Question #7 — it only confirms the gap is real and still open as of this pass." ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:payments:Question_PostSchoolYearPaymentValidation> a <http://www.w3.org/ns/oa#Annotation> ;
	a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:description> "Payments/Payments_Scenarios.xlsx (a short informal scenarios workbook in this FDD folder, not named in the FDD's own Additional Resources list but read per CONVENTIONS.md's load-bearing-xlsx allowance) has one row not restated anywhere in the main FDD text: 'Paying for a Permit after school year ends -> Prevent people from paying fees for inactive applications... should be on MORE validation (Error message should show up).' No invariant on pay:PaymentTransactionAggregate or business rule anywhere in payments-capability.ttl validates an application's/credential's active-vs-inactive status (school-year-bounded or otherwise) before allowing payment initiation — pay:Op_InitiatePayment's own request body is just an applicationId reference, with no such pre-check documented. This is a different concept from the already-flagged 'one fee per year' dedup gap (credentialing-technical-design.md Open Technical Question #7 / this project's own cross-domain confirmation note on pay:PaymentTransactionAggregate) — that one is about preventing a SECOND payment for the same year; this one is about preventing ANY payment once the underlying application/permit has gone stale/inactive. Genuine, newly-surfaced coverage gap; whichever domain owns 'application is still payable' eligibility (most likely credentialing, which owns application/permit lifecycle state) would need to enforce this before ever calling Payments, exactly as the cross-domain 'one fee per year' rule already works." ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:payments:Question_ReconciliationDiscrepancyEscalationProcess> a <http://www.w3.org/ns/oa#Annotation> ;
	a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:payments:ReconciliationBatchAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "payments-capability.md Open Question #9: 'What is the process for resolving posting file discrepancies — direct contact with CEPAS or a system-managed workflow?' payments-sequences.md's 'Reconciliation Discrepancy Investigation' sequence shows BOTH: an ad hoc, name-specific step ('Contact CEPAS support (Sean Strom)') and a formal system-managed resolution workflow (POST /reconciliation/discrepancies/{id}/resolve with a fixed enum of resolutionAction values). Whether direct CEPAS contact is a required step in every case, or an example of one investigator's ad hoc practice that happens to precede the formal system step, is not documented — the sequence shows one example, not a defined process. Left open rather than assumed." ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:payments:Question_StaleOpenQuestionsAnsweredElsewhere> a <http://www.w3.org/ns/oa#Annotation> ;
	a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Three rows in payments-capability.md's own Open Questions table appear to already be answered by other parts of the same document set, and are likely stale rather than genuinely open: (a) #13 'Who is authorized to approve refunds, and what dollar thresholds require dual approval?' — answered by payments-permissions.md's Special Cases section and this file's pay:RefundRequestAggregate invariants ($500 threshold, Credential Admin initiates / Financial Admin authorizes). (b) #17 'Should failed payment transactions be retryable in place, or does each retry require creating a new transaction?' — answered by payments-api.yml/payments-sequences.md: retry reuses POST /payments/initiate and always creates a new transaction (pay:Op_InitiatePayment's own notes). (c) #21 'Should payment confirmation emails be sent immediately upon redirect confirmation, or should they wait for posting file reconciliation?' — answered by payments-sequences.md: emails fire on whichever confirmation path completes first (immediate on the real-time redirect happy path; explicitly labeled '(delayed)' in the Missing Payment Recovery sequence when reconciliation is what confirms it). None of these are asserted as fully authoritative resolutions — the source's own Open Questions table still lists them as open — but the tension between the two is itself worth flagging rather than silently picking a side." ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:resolutionNotes> "Resolved by cross-reference to payments-permissions.md, pay:Op_InitiatePayment's own notes, and the payments-sequences.md sequences named above; the source document's Open Questions table itself was not updated to reflect this." ;
	<urn:solutiondesign:ontology:status> "resolved" .

<urn:solutiondesign:instance:payments:RecBatchState_Completed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Completed" .

<urn:solutiondesign:instance:payments:RecBatchState_Failed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Failed" .

<urn:solutiondesign:instance:payments:RecBatchState_PartiallyCompleted> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:description> "Reached when a batch has some malformed/skipped records but processing otherwise completes (payments-capability.md Error Handling: 'Skip malformed record, log error, continue processing, flag batch as PartiallyCompleted')." ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "PartiallyCompleted" .

<urn:solutiondesign:instance:payments:RecBatchState_Processing> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Processing" .

<urn:solutiondesign:instance:payments:RecBatchState_Received> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Received" .

<urn:solutiondesign:instance:payments:ReconciliationBatchAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks daily processing of CEPAS posting files, enabling audit trail of reconciliation operations and identification of systematic issues." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:DiscrepancyResolvedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:PaymentDiscrepancyDetectedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:ReconciliationBatchCompletedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:payments:ReconciliationDiscrepancy> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:payments:ReconciliationRecord> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RecBatchState_Completed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RecBatchState_Failed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RecBatchState_PartiallyCompleted> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RecBatchState_Processing> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RecBatchState_Received> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:ReconciliationSummary> ;
	<urn:solutiondesign:ontology:invariants> "One batch per calendar day per CEPAS application. Batch processing is idempotent (reprocessing same file yields same results). All posting file records must be categorized: Matched, Missing, or Discrepancy. Discrepancies remain flagged until manually resolved. Batch status progression: Received -> Processing -> Completed OR Failed. Auto-updates only apply to Pending transactions; Failed and Refunded transactions are never overwritten by the posting file. All auto-updates and discrepancy insertions for a given batch are wrapped in a single SQL transaction so the batch is processed atomically." ;
	<urn:solutiondesign:ontology:notes> "Uses a distributed lock (Azure Blob Lease) to prevent concurrent batch runs, per payments-technical-design.md / payments-capability.md Architecture notes. The actual batch job driving this aggregate's lifecycle is modeled as pay:BatchJob_PostingFileReconciliation in payments-technical-design.ttl." ;
	<urn:solutiondesign:ontology:rootEntity> "ReconciliationBatch" .

<urn:solutiondesign:instance:payments:ReconciliationBatchCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table also lists 'monitoring' — no such bounded context in the project registry; not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "batch_id, file_date, total_records, matched_count, missing_count, discrepancy_count" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Daily posting file processing finishes" .

<urn:solutiondesign:instance:payments:ReconciliationDiscrepancy> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Unmatched or conflicting posting file record requiring manual review; carries its own resolution workflow (status Unresolved -> Resolved, resolution action, resolution notes, resolver, resolved-at)." ;
	<urn:solutiondesign:ontology:name> "ReconciliationDiscrepancy" .

<urn:solutiondesign:instance:payments:ReconciliationRecord> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Individual posting file entry with match status (Match, MissingPayment, AmountMismatch, OrphanPayment, UnexpectedStatus)." ;
	<urn:solutiondesign:ontology:name> "ReconciliationRecord" .

<urn:solutiondesign:instance:payments:ReconciliationSummary> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Aggregate counts for a batch: total records, matched, missing, discrepancies." ;
	<urn:solutiondesign:ontology:name> "ReconciliationSummary" .

<urn:solutiondesign:instance:payments:RefundApproval> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Approval/rejection decision, approver, timestamp, reason." ;
	<urn:solutiondesign:ontology:name> "RefundApproval" .

<urn:solutiondesign:instance:payments:RefundApprovedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table lists 'audit, payments' — 'payments' appears to self-reference this same bounded context, which cannot meaningfully subscribe to its own event; not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "refund_request_id, approved_by, approved_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Financial Admin authorizes a refund" .

<urn:solutiondesign:instance:payments:RefundAudit> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Immutable audit log of refund lifecycle events." ;
	<urn:solutiondesign:ontology:name> "RefundAudit" .

<urn:solutiondesign:instance:payments:RefundCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "refund_request_id, refund_confirmation_number, refund_amount, processed_date" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "CEPAS confirms the refund was processed" .

<urn:solutiondesign:instance:payments:RefundConfirmation> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "CEPAS API response data (refund confirmation number, processed date)." ;
	<urn:solutiondesign:ontology:name> "RefundConfirmation" .

<urn:solutiondesign:instance:payments:RefundFailedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table also lists 'monitoring' and 'support' — no such bounded contexts in the project registry; not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "refund_request_id, error_message, failed_at" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "CEPAS API refund call fails" .

<urn:solutiondesign:instance:payments:RefundRequestAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Manages the workflow of refund processing, including administrator authorization, CEPAS API interaction, and audit trail." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:BulkRefundCompletedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:RefundApprovedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:RefundCompletedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:RefundFailedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:payments:RefundRequestedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:payments:RefundAudit> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RefundState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RefundState_Completed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RefundState_Failed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RefundState_Processing> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RefundState_Rejected> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:payments:RefundState_Requested> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:RefundApproval> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:payments:RefundConfirmation> ;
	<urn:solutiondesign:ontology:invariants> "Refund requests must reference an existing Paid transaction. Refund amount validation occurs before the CEPAS API call. Approved refunds cannot be cancelled (irreversible). Refund request status progression: Requested -> Approved / Rejected -> Processing -> Completed / Failed. Refunds <= $500 require a single Financial Admin approval (auto-approved by the system); refunds > $500 require the Credential Admin to initiate and a separate Financial Admin to authorize (dual approval); the threshold is configurable, default $500." ;
	<urn:solutiondesign:ontology:notes> "Shares the same hash-chained PAYMENT_TRANSACTION_EVENTS audit ledger as PaymentTransaction (event_type values RefundRequested/RefundApproved/RefundCompleted/RefundFailed are recorded against the same aggregate_id=payment_transaction_id) rather than maintaining a separate event store — the same selective Event Sourcing pattern noted on PaymentTransactionAggregate, for the same 7-year audit-retention reason." ;
	<urn:solutiondesign:ontology:rootEntity> "RefundRequest" .

<urn:solutiondesign:instance:payments:RefundRequestedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Consumers table also lists 'approvals' — no such bounded context in the project registry (likely refers to the internal Financial Admin approval step modeled within this same aggregate, not a separate domain); not asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "refund_request_id, transaction_id, refund_amount, requested_by, reason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin initiates a refund" .

<urn:solutiondesign:instance:payments:RefundState_Approved> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Approved" .

<urn:solutiondesign:instance:payments:RefundState_Completed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Completed" .

<urn:solutiondesign:instance:payments:RefundState_Failed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Failed" .

<urn:solutiondesign:instance:payments:RefundState_Processing> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Processing" .

<urn:solutiondesign:instance:payments:RefundState_Rejected> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Rejected" .

<urn:solutiondesign:instance:payments:RefundState_Requested> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Requested" .

<urn:solutiondesign:instance:payments:Req_07_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The 'Pay Fee' link is displayed to Citizen, Business, and State Admin/staff users; shown immediately on the application confirmation page after submission; also shown on the pending certification/application status page for later payment; no longer available once status updates to Paid; the confirmation email template includes a coded insert for the pay fee link; if not paid immediately, application status is Pending Payment while the application remains Submitted." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: pay:Seq_IndividualPaymentHappyPath and pay:Seq_PaymentRetryAfterFailure both begin exactly at 'User clicks Pay Fee link', and pay:Seq_PaymentRetryAfterFailure's own UI note ('Link always available for Pending Payment') matches this story's persistence criterion. cred:AppState_PendingPayment (credentialing-domain.ttl) is a real, already-modeled state matching this story's status name exactly. comm:EmailTemplateAggregate (communications-api.ttl) is Communications' own real templating concept — matches 'coded insert for the pay fee link' well, though the specific coded-insert/merge-field mechanism isn't independently confirmed against communications' own docs in this pass (out of scope; Communications' own FDD ingestion should verify). Comment 10 ('Define users.') on the 'Citizen, Business, State Admin' phrase is the same role-definition ambiguity FDD 11/16 and 29 both raised; already resolved concretely elsewhere (payments-permissions.md/payments-sequences.md define Business User as district staff managing temporary credentials/substitutes) — not re-raised. Wireframes 07/08 (viewed) directly show both halves of this story (confirmation-page link with Pay Later deferral; pending-status-page Payment tab)." ;
	<urn:solutiondesign:ontology:requirementId> "7.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:credentialing:AppState_PendingPayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_InitiatePayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_IndividualPaymentHappyPath> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_PaymentRetryAfterFailure> ;
	<urn:solutiondesign:ontology:statement> "As a User (Citizen, Business, State Admin), I want to see a Pay Fee link after submitting my credential application so that I can immediately complete the required payment." ;
	<urn:solutiondesign:ontology:title> "Display Pay Fee link across the application lifecycle" .

<urn:solutiondesign:instance:payments:Req_07_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking 'Pay Fee' navigates the user away from MiEdWorkforce to CEPAS; the payment information payload sent to CEPAS is encrypted (e.g. AES over TLS); MiEdWorkforce does not process payments or store credit card numbers; upon confirmation on the CEPAS site the user is automatically navigated back; the returned webpage displays a Success or Error message; CEPAS Success updates application status to Paid; CEPAS Error leaves status at Awaiting Payment." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong direct match across every criterion: AES encryption (pay:TP_CepasRedirectInitiation's own AES-256-GCM steps), never storing card data (pay:PaymentsContext's own PCI-boundary notes), auto-return-with-status-message (both sequences' own UI-facing steps), and the Paid/Failed status split (pay:PayState_Paid / pay:PayState_Failed). See pay:Question_PaymentResultMessagingContradiction: comment 8 (the FDD's own author) states MiEdWorkforce displays NO message related to payment, only a status change — directly contradicted by this story's own acceptance criteria text and by wireframes 04/10/11/15/16 (all viewed), which show explicit MiEdWorkforce-rendered Payment Successful/Payment Error panels with confirmation numbers, amounts, and dates. Not resolved here." ;
	<urn:solutiondesign:ontology:requirementId> "7.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_ConfirmPayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_InitiatePayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:PayState_Failed> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:PayState_Paid> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_IndividualPaymentFailed> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_IndividualPaymentHappyPath> ;
	<urn:solutiondesign:ontology:statement> "As a User (Citizen, Business, State Admin), I want to be redirected to the CEPAS site when I click 'Pay Fee' so that I can securely enter my payment details." ;
	<urn:solutiondesign:ontology:title> "Redirect to CEPAS for secure payment entry" .

<urn:solutiondesign:instance:payments:Req_07_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Calculate the required Payment Amount from the associated License/Credential type; construct a payment request payload with Payment Amount, Type of License, and Application Reference Number; encrypt the payload (AES/TLS) and redirect the user to CEPAS; verify the integrity of the completed transaction by matching a hash provided by CEPAS against the expected amount." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match. The hash-integrity criterion technically describes the CONFIRM side of the flow (matching CEPAS's returned hash), not the initiate side this story is otherwise about — the FDD bundles both directions under one 'send CEPAS what's needed' story; pay:Rule_HashValidationRequired is linked for that half rather than treating it as out of scope." ;
	<urn:solutiondesign:ontology:requirementId> "7.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_InitiatePayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_HashValidationRequired> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_PaymentAmountImmutability> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:TP_CepasRedirectInitiation> ;
	<urn:solutiondesign:ontology:statement> "As MiEdWorkforce, I want to send CEPAS the information necessary to make a payment." ;
	<urn:solutiondesign:ontology:title> "Construct and send the CEPAS payment request payload" .

<urn:solutiondesign:instance:payments:Req_07_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Receive Payment Amount, Payment Type, Paid Date, CEPAS Authorization Code, CEPAS Confirmation Number, Type of License, Application Reference Number, Payment Reference Number, CEPAS Return message, and CEPAS Return Code; mark the application Paid and advance the workflow (e.g. auto-approved or credential review); double-confirm the amount via a secret-key hash match against CEPAS's own hash; store the confirmation data for traceability; the system relies entirely on this real-time CEPAS response since it never processes payments or handles card numbers itself." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, including the double-hash-confirmation detail (pay:TP_CepasConfirmationProcessing's own steps) and the 'workflow advancement' criterion (pay:PaymentCompletedEvent -> credentialing's own status transition per payments-capability.ttl's subscribesTo edge). 'Payment Type' (Credit Card or Bank Remittance, added mid-review per comment 30/31) is a distinct concept from pay:PaymentConfirmation's existing 'card type' field (VISA/MC/AMEX/etc, per the CEPAS Payments interface doc's own 'ct' parameter, explicitly NOT sent for eCheck) — Payment Type would need to be a separate payment-METHOD-category field alongside card type, not a synonym for it; not currently modeled as its own PaymentConfirmation field. Minor terminology gap, not raised as a full Annotation given how small it is." ;
	<urn:solutiondesign:ontology:requirementId> "7.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:credentialing:AppState_PendingPayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_ConfirmPayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:PaymentCompletedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_HashValidationRequired> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:TP_CepasConfirmationProcessing> ;
	<urn:solutiondesign:ontology:statement> "As MiEdWorkforce, I want to receive all necessary outbound confirmation data from CEPAS immediately after a successful payment, so that I can update the application status and ensure comprehensive payment traceability." ;
	<urn:solutiondesign:ontology:title> "Receive and apply CEPAS outbound confirmation data" .

<urn:solutiondesign:instance:payments:Req_07_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "If CEPAS is down/unavailable when the user clicks Pay Fee, display an error message pop-up; the error message displays within MiEdWorkforce (before attempted redirection); the message informs the user the system is offline and to try again later." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, including the 'before redirection, inside MiEdWorkforce' detail (pay:Seq_CepasServiceUnavailable's own circuit-breaker health check precedes any redirect) — note the story's own title says 'error pop-up on the CEPAS website' but its acceptance criteria correctly say the error displays WITHIN MiEdWorkforce; the title itself looks like a copy-paste leftover from 7.1.2's CEPAS-side error case, not a real discrepancy in behavior (the AC text, wireframes, and pay:Seq_CepasServiceUnavailable's own diagram all agree the message is MiEdWorkforce-side). No wireframe distinctly depicts this specific 'system offline' message (wireframe-11's generic Payment Error panel is the closest visual match, per that wireframe's own note) — not raised as a gap given the AC text is otherwise unambiguous." ;
	<urn:solutiondesign:ontology:requirementId> "7.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_CepasUnavailabilityHandling> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_CepasServiceUnavailable> ;
	<urn:solutiondesign:ontology:statement> "As MiEdWorkforce, I want to direct a user to an error pop-up on the CEPAS website when the CEPAS server is down and the user tries to pay so that they know why they cannot proceed." ;
	<urn:solutiondesign:ontology:title> "Display CEPAS-unavailable error before redirect" .

<urn:solutiondesign:instance:payments:Req_07_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Ingest the CEPAS post file daily; the file is an audit summary of the previous day's transactions; contains single/bulk payments and single/bulk refunds plus missing-payment information; used for reconciling/auditing; transferred via the State's File Transfer Service (FTS), inbound to MiEdWorkforce; contains a Payment Command Code (Payment=1, Refund=5, Partial Refund=14, etc.)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match — pay:UT_PaymentCommandCode's full code list (1/5/6/9/10/14/15/16) is a superset of what this story names, sourced from the same posting-file interface spec (confirmed against Fdd07CepasPostingFileInterfaceDoc). FTS as the transfer mechanism matches ext:FTSSystem's own Dependency in payments-capability.ttl." ;
	<urn:solutiondesign:ontology:requirementId> "7.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:BatchJob_PostingFileReconciliation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_DailyPostingFileReconciliation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:UT_PaymentCommandCode> ;
	<urn:solutiondesign:ontology:statement> "As MiEdWorkforce, I want to receive a CEPAS post file containing information about single payments, bulk payments, single refunds, and bulk refunds so that I can perform payment reconciliation." ;
	<urn:solutiondesign:ontology:title> "Receive daily CEPAS posting file for reconciliation" .

<urn:solutiondesign:instance:payments:Req_07_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "A dedicated daily batch job processes the incoming posting file; checks specifically for missing-payment-information records; the posting file is the designated source of truth for payment status during reconciliation." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match; 'source of truth' language is a near-verbatim match to pay:Rule_PostingFileSourceOfTruth's own statement." ;
	<urn:solutiondesign:ontology:requirementId> "7.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:BatchJob_PostingFileReconciliation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_PostingFileSourceOfTruth> ;
	<urn:solutiondesign:ontology:statement> "As MiEdWorkforce, I want to process a daily batch job using the CEPAS post file so that I can automatically update records where payment confirmation was initially missed." ;
	<urn:solutiondesign:ontology:title> "Daily batch job processes the posting file" .

<urn:solutiondesign:instance:payments:Req_07_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "If missing payment information is identified, automatically update the respective tables; the update is automatic, requiring no manual approval; this corrects payments initially missed during real-time confirmation to 'paid' status; if no missing payment information is found, no action is required." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, including the 'no manual approval needed' detail (pay:Rule_MissingPaymentAutoUpdateRestrictions's own auto-update behavior for Pending transactions) and the no-action-needed branch (pay:Seq_DailyPostingFileReconciliation's own 'Match confirmed, no action needed' branch)." ;
	<urn:solutiondesign:ontology:requirementId> "7.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:BatchJob_PostingFileReconciliation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:MissingPaymentDetectedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_MissingPaymentAutoUpdateRestrictions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_MissingPaymentRecovery> ;
	<urn:solutiondesign:ontology:statement> "As MiEdWorkforce, I want the system to update the respective MiEdWorkforce tables if missing payment information is found in the batch job so that the payment status is accurately reflected." ;
	<urn:solutiondesign:ontology:title> "Auto-update missing payment information found by the batch job" .

<urn:solutiondesign:instance:payments:Req_07_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Support processing multiple transactions simultaneously via bulk/batch for both payments and refunds; generate and submit a single payment request to CEPAS encapsulating fees for multiple credential applications; trigger multiple distinct refund requests via the CEPAS API based on a bulk administrator selection; receive and process the daily CEPAS post file for both bulk payments and bulk refunds." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, comprehensive match across all four sub-criteria: single-request-for-multiple-applications (pay:Op_InitiateBulkPayment/pay:Rule_BulkPaymentFeeIntegrity), multiple-distinct-refund-requests (pay:Op_RequestBulkRefund's own per-item RefundRequest creation), and posting-file handling for both (pay:Seq_DailyPostingFileReconciliation's Command Code 1/5 branches, already linked from 7.2.x)." ;
	<urn:solutiondesign:ontology:requirementId> "7.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_InitiateBulkPayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_RequestBulkRefund> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_BulkPaymentFeeIntegrity> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_BulkPaymentProcessing> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_BulkRefundProcessing> ;
	<urn:solutiondesign:ontology:statement> "As MiEdWorkforce, I want to support bulk/batch processing of payments and refunds to CEPAS so that district staff and administrators can efficiently manage high volumes of transactions." ;
	<urn:solutiondesign:ontology:title> "Support bulk/batch processing of payments and refunds" .

<urn:solutiondesign:instance:payments:Req_07_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Show the Business User (e.g. district staff managing temporary credentials/substitutes) a view of multiple applications with outstanding fees; allow selecting multiple pending applications; display 'No Unpaid Applications' if none exist; accurately calculate and display the single total fee owed for all selected applications; provide a Pay Fee link/button that initiates the single bulk transaction for the calculated total; redirect to CEPAS passing required metadata for all applications in the batch; navigate back to MiEdWorkforce on both success and error." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match on every criterion, corroborated in detail by wireframes 05/12-16 (all viewed): the empty state (wireframe-13, near-exact 'No Unpaid Applications' text match), the selected-total footer (wireframe-14, $450.00 across 10 selected items — matches pay:Rule_BulkPaymentFeeIntegrity's own worked example structure even though the dollar figures differ), and both the success (wireframe-15) and error (wireframe-16) return states. pay:Perm_TransactionInitiateBulk's own scope model (District/ISD/System-wide) matches 'Business User... district staff' precisely. See the discrepancy Annotation above (targeting this Requirement) on the two visually different bulk-payment mockups in this same FDD." ;
	<urn:solutiondesign:ontology:requirementId> "7.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_InitiateBulkPayment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Perm_TransactionInitiateBulk> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_BulkPaymentProcessing> ;
	<urn:solutiondesign:ontology:statement> "As a Business User, I want to select multiple applications with outstanding fees so that I can complete a single bulk payment." ;
	<urn:solutiondesign:ontology:title> "Business User selects multiple applications for a single bulk payment" .

<urn:solutiondesign:instance:payments:Req_07_BizSpec_Refund> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Inbound to CEPAS: Original Payment Amount, CEPAS Confirmation Number, Refund Amount. Outbound from CEPAS: Refund Amount, CEPAS Refund Confirmation Number, Date Refund Processed. (HLS Use Cases 9-11 restate the same content at coarser grain and are skipped as duplicative, per CONVENTIONS.md, same as the rest of the HLS table.)" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:notes> "Very strong match — payments-capability.ttl/payments-api.ttl/payments-sequences.ttl model refund processing (including the >$500 dual-approval workflow this FDD's own prose doesn't even mention) in more detail than this FDD provides. The interesting finding isn't a gap on the Payments side; it's that the Addendum's own Feature/story numbering (7.1.1-7.1.5, 7.2.1-7.2.3, 7.3.1-7.3.2) never gives refund processing its own number at all, despite Feature 7.1's title explicitly being 'CEPAS Interface (Payments AND REFUNDS)' — see pay:Question_AddendumOmitsRefundFeature." ;
	<urn:solutiondesign:ontology:requirementId> "BizSpec-Refunds" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_ApproveRefund> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Op_RequestRefund> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Rule_RefundAmountValidation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_RefundRequestDualApproval> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:Seq_RefundRequestSingleApproval> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:payments:TP_CepasRefundApiCall> ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem — this is Business Specifications prose, not Addendum narrative form.) The system integrates MiEdWorkforce with the CEPAS interface for processing refunds with real-time capability, using API as needed, with traceability. Refunds are processed by the MiEdWorkforce Credential Administrator." ;
	<urn:solutiondesign:ontology:title> "Refund processing via CEPAS (never given its own 7.x number)" .

<urn:solutiondesign:instance:payments:Rule_BulkPaymentFeeIntegrity> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:Op_InitiateBulkPayment> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:example> "User selects 5 applications ($50+$75+$50+$100+$50 = $325). If the CEPAS confirmation returns $325, all 5 applications are marked Paid. If it returns a different amount, all 5 remain Pending and a discrepancy is flagged." ;
	<urn:solutiondesign:ontology:rationale> "Prevents partial-payment scenarios where some applications in a bulk batch are paid and others are not." ;
	<urn:solutiondesign:ontology:statement> "When processing a bulk payment, the system must validate that the total amount equals the sum of individual application fees. Bulk payment succeeds or fails atomically." .

<urn:solutiondesign:instance:payments:Rule_CepasUnavailabilityHandling> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:Op_InitiatePayment> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:example> "User submits a credential application successfully; status is set to Pending Payment. User clicks \"Pay Fee\"; a health check detects CEPAS is unavailable (timeout or 503). Error message is displayed: \"Payment system temporarily unavailable. Please try again later. Your application has been submitted.\" User returns in 1 hour and the redirect succeeds." ;
	<urn:solutiondesign:ontology:rationale> "Separates application submission from payment timing so users can submit applications and pay later, improving user experience during CEPAS outages." ;
	<urn:solutiondesign:ontology:statement> "If the CEPAS server is unreachable when a user clicks \"Pay Fee\", the system must display an error message within MiEdWorkforce (before attempting the redirect) and allow the user to retry later. Application submission is not blocked." .

<urn:solutiondesign:instance:payments:Rule_HashValidationRequired> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:Op_ConfirmPayment> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:example> "CEPAS returns c=12345, t=100.00, hash=a1b2c3d4.... MiEdWorkforce calculates SHA-1(\"12345\" + \"100.00\" + SecurityKey). If hashes match, transaction is marked Paid; if not, transaction is marked Failed and an alert is raised." ;
	<urn:solutiondesign:ontology:rationale> "Prevents spoofed payment confirmations and ensures data integrity. CEPAS provides a hash calculated as SHA-1(ConfirmationNumber + Amount + SecurityKey) which MiEdWorkforce must independently verify." ;
	<urn:solutiondesign:ontology:statement> "All payment confirmations returned from a CEPAS redirect must pass SHA-1 hash validation before updating transaction status to Paid." .

<urn:solutiondesign:instance:payments:Rule_MissingPaymentAutoUpdateRestrictions> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:BatchJob_PostingFileReconciliation> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:ReconciliationBatchAggregate> ;
	<urn:solutiondesign:ontology:example> "Transaction T1 marked Failed on Jan 10 (declined card). User retries with a different card, creating Transaction T2 (succeeds). The Jan 11 posting file includes T2's confirmation; T2 is auto-updated to Paid, T1 remains Failed. If the posting file somehow includes T1, it is flagged as a discrepancy for manual review." ;
	<urn:solutiondesign:ontology:rationale> "Prevents corruption of the audit trail and state-machine violations. Failed payments may have been retried under a new transaction ID; refunded payments should not revert to Paid." ;
	<urn:solutiondesign:ontology:statement> "Posting file reconciliation can only auto-update transactions currently in Pending status. Transactions in Failed or Refunded status are not auto-updated even if they appear in the posting file." .

<urn:solutiondesign:instance:payments:Rule_PaymentAmountImmutability> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:example> "User initiates payment for an Elementary Credential on Jan 1, 2026 (fee: $100). Fee schedule updated Jan 5, 2026 (new fee: $120). User completes payment Jan 10, 2026. Amount charged: $100 (original calculated amount). New applications after Jan 5 pay $120." ;
	<urn:solutiondesign:ontology:rationale> "Prevents user confusion, ensures audit trail integrity, and matches CEPAS confirmation amounts. If the fee schedule changes, new applications pay the new rate; existing pending payments honor the original amount." ;
	<urn:solutiondesign:ontology:statement> "Payment amount is calculated once at transaction initiation based on credential type and cannot be modified afterward." .

<urn:solutiondesign:instance:payments:Rule_PostingFileSourceOfTruth> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:BatchJob_PostingFileReconciliation> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:ReconciliationBatchAggregate> ;
	<urn:solutiondesign:ontology:example> "User completes payment on the CEPAS site then closes the browser before the redirect back. The transaction remains Pending in MiEdWorkforce. The next morning, the posting file includes this payment; the batch job detects the missing payment and updates status to Paid, advancing the credential application workflow automatically." ;
	<urn:solutiondesign:ontology:rationale> "Real-time redirect confirmations can be missed due to browser closures, network issues, or user navigation away. The posting file ensures no revenue is lost and all payments are eventually reconciled." ;
	<urn:solutiondesign:ontology:statement> "The CEPAS posting file is the authoritative source of truth for payment status. If the posting file confirms a payment that MiEdWorkforce has as Pending, the system automatically updates it to Paid." .

<urn:solutiondesign:instance:payments:Rule_RefundAmountValidation> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:Op_RequestRefund> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:payments:RefundRequestAggregate> ;
	<urn:solutiondesign:ontology:example> "Original payment: $100. Valid refund requests: $100 (full), $50 (partial), $25 (partial). Invalid: $150 (exceeds original) — blocked before the CEPAS API call. If a $30 partial refund has already processed, the maximum new refund is $70; multiple partial refunds are allowed until the total refunded equals the original amount." ;
	<urn:solutiondesign:ontology:rationale> "Prevents over-refunding and ensures financial integrity. CEPAS enforces this on their end too, but MiEdWorkforce validates before the API call to give immediate user feedback." ;
	<urn:solutiondesign:ontology:statement> "Refund amount must be less than or equal to the original payment amount. Partial refunds must leave a non-zero remainder or represent the full amount." .

<urn:solutiondesign:instance:payments:Seq_BulkPaymentProcessing> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor DistrictStaff as District Staff\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant Credentials\n    participant CEPAS\n    participant EventBus\n    participant Comms as Communications\n\n    DistrictStaff->>UI: Navigate to bulk payment page\n    UI->>Payments: GET /applications/pending-payment?districtId=12345\n\n    Payments->>Credentials: Query applications<br/>Filter: District 12345, Status=Pending Payment\n    Credentials-->>Payments: List of 10 applications<br/>App1: $50, App2: $75, App3-10: $50 each\n\n    Payments-->>UI: Applications list\n    UI-->>DistrictStaff: Display table with checkboxes<br/>Total available: 10 applications\n\n    DistrictStaff->>UI: Select applications 1-10\n    DistrictStaff->>UI: Click \"Pay Fees\" ($525 total)\n\n    UI->>Payments: POST /payments/initiate-bulk<br/>applicationIds: [APP-1, APP-2, ..., APP-10]\n\n    Payments->>Payments: Validate user permission<br/>Scope: District 12345<br/>All apps in scope: YES\n\n    Payments->>Payments: Create BulkPaymentTransaction<br/>Total: $525 ($50×9 + $75×1)<br/>Reference: BULK-789|APP-1,APP-2,...,APP-10\n\n    Payments->>Payments: Create 10 child PaymentTransactions<br/>Each linked to bulk parent<br/>All Status: Pending\n\n    Payments->>Payments: Encrypt payload: amount=$525\n    Payments-->>UI: 302 Redirect to CEPAS\n    UI-->>DistrictStaff: Browser redirects to CEPAS\n\n    DistrictStaff->>CEPAS: Review payment summary ($525)\n    DistrictStaff->>CEPAS: Enter payment details\n    DistrictStaff->>CEPAS: Confirm payment\n\n    CEPAS->>CEPAS: Process payment<br/>Confirmation: CONF-999<br/>Amount: $525.00\n\n    CEPAS-->>DistrictStaff: Redirect to MiEdWorkforce<br/>returnurl?c=0&o=CONF-999&t=525.00&...\n\n    DistrictStaff->>UI: Browser redirects back\n    UI->>Payments: GET /payments/confirm?c=0&o=CONF-999...\n\n    Payments->>Payments: Validate hash\n    Payments->>Payments: Validate amount: $525 = $525: YES\n\n    Payments->>Payments: Update BulkPaymentTransaction: Paid<br/>Update all 10 child transactions: Paid<br/>ConfirmationNumber: CONF-999\n\n    Payments--)EventBus: BulkPaymentCompleted<br/>Payload: applicationIds: [APP-1...APP-10]\n\n    EventBus--)Credentials: BulkPaymentCompleted event\n    Credentials->>Credentials: Update all 10 applications<br/>Status: Pending Payment -> In Review\n\n    EventBus--)Comms: BulkPaymentCompleted event\n    Comms--)DistrictStaff: Email: Bulk payment confirmation<br/>Itemized list of 10 applications\n\n    Payments-->>UI: 200 OK (success page data)\n    UI-->>DistrictStaff: Display success page<br/>\"10 applications paid: $525\"<br/>Confirmation: CONF-999\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Amount mismatch -> All transactions remain Pending, discrepancy flagged. Any application out of scope -> Reject entire bulk payment request." ;
	<urn:solutiondesign:ontology:eventsPublished> "BulkPaymentCompleted - Includes array of all application IDs." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Atomic success/failure: All applications paid or none; no partial payments. Amount validation: Total must equal sum of individual fees. Scope enforcement: User can only select applications within authorized district/ISD; the calling domain validates application eligibility before Payments is invoked." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Bulk Payment Processing" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District staff selects multiple credential applications and processes single payment for total fees. When: Business user (district staff) needs to pay fees for multiple applications. Who: Business User with payments.transaction.initiate-bulk permission." .

<urn:solutiondesign:instance:payments:Seq_BulkRefundProcessing> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor CredAdmin as Credential Admin\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant EventBus\n    participant Comms as Communications\n\n    CredAdmin->>UI: Navigate to bulk refund page\n    UI->>Payments: GET /payments?status=Paid&districtId=12345\n    Payments-->>UI: List of paid transactions\n\n    UI-->>CredAdmin: Display paid transactions table\n\n    CredAdmin->>UI: Select 5 transactions:<br/>CONF-100 ($50), CONF-101 ($50),<br/>CONF-102 ($50), CONF-103 ($75),<br/>CONF-104 ($50)\n\n    CredAdmin->>UI: For each, enter refund amount:<br/>All full refunds (total: $275)\n\n    CredAdmin->>UI: Enter reason: \"District processing error\"\n    CredAdmin->>UI: Click \"Submit Bulk Refund\"\n\n    UI->>Payments: POST /refunds/bulk-request<br/>transactions: [{id, amount, reason}, ...]<br/>Total: $275\n\n    Payments->>Payments: Validate all amounts <= original: YES\n    Payments->>Payments: Check threshold: $275 <= $500: YES<br/>Single approval (auto-approved)\n\n    Payments->>Payments: Create 5 RefundRequest records<br/>All Status: Approved (auto)<br/>LinkedBulkId: BULK-REFUND-789\n\n    loop For each refund (5 requests)\n        Payments->>CEPAS: POST /api/v1/payment/cancel<br/>ConfirmationNumber: CONF-100<br/>RefundAmount: 50.00\n\n        CEPAS->>CEPAS: Process refund\n        CEPAS-->>Payments: 200 OK<br/>RefundConfirmationNumber: REFUND-200\n\n        Payments->>Payments: Update RefundRequest: Completed<br/>RefundConfirmationNumber: REFUND-200\n\n        Payments->>Payments: Update PaymentTransaction: Refunded\n    end\n\n    Payments--)EventBus: BulkRefundCompleted<br/>Payload: refundIds: [5 IDs], totalAmount: $275\n\n    EventBus--)Comms: BulkRefundCompleted event\n    Comms--)CredAdmin: Email: Bulk refund processed<br/>5 refunds: $275 total\n\n    Payments-->>UI: 200 OK<br/>Summary: 5 refunds processed\n\n    UI-->>CredAdmin: Display success:<br/>\"5 refunds processed successfully\"<br/>Confirmation numbers: REFUND-200...REFUND-204\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "If any CEPAS API call fails, that refund marked Failed, others continue; summary shows successful vs. failed counts." ;
	<urn:solutiondesign:ontology:eventsPublished> "BulkRefundCompleted - Single event with summary of all refunds." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Sequential processing: Refunds processed one-by-one via CEPAS API (not atomic batch). Partial success handling: If one fails, others continue; failure logged separately. Threshold calculation: Total refund amount determines approval requirements." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Bulk Refund Processing" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Credential Admin selects multiple paid transactions for bulk refund. When: Multiple applications need refunds (e.g., district error, program cancellation). Who: Credential Administrator (with Financial Admin approval for high values)." .

<urn:solutiondesign:instance:payments:Seq_CepasServiceUnavailable> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant CircuitBreaker\n    participant Monitoring\n\n    User->>UI: Click \"Pay Fee\"\n    UI->>Payments: GET /payments/initiate?applicationId=APP-123\n\n    Payments->>CircuitBreaker: Check CEPAS health\n    CircuitBreaker->>CEPAS: HTTP HEAD https://epay.michigan.gov/payment<br/>Timeout: 5 seconds\n\n    alt CEPAS unavailable\n        CEPAS-->>CircuitBreaker: Timeout (no response)\n        CircuitBreaker->>CircuitBreaker: Record failure<br/>Failure count: 3/3<br/>Circuit state: CLOSED -> OPEN\n\n        CircuitBreaker--)Monitoring: Alert: CEPAS circuit breaker opened<br/>Timestamp: 2026-01-15 10:30:00\n\n        CircuitBreaker-->>Payments: Health check failed<br/>Circuit state: OPEN\n\n        Payments-->>UI: 503 Service Unavailable<br/>Error: \"Payment system temporarily unavailable\"\n\n        UI-->>User: Display error message<br/>\"The payment system is temporarily unavailable.<br/>Please try again later.<br/>Your application has been submitted.\"\n\n        Note over CircuitBreaker: Circuit remains OPEN<br/>for 5 minutes (cooldown)\n\n    else CEPAS available (after cooldown)\n        Note over CircuitBreaker: After 5-minute cooldown\n\n        User->>UI: Click \"Pay Fee\" (retry)\n        UI->>Payments: GET /payments/initiate?applicationId=APP-123\n\n        Payments->>CircuitBreaker: Check CEPAS health\n        CircuitBreaker->>CEPAS: HTTP HEAD https://epay.michigan.gov/payment\n        CEPAS-->>CircuitBreaker: 200 OK\n\n        CircuitBreaker->>CircuitBreaker: Health check success<br/>Circuit state: OPEN -> HALF-OPEN -> CLOSED\n\n        CircuitBreaker-->>Payments: Health check passed\n        Payments->>Payments: Create PaymentTransaction<br/>Encrypt payload\n        Payments-->>UI: 302 Redirect to CEPAS\n        UI-->>User: Browser redirects to CEPAS\n\n        Note over User,CEPAS: Payment proceeds normally\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "CEPAS unreachable -> 503 Service Unavailable, circuit opens for 5-minute cooldown." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (circuit breaker alert to Monitoring only, not a modeled sd:DomainEvent)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Circuit breaker pattern: Prevents cascading failures and reduces load on struggling CEPAS. Health check before redirect: Fail fast with clear error rather than broken redirect. Cooldown period: 5 minutes (configurable) before retry attempts." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "CEPAS Service Unavailable" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: User attempts payment when CEPAS is down; system displays error and allows retry later. When: CEPAS health check fails. Who: Any user attempting payment." .

<urn:solutiondesign:instance:payments:Seq_DailyPostingFileReconciliation> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant ReconciliationJob\n    participant FTS as File Transfer Service\n    participant CEPAS\n    participant Payments\n    participant EventBus\n    participant Monitoring\n\n    Note over ReconciliationJob: Scheduled: Daily 3:00 AM EST\n\n    ReconciliationJob->>ReconciliationJob: Start reconciliation batch\n    ReconciliationJob->>Payments: Create ReconciliationBatch<br/>Status: Processing<br/>FileDate: 2026-01-15\n\n    ReconciliationJob->>FTS: SFTP connect\n    ReconciliationJob->>FTS: GET MiEdWorkforce_260115.txt\n    FTS-->>ReconciliationJob: Posting file (fixed-width text)\n\n    ReconciliationJob->>ReconciliationJob: Parse file<br/>AH (header): Validate site, agency, application<br/>AD (transactions): Extract records<br/>AF (footer): Validate total records, total amount\n\n    Note over ReconciliationJob: Header/Footer validation: PASS<br/>Expected records: 247<br/>Expected total: $24,750.00\n\n    loop For each AD transaction record (247 records)\n        ReconciliationJob->>ReconciliationJob: Extract fields:<br/>- Confirmation Number<br/>- Payment Amount<br/>- Custom Reference (APP-123)<br/>- Command Code (1=Payment, 5=Refund, 6=Void, 9=Chargeback, 10=ChargebackReversal, 14=Partial, 15=ACHCredit, 16=ProcessorVoid)\n\n        alt Command Code = 1 (Payment)\n            ReconciliationJob->>Payments: Query by reference: APP-123\n\n            alt Transaction found, Status=Pending\n                Payments->>Payments: Update PaymentTransaction<br/>Status: Pending -> Paid<br/>ConfirmationNumber: CONF-789<br/>Source: Posting File\n                Payments--)EventBus: MissingPaymentDetected\n                Payments--)EventBus: PaymentCompleted\n                ReconciliationJob->>ReconciliationJob: Log: Missing payment recovered\n            else Transaction found, Status=Paid\n                ReconciliationJob->>ReconciliationJob: Match confirmed<br/>No action needed\n            else Transaction found, Amount mismatch\n                ReconciliationJob->>Payments: Create ReconciliationDiscrepancy<br/>Type: Amount Mismatch<br/>Expected: $100, Actual: $105\n                ReconciliationJob--)EventBus: PaymentDiscrepancyDetected\n            else Transaction not found\n                ReconciliationJob->>Payments: Create ReconciliationDiscrepancy<br/>Type: Orphan Payment<br/>(Payment in CEPAS but no application)\n                ReconciliationJob--)EventBus: PaymentDiscrepancyDetected\n            end\n\n        else Command Code = 5 (Refund)\n            ReconciliationJob->>Payments: Match refund confirmation number\n            ReconciliationJob->>ReconciliationJob: Verify refund recorded\n        else Command Code = 6, 9, 10, 15, or 16 (Void, Chargeback, Chargeback Reversal, ACH Credit, Processor Void)\n            ReconciliationJob->>ReconciliationJob: Record as ReconciliationRecord with match_result = Discrepancy\n            Note over ReconciliationJob: Not auto-resolved - no defined handling for these codes yet; flagged for manual classification\n        end\n    end\n\n    ReconciliationJob->>Payments: Update ReconciliationBatch<br/>Status: Processing -> Completed<br/>Summary:<br/>- Total Records: 247<br/>- Matched: 240<br/>- Missing Payments Recovered: 5<br/>- Discrepancies: 2\n\n    ReconciliationJob--)EventBus: ReconciliationBatchCompleted\n    EventBus--)Monitoring: ReconciliationBatchCompleted event\n\n    alt Discrepancies > 0\n        Monitoring--)EventBus: Alert: Manual review needed\n        EventBus--)Monitoring: Email: Payment Admin notification<br/>Subject: \"2 payment discrepancies require review\"\n    end\n\n    ReconciliationJob->>ReconciliationJob: End batch job\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Not separately enumerated in this sequence beyond pay:BatchJob_PostingFileReconciliation's own errorHandling." ;
	<urn:solutiondesign:ontology:eventsPublished> "MissingPaymentDetected - Per recovered payment. PaymentCompleted - Per recovered payment (triggers credential workflow). PaymentDiscrepancyDetected - Per unmatched or mismatched record. ReconciliationBatchCompleted - At batch completion with summary." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Source of truth: Posting file is authoritative for payment status. Auto-update restrictions: Only Pending transactions updated; Failed/Refunded left unchanged. Discrepancy handling: Flagged for manual review, not auto-resolved." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Daily Posting File Reconciliation" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Nightly batch job retrieves CEPAS posting file, matches transactions, updates missing payments, flags discrepancies. When: Daily at 3:00 AM EST (automated). Who: System (ReconciliationJob)." .

<urn:solutiondesign:instance:payments:Seq_IndividualPaymentFailed> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant Credentials\n    participant EventBus\n    participant Comms as Communications\n\n    User->>UI: Click \"Pay Fee\"\n    UI->>Payments: Initiate payment\n    Payments-->>User: Redirect to CEPAS\n\n    User->>CEPAS: Enter card details\n    User->>CEPAS: Confirm payment\n\n    CEPAS->>CEPAS: Payment DECLINED<br/>Reason: Insufficient Funds<br/>Return Code: 101\n\n    CEPAS-->>User: 302 Redirect to MiEdWorkforce<br/>returnurl?c=101&m=Declined - Insufficient Funds<br/>&t=100.00&i=SESSION-67890&hash=...\n\n    User->>UI: Browser redirects back\n    UI->>Payments: GET /payments/confirm?c=101&m=Declined...\n\n    Payments->>Payments: Validate hash (partial validation)\n    Payments->>Payments: Update PaymentTransaction<br/>Status: Pending -> Failed<br/>ReturnCode: 101<br/>ReturnMessage: Declined - Insufficient Funds<br/>FailedDate: 2026-01-15\n\n    Payments--)EventBus: PaymentFailed\n    EventBus--)Credentials: PaymentFailed event\n\n    Note over Credentials: Application remains<br/>Status: Pending Payment<br/>(Not advanced)\n\n    EventBus--)Comms: PaymentFailed event\n    Comms--)User: Email: Payment failed notification<br/>Suggestion: Try different payment method\n\n    Payments-->>UI: 200 OK (error page data)\n    UI-->>User: Display error page<br/>\"Payment declined. Try again with<br/>different card.\"<br/>[Retry Payment] button shown\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Common return codes: 101 (Declined), 102 (Insufficient Funds), 103 (Invalid Card), 104 (Expired Card)." ;
	<urn:solutiondesign:ontology:eventsPublished> "PaymentFailed - Fires when CEPAS returns non-zero return code." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Preserve failed transaction: Audit trail maintained; retry creates new transaction. User-friendly error: Generic message to user; detailed error logged for admin review. Unlimited retries: User can attempt payment multiple times." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Individual Payment Flow (Payment Failed)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Payment fails on CEPAS (e.g., declined card, insufficient funds); user can retry. When: CEPAS returns error code via redirect. Who: User (after payment decline)." .

<urn:solutiondesign:instance:payments:Seq_IndividualPaymentHappyPath> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant Credentials\n    participant EventBus\n    participant Comms as Communications\n\n    User->>UI: Click \"Pay Fee\" link\n    UI->>Payments: GET /payments/initiate?applicationId=APP-123\n\n    Payments->>Payments: Create PaymentTransaction<br/>Status: Pending<br/>Amount: $100.00 (from credential type)<br/>Reference: APP-123\n    Payments->>Payments: Encrypt payload with AES GCM<br/>(amount, ref, id, returnurl)\n\n    Note over Payments: Encrypted format:<br/>aen=<key_id>|<12B_nonce><ciphertext+tag>\n\n    Payments-->>UI: 302 Redirect to CEPAS<br/>URL: https://epay.michigan.gov/payment?aen=...\n    UI-->>User: Browser redirects to CEPAS\n\n    User->>CEPAS: Enter credit card details\n    User->>CEPAS: Confirm payment ($100.00)\n\n    CEPAS->>CEPAS: Process payment<br/>Generate confirmation: CONF-789<br/>Calculate hash: SHA-1(CONF-789 + 100.00 + SecurityKey)\n\n    CEPAS-->>User: 302 Redirect to MiEdWorkforce<br/>returnurl?c=0&m=Success&o=CONF-789&t=100.00<br/>&d=2026-01-15&z=AUTH-456&i=SESSION-67890<br/>&ct=VISA&hash=a1b2c3d4...\n\n    User->>UI: Browser redirects back\n    UI->>Payments: GET /payments/confirm?c=0&o=CONF-789&...\n\n    Payments->>Payments: Validate hash<br/>Expected: SHA-1(CONF-789 + 100.00 + SecurityKey)<br/>Received: a1b2c3d4...<br/>Match: YES\n\n    Payments->>Payments: Update PaymentTransaction<br/>Status: Pending -> Paid<br/>ConfirmationNumber: CONF-789<br/>PaidDate: 2026-01-15<br/>AuthorizationCode: AUTH-456<br/>CardType: VISA\n\n    Payments--)EventBus: PaymentCompleted\n    EventBus--)Credentials: PaymentCompleted event\n    Credentials->>Credentials: Update application<br/>Status: Pending Payment -> In Review\n\n    EventBus--)Comms: PaymentCompleted event\n    Comms--)User: Email: Payment confirmation\n\n    Payments-->>UI: 200 OK (success page data)\n    UI-->>User: Display success page<br/>Confirmation #: CONF-789<br/>Amount: $100.00\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Hash validation fails -> Transaction marked Failed, security alert raised. CEPAS returns error code -> see \"Individual Payment Flow (Payment Failed)\"." ;
	<urn:solutiondesign:ontology:eventsPublished> "PaymentCompleted - Fires after hash validation success." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "PCI Compliance: MiEdWorkforce never handles card data; all sensitive processing on CEPAS. Hash validation: Required security check prevents spoofed confirmations. Event-driven: Credential workflow advancement triggered by PaymentCompleted event." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Individual Payment Flow (Happy Path)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: User initiates payment for credential application fee, completes payment on CEPAS, and returns to MiEdWorkforce with confirmation. When: User clicks \"Pay Fee\" link on pending credential application. Who: Citizen User, Business User, or State Admin/Staff." .

<urn:solutiondesign:instance:payments:Seq_MissingPaymentRecovery> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant FTS as File Transfer Service\n    participant ReconciliationJob\n    participant EventBus\n    participant Credentials\n    participant Comms as Communications\n\n    Note over User,CEPAS: User initiates payment, completes on CEPAS\n\n    User->>UI: Click \"Pay Fee\"\n    UI->>Payments: Initiate payment\n    Payments-->>User: Redirect to CEPAS\n\n    User->>CEPAS: Complete payment ($100.00)\n    CEPAS->>CEPAS: Payment successful<br/>Generate CONF-789\n    CEPAS-->>User: 302 Redirect to MiEdWorkforce\n\n    User->>User: CLOSE BROWSER<br/>(Never returns to MiEdWorkforce)\n\n    Note over Payments: PaymentTransaction remains<br/>Status: Pending<br/>(Confirmation never received)\n\n    Note over CEPAS,FTS: Next morning at 3:00 AM EST\n\n    CEPAS->>FTS: Post daily file via SFTP<br/>Filename: MiEdWorkforce_260115.txt\n\n    ReconciliationJob->>FTS: Retrieve posting file (SFTP)\n    FTS-->>ReconciliationJob: MiEdWorkforce_260115.txt\n\n    ReconciliationJob->>ReconciliationJob: Parse fixed-width file<br/>AH (header), AD (transactions), AF (footer)\n\n    Note over ReconciliationJob: AD Record found:<br/>ConfirmationNumber: CONF-789<br/>Amount: $100.00<br/>Reference: APP-123<br/>Command Code: 1 (Payment)\n\n    ReconciliationJob->>Payments: Query transaction by APP-123\n    Payments-->>ReconciliationJob: Found: Status=Pending\n\n    ReconciliationJob->>Payments: Update PaymentTransaction<br/>Status: Pending -> Paid<br/>ConfirmationNumber: CONF-789<br/>Source: Posting File Reconciliation\n\n    Payments--)EventBus: MissingPaymentDetected\n    Payments--)EventBus: PaymentCompleted\n\n    EventBus--)Credentials: PaymentCompleted event\n    Credentials->>Credentials: Update application<br/>Status: Pending Payment -> In Review\n\n    EventBus--)Comms: PaymentCompleted event\n    Comms--)User: Email: Payment confirmation (delayed)\n\n    ReconciliationJob->>ReconciliationJob: Log: Missing payment recovered<br/>Transaction: APP-123<br/>Confirmation: CONF-789\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "None distinct from the reconciliation batch job's own error handling (see pay:BatchJob_PostingFileReconciliation)." ;
	<urn:solutiondesign:ontology:eventsPublished> "MissingPaymentDetected - Fires when posting file payment not found in real-time flow. PaymentCompleted - Standard payment completion event (triggers credential workflow)." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Posting file is source of truth: Catches all payments that CEPAS confirmed, even if redirect missed. Auto-update only Pending: Failed or Refunded transactions not overwritten. Monitoring: MissingPaymentDetected event tracks reliability of redirect flow." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Individual Payment Flow (Browser Closed - Missing Payment)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: User completes payment on CEPAS but closes browser before redirect; posting file reconciliation catches missing payment next morning. When: Nightly batch job processes CEPAS posting file. Who: System (automated reconciliation)." .

<urn:solutiondesign:instance:payments:Seq_PaymentRetryAfterFailure> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant EventBus\n\n    Note over User,Payments: Previous payment attempt failed<br/>Transaction T1: Status=Failed\n\n    User->>UI: View application (Status: Pending Payment)\n    UI-->>User: Display \"Pay Fee\" link<br/>(Link always available for Pending Payment)\n\n    User->>UI: Click \"Pay Fee\" (retry)\n    UI->>Payments: GET /payments/initiate?applicationId=APP-123\n\n    Payments->>Payments: Check for existing Paid transaction<br/>Query: applicationId=APP-123, Status=Paid\n\n    alt Existing Paid transaction found\n        Payments-->>UI: 409 Conflict<br/>Error: \"Payment already completed\"\n        UI-->>User: Display: \"This application has already been paid.\"\n\n    else No Paid transaction (only Failed transaction exists)\n        Payments->>Payments: Create NEW PaymentTransaction (T2)<br/>Status: Pending<br/>Amount: $100.00<br/>Reference: APP-123\n\n        Note over Payments: Original failed transaction (T1)<br/>preserved in audit trail\n\n        Payments->>Payments: Encrypt payload\n        Payments-->>UI: 302 Redirect to CEPAS\n        UI-->>User: Browser redirects to CEPAS\n\n        User->>CEPAS: Enter DIFFERENT card details\n        User->>CEPAS: Confirm payment\n\n        CEPAS->>CEPAS: Payment successful<br/>Confirmation: CONF-999\n\n        CEPAS-->>User: Redirect to MiEdWorkforce\n        User->>UI: Browser redirects back\n        UI->>Payments: GET /payments/confirm?c=0&o=CONF-999...\n\n        Payments->>Payments: Validate hash\n        Payments->>Payments: Update PaymentTransaction T2<br/>Status: Pending -> Paid<br/>ConfirmationNumber: CONF-999\n\n        Payments--)EventBus: PaymentCompleted\n\n        Payments-->>UI: 200 OK\n        UI-->>User: Display success page<br/>Confirmation: CONF-999\n\n        Note over Payments: Transaction T1: Status=Failed (preserved)<br/>Transaction T2: Status=Paid (successful retry)\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Existing Paid transaction found for the application -> 409 Conflict, \"This application has already been paid.\"" ;
	<urn:solutiondesign:ontology:eventsPublished> "PaymentCompleted - Fires on successful retry." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Each retry creates new transaction: Failed transactions preserved for audit trail. Prevent double payment: Check for existing Paid transaction before creating new one. Unlimited retries: User can attempt payment as many times as needed." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Payment Retry After Failure" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: User retries payment after previous attempt failed (declined card, timeout, etc.). When: User clicks retry button on failed payment error page. Who: Any user with failed payment transaction." .

<urn:solutiondesign:instance:payments:Seq_ReconciliationDiscrepancyInvestigation> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor PaymentAdmin as Payment Admin\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant EventBus\n\n    Note over Payments: Reconciliation batch detected discrepancy<br/>Type: Amount Mismatch<br/>Expected: $100, Actual: $105\n\n    PaymentAdmin->>UI: Navigate to discrepancies page\n    UI->>Payments: GET /reconciliation/discrepancies?status=Unresolved\n    Payments-->>UI: List of unresolved discrepancies\n\n    UI-->>PaymentAdmin: Display discrepancies table<br/>Discrepancy #1:<br/>- Type: Amount Mismatch<br/>- Application: APP-123<br/>- Expected: $100.00<br/>- CEPAS Posted: $105.00<br/>- Confirmation: CONF-789\n\n    PaymentAdmin->>UI: Click discrepancy to investigate\n    UI->>Payments: GET /reconciliation/discrepancies/{id}\n    Payments-->>UI: Discrepancy details + related transaction\n\n    UI-->>PaymentAdmin: Display full details:<br/>- PaymentTransaction: APP-123, $100<br/>- Posting file record: CONF-789, $105<br/>- Date: 2026-01-15\n\n    Note over PaymentAdmin: Investigation:<br/>1. Check CEPAS portal for transaction<br/>2. Contact CEPAS support (Sean Strom)<br/>3. Determine: $5 processing fee charged<br/>   (Not communicated in advance)\n\n    PaymentAdmin->>UI: Enter resolution notes:<br/>\"Contacted CEPAS support. $5 processing fee<br/>added by CEPAS. Confirmed with Sean Strom<br/>that this is expected. Updating fee schedule.\"\n\n    PaymentAdmin->>UI: Select resolution action:<br/>\"Accept CEPAS amount as correct\"\n\n    PaymentAdmin->>UI: Click \"Resolve Discrepancy\"\n\n    UI->>Payments: POST /reconciliation/discrepancies/{id}/resolve<br/>resolution: \"Accept CEPAS amount\"<br/>notes: \"...\"<br/>correctedAmount: 105.00\n\n    Payments->>Payments: Update PaymentTransaction<br/>Amount: $100 -> $105<br/>Notes: \"Adjusted per CEPAS posting file\"\n\n    Payments->>Payments: Update ReconciliationDiscrepancy<br/>Status: Unresolved -> Resolved<br/>ResolvedBy: Payment Admin<br/>ResolvedAt: 2026-01-16<br/>ResolutionNotes: \"...\"\n\n    Payments--)EventBus: DiscrepancyResolved\n\n    Payments-->>UI: 200 OK\n    UI-->>PaymentAdmin: Display: \"Discrepancy resolved\"\n\n    Note over PaymentAdmin: Follow-up action:<br/>Update fee schedule to include<br/>$5 CEPAS processing fee\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Not separately enumerated in this sequence." ;
	<urn:solutiondesign:ontology:eventsPublished> "DiscrepancyResolved - Fires when admin marks discrepancy resolved." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Manual resolution required: No auto-resolution of discrepancies. Audit trail: All resolution actions logged with notes. Resolution options: Accept CEPAS, Reject (mark transaction Failed), Create adjustment." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Reconciliation Discrepancy Investigation" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Payment Admin investigates and manually resolves posting file discrepancy. When: Reconciliation batch detects unmatched or mismatched transaction. Who: Payment Administrator." .

<urn:solutiondesign:instance:payments:Seq_RefundRequestDualApproval> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor CredAdmin as Credential Admin\n    actor FinAdmin as Financial Admin\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant EventBus\n    participant Comms as Communications\n\n    CredAdmin->>UI: Request refund: $750\n    CredAdmin->>UI: Reason: \"Duplicate payment processing error\"\n\n    UI->>Payments: POST /refunds/request<br/>transactionId, amount: 750, reason: \"...\"\n\n    Payments->>Payments: Validate amount <= original: YES\n    Payments->>Payments: Check threshold: $750 > $500: YES<br/>Dual approval required\n\n    Payments->>Payments: Create RefundRequest<br/>Status: Requested (pending approval)<br/>Amount: $750.00<br/>RequestedBy: Credential Admin\n\n    Payments--)EventBus: RefundRequested\n    EventBus--)Comms: RefundRequested event\n    Comms--)FinAdmin: Email: Refund approval needed<br/>Amount: $750<br/>Reason: \"Duplicate payment...\"<br/>Link to approval page\n\n    Payments-->>UI: 200 OK\n    UI-->>CredAdmin: Message: \"Refund request submitted.<br/>Requires Financial Admin approval.\"\n\n    Note over FinAdmin: Financial Admin reviews request\n\n    FinAdmin->>UI: Navigate to refund approvals\n    UI->>Payments: GET /refunds/pending-approval\n    Payments-->>UI: List of pending refund requests\n    UI-->>FinAdmin: Display pending refunds\n\n    FinAdmin->>UI: Review request details\n    FinAdmin->>UI: Click \"Approve\"\n    FinAdmin->>UI: Enter approver notes: \"Verified with applicant\"\n\n    UI->>Payments: POST /refunds/{id}/approve<br/>approverNotes: \"Verified with applicant\"\n\n    Payments->>Payments: Update RefundRequest<br/>Status: Requested -> Approved<br/>ApprovedBy: Financial Admin<br/>ApprovedAt: 2026-01-16\n\n    Payments--)EventBus: RefundApproved\n\n    Payments->>CEPAS: POST /api/v1/payment/cancel<br/>Body: {ConfirmationNumber: CONF-789, RefundAmount: 750.00}\n\n    CEPAS->>CEPAS: Process refund\n    CEPAS-->>Payments: 200 OK<br/>{RefundConfirmationNumber: REFUND-456,<br/>RefundAmount: 750.00,<br/>ProcessedDate: 2026-01-16}\n\n    Payments->>Payments: Update RefundRequest: Completed<br/>RefundConfirmationNumber: REFUND-456\n\n    Payments->>Payments: Update PaymentTransaction: Refunded\n\n    Payments--)EventBus: RefundCompleted\n    EventBus--)Comms: RefundCompleted event\n    Comms--)CredAdmin: Email: Refund approved and processed\n    Comms--)FinAdmin: Email: Refund processed confirmation\n    Comms--)User: Email: Refund confirmation to applicant\n\n    Payments-->>UI: 200 OK\n    UI-->>FinAdmin: Display: \"Refund processed: REFUND-456\"\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Not separately enumerated beyond the single-approval flow's error scenarios." ;
	<urn:solutiondesign:ontology:eventsPublished> "RefundRequested - Fires when Credential Admin submits request. RefundApproved - Fires when Financial Admin approves. RefundCompleted - Fires after CEPAS confirms refund." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Dual approval threshold: Configurable; default >$500. Approval workflow: Sequential (request -> approve -> process), not parallel. Rejection path: Financial Admin can reject with reason using the same payments.refund.approve permission (not shown in diagram)." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Refund Request Processing (Dual Approval >$500)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Credential Admin requests refund >$500; requires Financial Admin approval before processing. When: High-value refund needed. Who: Credential Administrator, Financial Administrator." .

<urn:solutiondesign:instance:payments:Seq_RefundRequestSingleApproval> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:payments:PaymentsContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor CredAdmin as Credential Admin\n    participant UI as MiEdWorkforce UI\n    participant Payments\n    participant CEPAS\n    participant Credentials\n    participant EventBus\n    participant Comms as Communications\n\n    CredAdmin->>UI: Search for transaction\n    UI->>Payments: GET /payments/search?confirmationNumber=CONF-789\n    Payments-->>UI: Transaction found (Paid, $100.00)\n    UI-->>CredAdmin: Display transaction details\n\n    CredAdmin->>UI: Click \"Request Refund\"\n    UI-->>CredAdmin: Display refund form\n\n    CredAdmin->>UI: Enter refund amount: $100.00\n    CredAdmin->>UI: Enter reason: \"Applicant withdrew application\"\n    CredAdmin->>UI: Submit refund request\n\n    UI->>Payments: POST /refunds/request<br/>transactionId, amount: 100, reason: \"...\"\n\n    Payments->>Payments: Validate amount <= original: YES ($100 <= $100)\n    Payments->>Payments: Check threshold: $100 <= $500: YES<br/>Single approval path\n\n    Payments->>Payments: Create RefundRequest<br/>Status: Approved (auto-approved)<br/>Amount: $100.00<br/>Reason: \"Applicant withdrew application\"\n\n    Payments->>CEPAS: POST /api/v1/payment/cancel<br/>Headers: ApplicationID, SecurityKey, PaymentChannel<br/>Body: {ConfirmationNumber: CONF-789, RefundAmount: 100.00}\n\n    CEPAS->>CEPAS: Process refund\n    CEPAS-->>Payments: 200 OK<br/>{RefundConfirmationNumber: REFUND-123,<br/>RefundAmount: 100.00,<br/>ProcessedDate: 2026-01-16,<br/>Status: Completed}\n\n    Payments->>Payments: Update RefundRequest: Completed<br/>RefundConfirmationNumber: REFUND-123<br/>ProcessedDate: 2026-01-16\n\n    Payments->>Payments: Update PaymentTransaction: Refunded<br/>Link to RefundRequest\n\n    Payments--)EventBus: RefundCompleted\n    EventBus--)Credentials: RefundCompleted event\n    Credentials->>Credentials: Update application status<br/>(Business logic: May revert to Draft)\n\n    EventBus--)Comms: RefundCompleted event\n    Comms--)CredAdmin: Email: Refund processed notification\n    Comms--)User: Email: Refund confirmation to applicant\n\n    Payments-->>UI: 200 OK (success message)\n    UI-->>CredAdmin: Display: \"Refund processed: REFUND-123\"\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "CEPAS API failure -> RefundRequest marked Failed, admin alerted for retry. Amount exceeds original -> Validation error before CEPAS API call." ;
	<urn:solutiondesign:ontology:eventsPublished> "RefundCompleted - Fires after CEPAS confirms refund processed." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Auto-approval threshold: Configurable; default $500. CEPAS API idempotency: Safe to retry on failure (same confirmation number). Atomic update: Transaction status only changes after CEPAS confirms." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Refund Request Processing (Single Approval ≤$500)" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Credential Admin requests refund for paid transaction; auto-approved if <=$500, processed via CEPAS API. When: Applicant withdraws application or refund needed for other reason. Who: Credential Administrator." .

<urn:solutiondesign:instance:payments:SequencesDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "sequences" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/payments/payments-sequences.md" .

<urn:solutiondesign:instance:payments:TP_CepasConfirmationProcessing> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:implementationNotes> "Endpoint is unauthenticated (external-public, no MiLogin token) — CEPAS return redirects don't carry a MiLogin session, so tamper detection relies solely on SHA-1 hash validation, per payments-api.yml's /payments/confirm description. Target processing time <2 seconds (hash validation + DB update + event publish)." ;
	<urn:solutiondesign:ontology:steps> "1. CEPAS redirects the user's browser to GET /payments/confirm with query parameters (c, m, o, t, d, z, i, ct, hash). 2. Compute expected_hash = SHA-1(confirmation_number + amount + security_key). 3. Compare to the received hash; reject and raise a security alert on mismatch. 4. Map CEPAS return code: 0 -> update to Paid, publish PaymentCompleted; 1-999 -> update to Failed with stored error message, publish PaymentFailed; missing code -> Failed, alert admin. 5. Idempotency: a duplicate confirmation (already processed) is logged and returns success without reprocessing." .

<urn:solutiondesign:instance:payments:TP_CepasRedirectInitiation> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:implementationNotes> "Encryption failure: log error, display user-friendly message, do not redirect. CEPAS unavailable: circuit breaker (5-minute cooldown after 3 failures). Invalid key ID: alert admin, fall back to emergency CEPAS support contact. Target response time <1 second. See payments-technical-design.ttl's pay:TP_CircuitBreakerManagement and pay:Question_CircuitBreakerConfigDiscrepancy for a parameter discrepancy between this doc and payments-technical-design.md's own circuit-breaker table." ;
	<urn:solutiondesign:ontology:steps> "1. Client calls POST /payments/initiate. 2. Payments creates a PaymentTransaction (Pending), amount calculated from credential type. 3. Build plaintext payload (amount, ref, id, returnurl). 4. Encrypt with AES-256-GCM using a random 12-byte nonce and CEPAS-provided key ID + secret key; append 16-byte auth tag; Base64-encode as key_id|nonce+ciphertext+tag. 5. Return CEPAS redirect URL (payload capped at 2048 chars; reference data truncated if needed) for the client to redirect the user's browser to." .

<urn:solutiondesign:instance:payments:TP_CepasRefundApiCall> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:CapabilityDoc> ;
	<urn:solutiondesign:ontology:implementationNotes> "Idempotent on ConfirmationNumber. Circuit breaker opens after 5 failures (10-minute cooldown). Refunds processed only during CEPAS business hours (8 AM-5 PM EST); after-hours requests queue for next business day. Refund API rate limit 100 requests/minute — bulk refunds >100 items need queuing. See payments-technical-design.ttl's pay:TP_CircuitBreakerManagement and pay:Question_CircuitBreakerConfigDiscrepancy: payments-technical-design.md's own circuit-breaker table states a single 3-failure/5-minute configuration applying to 'both the payment redirect health check and the refund API', which conflicts with this doc's 5-failure/10-minute figure for the refund API specifically. Flagged as a genuine source-doc discrepancy, not resolved here." ;
	<urn:solutiondesign:ontology:steps> "1. Validate refund amount <= remaining refundable amount before calling CEPAS. 2. POST https://epay.michigan.gov/api/v1/payment/cancel with ApplicationID/PaymentChannel/SecurityKey headers and {ConfirmationNumber, RefundAmount} body. 3. On success, record RefundConfirmationNumber/ProcessedDate and update PaymentTransaction to Refunded/PartiallyRefunded. 4. On 4xx, log and mark refund Failed, notify admin. On 5xx, retry with exponential backoff (max 3 attempts: 1m/2m/4m). On timeout (>30s), retry once then mark Failed for manual intervention." .

<urn:solutiondesign:instance:payments:TP_CircuitBreakerManagement> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:implementationNotes> "payments-technical-design.md states this single configuration 'applies to both the payment redirect health check and the refund API,' and that alerts fire when the circuit opens. See pay:Question_CircuitBreakerConfigDiscrepancy below: this conflicts with payments-capability.md's own Integration Patterns section, which gives the refund API a DIFFERENT circuit breaker (opens after 5 failures, 10-minute cooldown — see pay:TP_CepasRefundApiCall in payments-capability.ttl) distinct from the redirect health check's 3-failures/5-minute breaker (pay:TP_CepasRedirectInitiation, same file). Not resolved here — the two source documents disagree on whether there is one shared circuit breaker or two independently configured ones." ;
	<urn:solutiondesign:ontology:steps> "States: Closed (normal — all requests pass through to CEPAS), Open (failing — requests blocked immediately, user shown an availability error), Half-open (recovering — a single test request is allowed; success closes the circuit, failure re-opens it). Per payments-technical-design.md's own Circuit Breaker Configuration table: failure threshold 3 consecutive failures, health-check timeout 5 seconds, cooldown period 5 minutes, 1 half-open test request." .

<urn:solutiondesign:instance:payments:TP_ConcurrencyControl> a <urn:solutiondesign:ontology:TechnicalProcess> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:implementationNotes> "Exists specifically to prevent lost updates when two processes race to confirm the same PaymentTransaction — e.g. a real-time /payments/confirm redirect racing the nightly posting-file reconciliation job for the same transaction. Applies to PaymentTransactions, RefundRequests, and ReconciliationDiscrepancies (all three carry a rowversion column per payments-capability.md's ERD)." ;
	<urn:solutiondesign:ontology:steps> "1. Every state-bearing update (payment confirmation, refund status change, reconciliation batch update) is issued as an UPDATE ... WHERE rowversion = @expectedVersion, using the row's own optimistic-concurrency rowversion column read at the start of the operation. 2. If zero rows are affected (another process modified the row first), the update is treated as a conflict, not silently accepted. 3. The application layer re-reads the row and retries with a fresh rowversion, using exponential backoff for transient concurrency failures." .

<urn:solutiondesign:instance:payments:TechnicalDesignDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "technical-design" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/payments/payments-technical-design.md" .

<urn:solutiondesign:instance:payments:UT_BulkPayment> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Single payment transaction covering fees for multiple credential applications (e.g., a district paying for 10 substitute credentials)." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Bulk Payment" .

<urn:solutiondesign:instance:payments:UT_CEPAS> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Centralized Electronic Payment Authorization System - State of Michigan Treasury's payment gateway for credit card and e-check transactions." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "CEPAS" .

<urn:solutiondesign:instance:payments:UT_HashValidation> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Security verification using SHA-1 hash of confirmation number, amount, and secret key to ensure payment data integrity." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Hash Validation" .

<urn:solutiondesign:instance:payments:UT_MissingPayment> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Transaction confirmed in the CEPAS posting file but not recorded in MiEdWorkforce during the real-time redirect flow." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Missing Payment" .

<urn:solutiondesign:instance:payments:UT_PaymentCommandCode> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Indicator in the posting file denoting transaction type: Payment (1), Refund (5), Void (6), Chargeback (9), Chargeback Reversal (10), Partial Refund (14), ACH Credit (15), or Processor Void (16). Only Payment and Refund are actively reconciled today; all other codes land in Discrepancy for manual review, pending explicit handling." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Payment Command Code" .

<urn:solutiondesign:instance:payments:UT_PaymentTransaction> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A financial transaction record tracking fee collection for a credential application, including amount, status, confirmation numbers, and audit trail." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Payment Transaction" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:payments:PaymentTransactionAggregate> .

<urn:solutiondesign:instance:payments:UT_PostingFile> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Daily batch file from CEPAS containing previous day's confirmed transactions for reconciliation purposes." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Posting File" .

<urn:solutiondesign:instance:payments:UT_Reconciliation> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Process of matching CEPAS posting file records to internal MiEdWorkforce payment transactions to identify discrepancies." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Reconciliation" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:payments:ReconciliationBatchAggregate> .

<urn:solutiondesign:instance:payments:UT_Refund> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Return of payment to original payer, processed via CEPAS CancelPayment API, resulting in a new confirmation number." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Refund" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:payments:RefundRequestAggregate> .

<urn:solutiondesign:instance:payments:WireframeApplicationPaymentTab> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a 'Career Authorization Application: 292871' detail page (Details/Payment/Documents tabs, Payment tab active, status badge 'Awaiting Payment'), showing the exact CEPAS static-text notice quoted in comment 21 ('Michigan Department of Education uses the CEPAS Credit Card Processing Payment Module to provide a secure payment method. This will open a new window. Payments status is provided after the payment is processed.') and a 'Pay Application Fee' button — directly corroborates 7.1.1's 'Pay Fee link on the pending certification/application status page' and 7.1.2's static pre-redirect text." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-08-application-payment-tab-cepas-notice.jpg" .

<urn:solutiondesign:instance:payments:WireframeApplicationSubmittedPayLater> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Application Submitted!' confirmation with 'Continue to Payment' (primary) and 'Pay Later' (secondary/text link) actions — directly corroborates 7.1.1's 'Pay Fee link displayed immediately on the application confirmation page' AND its 'if the fee is not paid immediately, the application status is Pending Payment but remains submitted' criterion in one screen." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-07-application-submitted-continue-to-payment.jpg" .

<urn:solutiondesign:instance:payments:WireframeBulkPaymentAndRefund> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Screenshot 6'. A 'Bulk payment and refund' screen scoped to one district ('Holt public school district'), with Temporary credential/Select type/Status filter dropdowns, a checkbox table (Unique Id/Name/Type/Fee/Status), Total amount/Total selected, and a Pay fee button — directly corroborates 7.3.1/7.3.2's filter dropdowns (also described in the Business Specifications' own 'dropdown boxes... Temporary Credential, Select Type, Status' bullet, which is actually about the AUDIT tables, not this payment screen — see pay:Question_AuditFilterDropdownsVsBulkPaymentScreen) and the per-application fee/status/select-multiple shape. Notably titled 'Bulk payment AND REFUND' even though no numbered Addendum story covers bulk refund selection by an end user (only pay:Op_RequestBulkRefund's own Credential-Admin-initiated API flow) — consistent with pay:Question_AddendumOmitsRefundFeature below." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-05-bulk-payment-and-refund-screen.png" .

<urn:solutiondesign:instance:payments:WireframeCepasModalPlaceholder> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the same Payment tab with an empty 'Placeholder for CEPAS Payment' modal overlaid — an explicit wireframe placeholder standing in for CEPAS's own off-platform payment UI (comment 23/36: 'Placeholder to indicate the step in this process where CEPAS will handle the payment process, outside of MiEdWorkforce'). Worth flagging that this renders as an IN-PAGE MODAL rather than a full off-site redirect/new-window — a minor visual discrepancy against 7.1.2's 'navigates the system user AWAY from MiEdWorkforce' and 8's own text ('This will open a new window'), likely just wireframe shorthand for the same redirect rather than a real modal design intent, not raised as a separate Annotation given how clearly it reads as a placeholder." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-09-placeholder-cepas-payment-modal.jpg" .

<urn:solutiondesign:instance:payments:WireframeDataFlowElements> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Screenshot 1' per the document's own caption. A data-flow box diagram (not a UI mockup): Inbound Payment Request (MiEdWorkforce Payment Review screen -> API -> CEPAS, carrying Type of License/Application Reference Number/Payment Amount) and Outbound Payment Response (CEPAS -> API -> MiEdWorkforce Payment Review screen, carrying the full outbound element list). Directly corroborates the Business Specifications section's own inbound/outbound data-element tables and 7.1.3/7.1.4." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-01-payment-data-flow-elements.png" .

<urn:solutiondesign:instance:payments:WireframeLegacyMoecs> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: NOT a MiEdWorkforce mockup — a screenshot of the legacy MOECS system's own 'Payment Confirmation' page ('To download the certificate, you need to log on to MOECS System and click on the Print Certificate link'), embedded inline near the Business Specifications' CEPAS-success bullet list as reference material for the OLD system's equivalent screen, not a proposed new design. Caught only by viewing it (its filename/document-order position gave no hint of this)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-06-legacy-moecs-payment-confirmation.png" .

<urn:solutiondesign:instance:payments:WireframePaymentErrorDetail> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the same Payment tab showing a 'Payment Error' banner, status still 'Awaiting Payment', Pay Application Fee button still present (retry available) — directly corroborates 7.1.2's 'status remains in Awaiting Payment' on CEPAS error and pay:Seq_IndividualPaymentFailed's retry affordance. Note this specific wireframe is generic (redacted body text) and doesn't visually distinguish a CEPAS-DOWN error (7.1.5) from a card-declined error (7.1.2/pay:PayState_Failed) — both would plausibly render this same panel; not investigated further as the acceptance-criteria text for each is otherwise clear and non-conflicting." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-11-payment-error-detail.jpg" .

<urn:solutiondesign:instance:payments:WireframePaymentFlowSequence> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Screenshot 2'. An UML-style sequence diagram (Users -> MiEdWorkforce UI -> CEPAS) showing: click Pay -> UI requests encrypted URL from an 'Encryption endpoint' -> UI sends user to CEPAS URL -> user pays at CEPAS -> CEPAS returns success message with HASH -> UI requests a HASH check from a 'Hash-check endpoint' -> UI displays Success/Error message. This is a close match to pay:Seq_IndividualPaymentHappyPath's own mermaid content, down to the encrypt/hash-check endpoint split, and is itself evidence AGAINST comment 8's 'no message displayed' claim — see pay:Question_PaymentResultMessagingContradiction." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-02-payment-flow-sequence-cepas.png" .

<urn:solutiondesign:instance:payments:WireframePaymentReviewSummary> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Screenshot 3'. A 'Payment review' screen (Daily Substitute Permit fee, $45.00, payer name) with the CEPAS static-text notice ('Michigan Department of Education uses the CEPAS Credit Card Processing Payment Module...') and Previous/Next navigation — directly corroborates 7.1.2's required pre-redirect static text (comment 18-21 thread)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-03-payment-review-summary.png" .

<urn:solutiondesign:instance:payments:WireframePaymentSuccessfulDetail> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the same application detail page, Payment tab, now showing 'Pending Review' status and a 'Payment successful' panel with Amount paid $45.00, Item/For, Payment Date/Time, and Payment Confirmation # — directly corroborates 7.1.4's stored/displayed confirmation data and the status advancing past 'Awaiting Payment' once paid." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-10-payment-successful-detail.png" .

<urn:solutiondesign:instance:payments:WireframePaymentSuccessfulScreenshot5> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Screenshot 5' (the document's own numbering skips 'Screenshot 4' entirely — not investigated further, too minor). A MiEdWorkforce-branded 'Payment successful' confirmation screen (checkmark, Amount paid $45.00, Payment details, confirmation-email notice, Back to home/Start a new credential application buttons) — direct, explicit evidence that MiEdWorkforce DOES render its own success page, corroborating 7.1.2/7.1.4 and contradicting comment 8's 'no message displayed' claim (see pay:Question_PaymentResultMessagingContradiction)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-04-payment-successful-screenshot5.png" .

<urn:solutiondesign:instance:payments:WireframeUnpaidFeesBulkError> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the same list with a 'Payment Error' banner, selection/total PRESERVED (10 selected, $450.00) rather than reset — directly corroborates 7.3.2's error-path criterion, and usefully shows the error path preserves the user's selection (retry-friendly) where the success path clears it — a UX detail not stated in the FDD text itself, not modeled as a gap since it's additive detail, not a contradiction." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-16-unpaid-application-fees-bulk-error.jpg" .

<urn:solutiondesign:instance:payments:WireframeUnpaidFeesBulkSuccess> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the Unpaid Application Fees list with a 'Payment Successful' banner overlaid, selection reset to 0 — directly corroborates 7.3.2's 'upon confirmation of payment success, user navigated back to MiEdWorkforce webpage' criterion." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-15-unpaid-application-fees-bulk-success.jpg" .

<urn:solutiondesign:instance:payments:WireframeUnpaidFeesEmpty> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Unpaid Application Fees' screen, empty results ('No Unpaid Applications... Try expanding your search criteria'), Selected 0 / Payment Amount $0.00 footer — directly corroborates 7.3.2's 'No Unpaid Applications' message criterion, though the wireframe's own copy differs slightly from the FDD text's exact wording ('No Unpaid Applications' heading vs. the FDD's quoted 'No Unpaid Applications.' message) — near enough not to flag as a discrepancy." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-13-unpaid-application-fees-empty-state.jpg" .

<urn:solutiondesign:instance:payments:WireframeUnpaidFeesNav> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the main left-nav menu ('Welcome back, Connie') with 'Unpaid Application Fees' as a Credential Management sub-item alongside Permits/Renew Daily Substitutes/Career Authorizations/Special Education Approvals — establishes where 7.3.2's bulk-payment entry point lives in the actual information architecture (a menu item, not the district-scoped 'Bulk payment and refund' screen in wireframe-05, which is unlabeled navigation-wise — see pay:Question_AuditFilterDropdownsVsBulkPaymentScreen for the broader inconsistency between the two bulk-payment mockups)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-12-unpaid-application-fees-nav.jpg" .

<urn:solutiondesign:instance:payments:WireframeUnpaidFeesSelectedTotal> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:payments:Fdd07Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the same screen with a redacted Application #/Type/Amount/Status/Submitted table, 4 (then, per the footer, effectively 10 across pagination) rows checked, footer 'Selected: 10, Payment Amount: $450.00', 'Pay Application Fees' button — directly corroborates 7.3.2's select-multiple, single-total-fee-calculation, and single Pay Fee action criteria." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/07-credit-card-payments-and-refunds/wireframes/wireframe-14-unpaid-application-fees-selected-total.jpg" .

