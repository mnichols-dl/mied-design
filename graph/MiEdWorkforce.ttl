	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Upload Employee Roster' modal, drag-and-drop, 1MB max, .doc/.docx/.pdf only (NOTE: file types listed here are document formats, not the tabular/CSV-like schema Req_24_4_1's 'validate against the schema' AC implies — an internal inconsistency in the source design, not resolved here)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/24-request-for-id-collection/wireframes/wireframe-11-upload-employee-roster-modal.png" .

