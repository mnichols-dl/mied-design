<urn:solutiondesign:instance:epp:ApiDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "api-spec" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/epp/epp-api.yml" .

<urn:solutiondesign:instance:epp:ApiSpec> a <urn:solutiondesign:ontology:ApiSpec> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:ApiDoc> ;
	<urn:solutiondesign:ontology:version> "1.0.0" .

<urn:solutiondesign:instance:epp:ApplicationAcknowledgements> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Applicant attestations specific to the approval category." ;
	<urn:solutiondesign:ontology:name> "ApplicationAcknowledgements" .

