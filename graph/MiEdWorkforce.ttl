	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Citizens can add/remove; districts can add, cannot remove citizen-added. Same API-surface gap as staffing.education-history.view." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.education-history.update" .

<urn:solutiondesign:instance:staffing:Perm_EducationHistoryView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View education history for employee" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EducationHistory> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "District users see for their employees; citizens see own. No sd:ApiOperation exists for Education History anywhere in staffing-api.yml, despite staffing-domain.md's EducationHistory entity and its own dedicated invariants — a documented gap, not modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.education-history.view" .

<urn:solutiondesign:instance:staffing:Perm_EmployeeRosterAddEmployee> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Add a new employee to a district's employee roster." ;
	<urn:solutiondesign:ontology:description> "Add new employee to roster via online entry" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EmployeeRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Stub — see staffing-permissions.md (converted separately in this same batch, may not match exactly). Referenced here because iam-api.yml's selfResolveIdentityRequest and escalateIdentityRequest operations gate on this Staffing permission for NewId-type identity resolution requests." ;
	<urn:solutiondesign:ontology:notes> "Triggers Unique ID matching workflow with Mi-Key (via IAM)." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.employee-roster.add-employee" .

<urn:solutiondesign:instance:staffing:Perm_EmployeeRosterBulkUpload> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Upload bulk file to update employee data" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EmployeeRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Must include valid Unique IDs; cannot create new employees via bulk (confirmed by staffing-domain.md's resolved Open Question #3, citing FDD 15.5). No matching bulk-upload endpoint exists anywhere in staffing-api.yml — left with no PermissionRequirement, an intentional, documented gap; the bulk/file-upload pipeline implied by staffing.admin.view-file-queues / staffing.admin.reset-file-processing is likewise entirely absent from the API surface." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.employee-roster.bulk-upload" .

<urn:solutiondesign:instance:staffing:Perm_EmployeeRosterCertify> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Certify employee roster collection for entity" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EmployeeRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Requires all pre-certification tasks complete." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.employee-roster.certify" .

<urn:solutiondesign:instance:staffing:Perm_EmployeeRosterUpdateDemographics> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Request demographic update via Mi-Key" ;
	<urn:solutiondesign:ontology:description> "Update demographic data on an existing employee roster record." ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EmployeeRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Stub — see staffing-permissions.md (converted separately in this same batch, may not match exactly). Referenced here because iam-api.yml's selfResolveIdentityRequest operation gates on this Staffing permission for DemographicUpdate-type identity resolution requests." ;
	<urn:solutiondesign:ontology:notes> "Triggers Mi-Key update workflow via IAM." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.employee-roster.update-demographics" .

<urn:solutiondesign:instance:staffing:Perm_EmployeeRosterUpdateEmployment> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Update employment status, dates, separation reason" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EmployeeRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Allows termination and status changes." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.employee-roster.update-employment" .

<urn:solutiondesign:instance:staffing:Perm_EmployeeRosterView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View employee roster for entity" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EmployeeRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Required to see list of employees for school/district." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.employee-roster.view" .

<urn:solutiondesign:instance:staffing:Perm_EvaluationOutcomeAppeal> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Appeal evaluation outcome" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EvaluationOutcome> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "District can appeal within 5-year window; citizen can appeal any (per staff:Rule_EvaluationOutcomeAppealWindow). Same API-surface gap as staffing.evaluation-outcome.view." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.evaluation-outcome.appeal" .

<urn:solutiondesign:instance:staffing:Perm_EvaluationOutcomeApproveAppeal> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Approve or deny citizen appeal request" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EvaluationOutcome> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "District reviews and approves/denies citizen appeals. Same API-surface gap as staffing.evaluation-outcome.view." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.evaluation-outcome.approve-appeal" .

<urn:solutiondesign:instance:staffing:Perm_EvaluationOutcomeSubmit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit evaluation outcome for employee" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EvaluationOutcome> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "District submits for instructional staff/administrators. Same API-surface gap as staffing.evaluation-outcome.view." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.evaluation-outcome.submit" .

<urn:solutiondesign:instance:staffing:Perm_EvaluationOutcomeView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View evaluation outcomes for employee" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_EvaluationOutcome> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "District users see for their employees; citizens see own. No sd:ApiOperation exists for Evaluation Outcome anywhere in staffing-api.yml, despite the EvaluationOutcome entity and its own 'Evaluation Outcome Appeal Window' business rule — a documented gap, not modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.evaluation-outcome.view" .

<urn:solutiondesign:instance:staffing:Perm_NewTeacherMonitoringUpdate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Update new teacher monitoring data" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_NewTeacherMonitoring> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Assign mentor, link SCECH sessions for DPPD requirement. Same API-surface gap as staffing.new-teacher-monitoring.view — even the NewTeacherMentorAssigned domain event has no corresponding API operation shown creating it." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.new-teacher-monitoring.update" .

<urn:solutiondesign:instance:staffing:Perm_NewTeacherMonitoringView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View new teacher monitoring data" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_NewTeacherMonitoring> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Required to see mentor assignments and SCECH tracking. No sd:ApiOperation exists for New Teacher Monitoring anywhere in staffing-api.yml, despite staffing-domain.md's dedicated NewTeacherMonitoring entity, ERD table, and staff:Rule_NewTeacherMonitoringRequirement business rule — a documented gap, not modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.new-teacher-monitoring.view" .

<urn:solutiondesign:instance:staffing:Perm_PositionRosterCertify> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Certify position roster collection for entity" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_PositionRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Requires all pre-certification tasks complete." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.position-roster.certify" .

<urn:solutiondesign:instance:staffing:Perm_PositionRosterCreate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Create new position in roster" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_PositionRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Only allowed during working window or open collection." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.position-roster.create" .

<urn:solutiondesign:instance:staffing:Perm_PositionRosterDelete> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Delete position during working window" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_PositionRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Only allowed before position is established/certified. (The underlying operation, cancelPosition, sets status to Cancelled rather than physically deleting — see staffing-api.ttl.)" ;
	<urn:solutiondesign:ontology:permissionId> "staffing.position-roster.delete" .

<urn:solutiondesign:instance:staffing:Perm_PositionRosterUpdate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Update position details, status, approved FTE" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_PositionRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Includes status changes (Filled, Frozen, Cancelled, etc.)." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.position-roster.update" .

<urn:solutiondesign:instance:staffing:Perm_PositionRosterView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View position roster and organizational chart" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_PositionRoster> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:notes> "Required to see positions for school/district." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.position-roster.view" .

<urn:solutiondesign:instance:staffing:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "permissions" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/staffing/staffing-permissions.md" .

<urn:solutiondesign:instance:staffing:PosRosterState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:staffing:PosRosterState_Approved> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Approved" .

<urn:solutiondesign:instance:staffing:PosRosterState_Cancelled> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Cancelled" .

<urn:solutiondesign:instance:staffing:PosRosterState_Filled> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Filled" .

<urn:solutiondesign:instance:staffing:PosRosterState_Frozen> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Frozen" .

<urn:solutiondesign:instance:staffing:PosRosterState_Pending> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Pending" .

<urn:solutiondesign:instance:staffing:Position> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Job position with identifier, title, type, status, approved FTE." ;
	<urn:solutiondesign:ontology:name> "Position" .

<urn:solutiondesign:instance:staffing:PositionCreatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Not in staffing-domain.md's Domain Events table or the ERD's event-type enums; only appears in the 'Create New Position' sequence ('Triggers dashboard updates, notifications if configured'). Consumers not documented anywhere, so none are asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "positionId, positionIdentifier, entityCode, educationJobType" ;
	<urn:solutiondesign:ontology:trigger> "District creates a new position in the roster" .

<urn:solutiondesign:instance:staffing:PositionRosterAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Defines the organizational structure of approved positions within an entity for a school year, tracking position lifecycle and FTE allocation." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:PositionCreatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:PositionStatusChangedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:Position> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:Spot> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:PosRosterState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:PosRosterState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:PosRosterState_Cancelled> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:PosRosterState_Filled> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:PosRosterState_Frozen> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:PosRosterState_Pending> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:EducationJobType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:LocalJobCategory> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:LocalJobFunction> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:PositionStatus> ;
	<urn:solutiondesign:ontology:invariants> "Position status Filled requires employee assignment. Position status Approved requires expected start date in future, no employee assignment. Position status Active/Frozen/Cancelled prohibits active employee assignment after effective date. Cancelled position requires cancellation reason. Sum of spot FTE should equal approved FTE for position (health indicator, not blocking). Approved FTE must be greater than zero. Position cannot be deleted after establishment (working window only); use Cancelled status instead." ;
	<urn:solutiondesign:ontology:rootEntity> "PositionRoster" .

<urn:solutiondesign:instance:staffing:PositionStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Filled, Approved, Active, Frozen, or Cancelled." ;
	<urn:solutiondesign:ontology:name> "PositionStatus" .

<urn:solutiondesign:instance:staffing:PositionStatusChangedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Not in staffing-domain.md's Domain Events table; only appears in the 'Update Position Status' sequence ('Triggers notifications if employee assignment ended'). Consumers not documented anywhere, so none are asserted." ;
	<urn:solutiondesign:ontology:payloadHighlights> "positionId, oldStatus, newStatus, statusDate" ;
	<urn:solutiondesign:ontology:trigger> "Position status transitioned (e.g., Active to Frozen, Active to Cancelled)" .

<urn:solutiondesign:instance:staffing:QualityReviewResult> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Validation errors, warnings, and justification-required conditions from a quality-review run." ;
	<urn:solutiondesign:ontology:name> "QualityReviewResult" .

<urn:solutiondesign:instance:staffing:Question_AddendumOmitsBizSpecFeatures> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Three real capabilities described at length in the Business Specifications prose, each with its own HLS table row (12, 13, 23) and full bullet list of admin behaviors, were never assigned an Addendum feature number at all (the Addendum jumps from Feature 10.1 straight through 10.16 with no slot for the Employment Data Collection Worklist, Data Quality Review & Processing admin, or the Staffing Data Admin's own request-processing Worklist). Same discrepancy shape the FDD 29 pass found and named for its own document (Question_AddendumOmitsThreeBizSpecFeatures there) — apparently a recurring pattern across this FDD suite's Addendum-drafting process, not a one-off. Modeled here as staff:Req_10_BizSpec_EmploymentCollectionWorklist (genuine gap), staff:Req_10_BizSpec_DataQualityAdmin (out-of-scope, deferred to FDD 19/20), and staff:Req_10_BizSpec_AdminWorklist (satisfied) — three different resolutions for three items that share the same drafting omission." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_BizSpec_AdminWorklist> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_BizSpec_DataQualityAdmin> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_BizSpec_EmploymentCollectionWorklist> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_AdminStoriesStillUnderInternalDiscussion> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Every numbered story in Features 10.3 and 10.8 through 10.15 except 10.14 (10.3.1, 10.8.1, 10.8.2, 10.9.1, 10.10.1, 10.11.1, 10.12.1, 10.13.1, 10.13.2, 10.15.1 — 10 stories) carries an identical reviewer comment from Sinha (DTMB-Contractor, Feb 2026): 'This is a high-level user story. We are having internal discussions around it. It will be detailed and finalized once we have more knowledge on the implementation.' Deduped into one Annotation per CONVENTIONS.md's repeated-comment guidance — the pattern itself is the finding: essentially every admin-configuration-surface story in this FDD (data elements, collections, categories, identity admin, business rules, closeout) is self-acknowledged by the FDD's own authors as not yet detailed enough to build from, independently corroborating why staffing-api.yml has no matching endpoints for any of staff:Perm_AdminManageCollections/AdminManageValidations/AdminManageDataElements/AdminViewFileQueues/AdminResetFileProcessing/AdminManageReports (only staff:Perm_AdminProcessExceptions, covering the one Feature — the Admin's own extension/reopen Worklist — that ISN'T on this list, does)." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_10_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_11_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_12_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_13_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_13_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_15_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_3_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_8_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_8_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_9_1> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_AnomalyDetectionBaselineAndThreshold> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What baseline and threshold apply to the trend/anomaly-detection style Data Quality checks (e.g., 'changes in Assignment counts by more than X%,' 'staff assigned to a facility a significant distance from the district')? FDD 10's source spreadsheet doesn't define X% or 'significant distance.'" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Product" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_AuditFindingsPersistenceOnReopen> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What happens to audit findings and audit work items when a collection is reopened via a Collection Exception — do previous results persist or reset? Neither AuditWorkItemAggregate's invariants nor CollectionExceptionAggregate's describe this interaction. staffing-domain.md's Open Question #7, verbatim." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:AuditWorkItemAggregate> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:CollectionExceptionAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_CedsDataDefinitionAutoGenerationGap> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "No capability exists anywhere in staffing-domain.ttl, staffing-api.ttl, or documents-api.ttl to auto-generate a data-definition document (type/length/format/schema/sample-file) from a data element's CEDS-aligned metadata. Depends on a Data Element admin surface (staff:Perm_AdminManageDataElements, Req_10_8_1) that is itself a documented gap — a second-order gap layered on a first-order one." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_2_3> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_CollectionExceptionCriteria> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What are the approval and denial criteria for Collection Exception requests, and what notifications are triggered at each step? staff:Perm_AdminProcessExceptions and the Request Collection Exception sequence describe the workflow shape (Staffing Data Admin reviews, approves with dates or denies with reason) but not the actual approval/denial criteria a Staffing Data Admin applies — staffing-domain.md's Open Question #2, verbatim." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:CollectionExceptionAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_CrossRecordValidationEvaluationModel> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "How are cross-record/collection-level validations (e.g., 'all open districts must report active staff,' 'if building has CTE in EEM, CTE assignments should be reported') evaluated — as part of the same per-record quality-review pass, or a separate collection-level pass? These require EEM program-flag lookups not currently modeled anywhere in staffing-domain.md." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Engineering" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_DataHubFlowDirectionDisputed> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Live, unresolved reviewer disagreement on 8.4.1's own framing: Punniyamoorthy (2025-11-21) questioned the story entirely -- 'Isn't the flow of data... School District -> to send staffing data via CEPI Public Service to MiDH -> then MiDH to MiEd? if so this story is not needed' -- i.e. challenging whether MiEdWorkforce sending TO the DataHub is even the right direction, versus receiving FROM it. Dailey (2025-11-24) replied that MiDataHub actually wants BOTH: 'There is a desire by the Michigan Data Hub to receive staff credential data for their employees from MiEdWorkforce. They don't always have that data in the data hub, because it usually isn't in their SIS' -- then (2025-11-25) suggested a call to narrow down 'specific use cases for the data exchange in both directions,' which per this document's own text never happened (no further resolution recorded, and 8.4.5's own not-yet-existing ReceiveFromHub method is still explicitly TBD). Whether 8.4.1 (outbound SendToHub) is even the correct primary use case, versus 8.4.5 (inbound, not yet built) being the actual priority, is unresolved as of this pass." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_5> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_DataHubMiKeyOwnershipUnconfirmed> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "The Data Hub IDD's own HIGH LEVEL SCENARIOS table (use case 1 -- Ed-Fi Identities API staff-unique-ID lookup) carries a still-open reviewer comment: 'Need to identify if this is in Mi-Key or in MiEdWorkforce as a passthru - per Michael Nichols' (Dailey, 2026-01-13). This is an unresolved architectural boundary question -- whether the person-matching step for this integration is Mi-Key's own responsibility (ext:MiKeySystem, already canonically declared in iam-domain.ttl) or a MiEdWorkforce-side passthrough -- left unanswered anywhere in this document or in iam-domain.ttl/staffing-domain.ttl." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_1> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_EducationHistoryTriggersRevalidation> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "When a citizen updates their Education History, does this trigger re-validation of appropriate placement for existing assignments (e.g. Rule_EndorsementAlignmentForTeaching, or the Education History pre-certification requirement for Teacher/Administrator/Special Education Paraprofessional/Temporary-Credential positions)? staffing-domain.md's Open Question #5, verbatim — no sequence or invariant describes this interaction either way." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:EducationHistory> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_EmploymentAssignmentVerificationEndpoint> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Confirmed from staffing's own source docs: credentialing-sequences.md's 'Submit Permit Application' sequence calls 'Staffing: Verify employment assignment (if required)' with no corresponding endpoint anywhere in staffing-api.yml. The closest shape in the actual spec is GET /employee-roster/search (staff:Op_SearchEmployees) — an org-scoped, permission-gated (staffing.employee-roster.view) search endpoint, not built as a single-lookup employment-assignment verification call, and it returns employee/demographic search results, not an assignment-verification determination. No FDD source describes an 'employment assignment verification' requirement on staffing's side at all, so it is also unconfirmed whether this is a real requirement rather than a credentialing-side assumption. See cred:Question_StaffingMentorVerificationEndpoint (credentialing-technical-design.ttl, part (b)) for the identical finding from credentialing's side." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Op_SearchEmployees> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:owner> "Engineering (credentialing + staffing)" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_Feature103HeadingBodyMismatch> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Feature 10.3 is titled 'Manage System Alerts/Notifications' (identical to Feature 10.4's own heading) but its single story, 10.3.1, is a business-rule/validation-management story with no connection to alerts or notifications — it is instead a near-verbatim duplicate of Feature 10.13's 'Business Rule Management' stories (10.13.1/10.13.2). Reads as a copy/paste error in the source document (Feature 10.4's heading text applied to Feature 10.3's slot) rather than an intentional third home for business-rule content. Modeled as its own Requirement (Req_10_3_1) per the FDD's literal numbering rather than silently merged into Req_10_13_1, since a coverage audit citing '10.3.1' should be able to find it." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_3_1> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_IdentityAdminConfigOwnershipAndGap> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Feature 10.12 places 'Identity Management Admin Role Worklist' and identity-processing business-rule/alert configuration under the STAFFING Data Admin's own page, but staffing-domain.ttl's own notes say Unique ID matching, Near Match handling, and the Identity Administrator worklist belong entirely to iam, not staffing (staffing only triggers resolution and consumes completion events). Neither domain's real, converted API surface (staffing-api.ttl or iam-api.ttl) exposes an admin-configuration capability for any of this — it's missing regardless of which domain is meant to own it, and the FDD itself doesn't resolve which one should. Distinct from, but adjacent to, staff:Question_MentorVerificationEndpointDirection and staff:Question_EmploymentAssignmentVerificationEndpoint (staffing-domain.ttl), which flag the analogous staffing<->credentialing ownership ambiguity for a different capability." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_12_1> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Product (staffing + iam)" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_LegacyValidationPortVsRederive> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Should the ~100+ rows in 'Staffing Submission Validations.xlsx' (particularly the legacy 'REP BRs' sheet, keyed to a MORE fixed-width field-position layout) be ported 1:1 into the new validation engine, or re-derived from the CEDS-aligned data-element model FDD 10 Feature 10.8 describes? A 1:1 port perpetuates legacy field-position framing that has no meaning in MiEdWorkforce's own data model." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:owner> "Product / Engineering" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_MentorVerificationEndpointDirection> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Confirmed from staffing's own source docs: credentialing-domain.md's 'Mentor Assignment Requirement for Permits' rule calls GET /educators/{uniqueId} on the Staffing API expecting to 'verify educator exists and holds valid, relevant credential.' staffing-api.yml has no such endpoint — its closest equivalent, GET /educators/search (staff:Op_SearchEducators), is a paginated name/Unique-ID lookup returning only a free-text, nullable activeCredentialSummary string ('Brief description of active credentials (for mentor validation)'), not a structured valid/invalid determination against a specific credential type. More fundamentally, credential validity is not staffing-owned data in the first place: staffing-domain.md's own Upstream Dependencies table has Staffing calling Credentialing (GET /educators/{educatorId}/credentials) for exactly this purpose — the reverse of what credentialing's rule assumes. Both halves of this characterization hold up against staffing's actual source text (verified directly against staffing-api.yml lines ~1606-1620 and staffing-domain.md's Dependencies table). See cred:Question_StaffingMentorVerificationEndpoint (credentialing-technical-design.ttl, once credentialing is converted into mied-v3) for the identical finding from credentialing's side, and staffing-domain.md Open Technical Question reference credentialing-technical-design.md #8." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Op_SearchEducators> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:owner> "Engineering (credentialing + staffing)" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_MultiDistrictEmployment> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "How does the system handle employees who work for multiple districts simultaneously? staffing-domain.md's own EmployeeRoster model assumes a single employer per record (one entity_code per employee_record_id) — this is staffing-domain.md's Open Question #1, verbatim." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_MultipleSpotsPerEmployee> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "For positions with multiple spots, can a single employee fill more than one spot within the same position? staffing-domain.md's Open Question #8, verbatim — neither the Position/Spot invariants nor the Assignment invariants say either way." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Spot> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_NewTeacherPriorExperienceSource> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "How is 'years of prior teaching experience' determined for the New Teacher flag — sourced from historical assignment data or manually entered? staffing-domain.md's Open Question #6, partially informed (2026-08-14) by confirmation that the flag reads a discrete CEDS data element, 'Years of Prior Teaching Experience' — but not resolving whether Staffing's own historical Assignment records populate that value, or the district submits it directly. This unconfirmed CEDS pointer is exactly the kind of thing sd:cedsAlignment would assert once confirmed; not asserted on staff:NewTeacherMonitoring in this pass because the source itself says the derivation, not just the alignment, is still open." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:NewTeacherMonitoring> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_NoBulkUploadSurfaceConfirmedAgain> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Feature 10.14's own dismissal text asserts that file/API upload functionality 'has been covered within the user stories associated with other Features in this Epic' — but the sibling FDD passes reviewed concurrently in this same wave (18-roster-of-positions, 21-roster-of-employees, 22-employee-assignment-details) each independently found the opposite: staffing-api.ttl has NO bulk-file-upload or batch-API ingestion sd:ApiOperation anywhere for ANY Staffing aggregate (Position, Employee, or Assignment) — every modeled operation across staffing-api.ttl is a single-record REST call, despite staffing-domain.md's own methods list and this FDD's own top-level Description both explicitly promising 'online submission, file extracts from local data systems, and API services.' Three independent FDDs (18, 21, 22) converging on the identical finding, now joined by this FDD's own Feature 10.14 text asserting coverage that doesn't exist, raises this from 'a gap in one document' to a confirmed, systemic absence across the whole Staffing bounded context — the same conclusion staff:Perm_EmployeeRosterBulkUpload's own pre-existing note in staffing-permissions.ttl already flagged in isolation ('No matching bulk-upload endpoint exists anywhere in staffing-api.yml'), now corroborated four times over from four different FDDs. Recommended for GAPS.md as a cross-cutting Staffing finding rather than a per-FDD note." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_14> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_SecureSiteDeliberatelyDeferred> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "All three Secure Site stories are explicitly self-scoped by the FDD's own text as NOT an active build: 8.8.2's own AC says the system 'does not implement or rely on' anything here, and 8.8.3's own AC says 'no operational interface is claimed as active until formally defined.' The whole sub-document is a deliberate placeholder confirming a design intent (don't build anything that would block a future Secure Site interface) rather than a specification of a system to build now. Treated as out-of-scope for this pass rather than a coverage gap -- there is nothing here to satisfy or to flag as missing; staffing's existing staff/assignment data model already carries no obvious blocker to a future interface, which is the only substantive claim any of these three stories makes." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_8_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_8_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_8_3> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_8SecureSiteDoc> ;
	<urn:solutiondesign:ontology:findingType> "out-of-scope" ;
	<urn:solutiondesign:ontology:status> "resolved" .

<urn:solutiondesign:instance:staffing:Question_StaffingExternalIntegrationsCoverageGap> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Data Hub, CTEIS, NexSys, and MSDS-TSDL are four real, named external-system integrations that all move staff/assignment/employment data by Unique ID or PIC, and staffing is their natural owning bounded context (staffing-domain.ttl already owns Position/Assignment/Employment) — but NONE of the four has any Dependency, Sequence, or ExternalSystem node anywhere in staffing-domain.ttl or staffing-sequences.ttl today. This is a real, substantive coverage gap on an EXISTING domain, not a 'no bounded context' situation, so ext:MiDataHubSystem/ext:CTEISSystem/ext:NexSysSystem/ext:MSDSTSDLSystem are minted in this fdd-review file (see the top of this file) for traceability, pending a future staffing-domain pass folding them in properly. Per 8.5's own IDD text ('these are the same set of service endpoint that will be used by many of the other integrations including MSDS/TSDL, MEGS+, NexSys and potentially others... based on the existing set of REP services'), the personnel-lookup capability CTEIS (8.5.2/8.5.3/8.5.4), NexSys (8.6.1/8.6.2), and MSDS-TSDL (8.7.1) each separately ask for is really ONE missing capability — a shared staff/personnel-directory read API exposed to multiple external consumers by district/PIC/Unique-ID/core-fields — not three or four independent gaps. Similarly, the repeated 'log all calls' / 'secure and environment-aware' boilerplate present in nearly every one of these stories (8.4.2-8.4.4, 8.5.5, 8.6.3-8.6.4, 8.7.3) is one recurring cross-cutting integration-hygiene pattern repeated per interface, not four/five independent findings. 8.4's own Michigan DataHub half additionally needs its own Dependency/Sequence for the SendToHub outbound flow and the not-yet-existing ReceiveFromHub inbound flow (see Question_DataHubFlowDirectionDisputed for a live dispute over whether/how the outbound half is even needed as currently framed) and CTEIS's own assignment-code reference-data method (8.5.6)." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_4> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_4_5> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_5_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_5_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_5_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_5_4> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_5_5> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_5_6> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_6_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_6_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_6_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_6_4> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_7_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_7_2> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_7_3> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_08_7_4> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_SupportMaterialsPreviewAndExportGap> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "'Preview documents prior to publishing them to end users' (stated identically in both 10.2.1 and 10.2.2) and 'download the [materials] list' as PDF/Word/Excel (10.2.1) have no matching capability anywhere in documents-api.ttl — Documents' real surface supports upload, replace (versioned), metadata retrieval, and search/list, but no draft/staged-vs-published distinction with a preview step, and no bulk table-export operation. None of the three viewed Add-New-File wireframes show a preview affordance either, so this isn't a case of the wireframe clarifying otherwise-ambiguous text." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_2_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:Req_10_2_2> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:Question_WarehousePipelineMechanics> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What are the mechanics of the CEPI CEDS Data Warehouse Synapse Pipeline — full extract vs. incremental, retry/failure handling, and what 'schedule some or all data closeout processing for a future date' means operationally (partial collection push)? FDD 10 explicitly defers these details." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:staffing:BatchJob_CollectionToWarehousePipeline> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:owner> "Engineering (staffing + reporting)" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:staffing:ReferenceImageLegacy> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a non-MiEdWorkforce, legacy MORE/WISEstaff-style 'Roadmap Progress' panel (Preliminary Steps / Preliminary Certification Process / Final Certification Process / After Certification Phase, with error/warning counts) embedded in the Business Specifications prose as an illustrative reference, not a MiEdWorkforce mockup. Matches the three review comments (Groom, Feb 2025) on this image and its two siblings (word/media/image2.png-image5.png, not individually re-extracted) explicitly stating 'This screenshot is for reference only and will need to be updated for Staffing and MiEd design' — i.e. these five images are acknowledged-stale legacy-system illustrations, not wireframes to build against. Kept for traceability only." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/10-staffing-admin/wireframes/reference-legacy-more-roadmap-progress.png" .

<urn:solutiondesign:instance:staffing:Req_08_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Constructs a SendToHub request (BatchId, FeedSystem, DistrictId, DataType, JsonData) for opted-in districts; sends via HTTP/HTTPS POST; excludes non-opted-in districts; logs each send with batch id, district, and outcome." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.4.1" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to send staffing-related data to the Michigan DataHub via CEPI Public Services so that opted-in districts can consume it." ;
	<urn:solutiondesign:ontology:title> "Send staffing data to the Michigan DataHub" .

<urn:solutiondesign:instance:staffing:Req_08_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Records HTTP 200 as sent successfully; flags HTTP 422 as invalid and logs the error; logs HTTP 500/unexpected errors and identifies the impacted batch; no partial/failed batch is silently treated as successful." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.4.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to handle SendToHub responses so that success and failure are clearly tracked." ;
	<urn:solutiondesign:ontology:title> "Handle Michigan DataHub SendToHub responses" .

<urn:solutiondesign:instance:staffing:Req_08_4_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Logs date/time, environment, district, DataType, and response status per SendToHub call; captures error details; follows MiEdWorkforce integration logging standards." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.4.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to log all Michigan DataHub interactions so that data sharing activity is auditable." ;
	<urn:solutiondesign:ontology:title> "Log all Michigan DataHub interactions" .

<urn:solutiondesign:instance:staffing:Req_08_4_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Supports bearer token or agreed authentication for CEPI Public Services/MiDH; credentials never exposed in logs or UI; all calls use the configured security mechanism." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.4.4" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support secure authentication to the DataHub-related services so that only authorized traffic is processed." ;
	<urn:solutiondesign:ontology:title> "Secure authentication to Michigan DataHub services" .

<urn:solutiondesign:instance:staffing:Req_08_4_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Accepts a JSON payload structurally consistent with the documented SendToHub format, for a future ReceiveFromHub implementation; validates and logs inbound messages; logs processing failures with troubleshooting detail; no hard-coded assumption blocks a similar inbound structure." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_4DataHubDoc> ;
	<urn:solutiondesign:ontology:notes> "The FDD's own text says this endpoint 'does not exist currently.' A review comment thread on this exact interface (Dailey, responding to Punniyamoorthy's challenge that the outbound-only framing might make 8.4.1 unnecessary) confirms the INBOUND direction is real and wanted: 'There is a desire by the Michigan Data Hub to receive staff credential data for their employees from MiEdWorkforce. They don't always have that data in the data hub, because it usually isn't in their SIS.' See Question_DataHubFlowDirectionDisputed below." ;
	<urn:solutiondesign:ontology:requirementId> "8.4.5" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to be able to receive data from the Michigan DataHub (via CEPI Public Services) in a compatible JSON format so that future inbound use cases can be supported." ;
	<urn:solutiondesign:ontology:title> "Receive data from the Michigan DataHub in a compatible JSON format" .

<urn:solutiondesign:instance:staffing:Req_08_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Makes staffing data available via the defined REST endpoints on request/schedule; includes required staff identity/assignment details per the IDD; only internal/authorized integrations can access the endpoints; logs each outbound interaction with district and outcome." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_5CteisDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.5.1" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to provide CTEIS with district-specific staffing roster data so that CTEIS can identify staff associated with CTE assignments." ;
	<urn:solutiondesign:ontology:title> "Provide CTEIS with district-specific staffing roster data" .

<urn:solutiondesign:instance:staffing:Req_08_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Returns personnel records for a valid district identifier via GetPersonnelByDistrict; returns an appropriate indication and logs the event if the district is invalid/not found; response structure matches the IDD's defined/sample format." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_5CteisDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.5.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support retrieval of personnel by district so that CTEIS can obtain full staff rosters." ;
	<urn:solutiondesign:ontology:title> "Support retrieval of personnel by district for CTEIS" .

<urn:solutiondesign:instance:staffing:Req_08_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Returns the corresponding personnel record for a valid PIC (or successor identifier) via GetPersonnelByPIC; indicates no-record-found without exposing unrelated individuals when no match exists; logs all such requests/responses for audit." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_5CteisDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.5.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support retrieval of personnel by PIC so that CTEIS can validate specific individuals." ;
	<urn:solutiondesign:ontology:title> "Support retrieval of personnel by PIC for CTEIS" .

<urn:solutiondesign:instance:staffing:Req_08_5_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Attempts to locate matching personnel for supported GetPersonnelByCoreFields fields; follows defined service rules when multiple matches are found; logs invalid/incomplete requests with reasons." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_5CteisDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.5.4" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support retrieval of personnel by core fields so that CTEIS can perform flexible identity validation." ;
	<urn:solutiondesign:ontology:title> "Support retrieval of personnel by core fields for CTEIS" .

<urn:solutiondesign:instance:staffing:Req_08_5_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Exposes methods only over HTTPS with authenticated access; endpoints configurable per environment (DEV/TEST/PROD); logs record which environment handled each request." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_5CteisDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.5.5" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want CTEIS interface calls to be secured and environment-aware so that data integrity is maintained." ;
	<urn:solutiondesign:ontology:title> "Secure and environment-aware CTEIS interface calls" .

<urn:solutiondesign:instance:staffing:Req_08_5_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Returns Result.AssignmentCodes on an authorized GET; each item includes Code, Description, ClosedDate (where applicable), and IsEdEffectivenessRequired; response includes a ReturnCode object; errors return an appropriate indication and are logged; all calls logged with timestamp, calling-system identifier, and response status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_5CteisDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.5.6" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to provide a complete list of available assignment codes via the GetCompleteAssignmentCodeList method so that consuming systems such as CTEIS can reliably reference valid assignment codes." ;
	<urn:solutiondesign:ontology:title> "Provide a complete list of assignment codes to CTEIS" .

<urn:solutiondesign:instance:staffing:Req_08_6_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Returns staff with assignment details by entity for a valid DistrictCode via the documented TeacherInformation method; indicates no-data and logs the event for an invalid/not-found DistrictCode; only authorized NexSys calls are processed." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_6NexSysDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.6.1" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to expose a NexSys-facing API that returns staff and assignment data by district so that Title I Part A Comparability reporting requirements can be met." ;
	<urn:solutiondesign:ontology:title> "Expose a NexSys-facing staff/assignment API" .

<urn:solutiondesign:instance:staffing:Req_08_6_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Response includes the identity/assignment attributes documented in the NexSys IDD; values derived from current MiEdWorkforce data at request time; missing/inconsistent internal data does not break the API (affected records excluded/flagged)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_6NexSysDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.6.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want the NexSys response to include key personnel and assignment attributes so that comparability calculations can be performed." ;
	<urn:solutiondesign:ontology:title> "Include key personnel/assignment attributes in NexSys responses" .

<urn:solutiondesign:instance:staffing:Req_08_6_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Requires a valid API token (or equivalent) as specified; logs each call with timestamp, district, and response status; logs authentication failures with reason, without exposing credentials." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_6NexSysDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.6.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want NexSys API traffic to be authenticated and logged so that usage and failures are traceable." ;
	<urn:solutiondesign:ontology:title> "Authenticate and log NexSys API traffic" .

<urn:solutiondesign:instance:staffing:Req_08_6_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Endpoints configurable for QA, Staging, and Production; environment identifiable in logs; cross-environment misconfiguration attempts are detected and logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_6NexSysDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.6.4" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support separate endpoints per environment so that NexSys testing does not affect production data." ;
	<urn:solutiondesign:ontology:title> "Support separate NexSys endpoints per environment" .

<urn:solutiondesign:instance:staffing:Req_08_7_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Returns personnel information for a valid UniqueId via GetPersonnelByUniqueId; indicates no-record-found for an invalid/not-found UniqueId; logs all requests and responses." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_7MsdsTsdlDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.7.1" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to expose an API to retrieve personnel information by Unique ID so that MSDS/TSDL and other applications can validate educator identities." ;
	<urn:solutiondesign:ontology:title> "Expose a personnel-by-Unique-ID API for MSDS/TSDL" .

<urn:solutiondesign:instance:staffing:Req_08_7_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Supports use of Unique ID and aligned data elements; behavior remains documented/consistent where PIC remains in use during transition; identifier-usage changes do not break consuming applications without documented change control." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_7MsdsTsdlDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.7.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want the TSDL integration to reflect updated MiEdWorkforce data model rules so that teacher-student linkages no longer depend solely on legacy PIC." ;
	<urn:solutiondesign:ontology:title> "Reflect updated data-model rules in the TSDL integration" .

<urn:solutiondesign:instance:staffing:Req_08_7_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "All calls made over HTTPS with defined authentication; endpoints distinguish environments and logs include environment; unauthorized requests are rejected and logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_7MsdsTsdlDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.7.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want TSDL-related API calls to be secure and environment-aware so that internal data is protected." ;
	<urn:solutiondesign:ontology:title> "Secure and environment-aware TSDL API calls" .

<urn:solutiondesign:instance:staffing:Req_08_7_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Service can be invoked multiple times per day; performance for expected volume is monitored; sustained failures generate error logs." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_7MsdsTsdlDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.7.4" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to support frequent TSDL queries so that data remains current for reporting." ;
	<urn:solutiondesign:ontology:title> "Support frequent TSDL queries" .

<urn:solutiondesign:instance:staffing:Req_08_8_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Core staff/assignment attributes historically required by Secure Site are available within MiEdWorkforce from existing data collections; no hard-coded constraint prevents building a future outbound interface using existing data; design documentation notes MiEdWorkforce can support a future Secure Site integration without major redesign." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_8SecureSiteDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.8.1" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to maintain staff and assignment data in a structure that can be shared with Secure Site in the future so that required assessment-related data can be provided with minimal additional development." ;
	<urn:solutiondesign:ontology:title> "Maintain staff/assignment data shareable with Secure Site in the future" .

<urn:solutiondesign:instance:staffing:Req_08_8_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Does not implement or rely on the deprecated Online Sessions/REP connection; any new Secure Site capability is implemented only under future-approved specifications." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_8SecureSiteDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.8.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to avoid maintaining obsolete dependencies on the prior REP-Secure Site connection so that the solution reflects current assessment processes." ;
	<urn:solutiondesign:ontology:title> "Avoid maintaining the obsolete REP-Secure Site connection" .

<urn:solutiondesign:instance:staffing:Req_08_8_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Interface documentation notes Secure Site-required staffing data can be sourced from MiEdWorkforce; no operational interface is claimed as active until formally defined." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd08_8SecureSiteDoc> ;
	<urn:solutiondesign:ontology:requirementId> "8.8.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to document the potential to share Secure Site-required data so that stakeholders understand this is an intentional future-ready design." ;
	<urn:solutiondesign:ontology:title> "Document the potential to share Secure Site-required data" .

<urn:solutiondesign:instance:staffing:Req_10_10_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add/modify a collection for Employee Rosters; mark Categories/Components as Required/Optional/Conditionally Required; indicate single vs. multi-occurring data elements." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Same shape and same gap as Req_10_9_1 — one collection-definition admin surface covering both Position and Employee Rosters conceptually (staff:CollectionAggregate doesn't distinguish a Position-Roster-collection from an Employee-Roster-collection as separate types), with the same missing admin ApiOperation." ;
	<urn:solutiondesign:ontology:requirementId> "10.10.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminManageCollections> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to add or modify the Employee Roster data collection, so that I can set specific requirements for how districts report employees." ;
	<urn:solutiondesign:ontology:title> "Define/modify the Employee Roster collection" .

<urn:solutiondesign:instance:staffing:Req_10_11_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add/update data categories (e.g. Assignment Details); select data elements from available elements to categorize; associate Entity Types with categories; track versioning/audit details." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "staff:CategoryRequirement (a ValueObject on staff:CollectionAggregate: 'data category with required/optional/conditional status') is the closest conceptual match, but it models a category's REQUIREMENT STATUS within a specific collection, not the category-definition/data-element-grouping admin surface this story describes (which is closer to a Category master-data concept than a per-collection requirement flag). Same missing-ApiOperation gap as Req_10_8_1/10_9_1/10_10_1 — all four Feature 10.8-10.11 stories point at the same underlying absent admin-configuration surface for Staffing's reference/master data (data elements, categories, collections)." ;
	<urn:solutiondesign:ontology:requirementId> "10.11.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CategoryRequirement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminManageDataElements> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to define and manage sets of data elements as Categories, so that I can group assignment details logically for data collection." ;
	<urn:solutiondesign:ontology:title> "Define Assignment Details data categories" .

<urn:solutiondesign:instance:staffing:Req_10_12_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "View/manage identity data authorized user roles and permissions; manage business rule validations applied to identity processing for staffing; manage identity processing user alerts/communications specific to staffing; manage the Identity Management Admin Role Worklist for processing Identity Requests." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: staff:StaffingContext's own domain-doc notes are explicit that Unique ID creation, identity matching/resolution logic, Near Match handling, and the Identity Administrator worklist are entirely IAM-owned, not Staffing's — so this story's true home is iam, not staffing. But iam-api.ttl's real, converted surface (checked directly) exposes only RUNTIME identity-resolution operations (submit/approve/deny a request) and reporting triggers (Op_TriggerExpireRequests, Op_GetNewUsersReport) — no admin-CONFIGURATION surface for 'identity processing business rule validations,' 'identity processing alerts,' or a queryable 'Identity Management Admin Role Worklist' as a distinct configurable thing exists in either domain's real API. This is therefore a genuine coverage gap, but an ambiguous one on OWNERSHIP as well as existence — see Question_IdentityAdminConfigOwnershipAndGap below." ;
	<urn:solutiondesign:ontology:requirementId> "10.12.1" ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to manage identity management processing specifically for staffing-related collections, so that I can control how new employees are identified and matched." ;
	<urn:solutiondesign:ontology:title> "Manage identity management processing for staffing collections" .

<urn:solutiondesign:instance:staffing:Req_10_13_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Assign a business rule/validation to a Collection, Category, or Data Element; update date fields associated with validation conditions (e.g. Academic Year Start/End); set severity to Errors/Warnings/Data Quality; edit the end-user-facing validation text." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "See Req_10_3_1's own notes — this story and 10.3.1 are near-verbatim duplicates (Question_Feature103HeadingBodyMismatch). Same PARTIAL satisfaction: the rule catalog and engine design exist (staff:TP_ValidationRuleEngine, which names this exact Feature number); the admin CRUD surface to actually assign/edit a validation through a UI does not (staff:Perm_AdminManageValidations has no matching sd:ApiOperation, per staffing-permissions.ttl's header note)." ;
	<urn:solutiondesign:ontology:requirementId> "10.13.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminManageValidations> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to manage and maintain business rules and validations for staffing data collections, so that I can ensure data integrity during submission." ;
	<urn:solutiondesign:ontology:title> "Manage and maintain business rules/validations for staffing collections" .

<urn:solutiondesign:instance:staffing:Req_10_13_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Produce/update/maintain a report including validation text and codes for public consumption; provide justification/comments when adding or updating validations." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Same underlying gap as Req_10_13_1 — a public validation-codes report (explicitly modeled on CEPI's real, cited precedent, the '2023-24 Collection Component Matrix') presupposes the same unbuilt validation-management admin surface. The 'REP BRs' sheet of Staffing Submission Validations.xlsx (BR NUM/Description/Fatal Error/Error/Warning columns) is a close real-world analog of exactly this kind of report, already produced manually for the legacy MORE system — corroborating evidence for the requirement's shape, not itself a substitute for the (still missing) system-generated version." ;
	<urn:solutiondesign:ontology:requirementId> "10.13.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to produce and update a report including validation text and codes, so that I can provide public documentation for local systems." ;
	<urn:solutiondesign:ontology:title> "Produce a public validation-text-and-codes report" .

<urn:solutiondesign:instance:staffing:Req_10_14> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "The Business Specifications prose (and HLS row 5) originally described this in detail (view file queues with Name/Type/Size/Collection/Input Method/Status/Organization/User, download completed files, view error details, reset/reprocess a stuck file, delete files, filter, view audit details, API configuration) — a full admin surface staff:Perm_AdminViewFileQueues and staff:Perm_AdminResetFileProcessing already name (both, per staffing-permissions.ttl's own note, with no matching sd:ApiOperation, consistent with the FDD's own decision that this belongs to developers, not an admin UI). Comment 12 (Thiele: 'Suggestion: Reset/reprocess a file in the queue already in progress. The reason why we're resetting doesn't really matter.') is an early-draft refinement of the since-removed scope, kept only for context." ;
	<urn:solutiondesign:ontology:requirementId> "10.14" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem — the FDD's own rationale for excluding this Feature.) 'The requirements for the Staffing Admin to manage file queues (e.g., resetting \"stuck\" files) and toggle upload availability should be considered outside scope of an administrative task. These functions are considered as technical management and maintenance tasks to be handled by developers. All functionality regarding uploading the files as well as reviewing and verifying the uploaded files has been covered within the user stories associated with other Features in this Epic.'" ;
	<urn:solutiondesign:ontology:title> "Queue management for API/file uploads — declined as an admin capability" .

<urn:solutiondesign:instance:staffing:Req_10_15_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Configure immediate processing to populate the longitudinal database (CEPI CEDS Data Warehouse) upon collection-set finalization; schedule some or all data closeout processing for a future date; store audit details (Modified By/On) for closeout-configuration changes." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Good conceptual match: staff:BatchJob_CollectionToWarehousePipeline's own description cites this exact Feature 10.15 and models the CollectionCertified-triggered extract-to-warehouse pipeline. PARTIAL, and the BatchJob's own sd:errorScenarios note says so directly: 'FDD 10 itself flags this as incomplete... full extract vs. incremental and retry/failure handling are named as open technical questions rather than resolved.' The ADMIN-FACING configuration surface this story specifically asks for (an admin choosing immediate-vs-scheduled-future-date processing per collection) is not itself a distinct sd:ApiOperation anywhere — the BatchJob's own sd:schedule property already flags the scheduling mechanics as staff:Question_WarehousePipelineMechanics (staffing-technical-design.ttl), which this story's own AC independently corroborates rather than introduces new information beyond." ;
	<urn:solutiondesign:ontology:requirementId> "10.15.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:BatchJob_CollectionToWarehousePipeline> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to manage the system configurations needed to process finalized data, so that data is correctly moved to the longitudinal database." ;
	<urn:solutiondesign:ontology:title> "Configure finalized-data closeout processing" .

<urn:solutiondesign:instance:staffing:Req_10_16> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Comment thread (Groom, 2026-03-16: 'Does this need to be defined within this story? In 13.2 (EPP Admin) Historical data is covered by specific feature development... want to ensure the difference in user story approach is accurate' -> Doherty/Sinha, 2026-04-10: 'this is indeed a redundant user story, as the requirements for Data Migration and Auditing are already comprehensively captured under Epic 32 - Technology, Standards, and Auditing. Also, the processes for viewing that data are already addressed within the Acceptance Criteria of other related user stories within this Epic. This has been removed.') documents a full user story that WAS here being deliberately deleted during review, in favor of the Assumptions section's own 'The system will allow users to view historical/legacy data within MiEdWorkforce' already being satisfied piecemeal by other stories' own ACs (several of the table-view stories above — 10.1.1, 10.2.1, 10.8.2, 10.9's/10.10's collection-history views — already describe viewing prior versions/status). Modeled as rejected rather than a gap: a real, documented decision, not an oversight." ;
	<urn:solutiondesign:ontology:requirementId> "10.16" ;
	<urn:solutiondesign:ontology:statement> "(Recovered from document.xml, not visible in the rendered .md — see header note.) 'All user stories regarding the Staffing Admin users' ability to view the historical data relating to this domain can be found within the user stories associated with other features in this FDD.'" ;
	<urn:solutiondesign:ontology:title> "Historical data connections/conversions — folded into other features' ACs" .

<urn:solutiondesign:instance:staffing:Req_10_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Navigate to Dashboard > Position Data > Staffing Users; table columns Name/Department/Group/Role/Start Date/Status; search by name; filters for Name/Department/Group/Role/Start Date/Status; Clear restores defaults; 'No results found' message when nothing matches; only administrative-permission users can access the page." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "FDD 10's own Dependencies section states this whole Feature is 'supported and defined by User Authorization (1)' — this is Staffing's own admin-facing view of IAM's generic user/role model (iam:Op_SearchUsers for the user list, iam:Op_ListRoles for the Role column's values), not a Staffing-owned aggregate or endpoint of its own. IAM's own admin surface (and its gaps — a Role-CRUD gap in particular) was already independently reviewed in fdd-review/01-user-management.ttl; not re-litigated here. Wireframe1 (Manage Users list) directly corroborates the table shape, though still under reused 'Credentialing' labeling — see that SourceDocument's own note." ;
	<urn:solutiondesign:ontology:requirementId> "10.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ListRoles> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SearchUsers> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to view a list of staffing users, so that I can see who currently has access and their assigned roles." ;
	<urn:solutiondesign:ontology:title> "View list of staffing users and roles" .

<urn:solutiondesign:instance:staffing:Req_10_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add User form (Employee Name, Role Group read-only 'Staffing', Role Type, Department, Status), all fields required, dropdown values TBD, Save disabled until complete; on save, creates the user-role association and returns to the list with the new user visible." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Matches fdd-review/01-user-management.ttl's own treatment of the equivalent generic 'admin manually adds/edits a user's role' story (satisfied there by this same Seq_SystemAdminManualGrant/Op_ManualGrantAuthorization mechanism) — this story is that same mechanism scoped to the 'Staffing' Role Group. Wireframe2 (Add User form) corroborates the field list field-for-field." ;
	<urn:solutiondesign:ontology:requirementId> "10.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ManualGrantAuthorization> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_SystemAdminManualGrant> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to add a new user with a role, so that I can grant them access to staffing functionality." ;
	<urn:solutiondesign:ontology:title> "Add a new staffing user with a role" .

<urn:solutiondesign:instance:staffing:Req_10_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Edit icon per row opens the Add User form pre-populated; user can modify Role Type, Department, Status (Role Group remains read-only); changes take effect immediately and are reflected in the list." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:requirementId> "10.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_ManualGrantAuthorization> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_RevokeAuthorization> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Administrator, I want to edit an existing user's role or status, so that I can update their access as responsibilities change." ;
	<urn:solutiondesign:ontology:title> "Edit an existing staffing user's role or status" .

<urn:solutiondesign:instance:staffing:Req_10_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Permissions derive from Role Group + Role Type; users see only authorized pages/actions; removing/changing a role immediately updates access; only administrators can assign/modify roles." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:requirementId> "10.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_CheckPermissions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_GetEffectivePermissions> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Administrator, I want user access to be controlled by assigned roles, so that users only see functionality they are authorized to use." ;
	<urn:solutiondesign:ontology:title> "Access controlled by assigned roles" .

<urn:solutiondesign:instance:staffing:Req_10_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Prevent duplicate role assignments for the same user; required-field validation errors on missing data; user-friendly error messages on save failure; entered data retained on error." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this is a generic form-validation/duplicate-prevention behavior expected of whatever screen implements 10.1.2, not a distinct IAM capability with its own node — the same kind of 'expected of any well-built form' criterion the FDD 29 pass left unlinked in similar cases rather than force a satisfiedBy edge. See the low-impact Annotation below rather than a satisfiedBy edge, per the ontology's own 'every Requirement gets an Annotation or a satisfiedBy' rule." ;
	<urn:solutiondesign:ontology:requirementId> "10.1.5" ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Administrator, I want the system to prevent invalid user assignments, so that access data remains accurate and consistent." ;
	<urn:solutiondesign:ontology:title> "Prevent invalid staffing user assignments" .

<urn:solutiondesign:instance:staffing:Req_10_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Navigate to Dashboard > Positions and Assignments > ... > Pages and Content; table with Code/Name/Modified By/Modified Date/Status/File Type; search and filter on any column; 'No results found' handling; download list as PDF/Word/Excel; edit via pencil icon; history tab with Modified By/On/Attachment; admin can preview documents before publishing; Save/Cancel." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Good structural match on the list/search/filter/metadata side via Documents' real, converted API. Two acceptance criteria have no clear backing: (1) 'preview documents prior to publishing' — no preview/staging-vs-published operation exists in documents-api.ttl (Op_GetDocumentMetadata returns metadata, not a rendered preview; none of the three Add-New-File wireframes show a distinct preview affordance either); (2) 'download the list' as PDF/Word/Excel bulk export of the materials table itself (not an individual document) has no matching operation. Both folded into Question_SupportMaterialsPreviewAndExportGap below rather than treated as fully satisfied." ;
	<urn:solutiondesign:ontology:requirementId> "10.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_GetDocumentMetadata> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_ListDocumentCategories> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_SearchDocuments> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to see a list of training manuals and user support materials, so that I can effectively manage them." ;
	<urn:solutiondesign:ontology:title> "View and manage list of training manuals and support materials" .

<urn:solutiondesign:instance:staffing:Req_10_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add File button; upload .doc/.docx/.pdf; File Type dropdown (TBD); Display Name, read-only Document ID, Permissions (multi-select role), Status (TBD list), Effective Date (future-only date picker); history tab with audit details; preview before publishing; Save/Cancel." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match on upload/versioning mechanics (docs:Op_RequestDocumentReplacement's SAS-token/versionNumber handshake is exactly the kind of 'version controls with a summary of changes' behavior the top-level Business Specifications paragraph for this Feature describes). 'Permissions — multi-select dropdown with all the user roles' scoped per-document is a finer grain than Documents' own category-level Perm_CategoryView/Edit gating; not modeled as a gap on its own since Documents' category model can reasonably be read as the mechanism (one category per role-restricted material type) rather than a missing capability. Same preview-before-publish gap as Req_10_2_1 — see Question_SupportMaterialsPreviewAndExportGap. Wireframes 3-5 (all three Add New File states) directly corroborate the field list." ;
	<urn:solutiondesign:ontology:requirementId> "10.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_ListDocumentCategories> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_RequestDocumentReplacement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_RequestDocumentUpload> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to manage and maintain training manuals and user support materials, so that data submitters have access to current guidance." ;
	<urn:solutiondesign:ontology:title> "Upload and maintain training manuals and support materials" .

<urn:solutiondesign:instance:staffing:Req_10_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Generate data definition documents (type, length, format) from CEDS metadata stored in the system; export in a user-consumable format (e.g. Excel); generated documents include file schema requirements and sample files." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no data-definition-generation capability (reading a data element's CEDS-aligned type/length/format metadata and rendering it into an Excel/PDF document with schema requirements and sample files) exists anywhere in staffing-domain.ttl, staffing-api.ttl, or documents-api.ttl. Comment thread (Thiele: 'help me understand why we want the application to do this instead of CEPI maintaining the documentation on our own' -> Groom: 'We want to use the meta data from the CEDS standards as the source whenever possible. The CEPI staff will still perform publishing and maintenance of the docs.') confirms this is a real, deliberately-scoped requirement (auto-generate the DATA, not auto-publish), not an open question — it depends on a Data Element admin surface (staff.admin.manage-data-elements, itself a gap — see Req_10_8_1) that doesn't exist yet either, making this a second-order gap on top of a first-order one." ;
	<urn:solutiondesign:ontology:requirementId> "10.2.3" ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to auto-generate data definition documents using system metadata, so that documentation remains consistent with CEDS standards without manual updates." ;
	<urn:solutiondesign:ontology:title> "Auto-generate CEDS-aligned data definition documents" .

<urn:solutiondesign:instance:staffing:Req_10_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Validations assignable to Collections/Categories/Data Elements; validation date fields updatable; severity as Error/Warning/Data Quality; validation messages editable; justification/comments (medium free-form) on add/update; public-facing validation report generated/maintained; all changes versioned and auditable." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Near-verbatim duplicate of Req_10_13_1/Req_10_13_2 below (same severity vocabulary, same Collection/Category/Data Element assignment model, same justification-field language) despite sitting under a heading literally titled 'Manage System Alerts/Notifications' — see Question_Feature103HeadingBodyMismatch. staff:TP_ValidationRuleEngine's own description cites this exact Feature-10.3/10.13 numbering and the companion Staffing Submission Validations.xlsx directly. PARTIAL: TP_ValidationRuleEngine documents the rule catalog and execution-engine design, and staff:Perm_AdminManageValidations documents the intended permission, but staffing-permissions.ttl's own header note confirms no sd:ApiOperation anywhere in staffing-api.yml actually implements this admin CRUD surface — the admin-facing 'assign a rule to a Collection/Category/Data Element' UI this story describes is design-level only, not yet a real endpoint." ;
	<urn:solutiondesign:ontology:requirementId> "10.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminManageValidations> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to manage business rules and validations so that staffing data quality is enforced." ;
	<urn:solutiondesign:ontology:title> "Manage business rules and validations for staffing data quality" .

<urn:solutiondesign:instance:staffing:Req_10_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "(From the Business Specifications prose, since the Addendum gives no AC of its own): create/manage system alert text with versioning; set effective dates; set authorized user roles to receive; view/manage the system event/trigger the alert uses; view existing alerts in a filterable table (Group/Type, Name, Status, Expiration Date, Action, versioning/audit)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match: comm:AlertAggregate already models versioning (comm:AlertVersion), role-based targeting (comm:AlertRoleTarget — matches 'Set Authorized User Roles to receive'), and an expiry-bearing state machine (comm:AlertState_Active/Expired — matches 'Expiration Date'/'Set system effective dates'). Unlike the FDD 29 pass's treatment of an equivalent Credentialing alerts deferral (which found NO alert/notification model at all and called it out-of-scope), Communications now has a real converted alerting surface in this same mied-v3 pass, so this is modeled as satisfied via that generic framework rather than out-of-scope — consistent with how Req_10_5/Req_10_7 below treat their own Business-Specification-#6/#2 deferrals. Not modeled: a discrete 'which event/trigger uses this alert' admin binding UI (comm:AlertAggregate doesn't expose a queryable trigger-registration list) — minor, not raised as its own Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "10.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:AlertAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_CreateAlert> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ListAlerts> ;
	<urn:solutiondesign:ontology:statement> "(No numbered user story — a scope-boundary paragraph.) All underlying logic for sending, tracking, and displaying system alerts and notifications derives from Business Specification #6 (Alerts, Emails & Communications). This Feature is strictly limited to configuring what is sent, specifically for the Data Collection & Compliance module; Business Specification #4 (Business Rules Management) specifies when and to whom." ;
	<urn:solutiondesign:ontology:title> "Configure system alerts/notifications for Staffing collections" .

<urn:solutiondesign:instance:staffing:Req_10_5> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Create/manage email templates within the Staffing group; set effective dates; set authorized recipient roles; define the triggering system event; view historical use (per-instance, count of uses, trigger point) with resend+CC ability; view templates in a filterable table (Name/Group/Status/Expiration/Action/versioning-audit)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match: communications-api.ttl already models a first-class 'Staffing' functional area as one of four alternative permission scopes on every template operation (comm:Perm_StaffingTemplatesView/Create/Edit/Delete), plus explicit template versioning (comm:Op_CreateTemplateVersion/Op_ListTemplateVersions) matching 'version controls'. Not modeled: the per-instance historical-send log with resend+CC (comm:EmailInstanceAggregate exists per communications-capability.ttl's hasAggregate list but wasn't traced further here — out of this review's own domain, no gap raised on Staffing's behalf for a capability that belongs entirely to communications' own FDD review)." ;
	<urn:solutiondesign:ontology:requirementId> "10.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_CreateTemplate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_CreateTemplateVersion> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Op_ListTemplates> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:Perm_StaffingTemplatesCreate> ;
	<urn:solutiondesign:ontology:statement> "(No numbered user story — a scope-boundary paragraph, identical in shape to Feature 10.4's.) All underlying logic for sending, tracking, and displaying emails/alerts/notifications derives from Business Specification #6; this Feature is strictly limited to configuring the tools for the Data Collection & Compliance module; Business Specification #4 specifies when/to whom." ;
	<urn:solutiondesign:ontology:title> "Configure email/notification templates for Staffing collections" .

<urn:solutiondesign:instance:staffing:Req_10_6> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Define available configurable tiles; define reports for each role-based dashboard; update text/help-support links for staffing data dashboard functionality; audit details stored." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: dash:DashboardsContext remains a stub-only bounded context in this project (per CONVENTIONS.md's stub registry, and per the FDD 29 pass's identical finding for Credentialing's own equivalent Feature 29.1.8/Business Specification #3 dependency) — there is no real Dashboards conversion anywhere in mied-v3 for this to satisfy, so unlike Req_10_4/10_5/10_7 (whose underlying frameworks ARE now real), this one genuinely has nothing to point at yet." ;
	<urn:solutiondesign:ontology:requirementId> "10.6" ;
	<urn:solutiondesign:ontology:statement> "(No numbered user story — a scope-boundary paragraph.) All underlying logic for the display, organization, and rendering of the dashboard derives from Business Specification #3 (Dashboards); this Feature is strictly limited to configuring which tiles and reports are available to whom, for the Data Collection & Compliance workflow." ;
	<urn:solutiondesign:ontology:title> "Configure Staffing tiles and reports on role-based dashboards" .

<urn:solutiondesign:instance:staffing:Req_10_7> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Define report availability, including future/immediate retirement; define report access by authorized user roles; search existing reports; create ad-hoc/custom reports; export/download options; manage report resources (page text, links); set a report as required for the collection worklist." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Good match: Reporting's own real, converted Admin catalog surface (register/update/activate-deactivate a report, Perm_CatalogManage-gated) is exactly the generic 'define availability, retire, access by role' framework this Feature says it configures for Staffing specifically. Not modeled: 'create ad-hoc and custom reports' and 'set a report as required for the collection worklist' — the former is a report-authoring capability outside Reporting's own catalog-registration model (Reporting registers pre-built Power BI reports, per reporting-api.ttl's own shape, rather than an ad-hoc report builder); the latter ties a report to staff:CollectionAggregate's own worklist concept, which has no such linkage field anywhere in staffing-domain.ttl. Both folded into notes rather than a separate Annotation given the FDD's own explicit 'strictly limited to configuration' framing already anticipates most of the heavy lifting living elsewhere." ;
	<urn:solutiondesign:ontology:requirementId> "10.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminCreateReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminUpdateReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminUpdateReportStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Perm_CatalogManage> ;
	<urn:solutiondesign:ontology:statement> "(No numbered user story — a scope-boundary paragraph.) All underlying logic for the display, organization, and rendering of the report derives from Business Specification #2 (Reporting); this Feature is strictly limited to configuring which reports are available to whom, for the Data Collection & Compliance workflow." ;
	<urn:solutiondesign:ontology:title> "Configure Staffing report availability and access" .

<urn:solutiondesign:instance:staffing:Req_10_8_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add/update Name, Description, System Name, ID, Status; define Category Information (Category, Legal Citation, Data Use, Instructions, Contact); set Data Type attributes aligning to CEDS plus specific flags; select data element dependencies from available elements." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "No matching sd:ApiOperation anywhere in staffing-api.yml, per staffing-permissions.ttl's own header note and staff:Perm_AdminManageDataElements's own notes — a documented, pre-existing gap this pass independently confirms rather than newly discovers. The permission node names the intent; nothing implements it. Same 'high-level, still under internal discussion' caveat as the rest of Features 10.8-10.15 — see Question_AdminStoriesStillUnderInternalDiscussion." ;
	<urn:solutiondesign:ontology:requirementId> "10.8.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminManageDataElements> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to add or update data elements for staffing data collections, so that the system accurately reflects current reporting standards." ;
	<urn:solutiondesign:ontology:title> "Add or update staffing data elements" .

<urn:solutiondesign:instance:staffing:Req_10_8_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Table with Name/Version/Status/Data Category/Data Type/Action; extract results in usable formats (Excel, CSV)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Same gap as Req_10_8_1 (no backing sd:ApiOperation) — a read-only view of the same missing capability, not a distinct implementation." ;
	<urn:solutiondesign:ontology:requirementId> "10.8.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminManageDataElements> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to view and filter existing data elements in a table, so that I can easily locate and review element definitions." ;
	<urn:solutiondesign:ontology:title> "View and filter existing staffing data elements" .

<urn:solutiondesign:instance:staffing:Req_10_9_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add/modify a collection for Position Rosters; select Entity Types; set collection dates (Open, Close, School Year Start/End); select specific Data Categories/Components to include." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "staff:CollectionAggregate is the right conceptual target (its own CollectionDefinition entity already models school-year dates, entity types, and category requirements — an exact shape match), but staffing-permissions.ttl's own note confirms staff:Perm_AdminManageCollections has no matching sd:ApiOperation anywhere in staffing-api.yml: the collection lifecycle staffing-api.ttl DOES expose (Op_ListCollections, Op_RunQualityReview, Op_CertifyCollection, etc.) is all downstream OF an already-defined collection, not the admin authoring surface that DEFINES one. Genuine gap in the build surface, not the domain model." ;
	<urn:solutiondesign:ontology:requirementId> "10.9.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminManageCollections> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want to add or modify the Position Roster data collection, so that I can set specific requirements for how districts report positions." ;
	<urn:solutiondesign:ontology:title> "Define/modify the Position Roster collection" .

<urn:solutiondesign:instance:staffing:Req_10_BizSpec_AdminWorklist> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Worklist surfaces submitted Collection Exception requests (extension) and reopen requests for admin action." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "The one Business-Specification item omitted from the Addendum that turns out to be FULLY satisfied, not a gap: staffing's own Collection Exception workflow (submit -> staff:Perm_AdminProcessExceptions-gated approve/deny) is exactly this Worklist's 'Collection extension' item. 'Reopen requests' and 'Etc.' beyond exception approval have no distinct backing (no separate reopen-request aggregate/operation exists; staff:CollectionState_Reopened is a state on Collection itself, reachable structurally but with no admin-facing reopen-REQUEST workflow of its own modeled) — a minor partial-coverage note, not a separate Annotation given how directly the core item (Collection extension) matches." ;
	<urn:solutiondesign:ontology:requirementId> "10.BizSpec.AdminWorklist" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ApproveCollectionException> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_DenyCollectionException> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AdminProcessExceptions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_RequestCollectionException> ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem, no Addendum feature number — Business Specifications prose only, also present as HLS row 23.) The Staffing Data Admin will have a Worklist that includes requests submitted by system users for processing, including: Collection extension, Reopen requests, Etc." ;
	<urn:solutiondesign:ontology:title> "Staffing Data Administrator's own processing worklist" .

<urn:solutiondesign:instance:staffing:Req_10_BizSpec_DataQualityAdmin> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Define DQ reports available on the DQ Dashboard (by Collection, User Roles, Status, Severity, Alerts/templates used); view/manage user support resources for DQ review; schedule DQ processing by Date or Event; schedule business-rule-enforcement validation by Date or Event." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "Out of scope for THIS review, not a Staffing-side gap: FDD 10's own Dependencies section names 'Data Quality Review & Processing (19.0)' as the owning epic for this exact capability, and FDD 19/20 was reviewed concurrently in this same wave (fdd-review/19-20-data-quality-review-and-processing/) — deferred there rather than duplicated or guessed at here, consistent with this FDD's own explicit cross-reference. Never promoted to the Addendum's own numbering (no 10.x feature number, despite its own HLS row 13 and full bullet list) — folded into Question_AddendumOmitsBizSpecFeatures below alongside the Worklist omission, though its resolution (defer to 19/20) differs from that one's (genuine gap)." ;
	<urn:solutiondesign:ontology:requirementId> "10.BizSpec.DataQualityAdmin" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem, no Addendum feature number — Business Specifications prose only, also present as HLS row 13.) On an administrative page, with audit details stored, the Staffing Data Admin will manage the Data Quality Review and Processing related to the Staffing Data Collections, used by data submitters in Data Quality Review & Processing 19 & 20." ;
	<urn:solutiondesign:ontology:title> "Configure Data Quality Review and Processing for staffing collections" .

<urn:solutiondesign:instance:staffing:Req_10_BizSpec_EmploymentCollectionWorklist> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Set worklist availability; set role-based access level; set task requirement (required/optional/conditional); set task deadline; show task progress with visual complete/incomplete indicators; gate certification eligibility on pre-certification task completion; reset the worklist each required collection period; audit details stored." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd10Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no 'collection worklist' concept (a configurable, per-collection checklist of tasks gating certification, distinct from the Collection aggregate's own certification-readiness invariants) exists anywhere in staffing-domain.ttl. staff:CollectionAggregate's invariants ('all pre-certification tasks must be complete before certification allowed') assume such a task list exists but nothing defines what the tasks ARE or how an admin configures them — this story is the missing definitional piece. Genuinely never promoted to the Addendum's own 10.x numbering despite having its own HLS row (12) and a full bullet list in the prose — see Question_AddendumOmitsBizSpecFeatures." ;
	<urn:solutiondesign:ontology:requirementId> "10.BizSpec.EmploymentWorklist" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem, no Addendum feature number — Business Specifications prose only, also present as HLS row 12.) On an administrative page, with audit details stored, the Staffing Data Administrator will manage the 'Employment Data Collection Worklist' by entity type and collection." ;
	<urn:solutiondesign:ontology:title> "Configure the Employment Data Collection Worklist" .

<urn:solutiondesign:instance:staffing:Req_18_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Add Position button on the Positions screen opens a Position Creation screen; required fields validated before save; system generates a unique position identifier on save; redirects to the Assignments page for the new position; all position creation actions logged with user, timestamp, and position ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, confirmed visually (Wireframe1/Wireframe2). staff:Seq_CreateNewPosition's own key decision ('Position identifier is system-generated to ensure uniqueness') matches this story's acceptance criteria near-verbatim." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_CreateNewPosition> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to create a new position so that I can define the staffing needs for a role in my district." ;
	<urn:solutiondesign:ontology:title> "Create a New Position" .

<urn:solutiondesign:instance:staffing:Req_18_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Approved FTE required on creation; must be numeric, greater than 0.00, decimals accepted; displayed immediately on the Assignments screen after saving; included in all downstream position health calculations." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: PositionRosterAggregate's own invariant ('Approved FTE must be greater than zero') is this exact rule." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to specify the Approved FTE for a position so that the system reflects the staffing allocation authorized for the position." ;
	<urn:solutiondesign:ontology:title> "Capture Approved/Desired FTE" .

<urn:solutiondesign:instance:staffing:Req_18_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Position Details page shows zero filled/vacant/frozen spots via stat cards immediately after creation (all zero except Approved FTE); no default spots auto-created; controls present to proceed to spot/assignment creation." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Satisfied at the data-model level (Position/Spot entities, Approved-FTE-vs-sum-of-spot-FTE invariant), but the specific Filled/Vacant/Frozen FTE 'stat card' breakdown this story and Wireframe7 describe is not itself an explicit field on staff:Position in staffing-domain.ttl — it is implicitly derived by summing staff:Spot records. Not raised as a separate gap (a derived/computed display value, not missing domain modeling), but noted for completeness." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want the Assignments page to show that no spots currently exist so that I understand that additional staffing setup is required." ;
	<urn:solutiondesign:ontology:title> "View Newly Created Position with No Spots" .

<urn:solutiondesign:instance:staffing:Req_18_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Warning displayed when Approved FTE > 0 and spot FTE sum does not match; persists until resolved; visually indicated via a red state; informational only, does not block actions until certification." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match: PositionRosterAggregate's own invariant states 'Sum of spot FTE should equal approved FTE for position (health indicator, not blocking)' — same non-blocking framing as this story. Confirmed visually (Wireframe7)." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want the system to display a warning when the sum of spot FTE does not equal the Approved FTE so that I am aware that staffing allocations are incomplete or inaccurate." ;
	<urn:solutiondesign:ontology:title> "Display FTE Health Indicator for Mismatch" .

<urn:solutiondesign:instance:staffing:Req_18_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Step 1 (Spot Details) dynamically shows/hides SCED Course and Grade Level fields based on Education Job Type/Local Job Category (Teacher gets full fields; Administrator/Student Support/Non-Instructional get a reduced set); FTE Allocation and Start Date required to proceed; Step 2 (Select Employee) offers search, an 'appropriately certified & endorsed' filter toggle, per-employee certificate/endorsement indicators, a PPR-flag blocking message, and grade-band validation; Step 3 (Confirm and Add) shows the employee's certificates/endorsements verbatim; on Add, creates a filled spot and updates the Filled Spots table and all four FTE stat cards; all steps logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Very close 1:1 match, confirmed visually across all three wireframed steps (Wireframe4/5/6): staff:Seq_AssignEmployeeToPosition is exactly this three-step workflow, including the PPR-blocking branch and the credential/endorsement validation branch. The dynamic field set by Education Job Type (Teacher vs. Administrator/Student Support/Non-Instructional) is not separately called out as a distinct rule in staffing-domain.ttl beyond the general AssignmentAggregate invariants, but is consistent with them." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreateAssignment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ValidatePlacement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AssignEmployeeToPosition> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to add a filled spot to a position by completing the three-step assignment workflow, so that I can assign an eligible employee to the appropriate SCED course, grade levels, and FTE allocation." ;
	<urn:solutiondesign:ontology:title> "Save Validation Errors for Position Creation (FDD heading; body is actually the Add Filled Spot workflow — see file header)" .

<urn:solutiondesign:instance:staffing:Req_18_1_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Recalculates and displays all four FTE stat cards; shows the health-indicator warning if mismatched; lists newly added filled spots (employee, Meets Requirements Yes/Partially/No, SCED Course Title, Start Date, Allocation); Add Filled/Unfilled Spot actions remain available; no additional user action required." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match for the FTE-recalculation and multi-row-list behavior (confirmed visually, Wireframe8). The three-state 'Yes/Partially/No' Meets Requirements indicator is only partially modeled — see Req_18_1_7's coverage-gap note; folded here as a partial-satisfaction caveat rather than a duplicate Annotation target, per the 'partial satisfaction is normal' rule." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AssignEmployeeToPosition> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want the Assignments tab to update immediately after adding a filled spot, so that I can see updated FTE totals, health indicators, and the list of filled and unfilled spots." ;
	<urn:solutiondesign:ontology:title> "Update Assignment Page After Adding a Filled Spot" .

<urn:solutiondesign:instance:staffing:Req_18_1_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "After an assignment update, revalidate all employees on the position; if any employee fails, display a banner with a 'See Recommendations' link even if only one of several employees fails; banner persists until resolved." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: staff:Op_ValidatePlacement's responseSchema is a flat boolean (meetsRequirements: true/false, missingCredential?/missingEndorsement?) evaluated once at assignment-creation time — there is no revalidate-on-update behavior, no three-state Yes/Partially/No outcome, and no banner/notification concept anywhere in staffing-domain.ttl or staffing-api.ttl. Confirmed by Wireframe9's visible 'Partially' state and 'See Recommendations' banner, which has no backing node to satisfy it. See the coverage-gap Annotation below (grouped with Req_18_1_8, the closely related Recommendations-modal story)." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.7" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to be notified when assigned employees do not meet position requirements, so that I can take corrective action." ;
	<urn:solutiondesign:ontology:title> "Display Recommendation Banner for Non-Qualified Employees" .

<urn:solutiondesign:instance:staffing:Req_18_1_8> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Modal lists each non-qualifying employee, the missing requirement, and recommended actions (apply for endorsement, apply for Temporary Credential, reassign employee); 'Temporary Credential' links to that workflow if in scope; informational only, no automatic changes." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: same gap as Req_18_1_7 — no Recommendations-modal-shaped output or 'recommended actions' concept exists anywhere in staffing-domain.ttl. The 'Apply for Temporary Credential' / 'Submit Justification' fork DOES exist as a real branch in staff:Seq_AssignEmployeeToPosition (the assignment-creation-time version of this idea) — this story describes a similar but distinct, later/on-demand version of that same choice, surfaced from a revalidation banner rather than from the initial assignment flow." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.8" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to view detailed recommendations for employees who do not meet assignment requirements, so that I understand how to resolve qualification issues." ;
	<urn:solutiondesign:ontology:title> "View Appropriate Placement Recommendations" .

<urn:solutiondesign:instance:staffing:Req_18_1_9> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "'Assignment History' tab shows type, employee, SCED course title, start date, end date, allocation; entries read-only; date-range filter (e.g. Last 12 Months); empty state when no history; historical entries remain visible after current-cycle changes; access to the tab logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no queryable assignment-history/version-log entity or endpoint exists anywhere in staffing-domain.ttl or staffing-api.ttl — staff:Op_GetAssignment returns only a single current AssignmentDetail, and the AuditWorkItemAggregate's own audit trail is scoped to the certification/audit domain, not to a per-position change history. Genuine coverage gap; see the annotation grouped with Req_18_3_7 below (same underlying missing concept: a queryable position/assignment audit-and-version history)." ;
	<urn:solutiondesign:ontology:requirementId> "18.1.9" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to view the assignment history for a position, so that I can see past staffing activity and FTE changes." ;
	<urn:solutiondesign:ontology:title> "View Assignment History" .

<urn:solutiondesign:instance:staffing:Req_18_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Select a position from the Positions table; edit Approved FTE, Building, and Status; validate on Save Changes; field-specific errors block save until corrected; edit logged with user, timestamp, position ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, confirmed visually (Wireframe3). staff:Op_UpdatePosition's own projection note ('Partial update of title, job category/function, approved FTE only') covers FTE and category/function; Building and Status are handled by this story's dedicated fields too, matching the wireframe's editable-field set." ;
	<urn:solutiondesign:ontology:requirementId> "18.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to edit existing position details so that I can keep the position record accurate when names or classifications change." ;
	<urn:solutiondesign:ontology:title> "Edit Position Details" .

<urn:solutiondesign:instance:staffing:Req_18_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Required Assigned Employee field, searchable by Unique ID or Name, limited to Active-Employment-Status employees; Job Position Status Date required before submission; conflict message on status conflicts; logged with user, timestamp, position ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match: staff:Seq_UpdatePositionStatus's own 'Status = Filled' branch requires an employee assignment or returns 400 Bad Request, identical to this story's rule." ;
	<urn:solutiondesign:ontology:requirementId> "18.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePositionStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_UpdatePositionStatus> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, when I set a position to 'Filled,' I want the system to require assignment of an active employee so that the position is accurately linked to staffing." ;
	<urn:solutiondesign:ontology:title> "Set Status to Filled (Assign Employee Required)" .

<urn:solutiondesign:instance:staffing:Req_18_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Delete option shown only during the working window; confirmation before removal; deleted positions removed entirely; deletion disallowed once established (post-working-window); if the position had an employee assignment, employee-assignment validations are rerun; logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Consistent with PositionRosterAggregate's own invariant ('Position cannot be deleted after establishment (working window only); use Cancelled status instead'), confirmed visually (Wireframe3's Delete Position button). Worth flagging: staff:Op_CancelPosition's own summary is 'Cancel position (sets status to Cancelled)' — a status transition, not the true, record-removing deletion this story describes for the pre-establishment case. staffing-api.ttl models only one DELETE /positions/{positionId} operation and its notes describe only the Cancelled-status behavior; it isn't explicit that this same operation performs a hard delete during the working window versus a soft Cancelled transition afterward. Not raised as a full coverage-gap Annotation (the underlying business rule is present and correct), but noted as an API-documentation ambiguity worth tightening." ;
	<urn:solutiondesign:ontology:requirementId> "18.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CancelPosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to delete a position when it is still in the working window (not yet submitted/certified) so that I can remove positions created in error." ;
	<urn:solutiondesign:ontology:title> "Remove Position During Working Window (Deletion)" .

<urn:solutiondesign:instance:staffing:Req_18_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Delete disabled once established; Cancelled status requires Job Position Status Date and Cancelled Reason; cancellation blocked without a reason; position drops from the active/default roster after the effective date but remains in historical/archived views; logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, exact match to staff:Rule_PositionStatusCancelledRequiresReason." ;
	<urn:solutiondesign:ontology:requirementId> "18.2.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CancelPosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_PositionStatusCancelledRequiresReason> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to cancel an established position so that I can end its lifecycle with proper documentation." ;
	<urn:solutiondesign:ontology:title> "Cancel/End Position (For Established Positions)" .

<urn:solutiondesign:instance:staffing:Req_18_2_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Assigned Employee field hidden/disabled for Active, Frozen, or Cancelled status; prior assignment shown to end after the status-change effective date; cannot save 'Filled' semantics (employee assignment) under a non-Filled status; disallowed attempts logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match: PositionRosterAggregate's own invariant ('Position status Active/Frozen/Cancelled prohibits active employee assignment after effective date') and Rule_FrozenPositionProhibitsAssignment's worked example both state this precisely; staff:Seq_UpdatePositionStatus's own Frozen/Cancelled branches ('end employee assignment at effective date') implement it end-to-end." ;
	<urn:solutiondesign:ontology:requirementId> "18.2.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_FrozenPositionProhibitsAssignment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_UpdatePositionStatus> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want the system to prohibit assigning an active employee to positions set to statuses where assignments are not allowed so that records remain valid." ;
	<urn:solutiondesign:ontology:title> "Prevent Employee Association for Certain Statuses" .

<urn:solutiondesign:instance:staffing:Req_18_2_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Multi-select positions enables Bulk Update; a single Status Date applies to all selected; Cancelled requires one Cancelled Reason for all selected; Filled is not permitted in bulk (assignments are per-position unique); logs list all affected position IDs." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: staffing-api.ttl has no bulk/multi-position update endpoint of any kind for Positions — staff:Op_UpdatePositionStatus (PATCH /positions/{positionId}/status) and staff:Op_UpdatePosition are both single-record operations, and no SequenceReference/ApiOperation anywhere models a multi-select batch update. Genuine coverage gap — grouped in the Feature 18.5 bulk/API-ingestion Annotation below, since it is the same underlying missing capability (a batch/bulk write surface for Positions) surfacing from a different UI entry point." ;
	<urn:solutiondesign:ontology:requirementId> "18.2.6" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to update the Job Position Status and Status Date for multiple positions simultaneously so that I can efficiently manage roster updates." ;
	<urn:solutiondesign:ontology:title> "Bulk Update of Position Status and Status Date" .

<urn:solutiondesign:instance:staffing:Req_18_2_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Missing-required-field errors on edit/status-update/cancellation are clear; status-change-vs-active-assignment conflicts are shown; no update saved until all errors are resolved." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "General validation behavior already implied by each operation's own 400-Bad-Request error paths in staff:Seq_UpdatePositionStatus — a thin but real match; no dedicated validation-message catalog exists (consistent with the rest of the platform's approach, which keeps error text as prose on each sequence rather than a promoted class)." ;
	<urn:solutiondesign:ontology:requirementId> "18.2.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CancelPosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePositionStatus> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want clear validation messages if edits, deletions, or status changes cannot be applied so that I can correct issues quickly." ;
	<urn:solutiondesign:ontology:title> "Validation Errors for Edit/Remove Operations" .

<urn:solutiondesign:instance:staffing:Req_18_3_10> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Staffing Data Admin reopens a prior collection; system allows edits to that year's data; a reopened-status banner/message is shown; edits during reopen follow standard working-window validation rules; all reopen-period edits logged with user ID, timestamp, rationale." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial satisfaction: staff:CollectionState_Reopened (a real, non-terminal StateDefinition on CollectionAggregate) and staffing-technical-design.ttl's own Rule_CollectionRolloverCarriesForward references confirm the state exists, but no dedicated sd:Sequence or sd:ApiOperation models the actual admin-initiated reopen ACTION (analogous to how staff:Seq_RequestCollectionException models the exception-request flow but nothing equivalent exists for a plain reopen) — the state is modeled, the transition into it is not. Not raised as a standalone Annotation given the state itself IS present and this is a narrower gap than the audit/history one above, but noted here per the 'partial satisfaction is normal' rule." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.10" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionState_Reopened> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to recognize when a collection period has been reopened so that previously locked position data can be edited if authorized." ;
	<urn:solutiondesign:ontology:title> "Recognize Re-Open Requests for Historical Data" .

<urn:solutiondesign:instance:staffing:Req_18_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "New academic year triggers automatic collection-year creation; no user action required; references the prior year's certified roster; logs rollover timestamp, academic year, and initialization status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match: staff:Seq_OpenNewCollection is initiatedBy 'internal-system', triggered by a Scheduler, and its own whatWhenWho text ('System automatically initializes a new school-year collection at the start of the academic year... No user action needed') is this story near-verbatim." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to automatically initialize the new collection year so that districts can begin reviewing and reporting their annual Position Roster data." ;
	<urn:solutiondesign:ontology:title> "Automatically Initialize the New Academic Year" .

<urn:solutiondesign:instance:staffing:Req_18_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Positions without an end date (Active, Approved, Filled, Vacant, or Frozen statuses) automatically carry forward with metadata and Approved FTE intact; no district re-entry required." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match — Rule_CollectionRolloverCarriesForward's statement and worked example describe this precisely, including the no-end-date carry-forward condition." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionRolloverCarriesForward> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to carry forward all active positions so that the new collection year reflects continuing staffing needs." ;
	<urn:solutiondesign:ontology:title> "Automatically Carry Forward Active Positions" .

<urn:solutiondesign:instance:staffing:Req_18_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Positions with both an end date and a Cancelled/end reason are excluded from the new year's default roster but remain in historical views; logs which position IDs were excluded." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match — the same rule's exclusion branch." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionRolloverCarriesForward> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to exclude positions with an end date so that only valid, ongoing positions continue into the new collection year." ;
	<urn:solutiondesign:ontology:title> "Automatically Exclude Ended Positions" .

<urn:solutiondesign:instance:staffing:Req_18_3_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Prior year's roster displayed as the basis for the new year on login after rollover; carried-forward positions show prior-year metadata; cancelled/ended positions absent from the new roster; active school year clearly displayed." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — staff:Seq_OpenNewCollection's own final steps show exactly this district-login-after-rollover view." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ListCollections> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to view my previous school year's roster at the beginning of the new collection year so that I can confirm which positions have carried forward." ;
	<urn:solutiondesign:ontology:title> "View Roster Data from the Previous School Year" .

<urn:solutiondesign:instance:staffing:Req_18_3_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "View any prior school year's org chart, read-only; shows start/end dates and status history; editing of historical positions/spots is prevented; correcting certified historical data requires a formal, admin-controlled reopen request; academic year and version shown in the UI." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no dedicated 'historical organizational chart' read view or endpoint exists in staffing-api.ttl (only current-collection Op_ListPositions/Op_GetPosition) and no reopen-REQUEST operation exists (staff:CollectionState_Reopened exists as a state, and staff:Rule_CollectionRolloverCarriesForward's own notes mention excluded records 'remain visible under historical views,' but nothing shows those historical views are actually queryable via a modeled endpoint, nor is there a citizen/district-facing reopen-request flow — only the reopen STATE itself is modeled). Genuine coverage gap; grouped with Req_18_3_7 below (same underlying missing capability: queryable historical/versioned position views)." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.5" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to view historical organizational charts so that I can reference how positions were structured and staffed in prior years." ;
	<urn:solutiondesign:ontology:title> "View Historical Organizational Charts (Read-Only)" .

<urn:solutiondesign:instance:staffing:Req_18_3_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Export in one or more supported formats (Excel, CSV, XML) for any selected school year; exported data matches what's shown, including carried-forward and ended positions; includes key position fields; export logged with user ID, timestamp, academic year." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no export/download sd:ApiOperation exists anywhere in staffing-api.ttl for Positions (or for any other Staffing aggregate) — confirmed visually by Wireframe10's download icon on the Positions list, which has no backing operation. Genuine, wireframe-confirmed coverage gap; see the Annotation below (grouped with the identical 18.5.7 export story)." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.6" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to export my position roster data, including historical rosters, so that I can perform local analysis and reconcile information with HR systems." ;
	<urn:solutiondesign:ontology:title> "Export Position Roster and Historical Data" .

<urn:solutiondesign:instance:staffing:Req_18_3_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Position Details page shows a version history/audit trail (status updates, end dates, cancelled reasons, user actions, timestamps); prior-year audit details are read-only." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: staff:Seq_UpdatePositionStatus's own keyDecisions say status changes are 'tracked in audit history for compliance reporting,' but no queryable audit-trail entity or endpoint for Positions exists in staffing-domain.ttl/staffing-api.ttl to back a UI view of it — the audit trail is asserted as happening, never modeled as a retrievable node. Same underlying gap as Req_18_1_9's assignment history and Req_18_3_5's historical org-chart view — see the consolidated coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "18.3.7" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to view audit and versioning details for positions so that I can understand how a position has changed over time." ;
	<urn:solutiondesign:ontology:title> "View Versioning / Audit Details for Position Records" .

<urn:solutiondesign:instance:staffing:Req_18_3_8> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Logs total positions carried forward and total excluded; records unexpected errors, flagged for admin review; logging data accessible to authorized support staff." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match: staff:Seq_OpenNewCollection's own content explicitly includes 'Log rollover outcome (counts carried forward, counts excluded, errors)' as a diagram step, and its errorScenarios describe unexpected per-record errors being 'logged and flagged for Staffing Data Admin review; does not block rollover for other records.'" ;
	<urn:solutiondesign:ontology:requirementId> "18.3.8" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to log all actions taken during the creation of the new collection so that system administrators can review the results." ;
	<urn:solutiondesign:ontology:title> "System Logging of Rollover Outcomes" .

<urn:solutiondesign:instance:staffing:Req_18_3_9> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "FTE health indicators recalculated per position on rollover completion; positions with issues visually flagged; indicators don't block user actions but remain visible until corrected." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match: staff:Seq_OpenNewCollection explicitly includes 'Recalculate FTE health indicators and data-quality flags for carried-forward positions.'" ;
	<urn:solutiondesign:ontology:requirementId> "18.3.9" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want the system to show data quality indicators so that I am aware of any positions that require attention before certification." ;
	<urn:solutiondesign:ontology:title> "Display Data Quality Indicators After Rollover" .

<urn:solutiondesign:instance:staffing:Req_18_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Certification page shows workflow steps (Pre-Certification Tasks, Data Quality Review, Justifications, Attestation, Certification) each marked complete/incomplete/blocked; Certify button disabled until all required steps complete; audit details (User ID, timestamp) captured only when a user completes a task or takes an action, not on page view." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match. The 'only log task completion, not page views' clause was itself the subject of a live review-comment exchange (comment 543258739 -> 1502134421): Groom asked whether audit details would be captured 'for the page view, or only when completing tasks,' and Caswell confirmed the intent was the latter and revised the acceptance criterion accordingly — the version modeled here already reflects that resolution, so no separate Annotation is needed." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_GetCertificationStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_CertifyCollection> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to view the certification workflow/status so that I understand what steps remain before I can certify the Position Roster." ;
	<urn:solutiondesign:ontology:title> "View Certification Workflow Status" .

<urn:solutiondesign:instance:staffing:Req_18_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Evaluates pre-certification task completeness on starting certification; displays incomplete tasks; blocks progress to Data Quality Review until addressed; marks tasks Complete once done." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — staff:Seq_CertifyCollection's own 'Pre-certification tasks incomplete' alt-branch blocks quality review exactly this way." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_CertifyCollection> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want the system to verify that all pre-certification tasks are complete so that I can proceed to certification." ;
	<urn:solutiondesign:ontology:title> "Perform Pre-Certification Tasks" .

<urn:solutiondesign:instance:staffing:Req_18_4_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Runs business rule validations for the collection; checks record completeness, lifecycle/dates, status/metadata consistency, historical comparison, cross-record/cross-interface (EEM) alignment; categorizes into Errors/Warnings/Justification-Required; results shown in a structured list; validation output stored in the certification audit record; execution logged with user ID, timestamp, result counts." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — staff:TP_ValidationRuleEngine's own rule-category breakdown (field-level, cross-field, cross-record/collection-level with EEM lookups, historical/trend anomaly detection) covers exactly the check categories this story lists." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RunQualityReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:TP_ValidationRuleEngine> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to run the Quality Review process so that the system can identify errors and anomalies before certification." ;
	<urn:solutiondesign:ontology:title> "System-Generated Data Quality Review (QR Validation)" .

<urn:solutiondesign:instance:staffing:Req_18_4_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Justification-required items shown in a dedicated section; text/structured input per issue; mandatory items clearly marked; certification blocked until all required justifications entered; justifications saved to the certification audit trail; each entry logged with user ID, timestamp, issue ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_SubmitJustifications> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to provide justification for specific data quality issues so that certification can proceed when certain conditions cannot be corrected." ;
	<urn:solutiondesign:ontology:title> "Enter Required Justification for QR Conditions" .

<urn:solutiondesign:instance:staffing:Req_18_4_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Checks for remaining Errors (not Warnings) at certification attempt; blocks and messages if any exist; justification does not substitute for correcting true errors unless specifically flagged as justification-allowed; proceeds to Attestation if none remain; blocked attempts logged with user ID, timestamp, unresolved-error list." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionCannotCertifyWithErrors> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to prevent certification when validation errors are present so that only accurate and validated data is certified." ;
	<urn:solutiondesign:ontology:title> "Prevent Certification When Errors Exist" .

<urn:solutiondesign:instance:staffing:Req_18_4_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Attestation text shown once pre-certification/QR/justifications are complete; user must view (scroll) and affirmatively acknowledge via checkbox or similar; certification blocked until acknowledged; acknowledgement logged with user ID and timestamp." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — staff:CertificationAttestation's own description ('E-signature and timestamp of authorized user certification') and staff:Seq_CertifyCollection's attestation step cover this." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CertificationAttestation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_CertifyCollection> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to review and affirm attestation statements so that I legally acknowledge the accuracy of my district's submission." ;
	<urn:solutiondesign:ontology:title> "Display Attestation / Agreement Text" .

<urn:solutiondesign:instance:staffing:Req_18_4_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On Certify, confirms pre-tasks/QR/justifications/attestation are all satisfied; permanently marks the roster Certified; records become read-only; workflow status updates; generates a certification receipt (District ID, User ID, Timestamp, School year, summary of certification conditions); successful certification logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match for the certification transition itself. Partial gap: staff:Op_CertifyCollection's producesShape is staff:CollectionDefinition — a distinct, structured 'certification receipt' artifact (District ID/User ID/Timestamp/School year/condition summary) as its own document/output isn't separately modeled; the certification event and timestamp are captured, but not as a formatted receipt document. Minor — not raised as its own Annotation, noted per the 'partial satisfaction is normal' rule." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CertifyCollection> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_CertifyCollection> ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to certify the Position Roster so that my district's data is finalized for the collection year." ;
	<urn:solutiondesign:ontology:title> "Certify the Position Roster" .

<urn:solutiondesign:instance:staffing:Req_18_4_8> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Editing/deletion of certified records prevented; attempted modification shows a certified-collection message; view-only access allowed; reopening by Staffing Data Admin marks data editable again and logs the reopening." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — staff:CollectionState_Certified is a real, isTerminal StateDefinition, and staff:Seq_CertifyCollection's own steps include 'Lock all records in collection (read-only except via reopen).' The reopen-logging half connects to the same Req_18_3_10 partial gap noted above (state modeled, dedicated reopen-action sequence not modeled)." ;
	<urn:solutiondesign:ontology:requirementId> "18.4.8" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionState_Certified> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_CertifyCollection> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to lock certified position roster data so that it remains immutable unless the collection is formally reopened." ;
	<urn:solutiondesign:ontology:title> "Lock Data After Certification" .

<urn:solutiondesign:instance:staffing:Req_18_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Select records on the Positions screen, select Update; navigate to file staging area; file-upload control accepts CSV/XML; standard file-upload processing applied; each record validated for a required Job Identifier; unsupported/unreadable file format errors and blocks processing; upload attempts (success or failure) logged with timestamp and user ID." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no bulk-file-upload sd:ApiOperation or sd:Sequence exists anywhere in staffing-api.ttl/staffing-sequences.ttl for Positions (or for any Staffing aggregate) — every modeled operation is a single-record REST call. Genuine coverage gap; see the consolidated Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.1" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to upload a bulk file containing position updates so that I can update the Position Roster without manually editing each position." ;
	<urn:solutiondesign:ontology:title> "Upload Bulk File for Position Updates" .

<urn:solutiondesign:instance:staffing:Req_18_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Processes all records with standard file-ingestion rules; updates all position-related data elements per the file; identifies positions by Job Identifier; logs each processed update; reflects updates immediately in the roster." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same gap as Req_18_5_1." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to process bulk file uploads so that all components of a position can be updated at once." ;
	<urn:solutiondesign:ontology:title> "Process Bulk File and Update Position Components" .

<urn:solutiondesign:instance:staffing:Req_18_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Validates each record individually; applies passing records; rejects and lists failing records with error messages; generates a downloadable/viewable validation report of successes and rejections." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same gap as Req_18_5_1." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to validate all bulk file records and allow partial success so that valid updates can proceed even when some records contain errors." ;
	<urn:solutiondesign:ontology:title> "Validate Bulk File Records and Allow Partial Success" .

<urn:solutiondesign:instance:staffing:Req_18_5_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Presents a summary of detected changes when the file differs from current values; requires user confirmation; no updates on cancel; proceeds with valid/invalid split on confirm; confirmations/cancellations logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same gap as Req_18_5_1." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.4" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to review changes detected during the bulk file upload so that I can confirm the updates before they are applied." ;
	<urn:solutiondesign:ontology:title> "Display Proposed Changes Before Finalizing Upload (Alternative Flow)" .

<urn:solutiondesign:instance:staffing:Req_18_5_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Receives payload via established connection rules from an authorized external HR system; applies standard ingestion/validation; updates position and employee components per payload; validates each record individually; valid records update, invalid records trigger standard API error messaging; transactions logged with timestamp, external system identifier, success/error status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial satisfaction: staffing-api.ttl's own file header explicitly documents that several operations, including these three, list 'x-access: [internal-user, external-client]' — i.e. they ARE already callable by an external HR/SIS system on a district's behalf, which is the mechanism this story actually describes for single-record submissions. What's genuinely missing is any BATCH/bulk-payload variant of this (a single API call updating many positions/employees at once, as opposed to one call per record) — grouped with the Feature 18.5 bulk Annotation below for that narrower gap." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePositionStatus> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to accept position and employee data from an external HR system via API so that the Position Roster can be updated programmatically." ;
	<urn:solutiondesign:ontology:title> "Accept Position & Employee Data via API" .

<urn:solutiondesign:instance:staffing:Req_18_5_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Validates all incoming API records against Position Roster rules; rejects erroring records with standardized error messages; valid records update the roster; validation results included in the API response; error responses don't block processing of other valid records; all outcomes logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial satisfaction, same basis as Req_18_5_5: the external-client-accessible single-record operations do return standard validation errors (400 Bad Request per staff:Seq_CreateNewPosition/Seq_UpdatePositionStatus), but there is no batch-submission response shape (per-record success/error array within one API response) to satisfy the 'partial successes in one call' half of this story." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePosition> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdatePositionStatus> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to validate API-submitted records and return error messages so that external systems can correct issues." ;
	<urn:solutiondesign:ontology:title> "Validate API Submissions and Return Errors" .

<urn:solutiondesign:instance:staffing:Req_18_5_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Export options match upload-allowable formats (CSV, XML); exported data includes all fields needed for the bulk template; export logged with user ID and timestamp; export matches current roster state; file structured for upload compatibility." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: identical underlying gap to Req_18_3_6 — no export/download operation exists in staffing-api.ttl. Grouped with it in the coverage-gap Annotation below rather than duplicated." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.7" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want to download the position roster data in formats that match the upload options so that I can update the file offline and re-upload it." ;
	<urn:solutiondesign:ontology:title> "Download Roster Data in Upload-Compatible Formats" .

<urn:solutiondesign:instance:staffing:Req_18_5_8> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Same validation rules apply to online, bulk, and API updates; identical outcomes regardless of input method; conflicts between methods resolved consistently (e.g. later submission wins within the working window); all updates tracked in the audit log with method source (online/bulk/API)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this story presupposes the bulk-file and batch-API paths exist to BE consistent with the online path — since neither is modeled (see the Feature 18.5 bulk-ingestion Annotation above), there is nothing yet to reconcile. Grouped into that same Annotation rather than treated as an independent gap." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.8" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want consistent update rules across online editing, bulk file uploads, and API submissions so that the Position Roster behaves predictably regardless of method." ;
	<urn:solutiondesign:ontology:title> "Maintain Consistency Across Online, Bulk File, and API Updates" .

<urn:solutiondesign:instance:staffing:Req_18_5_9> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Bulk uploads logged with user ID, file name, timestamp, processing result; API submissions logged with external system ID, timestamp, processing result; logs capture both successes and rejections; logs accessible to authorized admin users for audit purposes." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy for the bulk-file half (same missing surface as Req_18_5_1); the API half is partially covered by the general logging behavior on the existing single-record external-client operations, but there is no distinct bulk/API-specific log view. Grouped into the Feature 18.5 bulk-ingestion Annotation above." ;
	<urn:solutiondesign:ontology:requirementId> "18.5.9" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to log all update actions performed via bulk file and API so that data traceability and audit compliance are maintained." ;
	<urn:solutiondesign:ontology:title> "Log All Data Input Actions" .

<urn:solutiondesign:instance:staffing:Req_18_6_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Sends email via a Staffing-Data-Administrator-defined template when a deadline threshold is met; identifies authorized recipients; email includes the deadline date and a link to the submission area; also shown as a dashboard alert; notifications logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:requirementId> "18.6.1" ;
	<urn:solutiondesign:ontology:statement> "As an Authorized User, I want to receive an email notification about upcoming deadlines so that I can ensure the Position Roster is submitted on time." ;
	<urn:solutiondesign:ontology:title> "Notify User of Upcoming Deadlines" .

<urn:solutiondesign:instance:staffing:Req_18_6_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Triggers a communication event on new post-validation/QR errors or warnings; sends templated email directing the user to the issue location; shows a dashboard alert; both logged for audit." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:requirementId> "18.6.2" ;
	<urn:solutiondesign:ontology:statement> "As an Authorized User, I want to receive communication alerting me to new data quality issues that require my review." ;
	<urn:solutiondesign:ontology:title> "Alert User to Newly Identified Data Quality Issues" .

<urn:solutiondesign:instance:staffing:Req_18_6_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Sends templated email directing to the relevant workflow step when action is required; places a conspicuous dashboard action item; alert persists until the task is complete; notifications logged with the required-action type." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:requirementId> "18.6.3" ;
	<urn:solutiondesign:ontology:statement> "As an Authorized User, I want the system to communicate when my specific action is required on the Position Roster data so that I can complete the workflow." ;
	<urn:solutiondesign:ontology:title> "Notify User When Action Is Required" .

<urn:solutiondesign:instance:staffing:Req_18_6_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Dashboard alert generated for upcoming deadlines, new data quality issues, or required action; appears prominently in the dashboard alerts area; each alert links to the relevant workflow section; persists until resolved; creation/resolution logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:requirementId> "18.6.4" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must use alerts displayed on dashboards to draw attention to critical action items so that users can quickly identify urgent tasks." ;
	<urn:solutiondesign:ontology:title> "Display Dashboard Alerts for Critical Action Items" .

<urn:solutiondesign:instance:staffing:Req_18_6_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Outgoing emails logged with sender system ID, recipient, timestamp, template used; dashboard alerts logged with timestamp, type, triggering condition; logs accessible only to authorized admin staff; retained per state/agency standards." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:requirementId> "18.6.5" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to log all communications and dashboard alerts so that audit compliance and data traceability are maintained." ;
	<urn:solutiondesign:ontology:title> "Log All Communications and Alerts" .

<urn:solutiondesign:instance:staffing:Req_18_BizSpec_DuplicatePosition> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "User may edit or modify a copied/duplicated position prior to submission; a copied/duplicated position can be deleted prior to submission; once successfully submitted, it may not be deleted." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd18Doc> ;
	<urn:solutiondesign:ontology:notes> "This is a real, wireframe-independent Business Specifications feature (own paragraph, own save/delete-before-submission rules distinct from 18.2.3's general working-window-deletion rule) that was never given its own Feature/story number in the Addendum's 18.1-18.6 breakdown — the same situation FDD 29's review found for three of its own Business-Specifications-only capabilities. No satisfiedBy: no 'duplicate/copy position' operation or sequence step exists anywhere in staffing-api.ttl/staffing-sequences.ttl — staff:Op_CreatePosition creates from a blank form only. Genuine coverage gap." ;
	<urn:solutiondesign:ontology:requirementId> "BizSpec (unnumbered)" ;
	<urn:solutiondesign:ontology:statement> "As a School District User, I want the option to 'duplicate' or 'copy' an existing position to create a new position, so that I don't have to re-enter shared metadata for a similar role." ;
	<urn:solutiondesign:ontology:title> "Duplicate/copy an existing position" .

<urn:solutiondesign:instance:staffing:Req_21_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Landing page (Dashboard > Roster of Employees) lists current and historical employees with columns Unique ID/Name/Start Date/Position/Building/Credentialed/Employment Status; list is downloadable as Doc/Excel/PDF and filterable on all columns; an 'Add Employee' single-select dropdown offers 'Add individual Employee' and 'Upload Roster'; Upload Roster shows a CSV-upload modal; Add Individual Employee first searches by name/UID, shows results with advanced filters, and offers 'Create New Employee' if no match is found." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match on the list/search/add-employee shape (Wireframe21_3, Wireframe21_4, WireframeAddendumA21 all confirm this screen). Two things this story describes with no counterpart anywhere in staffing-api.ttl: (1) Doc/Excel/PDF export of the list — no export/download sd:ApiOperation exists for Employee Roster (staffing-api.ttl has no 'download' or 'export' operation at all); (2) the 'Upload Roster' CSV-upload modal itself — see Req_21_5_1/21_5_2's notes on staff:Perm_EmployeeRosterBulkUpload existing with no backing endpoint, the same underlying gap surfacing here from the landing-page-UI side. Not raised as a separate Annotation per item (both are narrow, and the bulk-upload gap already has its own Annotation below); noted here as partial satisfaction." ;
	<urn:solutiondesign:ontology:requirementId> "21.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ListEmployees> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_SearchEmployees> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want to add the Employment Data details to the Roster of Employees, so that I can maintain a list of all the current and historical employees." ;
	<urn:solutiondesign:ontology:title> "Add Employment Data details to the Roster of Employees (landing page)" .

<urn:solutiondesign:instance:staffing:Req_21_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "From the Name-column hyperlink in search results, show Name/Unique ID/DOB/Gender/School ID plus tabs (Demographic Information, Credentials, Employment, Professional Development, Education); Demographic Information tab shows Personal Information, Contact Information, and an Account Information History table, editable via 'Edit Details'; Credentials tab shows Active and Inactive/Suspended/Expired credentials across Certificates/Permits/Career Authorization/Employment/Special Education Approvals sub-tabs; Employment tab shows Current Employment and Employment History (Assignment/Meets Requirements/SCED Course Title/Start Date/Allocation/Status); user confirms demographic details, then sees a confirmation page after adding to roster." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match for the search-then-add path (Wireframe21_1/21_2 for the Employment tab detail, WireframeAddendumB21 for Demographic Information, WireframeAddendumD21 for the Employment tab). The Credentials/Professional Development/Education tabs are cross-domain UI composition over Credentialing- and ProfLearning-owned data (cred:Op_GetEducatorCredentials is staffing's own existing documented dependency for the Credentials-tab-equivalent data; no separate Staffing-side node models the composed multi-tab view itself) — not a Staffing coverage gap, just data the tab pulls from elsewhere. Comment id12 (Sinha, 'SOM Internal- Need to review for new/existing ID workflow') is an internal process-review note, not a content finding, and doesn't change any AC text. Comment id14 (Groom: 'These fields will not be entered by the business user. Citizen account has ability to add this data if/when they create their own account.') anchored to this story's Personal Information field list clarifies that these particular demographic fields are typically citizen-originated (via self-registration), with the district user only viewing/confirming rather than originating them here — consistent with this story covering an individual who ALREADY has a Unique ID (i.e. already resolved through the identity process), unlike 21.1.3's from-scratch entry." ;
	<urn:solutiondesign:ontology:requirementId> "21.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_GetEmployeeDemographics> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AddNewEmployee> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want to add the Employment Data details of individuals who have been assigned a Unique ID, so that I can establish the employment record for individuals whose identity has been validated." ;
	<urn:solutiondesign:ontology:title> "Add employment data for an individual who already has a Unique ID" .

<urn:solutiondesign:instance:staffing:Req_21_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Offered when no search results match; user enters Personal/Contact Information (no Unique ID field, since none exists yet); submission runs the Mi-Key matching algorithm; user sees a processing page, then a confirmation page, then can go to the user profile page; from the rostered employee's Employment tab the user can End Employment (modal: Start Date pre-filled, End Date, Separation Reason, Additional Remarks) or Add Assignment (modal: Type/Category/Position/SCED Course ID/Building/Grade Levels/FTE Allocation/Start Date, an expedited flow limited to selecting existing positions, not creating new ones); the record can be saved in Pending status with required employment fields missing, retaining the in-progress identity resolution; from Credentials the user can apply for Certificate/Permit/Career Authorization/Special Education Approval (link to be attached once available)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Mi-Key matching, processing-page-then-confirmation flow, and Pending-status-while-identity-resolves are all a direct match to staff:Seq_AddNewEmployee's 'No match - create new record' branch and staff:Op_ResolveNearMatch/staff:Op_RequestNewId (WireframeAddendumC21, WireframeAddendumD21 confirm the confirmation screen and the End Employment/Add Assignment modals). The Add Assignment modal itself is explicitly out of scope here per comment id15 ('This is defined within Epic 22. Employee Assignment Details.') — consistent with this FDD's own Dependencies section pointing Assignment Details at FDD 22, not re-raised as a separate Annotation. SEE Question_NewEmployeeWithoutIdContradiction below for a genuine, still-open contradiction between this story's own premise and a reviewer comment on the very same paragraph." ;
	<urn:solutiondesign:ontology:requirementId> "21.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RequestNewId> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ResolveNearMatch> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AddNewEmployee> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want to add the Employment Data details of individuals who have not been assigned a Unique ID, so that I can establish the employment record for individuals who are not present in the system." ;
	<urn:solutiondesign:ontology:title> "Add employment data for an individual with no Unique ID yet" .

<urn:solutiondesign:instance:staffing:Req_21_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Validate the individual's record for restricting PPR flags on submission. Reviewed-Listed disclosure status: hard-block addition with a specific error message directing the district to IChat for questions. Reviewed-Felony disclosure status: halt addition until the district completes a felony disclosure form, with a specific error message. Under PPR Review / PPR Document Hold / PPR Hold statuses: trigger a general-roster alert plus an application-delay-warning alert (directing questions to MDE-Professional-Practice@Michigan.gov), rather than a hard block. Display an error to the user whenever PPR flags prevent the addition." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Excellent, near-verbatim cross-domain match, not a gap: profpractice-domain.ttl's Rule_RosterEligibilityAssessment (Reviewed-Listed -> Ineligible hard block; Reviewed-Felony -> EligibleWithNotification/acknowledgment; active-review statuses -> Ineligible/alert) and Rule_ReviewedListedAbsoluteBlock use the identical named statuses this story lists, and staff:Seq_AddNewEmployee already models the blocking GET /educators/{uniqueId}/roster-eligibility call with a 403 Forbidden branch. Comment id1926732478 (Sinha, reply to id17): 'I have updated the user story to explicitly define the PPR statuses mapped out in Epic 9. The Acceptance Criteria now details the hard stop for the Reviewed; Listed status, the conditional stop requiring a disclosure form for the Reviewed; Felony status, and the specific warning alerts...' confirms the visible AC text above already reflects this alignment work — not a live open item. Comment id2020987456 ('Clarification needed; Comment chain in Epic 9') anchored near the Reviewed-Felony error text remains open but points back into Epic 9's own review thread, not something resolvable from this FDD's side." ;
	<urn:solutiondesign:ontology:requirementId> "21.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetRosterEligibilityAssessment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_ReviewedListedAbsoluteBlock> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_RosterEligibilityAssessment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_EvaluateRosterEligibility> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AddNewEmployee> ;
	<urn:solutiondesign:ontology:statement> "As the system, I must prevent the addition of an employee to the roster if they have PPR flags that restrict employment, issuing an error, so that the organization remains compliant by not hiring restricted individuals." ;
	<urn:solutiondesign:ontology:title> "Prevent adding an employee with employment-restricting PPR flags" .

<urn:solutiondesign:instance:staffing:Req_21_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Validate all submitted data elements against defined criteria; set status to Active on success; make employment data elements Read Only once Active; make an Update button available to modify the now-Read-Only data." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — Wireframe21_1/21_2 are a literal before/after pair (editable form vs. read-only with an Update button in the header) confirming exactly this behavior." ;
	<urn:solutiondesign:ontology:requirementId> "21.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmpRosterState_Active> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:statement> "As the system, I must set the record status to 'Active' upon successful submission when all required fields meet criteria, so that the initial employment record is finalized and protected as Read Only." ;
	<urn:solutiondesign:ontology:title> "Set record to Active and lock as Read Only on successful submission" .

<urn:solutiondesign:instance:staffing:Req_21_1_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Re-add a previously-terminated-in-the-same-district individual only if a new Date of Hire is supplied; the new Date of Hire must be chronologically after both the original Date of Hire and the original termination (Employment End) date, flagging an error otherwise; reject any submission that exactly matches a previous termination record (same district, same terminated status, no new Date of Hire); the previous record must be terminated before the individual can be re-added." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: nothing in staffing-domain.ttl models termination-record deduplication, exact-match rejection, or a chronological Date-of-Hire-vs-prior-termination check — staff:EmployeeRecord's own description only covers 'status, start/end dates, separation reason' as plain fields, with no BusinessRule instance addressing re-hire/re-add semantics (contrast with the 12 BusinessRule instances staffing-domain.ttl does have, none of which cover this). Comment id19/id1327490318 ('Business Rule Validation- Date of Hire must be after the original date of hire/comparison with original term date' / 'This has been added') shows this AC text was added to the FDD in response to review, but 'added' here means added to the FDD's own acceptance-criteria text, not built anywhere in the domain model — this is a genuine, still-open coverage gap, not a resolved item. See the coverage-gap Annotation below (grouped with Req_21_2_4, the related End-Date-after-Start-Date chronological check, since both are employment-date-ordering validations entirely absent from staff:EmployeeRosterAggregate's modeled invariants)." ;
	<urn:solutiondesign:ontology:requirementId> "21.1.6" ;
	<urn:solutiondesign:ontology:statement> "As the system, I must prevent the user from re-adding a previously terminated record (same district, terminated) unless a new Date of Hire is provided (rejecting exact termination matches), so that accurate employment history is maintained and new periods of employment are properly recorded." ;
	<urn:solutiondesign:ontology:title> "Prevent re-adding a previously terminated record without a new Date of Hire" .

<urn:solutiondesign:instance:staffing:Req_21_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Require authorized access rights to modify roster data; provide an interface to change employment details of records currently in Active status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:requirementId> "21.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdateEmploymentStatus> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want the system to allow me to edit the employment details of active individuals on the Employee Roster, so that I can maintain current employment information for personnel already added to the system." ;
	<urn:solutiondesign:ontology:title> "Edit employment details of an Active employee" .

<urn:solutiondesign:instance:staffing:Req_21_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The edit function allows input of Employment End Date and Employment Separation Reason." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "staff:Op_UpdateEmploymentStatus's own projection note ('if terminating, endDate and separationReason must both be present or both absent') already captures exactly this pairing." ;
	<urn:solutiondesign:ontology:requirementId> "21.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmploymentSeparationReason> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdateEmploymentStatus> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want to be able to add termination information (Employment End Date and Employment Separation Reason) to an employee record, so that the employee's end of employment can be accurately reported." ;
	<urn:solutiondesign:ontology:title> "Add termination information to an employee record" .

<urn:solutiondesign:instance:staffing:Req_21_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "If End Date is submitted without Separation Reason (or vice versa), the submission results in an Error status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact match — the rule's statement is essentially a direct restatement of this story's acceptance criteria." ;
	<urn:solutiondesign:ontology:requirementId> "21.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_EmploymentEndDateSeparationReasonCorequirement> ;
	<urn:solutiondesign:ontology:statement> "As the system, I must validate that if the Employment End Date is provided, the Employment Separation Reason is also submitted, so that complete separation details are captured when an employee is terminated." ;
	<urn:solutiondesign:ontology:title> "Require Employment End Date and Separation Reason together" .

<urn:solutiondesign:instance:staffing:Req_21_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Employment End Date must occur after the original Employment Start Date (Date of Hire); the system prevents submission and flags an Error if End Date is on or before the existing Start Date." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this is a plain chronological field-validation rule (End Date > Start Date on the SAME record) with no corresponding BusinessRule, invariant, or documented API-level validation anywhere in staffing-domain.ttl/staffing-api.ttl — staff:EmployeeRosterAggregate's invariants list covers required-field co-requirements (Rule_EmploymentEndDateSeparationReasonCorequirement) but not date ordering. Grouped with Req_21_1_6 in the coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "21.2.4" ;
	<urn:solutiondesign:ontology:statement> "As the system, I must ensure the Employment End Date is subsequent to the original Employment Start Date, so that data integrity regarding the employment period is maintained." ;
	<urn:solutiondesign:ontology:title> "Require Employment End Date to be after the original Employment Start Date" .

<urn:solutiondesign:instance:staffing:Req_21_2_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Successful validation/submission of changes transitions the data to Read Only display; an Update button is made available and clickable for future modifications." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Same Read-Only-plus-Update-button shape as Req_21_1_5, now for the edit path rather than initial add; Wireframe21_2 corroborates both equally." ;
	<urn:solutiondesign:ontology:requirementId> "21.2.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmpRosterState_Active> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdateEmploymentStatus> ;
	<urn:solutiondesign:ontology:statement> "As the system, I must display the updated employee details as Read Only upon successful submission, with an 'Update' button available for subsequent changes, so that the finalized data is protected and ready for future modification." ;
	<urn:solutiondesign:ontology:title> "Display updated employee details as Read Only after a successful edit" .

<urn:solutiondesign:instance:staffing:Req_21_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Dashboard > Employment > Data Collection & Submission page with 'Submit New Collection' (auto-labeled by school year, e.g. 'Fall 2025 Data Collection', with a checklist and a Start/Continue Employment Data Submission button) and 'Past Submissions' tabs (a filterable, Doc/Excel/PDF-downloadable table); validate the user's authorized access to the entity; the created roster is the official mechanism for reporting employment details for the year; clicking an employee's Name hyperlink opens a details drawer (Name, Certificate Number/Type, National Board Certified, Renewal Status, Endorsements, Certificate History, Assignment, Remarks/Comments); the user can submit the roster after making changes." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match on the collection-creation shape (WireframeAddendumE21 confirms the Data Collection & Submission landing page; WireframeAddendumG21 confirms the Employee Details drawer). As WireframeAddendumG21's own notes discuss, the drawer's Certificate/Endorsement/Certificate-History content is cross-domain UI composition over Credentialing data, not a Staffing-side gap. As with Req_21_1_1, the Doc/Excel/PDF download option on Past Submissions has no backing sd:ApiOperation anywhere — same narrow export-capability gap noted there, not repeated as its own Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "21.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ListCollections> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want the system to establish a process for creating a school year Employee Roster, so that the details of employed individuals can be reported throughout the year." ;
	<urn:solutiondesign:ontology:title> "Establish a process for creating a school year Employee Roster" .

<urn:solutiondesign:instance:staffing:Req_21_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The new collection automatically imports all previously-Active employee records; no manual intervention required." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Exact, pre-existing match — Rule_CollectionRolloverCarriesForward's statement and CollectionOpenedEvent's own carriedForwardCount payload field describe precisely this behavior; this FDD confirms an already-modeled rule rather than surfacing a new one." ;
	<urn:solutiondesign:ontology:requirementId> "21.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionOpenedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionRolloverCarriesForward> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As the system, I must automatically include all employee records active at the end of the previous school year collection in the new roster, so that the new school year-based Employee Roster is efficiently populated." ;
	<urn:solutiondesign:ontology:title> "Automatically carry forward active employee records into the new collection" .

<urn:solutiondesign:instance:staffing:Req_21_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Records with BOTH End Date and Separation Reason in the prior collection are filtered out of the new roster; only terminated records meeting this dual criterion are excluded." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Same exact-match relationship as Req_21_3_2 — CollectionOpenedEvent's excludedCount payload field is this criterion's own counter." ;
	<urn:solutiondesign:ontology:requirementId> "21.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CollectionOpenedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionRolloverCarriesForward> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "As the system, I must automatically exclude employee records that have both an Employment End Date and Employment Separation Reason reported in the previous submission, so that only continuing employees are included in the new collection." ;
	<urn:solutiondesign:ontology:title> "Automatically exclude fully-terminated records from the new collection" .

<urn:solutiondesign:instance:staffing:Req_21_3_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Set status to Pending when Start Date or Employment Status hasn't been submitted; allow completing Mi-Key identity matching and assigning a Unique ID while still Pending; prevent finalizing (certifying) the Roster while any records remain Pending; move Pending to Active only once all required initial-hire fields are submitted and pass validation." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Pending/Active states and the identity-resolution-while-Pending sequencing are a direct match. One nuance worth flagging (not a full gap): this story's 'prevents a user from finalizing the Employee Roster if any records remain in Pending status' criterion is not explicitly named among staff:CollectionAggregate's own invariants, which state only that 'Collection cannot be certified with any Error-status records' (Rule_CollectionCannotCertifyWithErrors) — Pending is a distinct, non-terminal EmpRosterState from Error, so it's not certain the modeled certify-block actually also covers Pending records the way this story requires. Not raised as a separate Annotation given how narrow it is, but worth a reviewer's eye if staff:Rule_CollectionCannotCertifyWithErrors is ever revised." ;
	<urn:solutiondesign:ontology:requirementId> "21.3.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmpRosterState_Active> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmpRosterState_Pending> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AddNewEmployee> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce system, I want to save an employee record in Pending status with incomplete employment details, so that I can establish a Unique ID while the authorized user enters official start dates or contractual statuses." ;
	<urn:solutiondesign:ontology:title> "Save an employee record in Pending status while identity resolution completes" .

<urn:solutiondesign:instance:staffing:Req_21_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Set Error status when field validation criteria aren't met (e.g. End Date before Date of Hire); let the user acknowledge errors via a 'Data Contains Errors' alert before submitting; show sections for Employees Not Appropriately Placed, Employees with No Assignment, Changes to Employee Roster, Required Positions with No Assignments, Buildings with No Appropriate Positions, Changes to Positions, and All Employees, each filterable and downloadable (Word/Excel/PDF); mark a record Error if the user cancels an update on a record missing mandatory data; restrict certifying the collection while any record is in Error status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match: Rule_CollectionCannotCertifyWithErrors is an exact match for the certify-blocked-by-Error criterion; Rule_ActiveEmploymentRequiresAssignment is an exact match for the 'Employees with No Assignment' dashboard section; Rule_CredentialMatchingForAdminInstructional/Rule_EndorsementAlignmentForTeaching are the underlying 'appropriate placement' checks behind 'Employees Not Appropriately Placed.' Genuinely partial, though: the SEVEN individual dashboard sections this story names are not each modeled as distinct queryable operations — staff:QualityReviewResult is one generic DomainEntity covering the whole quality-review output, not seven separately-addressable report shapes, and 'Required Positions with No Assignments'/'Buildings with No Appropriate Positions'/'Changes to Positions' lean on PositionRosterAggregate/organizations-domain concepts (EEM 'Open' building status) not individually cross-checked in this pass. As WireframeAddendumF21's own notes describe, the wireframe itself literally places a 'Power BI Charts?' placeholder over this content — corroborating from the source's OWN design artifact that this section's actual reporting mechanism was still unsettled, not just under-modeled on the Staffing side. Doc/Excel/PDF export again has no backing operation (same recurring gap as Req_21_1_1/21_3_1)." ;
	<urn:solutiondesign:ontology:requirementId> "21.4.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RunQualityReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:QualityReviewResult> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_ActiveEmploymentRequiresAssignment> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionCannotCertifyWithErrors> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CredentialMatchingForAdminInstructional> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_EndorsementAlignmentForTeaching> ;
	<urn:solutiondesign:ontology:statement> "As an Authorized User, I want to identify and correct records marked with an 'Error' status, so that I can resolve data inconsistencies and logic failures before the collection certification deadline." ;
	<urn:solutiondesign:ontology:title> "Identify and correct Error-status records before certification" .

<urn:solutiondesign:instance:staffing:Req_21_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Enable Quality Review only once pre-certification tasks are complete: all employment/assignment details updated; no records in error/pending status; legally-required building-level roles present per EEM (certification blocked if an open building has no reported staff); Data Quality Dashboard anomalies reviewed; mandatory text justification for specific warnings/errors; high-stakes summary reports reviewed. Display Quality Review results on screen, identifying specific flagged records." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Core review-then-justify-then-certify flow is a direct match (Wireframe21_5/21_6/21_7 confirm the screen and its confirm/success states). Two named pre-certification inputs are cross-domain/stub territory, not Staffing gaps per se: the EEM 'open building must have reported staff' check depends on orgs:BuildingsLookupOperation (already staffing's own documented Dependency, itself flagged with a mechanism discrepancy in staffing-domain.ttl's own header); the 'Data Quality Dashboard' review step points at dq:DataQualityContext, a stub-only bounded context per mied-v3/CONVENTIONS.md's registry with no real conversion anywhere — consistent with GAPS.md's expectation that Data Collection & Compliance FDDs often reference not-yet-modeled stub contexts." ;
	<urn:solutiondesign:ontology:requirementId> "21.4.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_GetCertificationStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RunQualityReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_SubmitJustifications> ;
	<urn:solutiondesign:ontology:statement> "As an Authorized User, I want to trigger a Quality Review of the Employee Roster, so that I can identify collection-level errors and warnings before final certification." ;
	<urn:solutiondesign:ontology:title> "Trigger a Quality Review before final certification" .

<urn:solutiondesign:instance:staffing:Req_21_4_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Show warnings, visually distinct from errors and non-blocking, for: employees reported across multiple districts; no new employees added since the last 30-day certification; no terminations reported since the last 30-day certification; apparent overreporting of a single Employment Status; all terminated employees sharing the same End Date; the same Separation Reason reported for all separating employees. User may proceed after acknowledging; acknowledgment is logged and stored in the roster's audit history." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "The six named warning scenarios are a near-verbatim match to the Business Specifications section's own 'Employee Collection Cert Level' warning table (same six conditions, same wording), so this story is internally confirmatory of the FDD's own earlier prose rather than introducing new scope. Comment id24 ('Verbiage for each warning is to be confirmed') remains open on the exact user-facing wording, but the underlying error-vs-warning distinction and non-blocking behavior are already modeled via Op_RunQualityReview/QualityReviewResult — not treated as a coverage gap, just unfinished copy." ;
	<urn:solutiondesign:ontology:requirementId> "21.4.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CertificationAttestation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RunQualityReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:QualityReviewResult> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want to see clear warning messages during Employee Roster review and certification, so that I am aware of potential data quality issues and can make informed decisions before submitting the roster." ;
	<urn:solutiondesign:ontology:title> "Show non-blocking warning messages during review and certification" .

<urn:solutiondesign:instance:staffing:Req_21_4_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Set/display status (Pending/Error/Active) based on submission state and validation results, per the same Pending/Error/Active semantics as Feature 21.1; Save-or-Cancel option; Active records become Read Only with an Update action available; user can save Pending, correct-and-resubmit Error, and view status transitions over time." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "This story restates Req_21_1_5/21_1_6's status-lifecycle acceptance criteria essentially verbatim, now framed as roster-wide monitoring rather than a single record's submission — same satisfiedBy targets apply; not treated as introducing distinct new scope." ;
	<urn:solutiondesign:ontology:requirementId> "21.4.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmpRosterState_Active> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmpRosterState_Error> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmpRosterState_Pending> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdateEmploymentStatus> ;
	<urn:solutiondesign:ontology:statement> "As an authorized Business User, I want to view the status of the Roster of Employees submission, so that I can monitor the current progress of the collection and know the state of the submitted data." ;
	<urn:solutiondesign:ontology:title> "View Roster of Employees submission status" .

<urn:solutiondesign:instance:staffing:Req_21_4_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Allow a user to 'send'/'push' submitted employee data to entities within their established hierarchy (PSA Education Management Companies, PSA Charter Authorizers, ISD/RESA hierarchies); generate an Action Item in the receiving entity's worklist; the receiving entity reviews core person data and confirms the individual is their employee; on confirmation, the employee is added to the receiving entity's Employee Roster; display a visual indicator that the record was received from another entity." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: nothing in staffing-domain.ttl, staffing-api.ttl, staffing-sequences.ttl, or staffing-permissions.ttl models sending/pushing an employee record to another entity, a receiving-entity worklist Action Item, a cross-entity confirmation step, or a 'received from another entity' indicator — no Aggregate, Permission, ApiOperation, Sequence, or DomainEvent addresses this at all (the closest concept, orgs:BuildingsLookupOperation's 'EEM hierarchy,' is about validating buildings within ONE entity's own organizational chart, not sharing an employee ACROSS entities). This is described in real detail (5 concrete acceptance criteria) for a specific, named multi-entity staffing scenario (shared speech therapists/substitutes across PSA/ISD hierarchies) — a substantive, high-impact gap, not a one-line aside. Comment id824067289 ('Need to add details') on this exact story suggests even the FDD's own reviewers considered it underspecified relative to how central it is. See the coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "21.4.5" ;
	<urn:solutiondesign:ontology:statement> "As a Business User (such as an ISD or PSA Management Company user), I want to push employee records to other entities within my established organizational hierarchy, so that shared staff (e.g., speech therapists or daily substitutes) can be added to multiple district rosters without requiring duplicate data entry." ;
	<urn:solutiondesign:ontology:title> "Push employee records to entities within an organizational hierarchy" .

<urn:solutiondesign:instance:staffing:Req_21_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Provide a file-upload option and file-type selection; support bulk submission via file upload; require authorization to submit for the entity; support direct online entry; accept structured, consumable file formats (not flat text); support automated submission through API service connections to HR systems; maintain open API endpoints for current/future HR-system integration via the Data Hub; design processing queues to handle both API streams and uploaded files consistently; align file-format decisions with future API integration." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Online entry is well covered (Op_AddEmployee). File upload and the HR-system/'Data Hub' API-integration path are only PARTIALLY covered: staff:Perm_EmployeeRosterBulkUpload exists (staffing.employee-roster.bulk-upload) but — per that permission's own pre-existing note in staffing-permissions.ttl — has no matching sd:ApiOperation anywhere in staffing-api.yml/staffing-api.ttl at all; a 'processing queue' concept for either file uploads or API streams is likewise entirely absent from staffing-technical-design.ttl. This is a pre-existing, already-documented gap in the staffing conversion (not new to this pass), independently confirmed here by an FDD that describes the missing capability in detail. The 'Data Hub' as a named integration surface doesn't correspond to any bounded context or ExternalSystem in mied-v3's registry either." ;
	<urn:solutiondesign:ontology:requirementId> "21.5.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_EmployeeRosterBulkUpload> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce system, I must be designed to support flexible and scalable data submission methods—including online entry, file uploads, and future API connections—so that educating organizations and integrated HR systems can seamlessly submit Employee Roster data through the Data Hub without requiring manual intervention." ;
	<urn:solutiondesign:ontology:title> "Support online entry, file upload, and API-based data submission" .

<urn:solutiondesign:instance:staffing:Req_21_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: a staging/review-before-commit step for bulk-uploaded data has no counterpart anywhere in staffing-domain.ttl/staffing-api.ttl/staffing-sequences.ttl — consistent with there being no bulk-upload sd:ApiOperation at all (see Req_21_5_1). Comment id26 (Groom, on the parent 21.5.1 paragraph: 'Does this need to include file processing post upload? (i.e. error results, and updating of individual records?)') with reply id710379547 (Sinha: 'This user story does not particularly address file processing post upload. It is added as a new user story 21.5.2.') documents exactly how this story came to exist — a reviewer noticed the gap directly, and it was split out as its own story rather than folded into 21.5.1, which is why it's modeled as a distinct Requirement here too. Coverage gap, not out-of-scope: this reads as intended future scope for the same not-yet-built bulk-upload pipeline, not a deliberately rejected idea." ;
	<urn:solutiondesign:ontology:requirementId> "21.5.2" ;
	<urn:solutiondesign:ontology:statement> "As a Business User submitting roster data via bulk upload, I want to review the processing results and validation errors in a staging area before committing, so that I can ensure only accurate data updates the individual employee records." ;
	<urn:solutiondesign:ontology:title> "Review bulk-upload processing results in a staging area before committing" .

<urn:solutiondesign:instance:staffing:Req_21_6> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd21Doc> ;
	<urn:solutiondesign:ontology:notes> "Not narrative ('As a...') form — modeled as plain sd:Requirement rather than sd:UserStory per CONVENTIONS.md. This is a pure scope-pointer, not a testable requirement of its own, so it's recorded as one Requirement and immediately dispositioned rather than left to accumulate its own acceptance criteria." ;
	<urn:solutiondesign:ontology:requirementId> "21.6" ;
	<urn:solutiondesign:ontology:statement> "All underlying logic for sending, tracking, and displaying emails, alerts and notifications are derived from Business Specification #6 (Alerts, Emails & Communications). This feature is strictly limited to the configuration of these tools (defining what is sent) specifically for the Data Collection & Compliance module. Additionally, Business Specification #4 (Business Rules Management) will specify when and to whom it is sent." ;
	<urn:solutiondesign:ontology:title> "Email/Comm configuration scope pointer" .

<urn:solutiondesign:instance:staffing:Req_22_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On saving Administrator/Instructional assignment details, validate the employee's Unique ID against held credentials/endorsements for the specific SCED Code/Grade Level; trigger a validation error if invalid; offer a link to the Temporary Credential Application process OR a required free-form Credential Error Justification field; display a State Aid Deduction warning when justification is required; store the justification for Appropriate Placement Audit review (not viewable to the citizen); alert the SOM Audit role when a justification is submitted." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong, near-complete match: staff:Seq_AssignEmployeeToPosition's sequence diagram shows exactly this branch ('Apply for Temporary Credential' or 'Submit Justification' with free-form text), backed by cred:Op_GetEducatorCredentials for the credential/endorsement check and staff:CredentialErrorJustificationSubmittedEvent for the alert. The 'not viewable to citizen' visibility constraint and the SOM-Audit-role-specifically framing (vs. a generic audit alert) aren't independently modeled as access-control assertions on staff:CredentialErrorJustification itself, but are consistent with staff:AuditWorkItemAggregate's own invariant that 'Credential error justifications from district submissions must appear in the auditor's audit item list.' See Question_CredentialPositionMappingOwnershipAmbiguous below for a related, narrower open question about who owns the underlying credential-to-position mapping definitions this validation depends on." ;
	<urn:solutiondesign:ontology:requirementId> "22.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:credentialing:Op_GetEducatorCredentials> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CredentialErrorJustification> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CredentialErrorJustificationSubmittedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreateAssignmentWithJustification> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ValidatePlacement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CredentialMatchingForAdminInstructional> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_EndorsementAlignmentForTeaching> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AssignEmployeeToPosition> ;
	<urn:solutiondesign:ontology:statement> "As a Business User with the School District role, I want the system to validate that an assigned employee holds the necessary credentials for their position, so that I can provide a required justification if they are not appropriately placed." ;
	<urn:solutiondesign:ontology:title> "Validate credential/endorsement for assigned employee; justification if not appropriately placed" .

<urn:solutiondesign:instance:staffing:Req_22_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Require a valid credential for Administrator/Instructional Education Job Type; if lacking, direct the user to the Temporary Credential Application process; display a State Aid Deduction warning when justification is required." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Same underlying mechanism as Req_22_1_1 — this story is the FDD's own restatement of the same branch from the district-user's perspective rather than a distinct capability. Rule_CredentialMatchingForAdminInstructional's own example ('district must either apply for temporary credential or submit credential error justification') matches almost verbatim." ;
	<urn:solutiondesign:ontology:requirementId> "22.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CredentialMatchingForAdminInstructional> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AssignEmployeeToPosition> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to be directed to the Temporary Credential Application process or the Credential Error Justification form if the employee lacks a valid credential for an Instructional or Administrator position, so that I can ensure compliance and document potential state aid deductions." ;
	<urn:solutiondesign:ontology:title> "Direct user to Temporary Credential Application or Credential Error Justification" .

<urn:solutiondesign:instance:staffing:Req_22_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Require course-level data elements (SCED Course Code, Subject Area, Local Course ID/Title, Course Code System, Academic School Year, SCED Grade Span, Course Level Characteristic, Core Academic Course, Course Interaction Mode, Virtual Indicator, Additional Credit Type, Tuition Funded, Teaching Assignment Start/End Date, Grade Level When Course Taken) when Local Job Category is 'Teacher'; require the employee to hold valid endorsement(s) covering the reported course content and grade level." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Rule and entity match well at the conceptual level (staff:CourseDetail's own description: 'SCED code, subject area, grade span, interaction mode for teaching assignments'; staff:AssignmentAggregate's invariant: 'Teacher assignments require valid endorsements for SCED course and grade level'). The FULL field-by-field CEDS element list this story enumerates (17 distinct elements) is not individually promoted onto staff:CourseDetail — consistent with staffing-domain.ttl's own documented scope decision to skip ERD/DataTable field-level modeling; not re-raised as a gap since that's a deliberate, already-stated scope choice, not an oversight." ;
	<urn:solutiondesign:ontology:requirementId> "22.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:CourseDetail> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_EndorsementAlignmentForTeaching> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to report course level information, including SCED codes and grade span, when assigning a \"Teacher\" position, so that the appropriate placement audit can verify endorsement alignment." ;
	<urn:solutiondesign:ontology:title> "Report course-level information for Teacher assignments; endorsement alignment" .

<urn:solutiondesign:instance:staffing:Req_22_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Display a New Teacher indicator (calculated from Years of Prior Teaching Experience) for individuals within their first 3 years of classroom teaching; require the New Teacher Monitoring component when the flag is true, disable/read-only it when false; block certification if the component is missing or has errors; allow entering a mentor Unique ID with name-lookup verification, or a free-form entry when no Unique ID is available (via a checkbox); alert the assigned mentor on submission." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Domain model and business rule match closely, including the mentor-Unique-ID-resolves-to-name-for-verification detail (staff:NewTeacherMonitoring's own description) and the free-form fallback. GENUINE, ALREADY-DOCUMENTED GAP (not newly raised here, cross-referenced from staffing-permissions.ttl's own header): no sd:ApiOperation exists anywhere in staffing-api.yml for New Teacher Monitoring at all — staff:Perm_NewTeacherMonitoringView/Update both note this explicitly, and even the NewTeacherMentorAssignedEvent has no operation shown creating it. This story is satisfied at the domain-model/business-rule level but not at the API-surface level; partial satisfaction, per the ontology's own guidance on this, not overclaimed as complete. staff:Op_SearchEducators is the closest existing operation for the mentor name-lookup, per staffing-api.ttl's own note pointing at staff:Question_MentorVerificationEndpointDirection (staffing-domain.ttl) — comment 16 on this FDD ('Align this search with the Temporary Credential Mentor reporting') independently corroborates that exact cross-domain alignment question, not re-raised as a new Annotation here." ;
	<urn:solutiondesign:ontology:requirementId> "22.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:NewTeacherMentorAssignedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:NewTeacherMonitoring> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_SearchEducators> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_NewTeacherMonitoringRequirement> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want the system to identify New Teachers, require monitoring details, and support mentor assignment, so that New Teachers are properly monitored and the collection can be certified." ;
	<urn:solutiondesign:ontology:title> "Identify New Teachers, require monitoring, support mentor assignment" .

<urn:solutiondesign:instance:staffing:Req_22_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Notify the Citizen accountholder via a defined template when a new Evaluation Outcome is submitted; send no notification if the Unique ID has no associated MiLogin for Citizens account." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Event and cross-domain subscription (comm:CommunicationsContext sd:subscribesTo staff:EvaluationOutcomeRecordedEvent) match. Same already-documented API-surface gap as Req_22_1_4: staff:Perm_EvaluationOutcomeSubmit/View both note no sd:ApiOperation exists anywhere in staffing-api.yml for Evaluation Outcome — domain-model/event-level satisfaction only, not API-surface complete." ;
	<urn:solutiondesign:ontology:requirementId> "22.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EvaluationOutcomeRecordedEvent> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen accountholder, I want to be notified when a new Evaluation Outcome is submitted by the School District user, so that I can review the reported data." ;
	<urn:solutiondesign:ontology:title> "Notify Citizen of new Evaluation Outcome" .

<urn:solutiondesign:instance:staffing:Req_22_1_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Provide a Citizen-facing appeal button on the Evaluation Outcomes component; the appeal window for citizen appeals is 5 years; route the appeal to the School District user's worklist for review/approval; store all appeal audit details." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "GENUINE DISCREPANCY (see Question_CitizenEvaluationAppealWindowDiscrepancy below): this story states the CITIZEN's own appeal window is '5 years', but staffing-domain.ttl's staff:Rule_EvaluationOutcomeAppealWindow states the opposite for citizens specifically — 'Citizens can appeal any evaluation outcome within their record' (i.e. no time limit), with the 5-year window applying only to DISTRICT appeals. This FDD's own main Business Specifications prose (non-Addendum section) agrees with the domain model ('Citizens can appeal any evaluation outcome within their record... School District users [can appeal]... if the school year is within the defined appealable window') — so the discrepancy is internal to this FDD's own Addendum restating its own Business Specifications section incorrectly, not a genuine domain-vs-FDD conflict. Still satisfied at the mechanism level (appeal exists, routes to district worklist, audit stored)." ;
	<urn:solutiondesign:ontology:requirementId> "22.1.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EvaluationOutcome> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_EvaluationOutcomeAppealWindow> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen accountholder, I want to be able to appeal an evaluation outcome reported by a School District user within the defined appealable window (currently 5 years)." ;
	<urn:solutiondesign:ontology:title> "Citizen appeals an Evaluation Outcome within the appealable window" .

<urn:solutiondesign:instance:staffing:Req_22_1_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Receive the citizen's appeal request in a worklist; provide approve/deny options; on approval, allow entering the corrected Evaluation Outcome; on denial, leave the outcome unchanged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Domain description ('appealable by both employee and district within defined windows') matches the approve/deny/correct shape; same already-documented Evaluation-Outcome API-surface gap as Req_22_1_5 applies (no sd:ApiOperation modeled for this workflow anywhere)." ;
	<urn:solutiondesign:ontology:requirementId> "22.1.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EvaluationOutcome> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_EvaluationOutcomeAppealWindow> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to have the option to approve or deny a Citizen's appeal request for an Evaluation Outcome, so that I can correct data inaccuracies if necessary." ;
	<urn:solutiondesign:ontology:title> "District approves or denies a citizen's Evaluation Outcome appeal" .

<urn:solutiondesign:instance:staffing:Req_22_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Require Assignment Start/End Date, Job Identifier, Staff FTE, District/Building Identifier, Classroom Position Type, and Education Job Type when Education Job Type is Non-Instructional; enforce selection of a specific Local Job Function (not category-level only)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct structural match to staff:AssignmentDetail/EducationJobType. The 'must select a specific Local Job Function, not category-level only' constraint is not asserted as an explicit invariant on staff:PositionRosterAggregate or staff:AssignmentAggregate today (staff:LocalJobFunction exists as a ValueObject but nothing in staffing-domain.ttl's invariants text forbids a category-only selection) — a minor, narrow modeling gap, not raised as a separate Annotation given its low impact." ;
	<urn:solutiondesign:ontology:requirementId> "22.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EducationJobType> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:LocalJobFunction> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreateAssignment> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to submit Assignment Details for Non-Instructional Staff, so that I can accurately report their employment period, effort (FTE), and specific job role to the state." ;
	<urn:solutiondesign:ontology:title> "Submit Assignment Details for Non-Instructional Staff" .

<urn:solutiondesign:instance:staffing:Req_22_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Allow manual add/update of education records only when no historical CEPI/STARR data exists for the Unique ID; require the Degree element, other elements optional; calculate/store 'Highest Level of Education Completed' in the K12Staff CEDS Domain; the component is Required for Teachers/School Administrators, Optional for others, with an alert if required data is missing." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "staff:EducationHistory's own description is close to a word-for-word match ('Sourced either from CEPI Data Warehouse/STARR-NSC interfaces (read-only...) or manually entered by district or citizen when no historical record exists (degree required, all other fields optional)'). Same already-documented API-surface gap as the New Teacher/Evaluation Outcome stories above: staff:Perm_EducationHistoryView/Update both note no sd:ApiOperation exists anywhere in staffing-api.yml for Education History." ;
	<urn:solutiondesign:ontology:requirementId> "22.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EducationHistory> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to perform updates to the education history for employees where no historical CEPI data exists, so that the \"Highest Level of Education Completed\" is accurately calculated for state and federal reporting." ;
	<urn:solutiondesign:ontology:title> "Manually update Education History when no CEPI data exists" .

<urn:solutiondesign:instance:staffing:Req_22_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Validate the Assignment Details component on Save/Submit; display an alert on the page for errors/warnings; require error correction prior to collection certification." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to the Collection quality-review/certification-blocking mechanism already modeled." ;
	<urn:solutiondesign:ontology:requirementId> "22.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AssignState_Error> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RunQualityReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionCannotCertifyWithErrors> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to receive an alert if required assignment details are missing, so that I can correct the record prior to collection certification." ;
	<urn:solutiondesign:ontology:title> "Alert on missing required Assignment Details" .

<urn:solutiondesign:instance:staffing:Req_22_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Require K12 Staff Classification, Staff FTE, District/Building Identifier, Assignment Start/End Dates, Classroom Position Type, Primary Assignment Indicator, Local Job Category, Education Job Type, and Job Identifier when Education Job Type is Student Support Staff; mandate a specific Local Job Function (e.g. 'Social Worker'), not category-level only." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Same structural match and same minor 'specific-function-not-category-only' invariant gap as Req_22_2_1 (Non-Instructional's analogous story) — not re-raised as a separate Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "22.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EducationJobType> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:LocalJobFunction> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_CreateAssignment> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to submit Assignment Details for Student Support Staff with specific Job Functions, so that I can accurately report staff roles as required by state compliance standards without using broad categories." ;
	<urn:solutiondesign:ontology:title> "Submit Assignment Details for Student Support Staff with specific Job Functions" .

<urn:solutiondesign:instance:staffing:Req_22_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The Education History component is required for Teacher, Administrator, Special Education Paraprofessional, and Teacher-on-Temporary-Credential positions; other positions may optionally report it; required-but-missing/errored records block collection certification." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "CITATION VERIFIED: staff:AssignmentAggregate's own invariant text is a near-exact match — 'Education History is required before certification for employees in a defined subset of positions (Teacher, Administrator, Special Education Paraprofessional, Teacher on a Temporary Credential); optional for all other positions.' Same list, same four position types, same wording pattern." ;
	<urn:solutiondesign:ontology:requirementId> "22.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Rule_CollectionCannotCertifyWithErrors> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want the system to require Education History details for Teacher, Administrator, Special Education Paraprofessionals, Teacher positions on a Temporary Credential positions, so that I cannot certify the collection with missing federal compliance data." ;
	<urn:solutiondesign:ontology:title> "Require Education History for specified position types before certification" .

<urn:solutiondesign:instance:staffing:Req_22_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Reference post-secondary history by Unique ID from CEPI Data Warehouse/STARR-NSC; pre-populate Name of Institution, Degree/Certificate Type, Conferring Date, Education Verification Method; the School District user can view but not edit/remove CEPI-sourced data; notify on STARR/NSC-sourced updates." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — staff:EducationHistory's description explicitly names both the CEPI Data Warehouse/STARR-NSC sourcing and the read-only-to-district constraint on that sourced data." ;
	<urn:solutiondesign:ontology:requirementId> "22.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EducationHistory> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to view pre-populated Education History data sourced from the CEPI Data Warehouse and STARR/NSC interfaces, so that I do not have to manually enter verified data that the state already possesses." ;
	<urn:solutiondesign:ontology:title> "View pre-populated Education History from CEPI/STARR-NSC" .

<urn:solutiondesign:instance:staffing:Req_22_4> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "This section carries no acceptance criteria or numbered stories of its own — it is a pure cross-reference to FDD 21's own Feature 21.5, which is out of this session's scope (FDD 21 is being reviewed by another agent concurrently). Modeled as a plain sd:Requirement rather than sd:UserStory since it is not narrative-form content, and given an out-of-scope Annotation rather than left dangling. WORTH FLAGGING even though out-of-scope for THIS file: this FDD's own main Business Specifications prose independently promises bulk-file and API update methods for Employee Assignment Details ('The system will allow the user... to update the Employee Assignment Details for the new academic year using the following methods: Online / Bulk file / API'), and comment 1124016608 on this exact document ('Can the users upload an excel file?') shows this was still an open question during review. staffing-api.yml/staffing-permissions.ttl already document, independently of this FDD, that NO bulk-upload endpoint exists anywhere in Staffing's real API surface (staff:Perm_EmployeeRosterBulkUpload has no matching sd:ApiOperation at all — see that permission's own notes). This FDD's own promise of a bulk/API update path for Assignment Details specifically has the same gap: staff:Op_CreateAssignment/staff:Op_UpdateAssignment are both single-record, online-only operations; nothing in staffing-api.yml exposes a bulk or batch assignment-update surface either. Per this session's brief, sibling FDD-18 and FDD-21 reviews (Roster of Positions and Roster of Employees, reviewed concurrently) independently found the identical absence for their own aggregates (Position Roster, Employee Roster) — three separate FDDs, covering three different Staffing aggregates, all promising a bulk-file/API update path that has zero corresponding sd:ApiOperation anywhere in staffing-api.yml. That consistency across independently-reviewed FDDs indicates this is a SYSTEMIC gap in Staffing's converted API surface (the bulk/batch ingestion layer for the whole domain was apparently never built out, not just overlooked for one aggregate), not three unrelated per-FDD findings — worth stating as such when this file's finding is reconciled with FDD 18's and FDD 21's own." ;
	<urn:solutiondesign:ontology:requirementId> "22.4" ;
	<urn:solutiondesign:ontology:statement> "(Not phrased as a user story in the source.) 'All user stories regarding the uploading of supporting documentation and bulk attendee data files can be found within user stories associated with Feature 21.5: Employee Roster Data Input via API and File Upload.'" ;
	<urn:solutiondesign:ontology:title> "Feature 22.4: Data Input via API and File Upload (pointer, no own stories)" .

<urn:solutiondesign:instance:staffing:Req_22_5> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22Doc> ;
	<urn:solutiondesign:ontology:notes> "Pure cross-reference to two other Business Specifications, neither of which has its own numbered story here. Business Specification #6 maps to comm:CommunicationsContext (a real, if stub-status, bounded context already referenced throughout staffing-domain.ttl's own subscribesTo claims). Business Specification #4 (Business Rule Management) has no corresponding bounded context anywhere in the 11 converted mied-v3 domains — already logged in GAPS.md from the FDD 29 pass; this FDD independently confirms the same gap, not re-logged as new." ;
	<urn:solutiondesign:ontology:requirementId> "22.5" ;
	<urn:solutiondesign:ontology:statement> "(Not phrased as a user story in the source.) 'All underlying logic for sending, tracking, and displaying emails, alerts and notifications are derived from Business Specification #6 (Alerts, Emails & Communications). This feature is strictly limited to the configuration of these tools... specifically for the Data Collection & Compliance module. Additionally, Business Specification #4 (Business Rules Management) will specify when and to whom it is sent.'" ;
	<urn:solutiondesign:ontology:title> "Feature 22.5: Email/Comm (pointer, no own stories)" .

<urn:solutiondesign:instance:staffing:Req_22_6_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Access the Appropriate Assignment Reports & Audits Worklist from the dashboard, restricted to SOM Auditor role/ISD-RESA permissions; display district-level audit items with district name, audit type, action item description, due date, status, Credential Error Justification (if provided); support sorting/filtering; a Collection Name single-select filter; 'No results found' messaging; open items via hyperlink; status values New/In Progress/Awaiting District Response/Completed." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22CompanionDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct visual match confirmed by Wireframe22_08. staff:Op_GetAuditItems's own notes explicitly distinguish ISD Auditors (constituent districts) from SOM Auditors (across all ISDs) — matches scope:SystemWide on staff:Perm_AuditView for the SOM case. The Collection Name filter, free-text Search, and sort/filter UI controls are not independently modeled as graph nodes (consistent with this ontology's general preference not to model UI chrome) — not a gap, just outside what this graph captures." ;
	<urn:solutiondesign:ontology:requirementId> "22.6.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AuditState_AwaitingDistrictResponse> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AuditState_Completed> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AuditState_InProgress> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AuditState_New> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AuditStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_GetAuditItems> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AuditView> ;
	<urn:solutiondesign:ontology:statement> "As an SOM Auditor, I want access to a centralized audit worklist that displays state-level audit tasks, so that I can monitor, manage, and track the progress of Employee and Appropriate Placement audits across all districts." ;
	<urn:solutiondesign:ontology:title> "SOM Auditor centralized state-level audit worklist" .

<urn:solutiondesign:instance:staffing:Req_22_6_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking the district name navigates to the Data Collection Report tab, loaded in the context of the selected audit period; restricted to SOM Auditor role; displays sections: Power BI Charts, Employees Not Appropriately Placed, Employees with No Assignment, Changes to Employee Roster, Required Positions with No Assignments, Buildings with No Appropriate Positions, Changes to Positions, All Employees." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22CompanionDoc> ;
	<urn:solutiondesign:ontology:notes> "staff:Op_GetDistrictAuditReport's own documented projection ('employees not appropriately placed, employees without assignments, credential error justifications, and change summaries') covers roughly 3 of the 7 named sections well (Employees Not Appropriately Placed, Employees with No Assignment, Changes to Employee Roster/Positions collapsed into one 'change summaries' concept). See Question_DistrictReportSectionsIncomplete below for the two sections ('Required Positions with No Assignments', 'Buildings with No Appropriate Positions') that have no corresponding data shape anywhere in staff:AuditWorkItemAggregate at all, and for the still-undecided Power BI charting mechanism itself." ;
	<urn:solutiondesign:ontology:requirementId> "22.6.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:AuditWorkItemAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_GetDistrictAuditReport> ;
	<urn:solutiondesign:ontology:statement> "As a SOM Auditor, I want to select a worklist item by clicking the School District Name hyperlink, so that I can navigate directly to the district's Data Collection Report to review audit-related data." ;
	<urn:solutiondesign:ontology:title> "SOM Auditor navigates to district Data Collection Report" .

<urn:solutiondesign:instance:staffing:Req_22_6_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Clicking an Employee Name hyperlink opens a drawer showing: Name, Certificate Number, Certificate Type, National Board Certified, Renewal Status, Endorsements (Subject/Grade, Institution, Nullified), Certificate History (App#/Issue Date/Expiration Date/Status), Assignment (App#/Issue Date/Expiration Date/Status), Remarks (Comment/Created By/Date Created)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22CompanionDoc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this is a genuinely composed, cross-domain view — most of its fields (Certificate Number/Type, National Board Certified, Renewal Status, Endorsements with Nullified flag, Certificate History) are Credentialing-shaped data, not Staffing data, yet nothing in either staffing-domain.ttl or credentialing-domain.ttl (as loaded/referenced here) models an operation or projection that composes exactly this Employee+Credential+Assignment+Remarks shape for an audit context. Wireframe22_07 (viewed directly) confirms this is a real, designed screen, not a stray acceptance-criteria list — including a 'Remarks' comment thread (Created By/Date Created, editable) and an unexplained 'Add to Investigation' action with no backing narrative anywhere. See Question_EmployeeDetailsAuditDrawerNotModeled below." ;
	<urn:solutiondesign:ontology:requirementId> "22.6.3" ;
	<urn:solutiondesign:ontology:statement> "As a SOM Auditor, I want to view employee information, so that I can understand employment, assignment, and credential details for review and decision-making." ;
	<urn:solutiondesign:ontology:title> "SOM Auditor views composed employee/credential/assignment details" .

<urn:solutiondesign:instance:staffing:Req_22_6_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Allow the SOM Auditor to request additional documentation/information from either an ISD user or a district user from within the system; allow upload of requested documentation (e.g. Local Master Teacher Schedule, Attendance for daily substitute usage)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22CompanionDoc> ;
	<urn:solutiondesign:ontology:notes> "The DISTRICT-facing half (SOM/ISD Auditor requests documentation FROM a district) matches staff:Op_RequestAuditDocumentation and staff:DocumentRequest closely — Wireframe22_09 (viewed directly) confirms the exact two example document types verbatim. The ISD-facing half (SOM Auditor requesting documentation/information FROM an ISD user, as opposed to a district user) has no distinct modeled path: staff:AuditWorkItemAggregate and its invariants are framed entirely around district-level audit items reviewed by ISD Auditors — there is no separate SOM-oversees-ISD audit item/worklist concept, so an SOM-to-ISD document request has nothing structurally different to attach to than the existing district-facing flow. See Question_SomIsdAuditOversightNotModeled below (shared with Req_22_6_1's worklist scope)." ;
	<urn:solutiondesign:ontology:requirementId> "22.6.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:DocumentRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RequestAuditDocumentation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Perm_AuditRequestDocumentation> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce State of Michigan Auditor, I want to be able to request additional documentation or information directly from the ISD or district user from within MiEdWorkforce, so that the audit chain of communication is maintained in the system." ;
	<urn:solutiondesign:ontology:title> "SOM Auditor requests additional documentation from ISD or district" .

<urn:solutiondesign:instance:staffing:Req_22_6_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "District-level users with the Staffing Data role receive a notification when assigned steps occur within the audit process, including when the ISD Auditor or the State of Michigan Auditor requests additional documentation or information." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd22CompanionDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — staff:DocumentRequestCreatedEvent's own trigger text and comm:CommunicationsContext's subscription already cover this exact notification path (district Staffing Data role users alerted on a document request)." ;
	<urn:solutiondesign:ontology:requirementId> "22.6.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:DocumentRequestCreatedEvent> ;
	<urn:solutiondesign:ontology:statement> "As a School District user, I want to receive a notification when assigned steps within the audit process, such as requested documentation, so that I can address audit requirements promptly." ;
	<urn:solutiondesign:ontology:title> "District notified of assigned audit steps" .

<urn:solutiondesign:instance:staffing:Req_24_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Upon successful Unique ID assignment (Match or New Creation), demographic fields lock to read-only; an 'Update Demographics' button remains available for intentional future updates; the Unique ID is stored and associated with the employing entity; the ID assignment (user, date, time) is logged in the audit logs." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: the separate GET-view/PATCH-update operation split (staff:Op_GetEmployeeDemographics vs. staff:Op_UpdateEmployeeDemographics) is consistent with a read-view-then-explicit-update UX, but no explicit 'demographics become read-only after ID assignment' invariant is asserted anywhere on staff:EmployeeRosterAggregate itself — an implicit, not explicit, match. The audit-logging half of this AC has no dedicated audit-log entity in staffing-domain.ttl beyond the update-history table shown in wireframe 5 (Modified date/Modified by/Authorized by columns) — treated as sufficient coverage of 'user, date, time' logging, not raised as a separate gap." ;
	<urn:solutiondesign:ontology:requirementId> "24.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdateEmployeeDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want the demographic data fields to become read-only once a Unique ID is successfully assigned, so that the identity data remains synchronized with the master record." ;
	<urn:solutiondesign:ontology:title> "Lock demographic fields to read-only once a Unique ID is assigned" .

<urn:solutiondesign:instance:staffing:Req_24_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "On entering a Unique ID (via search or manual entry), the system checks the current Employee Roster for the logged-in entity; if the Unique ID already exists in that roster, an error message is displayed and submission of a new 'Request for ID' for that individual is prevented." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, literal match: staff:Seq_AddNewEmployee's own sd:errorScenarios reads 'Unique ID already in entity roster > 409 Conflict, user selects existing record instead' — same rule, same outcome." ;
	<urn:solutiondesign:ontology:requirementId> "24.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AddNewEmployee> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want the system to check if the Unique ID I am attempting to add is already associated with my district, so that I do not create duplicate employment records for the same individual." ;
	<urn:solutiondesign:ontology:title> "Prevent duplicate employment records for an already-rostered Unique ID" .

<urn:solutiondesign:instance:staffing:Req_24_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Given a 'Near Match' result, display a resolution screen showing submitted data side-by-side with the potential match(es); highlight differing fields; mask sensitive data in potential-match results according to user permissions; display the match score/confidence level for each potential match." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match, corroborated field-for-field by wireframe 8 (90%/83% match scores shown, differing fields highlighted in the same yellow-highlight style this AC describes). One AC clause has no confirmed backing: 'mask sensitive data ... according to user permissions' — no field-level, permission-conditional masking rule for Near Match candidate data is asserted anywhere in iam-domain.ttl (iam does have an unrelated masking precedent for Lead Admin email and citizen SSN-last-4 elsewhere in iam-sequences.ttl, but nothing scoped to Near-Match candidate records specifically). Minor, not raised as its own Annotation given how narrow it is." ;
	<urn:solutiondesign:ontology:requirementId> "24.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequestAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserRequestNewId> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to view the details of potential existing records when a 'Near Match' is returned, so that I can determine if the employee I am adding already exists in the system." ;
	<urn:solutiondesign:ontology:title> "View potential-match details when a Near Match is returned" .

<urn:solutiondesign:instance:staffing:Req_24_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "A 'Use this Potential' (or similar) action is available per displayed potential match; selecting it updates the employee record with the selected Unique ID; an option to update the master record if submitted data differs is presented; on confirmation, a resolution message is sent back to Mi-Key to confirm the link." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Matches iam:Rule_BusinessUserNearMatchSelfResolution and iam:Seq_BusinessUserRequestNewId's self-resolve branch well for the core 'select and confirm' action. However, wireframe 9 (the actual 'Match and Link ID's' control) shows something a bit richer than this story's own text implies: a Primary-ID selector PLUS an optional second-candidate link checkbox and a required justification field — closer in shape to iam's separate LinkId request type (iam:Seq_BusinessUserRequestLinkId) than to a bare single-candidate self-resolve. Not modeled as a discrepancy Annotation since the underlying capability (self-resolve to an existing Unique ID) is genuinely present either way — flagged here as a UX/granularity nuance worth a second look if LinkId's own FDD is reviewed." ;
	<urn:solutiondesign:ontology:requirementId> "24.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_SelfResolveIdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Rule_BusinessUserNearMatchSelfResolution> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_ResolveNearMatch> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to select an existing record from the potential matches, so that I can use the existing Unique ID for my employee instead of creating a duplicate." ;
	<urn:solutiondesign:ontology:title> "Select an existing potential match to resolve a Near Match" .

<urn:solutiondesign:instance:staffing:Req_24_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "A 'Request New ID' action is available on the Near Match resolution screen; selecting it requires the user to provide a justification for rejecting the potential matches; the request routes to the Identity Administrator worklist for review and approval; the user is shown a notification that the request is pending administrative review." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: iam:Op_EscalateIdentityRequest's own summary is literally 'Escalate a business-user New ID Near Match for Identity Administrator review', and iam:Seq_BusinessUserRequestNewId's escalate branch requires justificationText and emits IdentityResolutionRequiresReview, matching this story end-to-end. Wireframe 10's 'Deny Request' action (also present on the same resolution screen, for suspected fraud) is NOT described anywhere in this story or any other numbered Addendum item — a real product capability with no corresponding FDD 24 user story at all. Not raised as its own Annotation (the underlying capability — an Identity Administrator denying a request — is separately covered by Req_24_5_2/iam:IdentityRequestDeniedEvent), but worth noting as an FDD-completeness gap in the source document itself, distinct from a solution-design coverage gap." ;
	<urn:solutiondesign:ontology:requirementId> "24.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequiresReviewEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Op_EscalateIdentityRequest> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_RequestNewId> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to request a new ID if none of the potential matches represent the employee I am adding, so that a correct, new identity record is created." ;
	<urn:solutiondesign:ontology:title> "Request a new ID when no potential match is correct" .

<urn:solutiondesign:instance:staffing:Req_24_4_1> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Uploaded employee roster files are validated against the schema; a record missing a Unique ID is rejected with an error message; a record whose Unique ID does not exist in the system is rejected; the upload proceeds only for records with valid, existing Unique IDs." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this story's own rule direction ('bulk upload cannot create new IDs, only update using an existing valid Unique ID') is independently CONFIRMED as already-resolved in staffing-domain.ttl's own Open Question #3 ('resolved... bulk-upload create-vs-update'), and wireframe 12 is a striking, independent visual confirmation of the exact validation behavior described here ('Line 12 - No UID', 'Line 137 - Duplicate UID'). But the actual implementing surface does not exist: staffing-permissions.ttl's own header already documents staff:Perm_EmployeeRosterBulkUpload as a Permission with NO backing sd:ApiOperation anywhere in staffing-api.ttl ('the bulk/file-upload pipeline ... is likewise entirely absent from the API surface'). This FDD reinforces that pre-existing, real gap with independent wireframe evidence rather than resolving it — genuine coverage gap, not fabricated as satisfied. See the coverage-gap Annotation below." ;
	<urn:solutiondesign:ontology:requirementId> "24.4.1" ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Data Administrator, I want the file upload process to reject records that do not include a valid Unique ID, so that users are forced to use the match process for new ID creation to prevent duplicates." ;
	<urn:solutiondesign:ontology:title> "Reject bulk-upload records lacking a valid Unique ID" .

<urn:solutiondesign:instance:staffing:Req_24_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The system exposes an API endpoint to receive staffing data; the API validates that the incoming record contains a Unique ID; a new-employee request with no Unique ID is rejected with an error code indicating ID creation must go through the UI or a dedicated ID-creation service; valid records are parsed and stored into the Employee Roster." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: staff:Op_AddEmployee's own notes confirm the external-caller shape this story needs ('x-access: [internal-user, external-client] — callable ... by external HR/SIS systems submitting on behalf of a district'), and the endpoint exists. But the specific restriction this story's AC asks for — reject an API-submitted new-employee request that has no Unique ID, distinct from the UI path which DOES allow blank-Unique-ID submission for new-record creation — is not explicitly confirmed anywhere in staff:Op_AddEmployee's converted notes; the operation as documented doesn't distinguish caller type when deciding whether a missing Unique ID is allowed. Consistent in spirit with the confirmed bulk-upload restriction (Req_24_4_1's notes) but not itself confirmed for this specific operation — not raised as a separate Annotation given how narrow the gap is, but not claimed as fully confirmed either." ;
	<urn:solutiondesign:ontology:requirementId> "24.4.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:statement> "As a School District, I want my local HR system to be able to submit staffing data via API, so that I can streamline the reporting of employees without manual entry." ;
	<urn:solutiondesign:ontology:title> "Submit staffing data via API from a local HR system" .

<urn:solutiondesign:instance:staffing:Req_24_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "An alert generates on the user's dashboard when a submitted record returns a 'Near Match' status requiring ID Admin intervention; the alert indicates which employee record requires resolution; the employee record is not created in the active roster until resolution completes." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "The event and its Communications subscription are real and well-matched (iam:IdentityResolutionRequiresReviewEvent -> comm:CommunicationsContext); the 'not created in active roster until resolution completes' half matches staff:Seq_AddNewEmployee's own 202-Accepted-pending-resolution branch. The specifically DASHBOARD-rendered form of the alert (as opposed to email) isn't separately modeled as a UI widget anywhere in Communications or a Dashboards capability (dash:DashboardsContext remains a stub-only context per mied-v3/CONVENTIONS.md, same as FDD 29's own 29.1.8/29.1.10 findings) — wireframe 13's generic notification-bell dropdown is used as general corroboration that SOME on-screen alert mechanism exists, not confirmation that a Near-Match-specific dashboard alert is itself built. Kept as Satisfied (the underlying event/notification plumbing is real) rather than a gap, consistent with how comparable dashboard-presentation nuances were treated in the FDD 29 pass." ;
	<urn:solutiondesign:ontology:requirementId> "24.5.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionRequiresReviewEvent> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to receive a system alert when an 'Add Employee' request results in a 'Near Match' that requires administrative review, so that I know the record is in a pending status." ;
	<urn:solutiondesign:ontology:title> "Alert the user when Add Employee produces a Near Match requiring review" .

<urn:solutiondesign:instance:staffing:Req_24_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "If approved: send a notification/email (per preferences) containing the new Unique ID, stating the record is active. If denied: send a notification/email stating the request was denied, including the Administrator's justification/rejection reason. Either notification links back to the relevant record in the Employee Roster." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct, strong match: iam:Seq_IdentityAdministratorResolveRequest's own mermaid content includes 'IAM->>Notification: Notify requester of outcome (email + on-screen)' immediately after both the approve and deny branches, and iam:IdentityRequestDeniedEvent's own payloadHighlights include 'denialReason' — exactly the 'Admin's justification/rejection reason' this story asks for." ;
	<urn:solutiondesign:ontology:requirementId> "24.5.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityRequestDeniedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:IdentityResolutionCompletedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_IdentityAdministratorResolveRequest> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to be notified when the Identity Administrator approves or denies my request for a New ID (following a Near Match), so that I can proceed with reporting the employee's assignment data." ;
	<urn:solutiondesign:ontology:title> "Notify the user of the Identity Administrator's approve/deny decision on a New ID request" .

<urn:solutiondesign:instance:staffing:Req_24_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "When a Staffing Authorized User successfully adds an employee who has an associated Citizen Account, an email triggers to that account's address, stating the specific entity (school district name) added them as an employee, using the Identity Administrator's defined email template." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: staff:EmployeeAddedToRosterEvent is already subscribed to by comm:CommunicationsContext in staffing-domain.ttl, and this is exactly the citizen-notification behavior this FDD's own Business Specifications prose describes ('If the Unique ID is associated with a Citizen User account, the citizen account will receive notification that the record has been added to a new employing school district')." ;
	<urn:solutiondesign:ontology:requirementId> "24.5.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmployeeAddedToRosterEvent> ;
	<urn:solutiondesign:ontology:statement> "As a Citizen User, I want to receive an email notification when a district adds my Unique ID to their Employee Roster, so that I am aware of changes to my employment record in the state system." ;
	<urn:solutiondesign:ontology:title> "Notify a Citizen User when a district adds their Unique ID to its roster" .

<urn:solutiondesign:instance:staffing:Req_24_BizSpec_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "A link to 'Add New Employee' is available on the Staffing Authorized User dashboard. Selecting it navigates to a Person Search page; entering search criteria and selecting a matching result pre-populates the Add Employee form including the Unique ID field (Unique ID becomes non-editable once pre-populated). No matching result navigates to a blank Add Employee form with the Unique ID field blank and non-editable. The user reviews/completes required data, agrees to an attestation, and submits; the system validates the data (per 'Identity Validations.xlsx', not itself reviewed in this pass) before submitting to Mi-Key. Mi-Key returns Match (existing Unique ID returned), No Match (new Unique ID created), or Near Match (Requires Resolution, handled per Req_24_3_1-24_3_3). On a successful Match or No-Match outcome the user may proceed with reporting Employment Data details (FDD 21.0); if the resulting Unique ID already has associated employment/credential data, it is displayed; if it's associated with a Citizen User account, that account is notified (Req_24_5_3)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong, near-verbatim match on both the Staffing side (staff:Seq_AddNewEmployee's mermaid content follows this exact search/pre-populate-or-blank/validate/submit shape) and the IAM side (iam:Seq_BusinessUserRequestNewId's Match/No-Match/Near-Match branching is worded almost identically to this FDD's own 'probabilistic match result of Match, No Match ... or Near Match ... with the match score'). Corroborated by wireframes 1-3. The FDD's own 'Feature 24.1: Create New Collection' aside (school-year rollover / data-cleansing deferred to Identity Admin FDD 15.9) is a scoping note, not itself a testable acceptance criterion, and isn't separately modeled. CONFIRMED CROSS-FDD OVERLAP: this Requirement is a near-verbatim restatement of fdd-review/15-identity-management-integration.ttl's iam:Req_15_2_1/15_2_2/15_2_3 (Feature 15.2, the doc this FDD's own text names as its own workflow spec) — both independently resolve to the same satisfiedBy targets; see this file's header note." ;
	<urn:solutiondesign:ontology:requirementId> "24.BizSpec.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:iam:Seq_BusinessUserRequestNewId> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_AddEmployee> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_SearchEmployees> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_AddNewEmployee> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User with authorized access to an educating organization, I want to add a new employee to my Employee Roster by first searching for their existing identity and, if found, reusing their Unique ID (or, if not found, entering their demographics fresh), so that a Unique ID is correctly matched or assigned via Mi-Key before I report the employee's assignment details." ;
	<urn:solutiondesign:ontology:title> "Add New Employee: search-or-create, Mi-Key assignment, proceed to employment reporting" .

<urn:solutiondesign:instance:staffing:Req_24_BizSpec_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "From the Employee Roster, viewing 'Personal Information' and selecting 'Update Demographics' presents an editable demographic form; submission is synchronized with Mi-Key (per '15.1 - Business User Update Demographics Record Requirements.docx', not itself reviewed in this pass); a successful update is reflected in a visible update-history log." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:Fdd24Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match; staff:Seq_UpdateEmployeeDemographics's own history-storage step and cross-notification pattern (citizen notified of district updates, district notified of citizen updates) is a strict superset of what this un-numbered prose describes. Corroborated by wireframes 4-5." ;
	<urn:solutiondesign:ontology:requirementId> "24.BizSpec.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_GetEmployeeDemographics> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Op_UpdateEmployeeDemographics> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:staffing:Seq_UpdateEmployeeDemographics> ;
	<urn:solutiondesign:ontology:statement> "As a Staffing Authorized User, I want to select an employee from my Employee Roster and update their demographic data through an 'Update Demographics' action, so that changes are synchronized with the Mi-Key master identity record and reflected in the employee's history." ;
	<urn:solutiondesign:ontology:title> "Update Demographics for an existing roster employee, synchronized through Mi-Key" .

<urn:solutiondesign:instance:staffing:Rule_ActiveEmploymentRequiresAssignment> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:example> "District hires Jane Smith on 9/1/2024 with Contractual status. Jane must be assigned to at least one position (e.g., 3rd Grade Teacher at Oak Elementary) before the district can certify the Fall 2024 collection." ;
	<urn:solutiondesign:ontology:rationale> "State and federal reporting require complete staffing data including position assignments. An employed individual without an assignment indicates incomplete data entry." ;
	<urn:solutiondesign:ontology:statement> "An employee with Active employment status must have at least one active assignment in the Assignment Details component before the collection can be certified." .

<urn:solutiondesign:instance:staffing:Rule_CollectionCannotCertifyWithErrors> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:example> "District attempts to certify Fall 2024 Employee Roster. System finds 3 employee records with missing assignment details (Error status). Certification blocked until district assigns positions to all active employees or terminates employment for those individuals." ;
	<urn:solutiondesign:ontology:rationale> "Certified data becomes finalized and immutable (except via formal reopen process). Error records would propagate incomplete/invalid data to the state warehouse." ;
	<urn:solutiondesign:ontology:statement> "A collection cannot be certified if any employee records or position records remain in Error status. All validation errors must be corrected before certification allowed." .

<urn:solutiondesign:instance:staffing:Rule_CollectionRolloverCarriesForward> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:example> "At the start of the 2025-26 school year, Oak Grove School District's 2024-25 Position Roster and Employee Roster are used as the basis for the new collection. A Principal position with no end date carries forward with its existing Approved FTE and status. A Bus Driver position cancelled with an effective date and cancellation reason in 2024-25 does not appear in the 2025-26 roster but remains visible under historical views." ;
	<urn:solutiondesign:ontology:rationale> "Districts should not have to re-enter continuing staffing data every school year; only genuinely new information needs fresh entry. Historical accuracy is preserved by keeping ended records queryable but not editable outside a formal reopen." ;
	<urn:solutiondesign:ontology:references> <urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> ;
	<urn:solutiondesign:ontology:statement> "When a new school-year collection is initialized, all Position Roster and Employee Roster records without an end date (and, for positions, without a Cancelled/end reason pair) are automatically carried forward into the new collection with their existing metadata. Records with both an end date and a separation/cancellation reason recorded in the prior collection are excluded from the new collection but remain visible in read-only historical views." .

<urn:solutiondesign:instance:staffing:Rule_CredentialMatchingForAdminInstructional> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<urn:solutiondesign:ontology:example> "District assigns John Doe to Principal position. System checks Credentialing domain and finds John holds Elementary Principal certificate. Assignment allowed. If John held no administrative credential, system would require temporary credential application or justification." ;
	<urn:solutiondesign:ontology:rationale> "Michigan law requires appropriate credentialing for instructional and administrative roles. Improper placement may result in state aid deductions." ;
	<urn:solutiondesign:ontology:statement> "An employee assigned to a position with Education Job Type of Administrator or Instructional must hold a valid credential for that position type. If not, district must either apply for temporary credential or submit credential error justification." .

<urn:solutiondesign:instance:staffing:Rule_EmploymentEndDateSeparationReasonCorequirement> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:example> "District reports Jane Smith's employment ending on 6/30/2025 due to Retirement. Both fields required. If district attempts to save only end date without reason, validation error prevents submission." ;
	<urn:solutiondesign:ontology:rationale> "Termination records must be complete for state reporting and historical analysis. Partial termination data indicates a data quality issue." ;
	<urn:solutiondesign:ontology:statement> "If an employee has an Employment End Date, an Employment Separation Reason must also be provided. Conversely, if a Separation Reason is provided, an End Date is required." .

<urn:solutiondesign:instance:staffing:Rule_EndorsementAlignmentForTeaching> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:AssignmentAggregate> ;
	<urn:solutiondesign:ontology:example> "District assigns Sarah Lee to teach High School Biology (SCED 03001). System checks Credentialing domain and finds Sarah holds Secondary Biology endorsement covering grades 6-12. Assignment allowed. If Sarah only held Elementary Science endorsement, system would require justification or temporary credential." ;
	<urn:solutiondesign:ontology:rationale> "Subject-area endorsements ensure teachers are qualified to teach specific content. Misalignment triggers audit review and potential aid penalties." ;
	<urn:solutiondesign:ontology:statement> "A Teacher position assignment with reported course details (SCED code and grade span) requires the employee to hold endorsements covering that content area and grade level. If not, district must apply for temporary credential or submit credential error justification." .

<urn:solutiondesign:instance:staffing:Rule_EvaluationOutcomeAppealWindow> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:example> "On 10/1/2025, district discovers a data entry error for the 2023-24 evaluation outcome for Teacher Bob Smith. Since 2023-24 is within the 5-year window, district can submit an appeal to change the outcome from Ineffective to Effective. Citizen Bob Smith can also appeal this outcome at any time via his citizen account." ;
	<urn:solutiondesign:ontology:rationale> "Allows correction of data entry errors while maintaining historical integrity. Citizens retain permanent appeal rights over their performance records." ;
	<urn:solutiondesign:ontology:statement> "Evaluation outcomes can be appealed by district users only if the school year is within the defined appealable window (currently 5 years). Citizens can appeal any evaluation outcome within their record." .

<urn:solutiondesign:instance:staffing:Rule_FrozenPositionProhibitsAssignment> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:example> "District sets Principal position at Lincoln Elementary to Frozen status effective 7/1/2024 due to pending budget cuts. Current principal Susan Taylor's assignment automatically ends 7/1/2024. Position cannot be filled until status changes to Active or Approved." ;
	<urn:solutiondesign:ontology:rationale> "Frozen positions are temporarily inactive (e.g., during budget uncertainty). Allowing active assignments would create data integrity issues and reporting confusion." ;
	<urn:solutiondesign:ontology:statement> "A position with status Frozen cannot have an active employee assignment. If an employee was previously assigned, the association ends after the effective date of the Frozen status change." .

<urn:solutiondesign:instance:staffing:Rule_ISDAuditItemCreatedAfterCertification> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:AuditWorkItemAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:example> "Oak Grove School District (constituent of Washtenaw ISD) certifies its Fall 2024 Employee Roster on 11/15/2024. System automatically creates an audit work item scoped to Washtenaw ISD, which appears in Washtenaw ISD auditors' audit item list." ;
	<urn:solutiondesign:ontology:rationale> "ISD auditors are responsible for reviewing district-level employment and placement data for compliance. Automatic audit work item creation ensures timely audit initiation." ;
	<urn:solutiondesign:ontology:statement> "When a district certifies their Employee Roster and Assignment Details collection, an audit work item is automatically created for the constituent district's ISD/RESA entity, visible to that ISD's auditors through Staffing's own audit item list (staffing.audit.view, scoped to their ISD/RESA entity)." .

<urn:solutiondesign:instance:staffing:Rule_NewTeacherMonitoringRequirement> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:CollectionAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:EmployeeRosterAggregate> ;
	<urn:solutiondesign:ontology:example> "District hires Emily Green in her first year of teaching on 9/1/2024. System sets New Teacher flag to true. District must assign mentor (via Unique ID lookup or free-form entry if no ID) and link eligible SCECH sessions before certifying 2024-25 collection. After 3 years of employment, flag sets to false and monitoring data becomes read-only." ;
	<urn:solutiondesign:ontology:rationale> "Michigan law (MCL 380.1526) requires structured support and professional development for beginning teachers." ;
	<urn:solutiondesign:ontology:statement> "An employee flagged as New Teacher (within first 3 years of classroom teaching) must have the New Teacher Monitoring component completed before collection certification, including mentor assignment and SCECH tracking toward the 15-day professional development requirement over 3 years." .

<urn:solutiondesign:instance:staffing:Rule_PositionGradeSpanAlignsWithBuildingAuthorization> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:example> "Lincoln Elementary (authorized K-5) creates a position for 3rd Grade Teacher with a SCED course spanning grades 3-5. System allows it. If the district tries to assign High School Biology (grades 9-12) to Lincoln Elementary, the system blocks with validation error: 'Building not authorized for grades 9-12'." ;
	<urn:solutiondesign:ontology:notes> "Validates against Building grade authorization from the organizations (organization-reference-data) domain, not yet converted into mied-v3." ;
	<urn:solutiondesign:ontology:rationale> "No rationale documented in staffing-domain.md — the source table cell is empty." ;
	<urn:solutiondesign:ontology:statement> "A position created at a specific building with assigned course grade spans must only include grades that the building is authorized to offer." .

<urn:solutiondesign:instance:staffing:Rule_PositionStatusCancelledRequiresReason> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:staffing:PositionRosterAggregate> ;
	<urn:solutiondesign:ontology:example> "District cancels Bus Driver position on 12/15/2024 due to Decreased Workload (route elimination). Cancellation reason required for status change to save successfully." ;
	<urn:solutiondesign:ontology:rationale> "Understanding why positions are eliminated (e.g., Budgetary Reduction vs. Organizational Restructuring) informs policy and funding decisions." ;
	<urn:solutiondesign:ontology:statement> "When a position status is set to Cancelled, a Job Position Status Cancelled Reason must be provided." .

<urn:solutiondesign:instance:staffing:Seq_AddNewEmployee> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Add New Employee\n---\nsequenceDiagram\n    actor DistrictUser\n    participant StaffingUI\n    participant StaffingAPI\n    participant IAM_API\n    participant ProfPracticeAPI\n    participant CommAPI\n\n    DistrictUser->>StaffingUI: Navigate to \"Add New Employee\"\n    StaffingUI->>StaffingAPI: GET /employee-roster/search (name, DOB)\n    StaffingAPI-->>StaffingUI: Search results or empty\n\n    alt Match found - use existing Unique ID\n        DistrictUser->>StaffingUI: Select matching record\n        StaffingUI->>StaffingAPI: POST /employee-roster/add-employee (pre-populated demographics + Unique ID)\n    else No match - create new record\n        DistrictUser->>StaffingUI: Enter demographic data (no Unique ID)\n        StaffingUI->>StaffingAPI: POST /employee-roster/add-employee (demographics, no Unique ID)\n    end\n\n    StaffingAPI->>StaffingAPI: Validate demographics (field-level rules)\n\n    alt Validation fails\n        StaffingAPI-->>StaffingUI: 400 Bad Request (validation errors)\n        StaffingUI-->>DistrictUser: Display errors\n    else Validation passes\n        StaffingAPI->>StaffingAPI: Create employee record (status: Pending)\n\n        alt No Unique ID yet (new record)\n            StaffingAPI->>IAM_API: POST /identity-resolution/requests (origin=BusinessUserStaffing, type=NewId, employeeRecordId, demographics)\n\n            alt IAM/Mi-Key returns Match or No-Match\n                IAM_API-->>StaffingAPI: 200/201 {uniqueId}\n                StaffingAPI->>StaffingAPI: Associate Unique ID with employee record\n            else IAM/Mi-Key returns Near Match (Requires Resolution)\n                IAM_API-->>StaffingAPI: 202 Accepted {requestId, potentialMatches[]}\n                StaffingAPI-->>StaffingUI: 202 Accepted (near match resolution required)\n                StaffingUI-->>DistrictUser: Show near-match resolution screen (backed by IAM's identity-resolution API)\n                Note over DistrictUser,IAM_API: See iam-sequences.md: \"Business User - Request New ID (Near Match Escalation)\"\n            end\n        end\n\n        StaffingAPI->>IAM_API: POST /permissions/check (user, entity, staffing.employee-roster.add-employee)\n        IAM_API-->>StaffingAPI: 200 OK {allowed: true}\n\n        StaffingAPI->>ProfPracticeAPI: GET /educators/{uniqueId}/roster-eligibility\n        ProfPracticeAPI-->>StaffingAPI: 200 OK {eligible: true, pprFlags: []}\n\n        alt PPR flags restrict employment\n            StaffingAPI-->>StaffingUI: 403 Forbidden (PPR restriction)\n            StaffingUI-->>DistrictUser: Display error: \"Employee cannot be added due to PPR restrictions\"\n        else Eligible for employment\n            StaffingAPI--)CommAPI: Publish EmployeeAddedToRoster event\n            StaffingAPI-->>StaffingUI: 201 Created {employeeRecordId, uniqueId}\n            StaffingUI-->>DistrictUser: Success - redirect to employment details entry\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Demographic validation fails > 400 Bad Request with field-level errors. PPR flags restrict employment > 403 Forbidden, block employee addition. IAM/Mi-Key service timeout > 503 Service Unavailable, user retries later. Unique ID already in entity roster > 409 Conflict, user selects existing record instead." ;
	<urn:solutiondesign:ontology:eventsPublished> "EmployeeAddedToRoster - Triggers notification to citizen account if exists, PPR clearance re-validation" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "System requires user to search before adding to prevent duplicate Unique ID associations within same district. Staffing never calls Mi-Key directly — identity resolution (matching, Near Match handling) is entirely IAM's, triggered here via API call. PPR clearance check is blocking; employee cannot be added if restricted by professional practice flags." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Add New Employee" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District user adds a new employee to the roster by searching for existing identity or creating new record, triggering Unique ID assignment via Mi-Key service. When: District hires new staff member and needs to report employment within 30 days (MCL 388.1619). Who: Staffing Authorized User (School District role)." .

<urn:solutiondesign:instance:staffing:Seq_AssignEmployeeToPosition> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Assign Employee to Position\n---\nsequenceDiagram\n    actor DistrictUser\n    participant StaffingUI\n    participant StaffingAPI\n    participant CredentialingAPI\n    participant CommAPI\n\n    DistrictUser->>StaffingUI: Navigate to position > \"Add Filled Spot\"\n    StaffingUI->>StaffingAPI: GET /positions/{positionId}/details\n    StaffingAPI-->>StaffingUI: 200 OK {position, educationJobType, localJobCategory, approvedFTE}\n\n    StaffingUI-->>DistrictUser: Step 1: Spot Details (SCED course?, grade levels, FTE allocation, start date)\n    DistrictUser->>StaffingUI: Enter spot details > Next\n\n    StaffingUI-->>DistrictUser: Step 2: Select Employee (search + toggle \"Only appropriately certified\")\n    StaffingUI->>StaffingAPI: GET /employee-roster/search-active (entityCode, filters)\n    StaffingAPI-->>StaffingUI: 200 OK {employees[], activeEmploymentStatus}\n\n    DistrictUser->>StaffingUI: Select employee > Next\n    StaffingUI->>StaffingAPI: POST /assignments/validate-placement (employeeId, positionId, scedCode?, gradeSpan?)\n\n    StaffingAPI->>CredentialingAPI: GET /educators/{uniqueId}/credentials\n    CredentialingAPI-->>StaffingAPI: 200 OK {credentials[], endorsements[]}\n\n    alt Administrator/Instructional position requires credential\n        StaffingAPI->>StaffingAPI: Validate credential exists for educationJobType\n\n        alt Credential valid\n            StaffingAPI-->>StaffingUI: 200 OK {meetsRequirements: true}\n        else Credential missing/invalid\n            StaffingAPI-->>StaffingUI: 200 OK {meetsRequirements: false, missingCredential: true}\n        end\n    end\n\n    alt Teacher position with course details requires endorsement\n        StaffingAPI->>StaffingAPI: Validate endorsement covers SCED code + grade span\n\n        alt Endorsement valid\n            StaffingAPI-->>StaffingUI: 200 OK {meetsRequirements: true}\n        else Endorsement missing/invalid\n            StaffingAPI-->>StaffingUI: 200 OK {meetsRequirements: false, missingEndorsement: true}\n        end\n    end\n\n    alt PPR clearance required\n        StaffingAPI->>StaffingAPI: Check for PPR flags (if disclosure prevents assignment)\n\n        alt PPR flag blocks assignment\n            StaffingAPI-->>StaffingUI: 403 Forbidden {pprRestriction: true}\n            StaffingUI-->>DistrictUser: Blocking error - cannot assign due to PPR disclosure\n        end\n    end\n\n    StaffingUI-->>DistrictUser: Step 3: Confirm and Add (display credentials, endorsements, validation results)\n\n    alt Meets all requirements\n        DistrictUser->>StaffingUI: Confirm assignment\n        StaffingUI->>StaffingAPI: POST /assignments/create (employeeId, positionId, spotDetails)\n        StaffingAPI->>StaffingAPI: Create assignment (status: Active)\n        StaffingAPI->>StaffingAPI: Update position FTE health indicator\n        StaffingAPI--)CommAPI: Publish EmployeeAssignedToPosition event\n        StaffingAPI-->>StaffingUI: 201 Created {assignmentId}\n        StaffingUI-->>DistrictUser: Success - assignment created, return to position view\n\n    else Does not meet requirements\n        StaffingUI-->>DistrictUser: Show options: \"Apply for Temporary Credential\" or \"Submit Justification\"\n\n        alt Apply for Temporary Credential\n            DistrictUser->>StaffingUI: Select \"Apply for Temporary Credential\"\n            StaffingUI-->>DistrictUser: Redirect to Credentialing domain temporary credential workflow\n            Note over DistrictUser: After temporary credential granted, return to assignment\n\n        else Submit Credential Error Justification\n            DistrictUser->>StaffingUI: Select \"Submit Justification\" + enter free-form text\n            StaffingUI->>StaffingAPI: POST /assignments/create-with-justification (employeeId, positionId, spotDetails, justificationText)\n            StaffingAPI->>StaffingAPI: Create assignment (status: Justified - credential error)\n            StaffingAPI--)CommAPI: Publish CredentialErrorJustificationSubmitted event\n            CommAPI--)AuditorRole: Alert SOM Auditor of placement issue\n            StaffingAPI-->>StaffingUI: 201 Created {assignmentId, status: Justified}\n            StaffingUI-->>DistrictUser: Warning - assignment created with justification, potential aid deduction\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "PPR flag blocks assignment > 403 Forbidden, user cannot proceed. Invalid SCED code or grade span > 400 Bad Request, user corrects and resubmits. Employee already assigned to same position/course > 409 Conflict, user reviews existing assignment. FTE allocation exceeds available FTE for position > Warning only, assignment allowed." ;
	<urn:solutiondesign:ontology:eventsPublished> "EmployeeAssignedToPosition - Triggers notification to employee if citizen account exists. CredentialErrorJustificationSubmitted - Alerts SOM Auditor via inclusion in the audit item list." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Three-step assignment workflow (spot details > select employee > confirm) ensures complete data entry before validation. Credential validation is non-blocking but forces justification or temporary credential path if missing. PPR flags can block assignment entirely (blocking error) if disclosure indicates risk. FTE health indicator recalculates after spot creation but does not block assignment." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Assign Employee to Position" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District user assigns an employee to a position, triggering credential validation and spot allocation. If credentials are missing, user submits justification or applies for temporary credential. When: Employee is hired or reassigned to different position/course. Who: Staffing Authorized User (School District role)." .

<urn:solutiondesign:instance:staffing:Seq_CertifyCollection> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Certify Collection\n---\nsequenceDiagram\n    actor DistrictUser\n    participant StaffingUI\n    participant StaffingAPI\n    participant CommAPI\n\n    DistrictUser->>StaffingUI: Navigate to Collection Certification page\n    StaffingUI->>StaffingAPI: GET /collections/{collectionId}/certification-status\n    StaffingAPI-->>StaffingUI: 200 OK {preTasksComplete, errorCount, warningCount, status}\n\n    StaffingUI-->>DistrictUser: Display workflow steps (pre-tasks > quality review > justifications > attestation > certify)\n\n    alt Pre-certification tasks incomplete\n        StaffingUI-->>DistrictUser: Block quality review - complete required tasks first\n        DistrictUser->>StaffingUI: Complete tasks (update records, resolve errors, run reports)\n    end\n\n    DistrictUser->>StaffingUI: Run Quality Review\n    StaffingUI->>StaffingAPI: POST /collections/{collectionId}/quality-review\n    StaffingAPI->>StaffingAPI: Execute validation rules (record-level, cross-record, historical, EEM alignment)\n    StaffingAPI-->>StaffingUI: 200 OK {errors[], warnings[], justificationRequired[]}\n\n    StaffingUI-->>DistrictUser: Display quality review results\n\n    alt Errors exist\n        StaffingUI-->>DistrictUser: Block certification - correct errors first\n        DistrictUser->>StaffingUI: Navigate to error records > correct data > re-run quality review\n        Note over DistrictUser: Loop until all errors resolved\n    end\n\n    alt Justification-required conditions exist\n        StaffingUI-->>DistrictUser: Display justification-required items\n        DistrictUser->>StaffingUI: Enter justification text for each item\n        StaffingUI->>StaffingAPI: POST /collections/{collectionId}/justifications (justifications[])\n        StaffingAPI->>StaffingAPI: Store justifications linked to collection\n        StaffingAPI-->>StaffingUI: 200 OK\n    end\n\n    StaffingUI-->>DistrictUser: Display attestation text + e-signature field\n    DistrictUser->>StaffingUI: Agree to attestation + e-sign\n    StaffingUI->>StaffingAPI: POST /collections/{collectionId}/certify (attestationAgreed, eSignature)\n\n    StaffingAPI->>StaffingAPI: Verify all pre-conditions met (no errors, all justifications, attestation)\n\n    alt Preconditions not met\n        StaffingAPI-->>StaffingUI: 400 Bad Request (specific reason)\n        StaffingUI-->>DistrictUser: Display error - cannot certify yet\n    else Preconditions met\n        StaffingAPI->>StaffingAPI: Mark collection as Certified (timestamp, certifying user)\n        StaffingAPI->>StaffingAPI: Lock all records in collection (read-only except via reopen)\n        StaffingAPI->>StaffingAPI: Create AuditWorkItem for constituent ISD/RESA entity (status: New)\n        StaffingAPI--)CommAPI: Publish CollectionCertified event\n        CommAPI--)ISDAuditor: Email alert of new district submission ready for review\n\n        StaffingAPI-->>StaffingUI: 200 OK {certificationTimestamp}\n        StaffingUI-->>DistrictUser: Success - collection certified, data finalized\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Error records still exist when certification attempted > 400 Bad Request, user corrects errors. Justifications missing for required items > 400 Bad Request, user provides justifications. Legislative deadline passed without certification > User must request Collection Exception. Network failure during certification > 500 Internal Server Error, user retries (idempotent)." ;
	<urn:solutiondesign:ontology:eventsPublished> "CollectionCertified - Triggers audit work item creation for the constituent ISD/RESA entity, email notifications" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Quality review must be run before certification but can be run multiple times as errors are corrected. Errors are blocking, warnings are informational only. Justifications are required only for specific validation conditions. Attestation and e-signature legally bind the certifying user to data accuracy." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Certify Collection" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District user runs quality review, resolves errors, provides justifications, and certifies collection after attestation, triggering creation of an audit work item for the district's ISD/RESA entity. When: End of collection period (e.g., Fall 2024 Employee Roster due by legislative deadline). Who: Staffing Authorized User (School District role) with certification permission." .

<urn:solutiondesign:instance:staffing:Seq_CreateNewPosition> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Create New Position\n---\nsequenceDiagram\n    actor DistrictUser\n    participant StaffingUI\n    participant StaffingAPI\n    participant EEMAPI\n    participant CommAPI\n\n    DistrictUser->>StaffingUI: Navigate to Positions > \"Add Position\"\n    StaffingUI-->>DistrictUser: Display position creation form (title, job type, category, function, building, approved FTE)\n\n    DistrictUser->>StaffingUI: Enter position details > Save\n    StaffingUI->>StaffingAPI: POST /positions/create (entityCode, positionDetails)\n\n    StaffingAPI->>StaffingAPI: Validate position fields (approved FTE > 0, job type/category/function alignment)\n\n    alt Validation fails\n        StaffingAPI-->>StaffingUI: 400 Bad Request (validation errors)\n        StaffingUI-->>DistrictUser: Display errors\n    else Validation passes\n        StaffingAPI->>EEMAPI: GET /organizations/{entityCode}/buildings\n        EEMAPI-->>StaffingAPI: 200 OK {buildings[]}\n        StaffingAPI->>StaffingAPI: Validate building code exists in entity\n\n        alt Building invalid\n            StaffingAPI-->>StaffingUI: 400 Bad Request (invalid building code)\n            StaffingUI-->>DistrictUser: Display error\n        else Building valid\n            StaffingAPI->>StaffingAPI: Generate position identifier (system-generated)\n            StaffingAPI->>StaffingAPI: Create position (status: Active, filled FTE: 0, vacant FTE: 0, frozen FTE: 0)\n            StaffingAPI--)CommAPI: Publish PositionCreated event\n            StaffingAPI-->>StaffingUI: 201 Created {positionId, positionIdentifier}\n            StaffingUI-->>DistrictUser: Success - redirect to position assignments page\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Approved FTE <= 0 > 400 Bad Request, must be positive. Invalid job type/category/function combination > 400 Bad Request, user corrects. Building code not in entity's EEM data > 400 Bad Request, user selects valid building. Duplicate position title within entity > Warning only, creation allowed." ;
	<urn:solutiondesign:ontology:eventsPublished> "PositionCreated - Triggers dashboard updates, notifications if configured" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Position identifier is system-generated to ensure uniqueness. Default status is Active (no employee assignment yet). Building validation against EEM ensures positions linked to valid entity hierarchy. FTE health indicator shows mismatch immediately (approved FTE > 0, filled FTE = 0)." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Create New Position" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District user creates a new position in the organizational chart, defining job type, approved FTE, and position status. When: District approves new staffing allocation for upcoming school year or mid-year need arises. Who: Staffing Authorized User (School District role)." .

<urn:solutiondesign:instance:staffing:Seq_ISDAuditorReviewDistrictSubmission> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - ISD Auditor Review District Submission\n---\nsequenceDiagram\n    actor ISDAuditor\n    participant AuditUI\n    participant StaffingAPI\n    participant CommAPI\n\n    Note over ISDAuditor,StaffingAPI: Triggered by CollectionCertified event creating an audit work item\n\n    ISDAuditor->>AuditUI: View Audit Items\n    AuditUI->>StaffingAPI: GET /audit/items (isdCode)\n    StaffingAPI-->>AuditUI: 200 OK {auditItems[], statuses[], dueDates[], credentialErrorJustifications[]}\n\n    AuditUI-->>ISDAuditor: Display audit item list (district, audit type, due date, status)\n\n    ISDAuditor->>AuditUI: Select district > View Data Collection Report\n    AuditUI->>StaffingAPI: GET /audit/{auditItemId}/district-report (districtCode)\n    StaffingAPI-->>AuditUI: 200 OK {sections: {employeesNotAppropriated[], employeesNoAssignment[], changesSummary[], ...}}\n\n    AuditUI-->>ISDAuditor: Display report sections (employees not appropriately placed, etc.)\n\n    alt Issues identified requiring documentation\n        ISDAuditor->>AuditUI: Request Additional Documentation (specify doc type)\n        AuditUI->>StaffingAPI: POST /audit/{auditItemId}/request-documentation (docType, details)\n        StaffingAPI->>StaffingAPI: Create document request (status: Awaiting District Response)\n        StaffingAPI--)CommAPI: Publish DocumentRequestCreated event\n        CommAPI--)DistrictUser: Email alert to Staffing Data role users for district\n        StaffingAPI-->>AuditUI: 201 Created {documentRequestId}\n\n        Note over DistrictUser: District uploads requested documentation via Documents domain\n\n        StaffingAPI->>StaffingAPI: Update audit item status to Awaiting District Response\n    end\n\n    alt Placement issues require formal finding\n        ISDAuditor->>AuditUI: Create Audit Finding\n        AuditUI->>StaffingAPI: POST /audit/{auditItemId}/findings (districtCode, individualDetails, issue, justification, uploadedDocs[])\n        StaffingAPI->>StaffingAPI: Store audit finding linked to audit item\n        StaffingAPI-->>AuditUI: 201 Created {findingId}\n    end\n\n    ISDAuditor->>AuditUI: All required tasks complete > Finalize Audit Report\n    AuditUI->>StaffingAPI: GET /audit/{auditItemId}/certification-status\n    StaffingAPI-->>AuditUI: 200 OK {allTasksComplete, findingsCount}\n\n    alt Tasks incomplete\n        StaffingAPI-->>AuditUI: 400 Bad Request (incomplete tasks listed)\n        AuditUI-->>ISDAuditor: Display error - complete all tasks before finalization\n    else Tasks complete\n        AuditUI-->>ISDAuditor: Display attestation + e-signature field\n        ISDAuditor->>AuditUI: Agree to attestation + e-sign\n        AuditUI->>StaffingAPI: POST /audit/{auditItemId}/finalize (attestationAgreed, eSignature)\n\n        StaffingAPI->>StaffingAPI: Mark audit as Completed (timestamp, auditor user)\n        StaffingAPI->>StaffingAPI: Lock audit report (read-only except during de-certification window)\n        StaffingAPI--)CommAPI: Publish AuditReportFinalized event\n        CommAPI--)SOMAuditor: Email alert of finalized ISD audit for SOM review\n\n        StaffingAPI-->>AuditUI: 200 OK {finalizationTimestamp}\n        AuditUI-->>ISDAuditor: Success - audit report finalized\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "District does not respond to document request within deadline > Audit status remains Awaiting District Response, escalation to SOM. ISD Auditor attempts to finalize without completing all tasks > 400 Bad Request. Network failure during finalization > 500 Internal Server Error, user retries (idempotent)." ;
	<urn:solutiondesign:ontology:eventsPublished> "DocumentRequestCreated - Triggers email to district Staffing Data role users. AuditReportFinalized - Triggers SOM Auditor notification, adds item to SOM Auditor's audit item list." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "ISD Auditor's audit item list auto-populated by district certification event. Document requests are tracked as separate entities linked to audit item, with status updates. Audit findings stored for SOM Auditor review (downstream workflow). Finalized audit reports are read-only but can be de-certified during allowable window for corrections." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "ISD Auditor Review District Submission" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: ISD Auditor reviews district-certified collection, validates appropriate placement, requests additional documentation if needed, and finalizes audit report. When: After district certifies Employee Roster and Assignment Details collection. Who: ISD Auditor (for constituent districts within ISD/RESA)." .

<urn:solutiondesign:instance:staffing:Seq_OpenNewCollection> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Open New Collection\n---\nsequenceDiagram\n    participant Scheduler\n    participant StaffingAPI\n    participant CommAPI\n    actor DistrictUser\n    participant StaffingUI\n\n    Scheduler->>StaffingAPI: Trigger new school-year collection initialization (entityCode, schoolYear)\n    StaffingAPI->>StaffingAPI: Create Collection (status: Open) for entity/schoolYear\n    StaffingAPI->>StaffingAPI: Load prior collection's Position Roster and Employee Roster records\n\n    loop For each prior-collection Position/EmployeeRecord\n        alt Record has no end date (or, for positions, no Cancelled status + reason)\n            StaffingAPI->>StaffingAPI: Carry record forward into new collection with existing metadata\n        else Record has end date and separation/cancellation reason\n            StaffingAPI->>StaffingAPI: Exclude record from new collection; remains queryable in historical view\n        end\n    end\n\n    StaffingAPI->>StaffingAPI: Recalculate FTE health indicators and data-quality flags for carried-forward positions\n    StaffingAPI->>StaffingAPI: Log rollover outcome (counts carried forward, counts excluded, errors)\n    StaffingAPI--)CommAPI: Publish CollectionOpened event\n\n    DistrictUser->>StaffingUI: Log in after rollover, navigate to Position/Employee Roster\n    StaffingUI->>StaffingAPI: GET /collections?schoolYear={new}&entityCode={entity}\n    StaffingAPI-->>StaffingUI: 200 OK {collection, carriedForwardRecords[], dataQualityIndicators[]}\n    StaffingUI-->>DistrictUser: Display new collection as basis for the year, prior year available read-only\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Unexpected error during rollover for a specific record > Logged and flagged for Staffing Data Admin review; does not block rollover for other records. District logs in before rollover completes > Prior year's roster displayed as read-only until rollover finishes." ;
	<urn:solutiondesign:ontology:eventsPublished> "CollectionOpened - Signals downstream systems (dashboards, reporting) that a new collection year is available" ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Rollover requires no user action; it runs automatically when the new school year becomes active. A record is carried forward only when it lacks both an end date and (for positions) a cancellation reason — matching the existing 'Employment End Date and Separation Reason Co-requirement' and 'Position Status Cancelled Requires Reason' invariants. Excluded records remain visible in historical, read-only views. FTE health indicators and data-quality flags are recalculated immediately after rollover." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Open New Collection" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: System automatically initializes a new school-year collection at the start of the academic year, carrying forward active Position Roster and Employee Roster records from the prior collection and excluding ended/cancelled ones. District users can view the prior year's roster read-only and see data-quality indicators flagged immediately after rollover. When: Start of a new school year, per the Staffing Data Admin's defined collection schedule. Who: System-triggered (no user action); Staffing Authorized Users view the result." .

<urn:solutiondesign:instance:staffing:Seq_RequestCollectionException> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Request Collection Exception\n---\nsequenceDiagram\n    actor DistrictUser\n    participant StaffingUI\n    participant StaffingAPI\n    actor StaffingDataAdmin\n    participant CommAPI\n\n    Note over DistrictUser,StaffingAPI: Context: Collection deadline passed, certification blocked\n\n    DistrictUser->>StaffingUI: Navigate to Collection > \"Request Exception\"\n    StaffingUI->>StaffingAPI: GET /collections/{collectionId}/exception-eligibility\n    StaffingAPI-->>StaffingUI: 200 OK {deadlinePassed: true, exceptionAvailable: true}\n\n    StaffingUI-->>DistrictUser: Display exception request form (requested extension dates, justification)\n    DistrictUser->>StaffingUI: Enter justification + requested dates > Submit\n    StaffingUI->>StaffingAPI: POST /collection-exceptions/request (collectionId, entityCode, justification, requestedDates)\n\n    StaffingAPI->>StaffingAPI: Validate request (deadline passed, dates future-dated, justification provided)\n\n    alt Validation fails\n        StaffingAPI-->>StaffingUI: 400 Bad Request (validation errors)\n        StaffingUI-->>DistrictUser: Display errors\n    else Validation passes\n        StaffingAPI->>StaffingAPI: Create exception request (status: Pending)\n        StaffingAPI--)CommAPI: Publish CollectionExceptionRequested event\n        StaffingAPI-->>StaffingUI: 201 Created {exceptionRequestId}\n        StaffingUI-->>DistrictUser: Success - request pending admin review\n\n        Note over StaffingDataAdmin: Staffing Data Admin reviews pending exception requests (staffing.admin.process-exceptions)\n\n        alt Admin approves request\n            StaffingDataAdmin->>StaffingAPI: POST /admin/collection-exceptions/{requestId}/approve (approvedDates)\n            StaffingAPI->>StaffingAPI: Mark exception as Approved\n            StaffingAPI->>StaffingAPI: Update collection open/close dates\n            StaffingAPI--)CommAPI: Publish CollectionExceptionApproved event\n            CommAPI--)DistrictUser: Email notification of approval with new dates\n\n        else Admin denies request\n            StaffingDataAdmin->>StaffingAPI: POST /admin/collection-exceptions/{requestId}/deny (denialReason)\n            StaffingAPI->>StaffingAPI: Mark exception as Denied\n            StaffingAPI--)CommAPI: Publish CollectionExceptionDenied event\n            CommAPI--)DistrictUser: Email notification of denial with reason\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Request submitted before deadline > 400 Bad Request, not eligible for exception yet. Requested dates in past > 400 Bad Request, dates must be future-dated. Empty justification > 400 Bad Request, justification required. Admin approval fails to update collection dates > 500 Internal Server Error, admin retries." ;
	<urn:solutiondesign:ontology:eventsPublished> "CollectionExceptionRequested - Pending Staffing Data Admin review. CollectionExceptionApproved - Notifies district, reopens collection. CollectionExceptionDenied - Notifies district with denial reason." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Exception requests only available after deadline has passed (prevents preemptive extensions). Staffing Data Admin has discretion to approve/deny based on justification. Approved exceptions update collection dates, allowing continued submission. Denial reason required to help district understand expectations." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Request Collection Exception" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District user requests permission to submit/certify collection data past legislative deadline, providing justification for delay. When: Collection deadline has passed and district needs additional time to complete submission. Who: Staffing Authorized User (School District role)." .

<urn:solutiondesign:instance:staffing:Seq_UpdateEmployeeDemographics> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Update Employee Demographics\n---\nsequenceDiagram\n    actor User\n    participant StaffingUI\n    participant StaffingAPI\n    participant IAM_API\n    participant CommAPI\n\n    User->>StaffingUI: Navigate to employee record > \"Update Demographics\"\n    StaffingUI->>StaffingAPI: GET /employee-roster/{employeeId}/demographics\n    StaffingAPI-->>StaffingUI: 200 OK {demographics, uniqueId, updateHistory[]}\n    StaffingUI-->>User: Display demographic form (read-only fields editable)\n\n    User->>StaffingUI: Update demographic fields + submit\n    StaffingUI->>StaffingAPI: PATCH /employee-roster/{employeeId}/demographics (changedFields)\n\n    StaffingAPI->>StaffingAPI: Validate changed fields (field-level rules)\n\n    alt Validation fails\n        StaffingAPI-->>StaffingUI: 400 Bad Request (validation errors)\n        StaffingUI-->>User: Display errors\n    else Validation passes\n        StaffingAPI->>IAM_API: POST /identity-resolution/requests (origin=BusinessUserStaffing, type=DemographicUpdate, employeeRecordId, changedFields)\n\n        alt IAM/Mi-Key returns Match (record updated)\n            IAM_API-->>StaffingAPI: 200 OK {updateTimestamp}\n            StaffingAPI->>StaffingAPI: Store demographic update in history (modified by, date)\n            StaffingAPI--)CommAPI: Publish DemographicDataUpdated event\n\n            alt Updated by District User\n                CommAPI--)User: Email citizen account (if exists) notifying of district update\n            else Updated by Citizen User\n                CommAPI--)StaffingAPI: Trigger alert to district users for entity\n            end\n\n            StaffingAPI-->>StaffingUI: 200 OK {updateTimestamp}\n            StaffingUI-->>User: Success confirmation with history view\n\n        else IAM/Mi-Key returns Near Match (Requires Resolution)\n            IAM_API-->>StaffingAPI: 202 Accepted {requestId, candidateUniqueId, matchScore}\n            StaffingAPI->>StaffingAPI: Set employee record status to \"Requires Resolution\"; submitted data held by IAM in temporary storage (not persisted to EmployeeRoster)\n            StaffingAPI-->>StaffingUI: 202 Accepted (near match resolution required)\n            StaffingUI-->>User: Show near-match resolution screen (submitted data vs. same-Unique-ID candidate only, backed by IAM's identity-resolution API)\n\n            Note over User,IAM_API: Update-path Near Match differs from Add-New-Employee: only the candidate sharing the submitted Unique ID is shown (other Unique IDs are never surfaced here); user may not \"Request New ID\" on this path (FDD 15.3) — self-resolved by the user, never escalated to the Identity Administrator except via auto-cancel timeout\n\n            alt User confirms this is the correct individual\n                User->>StaffingUI: Review comparison table; answer \"Replace master record with submitted data?\" (Yes/No); agree to attestation\n                StaffingUI->>IAM_API: POST /identity-resolution/requests/{requestId}/resolve (selectedUniqueId, replaceMasterRecord: true|false)\n                IAM_API->>IAM_API: Resolve near match; if replaceMasterRecord, update Mi-Key Master Record\n                IAM_API--)StaffingAPI: IdentityResolutionCompleted / PersonRecordUpdated event\n                StaffingAPI->>StaffingAPI: Store demographic update in history; clear \"Requires Resolution\" status\n                StaffingAPI--)CommAPI: Publish DemographicDataUpdated event (cross-notification per update source)\n                StaffingAPI-->>StaffingUI: 200 OK {updateTimestamp}\n                StaffingUI-->>User: Success confirmation\n\n            else User cancels the near match\n                User->>StaffingUI: Select \"Cancel\"\n                StaffingUI->>IAM_API: POST /identity-resolution/requests/{requestId}/cancel\n                IAM_API--)StaffingAPI: IdentityRequestCancelled event\n                StaffingAPI->>StaffingAPI: Discard temporary data; clear \"Requires Resolution\" status; no update applied\n                StaffingAPI-->>StaffingUI: 200 OK\n                StaffingUI-->>User: Update cancelled - record unchanged\n            end\n        end\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "IAM/Mi-Key update fails due to conflict (concurrent update) > 409 Conflict, user refreshes and retries. Citizen updates demographics but district does not have notification configured > No error, event published but no email sent. Invalid SSN format > 400 Bad Request before IAM call. Near Match left unresolved past the configured timeout > IAM auto-cancels, sends cancellation to Mi-Key, discards temporary data, publishes IdentityRequestCancelled." ;
	<urn:solutiondesign:ontology:eventsPublished> "DemographicDataUpdated - Triggers cross-notifications based on update source" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "All demographic updates flow through IAM's identity resolution API (which in turn talks to Mi-Key) to maintain a single source of truth for identity matching — Staffing holds no Near Match state of its own beyond a 'Requires Resolution' flag. Update history stored locally for audit trail. Cross-notification pattern: citizen notified of district updates, district notified of citizen updates. Near Match on the Update path is intentionally narrower than on Add New Employee: only the candidate sharing the submitted Unique ID is ever displayed, and the user cannot escalate to 'Request New ID' — they may only confirm (optionally replacing the master record) or cancel. An unresolved Near Match auto-cancels after an admin-configurable timeframe (not yet numerically defined — see iam:Question_NearMatchAutoCancelTimeframe in abox/mied-v3/iam/iam-domain.ttl)." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Update Employee Demographics" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District user or citizen updates demographic information for employee, triggering Mi-Key synchronization and history tracking. When: Name change (marriage, legal name change), address update, or correction of demographic data. Who: Staffing Authorized User (School District role) or Citizen User (self-only)." .

<urn:solutiondesign:instance:staffing:Seq_UpdatePositionStatus> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:content> "---\ntitle: Staffing - Update Position Status\n---\nsequenceDiagram\n    actor DistrictUser\n    participant StaffingUI\n    participant StaffingAPI\n    participant CommAPI\n\n    DistrictUser->>StaffingUI: Navigate to Position Details > \"Update Status\"\n    StaffingUI->>StaffingAPI: GET /positions/{positionId}\n    StaffingAPI-->>StaffingUI: 200 OK {position, currentStatus, currentAssignments[]}\n\n    StaffingUI-->>DistrictUser: Display status update form (new status, status date, cancellation reason?)\n    DistrictUser->>StaffingUI: Select new status + enter required fields > Save\n    StaffingUI->>StaffingAPI: PATCH /positions/{positionId}/status (newStatus, statusDate, cancelReason?)\n\n    StaffingAPI->>StaffingAPI: Validate status transition rules\n\n    alt Status = Filled\n        alt No employee assigned\n            StaffingAPI-->>StaffingUI: 400 Bad Request (Filled status requires employee assignment)\n            StaffingUI-->>DistrictUser: Display error - assign employee first\n        else Employee assigned\n            StaffingAPI->>StaffingAPI: Update status to Filled\n        end\n\n    else Status = Approved\n        alt Expected start date not in future\n            StaffingAPI-->>StaffingUI: 400 Bad Request (Approved status requires future start date)\n            StaffingUI-->>DistrictUser: Display error\n        else Expected start date valid\n            alt Employee currently assigned\n                StaffingAPI-->>StaffingUI: 400 Bad Request (Approved status cannot have active employee)\n                StaffingUI-->>DistrictUser: Display error - remove employee assignment first\n            else No employee assigned\n                StaffingAPI->>StaffingAPI: Update status to Approved\n            end\n        end\n\n    else Status = Active\n        alt Employee assigned after effective date\n            StaffingAPI->>StaffingAPI: Update status to Active, end employee assignment at effective date\n        else No employee assigned\n            StaffingAPI->>StaffingAPI: Update status to Active\n        end\n\n    else Status = Frozen\n        alt Employee assigned\n            StaffingAPI->>StaffingAPI: Update status to Frozen, end employee assignment at effective date\n        else No employee assigned\n            StaffingAPI->>StaffingAPI: Update status to Frozen\n        end\n\n    else Status = Cancelled\n        alt Cancellation reason not provided\n            StaffingAPI-->>StaffingUI: 400 Bad Request (Cancelled status requires reason)\n            StaffingUI-->>DistrictUser: Display error\n        else Cancellation reason provided\n            alt Employee assigned after effective date\n                StaffingAPI->>StaffingAPI: Update status to Cancelled, end employee assignment at effective date\n            else No employee assigned\n                StaffingAPI->>StaffingAPI: Update status to Cancelled\n            end\n        end\n    end\n\n    StaffingAPI->>StaffingAPI: Record status change in audit history\n    StaffingAPI--)CommAPI: Publish PositionStatusChanged event\n    StaffingAPI-->>StaffingUI: 200 OK {updatedStatus, statusDate}\n    StaffingUI-->>DistrictUser: Success - status updated\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Filled status without employee > 400 Bad Request, user assigns employee first. Cancelled status without reason > 400 Bad Request, user provides reason. Approved status with current employee > 400 Bad Request, user removes assignment first. Status date in future > Warning only, status change allowed." ;
	<urn:solutiondesign:ontology:eventsPublished> "PositionStatusChanged - Triggers notifications if employee assignment ended" ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Status transition rules enforce data integrity (e.g., Filled requires employee, Frozen prohibits employee). Employee assignments automatically end when position becomes Frozen or Cancelled. Cancellation reason required to document why position eliminated. Status changes tracked in audit history for compliance reporting." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Update Position Status" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: District user changes position status (e.g., Active to Filled, Active to Frozen, Active to Cancelled), enforcing business rules for employee associations and required fields. When: Position is filled by employee, temporarily frozen due to budget, or permanently cancelled. Who: Staffing Authorized User (School District role)." .

