<urn:solutiondesign:instance:communications:CommunicationsContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:CapabilityDoc> ;
	<urn:solutiondesign:ontology:displayName> "Communications" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:communications:AlertAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:communications:CommentAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:communications:EmailInstanceAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:communications:EmailTemplateAggregate> ;
	<urn:solutiondesign:ontology:identifier> "communications" ;
	<urn:solutiondesign:ontology:kind> "PlatformCapability" ;
	<urn:solutiondesign:ontology:notes> "Classification rationale: foundational infrastructure (the *how* and *when* of sending communications), not the *why* — used by all core domains, but doesn't contain business logic about which business events warrant a communication. Explicitly does NOT own: workflow state transitions that emit triggering events (credentialing, staffing, etc. own those), user role definitions and org hierarchy (iam), email deliverability infrastructure/SMTP/spam filtering (SendGrid), evaluation of which credential applications are approved (credentialing), determination of which staffing records have data-quality issues (dataquality), long-term archival storage infrastructure (Azure Storage/Data Lake)." ;
	<urn:solutiondesign:ontology:purpose> "Provides centralized notification and alerting infrastructure across MiEdWorkforce, enabling functional areas to deliver personalized, event-driven communications to internal staff, educators, and external stakeholders through email, dashboard alerts, and on-screen warnings. Manages the complete email lifecycle from template creation through delivery, retention, and resend." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:ApplicationApprovedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:ApplicationDeniedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:ApplicationRequiresManualReviewEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionUpdatedEvent> ;
