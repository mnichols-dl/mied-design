<urn:solutiondesign:instance:epp:EPPProviderModifiedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "eppCode, modifiedFields" ;
	<urn:solutiondesign:ontology:trigger> "EPP details updated" .

<urn:solutiondesign:instance:epp:EPPState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:epp:EPPState_Closed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Closed" .

<urn:solutiondesign:instance:epp:EPPType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Public, Independent, Educator Association, or State." ;
	<urn:solutiondesign:ontology:name> "EPPType" .

<urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents an EEM organization designated as an educator preparation provider. Links to read-only EEM organization data (via organizations/org-reference-data) and manages EPP-specific program approvals and metadata." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:EPPProgramApprovalChangedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:EPPProviderCreatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:epp:EPPProviderModifiedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:epp:ApprovedCertificateCategory> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:epp:ApprovedEndorsement> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:epp:EPPContact> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EPPState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:epp:EPPState_Closed> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:EPPType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:OrganizationReference> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:ReadingDiagnosticsFlag> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:epp:SpecialEdDirectorFlag> ;
	<urn:solutiondesign:ontology:invariants> "EPP must reference a valid EEM organization that exists in org-reference-data (Business Rule: 'EPP Must Reference Valid EEM Organization' — core organization attributes such as name/address cannot be modified in MiEdWorkforce; they sync from EEM). An EPP must have at least one approved certificate category to be active. Endorsements can only be approved for certificate types the EPP is authorized to offer (must add certificate category before an endorsement under it). MDE Approval Date must precede Enrollment Close Date and Recommend Close Date, for both certificate categories and endorsements. An EPP in Closed status cannot have active candidate enrollments. Core organization data (name, address, federal code) is read-only, sourced from EEM. Pro Prep visibility (Business Rule: 'Pro Prep Visibility Based on Close Dates'): a certificate category/endorsement is visible on the public Pro Prep catalog only if today is before both its Enrollment Close Date and Recommend Close Date, and the EPP's own status is Active; an EPP Admin can also manually override visibility (hide early / extend) independent of the date rule." ;
	<urn:solutiondesign:ontology:notes> "Reading Diagnostics / Special Ed Director flags (Open Question #8, resolved per FDD 13.1.2): these gate whether the EPP appears in certification-search dropdown filters for those two specific certifications — not candidate tracking or other program offerings." ;
	<urn:solutiondesign:ontology:rootEntity> "EducatorPreparationProvider" .

<urn:solutiondesign:instance:epp:EnrState_Enrolled> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Enrolled" .

<urn:solutiondesign:instance:epp:EnrState_Exited> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Exited" .

<urn:solutiondesign:instance:epp:EnrState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:epp:EnrState_PendingVerification> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Pending Verification" .

<urn:solutiondesign:instance:epp:EnrState_PlacedAlt> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Placed (Alt)" .

<urn:solutiondesign:instance:epp:EnrState_PostStudentTeachingTrad> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Post Student Teaching (Trad)" .

<urn:solutiondesign:instance:epp:EnrState_Rejected> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Rejected" .

<urn:solutiondesign:instance:epp:EnrState_StudentTeachingTrad> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Student Teaching (Trad)" .

<urn:solutiondesign:instance:epp:EnrollmentProgram> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Specific program/endorsement (Program Level + Grade Band, and Program Type where applicable) the candidate is pursuing; a candidate can have multiple." ;
	<urn:solutiondesign:ontology:name> "EnrollmentProgram" .

<urn:solutiondesign:instance:epp:EnrollmentStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Current lifecycle state with effective dates." ;
	<urn:solutiondesign:ontology:name> "EnrollmentStatus" .

<urn:solutiondesign:instance:epp:EnrollmentStatusOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:epp:EppContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Called by Credentialing to validate that a candidate holds an active EPP enrollment before processing a credential application. Not exposed via APIM; mTLS/Managed Identity. Supersedes the sd:path 'candidates/{id}/enrollment-status' guess used by credentialing-domain.ttl's pre-existing stub of this same IRI — real path parameter name is {candidateId}." ;
	<urn:solutiondesign:ontology:operationId> "getCandidateEnrollmentStatus" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:epp:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/candidates/{candidateId}/enrollment-status" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:projection> "Projects only hasActiveEnrollment (boolean) plus a minimal per-EPP summary (eppCode, eppName, status, programLevel, programType, enrollmentDate) across all of the candidate's enrollments, for Credentialing's own eligibility check — not the full aggregate." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get candidate enrollment verification status (internal service)" ;
	<urn:solutiondesign:ontology:tags> "Candidate Enrollments" .

<urn:solutiondesign:instance:epp:EppContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:epp:DomainDoc> ;
	<urn:solutiondesign:ontology:displayName> "Educator Preparation Provider (EPP)" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:epp:ApprovalApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:epp:CandidateEnrollmentAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:epp:CredentialApplicationReviewAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:epp:EducatorPreparationProviderAggregate> ;
	<urn:solutiondesign:ontology:identifier> "epp" ;
	<urn:solutiondesign:ontology:kind> "CoreDomain" ;
	<urn:solutiondesign:ontology:notes> "Explicitly does NOT own: educator credential issuance/lifecycle (credentialing), MTTC test score data (consumed from credentialing, which is the interface owner), actual credential application structure/requirements/payment (credentialing), user authentication (iam), email template management (communications), document storage (documents), payment processing (payments), professional practice clearances (profpractice), core organization data/hierarchy (org-reference-data / organizations, sourced from EEM)." ;
	<urn:solutiondesign:ontology:purpose> "Manages the relationship between Educator Preparation Providers (universities, colleges, and alternative route programs) and the candidates they prepare for educator certification: EPP provider registration and program approval, candidate enrollment verification and tracking, and EPP recommendation/approval of candidates for state credentialing. Bridges educator preparation (at institutions) and state credentialing (owned by credentialing), ensuring only qualified candidates from approved programs receive EPP recommendations that enable credential issuance." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:organizations:OrganizationDeactivatedEvent> .

<urn:solutiondesign:instance:epp:ExitInformation> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Exit date and reason, populated when status is Exited (e.g. Program Completion, Withdrew, Transferred to Another EPP, Other)." ;
	<urn:solutiondesign:ontology:name> "ExitInformation" .

<urn:solutiondesign:instance:epp:Fdd13Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 13.1-13.6, 13.8 (document's own subtitle). Author Vidhya Punniyamoorthy (DTMB); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI) 08/04/2025 per the signoff table — but comments.xml contains entries dated as late as 2026-04-03, well after that signoff date, meaning the document continued to be actively revised/reviewed after its nominal approval date. Same pattern FDD 29's own Fdd29Doc note already flagged for a different FDD; not resolved here." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/13 - Educator Preparation Providers - Admin Users/13  - EPP - Admin.docx" .

<urn:solutiondesign:instance:epp:Fdd13_7Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "One-page pointer doc, Feature 13.7 only. No comments, no embedded images. States its own content is superseded by 'Identity Management Integration (15.0)' — a distinct FDD not itself reviewed in this pass; see this file's closing note on epp:Req_13_7." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/13 - Educator Preparation Providers - Admin Users/13.7 - EPP- Identity Management Integration.docx" .

<urn:solutiondesign:instance:epp:Fdd25CandidateTrackingDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 25.2 (Candidate Tracking worklist) and 25.4 (bulk file upload). Authors Vidhya Punniyamoorthy, Beth Dontje, and Caitlin Groom (DTMB); same approvers/signoff date as Fdd25WorklistDoc. comments.xml carries dated entries through 2026-04-03." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/25 - Educator Preparation Providers - User/25.2, 25.4 - EPP - Candidate Tracking.docx" .

<urn:solutiondesign:instance:epp:Fdd25WorklistDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 25.1 (worklist search) and 25.3 (Hold/Deny/Cancel/Recommend actions). Authors Vidhya Punniyamoorthy and Beth Dontje (DTMB); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/05/2025 per the signoff table — but comments.xml carries dated entries through 2026-03-10, after that nominal approval date, the same 'still revised after signoff' pattern FDD 29's own review noted for its document." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/25 - Educator Preparation Providers - User/25.1, 25.3 - Worklist and Recommendation.docx" .

<urn:solutiondesign:instance:epp:Fdd31_4Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers FDD Feature 31.4 (Public Search - Pro Prep / Educator Preparation Provider search). Belongs to epp:, not credentialing, despite living in the same numbered FDD folder as 31.1-31.3." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/31 - Public Search/31.4 - Public Search - Pro Prep.docx" .

<urn:solutiondesign:instance:epp:InternalRemark> a <urn:solutiondesign:ontology:ValueObject> ;
