	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/24-request-for-id-collection/wireframes/wireframe-03-add-employee-success.png" .

<urn:solutiondesign:instance:staffing:Wireframe24_4> a <urn:solutiondesign:ontology:SourceDocument> ;
