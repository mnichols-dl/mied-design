	<urn:solutiondesign:ontology:description> "Manages educator's application of college course credits toward SCECH requirements, sourced from STARR data." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:proflearning:CollegeCourseAppliedEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:proflearning:CourseState_Applied> ;
