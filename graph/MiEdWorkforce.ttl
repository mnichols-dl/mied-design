	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:staffing:Cat_Audit> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "Request master schedules, attendance records, etc. ('ISD/RESA Entity' scope)." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.audit.request-documentation" .

<urn:solutiondesign:instance:staffing:Perm_AuditReviewSubmission> a <urn:solutiondesign:ontology:Permission> ;
