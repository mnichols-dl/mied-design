	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/disclosures/{disclosureId}/add-remark" ;
	<urn:solutiondesign:ontology:projection> "Which of the two value objects the request targets is selected by the remarkType (Internal/External) request parameter, not encoded as separate operations; response (remarkId, addedAt) is a minimal receipt, not modeled as a producesShape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Add remark to disclosure" ;
	<urn:solutiondesign:ontology:tags> "Disclosures" .

<urn:solutiondesign:instance:profpractices:Op_AddExternalCheckRemark> a <urn:solutiondesign:ontology:ApiOperation> ;
