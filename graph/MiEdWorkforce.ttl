	<urn:solutiondesign:ontology:operationId> "listWorklists" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/worklists" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<urn:solutiondesign:ontology:projection> "Returns WorklistSummary items (name, status, queued/assigned counts); excludes RoutingRules/PriorityRules/VisibilitySettings detail (see getWorklistDisclosures / the update operation for full configuration)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "List PPR worklists" ;
	<urn:solutiondesign:ontology:tags> "Worklists" .

<urn:solutiondesign:instance:profpractices:Op_LogNonSystemAction> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:DisclosureNonSystemActions> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "logNonSystemAction" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/disclosures/{disclosureId}/log-action" ;
	<urn:solutiondesign:ontology:projection> "Response (actionId, loggedAt) is a minimal receipt, not modeled as a producesShape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Log non-system action on disclosure" ;
	<urn:solutiondesign:ontology:tags> "Disclosures" .

<urn:solutiondesign:instance:profpractices:Op_ProcessNasdtecBatch> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Escape hatch used deliberately: the response is job-tracking metadata (a polling handle), not a domain-model entity. Called by Azure Synapse Pipeline nightly. Not exposed via APIM; authenticated via Managed Identity / mTLS, no user token present. x-permissions-required lists profpractice.nasdtec.view (a human-reviewer permission) even though the caller is a scheduled job with no user token — an as-documented oddity, not corrected here." ;
	<urn:solutiondesign:ontology:operationId> "processNasdtecBatch" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/jobs/process-nasdtec-batch" ;
	<urn:solutiondesign:ontology:responseSchema> "{ jobId: uuid, initiatedAt: date-time, statusUrl: uri }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Trigger NASDTEC nightly batch processing" ;
	<urn:solutiondesign:ontology:tags> "Admin Jobs" .

<urn:solutiondesign:instance:profpractices:Op_ReceiveRapBackNotification> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "external-public" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Source declares x-access: external-client, which has no equivalent in sd:accessType's enum (internal-user|internal-service|external-public). Mapped to external-public as the closest fit — x-permissions-required is empty ([]), meaning genuinely no permission gate, consistent with external-public's exemption from ApiOperationRequiresPermissionShape. sd:requiresAuth is deliberately NOT asserted false here even though there is no user-level permission gate: in reality this endpoint is restricted to MSP specifically via APIM allowlisting/shared secret, not open to the general public — that nuance isn't expressible in the current accessType enum, but it means this is not the 'genuinely unauthenticated public endpoint' case the ontology reserves requiresAuth false for." ;
	<urn:solutiondesign:ontology:operationId> "receiveRapBackNotification" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/webhooks/rapback" ;
	<urn:solutiondesign:ontology:projection> "Request (tcn, notificationDate, judicialMarker, pic) is the raw external payload that seeds CheckSource/NotificationDate/ResponseData on a new ExternalBackgroundCheck — a subset of the aggregate's eventual shape, captured before Disclosure linkage exists. No response body (plain 200 OK)." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Receive Rap Back notification" ;
	<urn:solutiondesign:ontology:tags> "Webhooks" .

<urn:solutiondesign:instance:profpractices:Op_RetrieveRapSheet> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Both request and response are deliberately opaque escape-hatch schemas: the request is a bare foreign-key reference, and the response is the one payload in this entire API that must NOT be modeled as mirroring any stored domain-model entity — its whole point is that it is never persisted. Initiates an on-demand SOAP call to CHRISS GET_RAPBACK. Only retrieval metadata (who, when) is logged in ExternalBackgroundCheck's RapSheetRetrievalLog." ;
	<urn:solutiondesign:ontology:operationId> "retrieveRapSheet" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/rapback/retrieve-rapsheet" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ checkId: uuid }" ;
	<urn:solutiondesign:ontology:responseSchema> "{ rapSheetText: string (transient, NEVER persisted — see Rule_RapSheetDisplayOnly), retrievedAt: date-time }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Retrieve full rap sheet from CHRISS" ;
	<urn:solutiondesign:ontology:tags> "External Checks" .

<urn:solutiondesign:instance:profpractices:Op_SetEnhancedMonitoring> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:EnhancedMonitoringStatus> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "setEnhancedMonitoring" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/educators/{educatorId}/markers/enhanced-monitoring" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:EnhancedMonitoringStatus> ;
	<urn:solutiondesign:ontology:projection> "Same projection reasoning as Op_SetMandatoryHold — justification-only request, marker-state response." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Set Enhanced Monitoring Status" ;
	<urn:solutiondesign:ontology:tags> "Account Markers" .

<urn:solutiondesign:instance:profpractices:Op_SetMandatoryHold> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:MandatoryHoldRequirement> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "setMandatoryHold" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/educators/{educatorId}/markers/mandatory-hold" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:MandatoryHoldRequirement> ;
	<urn:solutiondesign:ontology:projection> "Request carries only justification text (MarkerSetRequest) — marker type and educatorId are implied by the path/operation, not the value object's own fields. Response (MarkerChangeResult) mirrors the marker's new state plus audit metadata." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Set Mandatory Hold Requirement" ;
	<urn:solutiondesign:ontology:tags> "Account Markers" .

<urn:solutiondesign:instance:profpractices:Op_SetReReview> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:ReReviewRequirement> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "setReReview" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/educators/{educatorId}/markers/rereview" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:ReReviewRequirement> ;
	<urn:solutiondesign:ontology:projection> "Response adds reroutedDisclosureCount (a side-effect count of disclosures forced back to worklist) beyond the base MarkerChangeResult shape." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Set Re-Review Requirement" ;
	<urn:solutiondesign:ontology:tags> "Account Markers" .

<urn:solutiondesign:instance:profpractices:Op_SubmitDisclosure> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitDisclosure" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/disclosures" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request (DisclosureCreate) mirrors DisclosureType/ConvictionDate/Description/Attachments; response is a minimal subset (disclosureId, status, submittedAt), not the full aggregate." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit self-disclosure" ;
	<urn:solutiondesign:ontology:tags> "Disclosures" .

<urn:solutiondesign:instance:profpractices:Op_SubmitPprResponse> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:ProfessionalPracticeResponseAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:operationId> "submitPprResponse" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/ppr-responses" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:ProfessionalPracticeResponseAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request's 'answers' array maps to PPRResponseQuestions/PPRResponseAnswers; its 'newDisclosures' array embeds DisclosureCreate-shaped objects for any Yes answers — a cross-aggregate composite whose primary consumesShape is still the response aggregate. Response (responseId, responseDate, newDisclosuresReported, createdDisclosureIds) is a subset plus references to the Disclosure aggregates created as a side effect." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Submit Professional Practice Review response" ;
	<urn:solutiondesign:ontology:tags> "PPR Responses" .

<urn:solutiondesign:instance:profpractices:Op_UpdateDisclosure> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:notes> "Only allowed while disclosure status is UnderPprReview; once transitioned to any Reviewed status the disclosure is locked." ;
	<urn:solutiondesign:ontology:operationId> "updateDisclosure" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/disclosures/{disclosureId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request carries only disclosureType/convictionDate/description/documentIds — a targeted subset of the aggregate's fields, not the full shape; response is a DisclosureSummary." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update disclosure details" ;
	<urn:solutiondesign:ontology:tags> "Disclosures" .

<urn:solutiondesign:instance:profpractices:Op_UpdateDisclosureStatus> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Transitions to any 'Reviewed' status also require reviewNotes and invoke profpractice.disclosure.finalize authorization per the source description, but x-permissions-required only lists profpractice.status.update — the finalize permission requirement is described in prose, not enumerated as a second required permission. Modeled as conditional on the finalize permission to preserve that distinction honestly rather than dropping it." ;
	<urn:solutiondesign:ontology:operationId> "updateDisclosureStatus" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/disclosures/{disclosureId}/update-status" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:projection> "Request is limited to newStatus + reviewNotes — a targeted status-transition command, not the full aggregate shape; response echoes disclosureId/previousStatus/newStatus/updatedAt only." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update disclosure status" ;
	<urn:solutiondesign:ontology:tags> "Disclosures" .

<urn:solutiondesign:instance:profpractices:Op_UpdateWorklist> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "PUT" ;
	<urn:solutiondesign:ontology:operationId> "updateWorklist" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/worklists/{worklistId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<urn:solutiondesign:ontology:projection> "Response (WorklistSummary) is a narrower projection than the WorklistCreate-shaped request." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update PPR worklist" ;
	<urn:solutiondesign:ontology:tags> "Worklists" .

<urn:solutiondesign:instance:profpractices:PPRAccountMarkerChangedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "educatorId, markerType (MandatoryHoldRequirement|EnhancedMonitoringStatus|ReReviewRequirement), markerActive, reason, changedBy, changedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "Account marker set or cleared on educator" .

<urn:solutiondesign:instance:profpractices:PPRClearanceAssessment> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Not persisted as an aggregate — calculated fresh on each request, never cached. Represents PPR's assessment of an educator's disclosure status and account markers for Credentialing to combine with other factors. ClearanceStatus is one of Clear, ConditionalClearance, Hold, Blocked. Also carries BlockingReason, DistrictNotifications, RequiresFelonyAcknowledgment, and ReviewTriggers." ;
	<urn:solutiondesign:ontology:name> "PPRClearanceAssessment" .

<urn:solutiondesign:instance:profpractices:PPRClearanceAssessmentChangedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "educatorId, previousAssessment, newAssessment, triggeredBy (DisclosureStatusChange|MarkerChange|ComplianceRecalculation), changedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "Disclosure status change, marker change, or any condition affecting clearance assessment" .

<urn:solutiondesign:instance:profpractices:PPRClearanceOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Called by Credentialing to evaluate PPR clearance before processing a credential application. Computed on-demand, never cached. Not exposed via APIM; authenticated via Managed Identity / mTLS — no user token, X-Organization-Context does not apply. sd:path uses '{id}' (matching credentialing's pre-existing stub for this exact IRI) rather than profpractice-api.yml's own '{educatorId}' parameter name — sd:path has sh:maxCount 1, so the two source documents' differing param-name conventions for the same path can't both be asserted; the credentialing stub's spelling was kept since this IRI is shared and credentialing's file isn't ours to edit. CROSS-DOMAIN VERIFICATION: this operation's name/path/operationId, and the PPRClearanceAssessment value object it returns (ClearanceStatus one of Clear/ConditionalClearance/Hold/Blocked, plus RequiresFelonyAcknowledgment), are all CONFIRMED to match exactly what credentialing's own v2 conversion assumes — no renaming was needed. See profp:Rule_PPRClearanceAssessment for one real discrepancy found in this operation's own priority-order prose (flagged, not silently fixed)." ;
	<urn:solutiondesign:ontology:operationId> "getPprClearanceAssessment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/educators/{id}/ppr-clearance" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:profpractices:PPRClearanceAssessment> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Get PPR clearance assessment (internal service)" ;
	<urn:solutiondesign:ontology:tags> "Educator Status" .

<urn:solutiondesign:instance:profpractices:PPRQuestionConfigurationAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Defines the questions, branching logic, and validation rules for PPR response forms and self-disclosure forms. Allows administrators to update form structure without code changes." ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:QuestionConfigState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:QuestionConfigState_Draft> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:QuestionConfigState_Inactive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionBranchingLogic> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionCollection> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionDisplayOrder> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionEffectiveDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionFormType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionIsActive> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionIsRequired> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionResponseType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionText> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:QuestionValidationRules> ;
	<urn:solutiondesign:ontology:invariants> "At least one question must be configured for each form type. Required questions cannot be made optional for in-progress responses. Branching logic must reference valid question IDs. Changes to configurations create new versions rather than modifying existing ones. Question order must be sequential and unique." ;
	<urn:solutiondesign:ontology:notes> "While PPR domain *uses* these configurations, the aggregate definition here represents the interface/contract PPR needs rather than necessarily owning storage and lifecycle — a cross-domain forms configuration capability may end up owning this instead (source doc's own Dependency Note, Open Question #7 — see profp:Question_QuestionConfigOwnership)." ;
	<urn:solutiondesign:ontology:rootEntity> "PPRQuestionConfiguration" .

<urn:solutiondesign:instance:profpractices:PPRReminderRequiredEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "educatorId, reminderType, dueDate, currentComplianceStatus" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "System determines educator needs PPR reminder based on compliance calculation" .

<urn:solutiondesign:instance:profpractices:PPRRespState_NoReviewNeeded> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "No Review Needed" .

<urn:solutiondesign:instance:profpractices:PPRRespState_PendingReview> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Pending Review" .

<urn:solutiondesign:instance:profpractices:PPRRespState_ReviewComplete> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Review Complete" .

<urn:solutiondesign:instance:profpractices:PPRRespState_UnderReview> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Under Review" .

<urn:solutiondesign:instance:profpractices:PPRResponseAnswers> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Educator's yes/no responses to each question." ;
	<urn:solutiondesign:ontology:name> "Answers" .

<urn:solutiondesign:instance:profpractices:PPRResponseAssociatedEducator> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Reference to the individual." ;
	<urn:solutiondesign:ontology:name> "AssociatedEducator" .

<urn:solutiondesign:instance:profpractices:PPRResponseCreatedDisclosureIds> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "References to Disclosure aggregates created from \"Yes\" answers." ;
	<urn:solutiondesign:ontology:name> "CreatedDisclosureIds" .

<urn:solutiondesign:instance:profpractices:PPRResponseDate> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When the PPR form was submitted." ;
	<urn:solutiondesign:ontology:name> "ResponseDate" .

<urn:solutiondesign:instance:profpractices:PPRResponseNewDisclosuresReported> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Boolean indicating whether new incidents were reported." ;
	<urn:solutiondesign:ontology:name> "NewDisclosuresReported" .

<urn:solutiondesign:instance:profpractices:PPRResponseQuestions> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Collection of configured PPR questions answered." ;
	<urn:solutiondesign:ontology:name> "Questions" .

<urn:solutiondesign:instance:profpractices:PPRResponseSubmittedAt> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Timestamp of submission." ;
	<urn:solutiondesign:ontology:name> "SubmittedAt" .

<urn:solutiondesign:instance:profpractices:PPRResponseSubmittedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "responseId, educatorId, responseDate, newDisclosuresReported, createdDisclosureIds, responseStatus" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "Educator completes periodic PPR review" .

<urn:solutiondesign:instance:profpractices:PPRResponseType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "PPR (periodic review) vs. Self-Disclosure." ;
	<urn:solutiondesign:ontology:name> "ResponseType" .

<urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Organizes disclosures requiring review into queues for PPR staff, with filtering, prioritization, and assignment capabilities." ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:WorklistState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:WorklistState_Paused> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:WorklistAssignedReviewers> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:WorklistFilterConfiguration> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:WorklistName> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:WorklistPriorityRules> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:WorklistQueuedDisclosureIds> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:WorklistRoutingRules> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:WorklistVisibilitySettings> ;
	<urn:solutiondesign:ontology:invariants> "A disclosure can only be in one worklist at a time. Routing rules cannot conflict across worklists. At least one reviewer must be assigned to an active worklist. Disclosures are not locked when assigned to reviewers (multiple reviewers can view/edit)." ;
	<urn:solutiondesign:ontology:notes> "Open Question #26 in profpractice-domain.md flags that this aggregate may exceed the platform's general 'worklist-as-filtered-list' pattern (see solution-level/solution-architecture.md's Worklist / Pending-Items Pattern) in two ways: (1) AssignedReviewers restricts each named worklist to a specific set of PPR staff, and profpractice-permissions.md's worklist-related permissions are scoped 'Worklist-specific' rather than just System-wide; (2) PPR Admins can freely create ad hoc named worklists with their own RoutingRules/PriorityRules/VisibilitySettings via POST /worklists. The underlying FDD (09 - Professional Practice, Feature 9.2.1/9.2.2) does describe this as an explicit admin feature, but it is flagged as needing client confirmation rather than assumed either way — modeled here as documented, real routing, per the source's own aggregate definition. See profp:Question_PPRWorklistRoutingScope for the promoted Annotation." ;
	<urn:solutiondesign:ontology:rootEntity> "PPRWorklist" .

<urn:solutiondesign:instance:profpractices:Perm_ActionsLog> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Document external activities (phone calls, emails, manual reviews)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Audit> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; creates audit trail for offline actions. Source lists 'Worklist-specific' as an applicable scope — see file header note. profpractice-sequences.md's 'Log Non-System Action' sequence header instead names 'profpractice.disclosure.log-non-system-action', which does not exist in this catalog — a genuine documented naming discrepancy." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.actions.log" .

<urn:solutiondesign:instance:profpractices:Perm_AttachmentsDelete> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Remove document from view but retain in audit (soft delete)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Documents> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; requires justification. Same Documents-capability-ownership reasoning as profpractice.attachments.view/.upload — no PermissionRequirement modeled here." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.attachments.delete" .

<urn:solutiondesign:instance:profpractices:Perm_AttachmentsUpload> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Upload supporting documents to disclosure" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Documents> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "Educators upload to their own disclosures during submission. Not modeled with a PermissionRequirement here for the same reason as profpractice.attachments.view — the upload call (POST /upload) belongs to the Documents capability's own API, not profpractice's." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.attachments.upload" .

<urn:solutiondesign:instance:profpractices:Perm_AttachmentsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View supporting documents attached to disclosures" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Documents> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Educators see own; reviewers see assigned disclosures. Source lists 'Worklist-specific' as an applicable scope — see file header note. Not modeled with a PermissionRequirement here: document retrieval for a disclosure is a Documents-capability call (GET /documents?disclosureId=...) shown in profpractice-sequences.md, not one of profpractice's own ApiOperations." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.attachments.view" .

<urn:solutiondesign:instance:profpractices:Perm_AuditView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View disclosure and marker audit logs" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Audit> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Scope-aware audit visibility. No API operation or sequence currently models this permission — profpractice-api.yml has no dedicated audit-log endpoint; a documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.audit.view" .

<urn:solutiondesign:instance:profpractices:Perm_ClearanceView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View PPR clearance assessment for credential applications" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Assessments> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Credentialing staff check clearance before approval" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.clearance.view" .

<urn:solutiondesign:instance:profpractices:Perm_DisclosureDelete> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Remove disclosure from view but retain in audit (soft delete)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DisclosureDeletion> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Admin role only; educator cannot delete own disclosures. No API operation or sequence currently models this permission — profpractice-api.yml has no disclosure-delete endpoint; a documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.disclosure.delete" .

<urn:solutiondesign:instance:profpractices:Perm_DisclosureEdit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Edit disclosure details during active review" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DisclosureReview> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Can modify date, type, description, attachments while status is 'Under PPR Review'. Source lists 'Worklist-specific' as an applicable scope — see file header note." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.disclosure.edit" .

<urn:solutiondesign:instance:profpractices:Perm_DisclosureFinalize> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Mark disclosure as reviewed and lock for editing" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DisclosureProcessing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Transitions to 'Reviewed-*' status; prevents further edits. Source lists 'Worklist-specific' as an applicable scope — see file header note." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.disclosure.finalize" .

<urn:solutiondesign:instance:profpractices:Perm_DisclosureRevert> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Revert finalized disclosure back to 'Under PPR Review'" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DisclosureProcessing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Admin role only; allows corrections after finalization. No API operation or sequence currently models this permission — profpractice-api.yml has no revert endpoint and no sequence exercises it; a documented gap, not modeled with a PermissionRequirement." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.disclosure.revert" .

<urn:solutiondesign:instance:profpractices:Perm_DisclosureSearch> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Search and filter disclosures across worklists" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DisclosureReview> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; includes advanced filters. Source lists 'Worklist-specific' as an applicable scope — see file header note." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.disclosure.search" .

<urn:solutiondesign:instance:profpractices:Perm_DisclosureSubmit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit self-disclosure of criminal conviction or disciplinary action" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_SelfDisclosure> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "All authenticated educators" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.disclosure.submit" .

<urn:solutiondesign:instance:profpractices:Perm_DisclosureView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View disclosure history and status" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_SelfDisclosure> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Educators see own; reviewers see assigned/all. Source lists 'Worklist-specific' as a third applicable scope — see file header note on the Worklist-specific scope-vocabulary gap; scope:AssignedOnly is the closest existing proxy." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.disclosure.view" .

<urn:solutiondesign:instance:profpractices:Perm_EligibilityView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View roster eligibility assessment for employment" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Assessments> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "District HR checks eligibility before roster addition" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.eligibility.view" .

<urn:solutiondesign:instance:profpractices:Perm_MarkersManage> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Set or clear any account marker type" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_AccountMarkers> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Admin or Credentialing Admin role; requires justification; fully audited. profpractice-sequences.md's 'Manage Account Markers' sequence instead names finer-grained permission ids per marker (account-marker.set-mandatory-hold, account-marker.clear-mandatory-hold, account-marker.set-enhanced-monitoring, account-marker.set-rereview), none of which exist in this catalog — a genuine documented naming discrepancy, left unresolved rather than silently reconciled or split into new permissions." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.markers.manage" .

<urn:solutiondesign:instance:profpractices:Perm_MarkersView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View account-level markers (Mandatory Hold, Enhanced Monitoring, Re-Review)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_AccountMarkers> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer can view; visibility by scope" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.markers.view" .

<urn:solutiondesign:instance:profpractices:Perm_NasdtecAccess> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Access external NASDTEC clearinghouse site for full details" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_ExternalIntegration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; opens clearinghouse URL in new tab. No API operation models this permission — it gates an outbound browser navigation, not a MiEdWorkforce endpoint; a documented, expected non-gap." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.nasdtec.access" .

<urn:solutiondesign:instance:profpractices:Perm_NasdtecView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View NASDTEC disciplinary records matched to educators" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_ExternalIntegration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; includes clearinghouse URL" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.nasdtec.view" .

<urn:solutiondesign:instance:profpractices:Perm_NotificationsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View PPR-related notifications for district users" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DistrictNotifications> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "District HR sees alerts for educators they're hiring/employing. No API operation or sequence currently models this permission — profpractice-api.yml has no district-notifications endpoint; a documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.notifications.view" .

<urn:solutiondesign:instance:profpractices:Perm_QuestionsManage> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Create, edit, or activate PPR question configurations" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_QuestionConfiguration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "System Admin only; creates versioned changes. No API operation currently models this permission — profpractice-api.yml only exposes GET endpoints for question configuration (getDisclosureQuestions, getPprQuestions), no create/update/activate endpoint; a documented gap." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.questions.manage" .

<urn:solutiondesign:instance:profpractices:Perm_QuestionsView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View PPR question configurations and branching logic" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_QuestionConfiguration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Read-only access to form definitions" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.questions.view" .

<urn:solutiondesign:instance:profpractices:Perm_RapbackView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View Rap Back notification metadata" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_ExternalIntegration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; sees notification date, TCN, judicial marker" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.rapback.view" .

<urn:solutiondesign:instance:profpractices:Perm_RapsheetRetrieve> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Initiate on-demand rap sheet retrieval via CHRISS SOAP call" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_ExternalIntegration> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; display-only, never stored. profpractice-sequences.md's 'Retrieve Full Rap Sheet for Review' sequence header instead names 'profpractice.rapback.retrieve-rapsheet', which does not exist in this catalog — a genuine documented naming discrepancy." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.rapsheet.retrieve" .

<urn:solutiondesign:instance:profpractices:Perm_RemarksAdd> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Add comments to disclosures (internal or external)" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DisclosureProcessing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; remark type determined by API parameter. Source lists 'Worklist-specific' as an applicable scope — see file header note." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.remarks.add" .

<urn:solutiondesign:instance:profpractices:Perm_ReportView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View and export all PPR reports, metrics, and analytics" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_Reporting> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:District> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:Entity> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Scope-aware; includes export. profpractice-sequences.md's 'Generate PPR Compliance Report' sequence header instead names 'profpractice.reports.disclosure-metrics.view' or 'profpractice.reports.compliance.view', neither of which exists in this catalog — a genuine documented naming discrepancy." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.report.view" .

<urn:solutiondesign:instance:profpractices:Perm_ResponseSubmit> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Submit annual Professional Practice Review response" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_PPRResponse> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:notes> "All authenticated educators; required annually" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.response.submit" .

<urn:solutiondesign:instance:profpractices:Perm_ResponseView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View PPR response history" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_PPRResponse> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SelfOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "Educators see own; admins see all" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.response.view" .

<urn:solutiondesign:instance:profpractices:Perm_StatusUpdate> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Change disclosure status through workflow" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_DisclosureProcessing> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer role; enforce valid status transitions. Source lists 'Worklist-specific' as an applicable scope — see file header note. profpractice-sequences.md's 'Review Disclosure and Update Status' sequence header instead names the permission id 'profpractice.disclosure.update-status', which does not exist in this catalog — a genuine documented naming discrepancy between the two source documents, left unresolved rather than silently reconciled." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.status.update" .

<urn:solutiondesign:instance:profpractices:Perm_WorklistAssign> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Add or remove reviewers from worklists" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_WorklistManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Admin role only. No dedicated API operation models this permission separately — profpractice-api.yml's PUT /worklists/{worklistId} (assignedReviewerIds field of WorklistCreate schema) is the closest match but is gated by profpractice.worklist.configure, not this permission; a documented gap between the permissions catalog's granularity and the API's actual gating." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.worklist.assign" .

<urn:solutiondesign:instance:profpractices:Perm_WorklistConfigure> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "Create, edit, or pause PPR worklists and routing rules" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_WorklistManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:SystemWide> ;
	<urn:solutiondesign:ontology:notes> "PPR Admin role only" ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.worklist.configure" .

<urn:solutiondesign:instance:profpractices:Perm_WorklistView> a <urn:solutiondesign:ontology:Permission> ;
	<urn:solutiondesign:ontology:description> "View assigned PPR worklists and queued disclosures" ;
	<urn:solutiondesign:ontology:hasCategory> <urn:solutiondesign:instance:profpractices:Cat_WorklistManagement> ;
	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:AssignedOnly> ;
	<urn:solutiondesign:ontology:notes> "PPR Reviewer assigned to specific worklists. Source lists this scope as 'Worklist-specific' — see file header note; scope:AssignedOnly is the closest existing proxy." ;
	<urn:solutiondesign:ontology:permissionId> "profpractice.worklist.view" .

<urn:solutiondesign:instance:profpractices:PermissionsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
