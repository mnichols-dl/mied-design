	<urn:solutiondesign:ontology:payloadHighlights> "entityCode, uniqueId, employmentStartDate, employmentStatus" ;
	<urn:solutiondesign:ontology:trigger> "Employee record with Unique ID created" .

<urn:solutiondesign:instance:staffing:EmployeeAssignedToPositionEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "entityCode, uniqueId, positionId, assignmentStartDate, fte" ;
