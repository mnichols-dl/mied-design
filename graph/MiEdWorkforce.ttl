	<urn:solutiondesign:ontology:path> "/external-checks/{checkId}/add-remark" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ remarkText: string (max 5000 chars) }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Add remark to external check" ;
	<urn:solutiondesign:ontology:tags> "External Checks" .

