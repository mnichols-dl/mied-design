	<urn:solutiondesign:ontology:summary> "Denied authorization requests report (admin)" ;
	<urn:solutiondesign:ontology:tags> "Reports" .

<urn:solutiondesign:instance:iam:Op_GetEffectivePermissions> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:iam:IamContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Called by domain services and the UI shell to initialize permission context on page/module load; not exposed via APIM." ;
