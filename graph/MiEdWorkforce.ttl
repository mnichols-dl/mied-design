<urn:solutiondesign:instance:iam:AuthorizationWithdrawnEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "requestId, userId, withdrawnAt" ;
