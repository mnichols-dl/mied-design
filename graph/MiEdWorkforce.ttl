	<urn:solutiondesign:ontology:toContext> <urn:solutiondesign:instance:external:MiLoginSystem> .

<urn:solutiondesign:instance:_generated:dependency-f5e74edf81426073> a <urn:solutiondesign:ontology:Dependency> ;
	<urn:solutiondesign:ontology:fromContext> <urn:solutiondesign:instance:communications:CommunicationsContext> ;
	<urn:solutiondesign:ontology:mechanism> "rest-api" ;
	<urn:solutiondesign:ontology:notes> "viaOperation deliberately omitted: sd:ApiOperation's sd:exposedBy is constrained (ApiOperationShape) to sd:BoundedContext only, and SendGrid is modeled as sd:ExternalSystem (a distinct class) — there's no clean way to represent SendGrid's own outbound-send endpoint as an sd:ApiOperation under the current shape. A genuine ontology-shape limitation surfaced by real data (SendGrid has a real, documented API — POST https://api.sendgrid.com/v3/mail/send, per communications-technical-design.md — this isn't a case of the endpoint not existing), not a conversion gap." ;
	<urn:solutiondesign:ontology:toContext> <urn:solutiondesign:instance:external:SendGridSystem> .

<urn:solutiondesign:instance:_generated:dependency-f5ec30a410f706f8> a <urn:solutiondesign:ontology:Dependency> ;
