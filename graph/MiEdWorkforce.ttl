<urn:solutiondesign:instance:staffing:EducationHistory> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Collection of post-secondary degrees and institutions for highest-education calculation. Sourced either from CEPI Data Warehouse/STARR-NSC interfaces (read-only to district and citizen) or manually entered by district or citizen when no historical record exists (degree required, all other fields optional). District-added rows can be removed by the district only before save; citizen-added rows can never be removed by a district user." ;
	<urn:solutiondesign:ontology:name> "EducationHistory" .

<urn:solutiondesign:instance:staffing:EducationJobType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Administrator, Instructional, Student Support Staff, or Non-Instructional." ;
	<urn:solutiondesign:ontology:name> "EducationJobType" .

