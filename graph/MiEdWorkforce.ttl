	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:SCECHConversion> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:proflearning:STARRCourseRecord> ;
	<urn:solutiondesign:ontology:invariants> "Course must be from STARR data for the educator's Unique ID. Course must be completed after last credential issuance date. Once applied for SCECH credit, course cannot be reused. Conversion rate: 1 semester credit = 15 SCECH hours (configurable in business rules)." ;
	<urn:solutiondesign:ontology:rootEntity> "CollegeCourseApplication" .

