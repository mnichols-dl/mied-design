<urn:solutiondesign:instance:staffing:AssignmentAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Links employees to positions with detailed course, grade level, and FTE allocation information, validating credential appropriateness." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:AssignmentEndedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:CredentialErrorJustificationSubmittedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:EmployeeAssignedToPositionEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:CourseDetail> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AssignState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AssignState_Error> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AssignState_Justified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AssignState_Pending> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:CredentialErrorJustification> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:SpecializedFunding> ;
	<urn:solutiondesign:ontology:invariants> "Active employment requires at least one assignment. Administrator/Instructional positions require valid credential for assignment. Teacher assignments require valid endorsements for SCED course and grade level. Assignment start date must align with employment start date. FTE allocation must be positive decimal value. Special Education assignments require specific age group and service category data. Career Technical Education assignments require Career Cluster and CIP Code. Education History is required before certification for employees in a defined subset of positions (Teacher, Administrator, Special Education Paraprofessional, Teacher on a Temporary Credential); optional for all other positions." ;
	<urn:solutiondesign:ontology:rootEntity> "Assignment" .

<urn:solutiondesign:instance:staffing:AssignmentDetail> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Position assignment with start/end dates, FTE, primary indicator." ;
	<urn:solutiondesign:ontology:name> "AssignmentDetail" .

<urn:solutiondesign:instance:staffing:AssignmentEndedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Only appears in the ERD's ASSIGNMENT_EVENTS.event_type enum, not in staffing-domain.md's Domain Events table or in any sequence's explicit event-emit step." ;
	<urn:solutiondesign:ontology:payloadHighlights> "assignmentId, endDate, endReason?" ;
	<urn:solutiondesign:ontology:trigger> "Assignment end date set (via endAssignment or a position status transition that ends an assignment)" .

<urn:solutiondesign:instance:staffing:AuditFinding> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "District/individual-level placement issue with justification and uploaded documentation (document IDs reference the Documents domain — see abox/mied-v3/documents/, already real and converted)." ;
	<urn:solutiondesign:ontology:name> "AuditFinding" .

<urn:solutiondesign:instance:staffing:AuditReportFinalizedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "isdCode, districtCode, auditType, schoolYear, auditTimestamp, auditorUserId" ;
	<urn:solutiondesign:ontology:trigger> "ISD Auditor finalizes district audit" .

<urn:solutiondesign:instance:staffing:AuditState_AwaitingDistrictResponse> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Awaiting District Response" .

<urn:solutiondesign:instance:staffing:AuditState_Completed> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Completed" .

<urn:solutiondesign:instance:staffing:AuditState_Decertified> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "De-certified" .

<urn:solutiondesign:instance:staffing:AuditState_InProgress> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "In Progress" .

<urn:solutiondesign:instance:staffing:AuditState_New> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "New" .

<urn:solutiondesign:instance:staffing:AuditState_PendingSOMReview> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Pending SOM Review" .

<urn:solutiondesign:instance:staffing:AuditStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "New, In Progress, Awaiting District Response, or Completed (technical ERD adds Pending SOM Review and Decertified as additional states)." ;
	<urn:solutiondesign:ontology:name> "AuditStatus" .

<urn:solutiondesign:instance:staffing:AuditType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "School Safety (RapBacks) or Appropriate Placement Verification." ;
	<urn:solutiondesign:ontology:name> "AuditType" .

<urn:solutiondesign:instance:staffing:AuditWorkItemAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks ISD and SOM auditor review of district employment and placement data, managing findings, document requests, and certification." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:AuditReportFinalizedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:DocumentRequestCreatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:AuditFinding> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:DocumentRequest> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AuditState_AwaitingDistrictResponse> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AuditState_Completed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AuditState_Decertified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AuditState_InProgress> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AuditState_New> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:AuditState_PendingSOMReview> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:AuditStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:AuditType> ;
	<urn:solutiondesign:ontology:invariants> "Audit work item created only after district collection certification. All required audit tasks must be complete before audit report finalization. Audit report requires attestation and e-signature. Finalized audit becomes read-only except during defined de-certification window. Credential error justifications from district submissions must appear in the auditor's audit item list." ;
	<urn:solutiondesign:ontology:rootEntity> "AuditWorkItem" .

<urn:solutiondesign:instance:staffing:BatchJob_CollectionToWarehousePipeline> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:description> "Extracts finalized (certified) collection data and loads it into the CEPI CEDS Data Warehouse for state/federal reporting, per FDD 10 Feature 10.15 ('Data Closeout and Processing')." ;
	<urn:solutiondesign:ontology:errorScenarios> "Not documented — FDD 10 itself flags this as incomplete ('Full implementation details for the data processing closeout and connections to Data Warehouse to be determined'); full extract vs. incremental and retry/failure handling are named as open technical questions rather than resolved here." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:references> <urn:solutiondesign:instance:staffing:Seq_CertifyCollection> ;
	<urn:solutiondesign:ontology:schedule> "Triggered by the CollectionCertified event, or run on an admin-configured future date per FDD 10.15's 'schedule some or all data closeout processing for a future date' option — the exact scheduling mechanics are unresolved (Open Technical Question #4 below)." ;
	<urn:solutiondesign:ontology:steps> "1. Collection aggregate transitions to Certified (see 'Certify Collection' sequence). 2. CollectionCertified event published. 3. Synapse Pipeline consumes the event (or a scheduled trigger) and extracts finalized EmployeeRoster/PositionRoster/Assignment records for the certified collection. 4. Data lands in the CEPI CEDS Data Warehouse for standardized state/federal reporting." ;
	<urn:solutiondesign:ontology:title> "Collection-to-Warehouse Batch Processing" .

