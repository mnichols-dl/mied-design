	<urn:solutiondesign:ontology:section> "abox-tests/mied/profpractice/profpractice-permissions.md" .

<urn:solutiondesign:instance:profpractices:ProfessionalPracticeResponseAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents a periodic compliance submission where educators affirm their disclosure status by answering standardized questions. Creates Disclosure records when new incidents are reported." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:PPRResponseSubmittedEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:PPRRespState_NoReviewNeeded> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:PPRRespState_PendingReview> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:PPRRespState_ReviewComplete> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:PPRRespState_UnderReview> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseAnswers> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseAssociatedEducator> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseCreatedDisclosureIds> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseNewDisclosuresReported> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseQuestions> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseSubmittedAt> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRResponseType> ;
	<urn:solutiondesign:ontology:invariants> "All mandatory questions must be answered before submission. If any answer is \"Yes\", at least one new Disclosure must be created. Response cannot be deleted after submission, only soft-deleted by admin. Responses are linked to disclosure reminder schedules. PPR responses trigger the same workflows as self-disclosures (disclosures are routed to OEE worklist)." ;
	<urn:solutiondesign:ontology:rootEntity> "ProfessionalPracticeResponse" .

<urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> a <urn:solutiondesign:ontology:BoundedContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:displayName> "Professional Practices" ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:profpractices:PPRQuestionConfigurationAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<urn:solutiondesign:ontology:hasAggregate> <urn:solutiondesign:instance:profpractices:ProfessionalPracticeResponseAggregate> ;
	<urn:solutiondesign:ontology:identifier> "profpractices" ;
	<urn:solutiondesign:ontology:kind> "CoreDomain" ;
	<urn:solutiondesign:ontology:notes> "Explicitly does NOT own: credential application processing (credentialing), employment roster management (staffing), email/SMS notifications and templates (communications; PPR publishes events, Communications resolves/delivers), document upload/download/storage/malware scanning (documents; PPR references document IDs only), identity management and authentication (iam), payment processing (payments), Rap Back enrollment/de-enrollment (supplementary, outside this domain)." ;
	<urn:solutiondesign:ontology:purpose> "Manages the disclosure, review, and processing of criminal history and professional disciplinary events for Michigan educators. Enables self-disclosure, integrates with external background check systems (Rap Back/CHRISS, NASDTEC), and provides administrative workflows for reviewing disclosures and determining eligibility for credential issuance and employment." ;
	<urn:solutiondesign:ontology:status> "documented" ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:credentialing:CredentialApplicationSubmittedEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:staffing:EmployeeAddedToRosterEvent> ;
	<urn:solutiondesign:ontology:subscribesTo> <urn:solutiondesign:instance:staffing:EmploymentStatusChangedEvent> .

<urn:solutiondesign:instance:profpractices:QuestionBranchingLogic> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Conditional follow-up questions (e.g., if \"Yes\" to felony question, show conviction date field)." ;
	<urn:solutiondesign:ontology:name> "BranchingLogic" .

<urn:solutiondesign:instance:profpractices:QuestionCollection> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Collection of configured questions." ;
	<urn:solutiondesign:ontology:name> "Questions" .

<urn:solutiondesign:instance:profpractices:QuestionConfigState_Active> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Active" .

<urn:solutiondesign:instance:profpractices:QuestionConfigState_Draft> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> false ;
	<urn:solutiondesign:ontology:name> "Draft" .

<urn:solutiondesign:instance:profpractices:QuestionConfigState_Inactive> a <urn:solutiondesign:ontology:StateDefinition> ;
	<urn:solutiondesign:ontology:isTerminal> true ;
	<urn:solutiondesign:ontology:name> "Inactive" .

<urn:solutiondesign:instance:profpractices:QuestionDisplayOrder> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Sequence in which questions appear." ;
	<urn:solutiondesign:ontology:name> "DisplayOrder" .

<urn:solutiondesign:instance:profpractices:QuestionEffectiveDate> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When this configuration version becomes active." ;
	<urn:solutiondesign:ontology:name> "EffectiveDate" .

<urn:solutiondesign:instance:profpractices:QuestionFormType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Which form this applies to: PPR Response, Self-Disclosure." ;
	<urn:solutiondesign:ontology:name> "FormType" .

<urn:solutiondesign:instance:profpractices:QuestionIsActive> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Whether this configuration version is currently in use." ;
	<urn:solutiondesign:ontology:name> "IsActive" .

<urn:solutiondesign:instance:profpractices:QuestionIsRequired> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Whether the question must be answered." ;
	<urn:solutiondesign:ontology:name> "IsRequired" .

<urn:solutiondesign:instance:profpractices:QuestionResponseType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Expected answer format: YesNo, Date, FreeText, FileUpload, Dropdown." ;
	<urn:solutiondesign:ontology:name> "ResponseType" .

<urn:solutiondesign:instance:profpractices:QuestionText> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "The actual question displayed to users." ;
	<urn:solutiondesign:ontology:name> "QuestionText" .

<urn:solutiondesign:instance:profpractices:QuestionValidationRules> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Field-level validation (date formats, character limits, file types)." ;
	<urn:solutiondesign:ontology:name> "ValidationRules" .

<urn:solutiondesign:instance:profpractices:Question_ArraignmentStatusLifecycle> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What is the business logic for \"Reviewed - Arraignment\" status — does it automatically expire or transition when the underlying criminal case is resolved (conviction, dismissal, acquittal), or does it require a PPR reviewer to manually re-evaluate and transition it?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedArraignment> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #14." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_AttachmentReplacement> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can disclosure attachments be replaced after submission, or only added or soft-deleted? profpractice-api.yml's PUT /disclosures/{disclosureId} documentIds field says it 'replaces current document list', which suggests replacement is already supported at the API level — but the domain-level business rule for this isn't stated." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:DisclosureAttachments> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #11. Possible tension with profpractice-api.yml's updateDisclosure operation description, noted here rather than silently resolved." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_BulkStatusUpdate> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can PPR staff bulk-update disclosure statuses across multiple disclosures at once, or must each be processed individually? profpractice-api.yml only exposes a single-disclosure update-status endpoint." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Op_UpdateDisclosureStatus> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #15." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_ClearancePriorityOrderMismatch> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "profpractice-api.yml's own operation description for GET /educators/{id}/ppr-clearance states a 6-step priority order that omits profpractice-domain.md's own step 5 (\"other reviewed disclosures exist -> ConditionalClearance or Clear\"). profpractice-domain.md's Business Rules section and profpractice-sequences.md's 'Evaluate PPR Clearance' sequence both include the 7-step version with that branch. Which is authoritative for implementation — should the api.yml's prose be corrected to match domain.md/sequences.md, or does the shorter 6-step version reflect an intentional simplification not yet reflected in the other two documents?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Rule_PPRClearanceAssessment> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:ApiDoc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:notes> "Found during this mied-v3 conversion pass while cross-checking credentialing's dependency on this exact rule — not one of profpractice-domain.md's own numbered Open Questions, but flagged with the same rigor since credentialing's v2 conversion depends on this rule's exact behavior." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_ComplianceModelVsFlagReset> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "9.1.8 describes a literal batch/scheduled job that resets a stored 'Needs Responses' flag to Yes for every applicant each June 30. profp:Rule_AnnualPPRComplianceRequirement — the rule this pass is otherwise treating as satisfying 9.1.8 — explicitly does the opposite by design: 'Compliance is determined by whether the educator has submitted a PPR response since June 30 of the current year... The computed approach eliminates the need for batch marker reset jobs.' There is no stored, resettable 'Needs Responses' boolean anywhere in profp:EducatorPPRStatusAggregate; compliance is derived on-demand from profp:LastPPRResponseDate/profp:NextPPRDueDate. The end-user-visible outcome is the same either way (an applicant who hasn't responded since last June 30 is treated as needing a response), so this is not a functional coverage gap — but it is a genuine architectural discrepancy between what this specific FDD story asks for (a real flag, real reset job, real audit log entry for 'the reset process was completed successfully') and what the domain model deliberately implements instead (no flag, no job, nothing to log a completion event for). Worth a client/architecture conversation before assuming either document is simply wrong." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Req_09_1_8> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:findingType> "discrepancy" ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_DisclosureDisputeAppeal> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can an educator dispute or appeal a disclosure status determination, and if so, what is the workflow? No dispute/appeal aggregate, state, or API operation is documented anywhere in this domain's source material." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #23. This is a coverage gap, not just an open design question — no workflow of any kind is modeled for it." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_DisclosureReopening> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can a finalized disclosure be reopened for re-review, or must a new disclosure be created? (Distinct from the documented PPR Admin revert-to-Under-Review path — this asks whether that's the only mechanism or whether a parallel 'create new disclosure referencing the old one' pattern is also expected.)" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #6." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_DistrictDisclosureVisibility> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can districts access disclosure details directly, or do they only ever see the clearance/eligibility assessment status and associated district-notification alert messages? profpractice-permissions.md's profpractice.disclosure.view permission does not list District/ISD as an applicable scope, suggesting the latter, but this isn't stated as an explicit rule." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Perm_DisclosureView> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #22." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_FelonyAcknowledgmentWorkflow> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What is the workflow for completing the felony disclosure acknowledgment form (required by Rule_ReviewedFelonyConditionalProcessing before a district can proceed with hiring/credentialing) — is it handled within MiEdWorkforce as a form/API operation, via email exchange, or through a separate system entirely? No such endpoint is documented in profpractice-api.yml or credentialing's own API." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Rule_ReviewedFelonyConditionalProcessing> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #20." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_ListedOffenseCriteria> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What are the exact statutory offenses that trigger \"Reviewed - Listed\" status? Is there a maintained list of statute codes?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedListed> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #5. High impact: Rule_ReviewedListedAbsoluteBlock is an absolute statutory block with no override, so the exact enumerated-offense criteria determining when a disclosure reaches this status is load-bearing for correct implementation." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_ManualOverrideOfAssessment> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can PPR staff manually override a calculated clearance or eligibility assessment, or are assessments always derived strictly from disclosure statuses and markers with no manual override path?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:PPRClearanceAssessment> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #8." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_ManualReviewNotAutoBlock> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Review comment 1217190634 (Caswell, 2025-12-04) asks the FDD to 'clarify that if a record is returned, the initial plan is to flag it for manual review rather than automatically blocking the application' — confirmed in-thread by comment 784063271 (Groom, 2026-02-09): 'The RapBack record will not be rejected from MiEd and will be able to be reviewed manually.' This CONFIRMS (rather than contradicts) profp:Rule_RapBackTriggeredDisclosure's own existing modeled behavior (creates a placeholder disclosure, routes to worklist for review, does not auto-block) — worth recording as a positive cross-check, not a new gap, since it independently corroborates an existing rule the same way FDD 29's pass corroborated two of its own BusinessRule citations." ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:findingType> "unconfirmed-assumption" ;
	<urn:solutiondesign:ontology:impact> "L" ;
	<urn:solutiondesign:ontology:status> "resolved" .

<urn:solutiondesign:instance:profpractices:Question_MarkerExpiration> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Are account markers (Mandatory Hold Requirement, Enhanced Monitoring Status, Re-Review Requirement) permanent until manually cleared, or can they have automatic expiration?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #4." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_MarkerFlagUiPlacement> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Is the PPR Admin Flag / PPR Additional Review Flag UI meant to live inline on every individual disclosure record (as Wireframe3 shows, and as profp:EducatorPPRStatusAggregate's account-level MandatoryHoldRequirement/EnhancedMonitoringStatus value objects imply — one set of markers per educator, surfaced wherever a disclosure for that educator is viewed), or does it need a dedicated account/profile-level screen distinct from any one disclosure? The FDD's own review thread (comments 167/168) treats this as unresolved as of this pass ('need to review 9.3.5 with AO to decide where flag will exist in the designs'), even though the wireframe and domain model already model one specific answer." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_MidApplicationClearanceChange> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "What happens if an educator's PPR clearance changes while a credential application is mid-approval — is there a compensation or re-evaluation workflow, or does Credentialing simply re-poll on the next status transition?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:PPRClearanceAssessmentChangedEvent> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "M" ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #3. profpractice-domain.md's own Business Rules section says Credentialing 'subscribes to PPRClearanceAssessmentChanged... retrieve all in-progress applications... re-evaluate' which partially answers this, but the exact compensation mechanics (e.g. does an already-approved-pending-issuance application get pulled back?) remain unspecified." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_NASDTECDataLifecycle> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Should historical NASDTEC data be pulled at system launch (backfilling records predating go-live), or should the system start fresh from the go-live date only? Relatedly, what is the retention period for NASDTEC records stored locally — indefinite, seven years (matching disclosure retention), or some other period?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "Combines profpractice-domain.md Open Questions #18 (historical backfill) and #19 (NASDTEC retention period) — both concern the same underlying NASDTEC-record data-lifecycle decision that's currently unspecified." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_OverduePPRUX> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "When an educator has an overdue PPR, is the experience a blocking modal on login or a passive banner notification? profpractice-domain.md's own Rule_AnnualPPRComplianceRequirement example describes 'a banner alert on login', but this isn't asserted as a firm requirement." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Rule_AnnualPPRComplianceRequirement> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #24." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_PPRResponseConcurrency> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Can an educator have multiple PPR responses simultaneously in \"Under Review\" status, or must a previous response be finalized before a new one is submitted?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:ProfessionalPracticeResponseAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #2." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_PPRWorklistRoutingScope> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Does PPRWorklist require real routing/queue-management with admin-defined groupings and per-worklist reviewer assignment (as currently modeled), or can it be simplified to the platform's general worklist-as-filtered-list pattern (a filtered/sorted view over Disclosure's own status/type fields, gated by existing profpractice.* permissions, with no separate AssignedReviewers/admin worklist-creation)? Relatedly: are there separate PPR worklists for different disclosure types (felony, misdemeanor, disciplinary), or a single unified queue?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:notes> "Combines profpractice-domain.md Open Questions #26 (the platform-pattern-exception question, quoted at length on PPRWorklistAggregate's own sd:notes) and #13 (worklist segmentation by disclosure type) — both concern the same underlying question of how much real, admin-configurable structure PPRWorklist actually needs. The underlying FDD (09 - Professional Practice, Feature 9.2.1/9.2.2) describes worklist configuration and status/flag visibility as an explicit admin feature, suggesting real routing may be intentional, but this needs client confirmation per the source's own note." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_QuestionConfigOwnership> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Is PPR question configuration (branching logic, form structure for self-disclosure and PPR response forms) owned by the PPR domain itself, or by a cross-domain forms/configuration capability that serves multiple domains?" ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:PPRQuestionConfigurationAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #7, restating the aggregate's own 'Dependency Note' — PPRQuestionConfigurationAggregate is modeled here as PPR-owned per the source's aggregate definition, pending this resolution." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_RapbackAdminRoleNotModeled> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Every single story in this FDD (all 21 numbered stories plus the 3 synthetic Business-Specification items) is written for a 'Rapback Admin' role/permission set. No such role or permission exists anywhere in profpractice-permissions.ttl, which models only PPR Reviewer, PPR Admin, and Credentialing Admin — nor is it named in iam's role catalog. This is the single largest cross-cutting gap in this FDD: even the stories that DO have a real satisfiedBy target (e.g. 30.2.1/30.2.2, which reuse Op_GetExternalCheck/Op_RetrieveRapSheet) are gated in the actual graph by profp:Perm_RapbackView/profp:Perm_RapsheetRetrieve — PPR-Reviewer-scoped permissions per their own sd:notes ('PPR Reviewer role') — not by any Rapback-Admin-specific permission. Whether 'Rapback Admin' is meant to be a wholly new role, or PPR Reviewer/PPR Admin under a different display name for this specific workflow, is not resolved anywhere in the FDD's own text or its review-comment trail." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Req_30_1_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Req_30_3_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Req_30_5_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Req_30_6_1> ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:Req_30_8_1> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#reviewing> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:findingType> "coverage-gap" ;
	<urn:solutiondesign:ontology:impact> "H" ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:Question_ReviewSLA> a <urn:solutiondesign:ontology:Annotation> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Are there SLA requirements for PPR review turnaround time, and do reviews escalate automatically if not completed within a defined period? No SLA field or escalation mechanism is modeled on PPRWorklistAggregate or DisclosureAggregate." ;
	<http://www.w3.org/ns/oa#hasTarget> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<http://www.w3.org/ns/oa#motivatedBy> <http://www.w3.org/ns/oa#questioning> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.md Open Question #25." ;
	<urn:solutiondesign:ontology:status> "open" .

<urn:solutiondesign:instance:profpractices:RapBackNotificationReceivedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "checkId, educatorId, notificationDate, tcn, judicialMarker, requiresEducatorResponse" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "Rap Back system sends new criminal activity notification" .

<urn:solutiondesign:instance:profpractices:RapSheetRetrievalLog> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Audit trail of on-demand rap sheet retrievals (user, timestamp) — rap sheet content is NEVER stored." ;
	<urn:solutiondesign:ontology:name> "RapSheetRetrievalLog" .

<urn:solutiondesign:instance:profpractices:ReReviewRequirement> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Boolean marker; when active, forces previously reviewed disclosures back into worklist for additional scrutiny." ;
	<urn:solutiondesign:ontology:name> "ReReviewRequirement" .

<urn:solutiondesign:instance:profpractices:Req_08_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Includes a valid API key in the HTTPS request header for all calls; does not transmit and logs the failure if the key is invalid/expired; securely stores/retrieves the key via approved credential management; logs each authentication attempt with timestamp and result." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice's own Dependency to ext:NASDTECSystem and Seq_ProcessNasdtecNightlyBatch cover the authenticated-call shape; neither profpractice-domain.ttl nor this FDD's own errorScenarios detail credential-storage mechanics specifically (a generic security-infrastructure concern, not modeled at this level anywhere in the project) — not raised as a separate gap." ;
	<urn:solutiondesign:ontology:requirementId> "8.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:NASDTECSystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ProcessNasdtecNightlyBatch> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to authenticate to the NASDTEC Ed ID Clearinghouse using an API key so that only authorized requests are processed." ;
	<urn:solutiondesign:ontology:title> "Authenticate to NASDTEC via API key" .

<urn:solutiondesign:instance:profpractices:Req_08_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Issues a GET request to the NASDTEC endpoint with required parameters (format, StartDate, apiKey) when credentials are available; transmits over HTTPS; logs endpoint URL, timestamp, and query type; failed/timed-out requests generate error log entries." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: the sequence's own content shows exactly this GET /v1/clearinghouse/people?currmonth=YYYYMM call with retry-with-backoff on failure." ;
	<urn:solutiondesign:ontology:requirementId> "8.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_ProcessNasdtecBatch> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ProcessNasdtecNightlyBatch> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to send queries to the NASDTEC Clearinghouse API so that educator records can be retrieved for review within the credential process." ;
	<urn:solutiondesign:ontology:title> "Send queries to the NASDTEC Clearinghouse API" .

<urn:solutiondesign:instance:profpractices:Req_08_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Captures a valid response as a JSON array of educator records; validates all expected data elements are present/correctly formatted; logs malformed/incomplete responses as validation errors; retains the original response for audit/troubleshooting." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: ExternalBackgroundCheckAggregate's own invariants state external-check data is retained for audit purposes even after review." ;
	<urn:solutiondesign:ontology:requirementId> "8.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ProcessNasdtecNightlyBatch> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to receive and store responses from the NASDTEC Clearinghouse API so that retrieved data can be validated and processed." ;
	<urn:solutiondesign:ontology:title> "Receive and store NASDTEC responses" .

<urn:solutiondesign:instance:profpractices:Req_08_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Records timestamp, request parameters, endpoint, and response code per transaction; logs error messages/status codes for failed transactions; identifies scheduled vs. manual execution per log entry; retains logs per MiEdWorkforce's integration retention policy." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> ;
	<urn:solutiondesign:ontology:notes> "Per a review comment on this exact story ('Removing reference to NASDTEC, as this should be for all API calls'), the reviewer themselves generalized this from a NASDTEC-specific ask to a cross-cutting logging expectation — i.e. this story's real scope is broader than one integration. profpractice's own batch job satisfies the NASDTEC-specific slice of it; the cross-cutting 'all API calls' framing is a platform-wide NFR with no single owning domain, consistent with how this kind of ask is usually handled elsewhere in this project (sd:nonFunctionalRequirement at the Solution root) — not modeled as a per-domain gap here." ;
	<urn:solutiondesign:ontology:requirementId> "8.2.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ProcessNasdtecNightlyBatch> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to log all API transactions so that data exchange activity can be tracked and reviewed for audit purposes." ;
	<urn:solutiondesign:ontology:title> "Log all NASDTEC API transactions" .

<urn:solutiondesign:instance:profpractices:Req_08_2_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Encrypts/masks PII during storage and transmission; log entries omit full PII values; all requests/responses occur over HTTPS; detected security violations are reported per incident-management procedures." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> ;
	<urn:solutiondesign:ontology:notes> "HTTPS-only transport is confirmed by ext:NASDTECSystem's own integrationNotes. Field-level encryption/masking of the stored CertificationID (SSN) and log-redaction specifically are not called out anywhere in profpractice-domain.ttl beyond its general 'PII' data-classification awareness — a minor, generic gap (the same class of gap most PII-handling stories in this project carry, e.g. NASDTEC's own SSN field), not raised as its own Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "8.2.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:NASDTECSystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to ensure that personally identifiable information from NASDTEC is handled securely so that privacy requirements are maintained." ;
	<urn:solutiondesign:ontology:title> "Handle NASDTEC PII securely" .

<urn:solutiondesign:instance:profpractices:Req_08_2_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Performs a connectivity check before a scheduled query; skips and logs an error if the check fails; retries failed transmissions per configured retry settings." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> ;
	<urn:solutiondesign:ontology:notes> "Direct match: errorScenarios explicitly states 'NASDTEC API unavailable > Retry with exponential backoff, alert admin if persistent failure.'" ;
	<urn:solutiondesign:ontology:requirementId> "8.2.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ProcessNasdtecNightlyBatch> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to verify NASDTEC endpoint availability before transmission so that failed requests can be avoided." ;
	<urn:solutiondesign:ontology:title> "Verify NASDTEC endpoint availability before transmission" .

<urn:solutiondesign:instance:profpractices:Req_08_2_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Verifies the correct endpoint for its environment per query; test queries run only against NASDTEC's testing endpoint; each transaction log includes environment name; cross-environment queries are blocked and logged as configuration errors." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> ;
	<urn:solutiondesign:ontology:notes> "profpractice-domain.ttl/sequences.ttl do not describe per-environment endpoint configuration or cross-environment-query blocking for NASDTEC specifically — a minor, generic environment-configuration gap shared with several other interfaces in this same FDD folder (see the consolidated Annotation on 8.4-8.7 below for the pattern; not repeated as its own Annotation here since profpractice otherwise has real, substantial NASDTEC coverage)." ;
	<urn:solutiondesign:ontology:requirementId> "8.2.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:NASDTECSystem> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I want to restrict NASDTEC API usage to defined environments so that data integrity is maintained." ;
	<urn:solutiondesign:ontology:title> "Restrict NASDTEC API usage to defined environments" .

<urn:solutiondesign:instance:profpractices:Req_09_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Two-step form (Step 1 of 2 / Step 2 of 2) reached via MiLogin + hamburger-menu navigation; Type (Felony/Misdemeanor), Conviction Date (must not be future-dated), Description (max 5000 chars), file Upload (.jpg/.docx/.pdf, system-wide size standard), and a per-document Select Type dropdown (Judgment of Sentence/Register of Action/Certificate of Conviction/Copy of Court Docket/Order of Probation — confirmed as the complete, final list per comment 11, no 'Other' option); user may delete an uploaded file before submission; review screen groups Personal Information and Disclosures before Submit; confirmation message shown; every submission event is audit-logged (Modified By, Date Modified), audit log read-only and retained per data-retention policy." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong match, including field-for-field validation rules (future-date rejection, 5000-char cap) matching profp:DisclosureAggregate's own sd:invariants verbatim. Wireframe1 and Wireframe2 (both confirmed by viewing) directly corroborate the question form and the upload/delete panel. The 5-item Select-Type dropdown for uploaded-document type is NOT modeled as its own controlled-vocabulary ValueObject in profpractice-domain.ttl (profp:DisclosureAttachments is a single opaque ValueObject) — a minor granularity gap, not raised as its own Annotation. Comments 4/5 and 17/18 (intro-page verbiage and confirmation-page verbiage both still 'To be Confirmed'/'To be provided' as of the visible text) are copy/content placeholders, not functional gaps." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:documents:Op_RequestDocumentUpload> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureAttachments> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureConvictionDate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureDescription> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureType> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetDisclosureQuestions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_SubmitDisclosure> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_SevenYearAuditRetention> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_SubmitSelfDisclosure> ;
	<urn:solutiondesign:ontology:statement> "As a citizen user, I want to fill out a self-disclosure form, so that I can report new misdemeanors or felonies." ;
	<urn:solutiondesign:ontology:title> "Self-disclosure form submission" .

<urn:solutiondesign:instance:profpractices:Req_09_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Every submission event automatically logged (Modified By, Date Modified); audit log stored securely, cannot be altered/deleted by end users; accessible to authorized administrative users for review/reporting; retained per data-retention policy." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — this story is essentially restating profp:Rule_SevenYearAuditRetention's own statement (seven-year minimum retention for disclosure records, review actions, status changes, and audit-log entries) and profp:DisclosureAggregate's DisclosureReviewHistory entity. adt:AuditContext is modeled as subscribing to DisclosureSubmittedEvent specifically to support this cross-cutting audit concern." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureReviewHistory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureSubmittedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_SevenYearAuditRetention> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce system, I want to log all submissions, so that a full audit trail is maintained for tracking and compliance purposes." ;
	<urn:solutiondesign:ontology:title> "Full audit trail for submissions" .

<urn:solutiondesign:instance:profpractices:Req_09_1_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Two-step form; five Yes/No questions (new misdemeanor/felony; credential suspended/revoked/surrendered/nullified/pending action), default blank; answering Yes to any question for the first time surfaces an '+ Add Misdemeanor' modal (Type/Conviction Date/Description/Upload, all mandatory); previously-Yes users see a table of prior responses with an option to add a new one; review screen groups Personal Information and all Q&A plus Disclosures if any Yes answers; Submit produces a confirmation and the same audit-logging behavior as 9.1.1/9.1.2." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match. Wireframe1 (confirmed by viewing) shows this exact question set and inline conviction table. profp:ProfessionalPracticeResponseAggregate's own invariant ('If any answer is Yes, at least one new Disclosure must be created') matches the '+ Add Misdemeanor modal creates a Disclosure' behavior described here precisely." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetPprQuestions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_SubmitPprResponse> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:PPRResponseAnswers> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:PPRResponseQuestions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticeResponseAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_SubmitPPRResponse> ;
	<urn:solutiondesign:ontology:statement> "As a citizen user, I want the ability to submit a Professional Practice Review, so I can stay compliant with the state's policy." ;
	<urn:solutiondesign:ontology:title> "Submit annual Professional Practice Review" .

<urn:solutiondesign:instance:profpractices:Req_09_1_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "'My PPR Responses and Disclosure History' page with Responses and Disclosures tabs; each tab has a free-text search bar; Disclosures tab table columns: Type/Conviction Date/Description/Attachment (Yes/No); Responses tab table columns: Submission Date/Type (PPR or Self Disclosure)/New disclosure (Yes/No)/Review status; empty-state text when no history exists; clicking a history hyperlink shows Status/Questions-Answers/Uploaded documents detail." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Wireframe4 (confirmed by viewing) matches this screen closely, including both the Responses/Disclosures tabs and the search bar. profp:Seq_ViewDisclosureHistory's own SequenceReference for its list call is flagged resolutionStatus 'ambiguous' in profpractice-sequences.ttl (the sequence narrative shows GET /educators/{id}/disclosures, but profpractice-api.yml's real endpoint is GET /disclosures with no educatorId path segment, self-scoped implicitly) — carried forward as an existing, already-documented discrepancy rather than re-raised here. Comment 106/107 confirms the page title itself ('My PPR Responses and Disclosure History') was a late naming correction; comments 116-123 (several 'do we need this?' review questions on hyperlink behavior, download, filter, and the Attachment column's exact semantics) were all answered 'Yes' in-thread by Groom, so treated as resolved rather than open." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetDisclosure> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_ListDisclosures> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ViewDisclosureHistory> ;
	<urn:solutiondesign:ontology:statement> "As a citizen user, I want to view my disclosure history, so that I can track all submissions over time." ;
	<urn:solutiondesign:ontology:title> "View disclosure history" .

<urn:solutiondesign:instance:profpractices:Req_09_1_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Download option available on both Disclosures and Responses tabs; Excel/PDF/Word format options; downloaded file contains questions+responses and disclosure status." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Modeled only as far as profpractice-sequences.md's own 'Export Disclosure Data' sequence goes — and that sequence's own SequenceReferences (profpractice-sequences.ttl) already flag its export call (POST /export/disclosures) as resolutionStatus 'no-such-endpoint': no such endpoint exists anywhere in profpractice-api.yml, and no ExportService bounded context exists in the project's registry at all. This pass does not silently upgrade that to 'resolved' — the capability is narratively documented (format options, content) but has no real backing API operation anywhere in this project. A genuine, if narrow, implementation gap inherited from the domain conversion, not newly discovered here." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ExportDisclosureData> ;
	<urn:solutiondesign:ontology:statement> "As a citizen user, I want to download my submitted disclosure data, so that I have a personal copy for records." ;
	<urn:solutiondesign:ontology:title> "Download submitted disclosure data" .

<urn:solutiondesign:instance:profpractices:Req_09_1_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Filter option on both Disclosures tab (Conviction Date/Type/Description/Attachment Yes-No) and Responses tab (Submission Date/Type/New Disclosure/Status); only matching records displayed; filters clearable; filters persist until cleared or navigation away; 'no results' messaging when nothing matches." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Wireframe4 (confirmed by viewing) shows a filter icon on the disclosure-history screen, consistent with this story. profp:Op_ListDisclosures is a generic list endpoint (profpractice-api.ttl documents its response shape but not a specific filter-parameter contract) — the operation exists and is the natural backing call, but the exact filterable-field set this story enumerates is not independently documented at the API level. A minor, narrow gap (parameter-level detail, not the capability itself), not raised as its own Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_ListDisclosures> ;
	<urn:solutiondesign:ontology:statement> "As a citizen user, I want to filter my submitted disclosure data, so that I can easily view and locate specific submissions based on criteria." ;
	<urn:solutiondesign:ontology:title> "Filter submitted disclosure data" .

<urn:solutiondesign:instance:profpractices:Req_09_1_7> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Status auto-updates to Pending Review immediately on successful submission; visible in My Disclosure History; timestamp recorded; status cannot change before submission; failed submission does not change status (error shown instead); routes to the appropriate PPR Reviewer worklist once Pending Review; status remains until a PPR Reviewer updates it." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:markedDeleted> true ;
	<urn:solutiondesign:ontology:notes> "Direct match — profp:DiscState_PendingReview is a real, non-terminal state, and profp:Seq_SubmitSelfDisclosure's own content shows 'Note over PPRService: State: Pending Review' immediately on creation, plus the DisclosureRoutedToWorklist event this story's own routing requirement describes." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.7" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DiscState_PendingReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureRoutedToWorklistEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_SubmitSelfDisclosure> ;
	<urn:solutiondesign:ontology:statement> "As a citizen user, I want the status of my PPR to be set to \"Pending Review\" when I submit my disclosure so that I can be assured that my information has been received and is ready for review." ;
	<urn:solutiondesign:ontology:title> "Status set to Pending Review on submission" .

<urn:solutiondesign:instance:profpractices:Req_09_1_8> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Automatic annual reset on a defined date (e.g. June 30) with no manual intervention; applies to all applicants with active/eligible PPR records; records already Needs Responses = Yes remain unchanged; post-reset, applying/updating requires new PPR responses; reset date/time recorded for audit; a log/report entry confirms completion; reset date configurable by an authorized admin." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Functionally satisfied but via a DIFFERENT mechanism than this story literally describes — see profp:Question_ComplianceModelVsFlagReset below for the discrepancy this pass is flagging (not silently reconciled)." ;
	<urn:solutiondesign:ontology:requirementId> "9.1.8" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:LastPPRResponseDate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:NextPPRDueDate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_AnnualPPRComplianceRequirement> ;
	<urn:solutiondesign:ontology:statement> "As a system, I must automatically reset the Needs Responses flag to 'Yes' each year (on June 30th) so that applicants must reconfirm their conviction information when applying for credentials after that date." ;
	<urn:solutiondesign:ontology:title> "Automatic annual Needs Responses flag reset" .

<urn:solutiondesign:instance:profpractices:Req_09_2_0> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Never given a number anywhere in the document, unlike every other story in this FDD (assigned a synthetic '9.2.0' id here, same convention FDD 29's pass used for its own un-numbered-but-real items). Out of scope for profpractices: email/SMS template authoring and delivery-schedule management is explicitly owned by the Communications capability per profpractice-domain.ttl's own bounded-context notes ('Explicitly does NOT own:... email/SMS notifications and templates (communications); PPR publishes events, Communications resolves/delivers'), and the FDD's own Dependencies section names 'the system will support the alert, email, and communications business specifications... to support the Professional Practice communications (6.0)' as a distinct, separately-owned dependency." ;
	<urn:solutiondesign:ontology:requirementId> "9.2.0" ;
	<urn:solutiondesign:ontology:statement> "As a Credentialing Admin, I want to manage all the email templates so that I can ensure consistent, accurate, and timely communication is sent to citizen users, districts, and internal staff throughout the credentialing and PPR processes." ;
	<urn:solutiondesign:ontology:title> "Manage email templates (unnumbered Feature 9.2 intro story)" .

<urn:solutiondesign:instance:profpractices:Req_09_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Configure worklist-population criteria (Disclosure Status/Date/Type); full list of valid disclosure statuses selectable; date-based criteria (on/after, before, range); activate/deactivate criteria; only matching disclosures appear; dynamic update on config change; confirmation on save; restricted to Credentialing Admin role; historical worklist records unaffected by config changes; preview/summary before save; validation of required fields; revert-to-default option." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match to profp:PPRWorklistAggregate's WorklistRoutingRules/WorklistPriorityRules/WorklistFilterConfiguration value objects and profp:Seq_ConfigurePPRWorklist. This is the exact FDD citation profpractice-domain.ttl's own profp:Question_PPRWorklistRoutingScope Annotation already names as evidence that real admin-configurable worklist routing is likely intentional (not just the platform's simpler worklist-as-filtered-list pattern) — not re-raised as a new Annotation here, since it's already tracked at the domain-model level with this exact FDD cited. 'Revert to default configuration' and a distinct 'preview/summary screen before saving' are not independently modeled beyond the general PUT /worklists/{id} update operation — minor UI-level gaps, not raised separately." ;
	<urn:solutiondesign:ontology:requirementId> "9.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_CreateWorklist> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_ListWorklists> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_UpdateWorklist> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_WorklistConfigure> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ConfigurePPRWorklist> ;
	<urn:solutiondesign:ontology:statement> "As a Credentialing Admin, I want to define and configure the PPR worklist based on the status of the disclosure and the disclosure date, so that I can ensure PPR reviewers receive accurate, prioritized, and properly filtered cases for review." ;
	<urn:solutiondesign:ontology:title> "Define and configure the PPR worklist" .

<urn:solutiondesign:instance:profpractices:Req_09_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Configure visibility per status and per flag; Credentialing-Admin-only access; hidden statuses/flags suppressed everywhere in the reviewer UI; all visible by default; changes take effect immediately, no restart." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "REJECTED, not merely superseded: comment 131 (Sinha, DTMB-Contractor, 2025-12-08) states verbatim 'This user story is outdated and will be removed,' and the identical text is repeated in a second, later review pass as comment 1774396353 (2026-03-11) — the same finding surfaced and left unaddressed across two separate review cycles, strengthening rather than weakening the rejection. No profpractice artifact models per-status/per-flag reviewer-visibility configuration, and none should be added on this story's account." ;
	<urn:solutiondesign:ontology:requirementId> "9.2.2" ;
	<urn:solutiondesign:ontology:statement> "As a Credentialing Admin, I want to manage the visibility of PPR statuses and flags for the PPR Reviewer so that reviewers only see information relevant to their assigned disclosures and can perform their reviews efficiently." ;
	<urn:solutiondesign:ontology:title> "Manage visibility of PPR statuses and flags for reviewers" .

<urn:solutiondesign:instance:profpractices:Req_09_2_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "No acceptance criteria given in the source (title-only story; comment 133 says this is 'to be defined after the business rules engine/question sets discussion'). Satisfied at the data-model level by profp:PPRQuestionConfigurationAggregate (QuestionText/ResponseType/IsRequired/ValidationRules/BranchingLogic/DisplayOrder, versioned via EffectiveDate/IsActive) and gated by profp:Perm_QuestionsManage, but profp:Perm_QuestionsManage's own sd:notes already flag a real gap: 'profpractice-api.yml only exposes GET endpoints for question configuration... no create/update/activate endpoint.' Same underlying open question as profp:Question_QuestionConfigOwnership (does PPR itself own this configuration surface, or a cross-domain forms/configuration capability?) — not re-raised as a second Annotation, just cross-referenced here." ;
	<urn:solutiondesign:ontology:requirementId> "9.2.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:PPRQuestionConfigurationAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_QuestionsManage> ;
	<urn:solutiondesign:ontology:statement> "As the Credentialing Admin, I want to manage PPR disclosure questions so that I can ensure the questions are accurate, up-to-date, and aligned with regulatory and organizational requirements, enabling citizen users to provide complete and relevant self-disclosures." ;
	<urn:solutiondesign:ontology:title> "Manage PPR disclosure questions" .

<urn:solutiondesign:instance:profpractices:Req_09_2_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "View list of self-disclosures assigned to worklist; open a disclosure and navigate to an Audit Log tab; audit log fields at minimum Action/Modified By/Modified Date+timestamp; chronological, most-recent-first; read-only, cannot be edited/deleted by any user; scoped to the selected item only; records status changes, flag assignments, disclosure-detail edits, and document actions (add/delete/rename); visible for the disclosure's entire lifecycle and retained per retention policy." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Same structural shape the FDD 29 pass's Req_29_1_7 pattern established for this project: the underlying entities exist (DisclosureReviewHistory and AccountMarkerHistory both explicitly model 'audit trail of... changes, who/when/why') and profp:Perm_AuditView is a real Permission gating 'view disclosure and marker audit logs' — but profp:Perm_AuditView's own sd:notes already document that no ApiOperation or Sequence anywhere in profpractice-api.ttl/profpractice-sequences.ttl actually exposes an audit-log read endpoint or UI flow. A real, already-documented gap between the permission/data model and the exposed surface, not newly discovered here." ;
	<urn:solutiondesign:ontology:requirementId> "9.2.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:AccountMarkerHistory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureReviewHistory> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_AuditView> ;
	<urn:solutiondesign:ontology:statement> "As a PPR Reviewer or Credential Admin, I want to see audit logs on the PPR worklist item that include the Action, Modified By, and Modified Date so that I can track all changes made during the review process and ensure accuracy, accountability, and compliance." ;
	<urn:solutiondesign:ontology:title> "Audit logs on PPR worklist item" .

<urn:solutiondesign:instance:profpractices:Req_09_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Worklist view of all disclosure submissions (annual responses, self-disclosures, Rap Back) assigned to the reviewer, with Application Number/Name/Unique ID/Certificate Type/Type/School District/Has Conviction?/Status columns; open a record to view Personal Details/PP Flags/Response Details/Responses/Attachments/Review actions/Messages; Actions dropdown offers the full controlled status list; Internal Remarks tab (staff-only) and an external Messages/+Add Message flow (visible to citizen, reviewer, and admin, may trigger communications); confirmation on save; audit log of reviewer/timestamp/previous+new status; only PPR Reviewer role can change status; a Resolved tab lists all finalized statuses; updating an item from Resolved moves it back to Unresolved." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Wireframe3 and Wireframe5 (both confirmed by viewing) directly corroborate the Actions dropdown, flag toggles, and Unresolved/Resolved tab structure respectively; Wireframe5 also visually confirms comment 136's point that the worklist's own Type column literally includes 'Rapback' rows alongside 'Yearly' and 'Disclosure' — i.e. this worklist is not self-disclosure-only, consistent with profp:PPRWorklistAggregate's WorklistQueuedDisclosureIds spanning all of profp:DisclosureAggregate's SourceType values. profp:Perm_StatusUpdate's own sd:notes already flag a permission-id naming mismatch between this catalog and profpractice-sequences.md's own sequence header ('profpractice.disclosure.update-status') — an existing, already-documented discrepancy, not re-raised here. The Resolved<->Unresolved tab MOVEMENT RULE (an item leaves Resolved the moment its status is updated again) is not independently modeled as its own invariant beyond the ten DiscState_Reviewed-* states' own sd:isTerminal true/false split — a minor granularity gap." ;
	<urn:solutiondesign:ontology:requirementId> "9.3.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedNoActionRequired> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_AddDisclosureRemark> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetWorklistDisclosures> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_UpdateDisclosureStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_RemarksAdd> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_StatusUpdate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ReviewDisclosureAndUpdateStatus> ;
	<urn:solutiondesign:ontology:statement> "As a PPR Reviewer, I want to change the status of a disclosure so that I can process all the disclosures submitted by citizen users." ;
	<urn:solutiondesign:ontology:title> "Change disclosure status to process disclosures" .

<urn:solutiondesign:instance:profpractices:Req_09_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "View/open disclosures per 9.3.1's own detail layout; add a new disclosure record on behalf of a citizen user (minimum fields: type, date of incident, description, date reported); edit existing disclosure details and replace uploaded documents while status is Under PPR Review, logged with timestamp+reviewer; delete attachments (soft-deleted, retained for audit, logged); delete an entire disclosure record entered in error while Under PPR Review, with a confirmation prompt; prevent edit/delete once a disclosure reaches a final Reviewed status; only PPR Reviewer role has these permissions; updates immediately visible to Credentialing Admin and reflected in OEE/citizen worklists." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "The 'edit while Under PPR Review, locked once Reviewed' half of this story is a strong, direct match to profp:Rule_DisclosureEditingRestrictions verbatim, and attachment soft-delete matches profp:Rule_AttachmentManagement verbatim ('reviewer requests soft-delete... removing them from the disclosure view but retaining them... for audit'). Two of this story's own sub-asks are NOT modeled with a backing operation, per profpractice-permissions.ttl's own already-documented gaps: 'add a new disclosure record on behalf of a citizen user' has no create-on-behalf endpoint (profp:Op_SubmitDisclosure is scoped scope:SelfOnly to the submitting educator, not a reviewer acting for someone else — comment 151/152 confirms this exact scenario is 'a valid scenario... wording updated to adding a new disclosure on behalf'), and 'delete an entire disclosure record' has no backing operation at all (profp:Perm_DisclosureDelete's own sd:notes: 'No API operation or sequence currently models this permission... a documented gap'). Both are carried-forward, already-documented gaps rather than newly raised Annotations, consistent with this project's convention of not re-raising a gap already flagged at the domain-model level." ;
	<urn:solutiondesign:ontology:requirementId> "9.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_UpdateDisclosure> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_DisclosureEdit> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_AttachmentManagement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_DisclosureEditingRestrictions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ReviewDisclosureAndUpdateStatus> ;
	<urn:solutiondesign:ontology:statement> "As a PPR Reviewer, I want to add, edit, delete, and update self-disclosures submitted by citizen users so that I can manage and maintain accurate disclosure records during the Professional Practices Review process." ;
	<urn:solutiondesign:ontology:title> "Add, edit, delete, and update self-disclosures during review" .

<urn:solutiondesign:instance:profpractices:Req_09_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "View RapBack response records for the reviewer's assigned users only; readable format showing at minimum notification date/event type/jurisdiction/status/case-number identifiers; expand/collapse detail; indicate pending-not-yet-received; read-only, cannot be modified; error message on retrieval failure; restricted to PPR Reviewer/Credentialing Admin roles; updates in real-time or as soon as available." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — profp:ExternalBackgroundCheckAggregate's CheckNotificationDate/CheckMatchStatus/CheckState_Pending fields and states line up with this story's field list and 'indicate pending' criterion respectively; the read-only/never-modified invariant matches profp:ExternalBackgroundCheckAggregate's own sd:invariants verbatim ('Rap Back responses are read-only for PPR staff'). One paragraph of this story's own acceptance criteria was deleted in a later revision with the comment (728676430, undated in the visible thread) 'Rap Back Reviewer responsibility; Removed from PPR' — the deleted text itself could not be recovered (the paragraph is now empty in document.xml), but the comment's clear intent is that SOME sub-capability originally listed here was reassigned to a distinct 'Rap Back Reviewer' responsibility outside PPR's own role model. profpractice-permissions.md/.ttl model only a single undifferentiated 'PPR Reviewer' role for Rap Back viewing (profp:Perm_RapbackView) — no separate Rap Back Reviewer role exists anywhere in this domain's converted permission catalog. Whether a role split is actually coming, and if so what moves with it, is unresolved — flagged here rather than guessed at." ;
	<urn:solutiondesign:ontology:requirementId> "9.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetExternalCheck> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_RapbackView> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_RetrieveFullRapSheet> ;
	<urn:solutiondesign:ontology:statement> "As a PPR Reviewer, I want to see the RapBack response record for a citizen user so that I can review up-to-date criminal history information and make informed decisions during the Professional Practices Review process." ;
	<urn:solutiondesign:ontology:title> "View RapBack response record" .

<urn:solutiondesign:instance:profpractices:Req_09_3_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Status auto-updates to Under PPR Review the moment the reviewer opens the disclosure (first review action); not locked from other reviewers despite the status change; visible to the reviewer within the record; timestamp+assignee recorded; audit entry (user ID, date/time, previous+new status); citizen sees the updated status in their own history; notifications/alerts routed per communication rules; status remains Under PPR Review until manually changed, even if the reviewer navigates away without further action." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "profp:DisclosureReviewStartedEvent ('PPR reviewer begins reviewing disclosure') matches this story's trigger exactly and profp:DiscState_UnderPprReview is a real, non-terminal state. The AUTOMATIC-on-open transition specifically (as opposed to the reviewer manually selecting 'Under PPR Review' from the Actions dropdown, which profp:Seq_ReviewDisclosureAndUpdateStatus's own sequence content shows) is not independently distinguished in that sequence's own PUT /disclosures/{id}/status step — a minor granularity gap between 'the event exists' and 'the transition is proven to be automatic rather than reviewer-initiated', not raised as its own Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "9.3.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DiscState_UnderPprReview> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureReviewStartedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ReviewDisclosureAndUpdateStatus> ;
	<urn:solutiondesign:ontology:statement> "As a PPR Reviewer user, I want to update the status of a disclosure to be set to \"Under PPR Review\" when I begin reviewing it so that I can clearly indicate that the review process has started and prevent other reviewers from duplicating work." ;
	<urn:solutiondesign:ontology:title> "Status set to Under PPR Review on reviewer open" .

<urn:solutiondesign:instance:profpractices:Req_09_3_5> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "View/open disclosures per 9.3.1's own detail layout; assign or remove the PPR Admin Flag per individual (when on: future credential applications go to PPR Hold on submission, citizen notified of delay/denial risk; when off: Rapback/NASDTEC review continues, PPR Review role notified of results); assign or remove the PPR Additional Review Flag per individual (when on: alert sent to PPR Admin Review role, processing continues); scoped to individuals assigned to the reviewer's own worklist; immediate effect; flags not visible to the citizen; all flag assignment/removal actions audit-logged (user, date/time, flag type, action)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Very strong match — 'PPR Admin Flag' = profp:MandatoryHoldRequirement and 'PPR Additional Review Flag' = profp:EnhancedMonitoringStatus, and profp:Rule_MandatoryHoldAutoHold / profp:Rule_EnhancedMonitoringStatusBehavior restate this story's own on/off branches near-verbatim (citizen notified of delay/denial risk when Mandatory Hold is on; Rap Back/NASDTEC checks continue and PPR Review is notified when off). Wireframe3 (confirmed by viewing) shows both flags as toggles directly on the disclosure/individual detail screen, matching this story's own 'view/open disclosures... assign flag' framing. profp:Perm_MarkersManage's own sd:notes already flag a discrepancy between the single system-wide permission modeled here and the four narrower per-marker permission ids profpractice-sequences.md's own sequence header names — carried forward, not re-raised. GENUINELY NEW to this pass: comment 167 (Punniyamoorthy, 'Since these flags are Profile level, how do PPR Reviewer manage these flags? at present these are displayed as part of a PPR record') and Dontje's reply (comment 168, 'We need to review 9.3.5 with AO to decide where flag will exist in the designs') show the FDD's OWN reviewers were still unsettled, as of this review pass, on whether these are individual/profile-level markers surfaced on every disclosure record (as Wireframe3 and profp:EducatorPPRStatusAggregate both model them) or something requiring a dedicated account-level screen — an open UX/IA question the domain model has already picked an answer for, but which the FDD's own review thread had not yet closed as of the visible comments. See profp:Question_MarkerFlagUiPlacement below." ;
	<urn:solutiondesign:ontology:requirementId> "9.3.5" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:EnhancedMonitoringStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:MandatoryHoldRequirement> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_ClearEnhancedMonitoring> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_ClearMandatoryHold> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_SetEnhancedMonitoring> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_SetMandatoryHold> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_MarkersManage> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_EnhancedMonitoringStatusBehavior> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_MandatoryHoldAutoHold> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ManageAccountMarkers> ;
	<urn:solutiondesign:ontology:statement> "As a PPR Reviewer, I want to assign the PPR Admin Flag and the PPR Additional Review Flag at an individual level so that I can ensure appropriate oversight, escalate cases that require additional review, and manage disclosure processing accurately based on an individual's circumstances." ;
	<urn:solutiondesign:ontology:title> "Assign PPR Admin Flag and PPR Additional Review Flag at individual level" .

<urn:solutiondesign:instance:profpractices:Req_09_3_6> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "View/open disclosures per 9.3.1's own detail layout; check/uncheck non-system-action options from a 'Non-system Actions Taken' section, including at minimum Notified School District, Referred to Professional Practices Review, and Notified MSP for Removal." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match, including the exact three named action types — profp:NonSystemActionLoggedEvent's own payloadHighlights list 'NotifiedSchoolDistrict|ReferredToPPR|NotifiedMSPRemoval' verbatim, and its own sd:content sequence diagram lists two further options (ContactedEducator, ReviewedExternalDocuments) beyond what this specific FDD story enumerates, so the domain model's action-type set is a strict superset of this story's own minimum list, not a narrower one. profp:Perm_ActionsLog's own sd:notes already document a permission-id naming mismatch against profpractice-sequences.md's own sequence header — carried forward, not re-raised." ;
	<urn:solutiondesign:ontology:requirementId> "9.3.6" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:NonSystemActionLoggedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_LogNonSystemAction> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Perm_ActionsLog> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_LogNonSystemAction> ;
	<urn:solutiondesign:ontology:statement> "As a PPR Reviewer, I want to capture non-system actions taken during the PPR review so that I can document external steps, communications, or decisions that are relevant to the case and maintain a complete and auditable review history." ;
	<urn:solutiondesign:ontology:title> "Capture non-system actions taken during PPR review" .

<urn:solutiondesign:instance:profpractices:Req_09_4_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Automatic PPR-flag evaluation on credential-application processing; if actionable, halt further processing; existing application cannot be approved and is auto-set to Denied; prevent creating a new application for the same credential; halts regardless of Needs Responses flag status; clear message/status logged/displayed; audit trail records the halted application with reason (PPR actionable offense) and timestamp; downstream automated processes (renewals, approvals) do not proceed for flagged applications." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "profp:Rule_AutomaticStopCheckOnApplicationCreation cites 'BRD 9.4.1' by number in its own sd:statement — i.e. this exact story number was already read and modeled when profpractice-domain.ttl was written. One literal mismatch worth flagging rather than silently smoothing over: this story says an EXISTING application is 'automatically set to Denied' when a Blocked-triggering condition is discovered, but profp:Rule_AutomaticStopCheckOnApplicationCreation's own statement and example both describe blocking at NEW-APPLICATION-CREATION time only ('application creation is prevented', 'before rendering the application form') — an automatic transition of an ALREADY-SUBMITTED, in-flight application straight to a terminal Denied status is not itself described by that rule or by any Credentialing-side application state transition visible from this domain's own files. Not resolved here since credentialing's own application-state-machine file is outside this pass's scope to re-verify — noted as a possible gap at the Credentialing/PPR boundary for that domain's own review pass to confirm." ;
	<urn:solutiondesign:ontology:requirementId> "9.4.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:PPRClearanceOperation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_AutomaticStopCheckOnApplicationCreation> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_ReviewedListedAbsoluteBlock> ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce system, I want an automatic stop-check to be applied when a PPR (Professional Practice Review) flag status indicates an actionable offense, so that application processing is halted immediately to ensure compliance, even if the Needs Responses flag is clear 'No'." ;
	<urn:solutiondesign:ontology:title> "Automatic stop-check on actionable PPR flag" .

<urn:solutiondesign:instance:profpractices:Req_09_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Report Management page reachable via hamburger menu, listing existing reports (Report Name/Category/Added Date/Report Status) with search and per-column filter; Add Report flow captures Report Name/Description/Power BI Link/Workspace/Role-based Availability/Category/Sub-category/Active-or-Inactive Status; Cancel/Preview/Save & Add Report actions; access restricted by authorized role selection; standard interactive report functionality (filter/sort/column add-remove); reports can pull both current MiEdWorkforce data and CEPI Data Warehouse historical data; export to PDF/Excel/CSV." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Satisfied, but entirely by the Reporting bounded context's generic report-catalog admin capability, not by any profpractice-specific artifact — see this file's header note. rpt:ReportDefinitionAggregate's own PowerBIReportReference (workspaceId/reportId) and PermissionKeyVO/DomainAssociationVO value objects match this story's Power BI Link/Workspace and role-based-availability fields closely; rpt:Op_AdminCreateReport/rpt:Op_AdminListReports/rpt:Op_AdminUpdateReport back the Add/List/Edit flows. NOT modeled anywhere in either domain: per-column search/filter on the admin report list, a distinct Preview step before saving, and pulling from 'both current MiEdWorkforce data and CEPI Data Warehouse historical data' specifically (reporting-capability.ttl's own ext:PowerBISystem integrationNotes mention CEPI CEDS Data Warehouse dashboards only as a largely-unspecified, separately-flagged Phase-4 item — see rpt:Question_PowerBILicensingModel and the [NEEDS INPUT] markers that file's own header describes). These are genuine, narrower gaps within an otherwise well-matched cross-domain capability, not raised as new Annotations here since they belong to Reporting's own review pass, not this one." ;
	<urn:solutiondesign:ontology:requirementId> "9.5.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:PowerBISystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminCreateReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminListReports> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminUpdateReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Perm_CatalogManage> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a Credentialing Administrator, I want to configure and make available Power BI reports related to Professional Practice, so that authorized users can monitor disclosure trends, review statuses, and workforce compliance metrics." ;
	<urn:solutiondesign:ontology:title> "Configure and make available Power BI reports for Professional Practice" .

<urn:solutiondesign:instance:profpractices:Req_09_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Admins (by functional area) can set reports Active or Inactive; status change takes effect immediately; an Inactive report is completely hidden from the UI with no indication of its existence/unavailability; immediate retiring of report availability." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Excellent match, essentially operation-for-operation: rpt:Op_AdminUpdateReportStatus (PATCH /admin/reports/{reportDefinitionId}/status) is exactly this story's Active/Inactive toggle, and rpt:ReportDefinitionAggregate's own invariant 'Only reports with status = Active are surfaced in the portal catalog or eligible for token generation' matches the 'completely hidden' requirement precisely. This is also the story an explicit reviewer comment (184, Dontje: 'This should be moved to #2 Reports') directly names as belonging to the Reporting domain — confirmed accurate against the actual graph, not just taken on the comment's word." ;
	<urn:solutiondesign:ontology:requirementId> "9.5.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_AdminUpdateReportStatus> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Perm_CatalogManage> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a Credentialing Admin, I need the ability to set PPR related reports as Active or Inactive on-demand, so that I can control report visibility to end-users dynamically." ;
	<urn:solutiondesign:ontology:title> "Set PPR reports Active or Inactive on-demand" .

<urn:solutiondesign:instance:profpractices:Req_09_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Requires an authorized role with report permissions; reports listed under Credential Management > Reports > Professional Practice, alphabetically under an 'All Reports' tab; user can filter reports, mark favorites, or click a report name to view it; a 'Favorite Reports' tab lists favorited reports; clicking a report name shows it as configured by the Credentialing Admin." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "The core view/embed capability is satisfied by rpt:Op_ListReports/rpt:Op_GetReport/rpt:Op_GenerateEmbedToken (generic Reporting-domain catalog browsing and embed-token issuance), with profp:Op_GetPprReportData/profp:Seq_GeneratePPRComplianceReport supplying the PPR-specific underlying data feed one of these embedded reports would query. NOT modeled anywhere in either domain: a per-user 'Favorite Reports' concept — no favoriting/bookmarking value object or operation exists on rpt:ReportDefinitionAggregate or anywhere else in reporting-capability.ttl/-api.ttl. A real, narrow coverage gap, but one that belongs to Reporting's own domain file rather than being fabricated here." ;
	<urn:solutiondesign:ontology:requirementId> "9.5.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetPprReportData> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_GeneratePPRComplianceReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_GenerateEmbedToken> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_GetReport> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:Op_ListReports> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a MiEdWorkforce User, I want to access and interact with Power BI reports related to Professional Practice, so that I can monitor workforce compliance metrics, disclosure trends, and review statuses." ;
	<urn:solutiondesign:ontology:title> "Access and interact with Power BI Professional Practice reports" .

<urn:solutiondesign:instance:profpractices:Req_09_5_4> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Export available to users with appropriate report permissions; explicitly PDF/Excel/CSV formats; user can download the exported file; export/download availability is a configurable setting managed by admins per functional area; paginated reports must be highly formatted/pixel-perfect for print/PDF." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:notes> "Satisfied only loosely: export to PDF/Excel/CSV is native, built-in Power BI embedded-report functionality (Power BI Service handles export natively once a report is embedded via rpt:Op_GenerateEmbedToken), not a capability either domain's own API models as a distinct operation — consistent with reporting-capability.ttl's own header note that Reporting 'owns none of the underlying report data or definitions... report editing/authoring... not exposed in the portal UI' beyond the catalog/embed-token layer. A configurable per-functional-area export on/off toggle specifically is not modeled anywhere. This is also the story an explicit reviewer comment (185, Dontje: 'This should be moved to #2 reports. The PPR reports will use the MiEdWorkforce standards defined in #2') directly names as belonging to Reporting, consistent with the read above." ;
	<urn:solutiondesign:ontology:requirementId> "9.5.4" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:external:PowerBISystem> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:reporting:ReportDefinitionAggregate> ;
	<urn:solutiondesign:ontology:statement> "As a System User, I need the ability to export reports in a variety of formats including PDF, Excel, and CSV, for sharing and analysis." ;
	<urn:solutiondesign:ontology:title> "Export reports in multiple formats" .

<urn:solutiondesign:instance:profpractices:Req_30_1_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "A dedicated page is available for the Rapback Admin to review and process criminal conviction notifications. The system retrieves Rapback records received from MSP for review. The system stores specific metadata: Applicant Name, SID, Applicant DOB, TCN, Applicant SSN, TCN Date, Unique ID, Judicial Flag, Request ID, Create Date. The displayed records serve as the worklist of notifications requiring prioritization and processing." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "Partial: the webhook-ingest plumbing (matching this story's own metadata field list almost verbatim against the confirmed real MSP payload in Fdd30ChrissWebhookDoc) is real and modeled. What's NOT modeled: a dedicated Rapback-Admin-facing list/landing page as its own concept (profp:ExternalBackgroundCheckAggregate has no list/search ApiOperation — profp:Op_GetExternalCheck is get-by-id only), and several of this story's named metadata fields (Requesting Agency, SID, Judicial Flag, Request ID) are folded into profp:CheckResponseData's opaque 'structured metadata' description rather than individually promoted ValueObjects. Confirmed by viewing Wireframe1 (search + results table, paginated to '6115 items' — a real, high-volume worklist)." ;
	<urn:solutiondesign:ontology:requirementId> "30.1.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_ReceiveRapBackNotification> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ReceiveRapBackNotification> ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need to view a consolidated list of Rapback records, so that I can prioritize and process criminal conviction notifications." ;
	<urn:solutiondesign:ontology:title> "Consolidated Rapback records list for triage" .

<urn:solutiondesign:instance:profpractices:Req_30_1_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Results table displays Unique ID, Employed column, Credential column, TCN/SID/Last Name/First Name, Received Date and Status; TCN is a hyperlink to the individual record detail and on-demand Rapsheet." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this is a results-table/list-view requirement, and no list or search ApiOperation exists anywhere for profp:ExternalBackgroundCheckAggregate (only get-by-id via Op_GetExternalCheck). Confirmed by viewing Wireframe1's actual results table, which matches this story's column list closely. Grouped with the synthetic search/filter gap below (profp:Req_30_BizSpec_SearchFilter) since both describe the same missing list-query capability from different angles." ;
	<urn:solutiondesign:ontology:requirementId> "30.1.2" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the search results to display key metadata like Unique ID and employment status, so that I can evaluate the record's relevance." ;
	<urn:solutiondesign:ontology:title> "Search results surface key triage metadata" .

<urn:solutiondesign:instance:profpractices:Req_30_2_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "TCN is a hyperlink within the results table; clicking it opens the individual Rapback record detail page." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "Direct match — Op_GetExternalCheck is exactly this get-by-id detail operation. Confirmed by viewing Wireframe2 (the destination detail page)." ;
	<urn:solutiondesign:ontology:requirementId> "30.2.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_GetExternalCheck> ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need to click the TCN in the search results, so that I can navigate to the specific individual's Rapback record detail page." ;
	<urn:solutiondesign:ontology:title> "Navigate from search results to record detail" .

<urn:solutiondesign:instance:profpractices:Req_30_2_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Rapsheet is generated on-demand through the MSP/CHRISS service as part of the TCN process; not stored within MiEdWorkforce; not cached." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "Strong, well-corroborated match: this story, profp:Rule_RapSheetDisplayOnly's own statement, and Fdd30ChrissSoapDoc's explicit 'should not be saved in MiEdWorkforce either' line are all textually consistent, and Wireframe2's monospace 'Rapsheet Details' panel visually confirms the display-only, unformatted-text presentation Fdd30ChrissSoapDoc itself specifies." ;
	<urn:solutiondesign:ontology:requirementId> "30.2.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_RetrieveRapSheet> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Rule_RapSheetDisplayOnly> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_RetrieveFullRapSheet> ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the system to generate the Rapsheet on-demand from the MSP service when viewing the detail page, so that I can review the latest criminal conviction details without storing sensitive data." ;
	<urn:solutiondesign:ontology:title> "On-demand Rapsheet generation, never stored" .

<urn:solutiondesign:instance:profpractices:Req_30_3_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Rapback Admin permission gates search/review/bulk-process; user verifies/validates matching before processing; 'System Actions' (Refer to Professional Practice Review, No Referral Required) apply in bulk; 'Non-System Actions' (Notify School District, Notify MSP for Removal) can be logged simultaneously in bulk." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: the bulk-apply mechanic itself (acting on N selected records in one submission) has no equivalent anywhere in profpractice-api.ttl — every relevant operation (Op_LogNonSystemAction, Op_UpdateDisclosureStatus) is single-record. Confirmed by viewing Wireframe1's row-checkbox + single 'Action Taken' dropdown/Save control, which is the bulk-action UI this story describes. See the header note on the NonSystemActionLoggedEvent cross-reference for the individual-action vocabulary that IS modeled (just not at bulk-record-count scale)." ;
	<urn:solutiondesign:ontology:requirementId> "30.3.1" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the ability to select multiple records and apply processing actions in bulk, so that I can efficiently handle high volumes of Rapback records." ;
	<urn:solutiondesign:ontology:title> "Bulk-select and process Rapback records" .

<urn:solutiondesign:instance:profpractices:Req_30_3_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Admin selects multiple records and checks the 'Notify School District' non-system-action flag; no automated email is generated; status/audit log updates to reflect the district was notified." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL — see this file's header note on the NonSystemActionLoggedEvent cross-reference: profp:NonSystemActionLoggedEvent's own actionType enum already names 'NotifiedSchoolDistrict' verbatim, a striking match. However the operation/event are modeled against profp:DisclosureAggregate, not profp:ExternalBackgroundCheckAggregate (the Rapback record) — a real aggregate-scope mismatch, since this action can be taken on a Rapback record before any Disclosure exists for it. Bulk application (multiple records at once) is also not modeled — see profp:Req_30_3_1." ;
	<urn:solutiondesign:ontology:requirementId> "30.3.2" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureNonSystemActions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:NonSystemActionLoggedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_LogNonSystemAction> ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I want to bulk log that I have notified the school district(s) about selected Rapback records, so that the system maintains an accurate audit trail of my external communications." ;
	<urn:solutiondesign:ontology:title> "Bulk-log 'Notify School District' non-system action" .

<urn:solutiondesign:instance:profpractices:Req_30_3_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Applying 'No Referral Required' in bulk offers a checkbox/flag to also log 'Notify MSP for removal'; the actual MSP notification remains a manual, out-of-system process; selected records update to 'No Referral Required' status with the flag logged." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "Same PARTIAL match reasoning as 30.3.2: profp:NonSystemActionLoggedEvent's actionType enum names 'NotifiedMSPRemoval' verbatim, but again scoped to Disclosure, not ExternalBackgroundCheck, and single-record not bulk. 'No Referral Required' as a terminal status on the Rapback record itself (distinct from any Disclosure status) has no domain-model counterpart at all — see profp:CheckState_Resolved as the closest existing ExternalBackgroundCheck terminal state, an approximate match at best (it doesn't distinguish 'referred to PPR' from 'no referral needed' the way this FDD's status vocabulary does)." ;
	<urn:solutiondesign:ontology:requirementId> "30.3.3" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:NonSystemActionLoggedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_LogNonSystemAction> ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, when classifying records as 'No Referral Required' in bulk, I need an option to flag them for 'Notify MSP for removal', so that my necessary external follow-up is documented." ;
	<urn:solutiondesign:ontology:title> "'No Referral Required' with optional 'Notify MSP for removal' flag, in bulk" .

<urn:solutiondesign:instance:profpractices:Req_30_4_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System displays a history of notes on the Rapback record; each history entry includes note content, the modifying/adding user, and date/time; if a note is edited, the audit details of the change are captured." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: profp:ExternalBackgroundCheckAggregate has no Notes concept at all (only RapSheetRetrievalLog, a different-purpose audit log). The structurally closest thing in the whole domain is profp:DisclosureInternalRemarks/DisclosureExternalRemarks + profp:Op_AddDisclosureRemark on the DISCLOSURE aggregate — a real precedent for the shape of the feature, but on the wrong aggregate and, per profp:Op_AddDisclosureRemark's own notes, not modeled as EDITABLE (add-only), whereas this story's own acceptance criteria and Wireframe2's pencil/edit icon both show edit as a first-class capability. This exact editability question is itself still open in the FDD's own review-comment trail (comment 1467423164: 'Do we also need date updated? as this notes can be edited after it is created' — unresolved in-document, per this file's header note). Renamed to 'Internal Comments' per another still-noted review comment (1100015163) but the Addendum text itself was never updated to match — a minor, low-impact naming drift, not re-raised as its own Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "30.4.2" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Administrator, I want to view the history of notes added to a record, including who added them and when, so that I have a clear audit trail of the internal communication regarding the record." ;
	<urn:solutiondesign:ontology:title> "View notes history for a Rapback record" .

<urn:solutiondesign:instance:profpractices:Req_30_4_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System stores audit details for Rapback actions; automatically includes a date/time stamp and the modifying user; full note history including these audit details is stored and reviewable historically." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: same gap as 30.4.2 — no Notes concept on profp:ExternalBackgroundCheckAggregate. Confirmed by viewing Wireframe2's Notes list, which does show author name + date per entry, matching this story's intent, but there is no backing domain-model/API node for it." ;
	<urn:solutiondesign:ontology:requirementId> "30.4.3" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, when adding notes, the system should automatically record who made the note and when, so that the audit trail is preserved." ;
	<urn:solutiondesign:ontology:title> "Auto-capture who/when on note creation" .

<urn:solutiondesign:instance:profpractices:Req_30_5_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Search results are downloadable; 'Ready to Process' results download as a SID Review File (Excel); 'Ready to Process' and 'Is Employed' results download as a District Notification File (Excel)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no export/download ApiOperation exists anywhere for profp:ExternalBackgroundCheckAggregate. profp:Op_GetPprReportData is the nearest reporting-shaped operation in this domain but is an ad-hoc aggregated-metrics endpoint (Disclosure Processing Metrics, Compliance Status, etc.) rendered by Power BI — a different purpose (dashboards/analytics) from this story's row-level, Excel-formatted case-management export. Confirmed by viewing Wireframe1's 'Download' dropdown control on the results table." ;
	<urn:solutiondesign:ontology:requirementId> "30.5.1" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need to be able to download Rapback search results into defined file formats, so that I can perform necessary offline processing and reconciliation." ;
	<urn:solutiondesign:ontology:title> "Download Rapback search results" .

<urn:solutiondesign:instance:profpractices:Req_30_5_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "File includes SID, Last Name, First Name, Unique ID, Entity Name (if applicable), Date of Termination (if applicable); one row per employing school district when 'Is Employed' is checked; each unique SID/Entity Name pair listed only once." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same export-capability gap as 30.5.1, compounded by the underlying per-district employment data itself not being queryable from this domain (see profp:Req_30_7_1/30_7_2)." ;
	<urn:solutiondesign:ontology:requirementId> "30.5.2" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the SID Review File to include a separate row for each employing district of an individual, so that employment status and termination details are clearly tracked." ;
	<urn:solutiondesign:ontology:title> "SID Review File: one row per employing district" .

<urn:solutiondesign:instance:profpractices:Req_30_5_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Results sorted by employing school district; file includes School District, Lead Administrator First/Last Name/Title/Email, and up to 20 SIDs per district; Lead Administrator data populated from the EEM database." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same export-capability gap as 30.5.1. The EEM data source itself IS a real, canonical stub elsewhere in this project (ext:EEMSystem, declared in organizations-capability.ttl — 'external educator/employment master data source') but no sd:Dependency from profpractices to ext:EEMSystem exists for this lead-administrator-lookup purpose; this FDD's own Dependencies section confirms the EEM linkage generally ('dependent on entity data established through Interface/Integrations Set up- Receive: EEM Interface (8.1)') but FDD 8 itself is unconverted (see GAPS.md)." ;
	<urn:solutiondesign:ontology:requirementId> "30.5.3" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the District Notification File to include lead administrator contact information sourced from EEM, so that communication regarding Rapbacks is directed appropriately." ;
	<urn:solutiondesign:ontology:title> "District Notification File with EEM-sourced lead administrator contact" .

<urn:solutiondesign:instance:profpractices:Req_30_6_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "All audit details for Rapback actions are stored: Action, Date/Time Stamp, Modified by; admin can view historical action details; audit details are reviewable historically." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL — same DisclosureAggregate-vs-ExternalBackgroundCheckAggregate scope mismatch already flagged on 30.3.2/30.3.3 applies here too, plus the review-comment trail itself explicitly folds this story together with the Notes-history stories ('Audit Trail is not just for the notes, it will capture the status change and/or modifying the record. I think 30.6.1 and this can be one user story' — comment 383636854, later marked done via 'This has been added to 30.6.1', comment 1809660593) — i.e. the FDD's own authors ended up treating 30.4.x/30.6.1's audit trail as one merged concept, consistent with this file modeling both against the same underlying gap/partial-match pattern." ;
	<urn:solutiondesign:ontology:requirementId> "30.6.1" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:DisclosureNonSystemActions> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:NonSystemActionLoggedEvent> ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Op_LogNonSystemAction> ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the system to store all actions taken on a Rapback record (Action, Date/Time, User), so that I can fulfill audit and compliance requirements." ;
	<urn:solutiondesign:ontology:title> "Store all actions taken on a Rapback record" .

<urn:solutiondesign:instance:profpractices:Req_30_6_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Action item in audit details is a hyperlink; clicking it displays the associated email or PPR item detail." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this is a UI-navigation requirement with no domain-model counterpart — there is no modeled concept of an audit-log entry carrying a resolvable link to 'the email that was sent' (a Communications-capability artifact) or 'the PPR work item that was created' (profp:PPRWorklistAggregate item), only the underlying domain events that would need to produce such artifacts. Comment 1157398303 (Groom) is directly relevant here: 'This should align with PPR worklist elements with an indicator that it is sent from RapBack processing' — confirming intent that a Rapback-originated PPR worklist item should be a normal PPRWorklist item with an added provenance indicator, not a separate concept, but no such indicator field exists on profp:PPRWorklistAggregate/profp:DisclosureRoutedToWorklistEvent today." ;
	<urn:solutiondesign:ontology:requirementId> "30.6.2" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the action history items to be hyperlinks, so that I can click to view the exact email sent or the specific PPR work item created." ;
	<urn:solutiondesign:ontology:title> "Action history items link to the underlying email or PPR item" .

<urn:solutiondesign:instance:profpractices:Req_30_6_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "The 'No Referral Required' action item is not available/clickable as a hyperlink." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — a negative UI-behavior detail on top of the same unmodeled action-history-hyperlink concept as 30.6.2; grouped with it rather than given a separate Annotation." ;
	<urn:solutiondesign:ontology:requirementId> "30.6.3" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the 'No Referral Required' action history item to not be clickable, as there is no associated external artifact to review." ;
	<urn:solutiondesign:ontology:title> "'No Referral Required' has no clickable action detail" .

<urn:solutiondesign:instance:profpractices:Req_30_7_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System checks employment for Unique IDs with Matched-on-SSN or Matched-on-FN/LN/DOB status; sets Is Employed flag if one or more employment records found, else leaves unchecked; stores date/time the check completed." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: this requires profpractices to QUERY staffing's employment data for a Rapback-matched Unique ID — the reverse direction from every existing profpractices<->staffing relationship in this project (profpractice-domain.ttl's own scope note explicitly disclaims owning 'employment roster management (staffing)', and the only existing cross-domain wiring is Staffing SUBSCRIBING to PPR's own assessment events/PPRClearanceAssessmentChanged, not PPR querying Staffing). staff:EmployeeRosterAggregate (with a staff:EmploymentStatus value object) and staff:Op_ListEmployees/staff:Op_SearchEmployees are the plausible real targets once this new dependency direction is built, but no sd:Dependency edge or query pattern for it exists today — a genuine, unconfirmed gap, not a fabricated link." ;
	<urn:solutiondesign:ontology:requirementId> "30.7.1" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must automatically check for active employment records associated with a matched Unique ID, so that I can set the 'Is Employed' flag for administrative review." ;
	<urn:solutiondesign:ontology:title> "Auto-check active employment for a matched Unique ID" .

<urn:solutiondesign:instance:profpractices:Req_30_7_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "For an Active employment status under the Employee Roster, the system keeps a record of each distinct operational district and any termination date for that employment record." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same new-dependency-direction gap as 30.7.1. The FDD's own review comment trail leaves the storage location genuinely unresolved too ('Where do we keep this record? 30.7.2 user story' — comment 1108281494), so this is not simply an unmodeled-but-settled requirement; it's still an open question in the source document itself." ;
	<urn:solutiondesign:ontology:requirementId> "30.7.2" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must store the associated operational district and termination date when employment records are found, so that the Rapback Admin knows which entities are affected." ;
	<urn:solutiondesign:ontology:title> "Record operational district and termination date on employment match" .

<urn:solutiondesign:instance:profpractices:Req_30_7_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System checks certificates (any status), permits, career authorizations, or special-ed approvals from the previous or current school year for Unique IDs matched on SSN or FN/LN/DOB; sets Has Credential flag and records cert type/status if found; stores date/time the check completed." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: same new-dependency-direction reasoning as 30.7.1, but toward credentialing instead of staffing. cred:Op_GetEducatorCredentials (returns cred:IssuedCredentialAggregate, all of an educator's credentials/endorsements by educatorUniqueId) is the plausible real target once this dependency direction is built, but no such Dependency exists in profpractice-domain.ttl today. A related, unresolved review comment (2071511738 — 'It doesn't need to check for the Candidate tracking records?') raises whether EPP's Candidate Tracking data (epp:Seq_BulkUploadCandidateTrackingData, per FDD 29's own GAPS.md note) should ALSO be checked alongside issued credentials — a further, even-less-settled extension of this same gap, not resolved here." ;
	<urn:solutiondesign:ontology:requirementId> "30.7.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must automatically check for current or previous teaching credentials associated with a matched Unique ID, so that I can set the 'Has Credential' flag." ;
	<urn:solutiondesign:ontology:title> "Auto-check teaching credentials for a matched Unique ID" .

<urn:solutiondesign:instance:profpractices:Req_30_8_1> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System supports adding/maintaining alias names per individual Rapback record, available to users with Rapback permissions; alias name is recorded for the record." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no Alias/AKA concept exists anywhere in this project (checked profpractice-domain.ttl and grepped the full mied-v3 tree for 'Alias' — no hits outside this FDD's own fdd-review file). Confirmed by viewing Wireframe3 (Add Alias form: First/Last/DOB/SSN) and Wireframe2/Wireframe4 (Aliases table on the record detail page)." ;
	<urn:solutiondesign:ontology:requirementId> "30.8.1" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need the ability to add and maintain alias names on a Rapback record, so that I can accurately perform manual identity verification, especially when initial automatic matching fails." ;
	<urn:solutiondesign:ontology:title> "Add and maintain alias names on a Rapback record" .

<urn:solutiondesign:instance:profpractices:Req_30_8_2> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System shows the history of alias name(s) for each individual Rapback record; Rapback Admin can view the alias name(s)." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same gap as 30.8.1. Note the wireframes (2 and 4) show only a current alias LIST with delete, not an alias-change HISTORY view distinct from the current list — a minor discrepancy between this story's 'history' framing and what's actually wireframed, not otherwise resolved in the document." ;
	<urn:solutiondesign:ontology:requirementId> "30.8.2" ;
	<urn:solutiondesign:ontology:statement> "As a Rapback Admin, I need to view the history of all alias names recorded for an individual, so that I maintain a complete record of identity changes." ;
	<urn:solutiondesign:ontology:title> "View alias name history" .

<urn:solutiondesign:instance:profpractices:Req_30_8_3> a <urn:solutiondesign:ontology:UserStory> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "System stores audit data for all changes to alias names; Rapback Admin can view historical action(s) taken; audit details include Date/Time stamp and Modified by." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — same gap as 30.8.1/30.8.2." ;
	<urn:solutiondesign:ontology:requirementId> "30.8.3" ;
	<urn:solutiondesign:ontology:statement> "As the MiEdWorkforce System, I must store audit information (user and date) whenever an alias name is added or modified, ensuring data integrity." ;
	<urn:solutiondesign:ontology:title> "Audit alias additions/modifications" .

<urn:solutiondesign:instance:profpractices:Req_30_BizSpec_IdentityMatching> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "SSN-first, then-name-cascade matching against MiEdWorkforce Person data; three resulting statuses (Matched on SSN / Matched on FN-LN-DOB / No Match); match-completion timestamp stored for each attempt." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "PARTIAL: profp:Seq_ReceiveRapBackNotification already performs person-matching for exactly this purpose (PIC-empty branch: 'POST /match-person (SSN, DOB, Name)' against Mi-Key, resolving to a Unique ID) — a real, confirmed match in principle. But the granularity differs: this FDD describes an explicit two-tier cascade (SSN-only match attempted FIRST, distinct from a combined FN/LN/DOB match attempted second) with three persisted, individually-named statuses, whereas the modeled sequence shows a single combined Mi-Key call with an implicit match/no-match outcome and no equivalent to the 'Matched on SSN' vs. 'Matched on FN/LN/DOB' distinction. profp:CheckMatchStatus (on ExternalBackgroundCheckAggregate) is a different concept entirely — it describes whether the check data matches an EXISTING DISCLOSURE, not person-identity resolution — and is not cited here to avoid the same kind of confusable-near-miss mislabeling this project's other domain files (e.g. profpractice-domain.ttl's own EndorsementDefinitionAggregate 'OutOfState' vs. applicant-level in-state/out-of-state, flagged in the FDD 29 pass) have already flagged elsewhere." ;
	<urn:solutiondesign:ontology:requirementId> "30.BizSpec.IdentityMatching" ;
	<urn:solutiondesign:ontology:satisfiedBy> <urn:solutiondesign:instance:profpractices:Seq_ReceiveRapBackNotification> ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem — Business Specifications prose, never promoted to a numbered Addendum story; same 'no user story' review-comment pattern as the MCL-matching item above.) For each Rapback record (unique TCN) received, check for an identity match in MiEdWorkforce Person data: first by SSN only (status 'Matched on SSN'); if not matched, by First Name+Last Name+DOB, ignoring hyphens/spaces/apostrophes/special characters (status 'Matched on FN/LN/DOB'); else leave Unique ID null (status 'No Match'). Store the date/time each matching step completed." ;
	<urn:solutiondesign:ontology:title> "Match Rapback record to a MiEdWorkforce identity (SSN, then FN/LN/DOB, else No Match)" .

<urn:solutiondesign:instance:profpractices:Req_30_BizSpec_MclMatching> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "Exact-match (post-normalization) against the MCL code list; a match record is stored in the MiEdWorkforce database." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy: no MCL-code matching concept exists anywhere in profpractice-domain.ttl (profp:ExternalBackgroundCheckAggregate has no offense-code/statute field at all). Beyond being simply unmodeled, this requirement is ALSO still open in the FDD's own review trail on the more important question of consequence: comment 1537976203 (Groom, 2026-02-09) reads 'SOM Action- need to determine what MCL matching results in/action, and result display' — i.e. even the FDD's own authors had not yet decided what an MCL match should DO (route to a worklist? block an action? just a flag?) as of the latest comment on record. This is the single most significant open question in this whole FDD, since the entire premise of Rap Back processing (matching criminal offenses to MCL-enumerated categories relevant to educator eligibility) hinges on it." ;
	<urn:solutiondesign:ontology:requirementId> "30.BizSpec.MclMatching" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem — Business Specifications prose, never promoted to a numbered Addendum story; three separate 'I do not see user story for this requirement' review comments from Punniyamoorthy, 2026-01-26, independently flag this same omission.) When the system receives a Rapback record, it is matched against the MDE-defined list of MCL codes (Rapbacks-MCLKeywords.xlsx, 833 entries). Matching ignores parentheses, spaces, and special characters, and is not case-sensitive. If an exact match is found, a record of the MCL match is stored." ;
	<urn:solutiondesign:ontology:title> "Match Rapback records against the MDE-defined MCL code list" .

<urn:solutiondesign:instance:profpractices:Req_30_BizSpec_SearchFilter> a <urn:solutiondesign:ontology:Requirement> ;
	<urn:solutiondesign:ontology:acceptanceCriteria> "All listed filters are available and combinable; results reflect the filtered query." ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:notes> "No satisfiedBy — the same missing list/search ApiOperation gap already noted on profp:Req_30_1_2 (get-by-id via Op_GetExternalCheck is the only query capability that exists for ExternalBackgroundCheckAggregate). Confirmed by viewing Wireframe1's full filter panel, which matches this list of filters field-for-field, including the pre-rename 'No Action Required' label." ;
	<urn:solutiondesign:ontology:requirementId> "30.BizSpec.SearchFilter" ;
	<urn:solutiondesign:ontology:statement> "(No user-story stem — Business Specifications/HLS-table prose, never promoted to a numbered Addendum story.) The system provides search/filter over Rapback records by TCN, SID, Offense Type, Segment, First Name, Last Name, Employment/Credential checks, and Action(s) Taken (Ready to Process / Notified School District / Referred to Professional Practice Review / Notified MSP for removal, No Action Required)." ;
	<urn:solutiondesign:ontology:title> "Search and filter Rapback records" .

<urn:solutiondesign:instance:profpractices:RosterEligibilityAssessment> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Not persisted as an aggregate — calculated fresh on each request. Represents PPR's assessment of whether an educator may be added to a district employment roster, for Staffing to combine with other employment criteria. EligibilityStatus is one of Eligible, EligibleWithNotification, Ineligible. Also carries BlockingReason and DistrictNotifications." ;
	<urn:solutiondesign:ontology:name> "RosterEligibilityAssessment" .

<urn:solutiondesign:instance:profpractices:Rule_AnnualPPRComplianceRequirement> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:example> "An educator last submitted PPR on May 15, 2025. On July 1, 2025 the system calculates that the last response was before June 30, so compliance is required. The system publishes PPRReminderRequired events starting December 1, 2025 (before the June 30, 2026 deadline). Communications sends email reminders; if not completed by June 30, 2026, the system displays a banner alert on login and continues sending reminders." ;
	<urn:solutiondesign:ontology:rationale> "Ensures ongoing compliance with disclosure requirements throughout an educator's career. The computed approach eliminates the need for batch marker reset jobs." ;
	<urn:solutiondesign:ontology:statement> "Educators must complete a Professional Practice Review response annually. Compliance is determined by whether the educator has submitted a PPR response since June 30 of the current year (BRD 9.1.7): if LastPPRResponseDate is null (new educator), compliance is required after first credential application; if before June 30 of the current year, compliance is required; if on/after June 30, compliance is current; submissions dated June 29-30 count as current even if processed after June 30 (grace period). The system publishes PPRReminderRequired events at configured intervals before the annual due date (typically 30/60/90 days prior); if overdue, reminders continue at regular intervals until completed." .

<urn:solutiondesign:instance:profpractices:Rule_AttachmentManagement> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:example> "An educator accidentally uploads the same court order three times. A PPR reviewer requests soft-delete of two copies via the Documents API, removing them from the disclosure view but retaining them in system storage for audit purposes." ;
	<urn:solutiondesign:ontology:rationale> "Protects integrity of evidence while allowing administrative cleanup of duplicate or erroneous uploads." ;
	<urn:solutiondesign:ontology:statement> "Supporting documents for disclosures can be soft-deleted by PPR staff (removed from view but retained in audit). Hard deletes require DTMB intervention via ticket. Educators cannot delete attachments after submission; they must contact PPR staff." .

<urn:solutiondesign:instance:profpractices:Rule_AutomaticStopCheckOnApplicationCreation> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:PPRClearanceOperation> ;
	<urn:solutiondesign:ontology:example> "Educator clicks 'Apply for Certificate'. Before rendering the application form, Credentialing calls the PPR clearance API. The educator has a 'Reviewed - Listed' disclosure. PPR returns Blocked status. Credentialing displays: 'You cannot apply for a credential due to a disqualifying conviction. Contact MDE-Professional-Practice@Michigan.gov for assistance.'" ;
	<urn:solutiondesign:ontology:notes> "Enforcement point is on the Credentialing side (this rule describes Credentialing's own consumption behavior), but appliesTo/enforcedBy are still anchored to PPR's own EducatorPPRStatusAggregate/PPRClearanceOperation since that is the artifact this rule's data flows through on PPR's side of the boundary." ;
	<urn:solutiondesign:ontology:rationale> "Prevents educators from initiating application workflows when known disqualifiers exist, saving time for both educator and processing staff." ;
	<urn:solutiondesign:ontology:statement> "When an educator attempts to create a new credential application, Credentialing immediately evaluates PPR clearance (BRD 9.4.1): if PPR returns Blocked clearance status (Mandatory Hold Requirement active OR a \"Reviewed - Listed\" disclosure exists), application creation is prevented and a clear error message is displayed; this block applies regardless of Annual PPR Compliance status." .

<urn:solutiondesign:instance:profpractices:Rule_DisclosureEditingRestrictions> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Op_UpdateDisclosure> ;
	<urn:solutiondesign:ontology:example> "A reviewer finalizes a disclosure as 'Reviewed - Misdemeanor'. Later they realize they selected the wrong status. They must request a PPR Admin to revert the status to 'Under PPR Review' before making corrections." ;
	<urn:solutiondesign:ontology:rationale> "Prevents accidental corruption of finalized reviews while allowing corrections during the active review process." ;
	<urn:solutiondesign:ontology:statement> "Disclosures in \"Under PPR Review\" status can be edited by PPR staff (date, type, description, attachments). Once a disclosure reaches any \"Reviewed\" status, it becomes locked and cannot be edited without explicit reversion by PPR Admin." .

<urn:solutiondesign:instance:profpractices:Rule_EnhancedMonitoringStatusBehavior> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:example> "An educator had a minor incident years ago. PPR activates Enhanced Monitoring Status to monitor future applications without blocking employment. When they apply for a new endorsement, PPR returns ConditionalClearance, Communications sends an alert to PPR staff, but Credentialing approval proceeds if all other requirements are met." ;
	<urn:solutiondesign:ontology:rationale> "Allows monitoring of individuals with minor concerns without blocking their ability to work, while ensuring oversight." ;
	<urn:solutiondesign:ontology:statement> "When Enhanced Monitoring Status is active for an educator (BRD 9.1.20): PPR clearance returns ConditionalClearance with a review trigger indicating monitoring is active; Communications sends alerts to the PPR Review role when new credential applications are submitted (triggered by domain events); application processing continues normally (no automatic hold); Rap Back and NASDTEC checks proceed as usual; PPR staff receive notifications of external check results for review." .

<urn:solutiondesign:instance:profpractices:Rule_MandatoryHoldAutoHold> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:PPRClearanceOperation> ;
	<urn:solutiondesign:ontology:example> "An educator is under criminal investigation. PPR Admin activates Mandatory Hold Requirement. When the educator applies for a permit, PPR returns Hold status and Credentialing sets the application to 'PPR Hold' — cannot auto-approve regardless of other eligibility factors." ;
	<urn:solutiondesign:ontology:rationale> "Provides blanket hold for high-risk individuals pending investigation." ;
	<urn:solutiondesign:ontology:statement> "When Mandatory Hold Requirement is active for an educator (BRD 9.1.19): all credential applications receive Hold clearance status upon submission; the citizen is notified that the application is under review and may be delayed or denied; applications cannot proceed until the marker is cleared by PPR Review role; Rap Back and NASDTEC checks may still occur in background." .

<urn:solutiondesign:instance:profpractices:Rule_NASDTECNightlyBatchProcessing> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Op_ProcessNasdtecBatch> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Seq_ProcessNasdtecNightlyBatch> ;
	<urn:solutiondesign:ontology:example> "NASDTEC reports that an educator had their Ohio certificate revoked. The nightly batch matches the SSN to a Michigan educator, creates a background check record with the clearinghouse URL, and routes it to worklist. A PPR reviewer clicks the URL to see full details on the NASDTEC site and makes a processing determination." ;
	<urn:solutiondesign:ontology:rationale> "Ensures Michigan is aware of out-of-state disciplinary actions against educators holding or applying for Michigan credentials." ;
	<urn:solutiondesign:ontology:statement> "The system performs a nightly pull from the NASDTEC API (GET /v1/clearinghouse/people) and: (1) retrieves all educators with TransactionDate in the current month; (2) stores records locally (LastName, FirstName, MiddleName, SuffixName, BirthDate, CertificationID, Jurisdiction, TransactionDate, ClearinghouseId, ClearinghouseUrl); (3) matches to Michigan educators using Mi-Key (CertificationID/SSN + BirthDate + Name -> Unique ID); (4) if matched, creates an ExternalBackgroundCheck record and associates it with the educator; (5) routes it to the PPR worklist for manual review." .

<urn:solutiondesign:instance:profpractices:Rule_PPRClearanceAssessment> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:PPRClearanceOperation> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Seq_EvaluatePPRClearance> ;
	<urn:solutiondesign:ontology:example> "An educator with a past felony DUI conviction, status \"Reviewed - Felony\", applies for a teaching certificate. PPR returns ConditionalClearance with requiresFelonyAcknowledgment=true and a districtNotifications message asking the district to complete the felony disclosure acknowledgment form; Credentialing flags the application for manual review rather than auto-approving." ;
	<urn:solutiondesign:ontology:notes> "CROSS-DOMAIN-CRITICAL: this is the exact rule credentialing's own v2 conversion depends on via GET /educators/{id}/ppr-clearance and the PPRClearanceAssessmentChanged event — both names are confirmed present in this source verbatim (see profpractice-domain.ttl's header comment). DISCREPANCY FLAGGED (not silently resolved): profpractice-api.yml's own operation description for GET /educators/{educatorId}/ppr-clearance states only a 6-step priority order that SKIPS this rule's own step 5 (\"other reviewed disclosures exist -> ConditionalClearance or Clear\") entirely, jumping from step 4 (active review) directly to Enhanced Monitoring Status and then Clear. profpractice-sequences.md's own 'Evaluate PPR Clearance for Credential Application' sequence diagram matches profpractice-domain.md's 7-step version (it has an explicit 'Other reviewed disclosures?' branch), so the api.yml's operation description appears to be the outlier / an incomplete summary rather than the domain.md rule being wrong — but this is not silently corrected here. See profp:Question_ClearancePriorityOrderMismatch." ;
	<urn:solutiondesign:ontology:rationale> "Keeps decision logic flexible and auditable — changing business rules doesn't require database migrations, just updating the evaluation method. This is PPR's assessment only; Credentialing makes the final approval/denial decision combining PPR clearance with other factors." ;
	<urn:solutiondesign:ontology:statement> "When a credential application is submitted (or re-evaluated during processing), the system calculates PPR clearance by evaluating in priority order: (1) Mandatory Hold Requirement active -> Hold; (2) \"Reviewed - Listed\" disclosure exists -> Blocked; (3) \"Reviewed - Felony\" disclosure exists -> ConditionalClearance + felony acknowledgment required; (4) active review disclosure exists (Under PPR Review, PPR Hold, PPR Document Hold) -> Hold; (5) other reviewed disclosures exist (Reviewed - Misdemeanor, Reviewed - Arraignment, Reviewed - Non-Enumerated) -> ConditionalClearance or Clear (optional district message); (6) Enhanced Monitoring Status active -> ConditionalClearance; (7) no concerns -> Clear. Most restrictive condition takes precedence." .

<urn:solutiondesign:instance:profpractices:Rule_RapBackTriggeredDisclosure> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Op_ReceiveRapBackNotification> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Seq_ReceiveRapBackNotification> ;
	<urn:solutiondesign:ontology:example> "An educator with a valid teaching certificate is arrested for DUI. Rap Back sends notification. The system creates a disclosure requiring educator response, routes it to worklist, and publishes the event. Communications sends an email to the educator. The next time Credentialing evaluates clearance, the active-review disclosure triggers Hold status." ;
	<urn:solutiondesign:ontology:rationale> "Ensures educators cannot obtain credentials between time of arrest and conviction without MDE awareness." ;
	<urn:solutiondesign:ontology:statement> "When a Rap Back notification is received indicating new criminal activity (Integration A from spec), the system automatically: (1) creates a placeholder disclosure record linked to the external check; (2) routes the disclosure to the OEE worklist for review; (3) publishes RapBackNotificationReceived (Communications sends notification to the educator requiring disclosure or explanation); (4) any subsequent clearance evaluation reflects the active review status (Hold)." .

<urn:solutiondesign:instance:profpractices:Rule_RapSheetDisplayOnly> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Op_RetrieveRapSheet> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Seq_RetrieveFullRapSheet> ;
	<urn:solutiondesign:ontology:example> "A PPR reviewer sees a Rap Back notification for an educator, clicks 'View Rap Sheet'. The system makes a SOAP call to CHRISS and displays the rap sheet text in a modal. The reviewer reviews details and updates disclosure status. The rap sheet content is never written to the database — only the fact that retrieval occurred (audit log)." ;
	<urn:solutiondesign:ontology:rationale> "Privacy and data retention compliance; full rap sheets contain sensitive information beyond MDE's purview." ;
	<urn:solutiondesign:ontology:statement> "Full rap sheets retrieved via the CHRISS GET_RAPBACK SOAP call (Integration B from spec) are displayed to authorized PPR reviewers but NEVER stored in the system. Only metadata (requestID, tcn, judicialMarker) is persisted in the ExternalBackgroundCheck aggregate." .

<urn:solutiondesign:instance:profpractices:Rule_ReReviewRequirementBehavior> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Op_SetReReview> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:PPRWorklistAggregate> ;
	<urn:solutiondesign:ontology:example> "An educator with a 'Reviewed - Misdemeanor' from 5 years ago applies for a new position. Credentialing Admin activates Re-Review Requirement. The next time the educator's disclosures are evaluated for worklist population, the old misdemeanor disclosure appears in worklist for re-review." ;
	<urn:solutiondesign:ontology:rationale> "Provides a mechanism to re-evaluate educators whose circumstances have changed or who require heightened oversight despite previously cleared disclosures." ;
	<urn:solutiondesign:ontology:statement> "When Re-Review Requirement is active for an educator (BRD 9.1.8): disclosures in statuses that normally wouldn't populate worklist (Reviewed - No Action Required, Reviewed - Non-Enumerated, Reviewed - Misdemeanor, Reviewed - Arraignment) are forced back into the PPR worklist; applies to educators with credential status Valid, Withdrawn, Suspended, or Revoked; allows re-review of previously cleared disclosures when additional scrutiny is warranted." .

<urn:solutiondesign:instance:profpractices:Rule_ReviewedFelonyConditionalProcessing> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:PPRClearanceOperation> ;
	<urn:solutiondesign:ontology:example> "An educator with a past felony DUI conviction applies for a teaching certificate. PPR returns ConditionalClearance with felony acknowledgment requirement. Credentialing flags the application for manual review and notifies the district to complete the acknowledgment form before hire can proceed." ;
	<urn:solutiondesign:ontology:rationale> "Felonies don't automatically disqualify, but require district acknowledgment and an informed hiring decision." ;
	<urn:solutiondesign:ontology:statement> "When an educator has ANY disclosure in \"Reviewed - Felony\" status (BRD 9.1.9b): a credential application can still be created and submitted; PPR returns ConditionalClearance with RequiresFelonyAcknowledgment=true; the application cannot auto-approve and requires manual review; the district must complete a felony disclosure acknowledgment form before the application proceeds." .

<urn:solutiondesign:instance:profpractices:Rule_ReviewedListedAbsoluteBlock> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Op_GetRosterEligibilityAssessment> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:PPRClearanceOperation> ;
	<urn:solutiondesign:ontology:example> "A district HR user tries to add a new teacher to their roster. The teacher has a disclosure with status \"Reviewed - Listed\" (child abuse conviction). PPR returns Ineligible. Staffing blocks the addition and displays an error." ;
	<urn:solutiondesign:ontology:rationale> "Listed offenses are enumerated in state statute as absolute disqualifiers. No credential or employment allowed." ;
	<urn:solutiondesign:ontology:statement> "When an educator has ANY disclosure in \"Reviewed - Listed\" status (BRD 9.1.6): new credential applications cannot be created (PPR returns Blocked; Credentialing displays error); the educator cannot be added to an employment roster (PPR returns Ineligible; Staffing displays error); no exceptions or overrides exist without changing the disclosure status itself." .

<urn:solutiondesign:instance:profpractices:Rule_RosterEligibilityAssessment> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Op_GetRosterEligibilityAssessment> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:Seq_EvaluateRosterEligibility> ;
	<urn:solutiondesign:ontology:example> "A district HR user tries to add a teacher with a \"Reviewed - Listed\" disclosure (child abuse conviction) to their roster. PPR returns Ineligible; Staffing blocks the addition and displays: 'This individual has a disqualifying conviction and cannot be employed in Michigan schools.'" ;
	<urn:solutiondesign:ontology:notes> "Note this rule's own priority order lists only 4 steps (no separate Enhanced Monitoring Status branch), unlike the 6-7 step Clearance Assessment rule above — this is as documented in profpractice-domain.md, not an inconsistency introduced by this conversion." ;
	<urn:solutiondesign:ontology:rationale> "Employment eligibility has stricter constraints than credential application eligibility. Listed offenses are absolute employment barriers per state statute." ;
	<urn:solutiondesign:ontology:statement> "When a district attempts to add an educator to an employment roster, the system evaluates PPR eligibility in priority order: (1) \"Reviewed - Listed\" disclosures exist -> Ineligible (statutory employment prohibition); (2) \"Reviewed - Felony\" disclosures exist -> EligibleWithNotification (requires felony acknowledgment); (3) active review disclosures exist (Under PPR Review, PPR Hold, PPR Document Hold) -> Ineligible (blocked until review complete); (4) other reviewed disclosures exist -> Eligible or EligibleWithNotification (optional message)." .

<urn:solutiondesign:instance:profpractices:Rule_SevenYearAuditRetention> a <urn:solutiondesign:ontology:BusinessRule> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:enforcedBy> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> ;
	<urn:solutiondesign:ontology:example> "An educator appeals a credential denial based on a 2018 disclosure. PPR staff retrieve the complete audit trail showing all reviewer actions, status changes, and supporting documents (including soft-deleted duplicates) from 2018 forward." ;
	<urn:solutiondesign:ontology:rationale> "Supports compliance audits, legal proceedings, and appeals." ;
	<urn:solutiondesign:ontology:statement> "All disclosure records, review actions, status changes, audit log entries, and soft-deleted attachments must be retained for a minimum of seven years per state records retention policy. Hard-deleted documents (via DTMB intervention) are purged immediately and do not count toward retention requirements. After seven years, soft-deleted attachments may be purged via automated retention policy; active disclosures and non-deleted attachments are retained indefinitely or per state policy." .

<urn:solutiondesign:instance:profpractices:Seq_ConfigurePPRWorklist> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant UI as PPR Admin UI\n    participant PPRService as PPR Service\n    participant IAM as Identity & Access API\n\n    Admin->>UI: Navigate to \"Manage Worklists\"\n    UI->>IAM: Verify permission (worklist.configure)\n    IAM-->>UI: Permission confirmed\n\n    UI->>PPRService: GET /worklists\n    PPRService-->>UI: List of worklists\n\n    alt Creating New Worklist\n        Admin->>UI: Click \"Create Worklist\"\n        Admin->>UI: Enter worklist name (e.g., \"Felony Review Queue\")\n\n        Admin->>UI: Define routing rules\n        Note over Admin,UI: Configure conditions:<br/>- Disclosure type = Felony<br/>- Status = Under PPR Review<br/>- Date range filters\n\n        Admin->>UI: Set priority rules (sort by conviction date desc)\n        Admin->>UI: Configure visibility settings\n\n        Admin->>UI: Submit worklist\n        UI->>PPRService: POST /worklists\n\n        PPRService->>PPRService: Create PPRWorklist aggregate\n        Note over PPRService: State: Active\n\n        PPRService-->>UI: Worklist created\n        UI-->>Admin: Confirmation\n\n    else Editing Existing Worklist\n        Admin->>UI: Select worklist to edit\n        UI->>PPRService: GET /worklists/{id}\n        PPRService-->>UI: Worklist configuration\n\n        Admin->>UI: Modify routing rules or priority settings\n        Admin->>UI: Submit changes\n\n        UI->>PPRService: PUT /worklists/{id}\n        PPRService->>PPRService: Update PPRWorklist aggregate\n        PPRService-->>UI: Worklist updated\n        UI-->>Admin: Confirmation\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Conflicting routing rules across worklists > Validation error. Admin lacks permission > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (configuration change only)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Routing Rules: Define which disclosures automatically populate this worklist. Priority Settings: Determine sort order within worklist. Visibility Settings: Control which statuses/markers appear in this queue." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Configure PPR Worklist" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: PPR Admin creates or modifies worklist routing rules. When: New processing queue needed or routing logic changes. Who: User with profpractice.worklist.configure permission (PPR Admin)." .

<urn:solutiondesign:instance:profpractices:Seq_EvaluatePPRClearance> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Credentialing as Credentialing Service\n    participant PPRService as PPR Service\n\n    Credentialing->>PPRService: GET /educators/{id}/ppr-clearance\n\n    PPRService->>PPRService: Load EducatorPPRStatus aggregate\n    PPRService->>PPRService: Load all active and finalized disclosures\n\n    Note over PPRService: Evaluate in priority order:<br/>1. Mandatory Hold Requirement active?<br/>2. \"Reviewed - Listed\" disclosure exists?<br/>3. \"Reviewed - Felony\" disclosure exists?<br/>4. Active review disclosure exists?<br/>5. Other reviewed disclosures?<br/>6. Enhanced Monitoring Status active?<br/>7. No concerns?\n\n    alt Mandatory Hold Requirement active\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: ClearanceStatus: Hold<br/>BlockingReason: \"Mandatory Hold Requirement active\"<br/>DistrictNotifications: [hold message]\n\n    else \"Reviewed - Listed\" disclosure exists\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: ClearanceStatus: Blocked<br/>BlockingReason: \"Enumerated offense on record\"<br/>DistrictNotifications: [blocked messages]\n\n    else \"Reviewed - Felony\" disclosure exists\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: ClearanceStatus: ConditionalClearance<br/>RequiresFelonyAcknowledgment: true<br/>DistrictNotifications: [felony form message]\n\n    else Active disclosure (\"Under PPR Review\", \"PPR Hold\", etc.)\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: ClearanceStatus: Hold<br/>BlockingReason: \"Disclosure under active review\"\n\n    else Enhanced Monitoring Status active\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: ClearanceStatus: ConditionalClearance<br/>ReviewTriggers: [\"EnhancedMonitoringStatusActive\"]\n\n    else No PPR concerns\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: ClearanceStatus: Clear\n    end\n\n    PPRService-->>Credentialing: PPRClearanceAssessment value object\n\n    Note over Credentialing: Credentialing uses assessment to:<br/>- Block/hold/flag applications<br/>- Display district notifications<br/>- Require felony acknowledgment<br/>Final credential approval decision<br/>combines PPR + other factors\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Educator not found > Return 404. Database unavailable > Return 503, Credentialing should retry." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (synchronous query)." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Calculated On-Demand: Assessment is never cached; computed fresh on each request. Priority Order: Most restrictive condition takes precedence. Not Final Decision: PPR provides assessment; Credentialing makes approval/denial decision." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Evaluate PPR Clearance for Credential Application" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Credentialing domain requests PPR clearance assessment for application. When: Educator submits credential application or application status changes. Who: Credentialing domain (API consumer)." .

<urn:solutiondesign:instance:profpractices:Seq_EvaluateRosterEligibility> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Staffing as Staffing Service\n    participant PPRService as PPR Service\n\n    Staffing->>PPRService: GET /educators/{id}/roster-eligibility\n\n    PPRService->>PPRService: Load EducatorPPRStatus aggregate\n    PPRService->>PPRService: Load all active and finalized disclosures\n\n    Note over PPRService: Evaluate in priority order:<br/>1. \"Reviewed - Listed\" disclosure exists?<br/>2. Active review disclosure exists?<br/>3. \"Reviewed - Felony\" disclosure exists?<br/>4. No concerns?\n\n    alt \"Reviewed - Listed\" disclosure exists\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: EligibilityStatus: Ineligible<br/>BlockingReason: \"Enumerated offense\"<br/>DistrictNotifications: [employment prohibition]\n\n    else Active disclosure (\"Under PPR Review\", etc.)\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: EligibilityStatus: Ineligible<br/>BlockingReason: \"Review in progress\"\n\n    else \"Reviewed - Felony\" disclosure exists\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: EligibilityStatus: EligibleWithNotification<br/>DistrictNotifications: [felony acknowledgment required]\n\n    else No PPR concerns\n        PPRService->>PPRService: Build assessment\n        Note over PPRService: EligibilityStatus: Eligible\n    end\n\n    PPRService-->>Staffing: RosterEligibilityAssessment value object\n\n    Note over Staffing: Staffing uses assessment to:<br/>- Block roster addition if Ineligible<br/>- Display district notifications<br/>- Allow addition with warnings if EligibleWithNotification\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Educator not found > Return 404. Database unavailable > Return 503." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (synchronous query)." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Stricter Than Credentialing: Employment eligibility has absolute blocks (Listed offenses, active reviews). Calculated On-Demand: Never cached. District Notification: EligibleWithNotification requires district acknowledgment but allows employment." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Evaluate Roster Eligibility for Employment" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Staffing domain requests PPR eligibility assessment before roster addition. When: District HR attempts to add educator to employment roster. Who: Staffing domain (API consumer)." .

<urn:solutiondesign:instance:profpractices:Seq_ExportDisclosureData> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor User\n    participant UI as PPR UI\n    participant PPRService as PPR Service\n    participant ExportService as Export Service\n\n    User->>UI: Navigate to disclosure history\n    UI->>PPRService: GET /educators/{id}/disclosures (scope-aware)\n    PPRService-->>UI: Disclosures (filtered by permission scope)\n\n    User->>UI: Click \"Export to PDF/CSV\"\n    UI->>ExportService: POST /export/disclosures\n\n    Note over ExportService: Generate export file with:<br/>- Disclosure details<br/>- Status history<br/>- Remarks (filtered by permission)<br/>- Document references\n\n    ExportService-->>UI: Export file ready\n    UI-->>User: Download export file\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Export generation fails > Display error, allow retry. No data to export > Display message." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (or optional audit log entry)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Format Options: PDF for official records, CSV for data analysis. Permission Filtering: Educators see only their own; admins see based on scope. Document References: Export includes document IDs/names but not file content." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Export Disclosure Data" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Educator or admin downloads disclosure records for offline review. When: User needs records for personal files, legal proceedings, or compliance audits. Who: Authenticated educator (self-only) or admin with appropriate permissions." .

<urn:solutiondesign:instance:profpractices:Seq_GeneratePPRComplianceReport> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant UI as Reporting UI\n    participant PPRService as PPR Service\n    participant ReportingEngine as Reporting Engine (Power BI)\n    participant IAM as Identity & Access API\n\n    Admin->>UI: Navigate to \"PPR Reports\"\n    UI->>IAM: Verify permission (reports.*.view)\n    IAM-->>UI: Permission confirmed with scope\n\n    UI-->>Admin: Display available report types\n    Note over UI: Report options:<br/>- Disclosure Processing Metrics<br/>- Annual PPR Compliance Status<br/>- Review Timeline Analysis<br/>- Status Distribution<br/>- Worklist Performance\n\n    Admin->>UI: Select report type and filters\n    Note over Admin,UI: Filter options:<br/>- Date range<br/>- Disclosure type<br/>- Status<br/>- Worklist<br/>- Reviewer<br/>- District/ISD (scope-aware)\n\n    Admin->>UI: Click \"Generate Report\"\n\n    UI->>PPRService: GET /reports/data?type={type}&filters={...}\n    Note over PPRService: Query respects permission scope:<br/>System-wide vs Entity vs District\n\n    PPRService->>PPRService: Aggregate disclosure data\n    Note over PPRService: Calculate metrics:<br/>- Total disclosures by status<br/>- Average review time<br/>- Overdue PPR responses<br/>- Clearance assessment distribution<br/>- Worklist volume and throughput\n\n    PPRService-->>UI: Report data (JSON)\n\n    UI->>ReportingEngine: Render report visualization\n    ReportingEngine-->>UI: Formatted report (charts, tables)\n\n    UI-->>Admin: Display interactive report\n\n    alt Admin wants to export\n        Admin->>UI: Click \"Export Report\"\n        UI->>ReportingEngine: Generate export file (PDF/Excel)\n        ReportingEngine-->>UI: Export file\n        UI-->>Admin: Download export\n    end\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "No data matching filters > Display message. Reporting engine unavailable > Display error, suggest retry. Permission denied for requested scope > Access denied." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (or optional audit log entry for report access)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "External Reporting Tool: Reports rendered via Power BI or similar business intelligence platform. PPR Domain Responsibility: PPR Service provides data endpoints; reporting platform handles visualization. Scope-Aware: Reports filter data based on user's permission scope (system-wide, district, ISD). Real-Time Data: Reports query current state, not cached/snapshot data." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Generate PPR Compliance Report" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Admin accesses reporting interface to view disclosure processing metrics and compliance data. When: Ad-hoc reporting needs, compliance audits, or management review. Who: User with profpractice.report.view permission (source header names 'profpractice.reports.disclosure-metrics.view' or 'profpractice.reports.compliance.view', neither of which exists in profpractice-permissions.md — see that permission's own notes)." .

<urn:solutiondesign:instance:profpractices:Seq_LogNonSystemAction> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Reviewer\n    participant WorklistUI as Worklist UI\n    participant PPRService as PPR Service\n    participant EventBus as Event Bus\n\n    Reviewer->>WorklistUI: Review disclosure\n    Note over Reviewer: Reviewer takes external action:<br/>- Calls educator for clarification<br/>- Emails school district<br/>- Reviews external court records<br/>- Refers case to specialist\n\n    Reviewer->>WorklistUI: Click \"Log Non-System Action\"\n    WorklistUI-->>Reviewer: Display action logging form\n\n    Reviewer->>WorklistUI: Select action type\n    Note over Reviewer,WorklistUI: Options:<br/>- NotifiedSchoolDistrict<br/>- ReferredToPPR<br/>- NotifiedMSPRemoval<br/>- ContactedEducator<br/>- ReviewedExternalDocuments\n\n    Reviewer->>WorklistUI: Enter action description\n    Reviewer->>WorklistUI: Submit log entry\n\n    UI->>PPRService: POST /disclosures/{id}/non-system-actions\n\n    PPRService->>PPRService: Update Disclosure aggregate\n    Note over PPRService: NonSystemActions: [<br/>  { actionType, description,<br/>    loggedBy, loggedAt }<br/>]\n\n    PPRService--)EventBus: NonSystemActionLogged\n\n    PPRService-->>WorklistUI: Action logged\n    WorklistUI-->>Reviewer: Confirmation\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Description missing > Validation error. Action type not recognized > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "NonSystemActionLogged - For audit purposes." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Audit Trail: All non-system actions recorded for compliance and appeals. Free-Form Description: Allows flexible documentation of varied activities. No State Change: Logging action does not change disclosure status." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Log Non-System Action" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: PPR reviewer documents external activities (phone calls, emails, manual document reviews). When: Reviewer takes action outside the system that should be audited. Who: User with profpractice.actions.log permission (source header names 'profpractice.disclosure.log-non-system-action', which does not exist in profpractice-permissions.md — see that permission's own notes)." .

<urn:solutiondesign:instance:profpractices:Seq_ManageAccountMarkers> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Admin\n    participant UI as PPR Admin UI\n    participant PPRService as PPR Service\n    participant IAM as Identity & Access API\n    participant EventBus as Event Bus\n\n    Admin->>UI: Search for educator\n    UI->>PPRService: GET /educators/search\n    PPRService-->>UI: Educator results\n\n    Admin->>UI: Select educator\n    UI->>PPRService: GET /educators/{id}/ppr-status\n    PPRService-->>UI: Current account markers and disclosure history\n\n    Admin->>UI: Select marker action\n    Note over Admin,UI: Options:<br/>- Set/Clear Mandatory Hold Requirement<br/>- Set/Clear Enhanced Monitoring Status<br/>- Set/Clear Re-Review Requirement\n\n    Admin->>UI: Enter justification for marker change\n\n    alt Set Mandatory Hold Requirement\n        UI->>IAM: Verify permission (account-marker.set-mandatory-hold)\n        IAM-->>UI: Permission confirmed\n\n        UI->>PPRService: POST /educators/{id}/markers/mandatory-hold\n        PPRService->>PPRService: Update EducatorPPRStatus aggregate\n        Note over PPRService: MandatoryHoldRequirement = true<br/>MarkerReason recorded<br/>MarkerHistory audited\n\n        PPRService--)EventBus: PPRAccountMarkerChanged (markerType: MandatoryHold)\n        PPRService--)EventBus: PPRClearanceAssessmentChanged\n\n    else Clear Mandatory Hold Requirement\n        UI->>IAM: Verify permission (account-marker.clear-mandatory-hold)\n        IAM-->>UI: Permission confirmed\n\n        UI->>PPRService: DELETE /educators/{id}/markers/mandatory-hold\n        PPRService->>PPRService: Update EducatorPPRStatus aggregate\n        Note over PPRService: MandatoryHoldRequirement = false\n\n        PPRService--)EventBus: PPRAccountMarkerChanged\n        PPRService--)EventBus: PPRClearanceAssessmentChanged\n\n    else Set Enhanced Monitoring Status\n        UI->>IAM: Verify permission (account-marker.set-enhanced-monitoring)\n        IAM-->>UI: Permission confirmed\n\n        UI->>PPRService: POST /educators/{id}/markers/enhanced-monitoring\n        PPRService->>PPRService: Update EducatorPPRStatus aggregate\n\n        PPRService--)EventBus: PPRAccountMarkerChanged (markerType: EnhancedMonitoring)\n        PPRService--)EventBus: PPRClearanceAssessmentChanged\n\n    else Set Re-Review Requirement\n        UI->>IAM: Verify permission (account-marker.set-rereview)\n        IAM-->>UI: Permission confirmed\n\n        UI->>PPRService: POST /educators/{id}/markers/rereview\n        PPRService->>PPRService: Update EducatorPPRStatus aggregate\n        PPRService->>PPRService: Re-route previously reviewed disclosures to worklist\n\n        PPRService--)EventBus: PPRAccountMarkerChanged (markerType: ReReview)\n        PPRService--)EventBus: DisclosureRoutedToWorklist (for each re-routed disclosure)\n    end\n\n    PPRService-->>UI: Marker updated\n    UI-->>Admin: Confirmation with audit trail\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Admin lacks permission > Access denied. Justification missing > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "PPRAccountMarkerChanged - Marker state change. PPRClearanceAssessmentChanged - Triggers downstream re-evaluation. DisclosureRoutedToWorklist - If Re-Review Requirement forces disclosures back to review." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Justification Required: All marker changes require reason text for audit trail. Permission Segregation: Different permissions for setting vs. clearing markers per this sequence's own narrative, though profpractice-permissions.md models a single profpractice.markers.manage permission covering all marker set/clear operations — see notes on the IAM verify-permission references below. Immediate Effect: Marker changes immediately affect clearance assessments and worklist routing." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Manage Account Markers" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: PPR Admin sets or clears account-level markers on educator. When: Administrative decision requires heightened oversight or processing restrictions. Who: User with marker-specific permissions (PPR Admin or Credentialing Admin)." .

<urn:solutiondesign:instance:profpractices:Seq_ProcessNasdtecNightlyBatch> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    participant Scheduler as Job Scheduler\n    participant PPRService as PPR Service\n    participant NASDTEC as NASDTEC API\n    participant MiKey as Mi-Key API\n    participant EventBus as Event Bus\n\n    Scheduler->>PPRService: Trigger nightly NASDTEC batch\n\n    PPRService->>NASDTEC: GET /v1/clearinghouse/people?currmonth=YYYYMM\n    NASDTEC-->>PPRService: List of educators with TransactionDate in current month\n\n    Note over PPRService: Response includes:<br/>- LastName, FirstName, MiddleName, SuffixName<br/>- BirthDate<br/>- CertificationID (SSN)<br/>- Jurisdiction<br/>- TransactionDate<br/>- ClearinghouseId<br/>- ClearinghouseUrl\n\n    loop For each record in response\n        PPRService->>PPRService: Check if already processed (ClearinghouseId)\n\n        alt Not already processed\n            PPRService->>MiKey: POST /match-person (CertificationID/SSN, BirthDate, Name)\n            MiKey-->>PPRService: Unique ID match\n\n            alt Match found\n                PPRService->>PPRService: Create ExternalBackgroundCheck aggregate\n                Note over PPRService: CheckSource: NASDTEC<br/>State: Received<br/>RequiresReview: true\n\n                PPRService->>PPRService: Store NASDTEC record locally\n                Note over PPRService: Fields: LastName, FirstName, BirthDate,<br/>CertificationID, Jurisdiction,<br/>ClearinghouseId, ClearinghouseUrl\n\n                PPRService->>PPRService: Route to PPR worklist\n\n                PPRService--)EventBus: NASDTECRecordMatched\n\n            else No match found\n                PPRService->>PPRService: Log unmatched record\n                Note over PPRService: Store for manual review if needed\n            end\n        end\n    end\n\n    PPRService->>PPRService: Generate batch summary report\n    Note over PPRService: Report: {total records, matched, unmatched, errors}\n\n    PPRService-->>Scheduler: Batch complete\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "NASDTEC API unavailable > Retry with exponential backoff, alert admin if persistent failure. Mi-Key API unavailable > Skip person matching, log for manual follow-up. Malformed API response > Log error, skip record." ;
	<urn:solutiondesign:ontology:eventsPublished> "NASDTECRecordMatched - One per successful match." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Incremental Pull: Pull currmonth nightly to get recent transactions. Local Storage: NASDTEC records stored locally for search/reference. Person Matching: Use CertificationID (SSN) + BirthDate + Name to match via Mi-Key. Duplicate Prevention: Check ClearinghouseId to avoid re-processing same record." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Process NASDTEC Nightly Batch" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Scheduled job pulls data from NASDTEC API and matches to Michigan educators. When: Nightly at configured time (e.g., 2:00 AM). Who: System (scheduled job)." .

<urn:solutiondesign:instance:profpractices:Seq_ReceiveRapBackNotification> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor RapBack as Rap Back System (MSP)\n    participant Webhook as PPR Webhook Endpoint\n    participant PPRService as PPR Service\n    participant MiKey as Mi-Key API\n    participant EventBus as Event Bus\n\n    RapBack->>Webhook: POST /webhooks/rapback (notification payload)\n    Note over RapBack,Webhook: Payload includes:<br/>- TCN (Transaction Control Number)<br/>- NotificationDate<br/>- JudicialMarker<br/>- PIC (Person Identifier) [optional]\n\n    Webhook->>PPRService: Process Rap Back notification\n\n    alt PIC field is empty\n        PPRService->>MiKey: POST /match-person (SSN, DOB, Name)\n        MiKey-->>PPRService: Unique ID match\n\n        alt No match found\n            PPRService->>PPRService: Log unmatched notification\n            Note over PPRService: Cannot create disclosure without educator match\n            PPRService-->>Webhook: 200 OK (acknowledged but unmatched)\n        end\n    else PIC field populated\n        Note over PPRService: Use PIC to identify educator\n    end\n\n    PPRService->>PPRService: Create ExternalBackgroundCheck aggregate\n    Note over PPRService: CheckSource: RapBack<br/>State: Received<br/>RequiresEducatorResponse: true\n\n    PPRService->>PPRService: Create placeholder Disclosure aggregate\n    Note over PPRService: SourceType: RapBackTriggered<br/>State: Under PPR Review<br/>Description: \"Pending educator response\"\n\n    PPRService->>PPRService: Route disclosure to OEE worklist\n\n    PPRService--)EventBus: RapBackNotificationReceived\n    PPRService--)EventBus: DisclosureSubmitted\n    PPRService--)EventBus: DisclosureRoutedToWorklist\n    PPRService--)EventBus: PPRClearanceAssessmentChanged\n\n    PPRService-->>Webhook: 200 OK\n    Webhook-->>RapBack: Acknowledgment\n\n    Note over EventBus: Communications consumes events:<br/>- Sends email to educator requiring response<br/>- Alerts PPR staff of new notification\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Person match fails > Log unmatched notification, return 200 OK (acknowledge receipt). Duplicate notification (same TCN) > Update existing record, do not create duplicate." ;
	<urn:solutiondesign:ontology:eventsPublished> "RapBackNotificationReceived - External data received. DisclosureSubmitted - Placeholder disclosure created. DisclosureRoutedToWorklist - Routed to OEE for review. PPRClearanceAssessmentChanged - Active disclosure affects clearance." ;
	<urn:solutiondesign:ontology:initiatedBy> "external-system" ;
	<urn:solutiondesign:ontology:keyDecisions> "Person Matching: If PIC empty, use Mi-Key to match SSN+DOB+Name to Unique ID. Placeholder Disclosure: System creates disclosure requiring educator to provide details. Automatic Routing: Routes to OEE worklist for initial review." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Receive Rap Back Notification" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: External Rap Back system sends notification of new criminal activity via webhook. When: Michigan State Police detects new arrest or prosecution for enrolled educator. Who: External system (MSP Rap Back)." .

<urn:solutiondesign:instance:profpractices:Seq_RetrieveFullRapSheet> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Reviewer\n    participant WorklistUI as Worklist UI\n    participant PPRService as PPR Service\n    participant CHRISS as CHRISS SOAP API\n\n    Reviewer->>WorklistUI: Review Rap Back notification\n    WorklistUI->>PPRService: GET /external-checks/{id}\n    PPRService-->>WorklistUI: Rap Back metadata (TCN, judicial marker)\n\n    Reviewer->>WorklistUI: Click \"View Full Rap Sheet\"\n    WorklistUI->>PPRService: POST /rapback/retrieve-rapsheet\n\n    PPRService->>CHRISS: SOAP call: GET_RAPBACK (TCN)\n    CHRISS-->>PPRService: Full rap sheet text\n\n    Note over PPRService: **CRITICAL: Rap sheet content<br/>is NEVER stored in database**\n\n    PPRService->>PPRService: Log retrieval action in ExternalBackgroundCheck\n    Note over PPRService: RapSheetRetrievalLog: {user, timestamp}\n\n    PPRService-->>WorklistUI: Rap sheet text (transient)\n    WorklistUI-->>Reviewer: Display rap sheet in modal (read-only)\n\n    Note over Reviewer,WorklistUI: Reviewer reviews details,<br/>makes notes in disclosure remarks,<br/>updates disclosure status\n\n    Note over WorklistUI: When modal closed,<br/>rap sheet content discarded from memory\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "CHRISS API unavailable > Display error, allow retry. Invalid TCN > Display error message from CHRISS. Network timeout > Display error, suggest contacting support." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (audit log entry only)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Display-Only: Rap sheet is NEVER persisted; only displayed transiently. Audit Logging: System logs the fact that retrieval occurred (who, when) but not content. On-Demand: Retrieval only happens when reviewer explicitly requests it." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Retrieve Full Rap Sheet for Review" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: PPR reviewer initiates on-demand retrieval of complete rap sheet from CHRISS. When: Reviewer needs detailed criminal history beyond notification metadata. Who: User with profpractice.rapsheet.retrieve permission (source header names 'profpractice.rapback.retrieve-rapsheet', which does not exist in profpractice-permissions.md — see that permission's own notes)." .

<urn:solutiondesign:instance:profpractices:Seq_ReviewDisclosureAndUpdateStatus> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Reviewer\n    participant WorklistUI as Worklist UI\n    participant PPRService as PPR Service\n    participant DocService as Document Service\n    participant EventBus as Event Bus\n\n    Reviewer->>WorklistUI: View assigned worklist\n    WorklistUI->>PPRService: GET /worklists/{worklistId}/disclosures\n    PPRService-->>WorklistUI: Queued disclosures\n\n    Reviewer->>WorklistUI: Select disclosure to review\n    WorklistUI->>PPRService: GET /disclosures/{id}\n    PPRService-->>WorklistUI: Disclosure details\n\n    WorklistUI->>DocService: GET /documents?disclosureId={id}\n    DocService-->>WorklistUI: Supporting documents\n\n    Note over Reviewer,WorklistUI: Reviewer examines:<br/>- Conviction details<br/>- Court documents<br/>- Prior disclosure history\n\n    alt Need to edit disclosure details\n        Reviewer->>WorklistUI: Edit conviction date, type, or description\n        WorklistUI->>PPRService: PUT /disclosures/{id}\n        PPRService->>PPRService: Update Disclosure aggregate\n        Note over PPRService: Only allowed while status = \"Under PPR Review\"\n        PPRService-->>WorklistUI: Updated\n    end\n\n    Reviewer->>WorklistUI: Add internal remarks (staff notes)\n    WorklistUI->>PPRService: POST /disclosures/{id}/remarks\n    PPRService->>PPRService: Add InternalRemarks\n    PPRService-->>WorklistUI: Remarks saved\n\n    Reviewer->>WorklistUI: Update disclosure status\n    WorklistUI-->>Reviewer: Display available status transitions\n\n    Reviewer->>WorklistUI: Select new status (e.g., \"Reviewed - Misdemeanor\")\n    WorklistUI->>PPRService: PUT /disclosures/{id}/status\n\n    PPRService->>PPRService: Validate status transition\n    PPRService->>PPRService: Update Disclosure aggregate\n    Note over PPRService: Previous: Under PPR Review<br/>New: Reviewed - Misdemeanor\n\n    PPRService--)EventBus: DisclosureStatusChanged\n    PPRService--)EventBus: DisclosureReviewCompleted (if \"Reviewed\" status)\n    PPRService--)EventBus: PPRClearanceAssessmentChanged\n\n    PPRService-->>WorklistUI: Status updated\n    WorklistUI-->>Reviewer: Confirmation\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Invalid status transition > Validation error. Attempt to edit finalized disclosure > Access denied (must revert first)." ;
	<urn:solutiondesign:ontology:eventsPublished> "DisclosureStatusChanged - Status transition recorded. DisclosureReviewCompleted - Finalization to \"Reviewed\" status. PPRClearanceAssessmentChanged - Triggers re-evaluation in Credentialing/Staffing domains." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Edit Window: Can only edit disclosure details while status = \"Under PPR Review\". Status Transitions: Must follow valid workflow paths (e.g., cannot go directly from \"Pending Review\" to \"Reviewed - Felony\"). Assessment Recalculation: Status changes trigger clearance assessment recalculation." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Review Disclosure and Update Status" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: PPR staff reviews disclosure details and updates status through workflow. When: Disclosure appears in reviewer's worklist. Who: User with profpractice.status.update permission assigned to worklist (source header names 'profpractice.disclosure.update-status', which does not exist in profpractice-permissions.md — see that permission's own notes)." .

<urn:solutiondesign:instance:profpractices:Seq_ReviewNasdtecDisciplinaryRecord> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Reviewer\n    participant WorklistUI as Worklist UI\n    participant PPRService as PPR Service\n    participant EventBus as Event Bus\n\n    Reviewer->>WorklistUI: View NASDTEC worklist\n    WorklistUI->>PPRService: GET /worklists/{worklistId}/external-checks?source=NASDTEC\n    PPRService-->>WorklistUI: NASDTEC records requiring review\n\n    Reviewer->>WorklistUI: Select NASDTEC record to review\n    WorklistUI->>PPRService: GET /external-checks/{id}\n    PPRService-->>WorklistUI: NASDTEC record details\n\n    Note over WorklistUI: Display:<br/>- Educator name, DOB<br/>- Jurisdiction (state)<br/>- TransactionDate<br/>- ClearinghouseId<br/>- ClearinghouseUrl\n\n    Reviewer->>WorklistUI: Click ClearinghouseUrl link\n    Note over Reviewer: Opens NASDTEC clearinghouse site<br/>in new browser tab/window<br/>Views full disciplinary details externally\n\n    Note over Reviewer: Reviewer examines:<br/>- Type of disciplinary action<br/>- Reason for action<br/>- Severity and dates<br/>- Current status\n\n    Reviewer->>WorklistUI: Return to system, add internal remarks\n    WorklistUI->>PPRService: POST /external-checks/{id}/remarks\n    PPRService->>PPRService: Add reviewer notes to ExternalBackgroundCheck\n    PPRService-->>WorklistUI: Remarks saved\n\n    alt Create Michigan disclosure from NASDTEC finding\n        Reviewer->>WorklistUI: Click \"Create Disclosure from NASDTEC Record\"\n        WorklistUI->>PPRService: POST /disclosures/from-nasdtec\n\n        PPRService->>PPRService: Create Disclosure aggregate\n        Note over PPRService: SourceType: NASDTECTriggered<br/>State: Under PPR Review<br/>Description: Summary from NASDTEC\n\n        PPRService->>PPRService: Link disclosure to ExternalBackgroundCheck\n\n        PPRService--)EventBus: DisclosureSubmitted\n        PPRService--)EventBus: PPRClearanceAssessmentChanged\n\n        PPRService-->>WorklistUI: Disclosure created\n\n        Note over Reviewer: Disclosure now appears in standard<br/>disclosure worklist for full review\n\n    else No action required\n        Reviewer->>WorklistUI: Update NASDTEC record status to \"Reviewed - No Action\"\n        WorklistUI->>PPRService: PUT /external-checks/{id}/status\n\n        PPRService->>PPRService: Update ExternalBackgroundCheck aggregate\n        Note over PPRService: State: Reviewed - No Action\n\n        PPRService-->>WorklistUI: Status updated\n    end\n\n    WorklistUI-->>Reviewer: Confirmation\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "ClearinghouseUrl inaccessible > Display error, suggest manual follow-up. Educator match no longer valid > Log issue, flag for admin review." ;
	<urn:solutiondesign:ontology:eventsPublished> "DisclosureSubmitted - If disclosure created from NASDTEC record. PPRClearanceAssessmentChanged - If disclosure created." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "External Review: Full disciplinary details viewed on NASDTEC site, not in MiEdWorkforce. Disclosure Creation: Reviewer decides whether NASDTEC finding warrants Michigan disclosure. Link Preservation: Disclosure remains linked to original NASDTEC record for audit trail." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Review NASDTEC Disciplinary Record" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: PPR reviewer examines out-of-state disciplinary action and determines impact on Michigan credentials. When: NASDTEC record appears in worklist after nightly batch matching. Who: User with profpractice.disclosure.view permission assigned to worklist." .

<urn:solutiondesign:instance:profpractices:Seq_SubmitPPRResponse> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Educator\n    participant UI as PPR UI\n    participant PPRService as PPR Service\n    participant DocService as Document Service\n    participant EventBus as Event Bus\n\n    Educator->>UI: Navigate to \"Complete Annual PPR\"\n    UI->>PPRService: GET /ppr-questions\n    PPRService-->>UI: Current PPR question configuration\n\n    Educator->>UI: Answer all mandatory questions\n    Note over Educator,UI: Questions include:<br/>- New criminal convictions?<br/>- New disciplinary actions?<br/>- Pending charges?\n\n    alt Any answer is \"Yes\"\n        UI-->>Educator: Display disclosure detail forms\n\n        Educator->>UI: Enter details for each \"Yes\" answer\n        Educator->>UI: Upload supporting documents\n        UI->>DocService: POST /upload\n        DocService-->>UI: Document IDs\n    end\n\n    Educator->>UI: Submit PPR response\n    UI->>PPRService: POST /ppr-responses\n\n    PPRService->>PPRService: Create ProfessionalPracticeResponse aggregate\n    Note over PPRService: State: Pending Review\n    Note over PPRService: ResponseDate: Current timestamp\n\n    alt New disclosures reported (any \"Yes\" answers)\n        loop For each \"Yes\" answer\n            PPRService->>PPRService: Create Disclosure aggregate\n            Note over PPRService: SourceType: PPRResponse\n            Note over PPRService: State: Pending Review\n\n            PPRService->>PPRService: Route disclosure to OEE worklist\n            PPRService--)EventBus: DisclosureSubmitted\n            PPRService--)EventBus: DisclosureRoutedToWorklist\n        end\n\n        PPRService->>PPRService: Link disclosures to response\n        Note over PPRService: Response: NewDisclosuresReported = true\n    else All \"No\" answers\n        Note over PPRService: Response: NewDisclosuresReported = false\n        Note over PPRService: Response: ResponseStatus = No Review Needed\n    end\n\n    PPRService->>PPRService: Update EducatorPPRStatus.LastPPRResponseDate\n\n    PPRService--)EventBus: PPRResponseSubmitted\n\n    PPRService-->>UI: Response ID\n    UI-->>Educator: Confirmation - compliance updated\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Not all mandatory questions answered > Block submission. \"Yes\" answer without supporting details > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "PPRResponseSubmitted - Records compliance activity. DisclosureSubmitted - One per new disclosure. DisclosureRoutedToWorklist - One per new disclosure." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Disclosure Creation: System automatically creates Disclosure records for each \"Yes\" answer. Compliance Tracking: LastPPRResponseDate updated regardless of whether new disclosures reported. Routing: New disclosures route to OEE worklist same as self-disclosures." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Submit Professional Practice Review Response" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Educator completes annual PPR compliance check, potentially reporting new disclosures. When: Annual PPR due date approaching or past due. Who: Authenticated educator." .

<urn:solutiondesign:instance:profpractices:Seq_SubmitSelfDisclosure> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Educator\n    participant UI as PPR UI\n    participant PPRService as PPR Service\n    participant DocService as Document Service\n    participant EventBus as Event Bus\n\n    Educator->>UI: Navigate to \"Report Disclosure\"\n    UI->>PPRService: GET /disclosure-questions\n    PPRService-->>UI: Disclosure question configuration\n\n    Educator->>UI: Select disclosure type (Misdemeanor/Felony/Disciplinary)\n    UI-->>Educator: Display type-specific questions\n\n    Educator->>UI: Enter conviction date, description\n    Educator->>UI: Upload supporting documents (court orders, etc.)\n    UI->>DocService: POST /upload\n    DocService-->>UI: Document IDs\n\n    Educator->>UI: Submit disclosure\n    UI->>PPRService: POST /disclosures\n\n    PPRService->>PPRService: Create Disclosure aggregate\n    Note over PPRService: State: Pending Review\n    Note over PPRService: SourceType: SelfDisclosed\n\n    PPRService->>PPRService: Route to OEE worklist based on type\n\n    PPRService--)EventBus: DisclosureSubmitted\n    PPRService--)EventBus: DisclosureRoutedToWorklist\n\n    PPRService-->>UI: Disclosure ID\n    UI-->>Educator: Confirmation - under review\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "No documents attached > Block submission, require at least one document. Conviction date in future > Validation error. Description exceeds 5000 characters > Validation error." ;
	<urn:solutiondesign:ontology:eventsPublished> "DisclosureSubmitted - Triggers communications to educator and PPR staff. DisclosureRoutedToWorklist - Recorded for audit; routing/queue placement itself is handled synchronously by the PPRWorklist aggregate, not a downstream capability." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Document Requirements: At least one supporting document required for self-disclosures. Automatic Routing: System routes to OEE worklist based on disclosure type. Conviction Date: Cannot be future-dated." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "Submit Self-Disclosure" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Educator voluntarily reports a new criminal conviction or professional disciplinary action. When: Educator receives conviction or disciplinary action and must report within required timeframe. Who: Authenticated educator." .

<urn:solutiondesign:instance:profpractices:Seq_ViewDisclosureHistory> a <urn:solutiondesign:ontology:Sequence> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:content> "sequenceDiagram\n    actor Educator\n    participant UI as PPR UI\n    participant PPRService as PPR Service\n    participant DocService as Document Service\n\n    Educator->>UI: Navigate to \"My Disclosure History\"\n    UI->>PPRService: GET /educators/{id}/disclosures\n    PPRService-->>UI: All disclosures (self-disclosed, PPR responses, Rap Back, NASDTEC)\n\n    Note over UI: Display table:<br/>- Date Reported<br/>- Disclosure Type<br/>- Conviction Date<br/>- Status<br/>- Source (Self/PPR/RapBack/NASDTEC)\n\n    Educator->>UI: Select disclosure to view details\n    UI->>PPRService: GET /disclosures/{id}\n    PPRService-->>UI: Full disclosure details\n\n    UI->>DocService: GET /documents?disclosureId={id}\n    DocService-->>UI: Supporting documents\n\n    UI-->>Educator: Display disclosure details with documents\n\n    Note over Educator,UI: Educator can:<br/>- View status history<br/>- Download supporting documents<br/>- See external remarks (if any)<br/>- Print disclosure record\n" ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:SequencesDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "No disclosures on file > Display message indicating no history. Disclosure not found > Display error." ;
	<urn:solutiondesign:ontology:eventsPublished> "None (or optional audit log entry)." ;
	<urn:solutiondesign:ontology:initiatedBy> "user" ;
	<urn:solutiondesign:ontology:keyDecisions> "Self-Only: Educators can only view their own disclosures. Read-Only: Cannot edit finalized disclosures; must contact PPR for corrections. External Remarks Visibility: External remarks may be visible to educator; internal remarks are not." ;
	<urn:solutiondesign:ontology:status> "confirmed" ;
	<urn:solutiondesign:ontology:title> "View Disclosure History" ;
	<urn:solutiondesign:ontology:whatWhenWho> "What: Educator views their complete disclosure history with status details. When: Educator wants to review past submissions and outcomes. Who: Authenticated educator." .

<urn:solutiondesign:instance:profpractices:SequencesDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "sequences" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/profpractice/profpractice-sequences.md" .

<urn:solutiondesign:instance:profpractices:UT_Disclosure> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A report of a criminal history event (misdemeanor, felony) or professional disciplinary action submitted by an educator or discovered through background checks." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Disclosure" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> .

<urn:solutiondesign:instance:profpractices:UT_MandatoryHoldRequirement> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Account-level marker indicating that all future credential applications must be placed in \"PPR Hold\" status upon submission, requiring manual review before processing can continue." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Mandatory Hold Requirement" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> .

<urn:solutiondesign:instance:profpractices:UT_NASDTEC> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "National Association of State Directors of Teacher Education and Certification — interstate clearinghouse for educator discipline and misconduct." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "NASDTEC" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> .

<urn:solutiondesign:instance:profpractices:UT_PPR> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A periodic compliance check where educators must affirm or update their disclosure status by answering standardized questions." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Professional Practice Review (PPR)" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:ProfessionalPracticeResponseAggregate> .

<urn:solutiondesign:instance:profpractices:UT_PPRClearanceAssessment> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Calculated outcome from PPR domain indicating whether an educator has any PPR-related concerns affecting credential applications. Provides PPR-specific clearance information to Credentialing. Computed on-demand from current disclosure statuses and account-level markers, never cached or stored." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "PPR Clearance Assessment" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:PPRClearanceAssessment> .

<urn:solutiondesign:instance:profpractices:UT_RapBackCHRISS> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Record of Arrest and Prosecution Background check service managed by Michigan State Police. Provides both push notifications when new criminal activity occurs (Rap Back) and on-demand pull of full criminal history reports (rap sheets via CHRISS SOAP API). Rap sheets are display-only and never stored in MiEdWorkforce." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Rap Back / CHRISS" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> .

<urn:solutiondesign:instance:profpractices:UT_RosterEligibilityAssessment> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "Calculated outcome from PPR domain indicating whether an educator has any PPR-related restrictions on employment. Provides PPR-specific eligibility information to Staffing. Computed on-demand from disclosure statuses and markers." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Roster Eligibility Assessment" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:RosterEligibilityAssessment> .

<urn:solutiondesign:instance:profpractices:UT_SelfDisclosure> a <urn:solutiondesign:ontology:UbiquitousTerm> ;
	<http://www.w3.org/2004/02/skos/core#definition> "A voluntary report submitted by a citizen user documenting a new criminal conviction or professional disciplinary action." ;
	<http://www.w3.org/2004/02/skos/core#prefLabel> "Self-Disclosure" ;
	<urn:solutiondesign:ontology:describesConcept> <urn:solutiondesign:instance:profpractices:DisclosureAggregate> .

<urn:solutiondesign:instance:profpractices:Wireframe1> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Professional Practice questions' form — two Yes/No misdemeanor/felony questions, an inline conviction table (Type/Conviction Date/Description) with edit/delete icons, a second 'Regarding any professional credentials...' block (suspended/revoked, surrendered/nullified, pending action questions) with its own conviction table, Cancel/Save actions. Matches the Business-Specifications-section Annual PPR Review question set (9.1.3) closely, including the exact question wording." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Rapbacks search' page. Filter fields: TCN, SID, Offense Type (dropdown), Segment (dropdown), First Name, Last Name, Action(s) Taken (checkboxes: Ready to Process/Notified School District/Referred to Professional Practice Review/Notified MSP for Removal/No Action Required — note this wireframe still shows the pre-rename 'No Action Required' label, not the corrected 'No Referral Required' from comment 7/11/12), Employment/Credential Checks (Is Employed?/Has Credential? checkboxes). Results table columns: TCN (hyperlink)/SID/Last name/First name/DOB/Unique ID/Matched on SSN?/Received/Has Credential?/Is Employed?/Requesting Agency/School District/Action Taken, with row checkboxes, a Download dropdown, Page Size control, and pagination ('1-10 of 6115 items' — confirms this is expected to be a high-volume dataset, relevant to 30.3's bulk-processing rationale). A bulk 'Action Taken' dropdown + Save/Cancel appears below the table for the checked rows. Direct visual confirmation of 30.1.2, 30.3.1, and the synthetic search/filter and identity-matching-status display gaps." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/09-professional-practices/wireframes/wireframe-01-annual-ppr-review-questions.png" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/30-rapbacks/wireframes/wireframe-01-rapbacks-search.png" .

<urn:solutiondesign:instance:profpractices:Wireframe2> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Rapbacks Record Detail' page. Left panel: identity header (Name/DOB/SSN/TCN/SID), Employment Status + 'Employment History' link, Credential Status + 'Credential History' link, a Status radio group (Ready to Process/No Action Required [pre-rename label again]/Actions Taken, with sub-checkboxes Notified School District/Referred to Professional Practices Review/Notified MSP for Removal), an Aliases table (Name/DOB/SSN, delete icon, '+ Add Alias' — see Wireframe3), and a Notes list (author/date, edit/delete icons per note, free-text body). Right panel: 'Rapsheet Details' — a monospace-styled block of raw MSP/CHRISS text (matches the CHRISS interface doc's own 'reply should be treated as unformatted text, best presented in a window with monospace font' instruction verbatim). Direct visual confirmation of 30.2.1/30.2.2 (rap sheet display), 30.4.2 (notes with edit capability — corroborates the still-open 'can notes be edited' review question), 30.6.1-30.6.3 (status/action radio group), 30.8.1/30.8.2 (aliases table)." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Uploaded Documents' table (File name/Description/uploaded by/Date/Size, edit+delete icons per row) plus an 'Upload Additional Documents' panel (Browse/Upload, 1MB max for PDF files stated inline). Corroborates 9.1.1's upload/delete-before-submission acceptance criteria and Rule_AttachmentManagement's soft-delete framing." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/09-professional-practices/wireframes/wireframe-02-uploaded-documents.png" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/30-rapbacks/wireframes/wireframe-02-rapback-record-detail.png" .

<urn:solutiondesign:instance:profpractices:Wireframe3> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Add Alias' form — First Name, Last Name, Date of Birth, SSN fields plus Cancel/Add buttons. Direct confirmation of 30.8.1's field-level shape." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: reviewer-facing 'Professional Practices Review' detail screen for one educator (Name/Unique ID/SSN/Gender header, prior-conviction table with MDE Remarks column, credential-suspension/surrender/pending-action Yes/No block), an Action dropdown pre-populated with the full disclosure status list (PPR Hold, PPR Document Hold, Reviewed - Felony/Listed/No Action Required/Non-Enumerated/Misdemeanor/Arraignment) matching profp:DiscState_* one-for-one, PPR Admin Flag and PPR Additional Review Flag toggles shown directly on this same screen (not a separate profile page), and External Remarks (labelled 'visible to the educator') / Internal Remarks fields side by side. Direct visual confirmation of 9.3.1's Actions dropdown and 9.3.5's flag-toggle placement — see Req_09_3_5's own notes on the still-open 'where do these flags actually live' review thread, since this wireframe answers it one way (inline on the disclosure record) while the comment thread treats that as unresolved." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/09-professional-practices/wireframes/wireframe-03-ppr-reviewer-detail-flags.png" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/30-rapbacks/wireframes/wireframe-03-add-alias.png" .

<urn:solutiondesign:instance:profpractices:Wireframe4> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd30Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'My Disclosure History' citizen-facing screen, Responses/Disclosures tabs, a search box, and both a filter icon and a download icon in the table's top-right corner. Table columns shown (Submission Date/Type/New Disclosures/Status) match 9.1.4's Responses-tab column list. Direct visual confirmation that 9.1.4 (view history), 9.1.5 (download), and 9.1.6 (filter) are three facets of this one screen, not three separate screens." ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: a tighter crop of the same Aliases table already visible in Wireframe2 (Name/DOB/SSN + delete icon) — this is a cropped detail of part of Wireframe2's screen, not an independent screen, the same relationship FDD 29's Wireframe10/Wireframe1 pair had." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/09-professional-practices/wireframes/wireframe-04-my-disclosure-history.png" ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/30-rapbacks/wireframes/wireframe-04-aliases-table.png" .

<urn:solutiondesign:instance:profpractices:Wireframe5> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Professional Practice Review' worklist, Unresolved/Resolved tabs, search-by-name-or-ID, filter and download icons, and a results table whose Type column shows 'Yearly', 'Disclosure', and 'Rapback' values across different rows for the SAME columns (Application #/Name/Unique ID/Certificate Type/Type/School District/Has Conviction?/Status). Direct visual confirmation of comment 136's point (the worklist spans self-disclosures, annual PPR responses, AND Rap Back records, not self-disclosures alone) and of 9.3.1's Unresolved/Resolved tab structure." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/09-professional-practices/wireframes/wireframe-05-ppr-review-worklist.png" .

<urn:solutiondesign:instance:profpractices:Wireframe6> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:Fdd09Doc> ;
	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: the admin hamburger menu listing 'Report Management' as its own top-level item, alongside 'Business Rules', 'Communication Management', 'Position Management', 'Credential Management', 'Questions Management', 'System Users & Roles', and 'System Reports' — none of them scoped under a 'Professional Practice' heading. Visual support (not proof) for this pass's read that Feature 9.5's report-catalog admin page is generic/cross-cutting UI chrome rather than a PPR-specific build item — see the Feature 9.5 cross-domain note in this file's header." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/09-professional-practices/wireframes/wireframe-06-admin-hamburger-menu.png" .

<urn:solutiondesign:instance:profpractices:WorklistAssignedReviewers> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "PPR staff authorized to work items in this queue." ;
	<urn:solutiondesign:ontology:name> "AssignedReviewers" .

<urn:solutiondesign:instance:profpractices:WorklistFilterConfiguration> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Available filter options (status, date ranges, disclosure type)." ;
