	<urn:solutiondesign:ontology:path> "/credential-definitions/{definitionId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:credentialing:CredentialDefinitionVersion> ;
	<urn:solutiondesign:ontology:projection> "Response is just the new versionId — creates a new sd:CredentialDefinitionVersion rather than mutating the existing definition, per the Credential Definition Versioning business rule." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Update credential definition (admin)" ;
	<urn:solutiondesign:ontology:tags> "Definitions" .

