<urn:solutiondesign:instance:staffing:CollectionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Manages the data collection lifecycle for a school year, tracking submission requirements, quality review, and certification status." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:CollectionCertifiedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:CollectionOpenedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:CollectionDefinition> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:QualityReviewResult> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:CollectionState_AwaitingJustification> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:CollectionState_Certified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:CollectionState_InProgress> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:CollectionState_Open> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:CollectionState_Pending> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:CollectionState_QualityReview> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:CollectionState_Reopened> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:CategoryRequirement> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:CertificationAttestation> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:CollectionStatus> ;
	<urn:solutiondesign:ontology:invariants> "Collection cannot be certified with any Error-status records. All pre-certification tasks must be complete before certification allowed. Quality review must be run before certification. Required justifications must be provided for specific error conditions. Attestation agreement required for certification. Collection date ranges cannot overlap for same entity type. Certification period must fall within collection open/close dates." ;
	<urn:solutiondesign:ontology:rootEntity> "Collection" .

<urn:solutiondesign:instance:staffing:CollectionCertifiedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "entityCode, collectionType, schoolYear, certificationTimestamp, certifyingUserId" ;
	<urn:solutiondesign:ontology:trigger> "District certifies roster data" .

<urn:solutiondesign:instance:staffing:CollectionDefinition> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Name, school year dates, entity types, certification period." ;
	<urn:solutiondesign:ontology:name> "CollectionDefinition" .

<urn:solutiondesign:instance:staffing:CollectionExceptionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:staffing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Manages requests to allow data submission and certification past legislative deadlines for specific districts and collection periods." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:CollectionExceptionApprovedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:CollectionExceptionDeniedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:staffing:CollectionExceptionRequestedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:staffing:ExceptionRequest> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:ExceptionState_Approved> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:ExceptionState_Denied> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:staffing:ExceptionState_Pending> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:staffing:ExceptionStatus> ;
	<urn:solutiondesign:ontology:invariants> "Exception request can only be submitted after collection deadline has passed. Exception must specify district, collection type, and justification. Approval required before collection reopening allowed. Exception date range must be future-dated from request submission." ;
	<urn:solutiondesign:ontology:rootEntity> "CollectionException" .

<urn:solutiondesign:instance:staffing:CollectionExceptionApprovedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:notes> "Not in staffing-domain.md's Domain Events table; only appears in the 'Request Collection Exception' sequence." ;
