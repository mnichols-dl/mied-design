	<urn:solutiondesign:ontology:hasScope> <urn:solutiondesign:instance:shared:scope:ISD> ;
	<urn:solutiondesign:ontology:notes> "ISD Auditor reviews constituent district submissions ('ISD/RESA Entity' scope)." ;
	<urn:solutiondesign:ontology:permissionId> "staffing.audit.review-submission" .

<urn:solutiondesign:instance:staffing:Perm_AuditSubmitFinding> a <urn:solutiondesign:ontology:Permission> ;
