	<urn:solutiondesign:ontology:notes> "Covers Features 21.1-21.6 (document's own subtitle: 'Data Collection & Compliance- Employee Roster (21.1-21.6)'). Author Caitlin Groom (CEPI); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/04/2025 per the signoff table — but comments.xml contains dated entries through 2026-03-10, well after that nominal signoff date, meaning the document continued to be actively revised/reviewed after its approval date (same pattern already flagged in the FDD 29 review pass for its own signoff table)." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/21 - Data Collection & Compliance - Roster of Employees/21 - Collection & Compliance - Employee Roster.docx" .

<urn:solutiondesign:instance:staffing:Fdd22CompanionDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers TWO FDDs' worth of content: Feature 21.7 (Employee Audit — an FDD-21 concern, deliberately NOT modeled in this file, left for FDD 21's own review pass per this session's scope) and Feature 22.6 (Appropriate Placement Audit — modeled below, Req_22_6_1 through Req_22_6_5). Same approver pair (Dontje/Groom), signed 08/04/2025; comments.xml runs through 2026-04-28, again well past nominal signoff." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/22 - Data Collection & Compliance - Employee Assignment Details/21.7; 22.6 - Collection & Compliance - Employee and Appropriate Placement Audit.docx" .

<urn:solutiondesign:instance:staffing:Fdd22Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 22.1-22.5 (document subtitle: 'Data Collection & Compliance- Employee Assignment Details (22.1-22.5)'). Author Caitlin Groom (CEPI); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/05/2025 per the signoff table — but comments.xml contains entries dated through 2026-04-01, well after that signoff date, meaning the document continued to be actively revised/discussed after its nominal approval, same pattern FDD 29's own header noted for its document." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/22 - Data Collection & Compliance - Employee Assignment Details/22 - Collection & Compliance - Employee Assignment Details.docx" .

<urn:solutiondesign:instance:staffing:Fdd24Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Author Caitlin Groom (CEPI); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/05/2025. comments.xml carries two later dated entries (2025-12-04, 2026-02-03) — a stale-SharePoint-link fix and a scope-clarification exchange on Feature 24.4 (see Question_BulkUpdateAndDirectMiKeyApiScopeUndefined) — so, as with FDD 29, the signoff date isn't 'nothing changed after this.'" ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/24 - Data Collection & Compliance - Request for ID Collection/24 - Collection & Compliance - Request for ID.docx" .

<urn:solutiondesign:instance:staffing:GetEmployeeOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "CONFIRMED GAP (cross-domain consistency pass): staffing is now really converted in abox/mied-v3/staffing/staffing-api.ttl, and it exposes no single 'get employee + position + district' projection for template variable resolution. The closest real operation is staff:Op_GetEmployeeDemographics (GET /employee-roster/{employeeId}/demographics), but that returns demographic data only — not the Position/District variable families this stub's payload also needs — so it is not a clean match and no rename was made." ;
	<urn:solutiondesign:ontology:path> "/api/staffing/employees/{id}" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Returns staffing record / roster data for variable resolution (path inferred from communications-capability.md's Dependencies table description, not shown literally as a concrete endpoint in any source doc)." .

<urn:solutiondesign:instance:staffing:LocalJobCategory> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Teacher, Principal, Counselor, etc." ;
	<urn:solutiondesign:ontology:name> "LocalJobCategory" .

<urn:solutiondesign:instance:staffing:LocalJobFunction> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Specific role within category (e.g., Social Worker under Student Support)." ;
	<urn:solutiondesign:ontology:name> "LocalJobFunction" .

<urn:solutiondesign:instance:staffing:NewTeacherMentorAssignedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "menteeUniqueId, mentorUniqueId?, mentorName, schoolYear" ;
	<urn:solutiondesign:ontology:trigger> "Mentor assigned to new teacher" .

<urn:solutiondesign:instance:staffing:NewTeacherMonitoring> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Mentorship assignment and SCECH tracking for educators in their first three years. mentor_verified becomes true once an entered mentor Unique ID resolves to a name for district confirmation via a name-lookup only (e.g. GET /educators/search) — distinct from the unrelated, still-unresolved permit-mentor credential check in credentialing-domain.md's 'Mentor Assignment Requirement for Permits' rule (see staff:Question_MentorVerificationEndpointDirection below)." ;
	<urn:solutiondesign:ontology:name> "NewTeacherMonitoring" .

<urn:solutiondesign:instance:staffing:Op_AddEmployee> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:EmployeeRecord> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Source lists x-access as [internal-user, external-client] — callable by district HR users via the portal or by external HR/SIS systems submitting on behalf of a district; internal-user recorded as primary (see file header). Triggers identity resolution via IAM's identity-resolution API synchronously; Staffing holds no matching logic of its own. May return 202 if near-match resolution is required." ;
	<urn:solutiondesign:ontology:operationId> "addEmployee" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/add-employee" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:EmployeeRecord> ;
	<urn:solutiondesign:ontology:projection> "Request carries demographics plus an optional pre-existing Unique ID (from a prior search); response may be 201 with the created record or 202 pending Near Match resolution." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Add new employee with Mi-Key ID assignment" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_ApproveCollectionException> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:ExceptionRequest> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Staffing Data Admin role only. Scope is not evaluated; this is a system-wide admin action. Updates the collection close date." ;
	<urn:solutiondesign:ontology:operationId> "approveCollectionException" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/admin/collection-exceptions/{requestId}/approve" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:ExceptionRequest> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Approve collection exception request" ;
	<urn:solutiondesign:ontology:tags> "Admin" .

<urn:solutiondesign:instance:staffing:Op_CancelDemographicsNearMatch> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Also invoked automatically by IAM if a Near Match is left unresolved past the configured timeout (exact timeframe unresolved — see iam:Question_NearMatchAutoCancelTimeframe in abox/mied-v3/iam/iam-domain.ttl). No equivalent IAM-side operation for this business-user path exists in iam-api.ttl's real, converted surface as of this pass — see staffing-domain.ttl's file header and staffing-sequences.ttl's corresponding SequenceReference for this gap." ;
	<urn:solutiondesign:ontology:operationId> "cancelDemographicsNearMatch" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/employee-roster/{employeeId}/demographics/cancel-near-match" ;
	<urn:solutiondesign:ontology:requestBodySchema> "{ requestId }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Cancel a Near Match returned during a demographics update" ;
	<urn:solutiondesign:ontology:tags> "EmployeeRoster" .

<urn:solutiondesign:instance:staffing:Op_CancelPosition> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:PositionStatus> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "DELETE" ;
	<urn:solutiondesign:ontology:notes> "Positions cannot be physically deleted; sets status to Cancelled and requires a cancellation reason. Only allowed before the position is established or certified." ;
	<urn:solutiondesign:ontology:operationId> "cancelPosition" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/positions/{positionId}" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:Position> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Cancel position (sets status to Cancelled)" ;
	<urn:solutiondesign:ontology:tags> "Positions" .

<urn:solutiondesign:instance:staffing:Op_CertifyCollection> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:CertificationAttestation> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Restricted to internal-user (no external-client) as attestation and e-signature require an identified district official. Triggers creation of an audit work item for the district's ISD/RESA entity." ;
	<urn:solutiondesign:ontology:operationId> "certifyCollection" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/collections/{collectionId}/certify" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:CollectionDefinition> ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Certify collection after attestation" ;
	<urn:solutiondesign:ontology:tags> "Collections" .

<urn:solutiondesign:instance:staffing:Op_CheckExceptionEligibility> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:operationId> "checkExceptionEligibility" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/collections/{collectionId}/exception-eligibility" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:CollectionDefinition> ;
	<urn:solutiondesign:ontology:projection> "Boolean-flag projection only: deadlinePassed, exceptionAvailable — not the full CollectionDefinition." ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Check if collection is eligible for exception request" ;
	<urn:solutiondesign:ontology:tags> "Collections" .

<urn:solutiondesign:instance:staffing:Op_CreateAssignment> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Requires that placement validation passes (credential/endorsement match)." ;
	<urn:solutiondesign:ontology:operationId> "createAssignment" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/assignments/create" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Create employee assignment to position" ;
	<urn:solutiondesign:ontology:tags> "Assignments" .

<urn:solutiondesign:instance:staffing:Op_CreateAssignmentWithJustification> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Restricted to internal-user only (no external-client) because justified placements require district accountability and attestation; external systems should surface these cases back to a district user for resolution." ;
	<urn:solutiondesign:ontology:operationId> "createAssignmentWithJustification" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:staffing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/assignments/create-with-justification" ;
	<urn:solutiondesign:ontology:producesShape> <urn:solutiondesign:instance:staffing:AssignmentDetail> ;
	<urn:solutiondesign:ontology:projection> "Adds justificationText (staff:CredentialErrorJustification) on top of AssignmentDetail's usual fields." ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Create assignment with credential error justification" ;
	<urn:solutiondesign:ontology:tags> "Assignments" .

