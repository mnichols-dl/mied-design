<urn:solutiondesign:instance:profpractices:Op_AddDisclosureRemark> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:DisclosureExternalRemarks> ;
	<urn:solutiondesign:ontology:consumesShape> <urn:solutiondesign:instance:profpractices:DisclosureInternalRemarks> ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
