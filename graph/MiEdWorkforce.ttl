<urn:solutiondesign:instance:communications:CommentAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:communications:CapabilityDoc> ;
	<urn:solutiondesign:ontology:description> "Manages text annotations on process items with visibility control and tracking of comment inclusion in outbound emails." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:communications:CommentCreatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:CommentEmailHistory> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:communications:PredefinedComment> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:CommentState_Created> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:CommentState_Deleted> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:CommentState_Modified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:communications:CommentState_SentInEmail> ;
	<urn:solutiondesign:ontology:invariants> "Comments must be associated with a process item (CredentialApplication, StaffingRecord, EPPEnrollment). Internal comments are never visible to external users. External comments are eligible for email inclusion but never automatically included — the user must explicitly select which ones to include. Comment visibility cannot be changed after creation if already sent in an email. Deleted comments remain in the audit trail but are hidden from the UI." ;
	<urn:solutiondesign:ontology:notes> "Scoping: unlike template/email-history permissions, Comment permissions ARE scoped to organizational hierarchy (Building/District/ISD, transitive) since comments are tied to specific business process items with organizational ownership." ;
	<urn:solutiondesign:ontology:rootEntity> "Comment" .

<urn:solutiondesign:instance:communications:CommentCreatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "comment_id, process_item_id, visibility" ;
	<urn:solutiondesign:ontology:publishedToTopic> "miedworkforce-domain-events" ;
	<urn:solutiondesign:ontology:trigger> "Comment added to process item" .

<urn:solutiondesign:instance:communications:CommentEmailHistory> a <urn:solutiondesign:ontology:DomainEntity> ;
