<urn:solutiondesign:instance:profpractices:Op_GetPprReportData> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-user" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "Escape hatch used deliberately: an ad-hoc aggregated-metrics payload spanning multiple report types (Disclosure Processing Metrics, Annual PPR Compliance Status, Review Timeline Analysis, Account Marker Summary, External Integration Status), matching the ontology's own example of a composite reporting payload that doesn't map to one entity. Rendered by external reporting platform (Power BI); this endpoint supplies the underlying aggregated data." ;
	<urn:solutiondesign:ontology:operationId> "getPprReportData" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:profpractices:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/reports/data" ;
	<urn:solutiondesign:ontology:responseSchema> "{ reportType: string, generatedAt: date-time, data: object (report-type-specific aggregated structure) }" ;
	<urn:solutiondesign:ontology:scopeSensitive> true ;
	<urn:solutiondesign:ontology:summary> "Get PPR report data" ;
	<urn:solutiondesign:ontology:tags> "Reports" .

