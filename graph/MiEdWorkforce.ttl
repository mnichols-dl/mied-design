<urn:solutiondesign:instance:iam:AuthorizationDeniedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "requestId, userId, deniedRoles[], scope, approverId, denialReason, deniedAt" ;
