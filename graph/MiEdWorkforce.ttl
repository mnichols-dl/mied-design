	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "Escape hatch used deliberately for the response only: a generated-document handle (documentId/downloadUrl/expiresAt) is a Documents-capability shape, not one of Credentialing's own domain-model entities." ;
	<urn:solutiondesign:ontology:operationId> "printCredential" ;
	<urn:solutiondesign:ontology:partOfSpec> <urn:solutiondesign:instance:credentialing:ApiSpec> ;
	<urn:solutiondesign:ontology:path> "/credentials/print" ;
	<urn:solutiondesign:ontology:projection> "Request just names the credential(s) to print (credentialId, includeEndorsements); the printed PDF's field set is credentialing-domain.md's 'PDF Contents' list, a rendering of IssuedCredentialAggregate — see cred:TP_CertificatePdfGeneration in credentialing-technical-design.ttl." ;
	<urn:solutiondesign:ontology:responseSchema> "{ documentId, downloadUrl, expiresAt }" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Generate credential certificate PDF" ;
	<urn:solutiondesign:ontology:tags> "Credentials" .

