	<urn:solutiondesign:ontology:docType> "wireframe" ;
	<urn:solutiondesign:ontology:notes> "Confirmed by viewing: 'Select OK to run the Quality Review for this Collection. Depending on the size of the Collection this may take some time.' confirmation modal — corroborates Op_RunQualityReview being a real, potentially long-running, explicitly user-triggered action (Req_21_4_2)." ;
	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/21-roster-of-employees/wireframes/wireframe-06-quality-review-confirm-modal.png" .

<urn:solutiondesign:instance:staffing:Wireframe21_7> a <urn:solutiondesign:ontology:SourceDocument> ;
