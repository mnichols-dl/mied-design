<urn:solutiondesign:instance:credentialing:AssessmentDefinitionAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Defines available competency assessments, their passing criteria, and validity rules. Supports versioning to handle changes in assessment requirements over time." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionCreatedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionRetiredEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionUpdatedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionVersion> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AssessDefState_Active> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AssessDefState_Retired> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionEffectiveDateRange> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionIdentifier> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionProvider> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentDefinitionValidityPeriod> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentName> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:PassingCriteria> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ScoringScale> ;
	<urn:solutiondesign:ontology:invariants> "Assessment identifiers must be unique across all active definitions. Passing criteria must fall within scoring scale min/max bounds. Effective date ranges for different versions cannot overlap. Retired assessments remain visible for historical results but cannot be required for new endorsements. Changes to definitions create new versions rather than modifying existing ones." ;
	<urn:solutiondesign:ontology:rootEntity> "AssessmentDefinition" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionCreatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, assessmentIdentifier, assessmentName, provider, effectiveFrom" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin creates new assessment type" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionEffectiveDateRange> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When this version of the definition is active." ;
	<urn:solutiondesign:ontology:name> "EffectiveDateRange" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionIdentifier> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Unique code (e.g., MTTC-022, Praxis-5161)." ;
	<urn:solutiondesign:ontology:name> "AssessmentIdentifier" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionProvider> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Organization administering the assessment (e.g., Pearson-MTTC, ETS-Praxis)." ;
	<urn:solutiondesign:ontology:name> "AssessmentProvider" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionRetiredEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, assessmentIdentifier, retiredAt, retiredBy, replacementAssessmentId" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin retires assessment type" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionUpdatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "definitionId, assessmentIdentifier, changes, effectiveFrom, updatedBy" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin modifies assessment definition" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionValidityPeriod> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "How long results remain valid (null = no expiration)." ;
	<urn:solutiondesign:ontology:name> "ValidityPeriod" .

<urn:solutiondesign:instance:credentialing:AssessmentDefinitionVersion> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Historical versions of an AssessmentDefinition with change audit trail." ;
	<urn:solutiondesign:ontology:name> "DefinitionVersion" .

<urn:solutiondesign:instance:credentialing:AssessmentName> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Display name (e.g., Mathematics (Secondary))." ;
	<urn:solutiondesign:ontology:name> "AssessmentName" .

<urn:solutiondesign:instance:credentialing:AssessmentResultAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks educator competency assessment results used to validate endorsement eligibility. Supports multiple assessment providers and types (standardized tests, portfolio reviews, alternative demonstrations)." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:credentialing:AssessmentResultImportedEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AssessResultState_Disputed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AssessResultState_Expired> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AssessResultState_Unverified> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:credentialing:AssessResultState_Verified> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentResultAssessmentIdentifier> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentResultEducatorId> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentResultExpirationDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:AssessmentResultProvider> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:ScoreValue> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:credentialing:VerificationStatus> ;
	<urn:solutiondesign:ontology:invariants> "An educator can have multiple results for the same assessment (retakes allowed). Only the highest score for each assessment identifier is used for endorsement eligibility. Results must be verified before use in auto-approval workflows. Expired results cannot be used for new endorsement applications." ;
	<urn:solutiondesign:ontology:notes> "Data Source (Current State): manual entry from uploaded score reports (via Documents capability). Data Source (Future State): potential API integration with Pearson MTTC, ETS Praxis, other providers." ;
	<urn:solutiondesign:ontology:rootEntity> "AssessmentResult" .

<urn:solutiondesign:instance:credentialing:AssessmentResultAssessmentIdentifier> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Reference to assessment definition (e.g., MTTC-022-Mathematics)." ;
	<urn:solutiondesign:ontology:name> "AssessmentIdentifier" .

<urn:solutiondesign:instance:credentialing:AssessmentResultEducatorId> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Reference to the educator who took the assessment." ;
	<urn:solutiondesign:ontology:name> "EducatorId" .

<urn:solutiondesign:instance:credentialing:AssessmentResultExpirationDate> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "When result expires (some jurisdictions require recent scores)." ;
	<urn:solutiondesign:ontology:name> "ExpirationDate" .

<urn:solutiondesign:instance:credentialing:AssessmentResultImportedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "resultId, educatorId, assessmentIdentifier, scoreValue" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Admin imports a row from an assessment provider's score-report file and validation passes" .

<urn:solutiondesign:instance:credentialing:AssessmentResultProvider> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Organization that administered the assessment." ;
	<urn:solutiondesign:ontology:name> "AssessmentProvider" .

<urn:solutiondesign:instance:credentialing:AssessmentResultsValidatedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "applicationId, educatorId, assessmentResults: [{ assessmentId, score, passed }], allRequirementsMet" ;
	<urn:solutiondesign:ontology:publishedToTopic> "credentialing-events" ;
	<urn:solutiondesign:ontology:trigger> "Competency assessment results verified against requirements" .

<urn:solutiondesign:instance:credentialing:AssociatedEndorsements> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "List of endorsements attached to this credential." ;
	<urn:solutiondesign:ontology:name> "AssociatedEndorsements" .

<urn:solutiondesign:instance:credentialing:BatchJob_CredentialExpirationProcessing> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:appliesTo> <urn:solutiondesign:instance:credentialing:IssuedCredentialAggregate> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "Retry failed transitions the next night (bounded retry count, consistent with documents-technical-design.md's 'Hard Delete Background Job' pattern). Never expire a credential whose expires_at is still in the future." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:schedule> "Nightly (exact time TBD)." ;
	<urn:solutiondesign:ontology:steps> "1. Query ISSUED_CREDENTIALS where expires_at is today's date or earlier and status = Valid. 2. Transition each to Expired. 3. Publish CredentialExpired per record (consumers: communications for expiration notices, staffing for roster-eligibility re-evaluation). 4. Generate a summary: credentials expired, notification events published." ;
	<urn:solutiondesign:ontology:title> "Credential / Permit Expiration Processing" ;
	<urn:solutiondesign:ontology:whatWhenWho> "Permits and non-permanent credentials have hard expiration dates (see credentialing-domain.md's Rule_PermitDurationAndRenewalLimits); this keeps IssuedCredential.status accurate without requiring an on-access check on every read." .

<urn:solutiondesign:instance:credentialing:BatchJob_DefinitionVersionActivation> a <urn:solutiondesign:ontology:BatchJob> ;
	<urn:solutiondesign:ontology:belongsToContext> <urn:solutiondesign:instance:credentialing:CredentialingContext> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:credentialing:TechnicalDesignDoc> ;
	<urn:solutiondesign:ontology:errorScenarios> "If an activation fails (e.g. referential integrity issue), skip that version, continue processing the rest, and alert — do not let one bad version block the whole batch. Never activate a version whose EffectiveFrom is still in the future, regardless of processing delays." ;
	<urn:solutiondesign:ontology:initiatedBy> "internal-system" ;
	<urn:solutiondesign:ontology:schedule> "Nightly (exact time TBD — coordinate with other domains' nightly jobs, e.g. Organizations' CEPI sync, to avoid contention)." ;
	<urn:solutiondesign:ontology:steps> "1. Query CredentialDefinition/EndorsementDefinition versions where EffectiveFrom is today's date or earlier and the version is not yet Active. 2. For each: deactivate the currently Active version (transition to Deprecated), activate the future-dated version. 3. Publish a definition-changed event per activated version (consumed by any service caching definition data). 4. Generate a summary: versions activated, versions still pending future activation." ;
	<urn:solutiondesign:ontology:title> "Definition Version Activation (\"Cleanup of Future-Dated Changes\")" ;
	<urn:solutiondesign:ontology:whatWhenWho> "Lets a Credential Admin schedule a definition change in advance (e.g. a fee change effective at the start of a school year) without needing to be online at the moment it should take effect — see credentialing-domain.md's Rule_CredentialDefinitionVersioning and Rule_CleanupOfFutureDatedChanges business rules." .

