	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/13-epp-admin-users/wireframes/addendum-c-candidates-verified-pending-status-list.png" .

<urn:solutiondesign:instance:epp:WireframeProgramTypesPlaceholder> a <urn:solutiondesign:ontology:SourceDocument> ;
