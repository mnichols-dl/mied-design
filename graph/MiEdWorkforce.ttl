	<urn:solutiondesign:ontology:section> "abox/mied-v3/fdd-review/21-roster-of-employees/wireframes/wireframe-04-advanced-search.png" .

<urn:solutiondesign:instance:staffing:Wireframe21_5> a <urn:solutiondesign:ontology:SourceDocument> ;
