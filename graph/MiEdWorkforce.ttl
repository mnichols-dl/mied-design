<urn:solutiondesign:instance:profpractices:DisclosureAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Represents a single reported incident (criminal conviction or professional disciplinary action) submitted by an educator or identified through background checks. Manages the complete lifecycle from submission through final review determination." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:DisclosureReviewCompletedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:DisclosureReviewStartedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:DisclosureRoutedToWorklistEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:DisclosureStatusChangedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:DisclosureSubmittedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:NonSystemActionLoggedEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:profpractices:DisclosureNonSystemActions> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:profpractices:DisclosureReviewHistory> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_PendingReview> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_PprDocumentHold> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_PprHold> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedArraignment> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedFelony> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedListed> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedMisdemeanor> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedNoActionRequired> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_ReviewedNonEnumerated> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:DiscState_UnderPprReview> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureAssociatedEducator> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureAttachments> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureConvictionDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureDateReported> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureDescription> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureExternalRemarks> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureInternalRemarks> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureSourceType> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:DisclosureType> ;
	<urn:solutiondesign:ontology:invariants> "Conviction Date must not be in the future. Description is required and cannot exceed 5000 characters. At least one supporting document must be attached for self-disclosures. Status transitions must follow valid workflow paths. Once a disclosure reaches a \"Reviewed\" status, it cannot be edited without explicit reversion by PPR Admin. Hard deletes require DTMB intervention; standard deletes are soft deletes." ;
	<urn:solutiondesign:ontology:notes> "The ten \"Reviewed-*\" states are marked isTerminal true (end of standard workflow) even though a PPR Admin can exceptionally revert a finalized disclosure back to \"Under PPR Review\" (profpractice.disclosure.revert) — that revert is an explicit administrative exception, not a normal transition out of a terminal state." ;
	<urn:solutiondesign:ontology:rootEntity> "Disclosure" .

<urn:solutiondesign:instance:profpractices:DisclosureAssociatedEducator> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Reference to the individual this disclosure pertains to." ;
	<urn:solutiondesign:ontology:name> "AssociatedEducator" .

<urn:solutiondesign:instance:profpractices:DisclosureAttachments> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "References to supporting documents (court orders, police reports, etc.) managed by the Documents capability; PPR stores document ID references only." ;
	<urn:solutiondesign:ontology:name> "Attachments" .

<urn:solutiondesign:instance:profpractices:DisclosureConvictionDate> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Date of conviction or disciplinary action; must not be in the future." ;
	<urn:solutiondesign:ontology:name> "ConvictionDate" .

<urn:solutiondesign:instance:profpractices:DisclosureDateReported> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "System timestamp of submission, automatically captured." ;
	<urn:solutiondesign:ontology:name> "DateReported" .

<urn:solutiondesign:instance:profpractices:DisclosureDescription> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Free-text narrative of the incident (max 5000 characters)." ;
	<urn:solutiondesign:ontology:name> "Description" .

<urn:solutiondesign:instance:profpractices:DisclosureExternalRemarks> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Comments potentially visible to the educator." ;
	<urn:solutiondesign:ontology:name> "ExternalRemarks" .

<urn:solutiondesign:instance:profpractices:DisclosureInternalRemarks> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Staff-only comments and case notes." ;
	<urn:solutiondesign:ontology:name> "InternalRemarks" .

<urn:solutiondesign:instance:profpractices:DisclosureNonSystemActions> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Log of external activities (phone calls, emails, manual document reviews) taken by PPR staff outside the system, documented for audit." ;
	<urn:solutiondesign:ontology:name> "NonSystemActions" .

<urn:solutiondesign:instance:profpractices:DisclosureReviewCompletedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "disclosureId, reviewerId, finalStatus, reviewCompletedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "PPR reviewer finalizes disclosure to \"Reviewed\" status" .

<urn:solutiondesign:instance:profpractices:DisclosureReviewHistory> a <urn:solutiondesign:ontology:DomainEntity> ;
	<urn:solutiondesign:ontology:description> "Audit trail of all status changes and reviewer actions on a disclosure." ;
	<urn:solutiondesign:ontology:name> "ReviewHistory" .

<urn:solutiondesign:instance:profpractices:DisclosureReviewStartedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "disclosureId, reviewerId, reviewStartedAt" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "PPR reviewer begins reviewing disclosure" .

<urn:solutiondesign:instance:profpractices:DisclosureRoutedToWorklistEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "disclosureId, worklistId, routedAt, routingReason" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "Disclosure assigned to PPR worklist" .

<urn:solutiondesign:instance:profpractices:DisclosureSourceType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "How the disclosure was captured: SelfDisclosed, RapBackTriggered, NASDTECTriggered, PPRResponse, AdminEntered." ;
	<urn:solutiondesign:ontology:name> "SourceType" .

<urn:solutiondesign:instance:profpractices:DisclosureStatusChangedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "disclosureId, educatorId, previousStatus, newStatus, changedAt, changedBy" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "PPR reviewer changes disclosure status" .

<urn:solutiondesign:instance:profpractices:DisclosureSubmittedEvent> a <urn:solutiondesign:ontology:DomainEvent> ;
	<urn:solutiondesign:ontology:payloadHighlights> "disclosureId, educatorId, disclosureType, convictionDate, submittedAt, sourceType" ;
	<urn:solutiondesign:ontology:publishedToTopic> "profpractice-events" ;
	<urn:solutiondesign:ontology:trigger> "Educator submits self-disclosure or PPR response with new incidents" .

<urn:solutiondesign:instance:profpractices:DisclosureType> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Category of incident: Misdemeanor, Felony, Credential Suspension, Credential Revocation, Credential Surrender, Credential Nullification, Pending Credential Action." ;
	<urn:solutiondesign:ontology:name> "DisclosureType" .

<urn:solutiondesign:instance:profpractices:DisclosuresOperation> a <urn:solutiondesign:ontology:ApiOperation> ;
	<urn:solutiondesign:ontology:accessType> "internal-service" ;
	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:profpractices:ProfessionalPracticesContext> ;
	<urn:solutiondesign:ontology:method> "GET" ;
	<urn:solutiondesign:ontology:notes> "CONFIRMED GAP (cross-domain consistency pass): profpractice is now really converted in abox/mied-v3/profpractice/profpractice-api.ttl, and it exposes no '/educators/{id}/disclosures' path. The closest real operations are profp:Op_ListDisclosures (GET /disclosures, accessType internal-user/scopeSensitive true — a user-facing list, not an internal-service per-educator lookup, and not documented as filterable by educatorId) and profp:Op_GetEducatorPprStatus (GET /educators/{educatorId}/ppr-status, which does embed disclosure counts per its own sd:projection, but as an aggregated compliance view, not a raw disclosure list) — neither is a clean match for this stub's shape, so no rename was made. Distinct path from profp:Op_GetPprClearanceAssessment (formerly credentialing's profp:PPRClearanceOperation stub, now reconciled to the real operation) — epp-sequences.md calls a differently-named disclosures endpoint for optional conviction context, not the pass/fail clearance-status endpoint credentialing calls; left as a genuine, separate gap rather than guessing it's one of the above." ;
	<urn:solutiondesign:ontology:path> "/educators/{id}/disclosures" ;
	<urn:solutiondesign:ontology:scopeSensitive> false ;
	<urn:solutiondesign:ontology:summary> "Returns an educator's conviction/professional-practice disclosure summary, for review context." .

<urn:solutiondesign:instance:profpractices:DomainDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "domain" ;
	<urn:solutiondesign:ontology:section> "abox-tests/mied/profpractice/profpractice-domain.md" .

<urn:solutiondesign:instance:profpractices:EducatorPPRStatusAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Tracks account-level markers and provides a query interface for PPR clearance and roster-eligibility assessments. Does NOT store a single \"clearance status\" — assessments are calculated on-demand from current disclosure statuses and markers." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:PPRAccountMarkerChangedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:PPRClearanceAssessmentChangedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:PPRReminderRequiredEvent> ;
	<urn:solutiondesign:ontology:hasEntity> <urn:solutiondesign:instance:profpractices:AccountMarkerHistory> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:ActiveDisclosureIds> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:EnhancedMonitoringStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:FinalizedDisclosureIds> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:LastPPRResponseDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:MandatoryHoldRequirement> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:MarkerReasons> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:NextPPRDueDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:PPRClearanceAssessment> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:ReReviewRequirement> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:RosterEligibilityAssessment> ;
	<urn:solutiondesign:ontology:invariants> "Account markers can only be set/cleared by authorized PPR Review or Credentialing Admin roles. Marker changes require justification and are fully audited. An educator can have zero, one, or multiple account markers active simultaneously. Account markers are independent of disclosure statuses (markers + disclosures combine to determine assessment outcome). Annual PPR compliance is computed from LastPPRResponseDate, not stored as a toggleable marker." ;
	<urn:solutiondesign:ontology:rootEntity> "EducatorPPRStatus" .

<urn:solutiondesign:instance:profpractices:EnhancedMonitoringStatus> a <urn:solutiondesign:ontology:ValueObject> ;
	<urn:solutiondesign:ontology:description> "Boolean marker; when active, alerts the PPR Review role but processing continues." ;
	<urn:solutiondesign:ontology:name> "EnhancedMonitoringStatus" .

<urn:solutiondesign:instance:profpractices:ExternalBackgroundCheckAggregate> a <urn:solutiondesign:ontology:Aggregate> ;
	<urn:solutiondesign:ontology:definedIn> <urn:solutiondesign:instance:profpractices:DomainDoc> ;
	<urn:solutiondesign:ontology:description> "Manages integration data and responses from external background check systems (Rap Back/CHRISS, NASDTEC). Separate from Disclosure to isolate external system concerns." ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:NASDTECRecordMatchedEvent> ;
	<urn:solutiondesign:ontology:emits> <urn:solutiondesign:instance:profpractices:RapBackNotificationReceivedEvent> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:CheckState_Matched> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:CheckState_Pending> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:CheckState_Received> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:CheckState_RequiresEducatorAction> ;
	<urn:solutiondesign:ontology:hasState> <urn:solutiondesign:instance:profpractices:CheckState_Resolved> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckAssociatedDisclosureIds> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckEducatorId> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckMatchStatus> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckNotificationDate> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckRequiresEducatorResponse> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckResponseData> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:CheckSource> ;
	<urn:solutiondesign:ontology:hasValueObject> <urn:solutiondesign:instance:profpractices:RapSheetRetrievalLog> ;
	<urn:solutiondesign:ontology:invariants> "Rap Back responses are read-only for PPR staff (notification metadata stored, not full rap sheet). External check data is retained for audit purposes even after review. New external findings trigger automatic creation of disclosure records requiring educator acknowledgment. Integration failures are logged but do not block manual disclosure processing. Rap sheets retrieved via SOAP GET_RAPBACK are display-only, NEVER stored in system." ;
	<urn:solutiondesign:ontology:rootEntity> "ExternalBackgroundCheck" .

<urn:solutiondesign:instance:profpractices:Fdd08_2NasdtecDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "13 review comments: mostly dead-link fix and volume/scheduling TBDs. One substantive: 'we have to define this retention policy' (Punniyamoorthy) — independently corroborates profp:Question_NASDTECDataLifecycle, already on record from the profpractice domain pass; not re-modeled here as a duplicate. Another: 'Removing reference to NASDTEC, as this should be for all API calls' — confirms 8.2.4's audit-logging story was generalized from a NASDTEC-specific draft, i.e. it documents a cross-cutting logging expectation, not a NASDTEC peculiarity." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/08 - Interface and Integrations Setup/8.2 - NASDTEC - Ed ID Clearinghouse/8.2 - NASDTEC IDD.docx" .

<urn:solutiondesign:instance:profpractices:Fdd09Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 9.1-9.5 (the document's own subtitle: '9 - Professional Practice Review (PPR) (9.1-9.6)', though no 9.6-numbered story exists anywhere — see this file's header). Author(s) Beth Dontje / Caitlin Groom / Kate Boswell Gallagher; approved by Dontje (MDE) and Groom (CEPI) both 08/01/2025 per the sign-off table — but the comment threads (comments.xml/commentsExtended.xml/commentsExtensible.xml/commentsIds.xml) contain dated entries from 2025-10 through 2026-03, well past that nominal approval date, meaning the document continued to be actively revised long after its sign-off. Not resolved here; noted so the sign-off table isn't read as 'nothing changed after this' (same caveat FDD 29's own pass raised for its document)." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/09 - Professional Practices/9 - Professional Practice.docx" .

<urn:solutiondesign:instance:profpractices:Fdd30ChrissSoapDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Technical interface spec for the on-demand CHRISS SOAP 1.2 GET_RAPBACK pull (~20MB/month, as-needed frequency, application-level User/Password auth). Explicitly states 'None of the data returned is saved in MOECS (legacy system), and should not be saved in MiEdWorkforce either' — direct textual source for profp:Rule_RapSheetDisplayOnly. Matches profp:Op_RetrieveRapSheet / profp:Seq_RetrieveFullRapSheet's SOAP envelope shape exactly. No embedded images; no substantive review comments." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/30 - Interface Integration - Rapbacks/30.0 CHRISS (RapBacks)/Interface Design document - Chriss (RapBacks Details).docx" .

<urn:solutiondesign:instance:profpractices:Fdd30ChrissWebhookDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "Technical interface spec for the MSP-to-MiEdWorkforce push webhook (RESTful, HTTPS POST, API Token auth, ~200kB/month, daily). Matches profp:Op_ReceiveRapBackNotification / profp:Seq_ReceiveRapBackNotification closely: same field set (AgencyName, ApplicantName, SID, ApplicantDOB, TCN, ApplicantSSN, TCNDate, PIC, JudicialFlag, RequestID). No embedded images; no substantive review comments (sign-off rows only)." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/30 - Interface Integration - Rapbacks/30.0 CHRISS (RapBacks)/Interface Design document - Chriss (RapBacks).docx" .

<urn:solutiondesign:instance:profpractices:Fdd30Doc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "fdd" ;
	<urn:solutiondesign:ontology:notes> "Covers Features 30.1-30.8 (document subtitle: '30.0 Interface/Integration - Rapbacks (30.1-30.8)'). Author Vidhya Punniyamoorthy (DTMB); approved by Beth Dontje (MDE) and Caitlin Groom (CEPI), both 08/05/2025 — but comments.xml contains entries dated through 2026-04, well after nominal sign-off, same post-approval-revision pattern already noted in the FDD 29 review." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/30 - Interface Integration - Rapbacks/30 - Rapbacks.docx" .

<urn:solutiondesign:instance:profpractices:Fdd30MclKeywordsDoc> a <urn:solutiondesign:ontology:SourceDocument> ;
	<urn:solutiondesign:ontology:docType> "review" ;
	<urn:solutiondesign:ontology:notes> "833-row reference list of Michigan Compiled Law (MCL) statute citations (e.g. MCL 750.520b, MCL 333.7403), named by the Business Specifications section as the exact 'MDE-defined list of MCL codes' Rapback records are matched against. Confirms the MCL-matching business rule (profp:Req_30_BizSpec_MclMatching) is real and specific, not vague filler. Not modeled as individual graph instances — a reference-data list, cited by count/location instead, consistent with this project's treatment of large enumerated code lists elsewhere." ;
	<urn:solutiondesign:ontology:section> "functional-design-docs/30 - Interface Integration - Rapbacks/Rapbacks-MCLKeywords.xlsx" .

<urn:solutiondesign:instance:profpractices:FinalizedDisclosureIds> a <urn:solutiondesign:ontology:ValueObject> ;
