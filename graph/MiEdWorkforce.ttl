	<urn:solutiondesign:ontology:label> "Administration" .

<urn:solutiondesign:instance:epp:Cat_ApplicationReview> a <urn:solutiondesign:ontology:PermissionCategory> ;
	<urn:solutiondesign:ontology:label> "Credential Application Review" .

