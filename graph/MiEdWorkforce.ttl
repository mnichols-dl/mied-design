	<urn:solutiondesign:ontology:exposedBy> <urn:solutiondesign:instance:staffing:StaffingContext> ;
	<urn:solutiondesign:ontology:method> "POST" ;
	<urn:solutiondesign:ontology:notes> "x-access: [internal-user, external-client] — internal-user recorded as primary. Only allowed during a working window or open collection." ;
