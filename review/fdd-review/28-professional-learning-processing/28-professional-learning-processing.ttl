plrn:WireframeAddendumADoc a sd:SourceDocument ; sd:docType "wireframe" ;
    sd:section "abox/mied-v3/fdd-review/28-professional-learning-processing/wireframes/addendum-a-attendance-evaluation-tabs.jpg" ;
