    sd:definedIn staff:Fdd18Doc .
staff:Wireframe6 a sd:SourceDocument ; sd:docType "wireframe" ;
    sd:section "abox/mied-v3/fdd-review/18-roster-of-positions/wireframes/wireframe-06-add-filled-spot-step3.png" ;
