@prefix oa:    <http://www.w3.org/ns/oa#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix staff: <urn:solutiondesign:instance:staffing:> .
@prefix iam:   <urn:solutiondesign:instance:iam:> .
@prefix comm:  <urn:solutiondesign:instance:communications:> .
@prefix profp: <urn:solutiondesign:instance:profpractices:> .

